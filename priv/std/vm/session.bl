; vm/session.bl — the pure-beam-lisp daemon session (ports Daemon.Server).
;
; ══ WHAT MOVED HERE (FUP-082 T2/D3) ═════════════════════════════════════════
;
; The whole daemon, composed from the vm.* substrate — NO Elixir daemon code:
;
;   vm.net    the AF_UNIX transport (listen, accept, hello/token auth)
;   vm.io     the per-request group-leader proxy (stdout → frames)
;   vm.wire   the ETF codec
;   vm.manager the global VM manager (per-request VMs, PLAN-121)
;   bl.daemon/handle-in-vm  the command path
;
; A request runs in its own process under its VM's env, with its group leader
; set to a vm.io proxy so its stdout streams back as frames, and its exit code
; framed after the last output. N requests run concurrently — no serial worker.
;
;   (session/start root)   → {:ok listener}   boot the daemon for `root`
;   (session/stop listener)
;
; This is what `bl realm start` boots (a bl namespace AS the session).

(ns vm.session
  ;; NO [bl.daemon] here, deliberately. `bl.daemon` requires `bl.cli`, and
  ;; `bl.cli` requires `vm.client`, which requires THIS namespace — so requiring
  ;; the command handler closes a cycle:
  ;;
  ;;     vm.session → bl.daemon → bl.cli → vm.client → vm.session
  ;;
  ;; A cycle that only READS is survivable. This one is not: the AOT loader takes
  ;; a `:global` lock per namespace in the CALLER and runs that namespace's
  ;; `__bl_init__` in `Loader.Server`, so the two ends of the cycle wait on each
  ;; other — one holds `{:bl_load, Bl.Cli}` and waits for the server, the server
  ;; replays into `bl.daemon`, which comes back around and waits for a lock that
  ;; is already held. `:global.set_lock` then retries forever, and every command
  ;; in a fresh drop hangs. The handler is resolved by name at the point of use
  ;; instead (see `dispatch-command`), which keeps the seam this file's header
  ;; already names — `bl.daemon/handle-in-vm` — without binding it at load time.
  (:require [vm.net :as net] [vm.io :as io] [vm.wire :as wire]
            [vm.manager :as mgr]
            [vm.ports :as ports] [vm.names :as names] [vm.paths :as paths]
            [vm.exec :as exec]
            [vm.spec :as spec] [vm.registry :as registry]
            [vm.idle :as idle] [vm.owner :as owner] [vm.realm :as realm]))

(def PT-ROOT (tuple :vm_session :root))
(def PT-STARTED (tuple :vm_session :started-at))
(def PT-RECORD (tuple :vm_session :record))
(def PT-IDLE (tuple :vm_session :idle))

;; ══ ONE VM, POSSIBLY MORE THAN ONE SESSION ═══════════════════════════════════
;;
;; A session's admission state belongs to the SESSION, not to the VM. The warm
;; checkout VM is itself a session, and a test it runs may start another (the
;; shared-VM and daemon tests do). A VM-global draining flag and a VM-global drain
;; let that inner session's stop refuse every later request of the outer one, count
;; the outer request that runs the test as its own pending work (so it never
;; stopped), and close the outer session's realms under it.
;;
;; So each session has a key, bound in its connection processes (`PD-SESSION`), and
;; a live entry (`PT-LIVE`): its counter cell (slot 1 the requests it accepted, slot
;; 2 its draining flag), the realms its requests opened, and what it published. A
;; bare `request-handler` call (no key bound) speaks for the session started last
;; (`PT-CURRENT`). A session alone in its VM behaves exactly as before: it drains on
;; the VM's in-flight count and closes every realm.
(def PT-LIVE (tuple :vm_session :live))
(def PT-CURRENT (tuple :vm_session :current))
(def PD-SESSION :vm_session_key)
(def LIVE-LOCK :vm_session_live)
;; set by `bl.daemon/handle-in-vm` in the command's process: the realm it ran in
(def REQUEST-REALM :vm_request_realm)

(defn- live [] (erlang/apply :persistent_term :get (list PT-LIVE {})))

(defn- update-live!
  "Replace the live table with `(f table)` under one lock. Rare: a start, a stop,
   or a session's first request in a realm it had not used."
  [f]
  (let [lock (tuple LIVE-LOCK (erlang/self)) nodes (to-list [(erlang/node)])]
    (erlang/apply :global :set_lock (list lock nodes))
    (try (erlang/apply :persistent_term :put (list PT-LIVE (f (live))))
      (finally (erlang/apply :global :del_lock (list lock nodes))))))

(defn- session-key
  "The session this process serves: the one its connection bound, else the one
   started last."
  []
  (let [k (erlang/get PD-SESSION)]
    (if (= k :undefined) (erlang/apply :persistent_term :get (list PT-CURRENT nil)) k)))

(defn- cell [k] (:cell (get (live) k)))

(defn- draining?
  "Whether session `k` refuses new requests. A key whose session is gone refuses
   (its listener closed under a request that had not been read yet); no session at
   all does not."
  [k]
  (let [c (cell k)]
    (if (some? c) (= 1 (erlang/apply :atomics :get (list c 2))) (some? k))))

(defn- set-draining! [k on]
  (when-let [c (cell k)] (erlang/apply :atomics :put (list c 2 (if on 1 0)))))

(defn- pending-requests
  "Requests in flight that session `k` must wait for: every request the VM counts
   (`idle/running`) except those another live session accepted."
  [k]
  (let [others (reduce + 0 (map (fn [e] (erlang/apply :atomics :get (list (:cell e) 1)))
                                (vals (dissoc (live) k))))]
    (max 0 (- (idle/running) others))))

(defn- note-realm!
  "Remember that a request of session `k` ran in the realm at `root`."
  [k root]
  (when (and (some? k) (erlang/is_binary root))
    (let [e (get (live) k)]
      (when (and (some? e) (not (contains? (:realms e) root)))
        (update-live! (fn [m] (if (contains? m k) (update-in m [k :realms] conj root) m)))))))

(defn- session-realms
  "The realms session `k` answers for: every open realm when it is the VM's only
   session, else the open realms its own requests (or its boot) opened."
  [k]
  (let [m (live)]
    (if (empty? (dissoc m k))
      (realm/roots)
      (let [mine (or (:realms (get m k)) #{})]
        (to-list (filter (fn [r] (contains? mine r)) (realm/roots)))))))

(defn- register-session! [k root]
  ;; cell slots: 1 the requests it accepted, 2 its draining flag, 3 booting
  ;; (`await-boot!`): set until `boot-realm-services!` has returned
  (let [c (erlang/apply :atomics :new (list 3 (to-list [(tuple :signed false)])))]
    (erlang/apply :atomics :put (list c 3 1))
    (update-live! (fn [m] (assoc m k {:cell c
                                      :root root :started-at (erlang/system_time :second)
                                      :realms #{} :primary (empty? m)})))))

(def ^:private BOOT-POLL-MS 2)
(def ^:private BOOT-WAIT-MS 360000)

(defn- boot-done! [k]
  (when-let [c (cell k)] (erlang/apply :atomics :put (list c 3 0))))

(defn- await-boot!
  "Hold a command that arrived while session `k` was still starting its services
   until they are up. The listener accepts before the services start (`start`),
   and the launcher sends its first command as soon as the socket exists (M3).
   Run alongside the boot, that command took the same locks the boot held (the
   manager's start, a realm's lifecycle, the live table, the loader's per-file
   locks), all `:global`, which sleeps 0-250 ms and then up to 0.5, 1, 2 s
   between attempts: it woke a few hundred ms after the boot had released them.
   Everything it would have overlapped runs through the one loader process
   anyway. Polls one atomics slot, so a command that arrives later pays one
   read. Bounded like the launcher's own start deadline; a boot that raised
   cleared the flag on its way out."
  [k]
  (when-let [c (cell k)]
    (loop [waited 0]
      (when (and (= 1 (erlang/apply :atomics :get (list c 3))) (< waited BOOT-WAIT-MS))
        (Process/sleep BOOT-POLL-MS)
        (recur (+ waited BOOT-POLL-MS))))))

(defn- unregister-session! [k] (update-live! (fn [m] (dissoc m k))))

(defn- primary?
  "Whether `k` was the only session when it started: the one the VM's foreground
   loop runs and its process-wide facts (`PT-ROOT`, the stop flag) describe."
  [k]
  (let [e (get (live) k)] (or (nil? e) (= true (:primary e)))))

(defn- put-if-absent!
  "Put `v` at `key` unless another session already holds it. Returns whether it did."
  [key v]
  (if (some? (erlang/apply :persistent_term :get (list key nil)))
    false
    (do (erlang/apply :persistent_term :put (list key v)) true)))

(defn- stop-flag
  "The flag a stop of session `k` raises. The foreground loop (`vm.client`) waits on
   the VM's flag, which belongs to the session the VM started with; an inner session
   raising it would stop the outer one's VM, so an inner session raises its own."
  [k]
  (if (primary? k) (tuple :vm_session :stop) (tuple :vm_session :stop k)))

(defn- request-stop! [k] (erlang/apply :persistent_term :put (list (stop-flag k) true)))

(defn- erase-if-mine! [key v]
  (when (and (some? v) (= v (erlang/apply :persistent_term :get (list key nil))))
    (erlang/apply :persistent_term :erase (list key))))
(defn- pending! [conn-send id]
 (conn-send (wire/stderr id 0 "bl realm: retirement pending; release consumers and retry\n"))
 (conn-send (wire/exit id 1)))
(defn- drain-session!
 "Close session `k`'s request admission before checking the existing in-flight
  counter. Accepted work drains before realms; pending consumers keep the listener
  live. Only `k`'s own work and realms count (see `pending-requests`)."
 [k]
 (BeamLisp.Env/assert_native_framework_execution!)
 (set-draining! k true)
 (let [running (pending-requests k)]
  (if (> running 0) {:status :waiting :pending running}
   (let [results (mapv realm/close (session-realms k))
         pending (count (filter #(= :waiting (:status %)) results))]
    {:status (if (= 0 pending) :retired :waiting) :pending pending
     :errors (vec (keep :error results))}))))

(defn vm-label
  "What `bl vm` calls this VM: the project's name for a VM that serves one project,
   `shared` for the build's shared VM (it serves none in particular, and a blank
   label is not something a person can type to `bl vm stop`)."
  [root]
  (if (nil? root) "shared" (Path/basename root)))

(defn- members-text
  "What realm `root` owns, one member per line: `<pid> <role> <age-seconds>`. The
   age is how long the member has been in the realm. The wire is text and the client
   parses it, so a member list is the same bytes whoever asks."
  [root]
  (let [id (:id (vm.spec/read root))
        now (erlang/system_time :second)]
    (apply str (map (fn [m] (str (erlang/list_to_binary (erlang/pid_to_list (:pid m))) " " (name (or (:role m) :unknown))
                                 " " (max 0 (- now (or (:since m) now))) "\n"))
                    (owner/members id)))))

(defn show-text
  "What the realm at `root` is, as lines: its alias and key, the shadow chip when it shadows
   anything, what it shares by hash, and how many members it owns. Empty when it is not open.
   The console renders the same data (`realm/describe`); the lines are for the terminal."
  [root]
  (let [d (realm/describe root)]
    (if (nil? d)
      ""
      (str "realm    " (:alias d) "  (" (:key d) ")\n"
           (if-let [chip (realm/shadow-chip (:shadows d))] (str "         " chip "\n") "")
           (apply str (map (fn [[ns h]] (str "uses     " ns "  " h "\n")) (sort (:uses d))))
           "members  " (:members d) "\n"))))

(defn- shared-status-text
  "What a shared VM answers to `realm show`: it serves no single project, so it
   names the realms it has open."
  [k]
  (let [roots (session-realms k)]
    (str "shared VM  " (count roots) " realm(s)"
         (apply str (map (fn [r] (str "\n  " r)) roots)))))

(defn- sdk-call [namespace binding args]
  (BeamLisp.Loader/ensure_loaded namespace)
  (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! namespace binding) args))

(defn- status-text [k]
  (let [e (get (live) k)
        root (if e (:root e) (erlang/apply :persistent_term :get (list PT-ROOT nil)))]
    (if (nil? root)
      (shared-status-text k)
      (sdk-call "vm.inspect" "render-text"
        (list (sdk-call "vm.inspect" "model"
                (list {:root root
                       :started-at (if e (:started-at e)
                                       (erlang/apply :persistent_term :get (list PT-STARTED nil)))})))))))

(defn- control-handler [frame conn-send]
  ;; frame = {:control id op} where op ∈ #{:status :stop} or {:close root}
  (let [id (elem frame 1)
        op (elem frame 2)
        k (session-key)]
    (cond
      (= op :status)
      ;; the SESSION'S READ-MODEL, rendered — the same value the browser page
      ;; renders (vm.inspect), so the two faces cannot disagree.
      (do (conn-send (wire/stdout id 0 (str (status-text k) "\n")))
          (conn-send (wire/exit id 0)))
      (= op :realms)
      (do (conn-send (wire/stdout id 0 (str (join "\n" (session-realms k)) "\n")))
          (conn-send (wire/exit id 0)))
      (and (erlang/is_tuple op) (= :close (elem op 0)))
      (let [root (elem op 1) result (realm/close root)]
       (if (= :waiting (:status result)) (pending! conn-send id)
        (do (conn-send (wire/stdout id 0 (str "bl realm: closed " root "\n")))
            (conn-send (wire/exit id 0)))))
      (and (erlang/is_tuple op) (= :members (elem op 0)))
      (do (conn-send (wire/stdout id 0 (members-text (elem op 1))))
          (conn-send (wire/exit id 0)))
      (and (erlang/is_tuple op) (= :show (elem op 0)))
      (do (conn-send (wire/stdout id 0 (show-text (elem op 1))))
          (conn-send (wire/exit id 0)))
      (and (erlang/is_tuple op) (= :restart (elem op 0)))
      (if (draining? k) (pending! conn-send id)
       (let [root (elem op 1) result (realm/close root)]
        (if (= :waiting (:status result)) (pending! conn-send id)
         (do (realm/open root)
             (conn-send (wire/stdout id 0 (str "bl realm: restarted " root "\n")))
             (conn-send (wire/exit id 0))))))
      (= op :stop)
      (let [drained (drain-session! k)]
       (if (= :waiting (:status drained))
        (do ;; a drain that raised says why (`vm.manager/drain-vm`); pending
            ;; consumers alone keep the plain retry message
            (doseq [e (:errors drained)]
              (conn-send (wire/stderr id 0 (str "bl realm: retirement failed: " e "\n"))))
            (pending! conn-send id))
       (do (request-stop! k)
           (conn-send (wire/stdout id 0 "bl realm: stopping\n"))
           (conn-send (wire/exit id 0)))))
      :else (conn-send (wire/exit id 0)))))

(defn- request-handler [frame conn-send]
  ;; :control (status/stop) vs :request (a command)
  (if (= :control (elem frame 0))
    (control-handler frame conn-send)
    (let [k (session-key)
          _ (await-boot! k)]
    (if (draining? k) (pending! conn-send (elem frame 1))
     (do
      ;; Double-check after entering the existing counter: a stop either sees
      ;; this accepted request or it observes draining before any command effect.
      (idle/begin!)
      (let [c (cell k)
            _ (when c (erlang/apply :atomics :add (list c 1 1)))
            ;; The request's custody is released once: here, or by the connection's
            ;; watcher when it had to end this process (vm.net `arm-cancel!`).
            claim (net/new-claim)
            release (fn []
                      (when c (erlang/apply :atomics :sub (list c 1 1)))
                      (idle/end!))
            result (try
                    (if (draining? k) :retirement-pending (dispatch-command frame conn-send claim release))
                    (finally
                      (if (net/claim! claim)
                        (release)
                        ;; the watcher holds the claim: it is ending this process
                        ;; and releases the request itself
                        (erlang/apply :timer :sleep (list :infinity)))))]
       ;; The terminal frame commits after releasing request custody. A client
       ;; that immediately stops after receiving it must not see stale in-flight
       ;; work from this already-completed request.
       (if (= :retirement-pending result) (pending! conn-send (elem frame 1))
        (when (not= :cancelled result) (conn-send (wire/exit (elem frame 1) result))))))))))

(defn start-heartbeat
  "Send `id`'s client a heartbeat every `interval-ms` from a process of its own,
   for a caller that has no waiting process to beat from (a request's command
   beats from `await-command`). Returns the pid; `stop-heartbeat` ends it. The
   client reads this as proof the VM is alive and the command merely quiet."
  [conn-send id interval-ms]
  (spawn (fn []
           (loop []
             (receive
               :stop :ok
               (after interval-ms
                 (do (conn-send (wire/heartbeat id)) (recur))))))))

(defn stop-heartbeat [pid]
  (erlang/send pid :stop)
  :ok)

(defn await-command
  "Wait in THIS process for `child`, the command of request `id`: its exit code,
   `:cancelled` when the client left first (the child is ended), or 1 when the
   child died without answering. While it waits, `id`'s client gets a heartbeat
   every `interval-ms`. The beat comes from this waiting process, not one of its
   own: the command runs in `child`, so nothing it does can starve this receive,
   and a request no longer pays a process start for its liveness frames."
  [child conn-send id interval-ms]
  (let [mref (erlang/apply :erlang :monitor (list :process child))]
    (loop []
      (receive
        [:command-done code] (do (erlang/apply :erlang :demonitor (list mref (list :flush))) code)
        :client_gone (do (erlang/apply :erlang :demonitor (list mref (list :flush)))
                         (erlang/exit child :client_gone)
                         :cancelled)
        ; the command's process ended without answering (an exit the try did not see)
        [:DOWN _r :process _p reason]
        (do (conn-send (wire/stderr id 999999 (str "bl: the command ended abnormally: " (pr-str reason) "\n")))
            1)
        (after interval-ms
          (do (conn-send (wire/heartbeat id)) (recur)))))))

(defn- run-command
  "Run the command of request `id` in THIS process, the connection's (F2: one
   owned process start fewer, ~1 ms). Returns the exit code.

   Cancellation is the connection watcher's (vm.net `arm-cancel!`, armed by
   `dispatch-command`): when the client leaves, it ends this process, and with
   it whatever the command was blocked in, then releases the request. A process
   the command started that outlives it is not touched: a `serve` or a schedule
   is a realm member on purpose, and ending a realm's members for one request's
   departure would stop other requests' work in a shared VM."
  [argv cwd env conn-send id]
  (let [k (session-key)
        r (try
            (let [_loaded (BeamLisp.Loader/ensure_loaded "bl.daemon")
                  handler (BeamLisp.Env/fetch! "bl.daemon" "handle-in-vm")
                  r (handler argv cwd env)]
              (if (erlang/is_integer r) r 0))
            (catch e
              (do (conn-send (wire/stderr id 999999 (str "bl: " (ex-message e) "\n"))) 1)))]
    ;; before the answer, so a client that has it can ask which realms this
    ;; session has open
    (try (note-realm! k (erlang/get REQUEST-REALM)) (catch e nil))
    r))

(defn- dispatch-command [frame conn-send claim release]
  ;; frame = {:request id %{argv cwd env …}}
  (let [id (elem frame 1)
        m (elem frame 2)
        argv (to-list (:argv m))
        cwd (:cwd m)
        env (or (:env m) {})]
    ;; the command's stdout becomes :stdout frames on conn, through a group leader
    (let [worker (erlang/self)
          proxy (io/start-with-send conn-send id)
          prev-gl (erlang/group_leader)]
      (erlang/group_leader proxy worker)
      (net/arm-cancel!
        {:claim claim
         ;; after the watcher ended this process: what its finally would have done
         :cleanup (fn [] (io/finish proxy) (release))
         ;; the command runs here, so the client's proof of life comes from there
         :beat (fn [] (conn-send (wire/heartbeat id)))
         :every wire/HEARTBEAT-MS
         :abnormal (fn [reason]
                     (conn-send (wire/stderr id 999999 (str "bl: the command ended abnormally: " (pr-str reason) "\n")))
                     (conn-send (wire/exit id 1)))})
      (let [code (try
                   (run-command argv cwd env conn-send id)
                   (finally
                     (erlang/group_leader prev-gl worker)))]
        (io/finish proxy)
        code))))

(defn- boot-realm-services!
  "What a daemon runs besides its socket: the manager, the sequencer, and the
   facts the status read-model reports. Runs only AFTER the socket is ours — a
   start that lost the race must leave nothing of itself behind.

   A VM started for ONE project (`root`) opens that project's realm now, so its
   index is warm and its declared schedules fire before the first command: a daemon
   that sits warm overnight is exactly when a nightly prune should happen. A shared
   VM (`root` nil) has no project yet; each realm opens on its first request, which
   is the same `realm/open` call."
  [root k]
  (mgr/start)
  ;; the reload/intent sequencer (vm.exec): a watch commit and a dashboard intent
  ;; take turns here, never racing a program the daemon is running.
  (exec/start)
  (let [primary (primary? k)]
    (when (some? root)
      (note-realm! k (:root (realm/open root)))
      (when primary (erlang/apply :persistent_term :put (list PT-ROOT root))))
    (when primary (erlang/apply :persistent_term :put (list PT-STARTED (erlang/system_time :second))))))

(defn- busy?
  "Whether anything besides a running request is using this VM: a route a project
   holds that someone may open (not the VM's own console — see `idle/OWN-ROUTES`),
   or work a realm owns (a schedule, a `serve`, a `watch`; not its furniture — see
   `idle/FURNITURE-ROLES`). Either keeps it alive: a VM that serves a name or runs
   a job is not idle however quiet your terminal is."
  [k]
  (let [pid (erlang/list_to_integer (erlang/apply :os :getpid (list)))
        mine (idle/serving-claims (ports/list-claims) pid)
        vms (mgr/list-vms)]
    (or (draining? k) (> (count mine) 0)
        ;; work, not furniture: see `idle/active-members`
        (some (fn [vm] (> (count (idle/active-members (:id vm))) 0)) (to-list vms)))))

(defn- arm-idle!
  "Start the idle clock for `limit` seconds and remember its watcher. When it
   expires the VM stops itself the way `bl realm stop` does: it flips the stop flag
   the foreground loop is waiting on, so the same drain path runs."
  [limit k]
  (let [w (idle/start-watcher limit (fn [] (busy? k))
            (fn [] (println "bl realm: idle, stopping")
                   (request-stop! k)))]
    (when w
      (put-if-absent! PT-IDLE w)
      (update-live! (fn [m] (if (contains? m k) (assoc-in m [k :idle] w) m))))
    w))

(defn- release-start-marker!
  "The launcher wrote `.starting` before it spawned this VM so a second `bl` would
   not start another. This VM is listening now, so the marker has done its job."
  [root shared]
  (let [ep (paths/endpoints root (paths/build-id) shared)]
    (when (contains? ep :ok) (File/rm (:starting (:ok ep))))))

(defn start
  "Boot the warm VM for `root`: bind the socket first, and only if it is
   ours start the services behind it. Returns {:ok listener} | {:error reason};
   {:error :already-running} means a live daemon answers for this endpoint and
   NOTHING was started — attach to it. {:error :shared-needs-a-build} means a shared
   VM was asked of a source checkout (which runs its own sources and is never
   shared); {:error :no-root} means an own VM was asked with no project. `opts`
   {:idle seconds :log path :shared bool}:
   :idle arms the idle clock (0 or absent: the VM stays until stopped); :log is where
   this VM's output goes, recorded so `bl vm show` and `bl vm logs` can find it;
   :shared boots the build's SHARED VM, which needs no `root` (pass nil) and opens a
   realm per request."
  ([root] (start root {}))
  ([root opts]
   ;; the socket first, and the services after: binding is what decides who the
   ;; daemon is, so a start that loses must not have armed an index and a
   ;; scheduler it will never serve. The listener accepts at once, but a request
   ;; that arrives before the services are up waits on the manager like any other.
   (let [shared (= true (get opts :shared))
         k (erlang/make_ref)
         handler (fn [frame conn-send] (erlang/put PD-SESSION k) (request-handler frame conn-send))
         r (cond
             (and shared (= (paths/build-id) paths/SRC-BUILD))
             {:error :shared-needs-a-build}
             (and (not shared) (nil? root))
             {:error :no-root}
             ;; registered before the socket accepts, so its first request finds it
             :else (do (register-session! k (if shared nil root))
                       (let [l (net/listen root handler {:shared shared})]
                         (when-not (contains? l :ok) (unregister-session! k))
                         l)))]
     (if (contains? r :ok)
       (do (erlang/apply :persistent_term :put (list PT-CURRENT k))
           ;; a command's stderr is the client's stderr, as it is in a cold run
           (io/install-stderr-router!)
           ;; the flag is the VM's (the manager reads it); a session that did not set
           ;; it leaves it as it found it, and one that did clears it when it stops
           (when (and (= true (get opts :commands-only))
                      (put-if-absent! (tuple :vm_session :commands-only) true))
             (update-live! (fn [m] (assoc-in m [k :commands-only] true))))
           (try (boot-realm-services! (if shared nil root) k)
             (finally (boot-done! k)))
           ;; the HTTP face on :ui, a view over the same read-model. A failure
           ;; here does NOT stop the daemon: its job is serving commands, the
           ;; page is a view.
           (when (get opts :ui true) (start-ui root shared))
           ;; become visible to the machine: one record, written once. A failure
           ;; to publish costs `bl vm` a row (the old files still adopt this pid),
           ;; never the daemon its job.
           (publish-self! k (if shared nil root) (get opts :log))
           (release-start-marker! root shared)
           (arm-idle! (get opts :idle 0) k)
           {:ok (assoc (:ok r) :session k)})
       r))))

(defn- project-ui-port
  "The tree's declared :ui port, or nil for ephemeral. Reads the SPEC — the
   one reader that overlays .env.local.bl — so a local `{:ports {:ui N}}`
   pins the dashboard exactly as vm.spec's header promises (BUG-088: the
   bl.env/project reader bypassed the overlay and the pin silently lost)."
  [root]
  (let [pd (:ports (spec/read root))
        ui (if (map? pd) (get pd :ui) nil)]
    (cond (erlang/is_integer ui) ui
          (and (map? ui) (erlang/is_integer (get ui :port))) (get ui :port)
          :else nil)))

(defn- start-ui
  "The dashboard for the project this VM serves. A shared VM serves no single
   project, and the dashboard's pages read ONE root, so it starts none: a page
   that answered for the wrong realm would be worse than no page. Per-realm pages
   under one console are PLAN-158 step 12."
  [root shared]
  (when-not shared
   (try
    (let [want (or (project-ui-port root) 0)
          r (ports/claim "ui" want {:root root :hosts (to-list (names/hosts root "ui"))})]
      (when (contains? r :ok)
        ;; a name was claimed: make sure something answers it (never blocks, never fails the claim)
        (sdk-call "vm.gateway" "ensure-for-claim" (list (names/hosts root "ui")))
        (let [port (:ok r)
              ep (:ok (paths/endpoints root (paths/build-id) false))
              token (if (and ep (File/exists? (:token ep))) (File/read! (:token ep)) nil)]
          (sdk-call "vm.http" "serve"
            (list port {:root root :tree-id (paths/tree-id root)
                        :token token :started-at (erlang/system_time :second)})))))
    (catch e nil))))

(defn- publish-self!
  "Publish this VM's record and remember it on the listener so `stop` can retract
   exactly it. A VM is labelled with the project it was started for."
  [k root log]
  (try
    (let [r (registry/publish! :warm {:label (vm-label root) :log log})]
      (when (contains? r :ok)
        (put-if-absent! PT-RECORD (:ok r))
        (update-live! (fn [m] (if (contains? m k) (assoc-in m [k :record] (:ok r)) m)))))
    (catch e nil)))

(defn stop
  "Stop the daemon session's listener, and leave the registry: a clean stop
   removes the record, so only a crash ever leaves one for `prune` to find. The
   realms the session opened end with it (their index owners, wheels and members):
   a session that stopped listening but left them running would hold a project
   alive for nothing, and the next session in this process would inherit them.
   Pending work returns {:status :waiting :pending n}, retaining the listener,
   registry and idle watcher. New requests stay refused until stop is retried."
  [listener]
  (let [k (or (:session listener) (session-key))
        result (drain-session! k)]
   (if (= :waiting (:status result)) result
    (let [e (get (live) k)]
     (idle/stop-watcher (:idle e))
     (erase-if-mine! PT-IDLE (:idle e))
     (when (:record e) (registry/retract! (:record e)))
     (erase-if-mine! PT-RECORD (:record e))
     (when (:commands-only e) (erlang/apply :persistent_term :erase (list (tuple :vm_session :commands-only))))
     (erlang/apply :persistent_term :erase (list (tuple :vm_session :stop k)))
     (when (some? e) (unregister-session! k))
     (net/stop listener)))))
