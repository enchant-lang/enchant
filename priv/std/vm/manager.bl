; vm/manager.bl — the global daemon: one node, many project VMs.
;
; ══ THE TOPOLOGY THE DX WANTS ═══════════════════════════════════════════════
;
;   ONE global daemon (this defserver, node-registered :vm-manager)
;     ├── VM "blueprint@main"   (capped env + owned processes)
;     │     ├── :web      side-app  → http://blueprint.test
;     │     ├── :tooling  side-app  → http://tooling.blueprint.test
;     │     └── :runner   armed on demand → http://runner.blueprint.test
;     ├── VM "knowledger@main"
;     └── VM "blueprint@feature-x"   (same project, another instance)
;
; A command, by DEFAULT, attaches to this running global manager and is routed
; into the VM for its checkout — no per-command boot. If a caller wants an
; ISOLATED global VM instead (a clean node), that is a separate OS process
; running its own manager; nothing here assumes a singleton beyond the
; registered name, so a second node with its own name coexists.
;
; The manager is a SUPERVISOR-shaped owner of state, but it holds NO command
; worker and NO lock: a VM is an env, a command is a process under that env,
; and the BEAM schedules them. The manager's only job is the TABLE (id → VM)
; and the lifecycle verbs over it. Reading the table is a cast-free `call`;
; listing every VM is one message, not a directory scan.
;
;   (manager/start)                 ; boot the global daemon (idempotent)
;   (manager/ensure spec)           ; get-or-spawn the VM for a spec → vm
;   (manager/get id)                ; → vm | nil
;   (manager/list)                  ; → [vm …]   SEE THEM ALL
;   (manager/run id thunk)          ; route a command into VM id
;   (manager/serve id role thunk)   ; arm a side-app in VM id → pid
;   (manager/drain id)              ; tear one VM down
;   (manager/shutdown)              ; drain every VM, then stop the daemon

(ns vm.manager
  (:require [vm.core :as vmc] [vm.owner :as owner]
            [vm.paths :as paths]))

(def MANAGER :vm-manager)

(def SCOPE-ROW :manager_scope)

(defn- spec-identity [spec]
 ;; Display IDs and truncated module keys are routing hints, not authority to
 ;; reuse another project's environment or capabilities. Keep the full tree
 ;; fingerprint and execution-affecting spec beside the manager-owned entry.
 (assoc (select-keys spec [:key :decl :uses-paths :source-imports :source-paths :base :caps :max-heap-words :schedules])
        :tree (when (:root spec) (paths/fingerprint (:root spec)))))

(defn- conflict? [spec vms]
 (let [existing (get vms (:id spec)) identity (spec-identity spec)]
  (or (and existing (not= identity (:spec-identity existing)))
      (and (:key spec)
           (some (fn [vm]
                   (and (not= (:id vm) (:id spec)) (= (:key spec) (:key vm))))
                 (vals vms))))))

(defn- accepted [result]
 (cond
  (= :realm-identity-conflict (:error result))
  (throw (ex-info "realm identity conflicts with an open realm; close it before changing its specification"
                  {:reason :realm-identity-conflict}))
  (= :realm-draining (:error result))
  (throw (ex-info "realm still has consumers awaiting retirement" {:reason :realm-draining :id (:id result)}))
  :else result))

;; state: {:vms {id → vm-value}}
(defn unique-alias
  "`alias` made distinct from the aliases of the realms already open: `pulse`, then
   `pulse-2`, `pulse-3`. A nil alias stays nil (a bare spec is no realm). The alias is
   for people — URLs and the console — so two projects both called `pulse` stay
   addressable; the key, not the alias, names modules and registry rows."
  [alias vms]
  (if (nil? alias)
    nil
    (let [taken (set (keep :alias vms))]
      (loop [n 1]
        (let [candidate (if (= n 1) alias (str alias "-" n))]
          (if (contains? taken candidate) (recur (inc n)) candidate))))))

(defn- start-schedules! [vm]
  (when (and (seq (:schedules vm))
             (not (erlang/apply :persistent_term :get (list (tuple :vm_session :commands-only) false))))
    (BeamLisp.Loader/ensure_loaded "vm.sched")
    (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "vm.sched" "start-for") (list vm))))

(defn- caller-scope
  "The manager scope the CALLING env belongs to, or nil. A test runner (ward)
   binds one per file in the file's own env, so the VMs a file opens are the
   file's, and `shutdown` from inside it ends only those. The row lives in the
   env chain, so it follows the env into every process spawned under it and is
   gone with it."
  []
  (let [r (BeamLisp.Env/lookup (tuple SCOPE-ROW))]
    (if (and (erlang/is_tuple r) (erlang/== :ok (erlang/element 1 r)))
      (erlang/element 2 r)
      nil)))

(defn caller-scope-id
  "The manager scope of the calling env, or nil (see `caller-scope`). Part of
   `vm.realm`'s reopen key: a realm opened in one scope is not another's."
  []
  (caller-scope))

(defn- scoped
  "`spec` stamped with the caller's scope, unless it already names one."
  [spec]
  (let [scope (caller-scope)]
    (if (and (some? scope) (nil? (:scope spec))) (assoc spec :scope scope) spec)))

(defn- drain-vm
  "`vmc/drain` as this server's answer, never its exit. A drain runs inside the
   manager; one that raised ended the manager and its realm table with it, so
   `bl realm stop` printed \"stopped\" while the VM, its realm and its processes
   stayed up and nothing could retire them. A raising drain is kept as
   :draining with its reason, so the stop says why and can be retried."
  [vm]
  (try (vmc/drain vm)
    (catch e {:status :waiting :pending 0
              :error (let [m (ex-message e)] (if (string? m) m (pr-str e)))})))

(defn- shutdown-vms
  "Drain the VMs `scope` owns (all of them for a nil scope); keep pending ones
   as :draining and every VM of another scope untouched. Answers [reply state]."
  [st scope]
  (let [mine? (fn [vm] (or (nil? scope) (= scope (:scope vm))))
        targets (filter (fn [[_ vm]] (mine? vm)) (:vms st))
        others (into {} (filter (fn [[_ vm]] (not (mine? vm))) (:vms st)))
        results (mapv (fn [[id vm]] [id (drain-vm vm)]) targets)
        pending (into {} (keep (fn [[id result]]
                                (when (= :waiting (:status result))
                                 [id (assoc (get (:vms st) id) :status :draining)])) results))]
    [{:drained (- (count results) (count pending)) :pending (count pending)}
     (assoc st :vms (merge others pending))]))

(defserver daemon
  (init [_]
    (ok {:vms {}}))

  ;; get-or-spawn: idempotent by id, so two commands racing into the same
  ;; project both get the one VM (no double-spawn, no collision).
  ;;
  ;; ARMING is part of the spawn, not a step a caller might remember: the tree's
  ;; declared periodic work is a fact about the tree, and a VM is what a tree
  ;; means here. A project that declares none gets no process at all
  ;; (vm.sched/start-for answers nil), so the cost of this line is paid by
  ;; exactly the projects that asked for it.
  (handle-call [:ensure spec] [_from st]
    (let [id (:id spec)]
      (if (conflict? spec (:vms st))
        (reply {:error :realm-identity-conflict} st)
       (if (contains? (:vms st) id)
        (reply (if (= :draining (get-in st [:vms id :status]))
                 {:error :realm-draining :id id} (get (:vms st) id)) st)
        (let [vm (assoc (vmc/spawn-vm spec) :spec-identity (spec-identity spec) :scope (:scope spec))]
          (start-schedules! vm)
          (reply vm (assoc st :vms (assoc (:vms st) id vm))))))))

  ;; like :ensure, and says whether THIS call created the VM. The creator is the
  ;; one caller that must start the VM's services; deciding it inside the server
  ;; is what makes "exactly one" true when two first requests arrive together.
  (handle-call [:open spec] [_from st]
    (let [id (:id spec)]
      (if (conflict? spec (:vms st))
        (reply {:error :realm-identity-conflict} st)
       (if (contains? (:vms st) id)
        (reply (if (= :draining (get-in st [:vms id :status]))
                 {:error :realm-draining :id id}
                 {:vm (get (:vms st) id) :created false}) st)
        (let [vm (assoc (vmc/spawn-vm (assoc spec :alias (unique-alias (:alias spec) (vals (:vms st)))))
                        :spec-identity (spec-identity spec) :scope (:scope spec))]
          (start-schedules! vm)
          (reply {:vm vm :created true} (assoc st :vms (assoc (:vms st) id vm))))))))

  ;; One source version per physical project, in the existing realm table.
  ;; A document-only analysis realm has published no definitions, so its memo
  ;; survives edits. Executed project code requires a fresh realm on change.
  (handle-call [:observe-sources spec generation] [_from st]
    (let [identity (spec-identity spec)
          existing (some (fn [vm] (when (= (:tree identity) (:tree (:spec-identity vm))) vm))
                         (vals (:vms st)))
          changed (and existing (:source-generation existing)
                       (not= generation (:source-generation existing)))
          dirty (and changed (not= 0 (BeamLisp.Env/definition_revision (:env existing))))]
      (if (and existing (or (not= (:id spec) (:id existing)) (not= identity (:spec-identity existing)) dirty))
        (reply {:retire (:id existing)} st)
        (reply :current (if existing (assoc-in st [:vms (:id existing) :source-generation] generation) st)))))

  ;; Reservation and member creation are one manager turn. The child is owned
  ;; before a request can obtain it; initialization never blocks this manager.
  (handle-call [:service id slot identity thunk modules] [_from st]
    (let [vm (get (:vms st) id)
          previous (get-in vm [:services slot])
          live? (and previous (Process/alive? (:pid previous)))]
      (cond
        (nil? vm) (reply {:error :realm-closed :id id} st)
        (= :draining (:status vm)) (reply {:error :realm-draining :id id} st)
        (and live? (not= identity (:identity previous)))
        (reply {:error :service-identity-conflict :slot slot} st)
        live? (reply previous st)
        :else
        (let [entry {:pid (vmc/serve vm :service (fn [] (thunk (:env vm)))
                      (cons (elem (erlang/fun_info thunk :module) 1) modules)) :identity identity}]
          (reply entry (assoc-in st [:vms id :services slot] entry))))))

  (handle-call [:get id] [_from st]
    (reply (get (:vms st) id) st))

  (handle-call [:validate spec] [_from st]
    (reply (if (conflict? spec (:vms st)) {:error :realm-identity-conflict} :ok) st))

  (handle-call [:validate-root spec] [_from st]
    (let [existing (get (:vms st) (:id spec))]
      (reply (if (and existing
                      (not= (:tree (spec-identity spec)) (:tree (:spec-identity existing))))
               {:error :realm-identity-conflict} :ok) st)))

  (handle-call [:list] [_from st]
    (reply (vals (:vms st)) st))

  (handle-call [:drain id] [_from st]
    (if (contains? (:vms st) id)
      (let [r (drain-vm (get (:vms st) id))]
        (reply r (if (= :waiting (:status r))
                   (assoc-in st [:vms id :status] :draining)
                   (assoc st :vms (dissoc (:vms st) id)))))
      (reply {:halted 0} st)))

  ;; shutdown drains the VMs of ONE scope (see `caller-scope`), or every VM when
  ;; the caller has none — the node-wide end stays the one legitimate place a
  ;; daemon drains what it did not create. The scoped form is what lets a test
  ;; file close "its" manager without closing the realm that is running it.
  (handle-call [:shutdown] [_from st]
    (let [[answer st2] (shutdown-vms st nil)] (reply answer st2)))
  (handle-call [:shutdown scope] [_from st]
    (let [[answer st2] (shutdown-vms st scope)] (reply answer st2))))

(def ^:private LOCK-POLL-MS 2)

(defn trans
  "`global/trans` without its retry backoff: run `f` holding the lock `id`
   ({resource requester}, re-entrant for the same requester), on the same
   nodes. `:global` sleeps a random 0-250 ms after its first failed attempt,
   then up to 500 ms, 1 s and on. In a fresh VM the boot and the first request
   take the same locks (the manager's start, a realm's lifecycle), so the
   request slept through most of that backoff after the boot had released
   them (M3: 285 ms after `start`'s release). This polls every 2 ms instead."
  [id f]
  (let [nodes (erlang/apply :lists :append (list (list (erlang/node)) (erlang/nodes)))]
    (loop []
      (if (= true (global/set_lock id nodes 0))
        (try (f) (finally (global/del_lock id nodes)))
        (do (Process/sleep LOCK-POLL-MS) (recur))))))

(defn start
  "Boot the global daemon (idempotent by name). Returns its pid. The owner
   registry must exist before any VM spawns a member, so start it first.

   Two callers race the first start in every warm VM: the boot
   (`vm.session/boot-realm-services!`) and the first request
   (`bl.daemon/handle-in-vm`), since the listener accepts before the services
   are up. Checking the name and then starting let both start; the loser's
   request failed with `server failed to start: {:already_started, <manager>}`
   (about 1 in 3 fresh VMs once `prepare-drain!` widened the window). The
   check and the start now run under one lock, and the loser answers the
   winner's pid. Starting the owner registry stays the first step inside it,
   whether that start is eager or on demand."
  []
  (or (Process/whereis MANAGER)
      (trans (tuple :vm-manager-start (erlang/self))
        (fn []
          (or (Process/whereis MANAGER)
              (do (owner/start)
                  ;; What a drain calls is loaded now, before any request:
                  ;; loading an SDK namespace later can need a compile (a
                  ;; checkout VM's dev overlay, U15), and a drain must not
                  ;; depend on one succeeding. If it cannot load here, `drain`
                  ;; loads it itself, as it always did.
                  (try (vmc/prepare-drain!) (catch _ nil))
                  (core/start daemon nil {:name MANAGER})))))))

(defn ensure
  "Get-or-spawn the VM for `spec` (keyed by :id). Returns the VM value."
  [spec]
  (accepted (call MANAGER [:ensure (scoped spec)] :infinity)))

(defn open
  "Like `ensure`, answering {:vm vm :created bool}: `created` is true for exactly
   one caller per VM, however many ask at once."
  [spec]
  (accepted (call MANAGER [:open (scoped spec)] :infinity)))

(defn observe-sources
  "Observe project bytes under the realm lifecycle lock. Returns :current or
   {:retire id}; retirement itself uses the existing owned-process lifecycle."
  [spec generation]
  (call MANAGER [:observe-sources spec generation] :infinity))

(defn get-vm
  "The VM registered under `id`, or nil."
  [id]
  (call MANAGER [:get id]))

(defn validate-spec!
 "Refuse ambiguous project identity without creating or draining a realm."
 [spec]
 (accepted (call MANAGER [:validate spec])))

(defn validate-root!
 "Authorize project-scoped teardown by full tree identity. Changed declarations
  may still be drained; another project's colliding display ID may not."
 [spec]
 (accepted (call MANAGER [:validate-root spec])))

(defn list-vms
  "Every live VM — the read-model behind `bl vms`/`bl ps`."
  []
  (call MANAGER [:list]))

(defn run
  "Route a command `thunk` into VM `id` (it must exist). Runs under the VM's
   env, scoped so a `vm.scope/halt` ends only that VM. The 3-arg form binds
   `os-env` (the client's environment map) as this process's PROCESS-LOCAL env
   overlay, so concurrent commands with different env do not race."
  ([id thunk]
   (let [vm (get-vm id)]
     (if (nil? vm)
       (throw (ex-info (str "no VM: " id) {:id id}))
       (vmc/run vm thunk))))
  ([id os-env thunk]
   (let [vm (get-vm id)]
     (if (nil? vm)
       (throw (ex-info (str "no VM: " id) {:id id}))
       (vmc/run vm os-env thunk)))))

(defn serve
  "Arm a long-lived side-app in VM `id` under `role`. Returns the pid."
  [id role thunk]
  (let [vm (get-vm id)]
    (if (= :draining (:status vm))
      (accepted {:error :realm-draining :id id})
     (if (nil? vm)
      (throw (ex-info (str "no VM: " id) {:id id}))
      (vmc/serve vm role thunk)))))

(defn drain
  "Drain one VM. Pending consumers retain a :draining entry for explicit retry;
   completed retirement drops it. Returns core/drain's lifecycle status."
  [id]
  (call MANAGER [:drain id] :infinity))

(defn shutdown
  "Drain every VM the caller's scope owns (every VM when the caller has no
   scope, which is the node ending); retain pending entries. The daemon can stop
   only with zero :pending. Returns {:drained n :pending n}."
  []
  (let [scope (caller-scope)]
    (if (nil? scope)
      (call MANAGER [:shutdown] :infinity)
      (call MANAGER [:shutdown scope] :infinity))))
