; vm/net.bl — the AF_UNIX transport for a warm VM (ports Daemon.Listener).
;
; ══ WHAT MOVED HERE (FUP-082 T2/D2-D3) ══════════════════════════════════════
;
; The socket the daemon binds, the accept loop, the per-connection process, the
; 0600 perms guard, and the hello/token handshake — all beam-lisp now. Proven
; end-to-end: a bl server accepts a {packet,4} connection, decodes a frame with
; vm.wire, and frames a response back (see the net round-trip proof).
;
; It lives in `vm.*` because it is runtime substrate any host reuses, and —
; critically (K10: namespace state does NOT survive a hot reload) — the LISTEN
; SOCKET is owned by a long-lived process started via `listen`, NOT held as
; namespace state. A reload swaps the handler code; the socket and the accept
; loop keep running.
;
;   (net/listen root handler)   → {:ok listener} | {:error reason}
;       handler : (fn [frame conn-send] …)  called per decoded request frame;
;                 conn-send is (fn [bytes] …) to write a frame back.
;       {:error :already-running} when a LIVE daemon already answers on this
;       endpoint — the caller attaches to it; it is not a failure to report.
;   (net/answering? sock-path)  → true | false   does anything accept there?
;   (net/stop listener)         → :ok
;
; ══ ENDPOINT ADMISSION ══════════════════════════════════════════════════════
;
; A unix socket is a FILE, and binding over a file that exists is not an error
; here: `listen` used to unlink the path and bind, so a second start for the
; same endpoint took the path from the first (measured: both `listen`s returned
; {:ok …}, both accept loops lived, the path reached the second, and the first
; kept running unreachable). Two things close it:
;
;   • the bind happens under an OS-owned `.start` lease, so starters serialize;
;   • the acceptor holds a separate lifetime lease, preventing takeover while
;     it is alive even if it pauses or cannot answer a probe;
;   • inside the lock the existing path is PROBED, not trusted: something that
;     accepts is a live daemon (→ :already-running); something that refuses is
;     the leftover of a crash and is reclaimed. Other probe failures preserve it.
;
; Owner/VM death releases the OS descriptor. Persistent lease inodes are never
; unlinked; no timestamp or age grants ownership. New binds rotate credentials.

(ns vm.net
  (:require [vm.wire :as wire] [vm.paths :as paths] [os.lease :as lease]))

(def LISTEN-BACKLOG
  "How many connections may wait to be accepted. The OS default is a handful, and a
   burst of requests (a test run starting, an editor and a build at once) overflows it:
   the surplus connects are reset before the VM ever sees them. Measured: 80 simultaneous
   clients, 5 of 6 bursts lost between 1 and 27 of them at the default; none lost at 128.
   One connection is one short-lived process, so a deep queue costs nothing."
  128)

(defn- listen-opts [charlist]
  ;; Erlang 2-tuple opts (NEVER bl maps — a bl-map opt gives {:exit :badarg}).
  (list (tuple :inet_backend :inet)
        :local
        (tuple :ifaddr (tuple :local charlist))
        :binary
        (tuple :packet 4)
        (tuple :active false)
        (tuple :backlog LISTEN-BACKLOG)
        (tuple :reuseaddr true)))

(defn- connect-opts []
  (list (tuple :inet_backend :inet) :local :binary (tuple :packet 4) (tuple :active false)))

;; How long a starter waits for another starter's bind to finish, how often it
;; looks, and how old a lock must be before its holder is presumed dead. The wait
;; is generous (a bind takes milliseconds; a loaded host stretches it), the stale
;; age is an operational recovery heuristic, not proof that its holder died.
(def LOCK-WAIT-MS 5000)
(def LOCK-POLL-MS 25)
(def PROBE-TIMEOUT-MS 500)

(defn probe
  "Observe an endpoint without treating uncertainty as permission to remove it.
   :live | :dead | {:unknown reason}. Only absence or connection refusal proves
   death. Timeout, permissions, resource pressure and malformed paths are unknown."
  [sock-path]
  (try
    (let [r (gen_tcp/connect (tuple :local (erlang/binary_to_list sock-path)) 0
              (connect-opts) PROBE-TIMEOUT-MS)]
      (cond
        (= :ok (elem r 0)) (do (gen_tcp/close (elem r 1)) :live)
        (contains? #{:enoent :econnrefused} (elem r 1)) :dead
        :else {:unknown (elem r 1)}))
    (catch e {:unknown :probe-exception})))

(defn answering?
  "Whether a probe confirms a live listener. False includes unknown results;
   use `probe` when deciding whether an endpoint may be reclaimed."
  [sock-path]
  (= :live (probe sock-path)))

;; ── the start lock ──────────────────────────────────────────────────────────

(defn- acquire-owner [path]
  ;; A just-dead acceptor's port helper may still be observing EOF. Wait for OS
  ;; release, never infer release from age or remove the owning lock inode.
  (let [deadline (+ (erlang/monotonic_time :millisecond) PROBE-TIMEOUT-MS)]
    (loop []
      (let [r (lease/acquire! path)]
        (if (and (= :busy (:error r)) (< (erlang/monotonic_time :millisecond) deadline))
          (do (Process/sleep LOCK-POLL-MS) (recur)) r)))))

(defn- with-start-lock
  "Serialize bind/cleanup under an OS lease. A paused owner retains ownership;
   process death releases it. Never remove/recreate the persistent lock inode."
  [path f]
  (let [deadline (+ (erlang/monotonic_time :millisecond) LOCK-WAIT-MS)]
    (loop []
      (let [r (lease/acquire! path)]
        (if-let [held (:ok r)]
          (try (f) (finally (lease/release! held)))
          (if (and (= :busy (:error r)) (< (erlang/monotonic_time :millisecond) deadline))
            (do (Process/sleep LOCK-POLL-MS) (recur))
            {:error (if (= :busy (:error r)) :start-lock-timeout (:error r))}))))))

(defn- frame-recv [conn timeout-ms]
  (let [r (gen_tcp/recv conn 0 timeout-ms)]
    (if (= :ok (elem r 0)) {:ok (elem r 1)} {:error (elem r 1)})))

(defn- frame-send [conn payload]
  (gen_tcp/send conn payload))

;; ── the per-connection handler ──────────────────────────────────────────────
;;
;; hello first (authenticated: the token file's bytes must match), then a
;; request loop. The connection process owns its socket for its whole life; it
;; dies when the client disconnects, taking nothing else with it.

(defn- serve-conn [conn expect token handler mine]
  (let [hello (frame-recv conn 5000)]
    (when (some? (:ok hello))
      (let [decoded (wire/decode (:ok hello))
            frame (:ok decoded)]
        (if (and (some? frame) (= :hello (elem frame 0)))
          (let [m (elem frame 1)
                given (:token m)
                tree (:tree m)
                asked (:build m)]
            (cond
              (not (and (erlang/is_binary given)
                        (= (erlang/byte_size given) (erlang/byte_size token))
                        (erlang/apply :crypto :hash_equals (list given token))
                        (= tree expect)))
              (frame-send conn (wire/reject :unauthorized "bad token or wrong tree" {}))

              ;; A client that names a build is told when this is not it. The
              ;; endpoint names already carry the build, so reaching here means
              ;; a file was renamed or a client computed the name by hand; the
              ;; answer is the same either way: this VM must not run its command.
              (and (some? asked) (not= asked mine))
              (frame-send conn (wire/reject :restart_required
                                 (str "this daemon runs build " mine ", not " asked)
                                 {:build mine}))

              (and (some? (:checkout_generation m))
                   (not= (:checkout_generation m) (System/get_env "BL_CHECKOUT_GENERATION")))
              (frame-send conn (wire/reject :restart_required
                                 "checkout sources changed; restart required" {}))

              :else
              (do
                ;; ready — the handshake meta. No queue/busy (PLAN-121): attach.
                (frame-send conn (wire/ready {:pid (erlang/list_to_binary (erlang/apply :os :getpid (list)))
                                              :build mine
                                              :checkout_generation (System/get_env "BL_CHECKOUT_GENERATION")
                                              :queue_depth 0 :busy nil}))
                (serve-requests conn handler))))
          (frame-send conn (wire/reject :malformed "expected hello" {})))))))

;; ── a client that went away is told to the request ─────────────────────────
;;
;; One request per connection, and after the request is read nothing reads the
;; socket again, so a client killed mid-command (timeout -s KILL, Ctrl+C, a closed
;; terminal) was never noticed: its command ran on, holding whatever it held. A
;; watcher now polls the socket and acts when the peer is gone.
;;
;; F2: the command runs in the connection's own process (no second owned start,
;; ~1 ms). That process cannot wait for its client and run a command at once, so
;; the handler ARMS the watcher (`arm-cancel!`) for the time the command runs:
;;
;;   • the client leaves → the watcher claims the request (`claim!`), ends the
;;     connection process with `:client_gone`, waits for it, then runs the
;;     handler's cleanup itself, since a process ended from outside skips its
;;     `finally`;
;;   • the connection process dies on its own (a linked exit, a kill) → the same
;;     claim and cleanup, and the client is told the command ended abnormally,
;;     because the watcher owns the socket and it is still open;
;;   • the command stays quiet → the watcher sends its heartbeat.
;;
;; The claim is one atomics cell per request: whoever moves it from 0 to 1 first
;; (the watcher, or the handler finishing) releases the request's custody, once.
;; Unarmed (a control request), a gone client is still told with `:client_gone`.
;;
;; The poll is a zero-length `recv` with a short timeout on a passive socket: it
;; consumes nothing (the client sends no further frame on this connection) and
;; returns `{:error :closed}` the moment the peer is gone.

(def CLIENT-POLL-MS 200)
(def CLIENT-GONE :client_gone)
(def ^:private WATCHER :vm_net_watcher)

(defn client-gone?
  "Whether the peer of `conn` has closed it. Consumes nothing."
  [conn]
  (let [r (gen_tcp/recv conn 0 CLIENT-POLL-MS)]
    (and (= :error (elem r 0)) (not= :timeout (elem r 1)))))

(defn new-claim
  "A request's custody claim: one atomics cell, 0 while unclaimed."
  []
  (erlang/apply :atomics :new (list 1 (to-list [(tuple :signed false)]))))

(defn claim!
  "Take request custody `claim`. True for exactly one caller."
  [claim]
  (= :ok (erlang/apply :atomics :compare_exchange (list claim 1 0 1))))

(defn arm-cancel!
  "Arm this connection's watcher while a command runs in THIS process. `armed`:
   {:claim cell :cleanup (fn []) :beat (fn []) :every ms :abnormal (fn [reason])}.
   `cleanup` runs in the watcher after it ended this process; `abnormal` after
   this process died by itself, to tell the client. Returns whether a watcher
   was there to arm."
  [armed]
  (let [w (erlang/get WATCHER)]
    (if (erlang/is_pid w)
      (do (erlang/send w (tuple :vm_net_arm armed)) true)
      false)))

(defn- await-down [mref ms]
  (receive
    [:DOWN r :process _p _why] :when (= r mref) true
    (after ms false)))

(defn- take-over!
  "Claim an armed request whose process is ending or must end: end `worker`
   with `reason` unless it is already `down`, wait for it, run the cleanup.
   A command that traps exits is killed after a second. Answers whether this
   call held the claim."
  [armed worker mref reason down]
  (when (claim! (:claim armed))
    (when-not down
      (erlang/exit worker reason)
      (when-not (await-down mref 1000)
        (erlang/exit worker :kill)
        (await-down mref 5000)))
    (try ((:cleanup armed)) (catch _ nil))
    true))

(defn- watch-client
  "Spawn the watcher of `conn` for its connection process `worker` (above).
   Ends by itself when `worker` does. Returns the watcher's pid."
  [conn worker]
  ;; A plain BEAM process: it runs only SDK namespace code (the poll, the
  ;; handler's cleanup), so it needs no env conveyance or execution registration,
  ;; which cost a request ~0.6 ms of the owned-start protocol.
  (erlang/spawn (fn []
           (let [mref (erlang/monitor :process worker)]
             ;; `gone`: the client left before the handler armed this watcher (the
             ;; first poll can see it within the first 200 ms); an arm that comes
             ;; after takes the request over at once
             (loop [armed nil next-beat 0 gone false]
               (let [m (receive
                         [:vm_net_arm a] (tuple :arm a)
                         [:DOWN r :process _p why] :when (= r mref) (tuple :down why)
                         (after (if gone :infinity 0) nil))]
                 (cond
                   (and (some? m) (= :down (elem m 0)))
                   ;; the connection process ended: a normal end released its
                   ;; own claim; anything else is ours to release and report
                   (when (and (some? armed) (take-over! armed worker mref :ended true))
                     (try ((:abnormal armed) (elem m 1)) (catch _ nil)))

                   (and (some? m) (= :arm (elem m 0)))
                   (let [a (elem m 1)]
                     (if gone
                       (take-over! a worker mref CLIENT-GONE false)
                       (recur a (+ (erlang/monotonic_time :millisecond) (:every a)) false)))

                   (client-gone? conn)
                   (if (some? armed)
                     (take-over! armed worker mref CLIENT-GONE false)
                     (do (erlang/send worker CLIENT-GONE) (recur nil 0 true)))

                   (and (some? armed) (>= (erlang/monotonic_time :millisecond) next-beat))
                   (do (try ((:beat armed)) (catch _ nil))
                       (recur armed (+ (erlang/monotonic_time :millisecond) (:every armed)) false))

                   :else (recur armed next-beat false))))))))

(defn- serve-requests [conn handler]
  (let [req (frame-recv conn 1800000)]  ; 30min read window (a test can run long)
    (when (some? (:ok req))
      (let [decoded (wire/decode (:ok req))
            frame (:ok decoded)
            watcher (watch-client conn (erlang/self))]
        ;; The watcher owns the socket from here, so it is still open to tell the
        ;; client when this process dies under its command. This process keeps
        ;; reading and writing it (an inet socket serves any process).
        (gen_tcp/controlling_process conn watcher)
        (erlang/put WATCHER watcher)
        ;; :request → the command handler; :control → status/stop
        (when (some? frame)
          (handler frame (fn [bytes] (frame-send conn bytes))))
        (erlang/erase WATCHER)
        ;; one request per connection (the launcher opens a fresh conn each time)
        (gen_tcp/close conn)
        (erlang/exit watcher :kill)))))

;; ── the accept loop (a long-lived process, NOT namespace state) ─────────────

(defn await-connection-start
  "Internal handoff worker. Only the transferring parent may release serving.
   Parent death before release ends the worker and closes any transferred socket."
  [parent ticket conn serve]
  (let [ref (erlang/monitor :process parent)]
    (try
      (receive
        [:connection-start received] :when (= received ticket)
        (do (erlang/demonitor ref (list :flush)) (serve))
        [:DOWN received :process _pid _reason] :when (= received ref)
        :parent-stopped)
      (finally
        (erlang/demonitor ref (list :flush))
        (gen_tcp/close conn)))))

(defn handoff-connection
  "Internal ownership boundary: serving starts only after a successful transfer.
   The acceptor subscribes to no worker notifications. Failure closes both sides."
  [conn serve]
  (let [parent (erlang/self) ticket (erlang/make_ref)
        worker (spawn (fn [] (await-connection-start parent ticket conn serve)))]
    (try
      (let [result (gen_tcp/controlling_process conn worker)]
        (if (= :ok result)
          (do (erlang/send worker (tuple :connection-start ticket)) {:ok worker})
          (do (gen_tcp/close conn) (erlang/exit worker :kill) {:error result})))
      (catch error
        (gen_tcp/close conn)
        (erlang/exit worker :kill)
        (throw error)))))

(defn await-spare-start
  "Internal: a connection worker started BEFORE its connection arrives. It
   serves the one connection its accept loop transfers with `ticket`, and ends
   with that loop."
  [parent ticket serve]
  (let [ref (erlang/monitor :process parent)]
    (receive
      [:connection-start received conn] :when (= received ticket)
      (do (erlang/demonitor ref (list :flush))
          (try (serve conn) (finally (gen_tcp/close conn))))
      [:DOWN received :process _pid _reason] :when (= received ref)
      :parent-stopped)))

(defn- start-spare
  "An owned connection worker, waiting for the next connection: {:pid :ticket}.
   The owned start (~1 ms) is paid between requests, not inside one (F2)."
  [serve]
  (let [parent (erlang/self) ticket (erlang/make_ref)]
    {:pid (spawn (fn [] (await-spare-start parent ticket serve))) :ticket ticket}))

(defn- hand-to-spare
  "Give `conn` to the waiting worker. Answers whether it took it; on false the
   caller still owns `conn`."
  [spare conn]
  (and (some? spare)
       (= :ok (try (gen_tcp/controlling_process conn (:pid spare)) (catch _ :failed)))
       (do (erlang/send (:pid spare) (tuple :connection-start (:ticket spare) conn)) true)))

(defn- accept-loop
  ([lsock expect token handler build]
   (accept-loop lsock expect token handler build nil))
  ([lsock expect token handler build spare]
   (let [serve (fn [conn] (serve-conn conn expect token handler build))
         spare (or spare (start-spare serve))
         ar (gen_tcp/accept lsock 5000)]
     (cond
       (= :ok (elem ar 0))
       (let [conn (elem ar 1)]
         (when-not (hand-to-spare spare conn)
           ;; the spare is gone: start this connection's worker the old way
           (handoff-connection conn (fn [] (serve conn))))
         (accept-loop lsock expect token handler build nil))

       ;; timeout: keep looping (lets the process see a close)
       (= :timeout (elem ar 1))
       (accept-loop lsock expect token handler build spare)

       :else :stopped))))

(defn- bind-endpoint
  "Bind `sock-path`, chmod it, mint the token if absent, start accepting, and
   write the meta. Called only under the start lock, after the path was probed.
   `expect` is the hello :tree value a client must present."
  [root expect handler paths-map]
  (let [sock-path (:sock paths-map)
        token-path (:token paths-map)
        charlist (erlang/binary_to_list sock-path)]
    ;; reaching here means nothing answers: whatever file is at the path is the
    ;; leftover of a daemon that died without unlinking it
    (File/rm sock-path)
    (let [lr (gen_tcp/listen 0 (listen-opts charlist))]
      (if (not= :ok (elem lr 0))
        {:error (elem lr 1)}
        (let [lsock (elem lr 1)]
          (try
            (File/chmod sock-path 384)  ; 0o600
            (File/write! token-path (erlang/apply :crypto :strong_rand_bytes (list 32)))
            (File/chmod token-path 384)
            ;; Publish endpoint metadata before releasing acceptance. Identity
            ;; and listening-socket lifetime belong to the bound acceptor.
            (let [token (File/read! token-path) build (:build paths-map)
                  generation (tuple (erlang/apply :os :getpid (list)) (erlang/make_ref))]
              (write-meta! (:meta paths-map) root build generation)
              (let [handed (handoff-connection lsock
                             (fn [] (accept-loop lsock expect token handler build)))
                    pid (:ok handed)]
                (if pid
                  {:ok {:lsock lsock :pid pid :sock-path sock-path
                        :token-path token-path :meta-path (:meta paths-map)
                        :lock-path (:lock paths-map) :generation generation}}
                  (do (File/rm sock-path) (File/rm (:meta paths-map)) handed))))
            (catch error
              (gen_tcp/close lsock)
              (File/rm sock-path)
              (File/rm (:meta paths-map))
              (throw error))))))))

(defn listen
  "Bind the daemon socket for `root` and accept connections, dispatching each
   decoded request frame to `handler` (fn [frame conn-send]). Returns
   {:ok {:lsock :pid :sock-path}} | {:error reason}. The socket is chmod 0600 —
   the security boundary is file perms + the hello token.

   `opts` {:shared true} binds the SHARED endpoint of this build, which serves
   every shared project of the user and needs no `root` (pass nil): the realm is
   chosen per request. Without it the endpoint is the one for `root`.

   One daemon per endpoint: when a live daemon already answers there, returns
   {:error :already-running} and touches nothing of it."
  ([root handler] (listen root handler {}))
  ([root handler opts]
   (let [shared (= true (get opts :shared))
         build (paths/build-id)
         ep (paths/endpoints root build shared)]
     (if (nil? (:ok ep))
       ep
       (let [paths-map (:ok ep)
             expect (paths/hello-fingerprint root build shared)]
         (with-start-lock (:lock paths-map)
           (fn []
             (let [state (probe (:sock paths-map))]
               (cond
                 (= :live state) {:error :already-running}
                 (= :dead state)
                  (let [ownership (acquire-owner (str (:lock paths-map) ".owner"))]
                    (if-let [held (:ok ownership)]
                      (try
                        (let [bound (bind-endpoint root expect handler paths-map)]
                          (if-let [listener (:ok bound)]
                            (try
                              (lease/transfer! held (:pid listener))
                              bound
                              (catch e
                                (gen_tcp/close (:lsock listener))
                                (erlang/exit (:pid listener) :kill)
                                (lease/release! held)
                                (throw e)))
                            (do (lease/release! held) bound)))
                        (catch e (lease/release! held) (throw e)))
                      {:error (if (= :busy (:error ownership)) :already-running (:error ownership))}))
                 :else {:error (tuple :endpoint-probe-unknown (:unknown state))})))))))))

(defn- write-meta!
  "Publish complete endpoint metadata or raise, removing scratch on failure."
  [path root build generation]
  (let [tmp (str path ".tmp." (erlang/apply :os :getpid (list)))]
    (try
      (File/write! tmp (erlang/term_to_binary
                         {:pid (erlang/list_to_integer (erlang/apply :os :getpid (list)))
                          :root root :build build :generation generation
                          :started_at (erlang/system_time :second)}))
      (File/chmod tmp 384)
      (File/rename! tmp path)
      (finally (File/rm tmp)))))

(defn read-meta
  "The `.meta` term at `path` ({:pid :root :build :started_at}), or nil when it
   is absent or not one."
  [path]
  (let [r (try (File/read! path) (catch e nil))
        term (if (erlang/is_binary r) (try (BeamLisp.Env/decode_data_term! r) (catch e nil)) nil)]
    (if (and (map? term) (contains? term :build) (contains? term :root)) term nil)))

(defn stop
  "Close this listener's port; unlink files only while its generation still
   owns the endpoint under the same lock that protects binding. Legacy handles
   lacking ownership evidence close their port and leave reclamation to bind."
  [listener]
  (gen_tcp/close (:lsock listener))
  (when (and (:generation listener) (:lock-path listener) (:meta-path listener))
    (with-start-lock (:lock-path listener)
      (fn []
        (when (= (:generation listener) (:generation (read-meta (:meta-path listener))))
          (File/rm (:sock-path listener))
          (when (:token-path listener) (File/rm (:token-path listener)))
          (File/rm (:meta-path listener))))))
  :ok)
