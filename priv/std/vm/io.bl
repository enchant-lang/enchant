; vm/io.bl — a per-request group-leader proxy (ports Daemon.IO).
;
; ══ WHAT MOVED HERE (FUP-082 T2/D2-D3) ══════════════════════════════════════
;
; A command's stdout/stdin must become wire frames. This is a process running
; the Erlang I/O-server protocol: set as a command's group leader, every
; put_chars (IO.puts, a printed value) becomes a :stdout frame, every get_line
; becomes a :stdin request. It is pure BEAM message protocol — bl implements it
; the same way Elixir did. Output is chunked ≤64KiB and sent SYNCHRONOUSLY, so a
; slow client applies backpressure instead of growing the daemon heap.
;
;   (io/start conn id)          → proxy pid; set a worker's group_leader to it
;   (io/finish proxy)           → the final seq (flush marker)

(ns vm.io
  (:require [vm.wire :as wire]))

(def CHUNK 65536)

(defn- send-chunks [send-fn id stream seq bin]
  (if (= 0 (erlang/byte_size bin))
    seq
    (let [take (erlang/min CHUNK (erlang/byte_size bin))
          chunk (erlang/apply :binary :part (list bin 0 take))
          rest (erlang/apply :binary :part (list bin take (- (erlang/byte_size bin) take)))
          frame (if (= stream :stderr) (wire/stderr id seq chunk) (wire/stdout id seq chunk))]
      (send-fn frame)                     ; synchronous = bounded backpressure
      (send-chunks send-fn id stream (+ seq 1) rest))))

(defn- normalize [chars]
  (cond
    (erlang/is_binary chars) chars
    ;; chardata, not iodata: io_lib:format("~ts", ["✓"]) yields code points
    ;; above 255, which iolist_to_binary refuses and a daemon would then drop
    ;; the whole request's output on.
    (erlang/is_list chars) (erlang/apply :unicode :characters_to_binary (list chars))
    :else (erlang/apply :unicode :characters_to_binary
            (list (erlang/apply :io_lib :format (list "~p" (list chars)))))))

(defn request-chars
  "The text a `:put_chars` io request carries, as a binary. FOUR shapes arrive:
   `{:put_chars chars}`, `{:put_chars enc chars}`, and the two CALL forms
   `{:put_chars m f args}` / `{:put_chars enc m f args}` -- the one `io:format`
   sends: the I/O server is expected to MAKE the call (`io_lib:format(\"~ts~n\",
   [x])`) to get the text. Taking the last element of a call form yields the
   ARGUMENT LIST, which is how a daemon answered `(println 1)` with `~ts~n1`."
  [req]
  (let [n (erlang/tuple_size req)]
    (cond
      (= n 5) (normalize (erlang/apply (elem req 2) (elem req 3) (elem req 4)))
      (and (= n 4) (erlang/is_atom (elem req 1)) (erlang/is_atom (elem req 2)))
      (normalize (erlang/apply (elem req 1) (elem req 2) (elem req 3)))
      :else (normalize (elem req (- n 1))))))

;; handle one io_request body → {reply new-seq}
(defn- handle-io [send-fn id seq req stream]
  (cond
    ;; {:put_chars, enc, chars} | {:put_chars, chars}
    (and (erlang/is_tuple req) (= :put_chars (elem req 0)))
    (tuple :ok (send-chunks send-fn id stream seq (request-chars req)))

    ;; setopts / getopts / geometry — benign replies
    (and (erlang/is_tuple req) (= :setopts (elem req 0))) (tuple :ok seq)
    (= req :getopts) (tuple (list (tuple :binary true) (tuple :encoding :unicode)) seq)
    (and (erlang/is_tuple req) (= :get_geometry (elem req 0)))
    (tuple (if (= :columns (elem req 1)) 80 24) seq)

    ;; get_line / get_chars → stdin request (kept minimal: EOF for now)
    (and (erlang/is_tuple req)
         (contains? #{:get_line :get_chars :get_until} (elem req 0)))
    (tuple :eof seq)

    :else (tuple (tuple :error :request) seq)))

(declare drain-late-stderr unpublish-proxy!)

(defn- io-loop [send-fn id seq]
  (receive
    [:io_request from reply-as req]
    (let [r (handle-io send-fn id seq req :stdout)]
      (erlang/send from (tuple :io_reply reply-as (elem r 0)))
      (io-loop send-fn id (elem r 1)))

    ;; a write to :standard_error by a process this proxy leads, routed here by
    ;; the stderr router: same connection, same order as the stdout around it
    [:bl_stderr_request from reply-as req]
    (let [r (handle-io send-fn id seq req :stderr)]
      (erlang/send from (tuple :io_reply reply-as (elem r 0)))
      (io-loop send-fn id (elem r 1)))

    [:finish from ref]
    (do (erlang/send from (tuple :finished ref seq)) (drain-late-stderr))

    (after 1800000 (unpublish-proxy! (erlang/self)))))

;; ── stderr: one router in front of the VM's :standard_error ────────────────
;;
;; `IO.puts(:stderr, …)`, `io:format(standard_error, …)` and every library that
;; reports on stderr address ONE registered process for the whole VM. In a warm VM
;; that is the VM's log, so a command's error — written by the CLI on stderr, as a
;; cold run writes it — never reached the client that ran it. The router takes the
;; registered name; a request from a process whose group leader is a live request
;; proxy becomes that request's :stderr frames, and every other request goes to the
;; original device untouched. Call sites stay as they are: a cold VM has no router
;; and its :standard_error is the terminal.

(def PROXIES :bl_vm_io_proxies)
(def PT-ORIGINAL (tuple :vm_io :standard_error))
(def PT-ROUTER (tuple :vm_io :stderr_router))

(defn- original-stderr []
  (erlang/apply :persistent_term :get (list PT-ORIGINAL :undefined)))

(defn- publish-proxy! [pid]
  (when (not (= :undefined (ets/whereis PROXIES)))
    (ets/insert PROXIES (tuple pid)))
  pid)

(defn- unpublish-proxy! [pid]
  (when (not (= :undefined (ets/whereis PROXIES)))
    (ets/delete PROXIES pid))
  :ok)

(defn- drain-late-stderr
  "After the flush marker, a stderr write the router forwarded before the proxy
   left the table may still arrive. Its writer is blocked on the reply, so it goes
   to the original device and is answered; nothing waits forever on a proxy that
   is gone."
  []
  (receive
    [:bl_stderr_request from reply-as req]
    (let [device (original-stderr)]
      (if (erlang/is_pid device)
        (erlang/send device (tuple :io_request from reply-as req))
        (erlang/send from (tuple :io_reply reply-as :ok)))
      (drain-late-stderr))
    (after 1000 :ok)))

(defn- route-stderr [original msg]
  (if (and (erlang/is_tuple msg) (= 4 (erlang/tuple_size msg)) (= :io_request (elem msg 0)))
    (let [from (elem msg 1)
          gl (if (erlang/is_pid from)
               (let [info (erlang/process_info from :group_leader)]
                 (if (erlang/is_tuple info) (elem info 1) :undefined))
               :undefined)]
      (if (and (erlang/is_pid gl) (ets/member PROXIES gl))
        (erlang/send gl (tuple :bl_stderr_request from (elem msg 2) (elem msg 3)))
        (erlang/send original msg)))
    (erlang/send original msg)))

(defn- router-loop [original]
  (receive
    msg (do (try (route-stderr original msg) (catch _ (erlang/send original msg)))
            (router-loop original))))

(defn install-stderr-router!
  "Put the request-aware router in front of this VM's :standard_error. Idempotent;
   call once when a warm VM starts serving. Returns the router pid."
  []
  (let [existing (erlang/apply :persistent_term :get (list PT-ROUTER :undefined))]
    (if (and (erlang/is_pid existing) (erlang/is_process_alive existing)
             (= existing (erlang/whereis :standard_error)))
      existing
      (let [original (erlang/whereis :standard_error)
            parent (erlang/self)
            router (spawn
                     (fn []
                       (ets/new PROXIES (list :named_table :public :set (tuple :read_concurrency true)))
                       (erlang/send parent (tuple :bl_stderr_router_ready (erlang/self)))
                       (router-loop original)))]
        (receive
          [:bl_stderr_router_ready r] :ok
          (after 5000 :ok))
        (erlang/apply :persistent_term :put (list PT-ORIGINAL original))
        (erlang/apply :persistent_term :put (list PT-ROUTER router))
        ;; a process holds one registered name, so the router is known by
        ;; persistent_term and takes only :standard_error
        (when (erlang/is_pid original)
          (erlang/unregister :standard_error)
          (erlang/register :standard_error router))
        router))))

(defn start-with-send
  "Spawn a group-leader proxy for request `id` that emits frames via `send-fn`
   (a 1-arg fn taking framed bytes). Returns the proxy pid; set a worker's group
   leader to it with erlang/group_leader. Under the stderr router, the stderr of
   every process it leads streams back as :stderr frames."
  [send-fn id]
  (publish-proxy! (spawn (fn [] (io-loop send-fn id 0)))))

(defn finish
  "Flush marker: tell the proxy no more output is coming; returns the final seq.
   The proxy leaves the stderr table first, so later stderr writes by processes
   it still leads go to the VM's own stderr."
  [proxy]
  (unpublish-proxy! proxy)
  (let [ref (erlang/apply :erlang :make_ref (list))]
    (erlang/send proxy (tuple :finish (erlang/self) ref))
    (receive
      [:finished r seq] seq
      (after 5000 0))))
