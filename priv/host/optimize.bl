; optimize.bl — the checked-rewrite home for canonical bl-ANF, and the pinned
; HOST MODULE for `Elixir.BeamLisp.Optimize` (natively the namespace
; host.optimize: research/native-seed/speed/facts/closure-additions.edn).
;
; Public API: module / node for compilation, explain for evidence, rules for
; discovery. Facts are derived from executable ANF, never author annotations.
; The boot pass is deterministic, bounded and solver-independent: its rules
; instantiate structural/inductive laws with checked domain preconditions.
; Unknown callables, live providers and observable lazy ownership stay baseline.
; Every fact (integer/boolean tags, ranges, callable arities, closed integer
; callbacks, guard refinement) comes from the FACTS section below, which native
; emission reads too; the rest of this file owns only the rewrite
; preconditions and the rewrites.
(ns host.optimize)

(defn version [] "optimize-4")
(defn- runtime-module [] :Elixir.BeamLisp.Ns.Rt)

(defn- map [f xs] (BeamLisp.CompilerData/eager_map f xs))
(defn- getv [m k] (if (erlang/is_map m) (maps/get k m nil) nil))
(defn- put [m k v] (maps/put k v m))
(defn- item [xs i] (erlang/hd (lists/nthtail i xs)))
(defn- op? [n op] (erlang/== op (getv n :op)))
(defn- lit? [n v] (and (op? n :lit) (erlang/=:= v (getv n :val))))
(defn- call? [n mod fun] (and (op? n :remote) (erlang/== mod (getv n :mod)) (erlang/== fun (getv n :fun))))
(defn- named? [n name] (and (op? n :var) (erlang/== name (getv n :name))))

(defn rules
  "The optimizer's owned rule vocabulary. This is descriptive, not authority:
   executable preconditions are checked again for every candidate."
  []
  (list
    {:rule :own-module :law :literal-closure-module :proof :structural}
    {:rule :native-call :law :fixed-native-arity :proof :structural}
    {:rule :numeric-domain :law :non-map-numeric-dispatch :proof :domain}
    {:rule :integer-callback :law :integer-fold-invariant :proof :induction}
    {:rule :strict-map-fold :law :total-map-fold-composition :proof :induction}
    {:rule :strict-first-filter :law :private-total-filter-first :proof :induction}))

;; ══ FACTS: the shared ANF fact pass (round 3, E1) ══════════════════════════
;
; One conservative fact pass over canonical bl-ANF, read by both backends: the
; rewrites below (BEAM) and native.scheme (native emission, which calls
; BeamLisp.Optimize/expr, bind, forget, refine, int-fact? and bool-fact?).
; Facts come from executable ANF and lexical scope only, never from author
; annotations, and no solver runs at compile time. An absent fact means
; UNKNOWN, and unknown is always a correct answer. It lives in this pinned
; host because the optimizer runs while the boot namespaces are compiled, and a
; new pinned host would change the bootstrap floor's compiler-key inputs.
;
; A FACT is a map. Value keys (what a binding holds):
;   :tag       :int | :bool | :float | :number | :integer-list (absent: unknown)
;   :lo :hi    inclusive integer bounds, only with :tag :int (absent: unbounded)
;   :arity     a callable value of exactly this native arity
;   :callback  the closed total integer callback (its literal fn node)
; Evaluation keys (what evaluating the expression may do), from `expr`:
;   :raise?    false only when evaluation cannot raise
;   :footprint :pure when evaluation has no effect besides raising, else :unknown
; An environment maps a Source name to its value fact. Shadowing replaces or
; removes the name, so a stale fact never survives a rebinding.
;
; The per-binding report is `function-facts`. Validation (D4, translation
; validation, FL51) is research/native-seed/speed/facts/validate.bl: it checks
; these facts against formal.elaboration/check and formal.core, in tests.


(defn facts-version [] "facts-1")

(defn- listing
  "A finite ANF collection as an Erlang list, or nil when it is not one."
  [xs]
  (cond (erlang/is_list xs) xs
        (nil? xs) (list)
        (vector? xs) (BeamLisp.Vector/to_list xs)
        :else nil))
(defn- args-of [n] (listing (getv n :args)))
(defn- arity-is? [n k] (let [args (args-of n)] (and (some? args) (erlang/== k (erlang/length args)))))

(defn- pure [f] (put (put f :raise? false) :footprint :pure))
(defn- opaque [f] (put (put f :raise? true) :footprint :unknown))
(defn- value-of
  "The value part of a fact: what a binding of it holds."
  [f] (maps/remove :footprint (maps/remove :raise? f)))

; —— accessors ————————————————————————————————————————————————————————————

(defn tag [f] (getv f :tag))
(defn int-fact? [f] (erlang/== :int (getv f :tag)))
(defn bool-fact? [f] (erlang/== :bool (getv f :tag)))
(defn raise? [f] (not (erlang/== false (getv f :raise?))))
(defn pure? [f] (erlang/== :pure (getv f :footprint)))
(defn range-of [f] (when (int-fact? f) {:lo (getv f :lo) :hi (getv f :hi)}))

; —— integer ranges ———————————————————————————————————————————————————————

(defn- int-fact [lo hi]
  (let [f {:tag :int}
        f (if (some? lo) (put f :lo lo) f)]
    (if (some? hi) (put f :hi hi) f)))
(defn- add-bound [a b] (when (and (some? a) (some? b)) (erlang/+ a b)))
(defn- sub-bound [a b] (when (and (some? a) (some? b)) (erlang/- a b)))
(defn- smaller [a b] (if (erlang/< a b) a b))
(defn- larger [a b] (if (erlang/> a b) a b))
(defn- arithmetic-range [operator a b]
  (let [alo (getv a :lo) ahi (getv a :hi) blo (getv b :lo) bhi (getv b :hi)]
    (cond
      (erlang/== operator :+) (int-fact (add-bound alo blo) (add-bound ahi bhi))
      (erlang/== operator :-) (int-fact (sub-bound alo bhi) (sub-bound ahi blo))
      (and (some? alo) (some? ahi) (some? blo) (some? bhi))
        (let [p (erlang/* alo blo) q (erlang/* alo bhi) r (erlang/* ahi blo) s (erlang/* ahi bhi)]
          (int-fact (smaller (smaller p q) (smaller r s)) (larger (larger p q) (larger r s))))
      :else (int-fact nil nil))))
(defn- join-bound [a b low?]
  (when (and (some? a) (some? b)) (if low? (smaller a b) (larger a b))))
(defn- join-facts
  "The least fact true of both branches' values."
  [a b]
  (let [t (getv a :tag)]
    (cond
      (and (erlang/== :int t) (int-fact? b))
        (int-fact (join-bound (getv a :lo) (getv b :lo) true) (join-bound (getv a :hi) (getv b :hi) false))
      (and (some? t) (erlang/== t (getv b :tag))) {:tag t}
      :else {})))

; —— recognised operations ————————————————————————————————————————————————

(defn integer-op?
  "A two-operand integer + - * (canonical :arith or an erlang BIF): on two
   integers it returns an integer and cannot raise."
  [n]
  (and (or (op? n :arith) (and (op? n :remote) (erlang/== :erlang (getv n :mod))))
       (lists/member (if (op? n :arith) (getv n :bif) (getv n :fun)) (list :+ :- :*))
       (arity-is? n 2)))
(defn- operator-of [n] (if (op? n :arith) (getv n :bif) (getv n :fun)))

(defn- erlang? [n fun k]
  (and (op? n :remote) (erlang/== :erlang (getv n :mod)) (erlang/== fun (getv n :fun)) (arity-is? n k)))
(defn- erlang-comparison?
  "Erlang term comparison: total over all terms, always a boolean."
  [n]
  (and (op? n :remote) (erlang/== :erlang (getv n :mod)) (arity-is? n 2)
       (lists/member (getv n :fun) (list :< :> :"=<" :>= :== :"=:=" :"/=" :"=/="))))
(defn- type-test? [n]
  (and (op? n :remote) (erlang/== :erlang (getv n :mod)) (arity-is? n 1)
       (lists/member (getv n :fun) (list :is_integer :is_float :is_number :is_binary :is_bitstring :is_boolean
                                         :is_atom :is_tuple :is_list :is_map :is_function :is_pid :is_port
                                         :is_reference))))
(defn- fact-arith-comparison?
  "The canonical numeric comparison, with its exact BIF pair. On numbers it
   returns a boolean; on anything else it raises."
  [n]
  (and (op? n :arith) (arity-is? n 2)
       (cond
         (erlang/== :lt (getv n :fun)) (erlang/== :< (getv n :bif))
         (erlang/== :gt (getv n :fun)) (erlang/== :> (getv n :bif))
         (erlang/== :le (getv n :fun)) (erlang/== :"=<" (getv n :bif))
         (erlang/== :ge (getv n :fun)) (erlang/== :>= (getv n :bif))
         (erlang/== :num_eq (getv n :fun)) (erlang/== :== (getv n :bif))
         :else false)))
(defn- numeric? [f] (lists/member (getv f :tag) (list :int :float :number)))

(defn- integer-list? [xs]
  (cond
    (erlang/== xs (list)) true
    (erlang/is_list xs) (and (erlang/is_integer (erlang/hd xs)) (integer-list? (erlang/tl xs)))
    :else false))


; —— callable facts ———————————————————————————————————————————————————————

(defn- scaffold-body [n]
  (when (op? n :let)
    (let [name (getv n :name) init (getv n :init) cls (getv init :clauses) body (getv n :body)]
      (when (and (op? init :fn) (erlang/is_list cls) (erlang/== 1 (erlang/length cls)))
        (let [cl (erlang/hd cls) pats (getv cl :pats) args (getv body :args)]
          (when (and (nil? (getv cl :guard)) (erlang/is_list pats) (erlang/== 1 (erlang/length pats))
                     (erlang/== :pvar (getv (erlang/hd pats) :pop))
                     (erlang/== name (getv (erlang/hd pats) :name))
                     (op? body :apply) (named? (getv body :fn) name)
                     (erlang/is_list args) (erlang/== 1 (erlang/length args)) (named? (erlang/hd args) name))
            (getv cl :body)))))))

(defn literal-fn
  "The literal fn of a fn node or of the compiler's self-application scaffold."
  [n]
  (if (op? n :fn) n
    (let [body (scaffold-body n)] (when (op? body :fn) body))))

(defn native-arity
  "The one native arity every clause of a literal fn shares, else nil."
  [n]
  (let [f (literal-fn n) cls (getv f :clauses)]
    (when (and (some? f) (erlang/is_list cls) (not (erlang/== cls (list))))
      (let [argc (erlang/length (getv (erlang/hd cls) :pats))]
        (when (lists/all (fn [cl] (erlang/== argc (erlang/length (getv cl :pats)))) cls) argc)))))

(declare closed-int?)
(defn closed-int?
  "Total integer expressions over this explicit lexical domain. No globals,
   mutable reads, guards, division, captured unknowns or callable annotations."
  [n env]
  (cond
    (op? n :lit) (erlang/is_integer (getv n :val))
    (op? n :var) (erlang/== :int (getv (maps/get (getv n :name) env {}) :tag))
    (integer-op? n) (lists/all (fn [arg] (closed-int? arg env)) (getv n :args))
    (op? n :let) (and (closed-int? (getv n :init) env)
                      (closed-int? (getv n :body) (put env (getv n :name) {:tag :int})))
    :else false))

(defn expression-fuel
  "Remaining node fuel for the supported integer-expression grammar, or nil.
   Stops before descending beyond the bound, including deeply nested bodies."
  [n left]
  (when (erlang/> left 0)
    (cond
      (or (op? n :lit) (op? n :var)) (erlang/- left 1)
      (integer-op? n)
        (let [a (expression-fuel (item (getv n :args) 0) (erlang/- left 1))]
          (when (some? a) (expression-fuel (item (getv n :args) 1) a)))
      (op? n :let)
        (let [a (expression-fuel (getv n :init) (erlang/- left 1))]
          (when (some? a) (expression-fuel (getv n :body) a)))
      :else nil)))

(defn- distinct-names? [names]
  (cond
    (erlang/== names (list)) true
    :else (and (not (lists/member (erlang/hd names) (erlang/tl names)))
               (distinct-names? (erlang/tl names)))))

(defn int-callback
  "A closed total integer callback of `argc` parameters, within a bounded node
   budget. A variable resolves to the callback recorded in its DEFINITION-scope
   fact, never to the current meaning of its name; that fn is closed over its own
   parameters, so re-materializing it elsewhere captures nothing."
  [n argc env]
  (let [src (if (op? n :var)
              (getv (maps/get (getv n :name) env {}) :callback) n)
        f (literal-fn src) cls (getv f :clauses)]
    (when (and (some? f) (erlang/is_list cls) (erlang/== 1 (erlang/length cls)))
      (let [cl (erlang/hd cls) pats (getv cl :pats)]
        (when (and (nil? (getv cl :guard)) (erlang/== argc (erlang/length pats))
                   (lists/all (fn [p] (and (erlang/== :pvar (getv p :pop))
                                          (not (erlang/== "_" (getv p :name))))) pats))
          (let [names (BeamLisp.CompilerData/eager_map (fn [p] (getv p :name)) pats)
                inner (lists/foldl (fn [name e] (put e name {:tag :int})) {} names)]
            (when (and (distinct-names? names)
                       (some? (expression-fuel (getv cl :body) 64))
                       (closed-int? (getv cl :body) inner))
              {:fn f :clause cl :names names})))))))

; —— the expression fact ——————————————————————————————————————————————————


(defn- tag-of [n env] (getv (maps/get (getv n :name) env {}) :tag))

(defn refine
  "`env` where `test` is known truthy (the then-branch of an :if, a guard)."
  [env test]
  (let [args (args-of test)]
    (cond
      ; (if a b false/nil): both a and b hold in the then-branch.
      (and (op? test :if) (let [e (getv test :else)] (and (op? e :lit) (or (nil? (getv e :val)) (erlang/== false (getv e :val))))))
        (refine (refine env (getv test :test)) (getv test :then))
      (nil? args) env
      (and (call? test :erlang :is_function) (erlang/== 2 (erlang/length args))
           (op? (item args 0) :var) (op? (item args 1) :lit)
           (erlang/is_integer (getv (item args 1) :val)) (erlang/>= (getv (item args 1) :val) 0))
        (put env (getv (item args 0) :name) {:arity (getv (item args 1) :val)})
      (and (op? test :remote) (erlang/== :erlang (getv test :mod))
           (lists/member (getv test :fun) (list :is_integer :is_float :is_number))
           (erlang/== 1 (erlang/length args)) (op? (item args 0) :var))
        (let [name (getv (item args 0) :name)
              t (cond (erlang/== :is_integer (getv test :fun)) :int
                      (erlang/== :is_float (getv test :fun)) :float :else :number)]
          ; A known integer keeps its range under a redundant is_integer.
          (if (and (erlang/== t :int) (erlang/== :int (tag-of (item args 0) env))) env
            (put env name {:tag t})))
      :else env)))

(declare infer)
(defn- infer-all
  "Facts of `ns` in order: {:facts list :raise? bool :pure? bool :fuel n}."
  [ns env fuel]
  (loop [rest ns out (list) raises false pure true left fuel]
    (if (erlang/== rest (list))
      {:facts (lists/reverse out) :raise? raises :pure? pure :fuel left}
      (let [p (infer (erlang/hd rest) env left) f (elem p 0)]
        (recur (erlang/tl rest) (cons f out) (or raises (raise? f)) (and pure (pure? f)) (elem p 1))))))
(defn- with-children [f children]
  (let [f (put f :raise? (or (not (erlang/== false (getv f :raise?))) (getv children :raise?)))]
    (put f :footprint (if (and (erlang/== :pure (getv f :footprint)) (getv children :pure?)) :pure :unknown))))

(defn- infer-operation
  "A recognised operation over already inferred argument facts, or nil."
  [n env facts]
  (let [a (when (erlang/is_list facts) (when (not (erlang/== facts (list))) (erlang/hd facts)))
        b (when (and (some? a) (not (erlang/== (erlang/tl facts) (list)))) (erlang/hd (erlang/tl facts)))]
    (cond
      (integer-op? n)
        (if (and (int-fact? a) (int-fact? b)) (pure (arithmetic-range (operator-of n) a b)) {})
      (erlang-comparison? n) (pure {:tag :bool})
      (type-test? n) (pure {:tag :bool})
      (fact-arith-comparison? n) (if (and (numeric? a) (numeric? b)) (pure {:tag :bool}) (put (opaque {:tag :bool}) :footprint :pure))
      (erlang? n :not 1) (if (bool-fact? a) (pure {:tag :bool}) (put (opaque {:tag :bool}) :footprint :pure))
      (or (erlang? n :div 2) (erlang? n :rem 2))
        (if (and (int-fact? a) (int-fact? b)) (put (opaque {:tag :int}) :footprint :pure) {})
      (and (call? n :lists :seq) (lists/member (erlang/length (args-of n)) (list 2 3))
           (lists/all (fn [f] (int-fact? f)) facts))
        (opaque {:tag :integer-list})
      (and (call? n :lists :map) (arity-is? n 2)
           (some? (int-callback (item (args-of n) 0) 1 env))
           (erlang/== :integer-list (getv b :tag)))
        (opaque {:tag :integer-list})
      :else nil)))

;; Fuel is charged only where this pass recurses beyond the original tag
;; lattice (:let, :if, :do and the non-arithmetic operations). Literal lists,
;; cons chains and integer + - * trees cost nothing, exactly as before, so a
;; large expression loses only the new facts, never an old one.
(defn- infer
  "{fact, fuel}: the fact of `n` under `env`, spending at most `fuel`."
  [n env fuel]
  (cond
    (op? n :var) (tuple (pure (maps/get (getv n :name) env {})) fuel)
    (op? n :lit)
      (let [v (getv n :val)]
        (tuple (pure (cond (erlang/is_integer v) (int-fact v v)
                           (erlang/is_float v) {:tag :float}
                           (or (erlang/== v true) (erlang/== v false)) {:tag :bool}
                           (integer-list? v) {:tag :integer-list}
                           :else {}))
               fuel))
    (op? n :enil) (tuple (pure {:tag :integer-list}) fuel)
    (op? n :cons)
      (let [h (infer (getv n :head) env fuel) t (infer (getv n :tail) env (elem h 1))
            hf (elem h 0) tf (elem t 0)
            value (if (and (int-fact? hf) (erlang/== :integer-list (getv tf :tag))) {:tag :integer-list} {})]
        (tuple (with-children (pure value) {:raise? (or (raise? hf) (raise? tf)) :pure? (and (pure? hf) (pure? tf))})
               (elem t 1)))
    (some? (native-arity n))
      ; A literal fn (or its scaffold) only allocates a closure.
      (let [k (native-arity n) cb (when (lists/member k (list 1 2)) (int-callback n k env))]
        (tuple (pure (if (some? cb) {:arity k :callback (getv cb :fn)} {:arity k})) fuel))
    (integer-op? n)
      (let [r (infer-all (args-of n) env fuel) facts (getv r :facts)]
        (tuple (with-children (infer-operation n env facts) r) (getv r :fuel)))
    (erlang/=< fuel 0) (tuple (opaque {}) 0)
    (op? n :let)
      (let [i (infer (getv n :init) env (erlang/- fuel 1)) inf (elem i 0)
            b (infer (getv n :body) (put env (getv n :name) (value-of inf)) (elem i 1)) bf (elem b 0)]
        (tuple (with-children (pure (value-of bf)) {:raise? (or (raise? inf) (raise? bf)) :pure? (and (pure? inf) (pure? bf))})
               (elem b 1)))
    (op? n :if)
      (let [t (infer (getv n :test) env (erlang/- fuel 1)) tf (elem t 0)
            y (infer (getv n :then) (refine env (getv n :test)) (elem t 1)) yf (elem y 0)
            e (infer (getv n :else) env (elem y 1)) ef (elem e 0)]
        (tuple (with-children (pure (join-facts yf ef))
                 {:raise? (or (raise? tf) (or (raise? yf) (raise? ef))) :pure? (and (pure? tf) (and (pure? yf) (pure? ef)))})
               (elem e 1)))
    (op? n :do)
      (let [stmts (listing (getv n :stmts))]
        (if (or (nil? stmts) (erlang/== stmts (list)))
          (tuple (opaque {}) (erlang/- fuel 1))
          (let [r (infer-all stmts env (erlang/- fuel 1))]
            (tuple (with-children (pure (value-of (lists/last (getv r :facts)))) r) (getv r :fuel)))))
    (or (op? n :arith) (op? n :remote))
      (let [args (args-of n)]
        (if (nil? args) (tuple (opaque {}) (erlang/- fuel 1))
          (let [r (infer-all args env (erlang/- fuel 1))
                f (infer-operation n env (getv r :facts))]
            (tuple (if (some? f) (with-children f r) (opaque {})) (getv r :fuel)))))
    :else (tuple (opaque {}) fuel)))

(defn expr
  "The fact of evaluating `n` under `env`: its value facts plus :raise? and
   :footprint. Bounded: a large expression is unknown, never expensive."
  [n env]
  (elem (infer n env 64) 0))

; —— environments —————————————————————————————————————————————————————————

(defn bind
  "`env` with `name` bound to the value of `init`. Always replaces: a binding
   with no fact removes any outer fact of the same name."
  [env name init]
  (put env name (value-of (expr init env))))

(defn forget
  "`env` without the given names (every Scheme or BEAM binder of a Source name)."
  [env names]
  (lists/foldl (fn [name acc] (maps/remove name acc)) env names))

(defn pattern-names [p]
  (cond
    (erlang/== :pvar (getv p :pop)) (if (erlang/== "_" (getv p :name)) (list) (list (getv p :name)))
    (or (erlang/== :ptuple (getv p :pop)) (erlang/== :pstruct (getv p :pop)))
      (if (erlang/== :ptuple (getv p :pop))
        (lists/append (BeamLisp.CompilerData/eager_map (fn [x] (pattern-names x)) (getv p :elems)))
        (lists/append (BeamLisp.CompilerData/eager_map (fn [kv] (pattern-names (second kv))) (getv p :fields))))
    (erlang/== :pcons (getv p :pop)) (erlang/++ (pattern-names (getv p :head)) (pattern-names (getv p :tail)))
    (erlang/== :palias (getv p :pop)) (erlang/++ (pattern-names (getv p :a)) (pattern-names (getv p :b)))
    (erlang/== :pmap (getv p :pop)) (lists/append (BeamLisp.CompilerData/eager_map (fn [kv] (pattern-names (second kv))) (getv p :pairs)))
    :else (list)))

(defn shadow
  "`env` without every name the patterns bind."
  [env pats]
  (forget env (lists/append (BeamLisp.CompilerData/eager_map (fn [p] (pattern-names p)) pats))))

; —— the per-binding report ———————————————————————————————————————————————

(declare facts-walk)
(defn- facts-walk-all [ns env acc]
  (lists/foldl (fn [n a] (facts-walk n env a)) acc (or (listing ns) (list))))
(defn- facts-walk-clauses [cls env acc]
  (lists/foldl (fn [cl a]
                 (let [scoped (shadow env (or (listing (getv cl :pats)) (list)))
                       a (facts-walk (getv cl :guard) scoped a)]
                   (facts-walk (getv cl :body) (refine scoped (getv cl :guard)) a)))
               acc (or (listing cls) (list))))
(defn- facts-walk
  "Accumulate {:bindings reversed-list :visited n} over `n`, in source
   (pre-)order, threading the lexical environment as both backends do."
  [n env acc]
  (cond
    (not (erlang/is_map n)) acc
    (erlang/>= (getv acc :visited) 100000) (put acc :limited? true)
    :else
      (let [acc (put acc :visited (erlang/+ 1 (getv acc :visited))) op (getv n :op)]
        (cond
          (erlang/== op :let)
            (let [f (expr (getv n :init) env)
                  acc (put acc :bindings (cons {:name (getv n :name) :fact f :ann (getv n :ann)} (getv acc :bindings)))
                  acc (facts-walk (getv n :init) env acc)]
              (facts-walk (getv n :body) (put env (getv n :name) (value-of f)) acc))
          (erlang/== op :if)
            (let [acc (facts-walk (getv n :test) env acc) acc (facts-walk (getv n :then) (refine env (getv n :test)) acc)]
              (facts-walk (getv n :else) env acc))
          (erlang/== op :fn) (facts-walk-clauses (getv n :clauses) env acc)
          (erlang/== op :case) (facts-walk-clauses (getv n :clauses) env (facts-walk (getv n :subj) env acc))
          (erlang/== op :recv)
            (facts-walk (getv n :after) env (facts-walk (getv n :timeout) env (facts-walk-clauses (getv n :clauses) env acc)))
          (erlang/== op :try)
            (facts-walk (getv n :after) env (facts-walk-clauses (getv n :catch) env (facts-walk (getv n :body) env acc)))
          (or (erlang/== op :remote) (erlang/== op :arith)) (facts-walk-all (getv n :args) env acc)
          (erlang/== op :apply) (facts-walk-all (getv n :args) env (facts-walk (getv n :fn) env acc))
          (erlang/== op :invoke) (facts-walk (getv n :arguments) env (facts-walk (getv n :callee) env acc))
          (erlang/== op :do) (facts-walk-all (getv n :stmts) env acc)
          (erlang/== op :tuple) (facts-walk-all (getv n :elems) env acc)
          (erlang/== op :cons) (facts-walk (getv n :tail) env (facts-walk (getv n :head) env acc))
          (or (erlang/== op :map) (erlang/== op :struct))
            (lists/foldl (fn [kv a] (let [kv (listing kv)]
                                      (if (and (some? kv) (erlang/== 2 (erlang/length kv)))
                                        (facts-walk (second kv) env (facts-walk (first kv) env a)) a)))
                         acc (or (listing (getv n (if (erlang/== op :map) :pairs :fields))) (list)))
          :else acc))))

(defn- function-clauses [node]
  (cond
    (erlang/== :defn-clause (getv node :op))
      (list {:pats (getv node :params) :guard (getv node :guard) :body (getv node :body)})
    :else (or (listing (getv (literal-fn node) :clauses)) (list))))

(defn function-facts
  "Per-binding facts for one ANF function: a fn node, the compiler's
   self-application scaffold, or a :defn-clause. `params` is an optional list
   of value facts for the parameters of a single clause of plain variables
   (default: every parameter unknown). Returns
     {:version :params [{:name :fact}] :bindings [{:name :fact :ann}]
      :result fact :limited? bool}
   with bindings in source pre-order (a let before its init's lets), across
   every clause and nested fn. :result is the fact of a single clause's body."
  ([node] (function-facts node (list)))
  ([node params]
   (let [params (or (listing params) (list))
         cls (function-clauses node)
         single (when (erlang/== 1 (erlang/length cls)) (erlang/hd cls))
         pats (or (listing (getv single :pats)) (list))
         plain (and (some? single)
                    (lists/all (fn [p] (erlang/== :pvar (getv p :pop))) pats)
                    (erlang/== (erlang/length pats) (erlang/length params)))
         env (if plain
               (loop [ps pats fs params e {}]
                 (if (erlang/== ps (list)) e
                   (recur (erlang/tl ps) (erlang/tl fs)
                          (put e (getv (erlang/hd ps) :name) (value-of (erlang/hd fs))))))
               {})
         acc (if plain
               (facts-walk (getv single :body) (refine env (getv single :guard))
                     (facts-walk (getv single :guard) env {:bindings (list) :visited 0}))
               (facts-walk-clauses cls {} {:bindings (list) :visited 0}))]
     {:version (facts-version)
      :params (if plain (BeamLisp.CompilerData/eager_map (fn [p] {:name (getv p :name) :fact (maps/get (getv p :name) env {})}) pats) (list))
      :bindings (lists/reverse (getv acc :bindings))
      :result (if (some? single)
                (expr (getv single :body) (refine (shadow env (if plain (list) pats)) (getv single :guard)))
                (opaque {}))
      :limited? (erlang/== true (getv acc :limited?))})))

;; ══ end of FACTS ═══════════════════════════════════════════════════════════

(defn- scalar-value? [v]
  (or (erlang/is_integer v) (erlang/is_float v) (erlang/is_binary v)
      (erlang/is_atom v)))

(defn- arith-comparison?
  "Prove the executable comparison BIF, with its canonical numeric-tower pair.
   A label alone cannot establish totality; noncanonical arithmetic keeps its
   reference form rather than gaining authority from either field alone."
  [n]
  (cond
    (erlang/== :lt (getv n :fun)) (erlang/== :< (getv n :bif))
    (erlang/== :gt (getv n :fun)) (erlang/== :> (getv n :bif))
    (erlang/== :le (getv n :fun)) (erlang/== :"=<" (getv n :bif))
    (erlang/== :ge (getv n :fun)) (erlang/== :>= (getv n :bif))
    (erlang/== :num_eq (getv n :fun)) (erlang/== :== (getv n :bif))
    :else false))

(defn- comparison? [n]
  (and (erlang/is_list (getv n :args)) (erlang/== 2 (erlang/length (getv n :args)))
       (or (and (op? n :arith) (arith-comparison? n))
           (and (op? n :remote) (erlang/== :erlang (getv n :mod))
                (lists/member (getv n :fun) (list :< :> :"=<" :>= :== :"=:=" :"/=" :"=/="))))))

(defn- predicate-fuel
  "A total, effect-free scalar expression, with a bounded structural proof.
   Only explicit parameters and locals are in scope. Strict boolean BIFs,
   arithmetic over unknown scalar types, globals and captures remain unknown."
  [n scope left]
  (when (erlang/> left 0)
    (cond
      (op? n :lit) (when (scalar-value? (getv n :val)) (erlang/- left 1))
      (op? n :var) (when (maps/is_key (getv n :name) scope) (erlang/- left 1))
      (comparison? n)
        (let [a (predicate-fuel (item (getv n :args) 0) scope (erlang/- left 1))]
          (when (some? a) (predicate-fuel (item (getv n :args) 1) scope a)))
      (op? n :if)
        (let [t (predicate-fuel (getv n :test) scope (erlang/- left 1))
              y (when (some? t) (predicate-fuel (getv n :then) scope t))]
          (when (some? y) (predicate-fuel (getv n :else) scope y)))
      (op? n :let)
        (let [a (predicate-fuel (getv n :init) scope (erlang/- left 1))]
          (when (some? a) (predicate-fuel (getv n :body) (put scope (getv n :name) true) a)))
      :else nil)))

(defn- total-predicate? [n]
  (let [f (literal-fn n) cls (getv f :clauses)]
    (when (and (some? f) (erlang/is_list cls) (erlang/== 1 (erlang/length cls)))
      (let [cl (erlang/hd cls) pats (getv cl :pats)]
        (and (nil? (getv cl :guard)) (erlang/== 1 (erlang/length pats))
             (erlang/== :pvar (getv (erlang/hd pats) :pop))
             (not (erlang/== "_" (getv (erlang/hd pats) :name)))
             (some? (predicate-fuel (getv cl :body) {(getv (erlang/hd pats) :name) true} 64)))))))

(defn- scalar-list? [xs left]
  (cond
    (erlang/== xs (list)) true
    (erlang/=< left 0) false
    (erlang/is_list xs) (and (scalar-value? (erlang/hd xs))
                             (scalar-list? (erlang/tl xs) (erlang/- left 1)))
    :else false))

(defn- materialized-scalars? [n left]
  (cond
    (erlang/=< left 0) false
    (op? n :enil) true
    (op? n :lit) (scalar-list? (getv n :val) left)
    (op? n :cons) (and (op? (getv n :head) :lit) (scalar-value? (getv (getv n :head) :val))
                       (materialized-scalars? (getv n :tail) (erlang/- left 1)))
    (and (call? n :lists :seq) (erlang/== 2 (erlang/length (getv n :args))))
      (let [a (item (getv n :args) 0) b (item (getv n :args) 1)]
        (and (op? a :lit) (op? b :lit)
             (erlang/is_integer (getv a :val)) (erlang/is_integer (getv b :val))
             (erlang/=< (getv a :val) (getv b :val))))
    :else false))

; —— checked laws ————————————————————————————————————————————————————————

(defn- unpack [n]
  (cond
    (op? n :enil) {:args (list)}
    (op? n :cons) (let [tail (unpack (getv n :tail))]
                   (when (some? tail) {:args (cons (getv n :head) (getv tail :args))}))
    :else nil))

(defn- own-module [n mod]
  (let [args (getv n :args)]
    (when (and (some? mod) (call? n :erlang :element) (erlang/== 2 (erlang/length args)) (lit? (item args 0) 2))
      (let [fi (item args 1) fa (getv fi :args)]
        (when (and (call? fi :erlang :fun_info) (erlang/== 2 (erlang/length fa))
                   (some? (literal-fn (item fa 0))) (lit? (item fa 1) :module))
          (put (BeamLisp.Ns.Anf/lit mod) :ann (getv n :ann)))))))

(defn- numeric-domain [n env]
  (when (and (op? n :arith)
             (lists/all (fn [arg] (lists/member (getv (expr arg env) :tag) (list :int :float :number))) (getv n :args)))
    (put (BeamLisp.Ns.Anf/remote :erlang (getv n :bif) (getv n :args)) :ann (getv n :ann))))

(defn- int-expression [n]
  (cond
    (integer-op? n) (put (BeamLisp.Ns.Anf/remote :erlang (if (op? n :arith) (getv n :bif) (getv n :fun))
                                   (map (fn [arg] (int-expression arg)) (getv n :args))) :ann (getv n :ann))
    (op? n :let) (put (put n :init (int-expression (getv n :init))) :body (int-expression (getv n :body)))
    :else n))

(defn- replace-var [n old new]
  (cond
    (named? n old) (put new :ann (getv n :ann))
    (integer-op? n) (put n :args (map (fn [arg] (replace-var arg old new)) (getv n :args)))
    (op? n :let)
      (put (put n :init (replace-var (getv n :init) old new)) :body
           (if (erlang/== old (getv n :name)) (getv n :body) (replace-var (getv n :body) old new)))
    :else n))

(defn- all-names [n]
  (cond
    (op? n :var) (list (getv n :name))
    (integer-op? n) (lists/append (map (fn [arg] (all-names arg)) (getv n :args)))
    (op? n :let) (cons (getv n :name) (erlang/++ (all-names (getv n :init)) (all-names (getv n :body))))
    :else (list)))

(defn- mapped-name [names]
  (loop [i 0]
    (let [name (erlang/iolist_to_binary (list "__bl_opt_mapped_" (erlang/integer_to_binary i)))]
      (if (lists/member name names) (recur (erlang/+ i 1)) name))))

(defn- integer-fold-candidate
  "A safe integer fold: callback (literal or alias) in the callback grammar and
   accumulator/list domains proven. Returns the callback, else nil."
  [n env]
  (when (and (call? n :lists :foldl) (erlang/== 3 (erlang/length (getv n :args))))
    (let [args (getv n :args) f (int-callback (item args 0) 2 env)]
      (when (and (some? f) (erlang/== :int (getv (expr (item args 1) env) :tag))
                 (erlang/== :integer-list (getv (expr (item args 2) env) :tag)))
        f))))

(defn- alias-only-fold?
  "A safe fold candidate whose callback is a variable. Standalone specialization
   stays literal-only: rematerializing the alias body copies code without
   removing execution work. Aliases pay off only when fused."
  [n env]
  (and (some? (integer-fold-candidate n env))
       (op? (item (getv n :args) 0) :var)))

(defn- integer-fold [n env]
  (let [f (integer-fold-candidate n env) args (getv n :args)]
    (when (and (some? f) (not (op? (item args 0) :var)))
      (let [cl (getv f :clause) fn-node (getv f :fn)
            new-fn (put fn-node :clauses (list (put cl :body (int-expression (getv cl :body)))))]
        (put n :args (list new-fn (item args 1) (item args 2)))))))

(defn- fuse-fold [n env]
  (when (and (call? n :lists :foldl) (erlang/== 3 (erlang/length (getv n :args))))
    (let [args (getv n :args) rf (int-callback (item args 0) 2 env) mapped (item args 2)]
      (when (and (some? rf) (call? mapped :lists :map) (erlang/== 2 (erlang/length (getv mapped :args)))
                 (erlang/== :int (getv (expr (item args 1) env) :tag)))
        (let [ma (getv mapped :args) mf (int-callback (item ma 0) 1 env) source (item ma 1)]
          (when (and (some? mf) (erlang/== :integer-list (getv (expr source env) :tag)))
            (let [rc (getv rf :clause) mc (getv mf :clause) rn (getv rf :names)
                  used (erlang/++ rn (erlang/++ (getv mf :names)
                          (erlang/++ (all-names (getv rc :body)) (all-names (getv mc :body)))))
                  element-name (mapped-name used)
                  acc-name (mapped-name (cons element-name used))
                  mn (mapped-name (cons acc-name (cons element-name used)))
                  mapped-body (replace-var (getv mc :body) (item (getv mf :names) 0) (BeamLisp.Ns.Anf/var element-name))
                  reduced-body (replace-var (replace-var (getv rc :body) (item rn 0) (BeamLisp.Ns.Anf/var mn))
                                           (item rn 1) (BeamLisp.Ns.Anf/var acc-name))
                  body (put (BeamLisp.Ns.Anf/lett mn (int-expression mapped-body) (int-expression reduced-body)) :ann (getv n :ann))
                  combined (put (getv rf :fn) :clauses
                               (list (put (put rc :body body) :pats
                                      (list (BeamLisp.Ns.Anf/pvar element-name) (BeamLisp.Ns.Anf/pvar acc-name)))))]
              (put n :args (list combined (item args 1) source)))))))))

(defn- private-fold
  "(let [xs (lists/map mf src)] (lists/foldl rf init xs)) -> one fold. Only this
   immediate shape: the let body IS the sole consumer, xs occurs only as its list
   argument (rf is a closed callback or an alias other than xs; init must be a
   closed integer expression checked in the scope where xs is bound, so it
   cannot mention xs and cannot fail or effect). Hence removing the strict
   intermediate moves no effect, read or failure; source/map errors still arise
   from the same source evaluation. Returns {:node n}, {:refused true} or nil."
  [n env]
  (let [init (getv n :init) body (getv n :body) name (getv n :name)]
    (when (and (call? init :lists :map) (erlang/== 2 (erlang/length (getv init :args)))
               (call? body :lists :foldl) (erlang/== 3 (erlang/length (getv body :args)))
               (named? (item (getv body :args) 2) name))
      (let [args (getv body :args)
            inner (bind env name init)
            ok (and (not (erlang/== "_" name)) (not (named? (item args 0) name))
                    (closed-int? (item args 1) inner))
            fused (when ok (fuse-fold (put body :args (list (item args 0) (item args 1) init)) env))]
        (if (some? fused) {:node fused} {:refused true})))))

(defn- argument-name [state]
  (loop [i (getv state :fresh)]
    (let [name (erlang/iolist_to_binary (list "__bl_opt_arg_" (erlang/integer_to_binary i)))]
      (if (maps/is_key name (getv state :used-names)) (recur (erlang/+ i 1))
        (tuple name (put (put state :fresh (erlang/+ i 1)) :used-names
                         (put (getv state :used-names) name true)))))))

(defn- first-filter-shape [n]
  (when (and (call? n (runtime-module) :first) (erlang/== 1 (erlang/length (getv n :args))))
    (let [inner (item (getv n :args) 0) args (getv inner :args)
          invocation (BeamLisp.Ns.Anf/callable-invocation inner)]
      (cond
        (and (call? inner (runtime-module) :filter) (erlang/== 2 (erlang/length args)))
          {:predicate (item args 0) :source (item args 1)}
        (some? invocation)
          (let [f (getv invocation :callee) packed (unpack (getv invocation :arguments)) xs (getv packed :args)]
            (when (and (op? f :global) (erlang/== "filter" (getv f :name))
                       (some? packed) (erlang/== 2 (erlang/length xs)))
              {:callee f :predicate (item xs 0) :source (item xs 1)}))
        :else nil))))

(defn- first-filter-result
  "One private total consumer. Capture the live callee BEFORE the packed args,
   then preserve packed-cons order (predicate before source). Guard failure calls
   the captured value: it never rereads a binding or repeats an argument."
  [spec state]
  (let [fp (argument-name state) cp (argument-name (elem fp 1)) pp (argument-name (elem cp 1))
        ap (argument-name (elem pp 1)) xp (argument-name (elem ap 1))
        f (BeamLisp.Ns.Anf/var (elem fp 0)) c (BeamLisp.Ns.Anf/var (elem cp 0))
        p (BeamLisp.Ns.Anf/var (elem pp 0)) acc (BeamLisp.Ns.Anf/var (elem ap 0))
        x (BeamLisp.Ns.Anf/var (elem xp 0))
        step {:op :fn :ann {}
              :clauses (list {:pats (list (BeamLisp.Ns.Anf/pvar (elem ap 0))
                                         (BeamLisp.Ns.Anf/pvar (elem xp 0)))
                              :guard nil
                              :body {:op :if :test (BeamLisp.Ns.Anf/app p (list x))
                                     :then (BeamLisp.Ns.Anf/remote (runtime-module) :reduced (list x))
                                     :else acc :ann {}}})}
        fused (BeamLisp.Ns.Anf/remote (runtime-module) :k-reduce (list step (BeamLisp.Ns.Anf/lit nil) c))
        body (if (some? (getv spec :callee))
               {:op :if :ann {}
                :test (BeamLisp.Ns.Anf/remote (runtime-module) :core_filter_2? (list f))
                :then fused
                :else (BeamLisp.Ns.Anf/remote (runtime-module) :first
                        (list (BeamLisp.Ns.Anf/invoke f {:op :cons :head p
                                         :tail {:op :cons :head c :tail {:op :enil :ann {}} :ann {}}
                                         :ann {}})))}
               fused)
        bound (BeamLisp.Ns.Anf/lett (elem pp 0) (getv spec :predicate)
                (BeamLisp.Ns.Anf/lett (elem cp 0) (getv spec :source) body))
        result (if (some? (getv spec :callee))
                 (BeamLisp.Ns.Anf/lett (elem fp 0) (getv spec :callee) bound) bound)]
    (tuple result (elem xp 1))))

(defn- ordered-apply
  "Preserve canonical packed-cons order: head before tail.
   Core apply may schedule complex arguments differently, so bind them in
   that same order. Atomic arguments need no bindings. Observed names prevent
   capture; argument positions themselves remain unchanged."
  [f args ann state]
  (if (lists/all (fn [n] (or (op? n :var) (op? n :lit))) args)
    (tuple (put (BeamLisp.Ns.Anf/app f args) :ann ann) state)
    (loop [rest args vars (list) bindings (list) s state]
      (if (erlang/== rest (list))
        (let [body (put (BeamLisp.Ns.Anf/app f (lists/reverse vars)) :ann ann)
              result (lists/foldl (fn [b inner]
                                    (put (BeamLisp.Ns.Anf/lett (elem b 0) (elem b 1) inner) :ann ann))
                                  body bindings)]
          (tuple result s))
        (let [p (argument-name s) name (elem p 0)]
          (recur (erlang/tl rest) (cons (BeamLisp.Ns.Anf/var name) vars)
                 (cons (tuple name (erlang/hd rest)) bindings) (elem p 1)))))))

; —— evidence and traversal ————————————————————————————————————————————————

(defn- applied [state rule n detail]
  (let [s (put state :rewrites (erlang/+ 1 (getv state :rewrites)))]
    (if (getv s :report?)
      (put s :evidence (cons {:rule rule :at (getv n :ann) :conditions detail
                                    :authority :checked-anf :version (version)} (getv s :evidence))) s)))

(defn- refused [state rule n reason]
  (if (getv state :report?)
    (put state :refusals (cons {:rule rule :at (getv n :ann) :reason reason} (getv state :refusals))) state))

(defn- checked-fold-result
  "Callback expansion is cumulative, not a fresh allowance at each use. The
   callback grammar cap bounds analysis work per candidate; this separate
   run-wide budget prevents repeated body materialization growing output
   quadratically. Applies to literal and alias candidates alike."
  [n result env state rule detail]
  (let [f (literal-fn (item (getv result :args) 0))
        body (getv (erlang/hd (getv f :clauses)) :body)
        fuel (expression-fuel body 132)
        cost (when (some? fuel) (erlang/+ 4 (erlang/- 132 fuel)))]
    (if (and (some? cost) (erlang/=< cost (getv state :inline-left)))
      (tuple result (applied (put state :inline-left (erlang/- (getv state :inline-left) cost)) rule n detail))
      (tuple n (refused state rule n :callback-inline-budget)))))

(defn- rewrite [n env state mod]
  (let [op (getv n :op)
        own (when (erlang/== op :remote) (own-module n mod))
        numeric (when (erlang/== op :arith) (numeric-domain n env))
        consumer (when (erlang/== op :remote) (first-filter-shape n))
        private (when (erlang/== op :let) (private-fold n env))]
    (cond
      (some? own) (tuple own (applied state :own-module n :own-literal-closure))
      (some? numeric) (tuple numeric (applied state :numeric-domain n :non-map-operands))
      (some? consumer)
        (cond
          (not (materialized-scalars? (getv consumer :source) 128))
            (tuple n (refused state :strict-first-filter n :source-domain-or-budget-unproven))
          (not (total-predicate? (getv consumer :predicate)))
            (tuple n (refused state :strict-first-filter n :predicate-totality-or-effects-unproven))
          (erlang/< (getv state :inline-left) 64)
            (tuple n (refused state :strict-first-filter n :callback-inline-budget))
          :else
            (let [r (first-filter-result consumer state)]
              (tuple (put (elem r 0) :ann (getv n :ann))
                     (applied (put (elem r 1) :inline-left (erlang/- (getv state :inline-left) 64))
                       :strict-first-filter n
                       {:domain :materialized-scalars :predicate :closed-total
                        :ownership :immediate-single-consumer :resources :ordinary-heap
                        :binding (if (some? (getv consumer :callee)) :captured-runtime-identity :direct-intrinsic)
                        :order :callee-then-packed-arguments :halt :first-matching-element}))))
      (erlang/== op :invoke)
        (let [invocation (BeamLisp.Ns.Anf/callable-invocation n)
              f (getv invocation :callee) unpacked (unpack (getv invocation :arguments))
              arity (getv (expr f env) :arity)]
          (if (and (some? unpacked) (some? arity) (erlang/== arity (erlang/length (getv unpacked :args))))
            (let [p (ordered-apply f (getv unpacked :args) (getv n :ann) state)]
              (tuple (elem p 0) (applied (elem p 1) :native-call n
                                        {:arity arity :scope :lexical :arguments :ordered})))
            (tuple n (refused state :native-call n :unknown-or-mismatched-native-arity))))
      (some? private)
        (if (some? (getv private :node))
          (checked-fold-result n (getv private :node) env state :strict-map-fold
            {:domain :integer :callback :closed-total :ownership :private-let-single-consumer
             :binding :definition-scope :order :sequential-left-fold :resources :ordinary-heap})
          (tuple n (refused state :strict-map-fold n :private-use-not-provable)))
      (call? n :lists :foldl)
        (let [fused (fuse-fold n env)]
          (if (some? fused)
            (checked-fold-result n fused env state :strict-map-fold
              {:domain :integer :callback :closed-total :ownership :immediate-single-consumer
               :order :sequential-left-fold :resources :ordinary-heap})
            (let [specialized (integer-fold n env)]
              (if (and (some? specialized) (not (erlang/=:= specialized n)))
                (checked-fold-result n specialized env state :integer-callback :integer-accumulator-invariant)
                (tuple n (refused state :strict-map-fold n
                           (if (alias-only-fold? n env)
                             :callback-rematerialization-not-profitable
                             :unproven-domain-or-callback)))))))
      (and (erlang/== op :remote) (lists/member (getv n :mod) (list :Elixir.BeamLisp.Ns.Core (runtime-module)))
           (lists/member (getv n :fun) (list :reduce :transduce :map-indexed)))
        (tuple n (refused state :strict-map-fold n :live-provider-or-observable-lazy-demand))
      :else (tuple n state))))

(declare walk)
(defn- walk-list [xs env state mod]
  (loop [rest xs out (list) s state]
    (if (erlang/== rest (list)) (tuple (lists/reverse out) s)
      (let [pair (walk (erlang/hd rest) env s mod)]
        (recur (erlang/tl rest) (cons (elem pair 0) out) (elem pair 1))))))

(defn- walk-clauses [clauses env state mod]
  (loop [rest clauses out (list) s state]
    (if (erlang/== rest (list)) (tuple (lists/reverse out) s)
      (let [cl (erlang/hd rest) scoped (shadow env (getv cl :pats))
            gp (walk (getv cl :guard) scoped s mod)
            bp (walk (getv cl :body) (refine scoped (elem gp 0)) (elem gp 1) mod)
            new-cl (put (put cl :guard (elem gp 0)) :body (elem bp 0))]
        (recur (erlang/tl rest) (cons new-cl out) (elem bp 1))))))

(defn- rebuilt-pair [pair k v]
  (cond
    (erlang/is_tuple pair) (erlang/setelement 2 (erlang/setelement 1 pair k) v)
    (erlang/is_list pair) (list k v)
    :else (assoc (assoc pair 0 k) 1 v)))

(defn- walk-pairs [pairs env state mod]
  (loop [rest pairs out (list) s state]
    (if (erlang/== rest (list)) (tuple (lists/reverse out) s)
      (let [kv (erlang/hd rest) kp (walk (first kv) env s mod) vp (walk (second kv) env (elem kp 1) mod)]
        (recur (erlang/tl rest) (cons (rebuilt-pair kv (elem kp 0) (elem vp 0)) out) (elem vp 1))))))

(defn- field [n key env state mod]
  (let [p (walk (getv n key) env state mod)] (tuple (put n key (elem p 0)) (elem p 1))))
(defn- fields-list [n key env state mod]
  (let [p (walk-list (getv n key) env state mod)] (tuple (put n key (elem p 0)) (elem p 1))))

(defn- children [n env state mod]
  (let [op (getv n :op)]
    (cond
      (erlang/== op :let)
        (let [ip (walk (getv n :init) env state mod) init (elem ip 0)
              scoped (bind env (getv n :name) init)
              bp (walk (getv n :body) scoped (elem ip 1) mod)]
          (tuple (put (put n :init init) :body (elem bp 0)) (elem bp 1)))
      (erlang/== op :if)
        (let [tp (walk (getv n :test) env state mod)
              yp (walk (getv n :then) (refine env (elem tp 0)) (elem tp 1) mod)
              np (walk (getv n :else) env (elem yp 1) mod)]
          (tuple (put (put (put n :test (elem tp 0)) :then (elem yp 0)) :else (elem np 0)) (elem np 1)))
      (or (erlang/== op :remote) (erlang/== op :arith)) (fields-list n :args env state mod)
      (erlang/== op :invoke)
        (let [cp (walk (getv n :callee) env state mod)
              ap (walk (getv n :arguments) env (elem cp 1) mod)]
          (tuple (put (put n :callee (elem cp 0)) :arguments (elem ap 0)) (elem ap 1)))
      (erlang/== op :apply)
        (let [fp (field n :fn env state mod)] (fields-list (elem fp 0) :args env (elem fp 1) mod))
      (erlang/== op :fn)
        ; The backend's plain-fun shortcut binds every parameter name, including
        ; "_". Case-pattern wildcards do not bind it. Match that actual ABI.
        (let [cls (getv n :clauses) cl (erlang/hd cls)
              simple (and (erlang/== 1 (erlang/length cls)) (nil? (getv cl :guard))
                          (lists/all (fn [p] (erlang/== :pvar (getv p :pop))) (getv cl :pats)))
              scoped (if simple
                       (lists/foldl (fn [p e] (maps/remove (getv p :name) e)) env (getv cl :pats)) env)
              p (walk-clauses cls scoped state mod)]
          (tuple (put n :clauses (elem p 0)) (elem p 1)))
      (erlang/== op :case)
        (let [sp (walk (getv n :subj) env state mod) cp (walk-clauses (getv n :clauses) env (elem sp 1) mod)]
          (tuple (put (put n :subj (elem sp 0)) :clauses (elem cp 0)) (elem cp 1)))
      (erlang/== op :do) (fields-list n :stmts env state mod)
      (erlang/== op :tuple) (fields-list n :elems env state mod)
      (erlang/== op :cons)
        (let [hp (field n :head env state mod)] (field (elem hp 0) :tail env (elem hp 1) mod))
      (or (erlang/== op :map) (erlang/== op :struct))
        (let [key (if (erlang/== op :map) :pairs :fields) p (walk-pairs (getv n key) env state mod)]
          (tuple (put n key (elem p 0)) (elem p 1)))
      (erlang/== op :try)
        (let [bp (field n :body env state mod) cp (walk-clauses (getv n :catch) env (elem bp 1) mod)
              base (put (elem bp 0) :catch (elem cp 0))]
          (field base :after env (elem cp 1) mod))
      (erlang/== op :recv)
        (let [cp (walk-clauses (getv n :clauses) env state mod) base (put n :clauses (elem cp 0))
              tp (field base :timeout env (elem cp 1) mod)]
          (field (elem tp 0) :after env (elem tp 1) mod))
      :else (tuple n state))))

(defn- walk [n env state mod]
  (cond
    (nil? n) (tuple n state)
    (erlang/>= (getv state :visited) (getv state :max-nodes))
      (tuple n (put state :limited? true))
    :else
      (let [visited (put state :visited (erlang/+ 1 (getv state :visited)))
            s (if (or (op? n :var) (op? n :let))
                (put visited :used-names (put (getv visited :used-names) (getv n :name) true)) visited)
            p (children n env s mod)]
        (if (or (getv (elem p 1) :limited?)
                (not (lists/member (getv n :op) '(:remote :arith :invoke :let)))) p
          (rewrite (elem p 0) env (elem p 1) mod)))))

(defn run
  "Validate and optimize a canonical ANF module descriptor.

   Returns {:descriptor … :evidence … :refusals … :stats … :version …}.
   Options: :enabled? (default true; false is the reference path), :report?
   (default true), :max-nodes (default 100000: visited nodes and cumulative
   callback-expansion cost; it does not cap whole-module validation). Budget
   exhaustion leaves remaining regions unchanged. Definition-scope callback
   aliases and the private let-bound map->fold shape are always recognized.
   Alias-only standalone folds are refused as :callback-rematerialization-not-profitable.
   Solver absence/author metadata cannot grant rewrite authority. No external
   facts are accepted: scope/domain/ownership obligations are checked here."
  ([descriptor] (run descriptor {}))
  ([descriptor opts]
   (let [m (BeamLisp.Ns.Anf/validate-module! descriptor) limit (get opts :max-nodes 100000)
         enabled (get opts :enabled? true)
         context (when (get opts :module-identity? true) (getv m :name))]
     (when (or (not (erlang/is_integer limit)) (erlang/< limit 1))
       (erlang/error (Elixir.ArgumentError/exception "optimize: :max-nodes must be a positive integer")))
     (let [base-env {}
           initial {:visited 0 :rewrites 0 :evidence (list) :refusals (list)
                    :fresh 0 :used-names {} :inline-left limit :max-nodes limit :limited? false :report? (get opts :report? true)}
           p (if enabled
               (loop [rest (getv m :clauses) out (list) s initial]
                 (if (erlang/== rest (list)) (tuple (lists/reverse out) s)
                   (let [cl (erlang/hd rest) gp (walk (getv cl :guard) base-env s context)
                         bp (walk (getv cl :body) (refine base-env (elem gp 0)) (elem gp 1) context)
                         new-cl (put (put cl :guard (elem gp 0)) :body (elem bp 0))]
                     (recur (erlang/tl rest) (cons new-cl out) (elem bp 1)))))
               (tuple (getv m :clauses) initial))
           s (elem p 1) result (put m :clauses (elem p 0))]
       {:descriptor (BeamLisp.Ns.Anf/validate-module! result)
        :version (version)
        :evidence (lists/reverse (getv s :evidence))
        :refusals (lists/reverse (getv s :refusals))
        :stats {:enabled? enabled :visited (getv s :visited) :rewrites (getv s :rewrites)
                :limited? (getv s :limited?) :max-nodes limit
                :inlined-nodes (erlang/- limit (getv s :inline-left))}}))))

(defn module
  "Compiler-facing API: validated optimized descriptor, without report storage.
   Use explain for evidence. :enabled? false provides the reference path."
  ([descriptor] (module descriptor {}))
  ([descriptor opts] (:descriptor (run descriptor (assoc opts :report? false)))))

(defn node
  "Optimize one ANF expression under an empty lexical scope. Free values stay
   unknown. This is the same module pass, not a second node optimizer."
  ([expression] (node expression {}))
  ([expression opts]
   (let [m (BeamLisp.Ns.Anf/module :Elixir.BeamLisp.Optimize.Node
             (list {:op :defn-clause :fname :run :params (list) :guard nil :body expression :ann {}})
             (list [:run 0]) (list))]
     (:body (erlang/hd (:clauses (module m (assoc opts :module-identity? false))))))))

(defn explain
  "The full checked rewrite/refusal report over the same compiler pass."
  ([descriptor] (run descriptor))
  ([descriptor opts] (run descriptor (assoc opts :report? true))))
