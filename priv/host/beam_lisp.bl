; Exact pinned host for Elixir.BeamLisp. Application.start/2 calls init/0 before
; any self-hosted namespace is available. Keep this leaf independent of core
; vars until the prelude and reader/compiler have been interned in order.
(ns host.beam-lisp)

(defn argv []
  (let [bound (Process/get :bl_argv)]
    (if (nil? bound) (System/argv) bound)))

(defn with_argv [args f]
  (when-not (erlang/is_list args)
    (erlang/error (Elixir.FunctionClauseError/exception
      (list (erlang/list_to_tuple (list :module :Elixir.BeamLisp))
            (erlang/list_to_tuple (list :function :with_argv))
            (erlang/list_to_tuple (list :arity 2))))))
  (let [prev (Process/get :bl_argv)]
    (Process/put :bl_argv args)
    (try (BeamLisp.Ns.Rt/invoke f (list))
      (finally (if (nil? prev) (Process/delete :bl_argv)
                 (Process/put :bl_argv prev))))))

(defn cwd []
  (let [bound (Process/get :bl_cwd)]
    (if (nil? bound) (File/cwd!) bound)))

(defn with_cwd [dir f]
  (when-not (erlang/is_binary dir)
    (erlang/error (Elixir.FunctionClauseError/exception
      (list (erlang/list_to_tuple (list :module :Elixir.BeamLisp))
            (erlang/list_to_tuple (list :function :with_cwd))
            (erlang/list_to_tuple (list :arity 2))))))
  (let [prev (Process/get :bl_cwd)]
    (Process/put :bl_cwd dir)
    (try (BeamLisp.Ns.Rt/invoke f (list))
      (finally (if (nil? prev) (Process/delete :bl_cwd)
                 (Process/put :bl_cwd prev))))))

(defn- floor-unit-beam! [manifest directory module]
  (let [name (str (Atom/to_string module) ".beam")
        bytes (BeamLisp.AOTCache/read_precompiled_bytes! (Path/join directory name) 33554432)
        parsed (beam_lib/md5 bytes)]
    (when-not (and (= (String/downcase (Base/encode16 (crypto/hash :sha256 bytes)))
                       (Map/fetch! (Map/fetch! manifest "modules") name))
                   (= :ok (elem parsed 0)) (= module (elem (elem parsed 1) 0))
                   (Code/ensure_loaded? module)
                   (= (elem (elem parsed 1) 1) (erlang/apply module :module_info (list :md5))))
      (erlang/error :prelude_floor_changed))
    (tuple module bytes)))

(defn- adopt-floor-prelude! [namespace]
  ;; The prelude includes a library-tier namespace. Its complete verified floor
  ;; unit supplies the same SDK receipt as a cache hit, before initialization.
  ;; Recovery floors and source changes retain the normal staging path.
  (try
    (let [manifest (BeamLisp.Bootstrap/manifest)
          _ (when-not (BeamLisp.Bootstrap/key_matches? manifest) (erlang/error :previous_floor))
          directory (BeamLisp.Bootstrap/seed_dir)
          module (BeamLisp.Emit/module_for namespace)
          shim (floor-unit-beam! manifest directory module)
          attrs (Keyword/get (elem (elem (beam_lib/chunks (elem shim 1) (list :attributes)) 1) 1) :attributes)
          members (BeamLisp.AOT/normalized_attribute attrs :bl_aot_unit_members)
          _ (when-not (and (erlang/is_tuple members) (= 2 (erlang/tuple_size members))
                            (= :members (elem members 0)) (erlang/is_list (elem members 1))
                            (<= (erlang/length (elem members 1)) 8192))
              (erlang/error :invalid_prelude_unit))
          beams (cons shim (Enum/map (elem members 1)
                             (fn [member] (floor-unit-beam! manifest directory member))))
          root (BeamLisp.Tiers/priv_root)
          source (BeamLisp.Loader/source_path namespace)
          entries (BeamLisp.AOT/sdk_emission_entries! root source beams)]
      (BeamLisp.AOT/publish_sdk_emission_entries! entries))
    (catch _ nil)))

(defn init []
  ; Flat BEAM deployments have no project priv path. Keep the side-effecting
  ; tagged-reader registrations embedded, exactly as the former @data_readers
  ; external_resource did; seed_test checks this against the source file.
  (when-not (Process/whereis :Elixir.BeamLisp.Env)
    (let [started (BeamLisp.Env/start_link (list))]
      (when-not (or (erlang/== :ok (erlang/element 1 started))
                    (and (erlang/== :error (erlang/element 1 started))
                         (erlang/is_tuple (erlang/element 2 started))
                         (erlang/== :already_started
                                   (erlang/element 1 (erlang/element 2 started)))))
        (erlang/error (Elixir.RuntimeError/exception
          (str "failed to start BeamLisp.Env: " (Elixir.Kernel/inspect started)))))))
  (when-not (BeamLisp.Env/seeded?)
    (BeamLisp.AOT/ensure_loaded "rt")
    (BeamLisp.Ns.Rt/seed_core)
    (BeamLisp.AOT/ensure_loaded "core")
    (BeamLisp.Reader/enable_bl_reader)
    (BeamLisp.Compiler/enable_bl_backend)
    (adopt-floor-prelude! "multi")
    (BeamLisp.AOT/ensure_loaded "multi")
    (BeamLisp.AOT/ensure_loaded "sugar")
    (BeamLisp.Compiler/eval_string
      "(ns data-readers)\n(data-reader! \"d\" (quote datom/read-query))\n(data-reader! \"time\" (quote datom.time/read-iso8601))\n"
      (BeamLisp.Compiler/new_env "core"))
    (BeamLisp.Env/mark_seeded)
    (BeamLisp.Env/in_ns "user"))
  :ok)

(defn eval [source]
  (when (erlang/function_exported :Elixir.BeamLisp.Env :assert_native_framework_execution! 0)
    (BeamLisp.Env/assert_native_framework_execution!))
  (when-not (erlang/is_binary source)
    (erlang/error (Elixir.FunctionClauseError/exception
      (list (erlang/list_to_tuple (list :module :Elixir.BeamLisp))
            (erlang/list_to_tuple (list :function :eval))
            (erlang/list_to_tuple (list :arity 1))))))
  (init)
  (BeamLisp.Compiler/eval_string source))

(defn run_runtime_artifact
 "Run a compiled program on the exact installed runtime floor without Source
  parsing, compiler activation or phase providers. The floor producer identity
  is explicit at verification; no compiler-key memo or Source flag is forged."
 [directory args]
 (when-not (Process/whereis :Elixir.BeamLisp.Env)
  (let [result (BeamLisp.Env/start_link (list))]
   (when-not (or (erlang/== :ok (elem result 0))
                  (and (erlang/== :error (elem result 0))
                       (erlang/is_tuple (elem result 1)) (erlang/== :already_started (elem (elem result 1) 0))))
    (erlang/error :runtime_env_start_failed))))
 (BeamLisp.Env/assert_native_framework_execution!)
 (when-not (erlang/== :global (BeamLisp.Env/env_id)) (erlang/error :runtime_requires_global_environment))
 (BeamLisp.Env/with_namespace_lock "runtime-image"
  (fn []
   (let [state (BeamLisp.Env/runtime_floor_state)]
    (when (erlang/== :absent state)
     (BeamLisp.Env/adopt_runtime_floor! (Map/get (BeamLisp.AOT/runtime_floor!) :prepared)))
    (when-not (erlang/== :ready state)
     (let [owner (Process/whereis :Elixir.BeamLisp.Env)]
      (BeamLisp.Ns.Rt/__bl_init__)
      (BeamLisp.Ns.Rt/seed_core)
      (BeamLisp.Ns.Core/__bl_init__)
      (BeamLisp.Env/mark_loaded "rt")
      (BeamLisp.Env/mark_loaded "core")
      (BeamLisp.Env/mark_runtime_initialized! owner))))))
 (BeamLisp.Loader/run_runtime_artifact_unit directory args))

;; ── the compiled-form cache ─────────────────────────────────────────────────
;;
;; `run FILE` used to read, compile and run the whole file on every request:
;; 4–5 ms of a warm command for a file nobody changed. The realm keeps the
;; compiled forms of the files it ran, keyed by the file's SOURCE HASH, and
;; replays them: no read, no compile, no macro expansion — every form still
;; executes, so the file's effects (output, writes, definitions) happen again.
;;
;; Validity is the environment the file last ran in, not a clock: an entry is
;; used only while `BeamLisp.Env/definition_context` equals the context recorded
;; immediately after that file's previous run. `definition_context` covers ANY
;; namespace definition and native code publication in the chain, so any other
;; command that changed the realm — a new macro, a redefined function, a
;; reloaded namespace — makes the comparison fail and the file is recompiled.
;; Changes the file itself made are expected: they are part of the recorded
;; context, refreshed after every run (compiled or replayed).
;;
;; The cache lives in the CALLING env (the realm), so retirement destroys it
;; with the env. Compile-time-only effects (a macro that writes at expansion)
;; are not repeated on a hit; that is what skipping compilation means, and the
;; invalidation above is what keeps the compiled code faithful to its inputs.
(def ^:private run-cache-key (tuple :run_file_cache))
(def ^:private run-cache-limit 8)

(defn- run-context []
  (BeamLisp.Env/definition_context))

(defn- run-cache-table []
  (let [r (BeamLisp.Env/lookup run-cache-key)]
    (if (and (erlang/is_tuple r) (erlang/== :ok (elem r 0))) (elem r 1) {})))

(defn- run-cache-get [hash]
  (let [entry (get (run-cache-table) hash)
        context (run-context)]
    (when (and (some? entry) (some? context) (= context (:after entry))) entry)))

(defn- run-cache-put [hash forms context]
  (when (some? context)
    (let [table (run-cache-table)
          kept (if (>= (count table) run-cache-limit)
                 (dissoc table (first (keys table)))
                 table)]
      (BeamLisp.Env/put_key run-cache-key
        (assoc kept hash {:forms forms :after context})))))

(defn- source-hash [source]
  (Base/encode16 (crypto/hash :sha256 source) (list (tuple :case :lower))))

(defn run_file [path]
  (when (erlang/function_exported :Elixir.BeamLisp.Env :assert_native_framework_execution! 0)
    (BeamLisp.Env/assert_native_framework_execution!))
  (init)
  (if (File/dir? path)
   (BeamLisp.Loader/run_artifact_unit path (argv))
   (BeamLisp.Loader/with_load_path (Path/dirname path)
    (fn []
      (let [source (BeamLisp.Loader/read_source path)
            hash (source-hash source)
            ;; the check happens BEFORE this request's own global intern: the
            ;; recorded context includes the intern of the run that recorded it
            entry (run-cache-get hash)]
        ;; `*command-line-args*` is a LIBRARY binding, not the caller's state:
        ;; it is interned into core at :global (the env every chain ends in) so
        ;; the script still sees it, and a command that serves a project REALM
        ;; does not leave a scoped core definition behind. Such a definition is
        ;; a compiler context: `local_package_authority` declines every later
        ;; certificate in that realm (`:unsupported scoped compiler context`).
        ;; Read it from `BeamLisp/argv` too — this is the compat var, set per run.
        (BeamLisp.Env/with_env :global
          (fn [] (BeamLisp.Env/intern "core" "*command-line-args*" (argv))))
        (if (some? entry)
          (let [value (BeamLisp.Compiler/run_eval_forms (:forms entry))]
            (run-cache-put hash (:forms entry) (run-context))
            value)
          (let [r (BeamLisp.Compiler/eval_string_forms source (BeamLisp.Compiler/new_env) path)]
            (run-cache-put hash (:forms r) (run-context))
            (:value r))))))))

(defn repl []
  (init)
  (BeamLisp.Loader/ensure_loaded "bl.repl")
  (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "bl.repl" "run")
                         (list (list) {})))
