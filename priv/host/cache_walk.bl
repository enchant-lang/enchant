; Finite physical cache identity/charge kernel. SDK-owned pinned host leaf.
; No Env, loader, generic BL var lookup, process or retained resource state.
; The library owns code-cohort validation, admission and cache lifetime.
(ns host.cache-walk)
(defn- pair [a b]
 (erlang/setelement 2 (erlang/setelement 1 (erlang/make_tuple 2 nil) a) b))
(defn- triple [a b c]
 (erlang/setelement 3 (erlang/setelement 2 (erlang/setelement 1 (erlang/make_tuple 3 nil) a) b) c))
(defn- key-list [xs depth]
 (loop [xs xs out (BeamLisp.Vector/new)]
  (cond
   (erlang/== xs ()) out
   (erlang/== false (erlang/is_list xs)) nil
   :else (let [x (key-data (erlang/hd xs) depth)]
           (when (erlang/=/= x nil)
            (recur (erlang/tl xs) (BeamLisp.Vector/conj out x)))))))
(defn- key-map [x depth]
 (loop [it (maps/iterator x) out (maps/new)]
  (let [entry (maps/next it)]
   (if (erlang/== :none entry) out
    (let [k (key-data (erlang/element 1 entry) depth)
          v (key-data (erlang/element 2 entry) depth)]
     (when (and (erlang/=/= k nil) (erlang/=/= v nil))
      (recur (erlang/element 3 entry) (maps/put k v out))))))))
(defn key-data [x depth]
 (when (erlang/=< depth 128)
  (cond
   (erlang/is_atom x) (pair :atom x)
   (erlang/is_integer x) (pair :integer x)
   (erlang/is_float x) (pair :float x)
   (erlang/is_binary x) (pair :binary x)
   (erlang/is_reference x)
    (when (erlang/== (erlang/node x) (erlang/node))
     (triple :reference (erlang/node x) (erlang/ref_to_list x)))
   (erlang/is_tuple x)
    (let [v (key-list (erlang/tuple_to_list x) (erlang/+ depth 1))]
     (when (erlang/=/= v nil) (pair :tuple v)))
   (erlang/is_map x)
    (let [v (key-map x (erlang/+ depth 1))]
     (when (erlang/=/= v nil) (pair :map v)))
   (erlang/is_list x)
    (let [v (key-list x (erlang/+ depth 1))]
     (when (erlang/=/= v nil) (pair :list v)))
   :else nil)))
(defn- list-extra [xs depth]
 (loop [xs xs acc 0]
  (cond
   (erlang/== xs ()) acc
   (erlang/== false (erlang/is_list xs)) nil
   :else (let [n (binary-extra (erlang/hd xs) depth)]
           (when (erlang/=/= n nil)
            (recur (erlang/tl xs) (erlang/+ acc n)))))))
(defn- tuple-extra [x depth]
 (loop [i 1 acc 0]
  (if (erlang/> i (erlang/tuple_size x)) acc
   (let [n (binary-extra (erlang/element i x) depth)]
    (when (erlang/=/= n nil) (recur (erlang/+ i 1) (erlang/+ acc n)))))))
(defn- map-extra [x depth]
 (loop [it (maps/iterator x) acc 0]
  (let [entry (maps/next it)]
   (if (erlang/== :none entry) acc
    (let [k (binary-extra (erlang/element 1 entry) depth)
          v (binary-extra (erlang/element 2 entry) depth)]
     (when (and (erlang/=/= k nil) (erlang/=/= v nil))
      (recur (erlang/element 3 entry) (erlang/+ (erlang/+ acc k) v))))))))
(defn- binary-extra [x depth]
 (when (erlang/=< depth 128)
  (cond
   (erlang/is_binary x) (erlang/- (binary/referenced_byte_size x) (erlang/byte_size x))
   (or (erlang/is_atom x) (erlang/is_number x)) 0
   (erlang/is_tuple x) (tuple-extra x (erlang/+ depth 1))
   (erlang/is_map x) (map-extra x (erlang/+ depth 1))
   (erlang/is_list x) (list-extra x (erlang/+ depth 1))
   :else nil)))
(defn footprint [entry]
 (let [extra (binary-extra entry 0)]
  (when (erlang/=/= extra nil)
   (erlang/+ 256 (erlang/* 2
    (erlang/+ (erlang/+ (erlang/* (erlang/system_info :wordsize) (erts_debug/flat_size entry))
                       (erlang/external_size entry)) extra))))))
