; harness/doc.bl — the session document: what comes in, what gets appended.
;
; A harness session IS a literate document: `.bl.org` for every new session,
; `.bl.md` for a session that already has one on disk. Everything that happens
; in it — a task, a steer, an evaluation, a model's reply — arrives as blocks
; and is APPENDED, never rewritten: prose stays prose, code becomes a
; beam-lisp cell (`#+begin_src beam-lisp :id cN` / ```beam-lisp id=cN), and
; every cell is followed by the result block its evaluation produced
; (`#+RESULTS: cN` / ```bl-result cN). So one file is the transcript a person
; reads, the context a model reads, and a document `bl.doc` can slice.
;
; Input is `.bl` (code: one cell), `.bl.org` or `.bl.md` (prose + cells).
; Reading a document is `bl.doc`'s job — the SAME slicer the loader and the
; livebook runner use, so the harness and the language cannot disagree about
; where a cell begins. Input format and session format are independent: an
; Org session appends a Markdown input's cells as Org cells.

(ns harness.doc
  (:require [bl.doc :as doc] [bl.doc.spans :as spans]))

(def RESULT-CHARS
  "The most of one result a document keeps. A model reads the whole document on
   every step, so one runaway print would otherwise be paid for forever."
  16000)

(defn format-of
  "The format of an input: `:bl`, `:org` or `:md`.

   An explicit `fmt` (\"bl\" / \"bl.org\" / \"bl.md\") wins, then the path's
   extension, then the text itself — an Org or Markdown beam-lisp block means a
   document. With none of those, `default` decides: code for `eval`, a document
   for a task (plain prose IS a valid document, and a task is usually prose)."
  [text path fmt default]
  (cond
    (= fmt "bl") :bl
    (or (= fmt "bl.org") (= fmt "org")) :org
    (or (= fmt "bl.md") (= fmt "md")) :md
    (and (string? path) (ends-with? path ".org")) :org
    (and (string? path) (ends-with? path ".md")) :md
    (and (string? path) (ends-with? path ".bl")) :bl
    (includes? text "#+begin_src beam-lisp") :org
    (includes? text "```beam-lisp") :md
    :else default))

(defn document-format
  "The format of a session document's TEXT: `:org` when it opens with an Org
   keyword line (`#+title:` …), else `:md`."
  [text]
  (if (starts-with? (trim (or text "")) "#+") :org :md))

(defn- closer [fmt] (if (= fmt :org) "\n#+end_src" "\n```"))

(defn parts
  "Input text → its blocks, in order: `{:kind :cell :src s}` and
   `{:kind :prose :text s}`.

   A `.bl` input is one cell. A document is sliced by `bl.doc`: cells become
   cells, prose and other blocks stay prose, and a result block is DROPPED — a
   result is something evaluation produces, never something an author (or a
   model) gets to assert.

   A document that ends inside a block (a model cut off mid-cell) is closed and
   sliced again, so its cells still run. One the slicer still refuses is kept
   whole as prose rather than lost."
  [text fmt]
  (let [text (or text "")]
    (if (= fmt :bl)
      (if (blank? text) [] [{:kind :cell :src (trim text)}])
      (let [r (doc/slice-text text fmt)
            r (if (contains? r :error) (doc/slice-text (str text (closer fmt)) fmt) r)]
        (if (contains? r :error)
          [{:kind :prose :text (trim text)}]
          (vec
           (keep (fn [sp]
                   (cond
                     (= :cell (:kind sp))
                     (let [src (doc/cell-source sp)]
                       (if (blank? src) nil {:kind :cell :src src}))

                     (= :result (:kind sp)) nil

                     :else
                     (let [t (trim (join "\n" (:lines sp)))]
                       (if (blank? t) nil {:kind :prose :text t}))))
                 (get-in r [:ok :spans]))))))))

(defn cells?
  "Does a parts list hold any code?"
  [ps]
  (some? (some (fn [p] (= :cell (:kind p))) ps)))

(defn clip
  "At most RESULT-CHARS of `s`, saying how much was dropped."
  [s]
  (if (> (count s) RESULT-CHARS)
    (str (subs s 0 RESULT-CHARS) "\n;; … clipped, " (count s) " chars in all")
    s))

(defn result-text
  "What a cell's evaluation shows: its stdout, then its printed value — or,
   when it failed, its stdout then `;; error: …`. The same shape `bl.doc`
   writes, so a harness document reads like any other livebook."
  [r]
  (let [out (or (:stdout r) "")]
    (clip
     (cond
       (some? (:error r)) (str out ";; error: " (:error r))
       (blank? out) (str (:value r))
       :else (str out (:value r))))))

(defn cell-marker
  "The text every cell header starts with, in `fmt`: what `cells-in` counts."
  [fmt]
  (if (= fmt :org) "#+begin_src beam-lisp :id c" "```beam-lisp id=c"))

(defn cell-block
  ([id src] (cell-block :md id src))
  ([fmt id src]
   (if (= fmt :org)
     (str "#+begin_src beam-lisp :id " id "\n" src "\n#+end_src\n")
     (str "```beam-lisp id=" id "\n" src "\n```\n"))))

(defn result-block
  "A result as `bl.doc` itself writes it (`bl.doc.spans/result-lines`)."
  ([id text] (result-block :md id text))
  ([fmt id text]
   (str (join "\n" (spans/result-lines fmt id text)) (if (= fmt :org) "" "\n"))))

(defn- heading-prefix [fmt] (if (= fmt :org) "* " "## "))

(defn section-heading?
  "Headings generated by the harness, not headings inside operator/model prose."
  ([line] (or (section-heading? :md line) (section-heading? :org line)))
  ([fmt line]
   (let [p (heading-prefix fmt)]
     (or (= line (str p "task")) (= line (str p "steer")) (= line (str p "eval"))
         (= line (str p "note")) (= line (str p "advice")) (starts-with? line (str p "keep "))
         (starts-with? line (str p "model · t"))
         (starts-with? line (str p "turn "))))))

(defn kept-cells
  "The saved commands in document TEXT: {name src}, each name's latest
   version. A saved command is the first cell under a `keep NAME` section."
  [text fmt]
  (let [r (doc/slice-text text fmt)
        p (heading-prefix fmt)]
    (if (contains? r :error)
      {}
      (:found
       (reduce (fn [acc sp]
                 (cond
                   (= :cell (:kind sp))
                   (if (some? (:pending acc))
                     (-> acc (assoc-in [:found (:pending acc)] (doc/cell-source sp)) (assoc :pending nil))
                     acc)
                   (= :prose (:kind sp))
                   (reduce (fn [acc line]
                             (cond
                               (starts-with? line (str p "keep ")) (assoc acc :pending (trim (subs line (count (str p "keep ")))))
                               (section-heading? fmt line) (assoc acc :pending nil)
                               :else acc))
                           acc (:lines sp))
                   :else acc))
               {:found {} :pending nil}
               (get-in r [:ok :spans]))))))

(def ^:private ORG-HEADING (Regex/compile! "^\\*+ "))
(def ^:private ORG-BLOCK (Regex/compile! "(?i)^\\s*#\\+(results|begin_src|end_src)"))
(def ^:private MD-BLOCK (Regex/compile! "^\\s*```(beam-lisp|bl-result)"))

(defn safe-prose
  "Keep user/model prose from forging a generated section heading, a cell or
   a result once it is appended in `fmt`. Input prose may come from the other
   format, where those lines were plain text. In Org every heading line is
   indented one space (the operator's and the model's outlines stay inside
   their section) and a src/RESULTS line takes Org's comma escape; in Markdown
   a generated heading or a fence line is backslash-escaped. History
   reconstruction keeps each role."
  ([text] (safe-prose :md text))
  ([fmt text]
   (join "\n" (map (fn [line]
                     (cond
                       (and (= fmt :org) (Regex/match? ORG-HEADING line)) (str " " line)
                       (and (= fmt :org) (Regex/match? ORG-BLOCK line)) (str "," line)
                       (and (= fmt :md) (section-heading? :md line)) (str "\\" line)
                       (and (= fmt :md) (Regex/match? MD-BLOCK line)) (str "\\" line)
                       :else line))
                   (split text "\n")))))

(defn heading
  ([title] (heading :md title))
  ([fmt title] (str "\n" (heading-prefix fmt) title "\n")))

(defn preamble
  "The first lines of a new session document."
  ([sid ns] (preamble :md sid ns))
  ([fmt sid ns]
   (if (= fmt :org)
     (str "#+title: harness · " sid "\n"
          "#+property: harness-ns " ns "\n\n"
          "A beam-lisp session. Every block is appended: =* task= and =* steer= come "
          "from the operator, =* eval= is code the operator ran, =* model= is the "
          "model. Cells evaluate in =" ns "=, in the project's warm VM.\n")
     (str "# harness · " sid "\n\n"
          "A beam-lisp session. Every block is appended: `## task`/`## steer` come "
          "from the operator, `## eval` is code the operator ran, `## model` is the "
          "model. Cells evaluate in `" ns "`, in the project's warm VM.\n"))))
