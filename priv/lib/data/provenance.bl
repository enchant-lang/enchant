;; Compact invalidation evidence shared by tooling and stored-data readers.
(ns data.provenance (:require [data.bounded-cache :as cache]))

(defn definition-revision
  "Digest of live definition/code publication counters in the current lookup
   chain. Cost follows scope depth, independent of definition count and of the
   number of query namespaces. Dead/busy scopes decline. No definitions,
   callables or native environment references are retained in the receipt."
  []
  (when-let [context (BeamLisp.Env/definition_context)]
    (when-let [normalized (cache/key-data context 0)]
      (crypto/hash :sha256 (erlang/term_to_binary normalized (list :deterministic))))))
