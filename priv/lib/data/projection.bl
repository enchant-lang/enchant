;; Managed expensive reads over the existing closed Datom query boundary.
;; Readers carry no producer closure, query, source or retry authority.
(ns data.projection
  (:require [proc.server] [proc.work :as work] [proc.instance :as instance] [proc.framework :as framework]
            [proc.work-budget :as budget] [data.projection-policy :as policy]
            [data.first-order :as data] [data.cache-pool :as pool] [data.delta-aggregate :as aggregate]
            [data.bounded-cache :as cache] [data.provenance :as provenance] [datom]
            [datom.query.read-only :as closed]))

(def DEFAULTS
  {:max-output-bytes 65536 :max-read-bytes 1048576 :max-steps 32768
   :timeout-ms 5000 :max-heap-words 1048576})

(defn- options! [options]
  (data/check! options {:max-nodes 64 :max-bytes 4096 :max-depth 4})
  (when-not (and (map? options) (every? (set (keys DEFAULTS)) (keys options)))
    (throw (ex-info "Unknown managed projection options" {:kind :invalid-projection-options})))
  (let [o (merge DEFAULTS options)]
    (when-not (and (int? (:max-output-bytes o)) (<= 64 (:max-output-bytes o) 1048576)
                   (int? (:max-read-bytes o)) (<= 64 (:max-read-bytes o) 8388608)
                   (int? (:max-steps o)) (<= 4 (:max-steps o) 1000000)
                   (int? (:timeout-ms o)) (<= 1 (:timeout-ms o) 60000)
                   (int? (:max-heap-words o)) (<= 65536 (:max-heap-words o) 8388608))
      (throw (ex-info "Managed projection limits are outside their bounds" {:kind :invalid-projection-options})))
    o))

(defn- authorized? [state token role] (= token (get state role)))
(defn- refused [reason] {:status :refused :reason reason})

(defn- produce [parent tag ticket query source revision options context]
  ;; Only this fixed SDK adapter can execute. Supplied query data cannot call
  ;; Process/flag or substitute a function, custom store or computed provider.
  (Process/flag :max_heap_size {:size (:max-heap-words options) :kill true :error_logger false})
  (try
    ((:checkpoint context))
    (let [token (budget/open! (:max-steps options) (:max-read-bytes options) (:timeout-ms options))
          result (closed/read-budgeted! query source revision token (:max-output-bytes options))
          bytes (erlang/term_to_binary (:value result))]
      (when (> (erlang/byte_size bytes) (:max-output-bytes options))
        (throw (ex-info "Projection result exceeds its retained byte limit" {:kind :oversized})))
      (erlang/send parent [tag :candidate ticket
        {:status :ready :bytes bytes :charge (cache/footprint bytes)
         :basis (:basis result) :work (:work result)}]))
    (catch error
      (erlang/send parent [tag :candidate ticket
        {:status (or (:kind (ex-data error)) :failed)}]))))

(defn- produce-derived [parent tag ticket declaration options context]
  ;; This separate API delegates an owner-approved callback through proc.work;
  ;; it makes no claim that arbitrary callbacks belong to the closed query API.
  (Process/flag :max_heap_size {:size (:max-heap-words options) :kill true :error_logger false})
  (try
    ((:checkpoint context))
    (let [token (budget/open! (:max-steps options) (:max-read-bytes options) (:timeout-ms options))
          before (provenance/definition-revision)
          value (budget/with-budget token (fn [] ((:compute declaration) (:database declaration))))
          _ (when-not (and before (= before (provenance/definition-revision)))
              (throw (ex-info "Derived code changed" {:kind :superseded-derivation})))
          _ (data/check! value {:max-nodes 32768 :max-bytes (:max-output-bytes options) :max-depth 64})
          bytes (erlang/term_to_binary value)]
      (when (> (erlang/byte_size bytes) (:max-output-bytes options))
        (throw (ex-info "Derived output exceeds retention" {:kind :oversized})))
      (erlang/send parent [tag :candidate ticket {:status :ready :bytes bytes
                              :charge (cache/footprint bytes) :work (select-keys (budget/snapshot token) [:steps :bytes])}]))
    (catch error (erlang/send parent [tag :candidate ticket {:status (or (:kind (ex-data error)) :failed)}]))))

(declare effects!)
(declare schedule-expiry!)
(defn- notify! [state]
  ;; One unacknowledged wake per reader process. Reading acknowledges only
  ;; this wake; it never grants demand, work, retry or publication authority.
  (reduce (fn [s pid]
    (if (contains? (:notified s) pid) s
      (do (erlang/send pid [:data.projection/changed (erlang/self) (:read-token s)])
          (update s :notified conj pid)))) state (keys (:subscribers state))))

(defn- transition! [state event]
  (let [[after effects] (policy/step (:policy state) event)
        next (effects! (assoc state :policy after) effects)]
    (if (= (policy/observe (:policy state)) (policy/observe (:policy next))) next
      (notify! next))))

(defn- effects! [state effects]
  (reduce
    (fn [s effect]
      (case (:effect effect)
        :drop (assoc s :retained nil)
        :drop-candidate (assoc s :candidate nil)
        :publish (assoc s :retained (:candidate s) :candidate nil)
        :cancel (do (when (:job s) (work/cancel! (:workers s) (:job s))) s)
        :run
          (if (:aggregate s)
            (try
             (let [options (:options s) token (budget/open! (:max-steps options) (:max-read-bytes options) (:timeout-ms options))
                  _ (budget/spend! token (inc (count (get-in s [:aggregate :groups]))) 0)
                  value (aggregate/view (:aggregate s))]
              (if-not (= :ready (:status value))
                (transition! s {:op :finish :ticket (:ticket effect) :status :expiry-pending})
                (do
                  (data/check! value {:max-nodes 32768 :max-bytes (:max-output-bytes options) :max-depth 64})
                  (let [bytes (erlang/term_to_binary value)]
                    (when (> (erlang/byte_size bytes) (:max-output-bytes options))
                      (throw (ex-info "Projection output is oversized" {:kind :oversized})))
                    (transition! (assoc s :candidate {:bytes bytes :status :ready
                                                      :work (:work (:aggregate s))})
                      {:op :finish :ticket (:ticket effect) :status :ready :charge (cache/footprint bytes)})))))
             (catch error (transition! s {:op :finish :ticket (:ticket effect)
                                         :status (or (:kind (ex-data error)) :failed)})))
          (let [parent (erlang/self) tag (:completion s) ticket (:ticket effect)
                query (:query s) source (:source s) revision (:revision effect) options (:options s)
                job (work/submit! (:workers s) {:title "Managed stored-data projection"}
                      (fn [context]
                        (if-let [declaration (:derivation s)]
                          (produce-derived parent tag ticket declaration options context)
                          (produce parent tag ticket query source revision options context))))]
            (if (:id job)
              (assoc s :job (:id job) :candidate nil :terminal nil
                       :timer (erlang/send_after (:timeout-ms options) parent [tag :timeout ticket]))
              (transition! s {:op :finish :ticket ticket :status :work-admission-refused}))))
        s)) state effects))

(defn- refresh-source! [state]
  (if (:derivation state)
    (transition! state {:op :source :basis (get-in state [:derivation :basis])
      :revision [(get-in state [:derivation :identity]) (provenance/definition-revision)]})
  (if-let [a (:aggregate state)]
    (transition! state {:op :source :basis (:version a)
                       :revision [(get-in a [:options :source-id]) (:version a)]})
  (let [evidence (closed/revision! (:query state) (:source state))]
    (transition! (assoc state :dirty? false)
      {:op :source :basis (:basis evidence) :revision (:revision evidence)})))))

(defn- expire-state! [state]
  (if-let [a (:aggregate state)]
    (refresh-source! (assoc state :aggregate
      (aggregate/expire a (max (:now a) (erlang/system_time :millisecond))))) state))

(defn- schedule-expiry! [state]
  (when (:expiry-timer state) (erlang/cancel_timer (:expiry-timer state)))
  (let [after (assoc state :expiry-timer nil :expiry-ticket nil)
        at (when (:aggregate after) (aggregate/next-expiry (:aggregate after)))]
    (if (and at (pos? (get-in after [:policy :demand])) (not= :closed (get-in after [:policy :status])))
      (let [ticket (erlang/make_ref)
            delay (max 1 (min 2678400000 (- at (erlang/system_time :millisecond))))]
        (assoc after :expiry-ticket ticket
          :expiry-timer (erlang/send_after delay (erlang/self) [(:completion after) :expire ticket])))
      after)))

(defn- observed-state [state]
  (let [view (policy/observe (:policy state))
        expired? (when-let [a (:aggregate state)]
                   (when-let [at (aggregate/next-expiry a)] (<= at (erlang/system_time :millisecond))))
        view (if expired? (assoc view :status :stale :reason :expired) view)
        view (if (:dirty? state) (assoc view :status :stale :reason :unobserved-source) view)]
    view))

(defn- response [state]
  (let [view (observed-state state)]
    (if (and (= :ready (:status view)) (:retained state))
      ;; Send the retained binary across the process boundary. Decoding here
      ;; allocates a tree on the owner and then copies it into each reader.
      (assoc view ::payload (get-in state [:retained :bytes])
                  :work (get-in state [:retained :work]))
      view)))

(defn- subscribe-state! [state pid]
  (if (contains? (:subscribers state) pid)
    state
    (if (>= (count (:subscribers state)) 128)
      state
      (let [after (assoc-in state [:subscribers pid] (erlang/monitor :process pid))
            fresh (refresh-source! (expire-state! after))]
        (schedule-expiry! (transition! fresh {:op :demand :count (count (:subscribers fresh))}))))))

(defn- initial! [opts]
  (let [options (:options opts)
        ;; Include the declaration and both bounded revision receipts, not only
        ;; the retained answer. Query terms are copied into the private worker.
        query-charge (if (:query opts) (cache/footprint (:query opts)) 0)
        _ (when (nil? query-charge)
            (throw (ex-info "Projection declaration has no finite charge" {:kind :projection-capacity})))
        charge (+ 4096 262144 (* 2 query-charge) (* 4 (:max-output-bytes options))
                                         (get-in opts [:aggregate :options :max-bytes] 0))
        reservation (erlang/make_ref) tag (erlang/make_ref)]
    (when-not (and (pool/register! (erlang/self)) (pool/reserve! (erlang/self) reservation charge))
      (throw (ex-info "Managed projection retention capacity exhausted" {:kind :projection-capacity})))
    (pool/retain! (erlang/self) reservation)
    (let [workers (work/start! {:max-active 1 :history 1 :completion-tag tag})
          evidence (:evidence opts)
          state {:source (:source opts) :query (:query opts) :options options
                 :framework (framework/adopt! (:creator opts)) :aggregate (:aggregate opts) :derivation (:derivation opts)
                 :read-token (:read-token opts) :control-token (:control-token opts)
                 :creator (erlang/monitor :process (:creator opts))
                 :reservation reservation :completion tag :workers workers
                 :subscribers {} :notified #{} :retained nil :candidate nil :job nil :timer nil :terminal nil
                 :expiry-timer nil :expiry-ticket nil
                 :policy (policy/initial (+ 256 (* 2 (:max-output-bytes options)))) :dirty? false}]
      (if (or (:aggregate state) (:derivation state)) (refresh-source! state)
        (do (datom/listen! (:source state) {:attrs (set (:attributes evidence)) :payload :basis})
            (transition! state {:op :source :basis (:basis evidence) :revision (:revision evidence)}))))))

(defn- finish! [state id status]
  (if-not (= id (:job state)) state
    (let [ticket (get-in state [:policy :running :ticket])
          candidate (:candidate state)
          outcome (if (= :done status) (:status candidate :failed) status)]
      (when (:timer state) (erlang/cancel_timer (:timer state)))
      (transition! (assoc state :job nil :timer nil :terminal nil)
        {:op :finish :ticket ticket :status outcome :charge (:charge candidate)}))))

(defn- settle! [state]
  ;; Candidate and terminal notification have different senders. Join both
  ;; acknowledgements; never assume inter-sender mailbox ordering.
  (if (and (:terminal state)
           (or (:candidate state) (not= :done (:terminal state))))
    (finish! state (:job state) (:terminal state)) state))

(proc.server/defserver projection-owner
  (init [opts] (ok (initial! opts)))
  (handle-call [:read token] [from state]
    (if (authorized? state token :read-token)
      (reply (response state) (update state :notified disj (elem from 0)))
      (reply (refused :projection-reader) state)))
  (handle-call [:status token] [_from state]
    (if (authorized? state token :read-token)
      (let [view (observed-state state)]
        (reply (assoc (select-keys view [:status :reason :counts])
                 :wanted-basis (get-in view [:wanted :basis])
                 :published-basis (get-in view [:result :basis])
                 :retained-charge (get-in view [:result :charge])
                 :retention-limit (get-in state [:policy :max-charge])
                 :work (select-keys (get-in state [:retained :work]) [:steps :bytes :changed :expired])
                 :demand (get-in state [:policy :demand]) :limits (:options state)) state))
      (reply (refused :projection-reader) state)))
  (handle-call [:subscribe token] [from state]
    (if (authorized? state token :read-token)
      (let [after (subscribe-state! state (elem from 0))] (reply (response after) after))
      (reply (refused :projection-reader) state)))
  (handle-call [:unsubscribe token] [from state]
    (if (authorized? state token :read-token)
      (let [pid (elem from 0) monitor (get-in state [:subscribers pid])]
        (when monitor (erlang/demonitor monitor (list :flush)))
        (let [after (-> state (update :subscribers dissoc pid) (update :notified disj pid))
              next (transition! after {:op :demand :count (count (:subscribers after))})]
          (let [next (schedule-expiry! next)] (reply (response next) next))))
      (reply (refused :projection-reader) state)))
  (handle-call [:control token command] [_from state]
    (if-not (authorized? state token :control-token)
      (reply (refused :projection-controller) state)
      (let [after (case command
                    :refresh (refresh-source! (expire-state! state))
                    :retry (transition! (refresh-source! state) {:op :retry})
                    :evict (transition! state {:op :evict})
                    :close (transition! state {:op :close})
                    state)]
        (let [after (schedule-expiry! after)] (reply (response after) after)))))
  (handle-call [:delta token delta] [_from state]
    (cond
      (not (authorized? state token :control-token)) (reply (refused :projection-controller) state)
      (nil? (:aggregate state)) (reply (refused :not-incremental-projection) state)
      (= :closed (get-in state [:policy :status])) (reply (refused :projection-closed) state)
      :else
        (try
          (let [after (schedule-expiry!
                        (refresh-source! (assoc state :aggregate (aggregate/apply-delta (:aggregate state) delta))))]
            (reply (response after) after))
          (catch error (reply (refused (or (:kind (ex-data error)) :invalid-projection-delta)) state)))))
  (handle-info [tag :candidate ticket candidate] [state]
    (noreply (if (and (= tag (:completion state)) (= ticket (get-in state [:policy :running :ticket])))
               (settle! (assoc state :candidate candidate)) state)))
  (handle-info [tag :work-finished id status] [state]
    (noreply (if (and (= tag (:completion state)) (= id (:job state)))
               (settle! (assoc state :terminal status)) state)))
  (handle-info [tag :timeout ticket] [state]
    (noreply (if (= tag (:completion state))
      (let [after (transition! state {:op :timeout :ticket ticket})]
        (if (:terminal after) (finish! after (:job after) (:terminal after)) after)) state)))
  (handle-info [tag :expire ticket] [state]
    (noreply (if (and (= tag (:completion state)) (= ticket (:expiry-ticket state)))
               (schedule-expiry! (expire-state! state)) state)))
  (handle-info [:datom/changed basis _attrs] [state]
    ;; Refresh observes the current DB, which may already include an entire
    ;; queued transaction burst. Older basis notifications need no new stamp.
    (noreply (cond
      (zero? (get-in state [:policy :demand])) (assoc state :dirty? true)
      (and (int? basis) (<= basis (get-in state [:policy :wanted :basis] -1))) state
      :else (refresh-source! state))))
  (handle-info [:DOWN monitor :process pid _reason] [state]
    (if (and (= monitor (:creator state)) (not (Process/alive? pid))) (stop :normal state)
      (if (and (= monitor (get-in state [:subscribers pid])) (not (Process/alive? pid)))
        (let [after (-> state (update :subscribers dissoc pid) (update :notified disj pid))]
          (noreply (schedule-expiry! (transition! after {:op :demand :count (count (:subscribers after))}))))
        (noreply state))))
  (handle-info _ [state] (noreply state))
  (terminate [_reason state]
    (when (:timer state) (erlang/cancel_timer (:timer state)))
    (when (:expiry-timer state) (erlang/cancel_timer (:expiry-timer state)))
    (try (when (:source state) (datom/unlisten! (:source state))) (catch _ nil)
      (finally (try (work/stop! (:workers state))
        (finally (try (framework/close! (:framework state))
          (finally (pool/release! (erlang/self) (:reservation state)))))))) :ok))

(defn start!
  "Declare one named projection in this application instance. Only a closed
   stored-data query on a native connection is admitted. Startup observes
   source metadata but never runs the query. Duplicate names refuse. The
   creator owns lifetime; reader handles confer no refresh/retry authority."
  ([name source query] (start! name source query {}))
  ([name source query options]
   (when-not (keyword? name)
     (throw (ex-info "A managed projection requires a logical name" {:kind :invalid-projection-name})))
   (let [options (options! options) evidence (closed/revision! query source)
         read-token (erlang/make_ref) control-token (erlang/make_ref)
         pid (core/start projection-owner
               {:source source :query query :evidence evidence :options options
                :creator (erlang/self) :read-token read-token :control-token control-token}
               {:name (instance/name name)})]
     {:owner pid :read read-token :control control-token})))

(defn start-incremental!
  "Declare a fixed first-order count/sum reducer. The controller supplies exact
   source deltas; reads cannot drain/replay them. Retained rows/groups/bytes
   are bounded, expiry uses owned timers only while demanded, and checkpoint
   gaps refuse. No source callback or user-defined reducer is accepted."
  ([name declaration] (start-incremental! name declaration {}))
  ([name declaration options]
   (when-not (keyword? name)
     (throw (ex-info "A managed projection requires a logical name" {:kind :invalid-projection-name})))
   (let [options (options! options) a (aggregate/initial declaration)
         read-token (erlang/make_ref) control-token (erlang/make_ref)
         pid (core/start projection-owner
               {:aggregate a :options options :creator (erlang/self)
                :read-token read-token :control-token control-token}
               {:name (instance/name name)})]
     {:owner pid :read read-token :control control-token})))

(defn start-derived!
  "Owned derivation of an immutable DB value. The application owner delegates
   compute through proc.work's callback custody; reader handles cannot execute
   it. Failure/oversize stay blocked until explicit retry. This callback API
   does not certify purity: the controller owns its declaration and effects."
  ([name database key compute] (start-derived! name database key compute {}))
  ([name database key compute options]
   (when-not (and (keyword? name) (fn? compute) (BeamLisp.Ns.Rt/invocable? compute 1))
     (throw (ex-info "Invalid owned derivation" {:kind :invalid-derivation})))
   (let [options (options! options) revision (datom/db-revision database)
         identity (cache/fingerprint [revision key])
         _ (when-not (and identity (first revision) (int? (:basis-t database)))
             (throw (ex-info "Derivation requires a versioned DB identity" {:kind :invalid-derivation-source})))
         read-token (erlang/make_ref) control-token (erlang/make_ref)
         pid (core/start projection-owner
               {:derivation {:database database :identity identity :basis (:basis-t database) :compute compute}
                :options options :creator (erlang/self) :read-token read-token :control-token control-token}
               {:name (instance/name name)})]
     {:owner pid :read read-token :control control-token})))

(defn- read-value [handle message]
  (let [answer (call (:owner handle) message)]
    (if-let [bytes (::payload answer)]
      (assoc (dissoc answer ::payload) :value (erlang/binary_to_term bytes (list :safe)))
      answer)))

(defn reader [handle] (select-keys handle [:owner :read]))
(defn read [handle] (read-value handle [:read (:read handle)]))
(defn status
  "Read metadata with a reader grant. Never decodes retained values, changes
   demand, acknowledges wakes, retries or refreshes the source."
  [handle] (call (:owner handle) [:status (:read handle)]))
(defn subscribe! [handle] (read-value handle [:subscribe (:read handle)]))
(defn unsubscribe! [handle] (read-value handle [:unsubscribe (:read handle)]))
(defn refresh! [handle] (read-value handle [:control (:control handle) :refresh]))
(defn retry! [handle] (read-value handle [:control (:control handle) :retry]))
(defn evict! [handle] (read-value handle [:control (:control handle) :evict]))
(defn delta! [handle delta]
  (data/check! delta {:max-nodes 8192 :max-bytes 4194304 :max-depth 32})
  (read-value handle [:delta (:control handle) delta]))
(defn stop! [handle]
  (when (and handle (Process/alive? (:owner handle)))
    (let [result (call (:owner handle) [:control (:control handle) :close])]
      (when (= :closed (:status result)) (core/stop (:owner handle))))) :ok)
