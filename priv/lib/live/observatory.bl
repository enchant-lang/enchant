;; Read-only development instruments over existing owners. No registry or timer.
(ns live.observatory
  (:require [vm.observation :as runtime] [proc.work :as work] [bl.util :as util]
            [runtime.observation :as observation]
            [runtime.activity :as activity] [data.projection :as projection] [live.hiccup :as h] [web]))

(def path "/__enchant")
(def schema "enchant.observatory.v1")
(def max-owners 16)
(def max-rows 32)

(defn- label [value]
  (let [s (if (nil? value) "unknown" (str value))]
    (subs s 0 (min 160 (count s)))))

(defn- state-label [value] (label (if (keyword? value) (name value) value)))

(defn- sdk-id []
  (let [selected (erlang/apply :Elixir.System :get_env (list "BL_SDK_PRODUCT"))
        path (if (and (string? selected) (String/starts_with? selected "/nix/store/"))
               selected (BeamLisp.Tiers/priv_root))
        hash (when (and (string? path) (String/starts_with? path "/nix/store/"))
               (first (String/split (nth (String/split path "/") 3 "") "-")))]
    (when (and hash (= 32 (count hash))
               (every? #(String/contains? "0123456789abcdfghijklmnpqrsvwxyz" %) (String/codepoints hash)))
      hash)))

(defn open
  "Capture the host scope once. Explicit grants are maps of names to existing
   work owners or projection readers, at most sixteen total. Starts no work."
  ([] (open {}))
  ([options]
   (let [jobs (:work options {}) results (:projections options {})]
     (when-not (and (map? jobs) (map? results)
                   (<= (+ (count jobs) (count results)) max-owners))
       (throw (ex-info "Observatory needs at most sixteen named owner grants" {})))
     {:scope (runtime/capture) :activity (:activity options) :work jobs
      :source-link (:source-link options)
      :versions {:bl (util/version) :sdk (sdk-id)
                 :otp (erlang/list_to_binary (erlang/system_info :otp_release))}
      :projections (into {} (map (fn [[name reader]] [name (projection/reader reader)]) results))})))

(defn- job-view [row]
  {:id (label (:id row)) :title (label (:title row)) :status (state-label (:status row))
   :elapsed-ms (:elapsed-ms row) :progress (:progress row)})

(defn- work-view [[name owner]]
  (try
    (let [rows (work/snapshot owner)]
      {:name (label name) :available true :total (count rows)
       :running (count (filter observation/active? rows))
       :truncated (> (count rows) max-rows) :jobs (mapv job-view (take max-rows rows))})
    (catch _ {:name (label name) :available false :jobs []})))

(defn- projection-view [[name reader]]
  (try
    (let [result (projection/status reader)]
      {:name (label name) :status (state-label (:status result))
       :reason (when (:reason result) (label (:reason result)))
       :counts (select-keys (:counts result) [:started :coalesced :discarded :blocked])
       :wanted-basis (:wanted-basis result) :published-basis (:published-basis result)
       :work (:work result) :inputs (:inputs result)
       :retained-charge (:retained-charge result) :retention-limit (:retention-limit result)
       :demand (:demand result)})
    (catch _ {:name (label name) :status "unavailable"})))

(defn- with-links [tape link principal]
  (if-not (fn? link) tape
    (let [attach (fn [row]
                   (if-let [location (:location row)]
                     (let [url (try (link principal location) (catch _ nil))]
                       (if (and (string? url) (<= 1 (count url) 512)
                                (String/starts_with? url "/") (not (String/starts_with? url "//"))
                                (not (String/contains? url "\\")))
                         (assoc row :link url) row)) row))]
      (-> tape (update :running #(mapv attach %)) (update :recent #(mapv attach %))))))

(defn snapshot
  "One bounded sample for browser or CLI. Reads never subscribe, retry, index,
   cancel or launch analysis. Projection values and executable handles stay private.
   Reductions are cumulative; this sample does not estimate CPU percentage."
  ([observatory] (snapshot observatory nil))
  ([observatory principal]
  {:schema schema :sampled-at (erlang/system_time :millisecond)
   :versions (:versions observatory)
   :runtime (runtime/query (:scope observatory) max-rows)
   :activity (with-links (activity/snapshot (:activity observatory)) (:source-link observatory) principal)
   :work (mapv work-view (sort-by (fn [[name _]] (str name)) (:work observatory)))
   :projections (mapv projection-view (sort-by (fn [[name _]] (str name)) (:projections observatory)))
   :limits {:owners max-owners :rows-per-owner max-rows}
   :coverage {:tooling-cache (if (:activity observatory) "recorded decisions" "not enabled")
              :admission (if (:activity observatory) "recorded waits" "not enabled")
              :cpu-rate "requires consecutive samples"}}))

(def style
  (str
   ":root{color-scheme:light;--paper:#f3f0e6;--ink:#183a36;--line:#bcc7b8;--teal:#197766;--orange:#ba4c25}"
   "*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 system-ui,sans-serif}"
   "main{max-width:1260px;margin:auto;padding:36px 32px 64px}a{color:inherit;text-underline-offset:4px}"
   "header{display:flex;justify-content:space-between;gap:24px;align-items:start;border-top:5px solid var(--ink);padding-top:20px}"
   "h1{font:clamp(36px,6vw,68px)/1.05 Georgia,serif;letter-spacing:-2px;margin:8px 0 18px}h2{font:26px/1.2 Georgia,serif;margin:0}"
   ".eyebrow,.index,dt,th{font:11px/1.5 ui-monospace,monospace;text-transform:uppercase;letter-spacing:1.5px}"
   ".eyebrow{color:var(--teal)}.intro{max-width:590px;margin:0 0 26px;color:#4c6259}nav{display:flex;gap:10px;flex-wrap:wrap}"
   "nav a{border:1px solid var(--ink);padding:9px 13px;text-decoration:none;font:12px ui-monospace,monospace}nav a:first-child{background:var(--ink);color:var(--paper)}"
   ".plate{margin:26px 0;border:1px solid var(--line);background:#faf9f3}.caption{display:flex;gap:18px;align-items:center;padding:16px 20px;border-bottom:1px solid var(--line)}"
   ".index{background:var(--ink);color:var(--paper);padding:5px 8px}.sub{font-size:12px;color:#53675c}.flow{padding:24px;display:grid;grid-template-columns:repeat(5,1fr);gap:18px}"
   ".stage{position:relative;min-width:0}.stage:not(:last-child):after{content:'→';position:absolute;right:-16px;top:14px;color:var(--orange)}"
   ".symbol{font:36px/1.2 Georgia,serif;color:var(--teal);display:block}.stage b{display:block;font-size:13px}.stage small{font-size:11px;color:#53675c}"
   ".legend{padding:0 24px 18px;font-size:12px;color:#53675c}.grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.grid .plate{margin:0}"
   ".stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:20px}dl{margin:0}dd{margin:6px 0 0;font:26px/1.2 ui-monospace,monospace;overflow-wrap:anywhere}"
   ".note{margin:0;padding:0 20px 20px;color:#53675c;font-size:12px}.empty{padding:28px 20px;margin:0;color:#53675c}.owner{padding:18px 20px;border-bottom:1px solid var(--line)}"
   ".owner:last-child{border:0}.owner-head{display:flex;justify-content:space-between;gap:12px}.status{font:11px ui-monospace,monospace;border:1px solid var(--line);padding:4px 7px;white-space:nowrap}"
   ".lanes{margin:14px 0 0;padding:0;list-style:none}.lane{display:grid;grid-template-columns:18px 1fr auto;gap:10px;padding:9px 0;border-top:1px solid var(--line);font-size:12px}"
   ".dot{width:10px;height:10px;margin-top:4px;border:2px solid var(--teal);border-radius:50%}.running .dot{background:var(--teal)}.failed .dot,.cancelled .dot{border-color:var(--orange)}"
   ".counts{display:flex;gap:16px;flex-wrap:wrap;margin:12px 0;font:12px ui-monospace,monospace}.counts span{border-left:3px solid var(--teal);padding-left:7px}"
   "table{width:100%;border-collapse:collapse;text-align:left;font-size:12px}th,td{padding:12px 20px;border-bottom:1px solid var(--line)}td{font-family:ui-monospace,monospace;overflow-wrap:anywhere}"
   ".table-scroll{overflow:auto}.scale{display:block;height:5px;background:#dce1d6;min-width:70px;margin-top:5px}.scale i{display:block;height:100%;background:var(--teal)}"
   "footer{margin-top:24px;display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--ink);padding-top:15px;font:11px/1.6 ui-monospace,monospace}"
   "@media(max-width:720px){main{padding:20px 16px 40px}header{display:block}nav{margin:12px 0 24px}.grid{grid-template-columns:1fr}.flow{grid-template-columns:1fr 1fr;gap:20px}.stage:after{display:none}.stats{gap:8px}dd{font-size:19px}th,td{padding:10px}footer{display:block}}"))

(defn- symbol [kind]
  ;; Native geometry stays legible on hosts without mathematical symbol fonts.
  [:svg {:viewBox "0 0 40 40" :width 40 :height 40 :fill "none"
         :stroke "currentColor" :stroke-width 1.8 :aria-hidden "true"}
   (case kind
     :identify [[:circle {:cx 7 :cy 20 :r 3}]
                [:path {:d "M10 20H19M19 20L26 9H34M19 20H34M19 20L26 31H34"}]
                [:path {:d "M30 5V13M30 16V24M30 27V35"}]]
     :reuse [[:rect {:x 7 :y 7 :width 26 :height 7}]
             [:rect {:x 7 :y 17 :width 26 :height 7}]
             [:rect {:x 7 :y 27 :width 26 :height 7}]]
     :admit [[:path {:d "M25 5V35M31 5V35M5 13H23M5 27H23M18 8L23 13L18 18M18 22L23 27L18 32"}]]
     :derive [[:path {:d "M10 11L19 19M23 19L31 11M23 23L31 31"}]
              [:circle {:cx 7 :cy 8 :r 4}] [:circle {:cx 21 :cy 21 :r 4}]
              [:circle {:cx 34 :cy 8 :r 4}] [:circle {:cx 34 :cy 34 :r 4}]]
     :observe [[:circle {:cx 20 :cy 20 :r 13}] [:circle {:cx 20 :cy 20 :r 5}]
               [:path {:d "M20 1V5M20 35V39M1 20H5M35 20H39"}]]
     nil)])

(defn- stage [kind title detail]
  [:div {:class "stage"} [:span {:class "symbol"} (symbol kind)] [:b title] [:small detail]])
(defn- heading [index title]
  [:div {:class "caption"} [:span {:class "index"} index] [:h2 title]])
(defn- stat [title value]
  [:dl [:dt title] [:dd (if (nil? value) "—" (str value))]])
(defn- kib [n] (if (number? n) (str (quot n 1024) " KiB") "—"))

(defn page
  "Render a sampled value; pure rendering performs no observation or work."
  [sample]
  (let [rt (:runtime sample) resources (:resources rt)
        largest (reduce (fn [n row] (max n (:memory row 0))) 1 resources)]
    (str "<!doctype html>"
      (h/hiccup->html
        [:html {:lang "en"} [:head [:meta {:charset "utf-8"}]
          [:meta {:name "viewport" :content "width=device-width, initial-scale=1"}]
          [:title "Work Observatory · Enchant"] [:style style]]
         [:body [:main
          [:header [:div [:div {:class "eyebrow"} "Enchant / development instruments"]
                    [:h1 "Work, made visible."]
                    [:p {:class "intro"} "Follow the owners, inspect retained answers, and see what is actually running. One deliberate sample at a time."]]
           [:nav {:aria-label "Observatory"}
            [:a {:href path} "↻ Sample again"] [:a {:href (str path "/snapshot.json")} "↓ Snapshot JSON"] [:a {:href "/"} "Back to app"]]]
          [:section {:class "plate"} (heading "01" "The path of an answer")
           [:div {:class "flow"}
            (stage :identify "Identify" "Source · seeds · revision")
            (stage :reuse "Reuse" "Retained facts first")
            (stage :admit "Admit" "Bounded shared work")
            (stage :derive "Derive" "Follow dependencies")
            (stage :observe "Observe" "Many readers · one answer")]
           [:p {:class "legend"} "Architecture key · this diagram is explanatory. Admission occupancy and tooling cache hits are not yet instrumented."]]
          [:section {:class "plate"} (heading "02" "The captured runtime")
           [:div {:class "stats"}
            (stat "Whole VM memory" (kib (get-in rt [:vm :memory])))
            (stat "Whole VM processes" (get-in rt [:vm :processes]))
            (stat "Captured members" (:total rt))]
           [:p {:class "note"} (str "Scope: " (get-in rt [:realm :title])
             ". Physical VM totals include other realms. Listed membership belongs to the captured scope; foreground capture covers its host process only.")]]
          [:div {:class "grid"}
           [:section {:class "plate"} (heading "03" "Worker lanes")
            (if (empty? (:work sample)) [:p {:class "empty"} "No work owners registered. Pass existing proc.work owners to see their running and retained jobs."]
              (mapv (fn [owner]
                [:div {:class "owner"}
                 [:div {:class "owner-head"} [:b (:name owner)] [:span {:class "status"} (if (:available owner) (str (:total owner) " jobs") "unavailable")]]
                 [:ul {:class "lanes"}
                  (mapv (fn [job] [:li {:class (str "lane " (if (contains? #{"running" "cancelling" "failed" "cancelled"} (:status job)) (:status job) ""))}
                    [:span {:class "dot" :aria-hidden "true"}] [:span (:title job) [:br] [:small (:status job)]]
                    [:span (str (:elapsed-ms job) " ms")]]) (:jobs owner))]
                 (when (:truncated owner) [:p {:class "sub"} "Showing 32 jobs; snapshot is truncated."])]) (:work sample)))]
           [:section {:class "plate"} (heading "04" "Retained answers")
            (if (empty? (:projections sample)) [:p {:class "empty"} "No projection readers registered. This view never subscribes or starts a derivation."]
              (mapv (fn [row] [:div {:class "owner"}
                [:div {:class "owner-head"} [:b (:name row)] [:span {:class "status"} (:status row)]]
                (when (:reason row) [:p {:class "sub"} (:reason row)])
                [:div {:class "counts"}
                 (mapv (fn [key] [:span (str (name key) " " (get (:counts row) key "—"))]) [:started :coalesced :discarded :blocked])]
                (when (number? (:wanted-basis row))
                  [:p {:class "sub"}
                   (str "Requested basis " (:wanted-basis row)
                        (when (number? (:published-basis row)) (str " · published basis " (:published-basis row))))])
                (when (seq (:work row))
                  [:div {:class "counts"}
                   (mapv (fn [[key unit]] [:span (str (get (:work row) key) " " unit)])
                         (filter (fn [[key _]] (number? (get (:work row) key)))
                                 [[:steps "steps"] [:bytes "bytes charged"] [:changed "changed rows"] [:expired "expired rows"]]))])
                [:div {:class "sub"} (str "Retained charge: " (kib (:retained-charge row)) " / " (kib (:retention-limit row))
                  " · " (:demand row) " subscribers · result contents withheld")]
                (when-let [inputs (:inputs row)]
                  [:p {:class "sub"}
                   (str (:rows inputs) " retained inputs · " (kib (:charge inputs)) " / " (kib (:limit inputs)))])
                (when (and (number? (:retained-charge row)) (pos? (:retention-limit row 0)))
                  [:meter {:min 0 :max (:retention-limit row) :value (:retained-charge row)
                           :aria-label (str "Retained charge for " (:name row))} (kib (:retained-charge row))])]) (:projections sample)))]]
          [:section {:class "plate"} (heading "05" "Resource footprints")
           [:p {:class "note" :style "padding-top:16px"} "Bars compare listed process memory. Reductions count lifetime VM work; they are not CPU percentages."]
           [:div {:class "table-scroll"} [:table
            [:thead [:tr [:th "Resource / owner role"] [:th "Memory"] [:th "Reductions"] [:th "Mailbox"]]]
            [:tbody (mapv (fn [row] [:tr
              [:td (:id row) [:br] [:small (:role row)]]
              [:td (kib (:memory row)) (when (:available row)
                [:span {:class "scale"} [:i {:style (str "width:" (quot (* 100 (:memory row 0)) largest) "%")} ]])]
              [:td (if (:available row) (str (:reductions row)) "unavailable")]
              [:td (if (:available row) (str (:message_queue_len row)) "—")]]) resources)]]]
           (when (:truncated rt) [:p {:class "note"} "Showing 32 captured resources; additional members omitted."])]
          [:footer [:span "READ ONLY / manual sampling / no polling or background observer"]
           [:span (str schema " · sampled " (:sampled-at sample))]]]]]))))

(defn handler
  "An app :http handler. Host supplies authorization over its resolved principal.
   Every HTML/JSON request is checked before any owners are sampled."
  [observatory authorize]
  (fn [conn requested-path]
    (when (or (= requested-path path) (= requested-path (str path "/snapshot.json")))
      (let [conn (-> conn (web/resp-header "cache-control" "no-store")
                     (web/resp-header "x-content-type-options" "nosniff")
                     (web/resp-header "content-security-policy" "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'"))]
        (cond
          (not= true (authorize (web/private conn :me))) (web/text conn 404 "not found")
          (not= "get" (web/method conn)) (web/text conn 405 "GET required")
          :else (let [sample (snapshot observatory (web/private conn :me))]
            (if (= requested-path path) (web/html conn (page sample)) (web/json conn sample))))))))

(defn attach
  "Opt in at app construction: (attach app {:enabled? dev? :authorize developer?}).
   Pass optional :work / :projections grants. Disabled returns the original app;
   enabled requires explicit host authorization. Existing HTTP routes compose."
  [app options]
  (if-not (= true (:enabled? options)) app
    (do
      (when-not (fn? (:authorize options))
        (throw (ex-info "Development observatory requires host authorization" {})))
      (let [view (handler (open options) (:authorize options)) previous (:http app)]
        (assoc app :http (fn [conn requested-path]
          (or (view conn requested-path) (when previous (previous conn requested-path)))))))))
