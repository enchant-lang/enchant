; Portable, incremental Hiccup. Child slots have their own stable ownership.
(ns live.edit.projection
  (:require [clojure.re] [live.edit.document :as d] [live.edit.registry :as r]))
(defn- run-view [registry block from to]
  (let [calls (mapv :call (filterv #(and (<= (:from %) from) (<= to (:to %))) (:marks block)))
        source [:span {:data-edit-from from :data-edit-to to} (d/slice (:text block) from to)]]
    (reduce (fn [body call] [:span {:data-edit-call (:id call)} (r/present registry call "inline" body)]) source (reverse calls))))
(defn inline [extensions block]
  (let [ends (vec (sort (set (into [0 (d/length (:text block))] (mapcat (fn [m] [(:from m) (:to m)]) (:marks block))))))]
    (if (zero? (d/length (:text block))) [[:br {:data-edit-placeholder true}]]
      (mapv #(run-view (:functions extensions) block (nth ends %) (nth ends (inc %))) (range (dec (count ends)))))))
(defn slot [name] [:div {:class "ed-children" :data-edit-children name}])
(defn- slots [extensions b]
  (let [spec (get-in extensions [:blocks (:type b)])]
    (mapv slot (get spec :slots ["body"]))))
(defn- text-view [extensions b tag]
  (into [tag {:class "ed-text" :data-edit-text (:id b) :dir "auto" :data-placeholder "Write something…"}]
        (inline extensions b)))
(defn- safe-url [s]
  (when (and (string? s) (re-find #"^(https?://|/|#)" s)) s))
(defn node [extensions b]
  (let [id (:id b) type (get b :type "paragraph") attrs (:attrs b)
        spec (get-in extensions [:blocks type])
        text (text-view extensions b
               (if (= "heading" type) (get {1 :h1 2 :h2 3 :h3} (:level attrs) :h2) :p))
        content
        (cond
          (:render spec) ((:render spec) b {:text text :slots (into {} (map (fn [name] [name (slot name)]) (:slots spec)))})
          (= "divider" type) [:div {:class "ed-divider" :contenteditable "false" :role "separator"} [:hr]]
          (= "code" type) [:div {:class "ed-code" :contenteditable "false"}
                             [:div {:class "ed-code-label"} [:span {:data-icon "code"}]
                              [:span (get attrs :language "text")]
                              [:span {:class "ed-code-caption"} "Source"]]
                             [:div {:data-edit-code id :data-language (get attrs :language "text")}
                              [:pre {:data-edit-text id :class "ed-code-fallback"} (:text b)]]]
          (= "callout" type) [:aside {:class "ed-callout" :data-tone (get attrs :tone "amber")}
             [:button {:type "button" :class "ed-callout-icon" :contenteditable "false" :data-node-icon id
                       :aria-label "Change callout icon"} [:span {:data-icon (get attrs :icon "lightbulb")}]]
             (into [:div {:class "ed-callout-content"} text] (slots extensions b))]
          (= "task" type) [:div {:class "ed-task" :data-checked (str (boolean (:checked attrs)))}
             [:button {:type "button" :class "ed-checkbox" :contenteditable "false" :data-node-check id
                       :role "checkbox" :aria-checked (str (boolean (:checked attrs))) :aria-label "Complete task"}
              [:span {:data-icon "check"}]]
             (into [:div {:class "ed-task-content"} text] (slots extensions b))]
          (= "quote" type) (into [:blockquote {:class "ed-quote"} text] (slots extensions b))
          (= "image" type) (into [:figure {:class "ed-image" :contenteditable "false"}
             (if-let [url (safe-url (:src attrs))] [:img {:src url :alt (get attrs :alt "")}]
               [:button {:type "button" :data-node-media id :class "ed-media-placeholder"}
                [:span {:data-icon "image"}] "Add an image"])] (slots extensions b))
          (= "embed" type) (into [:div {:class "ed-bookmark" :contenteditable "false"}
             (if-let [url (safe-url (:href attrs))] [:a {:href url :target "_blank" :rel "noopener noreferrer"} url]
               [:button {:type "button" :data-node-media id} [:span {:data-icon "link"}] "Add a bookmark"])] (slots extensions b))
          :else (into [:div {:class (str "ed-content " (when (nil? spec) "ed-unavailable"))}
                        (when (nil? spec) [:span {:class "ed-unavailable-label" :contenteditable "false"} type]) text]
                      (slots extensions b)))
        wrapped (reduce (fn [body call] [:div {:data-edit-call (:id call)}
                            (r/present (:functions extensions) call "block" body)]) content (reverse (:wraps b)))]
    [:div {:key id :class "ed-node" :data-edit-block id :data-node-type type
           :data-parent (or (:parent b) "") :data-slot (get b :slot "body")}
     [:div {:class "ed-node-gutter" :contenteditable "false"}
      [:button {:type "button" :data-node-add id :aria-label "Insert a block" :tabindex "-1"} [:span {:data-icon "plus"}]]
      [:button {:type "button" :data-node-menu id :aria-label "Block actions" :tabindex "-1" :draggable "true"} [:span {:data-icon "grip"}]]]
     wrapped]))
(defn- fill-children [tree children]
  (if-not (vector? tree) tree
    (let [attrs (when (map? (second tree)) (second tree)) start (if attrs 2 1)]
      (if (:data-edit-children attrs)
        (into (subvec tree 0 start) (get children (:data-edit-children attrs) []))
        (into (subvec tree 0 start) (mapv #(fill-children % children) (subvec tree start)))))))
(declare project-tree)
(defn- project-tree [extensions grouped b]
  (let [children (group-by :slot (get grouped (:id b) []))
        projected (into {} (map (fn [[name rows]] [name (mapv #(project-tree extensions grouped %) rows)]) children))
        known (set (get-in extensions [:blocks (:type b) :slots] ["body"]))
        base (fill-children (node extensions b) projected)]
    (into base (mapv (fn [name] (into [:div {:class "ed-children ed-retained-slot" :data-edit-children name}] (get projected name)))
                   (remove known (keys children))))))
(defn body-node [extensions doc b] (project-tree extensions (group-by :parent (:blocks doc)) b))
(defn body [extensions doc]
  (let [grouped (group-by :parent (:blocks doc))]
    (mapv #(project-tree extensions grouped %) (get grouped nil []))))
(defn- reading-tree [tree icon]
 (cond
  (vector? tree)
  (let [tag (first tree) attrs (when (map? (second tree)) (second tree)) start (if attrs 2 1)
        checkbox? (and (= tag :button) (= "checkbox" (:role attrs)))
        inert? (or (= tag :button) (= tag :form))
        cleaned (into {} (remove (fn [[key _]]
          (let [attribute (if (keyword? key) (name key) (str key))]
           (or (= key :live/region) (starts-with? (lower-case attribute) "on")
               (starts-with? attribute "data-ev-") (starts-with? attribute "data-edit-")
               (and (starts-with? attribute "data-node-") (not= attribute "data-node-type"))
               (contains? #{:contenteditable :draggable :tabindex :data-placeholder} key)
               (and inert? (contains? #{:type :action :method :enctype :aria-label :aria-pressed} key))))) attrs))
        cleaned (cond
                  checkbox? (assoc cleaned :aria-label "Task status" :aria-readonly "true" :aria-disabled "true")
                  (and (= tag :button) (:data-node-icon attrs)) (assoc cleaned :aria-hidden "true")
                  (contains? #{:input :textarea :select} tag) (assoc cleaned :disabled true :readonly true :tabindex -1)
                  :else cleaned)]
   (cond
    (or (= "ed-node-gutter" (:class attrs)) (:data-edit-controls attrs)) nil
    (:data-icon attrs) (if icon (icon (:data-icon attrs))
                       [:span {:class "ed-read-icon" :aria-hidden "true"} (if (= "check" (:data-icon attrs)) "✓" "•")])
    (and (= tag :button) (:data-node-media attrs)) [:span {:class "ed-readonly-placeholder"} "Media unavailable"]
    :else (into [(cond (= tag :button) :span (= tag :form) :div :else tag) cleaned]
            (keep #(reading-tree % icon) (subvec tree start)))))
  (sequential? tree) (keep #(reading-tree % icon) tree)
  :else tree))
(defn reader
 "The same rich projection without an editing host, handlers or authoring
  controls. Optional :icon is a pure host renderer; :label names the document."
 [extensions document options]
 [:section {:key (:id document) :class "enchanted-document ed-reader" :data-editor-reader true}
  (into [:div {:class "ed-canvas" :role "document" :aria-label (:label options "Document") :contenteditable "false"}]
        (keep #(reading-tree % (:icon options)) (body extensions document)))])
(defn editor [extensions snapshot event stamp refusal]
  (let [doc (:document snapshot)]
    [:section {:key (:id doc) :class "enchanted-document"
               :live/region {:kind "enchanted-document" :id (:id doc)
                 :model {:snapshot snapshot :event event :stamp stamp :refusal refusal}}}
     [:div {:class "ed-canvas" :data-edit-canvas true :role "textbox" :aria-label "Document" :aria-multiline "true"
            :contenteditable "false" :spellcheck "true"} (body extensions doc)]
     [:div {:class "ed-live-status" :role "status" :aria-live "polite"} "Connecting…"]]))
