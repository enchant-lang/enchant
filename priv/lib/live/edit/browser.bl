; Native interop is confined to the browser boundary. Editing policy stays BL.
(ns ^:js live.edit.browser
  (:require [live.edit.model :as m] [live.edit.sync :as s]
            [live.edit.registry :as r] [live.edit.view :as view] [live.edit.tools :as tools]))
(defn- data [value] (js->bl value :keywordize-keys true))
(defn api-with [packages]
  (let [registry (r/functions packages)]
        #js {:catalog (fn [] (bl->js (r/catalog registry)))
                 :authority (fn [doc] (bl->js (s/authority registry (data doc))))
                 :decide (fn [state proposal] (bl->js (s/decide registry (data state) (data proposal))))
                 :replica (fn [snapshot] (bl->js (s/replica (data snapshot))))
                 :enqueue (fn [state id op] (bl->js (s/enqueue registry (data state) id (data op))))
                 :adopt (fn [state snapshot] (bl->js (s/adopt registry (data state) (data snapshot))))
                 :reply (fn [state reply] (bl->js (s/receive-reply registry (data state) (data reply))))
                 :outbound (fn [state] (bl->js (s/outbound (data state))))
                 :undo (fn [state id] (bl->js (s/undo registry (data state) id)))
                 :redo (fn [state id] (bl->js (s/redo registry (data state) id)))
                 :confirmed (fn [state] (bl->js (s/use-confirmed (data state))))
                 :body (fn [doc] (bl->js (view/body registry (data doc))))
                 :difference (fn [before after] (bl->js (s/difference (data before) (data after))))
                 :fragment (fn [doc anchor head] (bl->js (m/fragment (data doc) (data anchor) (data head))))
                 :editor (fn [snapshot event] (bl->js (view/editor registry (data snapshot) (data event) 0 nil)))}))
(defn api [] (api-with [tools/package]))
(defn install-with
  "Install an owned Live region driver using ordinary BL function packages.
   host implements mount(root, model, services, api). Returns a disposer."
  [host packages]
  (let [host (bl->js host) api (api-with packages)]
    (.registerRegion js/Live "editable-text"
      (fn [root model services] (.mount host root model services api)))))
(defn install [host] (install-with host [tools/package]))
