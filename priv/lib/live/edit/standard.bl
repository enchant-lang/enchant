(ns live.edit.standard
  (:require [live.edit.tools :as legacy] [live.edit.registry :as r]))
(defn bold [_ body] [:strong body])
(defn underline [_ body] [:u body])
(defn strike [_ body] [:s body])
(defn code [_ body] [:code body])
(defn link [args body]
  (when-not (re-find #"^(https?://|mailto:|/|#)" (:href args)) (r/fail "invalid-link"))
  [:a {:href (:href args) :rel "noopener noreferrer"} body])
(def block-types
  {"paragraph" {:label "Text" :icon "text" :description "Just start writing" :slots ["body"]}
   "heading" {:label "Heading" :icon "heading" :description "Give your ideas a little structure" :slots ["body"] :defaults {:level 2}}
   "bullet" {:label "Bulleted list" :icon "list" :description "Gather a few connected thoughts" :slots ["body"]}
   "ordered" {:label "Numbered list" :icon "list-ordered" :description "One thing after another" :slots ["body"]}
   "task" {:label "To-do" :icon "check-square" :description "Make something happen" :slots ["body"] :defaults {:checked false}}
   "quote" {:label "Quote" :icon "quote" :description "Words worth holding on to" :slots ["body"]}
   "callout" {:label "Callout" :icon "lightbulb" :description "An idea that deserves a moment" :slots ["body" "caption"] :defaults {:icon "lightbulb" :tone "amber"}}
   "code" {:label "Code" :icon "code" :description "A precise little expression" :slots [] :defaults {:language "beam-lisp"}}
   "divider" {:label "Divider" :icon "minus" :description "Give your thoughts room to breathe" :slots []}
   "image" {:label "Image" :icon "image" :description "A picture, with a caption" :slots ["caption"] :defaults {:src "" :alt ""}}
   "embed" {:label "Bookmark" :icon "link" :description "Keep a useful reference close" :slots ["caption"] :defaults {:href ""}}})
(def package
  {:name "standard" :provides
   {:editor/blocks block-types
    :editor/functions
    (merge (get-in legacy/package [:provides :editor/functions])
      {"text/bold" {:label "Bold" :kind "wrap" :scope "inline" :render bold :ui {:icon "bold" :shortcut "Mod-b" :group "basic"}}
       "text/underline" {:label "Underline" :kind "wrap" :scope "inline" :render underline :ui {:icon "underline" :shortcut "Mod-u" :group "basic"}}
       "text/strike" {:label "Strikethrough" :kind "wrap" :scope "inline" :render strike :ui {:icon "strike" :group "basic"}}
       "text/code" {:label "Inline code" :kind "wrap" :scope "inline" :render code :ui {:icon "code" :shortcut "Mod-e" :group "basic"}}
       "text/link" {:label "Link" :kind "wrap" :scope "inline" :render link :ui {:icon "link" :shortcut "Mod-k" :group "basic"}
                    :params {:href {:type "text" :format "url" :default "https://"}}}})}})
