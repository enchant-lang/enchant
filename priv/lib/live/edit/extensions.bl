; Installed packages are values. UI metadata never enters the semantic digest.
(ns live.edit.extensions (:require [live.edit.registry :as r]))
(defn build [packages]
  (let [parts (map :provides packages)
        blocks (reduce merge {} (map :editor/blocks parts))
        exports (reduce merge {} (map :editor/exports parts))
        functions (r/functions packages)]
    (doseq [[id spec] blocks]
      (when-not (and (string? id) (string? (:label spec)) (vector? (:slots spec))
                    (every? string? (:slots spec))) (r/fail "invalid-block-spec")))
    (doseq [[id spec] exports]
      (when-not (and (string? id) (not (contains? #{"json" "markdown"} id))
                     (string? (:label spec)) (not (blank? (:label spec)))
                     (string? (:extension spec)) (re-find #"^(?:\.[a-zA-Z0-9]+)+$" (:extension spec))
                     (string? (:mime spec)) (fn? (:write spec)))
        (r/fail "invalid-export-spec")))
    {:packages packages :functions functions :blocks blocks
     :commands (reduce merge {} (map :editor/commands parts))
     :policies (vec (keep :editor/command-policy parts))
     :ranges (vec (keep :editor/selection-ranges parts))
     :sibling-contexts (vec (keep :editor/sibling-context parts))
     :typings (vec (keep :editor/typing parts))
     :clipboards (vec (keep :editor/clipboard parts))
     :exports exports
     :surfaces (reduce merge {} (map :editor/surfaces parts))}))
(defn catalog [extensions]
  {:functions (mapv #(select-keys % [:id :label :kind :scope :params :version :ui])
                   (r/catalog (:functions extensions)))
   :blocks (mapv (fn [[id spec]] (assoc (select-keys spec [:label :icon :description :slots :defaults]) :id id))
                 (sort-by first (filter (fn [[_ spec]] (not= false (:insertable spec))) (:blocks extensions))))})
