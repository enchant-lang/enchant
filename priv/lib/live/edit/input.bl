; Pure package planning for native typing, composition and inline replacement.
; The host supplies model coordinates; the final writer still admits the op.
(ns live.edit.input (:require [live.edit.capabilities :as r]))
(defn plan [extensions context op options]
 (let [proposed (when (:input options)
                  (some (fn [provider]
                          (provider context {:op op :selection (:selection options) :seed (:id options)}))
                        (:typings extensions)))]
  (when (and proposed (not (and (map? proposed) (map? (:op proposed)))))
    (r/fail "invalid-input-plan"))
  {:op (if proposed (:op proposed) op)
   :options (if (and proposed (contains? proposed :selection)) (assoc options :selection (:selection proposed)) options)}))
