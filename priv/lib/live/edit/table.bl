;; Generic structured tables. Source formats belong to their own packages.
(ns ^:js live.edit.table
 (:require [live.edit.document :as d] [live.edit.capabilities :as r]))
(def max-rows 256)
(def max-columns 32)
(defn- point [id offset] {:block id :offset offset :affinity "right"})
(defn- selection [id offset] {:anchor (point id offset) :head (point id offset)})
(defn- ancestor [document id type]
 (loop [block (d/find-block document id) depth 0]
  (cond (nil? block) nil (= type (:type block)) block
        (>= depth 32) nil :else (recur (d/find-block document (:parent block)) (inc depth)))))
(defn inside? [context]
 (some? (ancestor (:document context) (get-in context [:selection :head :block]) "table")))
(defn- cell? [context]
 (= "table-cell" (:type (d/find-block (:document context) (get-in context [:selection :head :block])))))
(defn shape [context]
 (let [document (:document context) id (get-in context [:selection :head :block])
       table (ancestor document id "table") grouped (group-by :parent (:blocks document))
       rows (get grouped (:id table) []) cells (mapv #(get grouped (:id %) []) rows)
       row (ancestor document id "table-row")
       row-index (or (first (keep-indexed #(when (= (:id row) (:id %2)) %1) rows)) (dec (count rows)))
       column-index (or (first (keep-indexed #(when (= id (:id %2)) %1) (get cells row-index [])))
                        (dec (count (first cells))))]
  (when-not (and table (<= 1 (count rows) max-rows)
                (<= 1 (count (first cells)) max-columns)
                (every? #(and (= "table-row" (:type %)) (= "rows" (:slot %))) rows)
                (every? #(and (= (count (first cells)) (count %))
                              (every? (fn [cell] (and (= "table-cell" (:type cell)) (= "cells" (:slot cell))
                                                     (empty? (get grouped (:id cell))))) %)) cells))
   (r/fail "Choose a rectangular table with editable cells."))
  {:table table :rows rows :cells cells :row row-index :column column-index}))
(defn- cell [id parent header alignment]
 (assoc (d/block id "table-cell" "" {:header header :align alignment}) :parent parent :slot "cells"))
(defn- row-blocks [seed table columns header alignments]
 (let [row (assoc (d/block seed "table-row" "" {:header header}) :parent table :slot "rows")]
  (into [row] (mapv #(cell (str seed "/c" %) seed header (get alignments % "left")) (range columns)))))
(defn- set-attrs [block values]
 {:op "node/set" :block (:id block) :patch {:attrs (merge (:attrs block) values)}})
(defn insert [context _]
 (let [document (:document context) selected (d/find-block document (get-in context [:selection :head :block]))
       outer (or (ancestor document (:id selected) "table") selected)
       seed (:seed context) table (d/block seed "table" "" {:header true :rows 3 :columns 2})
       blocks (into [table] (mapcat #(row-blocks (str seed "/r" %) seed 2 (zero? %) ["left" "left"]) (range 3)))]
  {:ops [{:op "node/insert" :after (:id outer) :parent (:parent outer) :slot (:slot outer) :blocks blocks}]
   :selection (selection (str seed "/r0/c0") 0)}))
(defn add-row [context _]
 (let [{:keys [table rows cells row]} (shape context) n (count rows)
       columns (count (first cells)) seed (:seed context)]
  (when (>= n max-rows) (r/fail "This table has reached its row limit."))
  {:ops [{:op "node/insert" :after (:id (nth rows row)) :parent (:id table) :slot "rows"
          :blocks (row-blocks seed (:id table) columns false (mapv #(get-in % [:attrs :align] "left") (first cells)))}
         (set-attrs table {:rows (inc n) :columns columns})]
   :selection (selection (str seed "/c0") 0)}))
(defn add-column [context _]
 (let [{:keys [table rows cells row column]} (shape context) n (count (first cells)) seed (:seed context)]
  (when (>= n max-columns) (r/fail "This table has reached its column limit."))
  {:ops (conj (mapv (fn [i]
                     {:op "node/insert" :after (:id (get-in cells [i column])) :parent (:id (nth rows i)) :slot "cells"
                      :node (cell (str seed "/r" i) (:id (nth rows i))
                                  (and (zero? i) (get-in table [:attrs :header] true)) "left")}) (range (count rows)))
               (set-attrs table {:rows (count rows) :columns (inc n)}))
   :selection (selection (str seed "/r" row) 0)}))
(defn- header-ops [rows cells enabled]
 (into [(set-attrs (first rows) {:header enabled})]
       (mapv #(set-attrs % {:header enabled}) (first cells))))
(defn remove-row [context _]
 (let [{:keys [table rows cells row column]} (shape context) n (count rows) next-row (if (= row (dec n)) (dec row) (inc row))]
  (when (= n 1) (r/fail "Keep at least one row in this table."))
  {:ops (into [{:op "node/delete" :block (:id (nth rows row))} (set-attrs table {:rows (dec n)})]
               (when (zero? row) (header-ops (subvec rows 1) (subvec cells 1) (get-in table [:attrs :header] true))))
   :selection (selection (:id (get-in cells [next-row column])) 0)}))
(defn remove-column [context _]
 (let [{:keys [table rows cells row column]} (shape context) n (count (first cells))
       next-column (if (= column (dec n)) (dec column) (inc column))]
  (when (= n 1) (r/fail "Keep at least one column in this table."))
  {:ops (conj (mapv #(hash-map :op "node/delete" :block (:id (nth % column))) cells)
               (set-attrs table {:columns (dec n)}))
   :selection (selection (:id (get-in cells [row next-column])) 0)}))
(defn toggle-header [context _]
 (let [{:keys [table rows cells]} (shape context) enabled (not (get-in table [:attrs :header] true))]
  {:ops (into [(set-attrs table {:header enabled})] (header-ops rows cells enabled))}))
(defn align-column [context _]
 (let [{:keys [cells column]} (shape context)
       alignment (get {"left" "center" "center" "right" "right" "left"} (get-in cells [0 column :attrs :align] "left") "left")]
  {:ops (mapv #(set-attrs (nth % column) {:align alignment}) cells)}))
(defn- navigate [context delta]
 (let [{:keys [cells row column]} (shape context) columns (count (first cells))
       flat (vec (mapcat identity cells)) at (+ (* row columns) column) next (+ at delta)]
  (cond
   (< next 0) {:selection (selection (:id (first flat)) 0)}
   (< next (count flat)) {:selection (selection (:id (nth flat next)) 0)}
   :else (let [plan (add-row (assoc-in context [:selection :head :block] (:id (last flat))) {})]
           plan))))
(defn next-cell [context _] (navigate context 1))
(defn previous-cell [context _] (navigate context -1))
(defn next-row [context _]
 (let [{:keys [cells row column]} (shape context) columns (count (first cells))]
  (if (< (inc row) (count cells)) {:selection (selection (:id (get-in cells [(inc row) column])) 0)}
   (let [plan (add-row context {}) id (str (:seed context) "/c" column)]
    (assoc plan :selection (selection id 0))))))
(defn leave [context _]
 (let [{:keys [table]} (shape context) document (:document context)
       end (+ (d/block-index document (:id table)) (count (d/subtree document (:id table))))
       following (first (filter #(and (not (contains? #{"table" "table-row" "table-cell" "org-retained" "divider" "image" "embed"} (:type %)))
                                      (= (:parent table) (:parent %))) (subvec (:blocks document) end)))
       seed (:seed context)]
  (if following {:selection (selection (:id following) 0)}
   {:ops [{:op "node/insert" :after (:id table) :parent (:parent table) :slot (:slot table) :node (d/block seed "")}]
    :selection (selection seed 0)})))
(defn- boundary? [context backward]
 (let [a (get-in context [:selection :anchor]) h (get-in context [:selection :head])
       block (d/find-block (:document context) (:block h))]
  (and (= "table-cell" (:type block)) (= (:block a) (:block h)) (= (:offset a) (:offset h))
       (= (:offset h) (if backward 0 (d/length (:text block)))))))
(defn boundary-back [context _]
 (let [{:keys [cells row column]} (shape context) flat (vec (mapcat identity cells))
       at (+ (* row (count (first cells))) column) cell (nth flat (max 0 (dec at)))]
  {:selection (selection (:id cell) (if (zero? at) 0 (d/length (:text cell))))}))
(defn boundary-forward [context _]
 (let [{:keys [cells row column]} (shape context) flat (vec (mapcat identity cells))
       at (+ (* row (count (first cells))) column) cell (nth flat (min (dec (count flat)) (inc at)))]
  {:selection (selection (:id cell) (if (= at (dec (count flat))) (d/length (:text cell)) 0))}))
(defn command-policy [context item]
 (if (and (:selection/reason context)
          (or (inside? context)
              (ancestor (:document context) (get-in context [:selection :anchor :block]) "table")))
  (if (= "history" (:kind item)) item (assoc item :enabled false :reason (:selection/reason context)))
  (if-not (inside? context) item
  (let [id (:id item) root? (= "table" (:type (d/find-block (:document context) (get-in context [:selection :head :block]))))
        structural (or (starts-with? id "turn/") (starts-with? id "insert/") (starts-with? id "block/"))
        allowed (or (not structural) (and root? (contains? #{"block/delete" "block/duplicate" "block/up" "block/down"} id)))
        allowed (and allowed (or (cell? context) (not (contains? #{"wrap" "transform"} (:kind item)))))
        allowed (and allowed (not (and (= "wrap" (:kind item)) (= "block" (:scope item)))))]
   (if allowed item (assoc item :enabled false :reason "Use the table controls to keep its rows and columns together."))))))
(defn- control [command target label icon]
 [:button {:type "button" :contenteditable "false" :data-edit-command command :data-edit-command-target target
           :aria-label label :title label} [:span {:data-icon icon}] [:span label]])
(defn table-view [block context]
 [:section {:class "ed-table" :style (str "--ed-table-columns:" (let [n (get-in block [:attrs :columns] 2)] (if (and (integer? n) (<= 1 n max-columns)) n 2)))}
  [:div {:class "ed-table-toolbar" :role "toolbar" :aria-label "Table tools" :contenteditable "false" :data-edit-controls true}
   (control "table/add-row" (:id block) "Add row" "plus")
   (control "table/add-column" (:id block) "Add column" "columns")
   (assoc-in (control "table/toggle-header" (:id block) "Header row" "heading") [1 :aria-pressed] (str (boolean (get-in block [:attrs :header] true))))]
  [:div {:class "ed-table-scroll" :role "table" :aria-label "Table"}
   (update-in (get-in context [:slots "rows"]) [1 :class] str " ed-table-rows")]] )
(defn row-view [block context]
 [:div {:class "ed-table-row" :role "row" :data-header (str (boolean (get-in block [:attrs :header])))}
  (update-in (get-in context [:slots "cells"]) [1 :class] str " ed-table-cells")])
(defn cell-view [block context]
 [:div {:class "ed-table-cell" :role (if (get-in block [:attrs :header]) "columnheader" "cell")
        :data-align (get-in block [:attrs :align] "left")}
  (assoc-in (:text context) [1 :data-placeholder] "")])
(def block-types
 {"table" {:label "Table" :icon "table" :slots ["rows"] :insertable false :render table-view}
  "table-row" {:label "Table row" :slots ["cells"] :insertable false :render row-view}
  "table-cell" {:label "Table cell" :slots [] :insertable false :render cell-view :actions-label "Cell actions" :draggable false}})
;; Clipboard data is finite, source-independent and uses the ordinary journal.
(defn rectangle [context]
 (let [document (:document context) anchor (get-in context [:selection :anchor :block])
       head (get-in context [:selection :head :block])
       a (ancestor document anchor "table") z (ancestor document head "table")]
  (when (and (or a z) (not= anchor head))
   (when-not (and a z (= (:id a) (:id z))
                   (= "table-cell" (:type (d/find-block document anchor)))
                   (= "table-cell" (:type (d/find-block document head))))
    (r/fail "Select cells within one table, or copy the whole table as a block."))
   (let [start (shape (assoc-in context [:selection :head :block] anchor)) end (shape context)]
    (assoc end :from-row (min (:row start) (:row end)) :to-row (max (:row start) (:row end))
               :from-column (min (:column start) (:column end)) :to-column (max (:column start) (:column end)))))))
(defn selection-ranges [context]
 (let [document (:document context) a (get-in context [:selection :anchor :block])
       z (get-in context [:selection :head :block])
       left (ancestor document a "table") right (ancestor document z "table")]
  (when (and (or left right) (not= a z))
   (if-not (and left right (= (:id left) (:id right))
                (= "table-cell" (:type (d/find-block document a)))
                (= "table-cell" (:type (d/find-block document z))))
    {:reason "Select cells in one table, or choose the table as a whole block."}
    (try
     (let [rect (rectangle context)]
      {:ranges (vec (mapcat (fn [row]
                        (mapv (fn [cell] {:block (:id cell) :from 0 :to (d/length (:text cell))})
                         (subvec (nth (:cells rect) row) (:from-column rect) (inc (:to-column rect)))))
                       (range (:from-row rect) (inc (:to-row rect)))))} )
     (catch _ {:reason "This table needs source review before formatting."}))))))
(defn- grid-cell [value seed functions]
 (let [cell (assoc (d/block seed "table-cell" (:text value) {}) :marks (:marks value []))]
  (when-not (and (d/block? cell) (empty? (:wraps value)) (not (:parent value)))
   (r/fail "Paste plain text or supported inline content into table cells."))
  (update cell :marks
   (fn [marks]
    (let [ids (zipmap (distinct (map #(get-in % [:call :id]) marks)) (range (count marks)))]
     (mapv (fn [mark]
             (let [call (:call mark)
                   installed (r/application functions (str seed "/m" (get ids (:id call))) (:function call) (:args call) "inline")]
              (when-not (= (:version call) (:version installed)) (r/fail "function-contract-changed"))
              (assoc mark :call installed))) marks))))))

(defn paste-grid [context grid]
 (when-not (and (vector? grid) (<= 1 (count grid) max-rows)
                (vector? (first grid)) (<= 1 (count (first grid)) max-columns)
                (every? #(and (vector? %) (= (count (first grid)) (count %))) grid))
  (r/fail "Paste a rectangular grid with at most 256 rows and 32 columns."))
 (let [rect (rectangle context) {:keys [table rows cells row column]} (shape context)
       row (get rect :from-row row) column (get rect :from-column column)
       height (count grid) width (count (first grid))
       total-rows (max (count rows) (+ row height)) total-columns (max (count (first cells)) (+ column width))
       _ (when-not (and (<= total-rows max-rows) (<= total-columns max-columns))
           (r/fail "This paste would exceed the table's row or column limit."))
       seed (:seed context) old-columns (count (first cells))
       alignments (mapv #(get-in % [:attrs :align] "left") (first cells))
       new-rows (mapv #(row-blocks (str seed "/r" %) (:id table) total-columns false alignments)
                     (range (count rows) total-rows))
       new-columns (mapv (fn [r]
                           (mapv #(cell (str seed "/r" r "/c" %) (:id (nth rows r))
                                        (and (zero? r) (get-in table [:attrs :header])) "left")
                                 (range old-columns total-columns))) (range (count rows)))
       expanded (into (mapv #(into (nth cells %) (nth new-columns %)) (range (count rows)))
                      (mapv #(subvec % 1) new-rows))
       inserts (into (vec (keep-indexed (fn [r values]
                              (when (seq values) {:op "node/insert" :after (:id (last (nth cells r)))
                               :parent (:id (nth rows r)) :slot "cells" :blocks values})) new-columns))
                     (map-indexed (fn [r values] {:op "node/insert" :after (if (zero? r) (:id (last rows)) (:id (first (nth new-rows (dec r)))))
                       :parent (:id table) :slot "rows" :blocks values}) new-rows))
       replacements (vec (mapcat (fn [r]
                           (mapv (fn [c]
                             (let [value (grid-cell (get-in grid [r c]) (str seed "/v" r "/" c) (:functions context))
                                   target (get-in expanded [(+ row r) (+ column c)])]
                              {:op "text/replace" :block (:id target) :from 0 :to (d/length (:text target))
                               :expected (:text target) :text (:text value) :styles [] :restore (:marks value)})) (range width))) (range height)))
       ops (into (conj inserts (set-attrs table {:rows total-rows :columns total-columns})) replacements)
       _ (when (> (count ops) 4096) (r/fail "Paste a smaller table section at a time."))
       first-cell (get-in expanded [row column])]
  {:ops ops :selection (selection (:id first-cell) 0)}))
(defn- quote-tsv [text]
 (if (or (includes? text "\t") (includes? text "\n") (includes? text "\r") (includes? text "\""))
  (str "\"" (String/replace text "\"" "\"\"") "\"") text))
(defn- clipboard-rectangle-copy [context _]
 (when-let [rect (rectangle context)]
  (let [{:keys [cells from-row to-row from-column to-column table]} rect
        grid (mapv (fn [r] (subvec (nth cells r) from-column (inc to-column))) (range from-row (inc to-row)))
        root (assoc table :parent nil :slot "body" :attrs {:header (and (zero? from-row) (get-in table [:attrs :header]))
                   :rows (count grid) :columns (count (first grid))})
        blocks (into [root] (mapcat (fn [r]
                                  (let [row-id (str (:seed context) "/copy" r) header (and (zero? r) (get-in root [:attrs :header]))]
                                   (into [(assoc (d/block row-id "table-row" "" {:header header}) :parent (:id root) :slot "rows")]
                                    (mapv #(-> % (assoc :parent row-id :slot "cells") (assoc-in [:attrs :header] header)) (nth grid r))))) (range (count grid))))
        clear (mapv (fn [cell] {:op "text/replace" :block (:id cell) :from 0 :to (d/length (:text cell))
                                :expected (:text cell) :text "" :styles [] :restore []}) (vec (mapcat identity grid)))]
   (when (> (count clear) 4096) (r/fail "Copy a smaller table section at a time."))
   {:blocks blocks :text (join "\n" (map #(join "\t" (map (comp quote-tsv :text) %)) grid))
    :cells (mapv :id (mapcat identity grid)) :cut {:ops clear :selection (selection (:id (first (first grid))) 0)}})))
(defn clipboard-paste [context payload]
 (when (or (inside? context) (ancestor (:document context) (get-in context [:selection :anchor :block]) "table"))
  (let [_ (rectangle context)
        _ (when-not (cell? context) (r/fail "Place the caret in a table cell before pasting."))
        blocks (:blocks payload) table (first blocks)
        grid (if (= "table" (:type table))
               (let [document (d/document "clipboard" blocks) _ (d/validate document)
                     _ (when-not (= (count blocks) (count (d/subtree document (:id table))))
                         (r/fail "Paste one table at a time into table cells; other copied blocks remain on the clipboard."))
                     shaped (shape {:document document :selection (selection (:id table) 0)})]
                (mapv #(mapv (fn [cell] (select-keys cell [:text :marks])) %) (:cells shaped))) (:grid payload))]
   (cond grid (paste-grid context grid)
         (rectangle context) (paste-grid context [[{:text (:text payload "") :marks []}]])
         (seq blocks)
         (let [_ (when-not (every? #(and (nil? (:parent %)) (contains? #{"paragraph" "heading" "quote"} (:type %)) (empty? (:wraps %))) blocks)
                   (r/fail "Paste text, inline formatting or one rectangular table into a cell."))
               value (reduce (fn [result entry]
                               (let [[i block] entry offset (+ (d/length (:text result)) (if (zero? i) 0 1))]
                                {:text (str (:text result) (when (pos? i) "\n") (:text block))
                                 :marks (into (:marks result) (mapv #(-> % (update :from + offset) (update :to + offset)) (:marks block)))}))
                             {:text "" :marks []} (map-indexed (fn [index block] [index block]) blocks))
               value (grid-cell value (:seed context) (:functions context))
               [a z] (d/ordered-range (:document context) (get-in context [:selection :anchor]) (get-in context [:selection :head]))
               end (+ (:offset a) (d/length (:text value)))]
          {:ops [{:op "text/replace" :block (:block a) :from (:offset a) :to (:offset z) :text (:text value) :styles [] :restore (:marks value)}]
           :selection (selection (:block a) end)})
         :else nil))))

(defn clipboard-selection [context _]
 (when-let [rect (rectangle context)]
  {:cells (vec (mapcat (fn [row] (mapv :id (subvec (nth (:cells rect) row) (:from-column rect) (inc (:to-column rect)))))
                  (range (:from-row rect) (inc (:to-row rect)))))}))
(defn clipboard-copy [context payload]
 (or (clipboard-rectangle-copy context payload)
  (when (cell? context)
   (let [[a z] (d/ordered-range (:document context) (get-in context [:selection :anchor]) (get-in context [:selection :head]))
         block (first (d/fragment (:document context) a z))
         fragment (assoc block :type "paragraph" :parent nil :slot "body" :attrs {} :wraps [])]
    {:blocks [fragment] :text (:text fragment)
     :cut {:ops [{:op "text/replace" :block (:block a) :from (:offset a) :to (:offset z)
                  :expected (:text fragment) :text "" :styles [] :restore []}]
           :selection (selection (:block a) (:offset a))}}))))
(defn clipboard-cut [context payload] (:cut (clipboard-copy context payload)))

(defn- across-cells? [context]
 (and (not= (get-in context [:selection :anchor :block]) (get-in context [:selection :head :block]))
      (or (inside? context) (ancestor (:document context) (get-in context [:selection :anchor :block]) "table"))))
(defn replace-rectangle [context args]
 (let [copied (clipboard-copy context {}) plan (:cut copied) first-cell (get-in plan [:selection :head :block]) text (:text args "")]
  (when-not copied (r/fail "Choose a rectangle of table cells."))
  (assoc plan :ops (mapv #(if (= first-cell (:block %)) (assoc % :text text) %) (:ops plan))
              :selection (selection first-cell (d/length text)))))
(def commands
 {"table/insert" {:label "Table" :description "Organize a few related facts" :icon "table" :menu "insert" :run insert}
  "table/add-row" {:menu "block" :label "Add row" :icon "plus" :when inside? :run add-row}
  "table/add-column" {:menu "block" :label "Add column" :icon "columns" :when inside? :run add-column}
  "table/remove-row" {:menu "block" :label "Remove row" :icon "trash" :when inside? :run remove-row}
  "table/remove-column" {:menu "block" :label "Remove column" :icon "trash" :when inside? :run remove-column}
  "table/toggle-header" {:menu "block" :label "Header row" :icon "heading" :when inside? :run toggle-header}
  "table/align-column" {:menu "block" :label "Align column" :icon "align-left" :when cell? :run align-column}
  "table/next-cell" {:label "Next cell" :shortcut "Tab" :when cell? :run next-cell}
  "table/previous-cell" {:label "Previous cell" :shortcut "Shift-Tab" :when cell? :run previous-cell}
  "table/leave" {:label "Leave table" :shortcut "Escape" :when cell? :run leave}
  "table/replace-rectangle" {:label "Replace selected cells" :input-type "insertText" :when across-cells? :run replace-rectangle}
  "table/delete-rectangle-back" {:label "Clear selected cells" :input-type "deleteContentBackward" :when across-cells? :run replace-rectangle}
  "table/delete-rectangle-forward" {:label "Clear selected cells" :input-type "deleteContentForward" :when across-cells? :run replace-rectangle}
  "table/paragraph-rectangle" {:label "Clear selected cells" :input-type "insertParagraph" :when across-cells? :run replace-rectangle}
  "table/line-rectangle" {:label "Clear selected cells" :input-type "insertLineBreak" :when across-cells? :run replace-rectangle}
  "table/replacement-rectangle" {:label "Replace selected cells" :input-type "insertReplacementText" :when across-cells? :run replace-rectangle}
  "table/word-back-rectangle" {:label "Clear selected cells" :input-type "deleteWordBackward" :when across-cells? :run replace-rectangle}
  "table/word-forward-rectangle" {:label "Clear selected cells" :input-type "deleteWordForward" :when across-cells? :run replace-rectangle}
  "table/next-row" {:label "Next row" :input-type "insertParagraph" :when #(and (cell? %) (not (across-cells? %))) :run next-row}
  "table/boundary-back" {:label "Previous cell boundary" :input-type "deleteContentBackward" :when #(boundary? % true) :run boundary-back}
  "table/boundary-forward" {:label "Next cell boundary" :input-type "deleteContentForward" :when #(boundary? % false) :run boundary-forward}})


(defn clipboard-formats [context _]
 (when (cell? context) {:grid true}))
