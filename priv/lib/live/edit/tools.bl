(ns live.edit.tools (:require [clojure.string :as str]))
(defn highlight [args body] [:mark {:data-tone (:tone args)} body])
(defn emphasis [_ body] [:em body])
(defn callout [args body] [:aside {:class (str "edit-callout " (:tone args))} body])
(defn uppercase [text _] (str/upper-case text))
(def package
  {:name "standard"
   :provides {:editor/functions
     {"text/highlight" {:label "Highlight" :kind "wrap" :scope "inline" :render highlight
                        :params {:tone {:type "enum" :values ["amber" "mint" "rose"] :default "amber"}}}
      "text/emphasis" {:label "Emphasis" :kind "wrap" :scope "inline" :render emphasis}
      "text/callout" {:label "Callout" :kind "wrap" :scope "block" :render callout
                      :params {:tone {:type "enum" :values ["note" "warning"] :default "note"}}}
      "text/uppercase" {:label "Uppercase" :kind "transform" :scope "text" :run uppercase}}}})
