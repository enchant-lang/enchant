; Function contracts shared by native authority, commands and browser previews.
(ns live.edit.capabilities (:require [live.edit.registry :as base]))
(def fail base/fail)
(def present base/present)
(defn arguments [spec args]
  (let [values (base/arguments spec args)]
    (doseq [[key param] (:params spec)]
      (when (and (= "url" (:format param))
                 (not (re-find #"^(https?://|mailto:|/|#)" (get values key ""))))
        (fail "invalid-link")))
    (when-let [check (:validate spec)] (when-let [reason (check values)] (fail reason)))
    values))
(defn application [registry id function args scope]
  (let [call (base/application registry id function args scope)]
    (assoc call :args (arguments (get registry function) args))))
