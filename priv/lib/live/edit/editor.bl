; Public native interop entry. A package can replace any host/UI surface.
(ns ^:js live.edit.editor
  (:require [live.edit.session :as session] [live.edit.standard :as standard]))
(defn api-with [packages]
  #js {:create (fn [snapshot] (session/open packages snapshot))})
(defn api [] (api-with [standard/package]))
(defn install-with
  ([host packages] (install-with host packages "enchanted-document"))
  ([host packages kind]
  (let [host (bl->js host) api (api-with packages)]
    (.registerRegion js/Live kind
      (fn [root model services] (.mount host root model services api))))))
(defn install [host] (install-with host [standard/package]))
