(ns formal.point
 (:require [formal.term :as t] [formal.query :as q] [formal.value :as value]
           [formal.evaluate :as evaluate] [formal.identity :as identity]))

;; This is a data-evaluator profile. It neither extends the restricted
;; formal.witness Int/Bool metatheory nor borrows that model's Lean receipts.
(def profile :bl/independent-original-point-v1)
(def evaluator :bl/mathematical-data-replay-v1)
(defn- require! [ok why]
 (when-not ok (throw (ex-info (str "formal.point: " why) {}))))
(defn- assertions [question]
 (vec (concat (:assertions question) (when (:counterexample question) [(:counterexample question)]))))
(defn- assignments [question supplied]
 (let [variables (t/variables (q/roots question)) by-name (into {} (map (fn [v] [(:data v) v]) variables))
       rows (cond
             (map? supplied) (vec supplied)
             (vector? supplied)
              (mapv (fn [row]
                       (require! (and (vector? row) (= 2 (count row))) "each binding needs an original variable and typed value")
                       (let [[variable data] row]
                        (t/validate! [variable])
                        (require! (and (= :var (:op variable)) (= variable (get by-name (:data variable))))
                                  "binding key must be an original free variable") [(:data variable) data])) supplied)
             :else (throw (ex-info "formal.point: explicit name map or term-binding vector required" {})))
       names (mapv first rows)]
  (require! (<= (count variables) 512) "point variable capacity")
  (require! (and (every? string? names) (= (count names) (count (set names)))) "unique string input identities required")
  (require! (= (set names) (set (keys by-name))) "supply exactly every original variable, including displayed inputs")
  (let [values (into {} rows) checking (evaluate/check-bindings (q/roots question) values)]
   (require! (= :valid (:status checking)) "each point coordinate must be concrete and inhabit its declared mathematical sort")
   {:values values :variables (vec (sort-by :data variables))})))
(defn- observations [question values]
 (into {} (mapv (fn [[name descriptor]]
                 [name (if (value/value? descriptor)
                         (value/decode descriptor #(evaluate/observation % values))
                         (evaluate/observation descriptor values))]) (:observe question))))
(defn prepare
 "Construct an original satisfiability point or counterexample from explicit
  typed data, without search, native queries, Source compilation or execution.
  Every original assertion must replay true; unknown mathematics is refused.
  Display observations add no constraints and may remain unavailable."
 [question supplied]
 (try
  (q/validate! question)
  (let [{:keys [values variables]} (assignments question supplied)
        checked (evaluate/validate (assertions question) values)]
   (cond
    (= :invalid (:status checked))
     {:status :rejected :reason :original-assertion-false :validation checked :compiler-proof-authority false}
    (not= :valid (:status checked))
     {:status :unsupported :reason :original-replay-incomplete :validation checked :compiler-proof-authority false}
    :else
     {:status :ready
      :packet (identity/seal
               {:formal/point 1 :profile profile :evaluator evaluator
                :question (identity/hash question) :mode (:mode question)
                :role (if (= :prove (:mode question)) :original-counterexample :original-satisfiability)
                :bindings (mapv (fn [v] [(:data v) (t/sort-of v) (get values (:data v))]) variables)})
      :validation checked :observations (observations question values)
      :assurance :independently-replayed-data :evaluator-soundness :reviewed-not-mechanically-proved
      :kernel-execution :not-run :native-query-calls 0 :compiler-proof-authority false}))
  (catch error {:status :rejected :reason (ex-message error) :kernel-execution :not-run
                :native-query-calls 0 :compiler-proof-authority false})))
(defn check
 "Reconstruct a sealed point against the complete original question. Report
  data checking separately from compiler, runtime and metatheory authority."
 [question packet]
 (try
  (require! (and (map? packet) (= 1 (:formal/point packet))
                 (= profile (:profile packet)) (= evaluator (:evaluator packet))
                 (vector? (:bindings packet)) (identity/valid? packet)) "closed original-point packet required")
  (let [bindings (mapv (fn [row]
                         (require! (and (vector? row) (= 3 (count row))) "typed binding row required")
                         [(t/variable (nth row 0) (nth row 1)) (nth row 2)]) (:bindings packet))
        reconstructed (prepare question bindings)]
   (require! (= :ready (:status reconstructed)) "original point could not be reconstructed")
   (require! (= (identity/bytes packet) (identity/bytes (:packet reconstructed)))
             "point differs from its complete original question or typed bindings")
   {:status :checked-data-connection :profile profile :evaluator evaluator
    :question (:question packet) :packet (:identity packet) :role (:role packet)
    :validation (:validation reconstructed) :observations (:observations reconstructed)
    :assurance :independently-replayed-data :evaluator-soundness :reviewed-not-mechanically-proved
    :kernel-execution :not-run :native-query-calls 0 :compiler-proof-authority false})
  (catch error {:status :rejected :reason (ex-message error) :kernel-execution :not-run
                :native-query-calls 0 :compiler-proof-authority false})))
