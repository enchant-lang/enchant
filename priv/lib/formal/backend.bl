(ns formal.backend (:require [formal.term :as t] [formal.evaluate :as ev]))

(def ^:private wire-atoms
 #{:ok :protocol :generation :backend :name :version :capabilities :operations :sorts :limits :pid
   :status :error :why :kind :message :stats :solve-us :nodes :checks :observations :model-status
   :core :core-kind :sat :unsat :unknown :unsupported :available :partial :unavailable :native
   :unspecified :timeout :incomplete :canceled :invalid :max-bv-width :max-fp-bits
   :real-literal-bits :symbolic-rounding :native-cores :max-text-codepoint :max-nodes})

(defn native-data [data]
 (cond
  (keyword? data) (name data)
  (or (vector? data) (list? data)) (to-list (map native-data data))
  (map? data) (reduce (fn [out [k v]] (Map/put out (if (keyword? k) (name k) k) (native-data v)))
                       (maps/from_list (list)) data)
  :else data))
(defn- read-data [data]
 (cond
  (erlang/is_map data) (reduce (fn [out pair] (assoc out (elem pair 0) (read-data (elem pair 1)))) {} (maps/to_list data))
  (erlang/is_list data) (vec (map read-data data))
  :else data))
(defn decode-frame [bytes]
 (when-not (and (erlang/is_binary bytes) (<= 2 (erlang/byte_size bytes) 1048576)
                (= 131 (binary/at bytes 0)) (not= 80 (binary/at bytes 1)))
  (throw (ex-info "formal reply must be bounded, uncompressed ETF" {:kind :invalid})))
 (read-data (erlang/binary_to_term bytes (list :safe))))
(defn validate-reply [reply backend generation operation]
 (let [ok (:ok reply) status (:status reply)
       check? (contains? #{:check :scope} operation)]
  (when-not (and (map? reply) (or (= true ok) (= false ok)) (= 1 (:protocol reply))
                (= (name backend) (get-in reply [:backend :name]))
                (string? (get-in reply [:backend :version]))
                (= generation (:generation reply))
                (if ok
                 (cond
                  (= operation :hello) (and (map? (:capabilities reply)) (int? (:pid reply)) (pos? (:pid reply)))
                  check? (and (contains? #{:sat :unsat :unknown} status)
                              (contains? #{:available :partial :unavailable} (:model-status reply))
                              (vector? (:observations reply))
                              (every? (fn [row] (and (vector? row) (= 2 (count row))
                                               (string? (first row)) (vector? (second row))
                                               (string? (first (second row))))) (:observations reply))
                              (vector? (:core reply)) (every? string? (:core reply))
                              (contains? #{:native :unsupported} (:core-kind reply))
                              (map? (:stats reply)))
                  :else (contains? #{:load :reset} operation))
                 (and (contains? #{:error :unsupported} status) (string? (:error reply)))))
   (throw (ex-info "formal native reply schema or identity mismatch" {:kind :invalid})))
  reply))
(defn- close! [port]
 (when (and (erlang/is_port port) (some? (Port/info port))) (Port/close port)) :ok)
(defn- exchange! [port borrower-monitor payload timeout]
 (when-not (= (tuple :connected (erlang/self)) (erlang/port_info port :connected))
  (throw (ex-info "formal backend port custody required" {})))
 (let [deadline (+ (erlang/monotonic_time :millisecond) timeout)
       bytes (erlang/term_to_binary payload) monitor (erlang/monitor :port port)]
  (try
   (when (> (erlang/byte_size bytes) 1048576) (throw (ex-info "formal request exceeds packet capacity" {})))
   (when-not (Port/command port bytes (list :nosuspend)) (throw (ex-info "formal backend port busy" {})))
   (receive
    [seen [:data bytes]] :when (= seen port)
     (decode-frame bytes)
    [:DOWN seen :process _ _] :when (= seen borrower-monitor)
     (do (close! port) (erlang/exit (erlang/self) :kill))
    [:DOWN seen :port _ _] :when (= seen monitor) (throw (ex-info "formal native worker exited" {}))
    [seen [:exit_status status]] :when (= seen port) (throw (ex-info "formal native worker exited" {:status status}))
    (after (max 0 (- deadline (erlang/monotonic_time :millisecond)))
     (throw (ex-info "formal backend hard deadline exceeded" {:kind :timeout}))))
   (catch error (close! port) (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))
   (finally (Process/demonitor monitor (list :flush))))))

(defn- owner-context [state]
 {:owner (erlang/self) :generation (:generation state) :revision (:revision state)
  :assertions (:assertions state) :portable (:portable state) :retired (:retired state)})
(defn- refuse [state kind message]
 {:state state :result {:ok false :status :error :error message
                        :why {:kind kind :message message}}})
(defn- exchange-owned [state request]
 (let [result (try
                (let [reply (exchange! (:port state) (:monitor state) request (:hard-ms state))
                      op (elem request 0)
                      generation (if (and (:ok reply) (= op :reset)) (inc (:generation state)) (:generation state))]
                 (validate-reply reply (:backend state) generation op))
               (catch e {:ok false :status :error :error (ex-message e)
                         :why {:kind (get (ex-data e) :kind :invalid) :message (ex-message e)}}))]
  (when-not (:ok result) (close! (:port state)))
  {:result result :state (if (:ok result) (assoc state :generation (:generation result))
                                              (assoc state :retired true))}))
(defn- prepare-owned [state assertions assumptions observations]
 (let [roots (vec (concat (map :term assertions) assumptions (map second observations)))
       exported (t/export (:registry state) roots) ids (:ids (:registry exported))]
  {:registry (:registry exported) :nodes (:nodes exported)
   :assertions (mapv (fn [a] [(str (:label a)) (get ids (:term a))]) assertions)
   :assumptions (mapv (fn [term] (get ids term)) assumptions)
   :observations (mapv (fn [[name term]] [(str name) (get ids term)]) observations)}))
(defn- same-context? [state expected]
 (and (map? expected) (= (erlang/self) (:owner expected))
      (int? (:generation expected)) (= (:generation state) (:generation expected))
      (int? (:revision expected)) (= (:revision state) (:revision expected))))
(defn- managed-exchange [state operation payload]
 (cond
  (and (not= operation :reset) (not (:portable state)))
   (refuse state :context-unavailable "formal native context is not portable after raw transport; reset required")
  (and (= operation :scope) (not (same-context? state (:context payload))))
   (refuse state :context-changed "formal native question context changed before exchange")
  (not (contains? #{:load :scope :reset} operation))
   (refuse state :invalid "unknown formal managed operation")
  :else
   (try
    (let [assertions (vec (:assertions payload))
          prepared (when-not (= operation :reset)
                     (prepare-owned state assertions (:assumptions payload) (:observations payload)))
          request (cond
                    (= operation :reset) (tuple :reset (:generation state))
                    (= operation :load) (tuple :load (:generation state)
                                         (native-data (:nodes prepared)) (native-data (:assertions prepared)))
                    :else (tuple :scope (:generation state) (native-data (:nodes prepared))
                                 (native-data (:assertions prepared)) (native-data (:assumptions prepared))
                                 (native-data (:observations prepared)) (:solver-ms state)))
          exchanged (exchange-owned state request) result (:result exchanged) after (:state exchanged)
          committed (if-not (:ok result) after
                      (cond
                       (= operation :reset)
                        (assoc after :registry (t/registry) :assertions [] :portable true :revision (inc (:revision state)))
                       (= operation :load)
                        (assoc after :registry (:registry prepared)
                                     :assertions (vec (concat (:assertions state) assertions)) :revision (inc (:revision state)))
                       :else (assoc after :registry (:registry prepared))))]
     {:state committed :result (if (:ok result) (assoc result :owned-context (owner-context committed)) result)})
    (catch e
     (close! (:port state))
     (refuse (assoc state :retired true) :invalid (ex-message e))))))
(defn- handle-owned [state request]
 (cond
  (= request :hello) {:state state :result (:hello state)}
  (and (vector? request) (= :context-matches (first request)) (= 2 (count request)))
   ;; A completed refusal can retire a worker without changing its question.
   ;; Matching this token grants no ability to execute in a retired context.
   {:state state :result {:ok true :matches (and (:portable state) (same-context? state (second request)))}}
  (:retired state) (refuse state :retired "formal context retired")
  (= request :context)
   (if (:portable state) {:state state :result {:ok true :context (owner-context state)}}
     (refuse state :context-unavailable "formal native context is not portable after raw transport; reset required"))
  (and (vector? request) (= :managed (first request)) (= 3 (count request)))
   (managed-exchange state (second request) (nth request 2))
  (and (vector? request) (= :invoke (first request)) (= 2 (count request)))
   (let [exchanged (exchange-owned state (second request))]
    ;; Raw ETF cannot attest the original portable assumptions or node registry.
    ;; Even a successful scoped import is outside managed registry accounting.
    (if (and (get-in exchanged [:result :ok]) (not= :hello (elem (second request) 0)))
     (update exchanged :state #(assoc % :portable false :revision (inc (:revision state))))
     exchanged))
  :else (refuse state :invalid "unknown formal owner request")))

(defserver native-owner
 (init [config]
  (let [monitor (Process/monitor (:borrower config))
        port (erlang/open_port (tuple :spawn_executable (:worker config))
              (list :binary :use_stdio :exit_status (tuple :packet 4)
               (tuple :args (to-list (concat ["--backend" (name (:backend config))]
                    (if (= :z3 (:backend config)) ["--z3-library" (:library config)] []))))))
        hello (validate-reply (exchange! port monitor (tuple :hello) (:hard-ms config))
                              (:backend config) 0 :hello)]
   (when-not (and (:ok hello) (= 1 (:protocol hello)))
    (close! port) (throw (ex-info "formal protocol handshake refused" {:reply hello})))
   (ok {:port port :borrower (:borrower config) :monitor monitor :hello hello
        :backend (:backend config) :generation 0 :revision 0 :registry (t/registry) :assertions [] :portable true
        :solver-ms (:solver-ms config) :hard-ms (:hard-ms config) :retired false})))
 (handle-call request [from state]
  (if (not= (:borrower state) (elem from 0))
   (reply {:ok false :status :error :error "formal borrower required"} state)
   (let [handled (handle-owned state request)] (reply (:result handled) (:state handled)))))
 (handle-info [:DOWN ref :process _ _] [state]
  (if (= ref (:monitor state)) (stop :normal state) (noreply state)))
 (handle-info _ [state] (noreply state))
 (terminate [_ state] (close! (:port state))))

(defn- checksum [path] (Base/encode16 (crypto/hash :sha256 (File/read! path)) (list (tuple :case :lower))))
(defn with-session [opts f]
 (let [backend (get opts :backend :z3)
       worker (or (:worker opts) (System/get_env "ENCHANT_FORMAL_WORKER"))
       library (or (:library opts) (System/get_env "ENCHANT_Z3_LIBRARY"))
       solver-ms (get opts :solver-ms 500) hard-ms (get opts :hard-ms 2000)]
  (when-not (and (contains? #{:z3 :oxiz} backend) (string? worker) (File/exists? worker)
                (or (= backend :oxiz) (and (string? library) (File/exists? library)))
                (int? solver-ms) (int? hard-ms) (< 0 solver-ms hard-ms) (<= hard-ms 15000) (<= solver-ms 10000))
   (throw (ex-info "formal backend configuration refused" {:backend backend :worker worker :library library})))
  (let [identity {:backend backend :worker-sha256 (checksum worker)
                  :library-sha256 (when (= backend :z3) (checksum library))
                  :model-completion (if (= backend :z3) :concrete-extension :backend-native)
                  :sdk (System/get_env "BL_SDK_PRODUCT")}
        pid (start native-owner {:backend backend :worker (Path/expand worker) :library library
                                 :borrower (erlang/self) :solver-ms solver-ms :hard-ms hard-ms})
        hello (call pid :hello (+ 1000 hard-ms))
        session {:pid pid :borrower (erlang/self) :solver-ms solver-ms :hard-ms hard-ms :identity identity :hello hello
                 :state (atom {:generation (:generation hello) :revision 0 :assertions [] :portable true :retired false})}]
   (try (f session)
    (finally
     (try (swap! (:state session) #(assoc (if (map? %) % {}) :retired true))
      (finally (when (Process/alive? pid) (GenServer/stop pid :normal 1000)))))))))

(defn- owner-call [session request]
 (call (:pid session) request (+ 1000 (:hard-ms session))))
(defn invoke
 "Raw native compatibility transport. Successful exchanges other than hello
  invalidate portable context accounting until a managed reset."
 [session request] (owner-call session [:invoke request]))
(defn hello [session] (:hello session))
(defn context
 "Read the authoritative live portable context from its borrower-owned process.
  The owner PID is an execution token, not portable query data or a certificate."
 [session]
 (when-not (and (= (:borrower session) (erlang/self)) (Process/alive? (:pid session)))
  (throw (ex-info "formal backend: a live owned question context is required" {})))
 (let [reply (owner-call session :context)]
  (if (:ok reply) (:context reply) (throw (ex-info (:error reply) (:why reply))))))
(defn context-matches?
 "Check the captured owner's question identity after an exchange, including a
  native refusal that retired the worker. This is not a liveness check."
 [session expected]
 (let [reply (owner-call session [:context-matches expected])]
  (and (:ok reply) (= true (:matches reply)))))
(defn- managed-call [session operation payload]
 (let [reply (owner-call session [:managed operation payload])]
  (when (:ok reply)
   ;; A diagnostic mirror only. No native operation reads this atom.
   (swap! (:state session) (fn [_] (dissoc (:owned-context reply) :owner))))
  (dissoc reply :owned-context)))
(defn reset! [session] (managed-call session :reset {}))
(defn load! [session assertions] (managed-call session :load {:assertions (vec assertions)}))

(defn decode-native [wire]
 (if-not (and (vector? wire) (seq wire)) (ev/unavailable :malformed-observation)
  (let [kind (first wire)]
   (cond
    (contains? #{"bool" "int" "text"} kind) (second wire)
    (= kind "real") (ev/real (second wire) (nth wire 2))
    (= kind "bv") {:formal/bv [(second wire) (nth wire 2)]}
    (= kind "fp") {:formal/fp [(second wire) (nth wire 2) (nth wire 3)]}
    (= kind "enum") {:formal/enum [(second wire) (nth wire 2)]}
    (= kind "constructor") {:formal/constructor [(second wire) (mapv decode-native (nth wire 2))]}
    (= kind "array") {:formal/array {:default (decode-native (second wire))
                          :updates (mapv (fn [[k v]] [(decode-native k) (decode-native v)]) (nth wire 2))}}
    :else (ev/unavailable {:kind kind :reason (second wire)})))))

(defn scope!
 "An owner-checked native scope. The optional captured context is checked in
  the same owner turn as the exchange. Portable node IDs remain owner-local."
 ([session assertions assumptions observations]
  (scope! session assertions assumptions observations (context session)))
 ([session assertions assumptions observations expected]
  (let [started (erlang/monotonic_time :microsecond)
        reply (managed-call session :scope {:context expected :assertions (vec assertions)
                                            :assumptions (vec assumptions) :observations (vec observations)})]
   (assoc reply :identity (:identity session) :trusted false
                :values (into {} (map (fn [[name v]] [name (decode-native v)]) (:observations reply)))
                :wall-us (- (erlang/monotonic_time :microsecond) started)))))
