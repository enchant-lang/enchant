(ns formal.proof-strategy
 (:require [formal.finite-word-certificate :as finite]
           [formal.graph-integer-certificate :as integer]))

;; Closed installed choices. No certificate can select a module or callable.
(def profile :bl/installed-proof-strategies-preview-v1)
(defn strategy [candidate]
 (case (:profile candidate)
  :bl/finite-word-exhaustion-preview-v1
   {:kind :finite-word-exhaustion :required 3300000}
  :bl/graph-linear-integer-certificate-preview-v1
   {:kind :graph-linear-integer :required 2000000}
  nil))
(defn reserve [candidate limit]
 (if-let [selected (strategy candidate)]
  (assoc selected :status (if (<= (:required selected) limit) :reserved :refused)
                  :limit limit :reserved (if (<= (:required selected) limit) (:required selected) 0))
  {:status :refused :kind :uninstalled-proof-strategy :limit limit :reserved 0}))
(defn check [original candidate account]
 ;; This is an internal composition helper, not an authority-taking checker:
 ;; each installed kernel independently validates the entire original subject.
 (case (:kind account)
  :finite-word-exhaustion (finite/check original candidate)
  :graph-linear-integer (integer/check original candidate)
  {:status :rejected :verdict :not-established :reason :uninstalled-proof-strategy}))
