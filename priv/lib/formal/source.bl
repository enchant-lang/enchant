(ns formal.source
 (:require [compiler :as compiler] [system.ir :as ir]
           [formal.term :as t] [formal.value :as v] [formal.data :as d]
           [formal.numeric :as n] [formal.query :as q] [formal.intrinsics :as intrinsics] [formal.anf-inputs :as anf-inputs] [formal.anf-function :as anf-function] [formal.runtime-values :as runtime-values]))

;; Consume the compiler's resolved ANF, never a second surface-language walker.
;; This initial source environment allows the declared variables and a reviewed
;; intrinsic vocabulary. Arbitrary user functions/effects are refused, not UFs.
(defn- refuse [reason node]
 (throw (ex-info (str "formal source unsupported: " reason)
                {:operation (:op node) :origin (:ann node) :reason reason})))
(defn- result [term operands] (v/scalar term operands {}))
(defn truthy [value]
 (let [domain (:domain (v/lift value))]
  (cond
   (= :nullable (:kind domain))
    (let [payload (:value value) item (:item payload)]
     (result (if (= t/Bool (t/sort-of item))
               (t/all [(t/not (:nil? payload)) item]) (t/not (:nil? payload))) [value]))
   (and (t/term? (if (v/value? value) (:value value) value))
        (= t/Bool (t/sort-of (v/term value)))) (v/lift value)
   :else (v/scalar (t/bool true) [value] {:domain {:kind :scalar :profile :bl/truthiness-v1}}))))

(defn- integer-binary [operator a b node]
 (when-not (and (= :scalar (get-in (v/lift a) [:domain :kind]))
                (= :scalar (get-in (v/lift b) [:domain :kind]))
                (= t/Int (t/sort-of (v/term a))) (= t/Int (t/sort-of (v/term b))))
  (refuse "initial runtime arithmetic profile requires Int operands" node))
 (result (operator (v/term a) (v/term b)) [a b]))

(defn- intrinsic [name args node]
 (let [a (first args) b (second args) size (count args)]
  (cond
   (and (= name "neg") (= size 1)) (integer-binary t/sub (t/int 0) a node)
   (contains? #{"+" "-" "*" "<" "<=" "=<" ">" ">="} name)
    (if (= size 2)
     (integer-binary (get {"+" t/add "-" t/sub "*" t/mul "<" t/lt "<=" t/le "=<" t/le ">" t/gt ">=" t/ge} name) a b node)
     (if (and (= name "-") (= size 1)) (integer-binary t/sub (t/int 0) a node) (refuse "arithmetic arity" node)))
   (and (contains? #{"=" "eqv" "==" "=:="} name) (= size 2)) (runtime-values/equal a b)
   (and (= name "not") (= size 1)) (result (t/not (v/term (truthy a))) [a])
   (and (= name "strict-not") (= size 1))
    (do (when-not (and (= :scalar (get-in (v/lift a) [:domain :kind])) (= t/Bool (t/sort-of (v/term a))))
          (refuse "erlang/not requires Bool, not BL truthiness or nullable Bool" node))
        (result (t/not (v/term a)) [a]))
   (and (= name "quot") (= size 2)) (n/quotient a b)
   (and (= name "rem") (= size 2)) (n/remainder a b)
   (and (= name "mod") (= size 2)) (n/modulus a b)
   (and (contains? #{"pos?" "neg?" "zero?"} name) (= size 1))
    (result ((get {"pos?" t/gt "neg?" t/lt "zero?" t/eq} name) (v/term a) (t/int 0)) [a])
   (and (contains? #{"inc" "dec"} name) (= size 1))
    (result ((if (= name "inc") t/add t/sub) (v/term a) (t/int 1)) [a])
   (and (contains? #{"nil?" "some?" "int?" "keyword?" "string?" "boolean?" "vector?" "map?"} name) (= size 1))
    (let [value (runtime-values/type-test (get {"nil?" :nil "some?" :nil "int?" :int "keyword?" :keyword
                                              "string?" :string "boolean?" :bool "vector?" :vector "map?" :map} name) a)]
     (if (= "some?" name) (result (t/not (v/term value)) [value]) value))
   (and (= "count" name) (= size 1)) (runtime-values/count-value a)
   (and (= "empty?" name) (= size 1)) (result (t/eq (v/term (runtime-values/count-value a)) (t/int 0)) [a])
   (and (= "nth" name) (= size 2)) (runtime-values/nth-value a b nil)
   (and (= "nth-default" name) (= size 3)) (runtime-values/nth-value a b (nth args 2))
   (and (= "get" name) (= size 2)) (runtime-values/lookup-value a b nil)
   (and (= "get-default" name) (= size 3)) (runtime-values/lookup-value a b (nth args 2))
   (and (= "rest" name) (= size 1)) (runtime-values/rest-value a)
   (and (= "pop" name) (= size 1)) (runtime-values/pop-value a)
   (and (= "conj" name) (= size 2)) (runtime-values/conj-value a b)
   (and (= "text-starts-with" name) (= size 2))
    (result (t/app :str-prefix t/Bool [(v/term b) (v/term a)] nil) [a b])
   (and (= "text-codepoints" name) (= size 1))
    (runtime-values/length-value (t/app :str-len t/Int [(v/term a)] nil) :list [a])
   :else (refuse (str "intrinsic " name " is outside this source profile") node))))

(declare lower)
(defn- branch-values [yes no]
 (cond
  (and (= :nullable (get-in yes [:domain :kind])) (= :scalar (get-in no [:domain :kind]))) [yes (d/non-nil no)]
  (and (= :nullable (get-in no [:domain :kind])) (= :scalar (get-in yes [:domain :kind]))) [(d/non-nil yes) no]
  :else [yes no]))

(defn lower [node bindings opts]
 (let [op (:op node)]
  (cond
   (= op :lit)
    (let [value (:val node)]
     (cond (nil? value) (d/nil-of (get opts :nil-sort t/Int))
           (or (= true value) (= false value)) (v/lift (t/bool value))
           (int? value) (v/lift (t/int value))
           (string? value) (v/lift (t/text value))
           (and (keyword? value) (:keyword-universe opts)) (d/key-literal (:keyword-universe opts) value)
           (keyword? value) (runtime-values/keyword-value value)
           :else (refuse "literal needs a declared semantic domain" node)))
   (= :var op)
    (or (get bindings (:name node)) (refuse "unbound lexical input identity" node))
   (contains? #{:global :binding} op) (refuse "global values require actual selected Source resolution" node)
   (= op :let)
    (let [initial (lower (:init node) bindings opts)
          body (lower (:body node) (assoc bindings (:name node) initial) opts)]
     (v/make (:value body) (merge (v/context [initial body]) {:domain (:domain body) :errors (:errors body)})))
   (= op :if)
    (let [_ (when (nil? (:test node)) (refuse "ANF if condition shape" node))
          condition (truthy (lower (:test node) bindings opts))
          yes (lower (:then node) bindings opts) no (lower (:else node) bindings opts)
          [yes no] (branch-values yes no)]
     (v/choose condition yes no))
   (= op :do)
    (let [values (mapv (fn [child] (lower child bindings opts)) (:stmts node)) last-value (last values)]
     (when (empty? values) (refuse "empty do" node))
     (v/make (:value last-value) (merge (v/context values) {:domain (:domain last-value)})))
   (= op :arith)
    (let [meaning (intrinsics/arith-meaning node)]
     (when-not meaning (refuse "unreviewed canonical arithmetic identity" node))
     (intrinsic meaning (mapv #(lower % bindings opts) (:args node)) node))
   :else
    (let [call (ir/call-site node)]
     (when (or (nil? call) (:rest call)) (refuse "unresolved/computed call" node))
     (let [args (mapv #(lower % bindings opts) (:args call))]
      (cond
       (and (= :invoke (:mode call)) (= :lit (:op (:callee call))) (keyword? (:val (:callee call))) (contains? #{1 2} (:arity call)))
        (runtime-values/lookup-value (first args) (runtime-values/keyword-value (:val (:callee call))) (second args))
       (= :remote (:mode call))
        (let [meaning (intrinsics/remote-meaning (:mod call) (:fun call) (:arity call))]
         (when-not meaning (refuse "unreviewed module/function/arity identity" node))
         (intrinsic meaning args node))
       (and (= :invoke (:mode call)) (= :global (:op (:callee call))))
        (refuse "unresolved global calls require checked resolution and summaries" node)
       :else (refuse "first-class/user calls need explicit checked summaries" node)))))))

(defn prepare
 "Translate one expression in a declared intrinsic environment through real
  compiler ANF. Quoted forms use the bounded compiler datum conversion directly;
  strings use the Reader. Neither path certifies arbitrary functions or effects."
 ([source bindings] (prepare source bindings {}))
 ([source bindings opts]
  (try
   (let [forms (if (string? source) (BeamLisp.Reader/read_string source) (list (compiler/datum-macro-result source)))
         _ (when-not (= 1 (count forms)) (refuse "exactly one source expression is required" {}))
         form (first forms)
         named (mapv (fn [[name value]] [(if (string? name) name (str name)) (v/lift value)]) bindings)
         _ (when-not (= (count named) (count (set (map first named))))
             (refuse "multiple binding keys normalize to the same source name" {}))
         bindings (into {} named)
         _ (when-not (every? runtime-values/admissible? (vals bindings))
             (refuse "binding requires a reviewed runtime value profile" {}))
         inputs (anf-inputs/prepare "formal.source.intrinsics" bindings)
         anf (compiler/compile form (:environment inputs))
         value (lower anf (:bindings inputs) opts)]
    {:status :translated :value value :profile :bl/int-bool-intrinsics-v1
     :basis :compiler-anf :intrinsic-profile intrinsics/profile :source source :anf anf :scope (v/scope value)})
   (catch error {:status :unsupported :reason (ex-message error) :source source
                 :basis :compiler-anf :profile :bl/int-bool-intrinsics-v1}))))

(defn equivalence-problem [left right bindings opts]
 (let [a (prepare left bindings opts) b (prepare right bindings opts)]
  (if (and (= :translated (:status a)) (= :translated (:status b)))
   {:status :translated :problem (q/equivalent (:value a) (:value b)
       (merge opts {:profile :bl/int-bool-intrinsics-v1
                    :origin {:left left :right right :basis :compiler-anf}}))}
   {:status :unsupported :left a :right b})))

(defn prepare-function
 "Translate one anonymous BL function, as a quoted form or source text, through
  real compiler ANF. Forms never cross a printer/Reader round trip. Ordered
  semantic inputs bind its compiler parameters positionally. Execution is
  separate; this reviewed translation grants no compiler proof authority."
 ([source inputs] (prepare-function source inputs {}))
 ([source inputs opts]
  (try
   (let [forms (if (string? source) (BeamLisp.Reader/read_string source) (list (compiler/datum-macro-result source)))
         _ (when-not (and (= 1 (count forms)) (vector? inputs) (<= (count inputs) 32))
             (refuse "one function and at most 32 ordered semantic inputs required" {}))
         inputs (mapv v/lift inputs)
         _ (when-not (every? runtime-values/admissible? inputs)
             (refuse "function inputs require a reviewed runtime value profile" {}))
         anf (compiler/compile (first forms) (compiler/new-env "formal.source.intrinsics"))
         clause (anf-function/clause! anf (count inputs))
         bindings (into {} (map-indexed (fn [i pattern] [(:name pattern) (nth inputs i)]) (:pats clause)))
         value (lower (:body clause) bindings opts)]
    {:status :translated :value value :inputs inputs :source source :anf anf
     :basis :compiler-anf :profile :bl/int-bool-intrinsics-v1 :intrinsic-profile intrinsics/profile
     :scope (v/scope value) :assurance :reviewed-anf-to-terms :compiler-proof-authority false})
   (catch error {:status :unsupported :source source :reason (ex-message error)
                 :basis :compiler-anf :profile :bl/int-bool-intrinsics-v1}))))
