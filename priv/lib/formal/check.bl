(ns formal.check
 (:require [formal.query :as q] [formal.logic :as logic] [formal.proof :as proof] [formal.result :as result] [formal.question-graph :as question-graph]))

(defn raw-query
 "Execute one term question using the portable checker or an explicit backend."
 [options question]
 (if (= :query-graph (result/kind question))
  (do (question-graph/open! question)
   (if (:backend options) (logic/run-graph options question)
    {:status :unsupported :reason :graph-proof-search-not-admitted :question-graph question
     :compiler-proof-authority false}))
  (do (q/validate! question)
 (if (:backend options)
  (logic/run options question)
  (if (= :prove (:mode question))
   (proof/produce question (get options :search {}))
   {:status :unsupported :reason :sat-search-needs-an-explicit-backend})))))

(defn query
 "Check a portable question and retain the shared evidence envelope."
 ([question] (query {} question))
 ([options question]
  (let [raw (raw-query options question) execution (if (:backend options) :native :portable)]
   (if (= :query-graph (result/kind question))
    (result/attach-graph question raw execution) (result/attach question raw execution)))))
