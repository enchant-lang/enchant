(ns formal.anf-function (:require [system.ir :as ir]))

(defn clause!
 "Validate the compiler's function scaffold before interpreting its body.
  Function parameters are positional; compiled lexical names stay distinct
  from the names used for roles in a formal question."
 [anf arity]
 (when-not (and (int? arity) (<= 0 arity 32) (ir/self-scaffold? anf))
  (throw (ex-info "One compiler function scaffold with at most 32 parameters required" {})))
 (let [clauses (:clauses (ir/scaffold-inner anf)) clause (first clauses) patterns (:pats clause)]
  (when-not (and (= 1 (count clauses)) (nil? (:guard clause)) (= arity (count patterns))
                 (every? #(= :pvar (:pop %)) patterns)
                 (= arity (count (set (map :name patterns)))))
   (throw (ex-info "One unguarded clause with distinct variable parameters required" {})))
  clause))
