(ns formal.answer
 (:require [formal.term :as t] [formal.value :as v] [formal.query :as q] [formal.identity :as identity]
           [formal.evaluate :as replay] [formal.data-graph :as graph] [formal.question-graph :as question-graph]))

;; A pure boundary. Execution custody belongs to logic/oracle; this layer
;; checks data and never grants proof authority to an engine or handler.
(def ^:private question-fields [:id :mode :profile :profiles :scope :context])
(def ^:private payload-fields
 [:phase :solver-status :why :error :identity :backend :stats :wall-us :model-status
  :core :assignments :witness :witness-provenance :preflight :nodes-imported :cache-key])
(defn- same-data? [left right]
 ;; Formal data identity preserves numeric/data kinds and float bit patterns.
 ;; The existing canonical data-format capacity applies to reply binding.
 (= (identity/bytes left) (identity/bytes right)))

(defn- phase! [question response]
 (let [status (:solver-status response) phase (get response :phase :query)]
  (when-not
   (and (contains? #{:sat :unsat :unknown :unsupported :error :not-run} status)
        (case phase
         :query (not= :not-run status)
         :frontend (contains? #{:not-run :error :unsupported} status)
         :assumption-consistency (and (= :prove (:mode question)) (not= :allow (:vacuity question))
                                      (contains? #{:unsat :unknown :unsupported :error} status))
         false))
   (throw (ex-info "formal.answer: phase/status does not answer the complete question" {})))
  phase))

(defn- nonmodel-verdict [question phase status]
 (cond (= :unsat status) (if (= :assumption-consistency phase) :vacuous
                           (if (= :prove (:mode question)) :proved :unsat))
       (= :sat status) :candidate
       (= :not-run status) :error :else status))

(defn bind
 "Construct a complete-question-bound, unchecked handler reply. Semantic
  verdict and model evidence are reconstructed by check."
 [question response]
 (q/validate! question)
 (when-not (map? response) (throw (ex-info "formal.answer: a response map is required" {})))
 (let [phase (phase! question response)]
  (merge (select-keys response payload-fields) (select-keys question question-fields)
   {:formal/query-reply 1 :question question :phase phase :trusted false
    :assumptions (:assumptions question) :origin (:origin question)
    :verdict (nonmodel-verdict question phase (:solver-status response))
    :certificate {:status :not-checked :kind :effect-handler-answer}
    :compiler-proof-authority false})))

(defn- decoded [question assignments]
 (let [watched (vec (distinct (mapcat (fn [[_ descriptor]] (v/terms descriptor)) (:observe question))))
       values (into {} (mapv (fn [term] [term (replay/observation term assignments)]) watched))
       resolve (fn [term] (if (contains? values term) (get values term) (replay/observation term assignments)))]
  {:witness (into {} (mapv (fn [[name descriptor]]
                         [name (if (v/value? descriptor) (v/decode descriptor resolve) (resolve descriptor))])
                           (:observe question)))
   :witness-provenance
    (into {} (mapv (fn [[name descriptor]]
                    [name {:terms (mapv (fn [term]
                                 (let [value (get values term)]
                                  {:term (t/digest [term])
                                   :source (if (replay/unavailable? value) :unavailable :independent-replay)
                                   :reason (when (replay/unavailable? value) (:formal/unavailable value))}))
                               (v/terms descriptor))}]) (:observe question)))}))

(defn check
 "Check a full reply, replay assignments and reconstruct observations. The
  optional execution record is supplied by the effect owner from its actual
  fallback. Only an exactly matching response retains that execution's native
  observation provenance; all answers remain unchecked claims."
 ([question response] (check question response nil))
 ([question response executed]
  (q/validate! question)
  (when-not (and (map? response) (int? (:formal/query-reply response)) (= 1 (:formal/query-reply response))
                 (same-data? question (:question response))
                 (same-data? (select-keys question question-fields) (select-keys response question-fields)))
   (throw (ex-info "formal.answer: handler response differs from its complete typed question" {})))
  (let [answer (bind question response)
        matched? (boolean (and executed
                     (same-data? (select-keys answer payload-fields)
                                 (select-keys (bind question executed) payload-fields))))]
   (if (= :sat (:solver-status answer))
    (let [assignments (get answer :assignments {})
          context (vec (concat (:assertions question) (when (:counterexample question) [(:counterexample question)])))
          validation (replay/validate context assignments)
          assignments (if (map? assignments) assignments {})
          observations (if matched? (select-keys executed [:witness :witness-provenance]) (decoded question assignments))
          verdict (cond (= :invalid (:status validation)) :invalid-model
                        (not= :valid (:status validation)) :candidate
                        (= :prove (:mode question)) :refuted :else :sat)]
     (merge answer observations
      {:assignments assignments :validation validation :verdict verdict
       :observation-basis (if matched? :owned-native-fallback :independent-replay)
       :reported-witness (when (contains? response :witness) (:witness response))
       :delegation (if matched? :matched :not-matched)}))
    (assoc (dissoc answer :assignments :witness :witness-provenance)
      :validation {:status :not-applicable} :delegation (if matched? :matched :not-matched))))))

;; Version 2 is opt-in. It carries the complete question graph exactly once;
;; ordinary header metadata remains inside that graph, not in a lossy echo.
(def graph-profile :bl/graph-query-reply-v1)
(def ^:private graph-certificate {:status :not-checked :kind :graph-bound-answer})
(def ^:private graph-fields
 (set (concat payload-fields [:formal/query-reply :reply-profile :question-graph :question-reference :mode
        :trusted :certificate :compiler-proof-authority :verdict :validation :delegation
        :reported-witness :observation-basis :oracle-effect :execution :reported-execution :evidence :subject-kind])))
(defn- graph-require! [ok why]
 (when-not ok (throw (ex-info (str "formal.answer: " why) {:kind :graph-query-reply}))))
(defn- graph-same-data? [a b] (= (graph/bytes (graph/encode a)) (graph/bytes (graph/encode b))))
(defn- graph-header! [opened response]
 (graph-require! (and (= :map (rt/kind-kind response))
                      (int? (:formal/query-reply response)) (= 2 (:formal/query-reply response))
                      (= graph-profile (:reply-profile response))
                      (every? #(contains? graph-fields %) (keys response))
                      (= false (:trusted response)) (= false (:compiler-proof-authority response))
                      (= (identity/bytes graph-certificate) (identity/bytes (:certificate response)))
                      (= (:mode (:view opened)) (:mode response))
                      (= (identity/bytes (:reference opened)) (identity/bytes (:question-reference response))))
                 "closed graph-bound reply header required")
 (phase! (:view opened) response)
 response)
(defn assert-bound-graph!
 "Check declared graph format and exact complete-question binding only. This
  does not validate a model, authenticate execution, or grant proof authority."
 [context response]
 (let [opened (question-graph/open! context)]
  (graph-header! opened response)
  (graph-require! (= (:canonical-bytes opened) (question-graph/bytes (:question-graph response)))
                  "reply differs from its complete original graph question") response))
(defn bind-graph
 "Construct an unchecked version-2 reply bound to every original public field.
  Payload data has its own graph capacities. Semantic results are reconstructed
  by check-graph, not trusted from caller verdict or certificate labels."
 [context response]
 (graph-require! (map? response) "response map required")
 (let [opened (question-graph/open! context) question (:view opened)
       phase (phase! question response) payload (select-keys response payload-fields)
       _ (graph/encode payload)]
  (merge payload
   {:formal/query-reply 2 :reply-profile graph-profile :question-graph context
    :question-reference (:reference opened) :mode (:mode question) :phase phase
    :trusted false :compiler-proof-authority false :certificate graph-certificate
    :verdict (nonmodel-verdict question phase (:solver-status response))})))
(defn check-graph
 "Recheck an explicit graph reply against the complete original question.
  Only an exactly matching privately supplied actual execution retains native
  observation provenance. No graph or solver claim becomes a proof."
 ([context response] (check-graph context response nil))
 ([context response executed]
  (assert-bound-graph! context response)
  (let [question (:view (question-graph/open! context)) answer (cond-> (bind-graph context response)
                 (contains? response :execution) (assoc :reported-execution (:execution response)))
        matched? (boolean (and executed
                      (graph-same-data? (select-keys answer payload-fields)
                                        (select-keys (bind-graph context executed) payload-fields))))]
   (if (= :sat (:solver-status answer))
    (let [assignments (get answer :assignments {})
          assertions (vec (concat (:assertions question) (when (:counterexample question) [(:counterexample question)])))
          validation (replay/validate assertions assignments)
          assignments (if (map? assignments) assignments {})
          observations (if matched? (select-keys executed [:witness :witness-provenance]) (decoded question assignments))
          verdict (cond (= :invalid (:status validation)) :invalid-model
                        (not= :valid (:status validation)) :candidate
                        (= :prove (:mode question)) :refuted :else :sat)]
     (merge answer observations
      {:assignments assignments :validation validation :verdict verdict
       :observation-basis (if matched? :owned-native-fallback :independent-replay)
       :reported-witness (when (contains? response :witness) (:witness response))
       :delegation (if matched? :matched :not-matched)}))
    (assoc (dissoc answer :assignments :witness :witness-provenance)
     :validation {:status :not-applicable} :delegation (if matched? :matched :not-matched))))))
(defn assert-graph-body!
 "Validate a stored reply body before attaching its external question graph.
  Only binding/status headers are decoded; unrelated reported data stays in
  its canonical graph until explicitly materialized. No model is replayed."
 [context body]
 (graph/check! body)
 (let [rows (:nodes body) [kind entries] (nth rows (:root body))
       names (set (map #(erlang/atom_to_binary % :utf8) (disj graph-fields :question-graph)))
       _ (graph-require! (and (= "map" kind)
                         (every? (fn [[key _]] (let [[tag name] (nth rows key)]
                                                (and (= "keyword" tag) (contains? names name)))) entries))
                        "stored graph reply body fields required")
       selected (graph/keyword-nodes body [:formal/query-reply :reply-profile :question-reference :mode
                                           :trusted :certificate :compiler-proof-authority :phase :solver-status])
       ids (vec (vals selected)) decoded (graph/decode-nodes! body ids)
       by-id (into {} (mapv (fn [i] [(nth ids i) (nth decoded i)]) (range (count ids))))
       headers (into {} (mapv (fn [[key id]] [key (get by-id id)]) selected))]
  (graph-header! (question-graph/open! context) (assoc headers :question-graph context)) body))
(defn restore-graph-body!
 "Attach a separately stored authoritative question after exact reference
  checks. Retained execution/proof labels remain recorded data; use check-graph
  for independent model replay without trusting those labels."
 [context body]
 (assert-graph-body! context body)
 (let [response (assoc (graph/decode! body) :question-graph context)]
  (assert-bound-graph! context response)))
