(ns formal.intrinsics)

;; Exact reviewed identities, not a Cartesian product of module and function
;; names. Num.div/2 is modeled only through reviewed Float operands, never quot.
(def profile :bl/exact-intrinsic-identities-v1)
(def ^:private erlang-meanings
 {[:+ 2] "+" [:- 2] "-" [:- 1] "neg" [:* 2] "*"
  [:< 2] "<" [:"=<" 2] "=<" [:> 2] ">" [:>= 2] ">="
  [:== 2] "==" [:"=:=" 2] "=:=" [:div 2] "quot" [:rem 2] "rem"
  [:not 1] "strict-not" [:is_integer 1] "int?" [:is_float 1] "float?"
  [:"/" 2] "float-divide" [:is_binary 1] "string?" [:is_boolean 1] "boolean?"})
(def ^:private num-meanings
 {[:add 2] "+" [:sub 2] "-" [:mul 2] "*" [:neg 1] "neg" [:div 2] "float-divide"
  [:lt 2] "<" [:le 2] "=<" [:gt 2] ">" [:ge 2] ">=" [:num_eq 2] "=="
  [:pos? 1] "pos?" [:neg? 1] "neg?" [:zero? 1] "zero?"})
(def ^:private rt-meanings
 {[:count 1] "count" [:nth 2] "nth" [:nth 3] "nth-default" [:get 2] "get" [:get 3] "get-default"
  [:empty? 1] "empty?" [:rest 1] "rest" [:conj 2] "conj"
  [:int? 1] "int?" [:float? 1] "float?" [:keyword? 1] "keyword?" [:string? 1] "string?" [:vector? 1] "vector?" [:map? 1] "map?"
  [:eqv 2] "eqv" [:not_ 1] "not" [:pos? 1] "pos?" [:neg? 1] "neg?" [:zero? 1] "zero?"})
(def ^:private core-meanings
 {[:nil? 1] "nil?" [:some? 1] "some?" [:boolean? 1] "boolean?" [:pop 1] "pop"
  [:inc 1] "inc" [:dec 1] "dec" [:quot 2] "quot" [:mod 2] "mod"})
(def ^:private arith-pairs
 {:add :+ :sub :- :mul :* :div :"/" :lt :< :le :"=<" :gt :> :ge :>= :num_eq :==})
(defn remote-meaning [module function arity]
 (get (case module
        :erlang erlang-meanings :Elixir.BeamLisp.Num num-meanings
        :Elixir.BeamLisp.Ns.Rt rt-meanings :Elixir.BeamLisp.Ns.Core core-meanings
        :Elixir.String {[:starts_with? 2] "text-starts-with" [:codepoints 1] "text-codepoints"} {})
      [function arity]))
(defn arith-meaning [node]
 (when (and (= :arith (:op node)) (= 2 (count (:args node)))
            (contains? arith-pairs (:fun node)) (= (get arith-pairs (:fun node)) (:bif node)))
  (remote-meaning :erlang (:bif node) 2)))
