;; The authenticated, allowlisted namespace entry. Local and remote callers
;; enter this exact dispatcher; neither receives the provider's implementation.
(ns auth.interface
 (:require [auth] [auth.logic :as logic] [auth.identity :as identity] [auth.resource] [auth.contract :as contract]
           [auth.wire :as wire] [effect] [env]))

(def PROTOCOL "enchant.namespaces")
(def VERSION 2)
(def ERROR-CODES
 {:auth/unauthenticated "auth/unauthenticated" :auth/denied "auth/denied"
  :auth/unavailable-export "auth/unavailable-export" :auth/stale-code "auth/stale-code"
  :auth/contract-mismatch "auth/contract-mismatch" :auth/wrong-world "auth/wrong-world"
  :auth/unproved "auth/unproved" :auth/effect-denied "auth/effect-denied"
  :auth/effect-unavailable "auth/effect-unavailable" :auth/malformed "auth/malformed"})
(defn- require! [condition kind]
 (when-not condition (throw (ex-info "Namespace invocation refused" {:kind kind}))))
(defn- code-ids [callable]
 (into {} (map (fn [module] [module (erlang/apply module :module_info (list :md5))])
               (BeamLisp.Env/callback_modules callable))))
(defn manifest [prepared] (contract/from-prepared prepared))
(defn- guard-scope [owner closed creator]
 (spawn
  (fn []
   (let [monitor (erlang/monitor :process creator)]
    (receive
     [:auth/close from ticket]
     (do (reset! closed true) (env/destroy owner)
         (erlang/demonitor monitor (list :flush)) (erlang/send from [:auth/closed ticket]))
     [:DOWN seen :process _ _] :when (= seen monitor)
     (do (reset! closed true) (env/destroy owner)))))))
(defn open
 "Host loader. Source is checked before evaluation and retained in its own Env.
  roles/readers/effects/resolvers are trusted provider ports, not wire callbacks.
  Unsupported source is never published. No supplied proof receipt is accepted."
 [{:keys [source file world roles readers effects resolvers]
   :or {roles (fn [_ _] #{}) readers {} effects {} resolvers {}}}]
 (let [source (or source (File/read! file)) prepared (logic/prepare source)
       _ (require! (= :checked (:status prepared)) :auth/unproved)
       law (logic/policy-evidence)
       _ (require! (= :exhausted (:modality law)) :auth/unproved)
       _ (BeamLisp.Loader/ensure_loaded "auth.resource")
       owner (env/fork) closed (atom false) creator (erlang/self)]
  (try
   (let [bindings
         (env/with-env owner
          (fn []
           (BeamLisp.Env/put_key (tuple :realm_key) (subs (logic/digest [(:namespace prepared) (:source-id prepared)]) 0 12))
           (BeamLisp.Env/put_key (tuple :realm_decl) {:shadow [] :uses {} :overrides ""})
           (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env "user") (or file "auth-namespace"))
           (into {} (map (fn [[name _]]
                           (let [f (BeamLisp.Env/fetch! (:namespace prepared) name)]
                            [name {:function f :code (code-ids f)}])) (:exports prepared)))))
         _ (when file (require! (= source (File/read! file)) :auth/stale-code))]
    {:world world :owner owner :prepared prepared :manifest (manifest prepared) :bindings bindings
     :closed closed :guardian (guard-scope owner closed creator)
     :file file :source source :roles roles :readers readers :effects effects :resolvers resolvers :policy-evidence law})
   (catch error (env/destroy owner) (throw error)))))
(defn close! [provider]
 (reset! (:closed provider) true)
 (let [guardian (:guardian provider) monitor (erlang/monitor :process guardian)]
  (erlang/send guardian [:auth/close (erlang/self) monitor])
  (receive
   [:auth/closed seen] :when (= seen monitor) (erlang/demonitor monitor (list :flush))
   [:DOWN seen :process _ _] :when (= seen monitor) (env/destroy (:owner provider))
   (after 5000
    (do (erlang/demonitor monitor (list :flush)) (env/destroy (:owner provider)))))
 :ok)
(defn- resource-for [provider spec args]
 (let [arg (:arg spec) lookup (:lookup spec) value (when (and (int? arg) (<= 0 arg) (< arg (count args))) (nth args arg))]
  (if lookup
   (when-let [resolve (get (:resolvers provider) lookup)] (resolve value))
   value)))
(defn- source-current? [provider binding]
 (and (not @(:closed provider))
      (= (get-in provider [:prepared :compiler-id]) (BeamLisp.AOTCache/compiler_key))
      (or (nil? (:file provider)) (= (:source provider) (File/read! (:file provider))))
      (= (:code binding) (code-ids (:function binding)))))
(defn invoke!
 "Identity is the host-established dynamic context. Every call rechecks the
  application's ceiling, resource membership, current roles and exact code."
 [provider operation args]
 (require! (and (string? operation) (vector? args)) :auth/malformed)
 (wire/encode args wire/MAX-REQUEST)
 (let [principal (identity/current)
       authenticated (and principal
                          (or (nil? (:expires-at principal)) (> (:expires-at principal) (wire/now))))
       _ (require! authenticated :auth/unauthenticated)
       export (get-in provider [:prepared :exports operation])
       _ (require! (and export (= (:arity export) (count args))) :auth/unavailable-export)
       policy (:policy export) binding (get (:bindings provider) operation)
       app (when principal (get-in provider [:prepared :policy :grants (:application principal)]))
       app-ok (and (set? app) (some #(= operation (str %)) app))
       _ (require! app-ok :auth/denied)
       resource (resource-for provider (:resource policy) args)
       role-ok (and principal export
                    (some #(contains? (:roles policy) %) ((:roles provider) principal resource)))
       scope-ok (and (wire/text? resource)
                     (or (not (contains? principal :rights))
                         (contains? (:rights principal) [(get-in provider [:prepared :namespace]) operation resource])))
       current (and binding (source-current? provider binding))]
  (require! authenticated :auth/unauthenticated)
  (require! (and export (= (:arity export) (count args))) :auth/unavailable-export)
  (require! (logic/permit? (boolean authenticated) (boolean app-ok) (boolean role-ok) (boolean scope-ok) (boolean current))
            (if current :auth/denied :auth/stale-code))
  (let [ports (:ports export)
        methods
        {:read (fn [port]
                 (require! (contains? (:read ports) port) :auth/effect-denied)
                 (let [read (get (:readers provider) port)]
                  (require! read :auth/effect-unavailable)
                  (let [value (read principal resource)]
                   (wire/encode value wire/MAX-RESPONSE) value)))
         :perform (fn [port value]
                    (require! (contains? (:send ports) port) :auth/effect-denied)
                    (wire/encode value wire/MAX-REQUEST)
                    (let [perform (get (:effects provider) port)]
                     (require! perform :auth/effect-unavailable)
                     (perform principal resource value)))}
        result (BeamLisp.Env/with_code_lease (to-list (keys (:code binding)))
                 (fn []
                  (require! (source-current? provider binding) :auth/stale-code)
                  (env/with-env (:owner provider)
                   #(effect/with-methods :auth/resources methods
                      (fn [] (apply (:function binding) args))))))]
   (wire/encode result wire/MAX-RESPONSE)
   result)))
(defn request [provider operation args]
 {"protocol" PROTOCOL "protocol-version" VERSION "id" (logic/digest (crypto/strong_rand_bytes 16))
  "world" (:world provider) "namespace" (get-in provider [:manifest :namespace])
  "interface" (contract/id (:manifest provider))
  "version" (get-in provider [:manifest :version]) "operation" operation "args" args})
(defn dispatch [provider request]
 (let [base {"protocol" PROTOCOL "protocol-version" VERSION "id" (when (map? request) (get request "id"))
             "world" (:world provider) "namespace" (get-in provider [:prepared :namespace])
             "interface" (contract/id (:manifest provider))}]
  (try
   (wire/encode request wire/MAX-REQUEST)
   (require! (and (map? request) (= PROTOCOL (get request "protocol"))
                  (= VERSION (get request "protocol-version"))
                  (= #{"protocol" "protocol-version" "id" "world" "namespace" "interface" "version" "operation" "args"} (set (keys request)))
                  (wire/text? (get request "id"))) :auth/malformed)
   (require! (= (:world provider) (get request "world")) :auth/wrong-world)
   (require! (and (= (get-in provider [:prepared :namespace]) (get request "namespace"))
                  (= (contract/id (:manifest provider)) (get request "interface"))
                  (= (get-in provider [:prepared :policy :version]) (get request "version"))) :auth/contract-mismatch)
   (assoc base "ok" (invoke! provider (get request "operation") (get request "args")))
   (catch error
    (assoc base "error" {"code" (get ERROR-CODES (:kind (ex-data error)) "auth/unavailable")})))))
(defn endpoint [provider]
 (fn [request]
  ;; Keep caller identity separate from provider Env conveyance.
  (dispatch provider (wire/decode (wire/encode request wire/MAX-REQUEST) wire/MAX-REQUEST))))
