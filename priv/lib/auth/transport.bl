;; Transport is outside the imported application interface.
(ns auth.transport
 (:require [auth] [auth.interface :as namespace] [auth.identity :as identity]
           [auth.wire :as wire] [auth.authority :as private]
           [connector.transport :as transport] [auth.revocation :as revocation] [web]))
(def PATH "/realms/v1")
(def KINDS
 {"auth/unauthenticated" :auth/unauthenticated "auth/denied" :auth/denied
  "auth/unavailable-export" :auth/unavailable-export "auth/stale-code" :auth/stale-code
  "auth/contract-mismatch" :auth/contract-mismatch "auth/wrong-world" :auth/wrong-world
  "auth/unproved" :auth/unproved "auth/effect-denied" :auth/effect-denied
  "auth/effect-unavailable" :auth/effect-unavailable "auth/malformed" :auth/malformed})
(defn result! [request reply]
 (when-not (and (map? reply) (= namespace/PROTOCOL (get reply "protocol"))
                (= namespace/VERSION (get reply "protocol-version"))
                (= (get request "id") (get reply "id")) (= (get request "world") (get reply "world"))
                (= (get request "namespace") (get reply "namespace"))
                (= (get request "interface") (get reply "interface"))
                (not= (contains? reply "ok") (contains? reply "error")))
  (throw (ex-info "Imported namespace returned an invalid response" {:kind :auth/invalid-response})))
 (if-let [error (get reply "error")]
  (throw (ex-info "Imported namespace refused this call"
           {:kind (get KINDS (get error "code") :auth/unavailable)}))
  (get reply "ok")))
(defn bearer-authenticator [public audience revocation]
 (fn [request]
  (let [values (Plug.Conn/get_req_header request "authorization")
        value (when (= 1 (count values)) (first values))]
   (when (and (string? value) (starts-with? value "Bearer ") (<= (count value) wire/MAX-REQUEST))
    (try (identity/verify-token public (auth/decode-base64 (subs value 7)) audience revocation)
     (catch _ nil))))))
(defn authority-authenticator
 "Fresh issuer and revocation data on every request. Missing/unreadable policy
  never silently becomes offline authorization. Role membership is checked again
  by the provider independently of token validity."
 [file audience]
 (fn [request]
  (try
   (let [authority (private/private-data file) revoked (:revoked authority)]
    (when-not (set? revoked) (throw (ex-info "Explicit revocation policy required" {})))
    ((bearer-authenticator (Base/url_decode64! (:issuer-public authority)) audience
       (revocation/fn-oracle (fn [id] (contains? revoked (Base/url_encode64 id))))) request))
   (catch _ nil))))
(defn handler [provider authenticate]
 (fn [request]
  (let [reply (fn [conn status value]
                (web/json (-> conn (web/resp-header "cache-control" "no-store")
                                   (web/resp-header "connection" "close")) status value))]
   (cond
    (= "/health" (web/path request)) (reply request 200 {:ok true})
    (not= PATH (web/path request)) (reply request 404 {:error "not-found"})
    (not= "post" (web/method request)) (reply request 405 {:error "method-not-allowed"})
    (seq (Plug.Conn/get_req_header request "origin")) (reply request 403 {:error "service-client-required"})
    :else
    (try
     (if-let [principal (authenticate request)]
      (let [read (web/read-body-limited* request wire/MAX-REQUEST 3000) conn (:conn read)]
       (if (:error read) (reply conn 413 {:error "invalid-body"})
        (try
         (identity/with-verified principal
          #(reply conn 200 (namespace/dispatch provider (wire/decode (:body read) wire/MAX-REQUEST))))
         (catch _ (reply conn 400 {:error "invalid-body"})))))
      (reply request 401 {:error "unauthenticated"}))
     (catch _ (reply request 503 {:error "authority-unavailable"})))))))
(defn endpoint [{:keys [url token-file token-for issuer-public timeout-ms] :or {timeout-ms 5000}}]
 (let [uri (URI/parse url)]
  (when-not (and (contains? #{"https" "http"} (:scheme uri)) (wire/text? (:host uri))
                 (or (= "https" (:scheme uri)) (= "127.0.0.1" (:host uri))) (= PATH (:path uri))
                 (nil? (:userinfo uri)) (nil? (:query uri)) (nil? (:fragment uri)))
   (throw (ex-info "Invalid imported namespace audience" {:kind :auth/invalid-audience}))))
 (fn [request]
  (let [principal (identity/current)
        token (if token-for (token-for principal request) (String/trim (File/read! token-file)))
        verified (when issuer-public
                   (try (identity/verify-token (Base/url_decode64! issuer-public)
                          (auth/decode-base64 token) (get request "world") nil) (catch _ nil)))
        _ (when-not verified (throw (ex-info "No verified delegation credential" {:kind :auth/unauthenticated})))
        _ (when (or (and (= :person (:kind verified))
                         (not (and principal (= (:subject principal) (:subject verified))
                                   (= (:application principal) (:application verified)))))
                    (and principal (not= (:kind principal) (:kind verified))))
            (throw (ex-info "A credential cannot substitute another caller" {:kind :auth/denied})))
        response (transport/request!
                   {:method :post :url url :body (wire/encode request wire/MAX-REQUEST) :encoding :bytes
                    :headers {"authorization" (str "Bearer " token) "content-type" "application/json"}
                    :decode :bytes :timeout-ms timeout-ms :max-bytes wire/MAX-RESPONSE})]
   (when (or (:error response) (not= 200 (:status response)))
    (throw (ex-info "Imported namespace is unavailable"
             {:kind (if (= 401 (:status response)) :auth/unauthenticated :auth/unavailable)
              :outcome :uncertain})))
   (wire/decode (:body response) wire/MAX-RESPONSE))))
