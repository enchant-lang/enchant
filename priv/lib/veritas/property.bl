; veritas/property.bl — hypothesis testing: a property over a function's OUTPUT.
;
; ── Where this sits ─────────────────────────────────────────────────────────
;
; veritas core's `covers` reads a function's own guard clauses and asks a
; STRUCTURAL question: does every input land in some clause? That never RUNS the
; function. A hypothesis is the behavioural analogue: RUN the function on an
; input and assert a predicate over its RETURN value. The core cannot express
; this — it checks predicates over generated inputs, it never calls a target fn
; and inspects the result.
;
; The move (classic QuickCheck/Hypothesis, one turn of the screw): a REFUTED
; property is SHRUNK to its minimal witness — the smallest input that still breaks
; it — so the report names the simplest failing case, not the first random one.
;
; The fuzz DOMAIN is drawn from veritas generators (veritas/samples): an int-of is
; a bounded int domain, any-of is the cross-type domain (the old fuzz/mixed),
; tuple-of is a multi-arg domain (the old fuzz/pairs). One generator algebra feeds
; the property tester and the core alike — not a second, parallel domain notion.

(ns veritas.property
 (:require [veritas :as v] [typed] [env] [core] [compiler :as compiler] [reader-node :as rn]
           [formal.source-runtime :as source-runtime] [formal.source :as source] [formal.term :as t]
           [formal.value :as value] [formal.query :as q] [formal.logic :as logic]
           [formal.identity :as identity] [formal.runtime-values :as rv]))

; ── read a function's shape as data ─────────────────────────────────────────

(defn- ensure-src
  "Normalize a function argument to bl SOURCE. Callers may pass either a source
   STRING (\"(defn f [x] …)\") or a QUOTED bl FORM ('(defn f [x] …)) — the form
   is the natural bl idiom, so accept both. A non-string is pr-str'd back to
   source before it reaches BeamLisp.Reader/read_string (which only reads a
   binary). Idempotent on strings."
  [src]
  (if (string? src) src (core/pr-str src)))

(defn shape-of
 "Read one plain defn with one unguarded clause and distinct parameters.
  Destructuring, attributes, guards and multiple clauses require a richer
  source contract. The output binder `result` is reserved."
 [src]
 (let [forms (BeamLisp.Reader/read_string (ensure-src src))
       _ (when-not (= 1 (count forms)) (throw (ex-info "One source function required" {})))
       node (rn/node-form (first forms))
       _ (when-not (= :list (rn/node-tag node)) (throw (ex-info "A defn form is required" {})))
       items (rn/node-items node)
       _ (when-not (and (>= (count items) 4) (= "defn" (rn/node-name (rn/node-form (first items))))
                        (= :symbol (rn/node-tag (rn/node-form (second items)))))
           (throw (ex-info "A plain defn form is required" {})))
       parsed (nth (typed/defn-clauses items) 2) clause (first parsed)
       params (:params clause)
       marker (rn/node-form (second (rn/node-items (:node clause))))
       guarded? (and (= :keyword (rn/node-tag marker)) (= "when" (rn/node-name marker)))
       _ (when-not (and (= 1 (count parsed)) (not guarded?) (seq (:body clause))
                        (<= (count params) 16) (every? #(= :symbol (rn/node-tag (rn/node-form %))) params))
           (throw (ex-info "One unguarded clause with up to 16 variable parameters required" {})))
       names (mapv #(rn/node-name (rn/node-form %)) params)
       _ (when-not (and (= (count names) (count (set names)))
                        (every? #(and (not= "result" %) (not= "&" %) (not (String/contains? % "/"))) names))
           (throw (ex-info "Distinct unqualified parameters required; result is reserved" {})))
       fn-node (rn/list-node (concat (list (rn/sym-node "fn") (tuple :vector params)) (:body clause)))]
  {:name (rn/node-name (rn/node-form (second items))) :params names
   :fn-source (core/pr-str (compiler/datum fn-node))}))

; ── render an INPUT (a tuple of args) as bl source ──────────────────────────

(defn- lit [value]
 ;; Reader/printed data handles quotes, backslashes, symbols and containers.
 (str "(quote " (core/pr-str value) ")"))

(defn- args-src [gen candidate]
 (core/join " " (map lit (if (= :tuple (v/gen-tag gen)) candidate [candidate]))))
(defn- params-src [params] (core/join " " params))

; ── call the function on a candidate ────────────────────────────────────────

(defn- call
  "Call function `src` on candidate `cand`. {:ok v} on a normal return, {:raised
   true} on any raise (a crash is a first-class property outcome)."
  [src params gen cand]
  (let [s (ensure-src src)
        node (first (BeamLisp.Reader/read_string s))]
    (try
      {:ok (env/eval (str s "\n(" (:name (shape-of s)) " " (args-src gen cand) ")"))}
      (catch _ {:raised true}))))

; ── does the hypothesis hold at a candidate? ────────────────────────────────
;
; Call the fn, then evaluate the predicate with `result` bound to the return. A
; raise during the CALL is {:crash true}; a raise in the predicate counts as the
; property NOT holding (a property that errors is a failed property). The predicate
; is evaluated as a self-contained lambda over the params + `result`, so nothing
; from the caller's scope leaks in.

(defn- holds-at?
  [src params pred gen cand]
  (let [r (call src params gen cand)]
    (if (:raised r)
      {:holds false :crash true :input cand}
      (let [ok (try
                 (= true (env/eval
                           (str "((fn [" (params-src params) " result] " (pr-str (v/pred-form pred)) ") "
                                (args-src gen cand) " " (lit (:ok r)) ")")))
                 (catch _ false))]
        {:holds ok :crash false :input cand :result (:ok r)}))))

; ── shrink: the minimal witness, INSIDE the generator's domain ──────────────

(defn- shrink
  "Walk a failing `cand` down to a LOCAL MINIMUM inside `gen`'s domain: the
   simplest input that still fails the property. Reuses veritas core's
   DOMAIN-PRESERVING walk (the same GenShrink candidates the quantifier core
   shrinks with) — not a second, generator-blind ladder, which could walk a
   witness below its own domain (e.g. `int-of 5 100` → 0) and so report a value
   that is no longer a counterexample of the query that was asked.

   A multi-arg candidate is a coordinate TUPLE; only a `tuple-of` generator
   carries a domain PER coordinate, so any other generator retains the witness
   rather than risk a malformed (arity-changing) call. An unknown generator (no
   GenShrink) offers no in-domain candidates and likewise keeps its witness."
  [gen src params pred cand]
  (if (and (> (count params) 1) (not= :tuple (v/gen-tag gen)))
    cand
    (v/shrink-in-domain gen
                        (fn [c] (not (:holds (holds-at? src params pred gen c))))
                        cand)))

; ── the public verb ─────────────────────────────────────────────────────────

(defn hypothesis
  "Test a behavioural hypothesis `pred` (a QUOTED bl form over the input params and
   `result`) against a function `src` over the domain of generator `gen`. Tries to
   REFUTE it; on the first failing input, SHRINKS to the minimal witness. Returns
     {:holds true}                                     — no counterexample found
     {:holds false :witness cand :shrunk cand          — refuted, minimal case
      :result v :crash bool}                            — whether it was a crash
   A successful sample is not a proof. Shrinking seeks a local minimum in the
   generator domain. `n` controls sampling."
  [src0 pred gen n]
  (let [src (ensure-src src0)
        sh (shape-of src)
        params (:params sh)
        _ (when-not (= (count params) (if (= :tuple (v/gen-tag gen)) (count (:gens gen)) 1))
            (throw (ex-info "Generator coordinates must match function arity before sampling" {})))
        domain (v/samples gen n)
        failing (core/some (fn [c]
                             (let [h (holds-at? src params pred gen c)]
                               (if (:holds h) nil h)))
                           domain)]
    (if (nil? failing)
      {:holds true :tried (count domain)}
      (let [minimal (shrink gen src params pred (:input failing))
            mres (holds-at? src params pred gen minimal)]
        {:holds false
         :witness (:input failing)
         :shrunk minimal
         :result (:result mres)
         :crash (:crash mres)}))))

; A source law means: the target returns, the predicate returns, and its
; result is exactly true. Crashes remain counterexamples even when `result`
; is unused. The question contains no textual SMT or invented return sort.
(defn prepare
 "Prepare a complete backend-independent source property without executing it."
 [src0 pred gen]
 (try
  (let [src (ensure-src src0) shape (shape-of src) params (:params shape)
        tuple? (= :tuple (v/gen-tag gen))
        generators (if tuple? (:gens gen) [gen])
        _ (when-not (= (count params) (count generators))
            (throw (ex-info "Generator coordinates must match function arity exactly" {})))
        inputs (mapv (fn [i]
                   (or (v/gen-term (nth generators i) (str "property/input/" i))
                       (throw (ex-info "Generator has no reviewed term-based runtime domain" {:index i}))))
                 (range (count params)))
        function (source/prepare-function (:fn-source shape) inputs)
        _ (when-not (= :translated (:status function)) (throw (ex-info (:reason function) {})))
        output (:value function)
        predicate-source (str "(fn [" (params-src params) " result] " (pr-str (v/pred-form pred)) ")")
        predicate (source/prepare-function predicate-source (conj inputs output))
        _ (when-not (= :translated (:status predicate)) (throw (ex-info (:reason predicate) {})))
        property (:value predicate)
        _ (when-not (= t/Bool (t/sort-of (value/term property)))
            (throw (ex-info "A source property must return Bool, rather than a truthy value" {})))
        claim (value/scalar (value/term property) [output property] {})
        observe (merge (into {} (map-indexed (fn [i x] [(str "input/" i) x]) inputs))
                        {"result" output "predicate" property})
        problem (q/prove claim {:id :veritas/source-property :inputs inputs :observe observe
                 :profile :bl/source-property-v1
                 :origin {:source src :predicate (pr-str (v/pred-form pred)) :basis :compiler-anf}})]
   {:status :translated :problem problem :question-identity (identity/hash problem)
    :function function :predicate predicate :params params :tuple tuple? :generator gen
    :source-connection {:status :reviewed :basis :compiler-anf
                        :relation :returns-and-boolean-property :metatheory :not-mechanized}
    :compiler-proof-authority false})
  (catch error {:status :unsupported :reason (ex-message error) :compiler-proof-authority false})))

(defn- runtime-replay [prepared answer]
 (let [n (count (:params prepared)) observations (:witness answer)
       fields (mapv #(get observations (str "input/" %)) (range n))
       projected (mapv (fn [i]
                         (let [field (nth fields i)]
                          (when (and (= true (:defined field)) (= true (:within field)))
                           (rv/concrete (nth (get-in prepared [:function :inputs]) i) (:value field))))) (range n))
       concrete? (every? some? projected)
       args (mapv :value projected)
       witness (if (:tuple prepared) args (first args))
       in-domain? (and concrete? (v/gen-domain? (:generator prepared) witness))]
  (if-not in-domain?
   {:status :unavailable :reason :input-observations-or-domain}
   (let [actual (source-runtime/run (get-in prepared [:function :anf]) args)
         check (when (= :returned (:status actual))
                 (source-runtime/run (get-in prepared [:predicate :anf]) (conj args (:value actual))))
         predicted-result (get observations "result") predicted-property (get observations "predicate")
         matches? (and
           (contains? #{:returned :raised} (:status actual))
           (= false (:module-loaded actual))
           (or (= :raised (:status actual)) (and (contains? #{:returned :raised} (:status check)) (= false (:module-loaded check))))
           (= (= :returned (:status actual)) (:defined predicted-result))
           (or (= :raised (:status actual))
               (and (rv/matches? (get-in prepared [:function :value]) (:value actual) (:value predicted-result))
                    (= (= :returned (:status check)) (:defined predicted-property))
                    (or (= :raised (:status check)) (= (:value check) (:value predicted-property))))))
         fails? (or (= :raised (:status actual)) (= :raised (:status check)) (not= true (:value check)))]
    {:status (if (and matches? fails?) :reproduced :mismatch)
     :witness witness :arguments args :target actual :predicate check
     :holds (not fails?) :crash (= :raised (:status actual)) :matches-term-model matches?}))))

(defn prove
 "Check a source law using {:backend :z3|:oxiz}, returning its full term
  question and answer. Native UNSAT is :solver-claim, never a checked source
  proof. A refutation requires term replay and execution of the translated
  compiler ANF. Unsupported source returns :unsupported; :fallback :sample
  explicitly requests execution and sampling instead."
 [opts src pred gen]
 (when-not (map? opts) (throw (ex-info "Property checking requires an options map, not a legacy solver port" {})))
 (when-not (contains? #{nil :sample} (:fallback opts)) (throw (ex-info "Unknown source-property fallback" {})))
 (let [prepared (prepare src pred gen)]
  (if-not (= :translated (:status prepared))
   (if (= :sample (:fallback opts))
    (let [h (hypothesis src pred gen (get opts :sample-n 64))]
     (merge {:modality (if (:holds h) :witnessed :refuted) :engine :sample
             :symbolic prepared :compiler-proof-authority false}
            (if (:holds h) (select-keys h [:tried]) {:witness (:shrunk h) :crash (:crash h) :result (:result h)})))
    {:modality :unsupported :engine :terms :reason (:reason prepared) :preparation prepared :compiler-proof-authority false})
   (let [answer (logic/run opts (:problem prepared))
         replay (when (= :refuted (:verdict answer)) (runtime-replay prepared answer))
         modality (case (:verdict answer)
                    :proved :solver-claim
                    :refuted (if (= :reproduced (:status replay)) :refuted :candidate)
                    :candidate :candidate :vacuous :vacuous :unsupported :unsupported :error :error :unknown)
         base {:modality modality :engine :terms :question (:problem prepared)
               :question-identity (:question-identity prepared) :answer answer
               :source-connection (:source-connection prepared) :runtime-replay replay :compiler-proof-authority false}]
    (if (= :reproduced (:status replay))
     (merge base {:witness (:witness replay) :result (get-in replay [:target :value]) :crash (:crash replay)}) base)))))
