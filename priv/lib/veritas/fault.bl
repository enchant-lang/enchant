(ns veritas.fault (:require [veritas.mock :as mock] [datom]))

(defn isolate [options contract clause]
 (assoc (mock/synth options contract {:mode :isolate :clause clause}) :clause clause))
(defn isolate-all [options contract]
 (mapv #(isolate options contract %) (range (mock/law-count contract))))
(defn error-for
 "A complete isolated-fault result. Absence claims, vacuity and unresolved
  answers keep their questions; none is silently turned into an injected value."
 [options contract clause] (isolate options contract clause))
(defn errors
 "Every named fault request, including unavailable and unresolved outcomes."
 [options contract]
 (into {} (mapv (fn [row] [(:clause row) row]) (isolate-all options contract))))
(defn total-error
 "Ask for one response violating every law. This is stronger than the negation
  of their conjunction and can be infeasible even when ordinary faults exist."
 [options contract] (mock/synth options contract {:mode :all-invalid}))
(defn make-server [mock injections]
 (when-not (map? injections) (throw (ex-info "Fault injections must be an explicit request-key map" {})))
 {:mock mock :injections injections})
(defn serve [server key]
 (let [mock (:mock server)]
  (if (contains? (:injections server) key)
   (let [clause (get (:injections server) key)
         result (error-for (:options mock) (:contract mock) clause)]
    (assoc result :ok? false :reason clause :requested :fault
                  :injected? (= :witnessed (:modality result))))
   (assoc (mock/answer mock key) :reason nil :requested :valid :injected? false))))

(def SCHEMA
 [{:db/ident :clause/idx :db/valueType :db.type/long :db/unique :db.unique/identity}
  {:db/ident :clause/text :db/valueType :db.type/string}
  {:db/ident :clause/model :db/valueType :db.type/term}
  {:db/ident :fault/id :db/valueType :db.type/long :db/unique :db.unique/identity}
  {:db/ident :fault/kind :db/valueType :db.type/keyword}
  {:db/ident :fault/violates :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
  {:db/ident :fault/reason :db/valueType :db.type/long}
  {:db/ident :fault/value :db/valueType :db.type/term}
  {:db/ident :fault/check-status :db/valueType :db.type/keyword}
  {:db/ident :fault/measurement :db/valueType :db.type/term}])

(defn build-db
 "Measure supplied concrete responses and create an owned datom connection.
  Only independently observed violations produce edges. Unknown, interface and
  domain failures remain records. The caller closes :conn when finished."
 [options contract mutants]
 (let [definition (mock/definition contract)
       _ (when-not (and (map? options) (vector? mutants)
                        (every? #(and (int? (:fault/id %)) (<= 0 (:fault/id %))
                                      (keyword? (get % :kind :observed))) mutants)
                        (= (count mutants) (count (set (map :fault/id mutants)))))
           (throw (ex-info "Fault measurements need distinct nonnegative IDs and explicit options" {})))
       measured (mapv (fn [mutant]
                        (assoc mutant :measurement
                         (when (contains? mutant :value)
                          (try (mock/check-result options contract (:value mutant))
                               (catch error {:status :error :reason (ex-message error)}))))) mutants)
       clauses (mapv (fn [i law]
                       {:db/id (inc i) :clause/idx i :clause/model law
                        :clause/text (or (get-in definition [:origin :laws i]) (str "Typed response law " i))})
                     (range (mock/law-count contract)) (:laws definition))
       concrete (vec (filter #(contains? % :value) measured))
       faults (mapv (fn [i mutant]
                      (let [measurement (:measurement mutant)
                            violations (filter #(= :violated (:status %)) (:laws measurement))]
                       {:db/id (+ 1000000 i) :fault/id (:fault/id mutant) :fault/kind (get mutant :kind :observed)
                        :fault/reason (get mutant :clause -1) :fault/value [(:value mutant)]
                        :fault/check-status (:status measurement) :fault/measurement measurement
                        :fault/violates (mapv #(inc (:clause %)) violations)}))
                    (range (count concrete)) concrete)
       conn (datom/connect SCHEMA)]
  (try
   (datom/transact! conn (into clauses faults))
   {:conn conn :db (datom/db conn) :faults faults :attempts measured
    :complete? (every? #(contains? #{:valid :invalid} (get-in % [:measurement :status])) concrete)
    :compiler-proof-authority false}
   (catch error (datom/close! conn) (throw error)))))

(defn uncovered-clauses [db]
 (vec (sort (map first (datom/q '[:find ?idx :where [?c :clause/idx ?idx]
                                             [:not-join [?c] [?f :fault/violates ?c]]] db)))))
(defn covered-clauses [db]
 (vec (sort (distinct (map first (datom/q '[:find ?idx :where [?f :fault/violates ?c]
                                                                          [?c :clause/idx ?idx]] db))))))
(defn faults-per-clause [db]
 (let [rows (vec (datom/q '[:find ?idx ?f :where [?f :fault/violates ?c] [?c :clause/idx ?idx]] db))]
  (into {} (mapv (fn [[idx entries]] [idx (count entries)]) (vec (group-by first rows))))))
(defn redundant-mutants
 "Equal complete violation signatures. Partial observations cannot establish
  redundancy, and complete empty signatures remain visible."
 [db]
 (let [ids (vec (datom/q '[:find ?id ?status :where [?f :fault/id ?id] [?f :fault/check-status ?status]] db))
       edges (vec (datom/q '[:find ?id ?idx :where [?f :fault/id ?id] [?f :fault/violates ?c] [?c :clause/idx ?idx]] db))
       by-id (group-by first edges)
       signatures (mapv (fn [[id _]] [id (vec (sort (map second (get by-id id []))))])
                         (filter #(contains? #{:valid :invalid} (second %)) ids))
       groups (group-by second signatures)]
  (vec (sort-by :faults
         (keep (fn [[signature rows]]
                 (when (> (count rows) 1) {:signature signature :faults (vec (sort (map first rows))) :measurement :complete}))
               groups)))))

(defn independent-laws [isolated]
 {:independent (vec (sort (map :clause (filter #(= :witnessed (:modality %)) isolated))))
  :implied (vec (sort (map :clause (filter #(and (= :solver-claim (:modality %)) (= true (:implied %))) isolated))))
  :vacuous (vec (sort (map :clause (filter #(= :vacuous (:modality %)) isolated))))
  :undecidable (vec (sort (map :clause (remove #(or (= :witnessed (:modality %)) (= :vacuous (:modality %))
                                                  (and (= :solver-claim (:modality %)) (= true (:implied %)))) isolated))))
  :implication-basis :unchecked-solver-claim :compiler-proof-authority false})

(defn report
 "A portable report, with the database closed before returning. Use build-db
  explicitly when the caller needs an owned queryable connection."
 [options contract]
 (let [isolated (isolate-all options contract)
       mutants (mapv (fn [i row] (assoc row :fault/id i :kind :isolated)) (range (count isolated)) isolated)
       world (build-db options contract mutants)]
  (try
   {:clauses (mock/law-count contract) :faults (count (:faults world))
    :covered (covered-clauses (:db world)) :uncovered (uncovered-clauses (:db world))
    :measurements-complete? (:complete? world) :coverage-scope :supplied-concrete-responses :attempts (:attempts world)
    :generation-resolved? (empty? (:undecidable (independent-laws isolated)))
    :faults-per-clause (faults-per-clause (:db world)) :redundant (redundant-mutants (:db world))
    :laws (independent-laws isolated) :isolation isolated :compiler-proof-authority false}
   (finally (datom/close! (:conn world))))))
