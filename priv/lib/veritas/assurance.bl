;; Evidence composition without promoting samples or solver reports to proofs.
(ns veritas.assurance (:require [veritas :as v]))
(def ACCEPTED #{:checked :exhausted})
(defn structural [id holds detail]
 {:id id :modality (if (= true holds) :checked :unsupported) :detail detail})
(defn finite
 "Exhaust the actual finite runtime domain. Preserve Veritas's modality."
 [id cases predicate]
 (when-not (and (vector? cases) (seq cases) (<= (count cases) 4096))
  (throw (ex-info "A bounded nonempty finite assurance domain is required" {})))
 (assoc (v/for-all {:engine :enumerate} "case" (apply v/one-of cases) predicate)
        :id id :domain-size (count cases)))
(defn combine
 "Diagnostic evidence, never a bearer capability. Admission recomputes it from
  current source and compiler identities; a supplied success flag is not proof."
 [subject obligations]
 {:subject subject :obligations obligations
  :status (if (and (seq obligations) (every? #(contains? ACCEPTED (:modality %)) obligations)) :checked :unsupported)
  :compiler-proof-authority false})
