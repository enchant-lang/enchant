; A durable record of caller verdicts, complete questions and their evidence.
; Recording checks question identity, not mathematical validity. Reports retain
; unknown modalities and explicit witness presence; no row gains proof or
; compiler authority merely by being stored.

(ns veritas.ledger
  (:require [datom] [datom.store-fjall] [datom.file :as file] [datom.value-codec :as codec]
            [formal.identity :as identity] [formal.query :as query]))

(def schema
  [{:db/ident :verdict/id       :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :verdict/claim    :db/valueType :db.type/string}
   {:db/ident :verdict/modality :db/valueType :db.type/keyword :db/index true}
   {:db/ident :verdict/engine   :db/valueType :db.type/keyword}
   {:db/ident :verdict/why      :db/valueType :db.type/string}
   {:db/ident :verdict/seed     :db/valueType :db.type/long}
   {:db/ident :verdict/tried    :db/valueType :db.type/long}
   {:db/ident :verdict/witness  :db/valueType :db.type/term}
   {:db/ident :verdict/witness-present :db/valueType :db.type/boolean}
   {:db/ident :verdict/witness-value :db/valueType :db.type/term}
   {:db/ident :verdict/question-id :db/valueType :db.type/string}
   {:db/ident :verdict/question :db/valueType :db.type/term}
   {:db/ident :verdict/evidence :db/valueType :db.type/term}
   {:db/ident :verdict/payload :db/valueType :db.type/file}
   {:db/ident :verdict/assurance :db/valueType :db.type/keyword}
   {:db/ident :verdict/compiler-authority :db/valueType :db.type/boolean}
   {:db/ident :verdict/replay   :db/valueType :db.type/string}
   {:db/ident :verdict/about    :db/valueType :db.type/string :db/cardinality :db.cardinality/many :db/index true}
   {:db/ident :verdict/by       :db/valueType :db.type/string}
   {:db/ident :verdict/at       :db/valueType :db.type/long :db/index true}])

(defn open
  "A ledger: a durable datom conn at `path` (fjall), or in memory when `path` is
   nil (tests, throwaway sessions)."
  [path]
  (if (nil? path)
    (datom/connect schema)
    (datom/connect-with (datom.store-fjall/open path) schema)))

(defn- vid []
 (str "vd-" (Base/encode16 (crypto/strong_rand_bytes 16) (list (tuple :case :lower)))))

(def ^:private payload-byte-limit (* 16 1024 1024))
(def ^:private payload-media-type "application/vnd.beam-lisp.verdict-payload.v1")
(defn- payload! [ledger payload]
 (let [bytes (codec/encode payload)]
  (when (> (erlang/byte_size bytes) payload-byte-limit)
   (throw (ex-info "Ledger payload exceeds its explicit byte capacity" {})))
  (datom/put-file! ledger bytes {:media-type payload-media-type})))

(defn record!
  "Record a caller verdict without granting proof authority, under `meta`
   {:claim str (required) :about [str …] :by str :replay str}. The shrunk
   witness is kept when present (it is the one worth replaying). → the id."
  [ledger v meta]
  (when-not (and (keyword? (:modality v)) (string? (:claim meta)))
   (throw (ex-info "A ledger record needs an explicit modality and claim" {})))
  (let [at (erlang/system_time :millisecond) id (vid)
        present (or (contains? v :shrunk) (contains? v :witness))
        w (if (contains? v :shrunk) (:shrunk v) (:witness v))
        question (:question v)
        qid (when question (identity/hash (query/validate! question)))
        _ (when (and (:question-identity v) (not= qid (:question-identity v)))
            (throw (ex-info "Ledger question identity does not match the recorded question" {})))
        evidence (select-keys v [:modality :engine :complete :none :answer :source-connection :runtime-replay :projection-replay
                                :claim-kind :evidence :feasibility :optimality :compiler-proof-authority])
        ;; Values occur in covering-index keys. Complete questions and evidence
        ;; can exceed the store's 64 KiB key capacity, even for small contracts.
        ;; Keep their exact value-codec bytes in the existing blob tier instead.
        payload (payload! ledger
                  (cond-> {:veritas/verdict-payload 1 :evidence evidence}
                    qid (assoc :question question)
                    present (assoc :witness [w])))]
    (datom/transact! ledger
      [(cond-> {:db/id -1 :verdict/id id :verdict/claim (:claim meta)
                 :verdict/modality (:modality v) :verdict/at at
                :verdict/witness-present present :verdict/assurance :recorded
                :verdict/compiler-authority false :verdict/payload payload}
         (:engine v) (assoc :verdict/engine (:engine v))
         (:why v) (assoc :verdict/why (:why v))
         (int? (:seed v)) (assoc :verdict/seed (:seed v))
         (int? (:tried v)) (assoc :verdict/tried (:tried v))
         qid (assoc :verdict/question-id qid)
         (:replay meta) (assoc :verdict/replay (:replay meta))
         (:by meta) (assoc :verdict/by (:by meta)))])
    ;; many-valued refs go in as list-form adds: a map-form SET value is
    ;; rejected as one wrong-typed value (measured), not expanded
    (when (seq (:about meta))
      (let [e (first (first (into [] (datom/q '[:find ?e :in $ ?id :where [?e :verdict/id ?id]]
                                              (datom/db ledger) id))))]
        (datom/transact! ledger (mapv (fn [a] [:db/add e :verdict/about a]) (distinct (:about meta))))))
    id))

(def ^:private PULL
  [:verdict/id :verdict/claim :verdict/modality :verdict/engine :verdict/why
   :verdict/seed :verdict/tried :verdict/witness :verdict/replay :verdict/about
   :verdict/by :verdict/at :verdict/witness-present :verdict/witness-value
   :verdict/question-id :verdict/question :verdict/evidence :verdict/payload :verdict/assurance :verdict/compiler-authority])

(defn- normalize-row [db row]
 (let [row (if-let [descriptor (:verdict/payload row)]
             (do
              (when-not (and (file/file? descriptor) (= payload-media-type (:media-type descriptor))
                             (int? (:size descriptor)) (<= 1 (:size descriptor) payload-byte-limit))
               (throw (ex-info "Ledger payload descriptor is invalid" {})))
              (let [bytes (datom/file-bytes db descriptor)]
               (when-not (and (erlang/is_binary bytes) (= (:size descriptor) (erlang/byte_size bytes))
                              (= (:sha descriptor) (file/sha256 bytes)))
                (throw (ex-info "Ledger payload is missing or corrupt" {})))
               (let [payload (codec/decode bytes) question (:question payload)]
                (when-not (and (map? payload) (= 1 (:veritas/verdict-payload payload)) (map? (:evidence payload))
                               (= (boolean (:verdict/question-id row)) (contains? payload :question))
                               (or (not (contains? payload :question)) (= (:verdict/question-id row) (identity/hash (query/validate! question))))
                               (= (= true (:verdict/witness-present row)) (contains? payload :witness))
                               (or (not (contains? payload :witness)) (and (vector? (:witness payload)) (= 1 (count (:witness payload))))))
                 (throw (ex-info "Ledger payload does not match its indexed record" {})))
                (cond-> (assoc (dissoc row :verdict/payload) :verdict/evidence (:evidence payload))
                 question (assoc :verdict/question question)
                 (contains? payload :witness) (assoc :verdict/witness-value (:witness payload)))))) row)]
  ;; Existing inline records retain their public shape, including false/nil.
  (if (= true (:verdict/witness-present row))
   (assoc row :verdict/witness (first (:verdict/witness-value row))) row)))

(defn all
  "Every verdict, newest first; `since` (epoch ms) narrows."
  ([ledger] (all ledger 0))
  ([ledger since]
   (let [d (datom/db ledger)
         es (into [] (datom/q '[:find ?e ?at :in $ ?since
                                :where [?e :verdict/at ?at] [(>= ?at ?since)]]
                              d since))]
     (mapv (fn [[e _]]
             (normalize-row d (datom/pull d PULL e)))
           (reverse (sort-by second es))))))

(defn about
  "Every verdict resting on `thing` (a string naming code: \"ns/fn\")."
  [ledger thing]
  (let [d (datom/db ledger)]
    (mapv (fn [[e]] (normalize-row d (datom/pull d PULL e)))
          (into [] (datom/q '[:find ?e :in $ ?t :where [?e :verdict/about ?t]] d thing)))))

(def ^:private SECTIONS
 [[:error "Execution or interface errors"] [:refuted "Refuted"] [:candidate "Unconfirmed candidates"]
  [:unknown "Unknown"] [:unsupported "Unsupported"] [:vacuous "Vacuous"]
  [:witnessed "Witnessed (inspect engine and completeness)"] [:exhausted "Exhausted finite domains"]
  [:solver-claim "Solver claims (certificate unchecked)"]
  [:checked "Recorded checked labels (inspect evidence)"] [:proven "Legacy proven labels (not independently checked here)"]])

(defn- line [v]
  (str "- " (:verdict/claim v)
       " — " (name (or (:verdict/engine v) :unknown))
       (if (some? (:verdict/tried v)) (str ", " (:verdict/tried v) " tried") "")
       (if (some? (:verdict/seed v)) (str ", seed " (:verdict/seed v)) "")
       (if (or (= true (:verdict/witness-present v)) (and (nil? (:verdict/witness-present v)) (some? (:verdict/witness v))))
         (str "\n  witness: " (pr-str (:verdict/witness v))) "")
       (if (some? (:verdict/replay v)) (str "\n  replay: " (:verdict/replay v)) "")
       (if (:verdict/question-id v) (str "\n  question: " (:verdict/question-id v)) "")
       "  [" (:verdict/id v) "]"))

(defn report
  "Report every recorded modality with engine, effort, seed and witness.
   Native claims and legacy proof labels remain explicitly unchecked."
  ([ledger] (report ledger 0))
  ([ledger since]
   (let [vs (all ledger since)
         by (group-by :verdict/modality vs)
         known (set (map first SECTIONS))
         sections (concat SECTIONS (map (fn [k] [k (str "Other recorded modality: " (pr-str k))])
                                        (sort-by pr-str (remove #(contains? known %) (keys by)))))]
     (join "\n"
       (mapcat (fn [[k title]]
                 (let [xs (get by k)]
                   (if (empty? xs) []
                     (concat [(str "## " title " (" (count xs) ")")] (map line xs) [""]))))
               sections)))))
