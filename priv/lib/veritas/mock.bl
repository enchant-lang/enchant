(ns veritas.mock
 (:require [veritas :as v] [formal.response :as response] [formal.term :as t] [formal.value :as value]
           [formal.runtime-values :as runtime] [formal.ground :as ground]
           [formal.response-runtime :as response-runtime] [formal.logic :as logic]
           [formal.integer-optimize :as optimize] [formal.identity :as identity]))

(defn- require! [ok message] (when-not ok (throw (ex-info (str "veritas.mock: " message) {}))))
(defn- field-key [key]
 (require! (or (keyword? key) (string? key) (symbol? key)) "response fields need explicit names")
 (let [key (if (keyword? key) key (keyword (str key)))]
  (require! (not (blank? (str key))) "empty response field name") key))
(defn- options! [options] (require! (map? options) "an options map is required, not a solver handle") options)
(defn- native-sort [shape]
 (if (string? shape) (get {"Int" t/Int "Bool" t/Bool "String" t/String "Real" t/Real "Rounding" t/Rounding} shape) shape))
(defn- namespace-option [options]
 (require! (and (map? options) (every? #(= :namespace %) (keys options))) "unknown contract definition option")
 (let [scope (get options :namespace :veritas/response)]
  (require! (or (keyword? scope) (string? scope)) "a logical namespace must be explicit data") scope))
(defn- fields [declarations source? scope]
 (require! (and (vector? declarations) (<= (count declarations) 256)
                (every? #(and (vector? %) (= 2 (count %))) declarations)) "provide an ordered field vector")
 (let [rows (mapv (fn [i [name shape]]
                    (let [key (field-key name) sort (native-sort shape)
                          role (str "veritas/response/" (identity/hash [scope key (if (t/sort? sort) sort :runtime-model)]))
                          generator? (and source? (satisfies? v/GenTerms shape))
                          model (cond
                                  (t/sort? sort)
                                   (value/lift (t/variable role sort))
                                  generator?
                                   (do (require! (satisfies? v/GenShrink shape) "a source generator needs runtime domain admission")
                                       (or (v/gen-term shape role) (throw (ex-info "Generator has no reviewed term model" {:field key}))))
                                  (and source? (or (value/value? shape) (t/term? shape))) (value/lift shape)
                                  :else (throw (ex-info "Unknown response field domain" {:field key})))
                          model (if (and source? (t/term? (:value model)) (= t/String (t/sort-of (:value model)))
                                         (= :exact (get-in model [:scope :mode])))
                                  (assoc model :scope {:mode :abstract :model :solver-text :runtime-domain :valid-utf8}
                                               :domain {:kind :scalar :profile :bl/solver-text-v1}) model)]
                     {:key key :model model :generator (when generator? shape)}))
                  (range (count declarations)) declarations)]
  (require! (= (count rows) (count (set (map :key rows)))) "field names must retain distinct complete identities")
  rows))

(defn contract
 "Build a mathematical response relation from native sorts and a one-shot
  builder over typed field terms. The builder itself is never stored."
 ([declarations build-laws] (contract declarations build-laws {}))
 ([declarations build-laws options]
 (let [scope (namespace-option options) rows (fields declarations false scope)
       terms (into {} (mapv (fn [row] [(:key row) (value/term (:model row))]) rows))
       laws (if (fn? build-laws) (build-laws terms) build-laws)]
  {:definition (response/define (mapv (fn [row] [(:key row) (:model row)]) rows) laws)
   :fields rows :runtime-kind :terms :runtime-laws [] :namespace scope})))

(defn contract-from
 "Compile every quoted law from actual BL source. Unsupported laws reject the
  whole construction. Generator fields keep their runtime admission checks."
 ([declarations predicates] (contract-from declarations predicates {}))
 ([declarations predicates options]
 (let [scope (namespace-option options) rows (fields declarations true scope)
       built (response-runtime/from-source (mapv (fn [row] [(:key row) (:model row)]) rows) predicates)]
  (assoc built :fields rows :namespace scope))))

(defn definition [contract]
 (let [result (:definition contract)]
  (require! (= 1 (:formal/response result)) "a typed response contract is required; legacy SMT contracts are not accepted")
  result))
(defn field [contract name] (response/field (definition contract) (field-key name)))
(defn law-count [contract] (count (:laws (definition contract))))

(defn prepare
 "Expose the complete question before execution. Extra constraints are typed
  assumptions or named concrete pins; no solver text or commands are accepted."
 ([contract] (prepare contract {}))
 ([contract request]
  (require! (and (map? request) (every? #(contains? #{:mode :clause :pins :assumptions} %) (keys request))) "unknown response request option")
  (let [model (definition contract) pins (get request :pins {}) assumptions (get request :assumptions [])
        _ (require! (and (map? pins) (vector? assumptions)) "pins are a map and assumptions an explicit vector")
        pins (mapv (fn [[key data]] [(field-key key) data]) pins)
        _ (require! (= (count pins) (count (set (map first pins)))) "duplicate normalized response pin")
        bound (ground/combine (mapv (fn [[key data]] (runtime/bind (response/field model key) data)) pins))
        _ (require! (= :valid (:status bound)) (str "a pin has no admitted concrete representation: " (pr-str (:reason bound))))
        question (response/question model
                   (merge (select-keys request [:mode :clause])
                          {:assumptions (into assumptions (:pins bound))}))]
   {:question question :question-identity (identity/hash question) :request request
    :contract contract :pins (into {} pins)})))

(defn- runtime-admission [contract data]
 (when (map? data)
  (try
   (when-let [row (first (filter (fn [row] (and (:generator row) (not (v/gen-domain? (:generator row) (get data (:key row))))))
                                (:fields contract)))]
    {:status :invalid-domain :reason :generator-domain :field (:key row)})
   (catch error {:status :error :reason (ex-message error)}))))
(defn check-result
 "Measure a response and retain generator-specific runtime admission."
 [options contract data]
 (options! options) (definition contract)
 (let [failure (runtime-admission contract data)]
  (if failure (assoc failure :compiler-proof-authority false)
   (response-runtime/check-result contract data))))

(defn check
 "True only for an independently measured valid response. Unknown and execution
  errors throw; they must never become false violation edges."
 [options contract data]
 (let [result (check-result options contract data)]
  (case (:status result) :valid true :invalid false :invalid-domain false
   (throw (ex-info "Concrete response checking is unresolved" {:result result})))))

(defn accept-answer [prepared answer]
 (let [result (response-runtime/accept-answer prepared answer)]
  (if (= :witnessed (:modality result))
   (if-let [failure (runtime-admission (:contract prepared) (:value result))]
    (-> result (dissoc :value :witness) (assoc :modality :candidate :runtime-admission failure)) result) result)))
(defn execute [options prepared]
 (options! options)
 (let [answer (if (:session options) (logic/solve-in (:session options) (:question prepared))
                                   (logic/run options (:question prepared)))]
  (accept-answer (assoc prepared :question (or (:question answer) (:question prepared))) answer)))
(defn synth
 ([options contract] (synth options contract nil))
 ([options contract extra] (execute options (prepare contract (if (nil? extra) {} extra)))))
(defn satisfiable-status
 "Raw native status only. Use synth's modality to require a replayed value."
 [options contract] (:status (synth options contract)))
(defn satisfiable? [options contract]
 (let [result (synth options contract)]
  (case (:modality result) :witnessed true :solver-claim false
   (throw (ex-info "Contract realizability is unresolved" {:result result})))))
(defn synth-invalid [options contract] (synth options contract {:mode :invalid}))
(defn synth-seeded [options contract name seed] (synth options contract {:pins {(field-key name) seed}}))

(defn synth-boundary
 "A global integer boundary search shared by both backends. A feasible response
  is replayed separately from the final unchecked no-better-response claim."
 ([options contract name direction] (synth-boundary options contract name direction {}))
 ([options contract name direction settings]
  (options! options)
  (let [prepared (prepare contract) objective (value/term (field contract name))
        searched (optimize/integer options (:question prepared) objective direction settings)
        feasible (:feasible searched)
        result (when feasible (accept-answer (assoc prepared :question (:question feasible)) (:answer feasible)))
        feasibility (when result (select-keys result [:question :question-identity :answer :runtime-replay :projection-replay :source-connection :value :modality]))
        evidence {:kind :integer-extremum :direction direction :objective objective
                  :feasibility feasibility :search-status (:status searched) :terminal (:terminal searched)}]
   (cond
    (and (= :optimal-claim (:status searched)) (= :witnessed (:modality result)))
     (let [terminal (:terminal searched)]
      (assoc (dissoc result :witness :runtime-replay :projection-replay) :modality :solver-claim :claim-kind :integer-extremum
                    :question (:question terminal) :question-identity (identity/hash (:question terminal)) :answer (:answer terminal)
                    :feasibility :witnessed :optimality :solver-claim :optimization searched :evidence evidence))
    result (assoc result :modality :candidate :claim-kind :integer-extremum :feasibility (:modality result)
                         :optimality :not-established :optimization searched :evidence evidence)
    :else (assoc (accept-answer (assoc prepared :question (or (get-in searched [:terminal :question]) (:question prepared)))
                               (get-in searched [:terminal :answer]))
                 :claim-kind :integer-extremum :optimization searched :optimality :not-established :evidence evidence)))))

(defrecord MockServer [options contract seed-field cache lock capacity context])
(defn make-mock
 "A server retains the first replayed answer for each exact request key.
  Stability is per server instance, not a claim of canonical cross-backend
  model choice. New keys are refused at capacity; old answers are never evicted."
 [options contract seed-field]
 (options! options) (definition contract) (field contract seed-field)
 (let [capacity (get options :capacity 128)]
  (require! (and (int? capacity) (<= 1 capacity 4096)) "mock capacity must be in 1..4096")
  (->MockServer options contract (field-key seed-field) (atom {}) (erlang/make_ref) capacity
                (when (:session options) (logic/context (:session options))))))
(defn answer [server key]
 (global/trans (tuple (:lock server) (erlang/self))
  (fn []
   (let [guard (when (:session (:options server))
                (try (if (= (:context server) (logic/context (:session (:options server)))) :current :changed)
                     (catch _ :expired)))]
   (if (contains? #{:changed :expired} guard)
    {:ok? false :modality :error :reason (if (= :changed guard) :context-changed :context-expired) :compiler-proof-authority false}
   (if-let [cached (get @(:cache server) key)] (assoc cached :reuse :retained-answer)
    (if (>= (count @(:cache server)) (:capacity server))
     {:ok? false :modality :error :reason :mock-capacity :compiler-proof-authority false}
     (let [result (synth-seeded (:options server) (:contract server) (:seed-field server) key)
           result (assoc result :ok? (= :witnessed (:modality result)))]
      (when (:ok? result) (swap! (:cache server) assoc key result))
      result))))))))
