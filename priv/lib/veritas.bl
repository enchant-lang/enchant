; Quantifier tests and structural coverage share typed generator domains,
; complete formal.query values and actual BL witness replay. Native UNSAT
; remains a solver claim. Finite runtime search is exhausted; sampling alone
; establishes neither universal validity nor absence of an existential witness.
; Deprecated SMT helper entry points remain separate from the typed consumers.

(ns veritas
  (:require [z3] [oracle] [core] [env] [smt :as smtlib] [system.smt :as smt] [reader-node :as rn]
            [system.model :as model] [typed] [formal.beam-float :as float] [formal.term :as term] [formal.value :as value] [formal.runtime-values :as rv] [formal.anf-inputs :as formal-inputs]
            [formal.source :as source] [formal.source-runtime :as source-runtime] [formal.query :as query]
            [formal.coverage :as coverage] [formal.logic :as logic] [formal.identity :as identity]
            [formal.response :as response] [formal.response-runtime :as response-runtime] [compiler :as compiler]))

; ═════════════════════════════════════════════════════════════════════════
; GEN — typed generators as records; the Gen protocol dispatches on their type
; ═════════════════════════════════════════════════════════════════════════

(defrecord IntGen [lo hi])       ; a bounded integer — all three engines
(defrecord AnyGen [])            ; the union of all types — sample only (coverage keystone)

(defprotocol Gen
  (gen-sample    [g seed n])     ; → [witnesses]
  (gen-enumerate [g])            ; → finite [values] | :infinite
  (gen-constrain [g var])        ; → {:decls str :assert str} | nil (nil ⇒ not symbolic)
  (gen-tag       [g]))           ; → the type keyword it spans

; ── IntGen ──────────────────────────────────────────────────────────────────

(extend-type IntGen Gen
  (gen-sample [g seed n]
    ; deterministic: endpoints + zero + ±1 always, then a hash-spread interior.
    (let [lo (:lo g) hi (:hi g)
          span (+ 1 (- hi lo))
          edges (filter (fn [v] (and (>= v lo) (<= v hi))) (list lo hi 0 1 -1))
          interior (if (<= span 0) [] (map (fn [i] (+ lo (core/mod (* (+ i seed 1) 2654435761) span))) (range 0 n)))]
      (into [] (distinct (concat edges interior)))))
  (gen-enumerate [g]
    (let [span (+ 1 (- (:hi g) (:lo g)))]
      (if (> span 10000) :infinite
        (into [] (range (:lo g) (+ 1 (:hi g)))))))
  (gen-constrain [g var]
    (let [x (symbol var)]
      {:decls [(smtlib/declare-const x 'Int)]
       :assert [(smtlib/assert `(>= ~x ~(:lo g))) (smtlib/assert `(<= ~x ~(:hi g)))]}))
  (gen-tag [g] :int))

; ── AnyGen : one representative of every type — witnesses type-partiality ───

(extend-type AnyGen Gen
  (gen-sample [g seed n]
    (into [] (list 0 1 -1 (core/mod (* (+ seed 1) 7) 100)
                   1.5 -2.5 "" "hi" :kw true false [1 2] {:a 1} nil)))
  (gen-enumerate [g] :infinite)     ; the type universe is open
  (gen-constrain [g var] nil)        ; no single z3 sort spans all types — sample only
  (gen-tag [g] :any))

; ── RealGen : a bounded real (z3 Real theory) ───────────────────────────────

(defrecord RealGen [lo hi])

(extend-type RealGen Gen
  (gen-sample [g seed n]
    (let [lo (:lo g) hi (:hi g)
          mid (/ (+ lo hi) 2)]
      (into [] (distinct (list lo hi mid
                               (+ lo (* (/ (core/mod (* (+ seed 1) 2654435761) 1000) 1000.0) (- hi lo))))))))
  (gen-enumerate [g] :infinite)                 ; the reals are dense — never finite
  (gen-constrain [g var]
    (let [x (symbol var)]
      {:decls [(smtlib/declare-const x 'Real)]
       :assert [(smtlib/assert `(>= ~x ~(:lo g))) (smtlib/assert `(<= ~x ~(:hi g)))]}))
  (gen-tag [g] :float))

; ── BoolGen : the two booleans (finite ⇒ exhaustive proofs) ─────────────────

(defrecord BoolGen [])

(extend-type BoolGen Gen
  (gen-sample [g seed n] [true false])
  (gen-enumerate [g] [true false])
  (gen-constrain [g var] {:decls [(smtlib/declare-const (symbol var) 'Bool)] :assert []})
  (gen-tag [g] :bool))

; ── OneOf : a finite value set (enumerate = the set; constrain = a disjunction)

(defrecord OneOf [values])

(extend-type OneOf Gen
  (gen-sample [g seed n] (into [] (:values g)))
  (gen-enumerate [g] (into [] (:values g)))
  (gen-constrain [g var]
    ; members of ONE decidable sort translate to a z3 disjunction; a mixed or
    ; compound set declines to sampling. (Keywords are a datatype, not a
    ; scalar — enum-of owns them, datatype decl and all.)
    (cond
      (every? core/int? (:values g))
        (let [x (symbol var)]
          {:decls [(smtlib/declare-const x 'Int)]
           :assert [(smtlib/assert `(or ~@(map (fn [v] `(= ~x ~v)) (:values g))))]})
      (every? core/string? (:values g))
        (let [x (symbol var)]
          {:decls [(smtlib/declare-const x 'String)]
           :assert [(smtlib/assert `(or ~@(map (fn [v] `(= ~x ~v)) (:values g))))]})
      :else nil))
  (gen-tag [g]
    (let [v (core/first (:values g))]
      (cond (core/int? v) :int (string? v) :string (keyword? v) :kw :else :any))))

; ── StringGen : a prefixed, length-bounded string (z3 String theory) ────────

(defrecord StringGen [prefix minlen maxlen])

(extend-type StringGen Gen
  (gen-sample [g seed n]
    (let [p (:prefix g) base (count p) lo (max 0 (- (:minlen g) base)) hi (- (:maxlen g) base)
          pad (fn [k] (core/join "" (repeat k "x")))
          lengths (distinct [lo hi (+ lo (core/mod (+ seed 3) (inc (- hi lo))))])]
     (mapv #(str p (pad %)) lengths)))
  (gen-enumerate [g] :infinite)
  (gen-constrain [g var]
    (let [x (symbol var)]
      {:decls [(smtlib/declare-const x 'String)]
       :assert [(smtlib/assert `(str.prefixof ~(:prefix g) ~x))
                (smtlib/assert `(>= (str.len ~x) ~(:minlen g)))
                (smtlib/assert `(<= (str.len ~x) ~(:maxlen g)))]}))
  (gen-tag [g] :string))

; ── EnumGen : keyword tags as a z3 ALGEBRAIC DATATYPE (the enum theory) ───
;
; Each tag is a constructor of a sort-prefixed datatype (E_<var>-open); a
; payload arm ([:on :int]) adds an accessor + discriminant — exactly the
; datatype support system.smt already speaks (variants-map / datatype-decl).
; The bl value of a tag is the keyword; of a payload arm, {tag 0-ish} — so the
; same predicate evaluates on both rungs. All-nullary enums enumerate finitely
; (exhaustion proves); a payload arm opens the domain (only z3 constrains).

(defrecord EnumGen [tags arms])   ; tags [kw …] in order; arms {tag-str → sort-str | nil}

(defn- enum-value
  "The bl value a tag samples as: the keyword itself (nullary), or a single-key
   map carrying the sort's deterministic zero (payload). Tags are keywords by
   construction (enum-of)."
  [tag sort]
  (if (nil? sort) tag
    {tag (get {"Int" 0 "Real" 0.0 "Bool" true "String" "s"} sort)}))

(extend-type EnumGen Gen
  (gen-sample [g seed n]
    (into [] (map (fn [t] (enum-value t (get (:arms g) t))) (:tags g))))
  (gen-enumerate [g]
    (if (core/some? (core/some (fn [t] (if (core/some? (get (:arms g) t)) true nil)) (:tags g)))
      :infinite
      (into [] (:tags g))))
  (gen-constrain [g var]
    (let [sort (str "E_" var)
          _ (when (some #(String/contains? (str %) "/") (:tags g))
              (throw (ex-info "Legacy enum encoding cannot represent namespaced labels; use typed questions" {})))
          arms (into {} (map (fn [[tag shape]] [(name tag) shape]) (:arms g)))]
      {:decls (vec (concat [(smt/datatype-decl sort arms)]
                           [(smtlib/declare-const (symbol var) (symbol sort))]))
       :assert []
       :smt {:variants (smt/variants-map sort arms)}}))
  (gen-tag [g] :kw))

; ── CollGen : a length-bounded collection — the LENGTH ABSTRACTION theory ──
;
; system.smt's translate-len abstracts a collection var to its length
; (count/conj/rest/pop/empty? → <var>_len arithmetic). This gen binds the bl
; half: a real vector whose length honours the bounds, elements the
; deterministic (range 0 len). Elements are open ⇒ never finite; a content
; predicate (includes? …) stays untranslatable and falls to sampling — honest,
; as always.

(defrecord CollGen [minlen maxlen])

(extend-type CollGen Gen
  (gen-sample [g seed n]
    (let [lens (into [] (distinct (filter (fn [l] (and (>= l (:minlen g)) (<= l (:maxlen g))))
                                          (list (:minlen g) (:maxlen g) 1 0
                                                (core/quot (+ (:minlen g) (:maxlen g)) 2)
                                                (core/mod (* (+ seed 1) 7) (+ 1 (:maxlen g)))))))]
      (into [] (map (fn [l] (into [] (range 0 l))) lens))))
  (gen-enumerate [g] :infinite)
  (gen-constrain [g var]
    (let [len (symbol (str var "_len"))]
      {:decls [(smtlib/declare-const len 'Int)]
       :assert [(smtlib/assert `(>= ~len ~(:minlen g)))
                (smtlib/assert `(<= ~len ~(:maxlen g)))]
       :smt {:colls #{var}}}))
  (gen-tag [g] :vec))

; ── TupleGen : a fixed-arity product of generators (multi-var queries) ───────
;
; A tuple candidate is a VECTOR of one sample per child. constrain conjoins the
; children's decls/asserts under positional variable names <var>_0, <var>_1 … so
; a joint ∀/∃ over (a b) becomes one z3 query. Only symbolic when EVERY child is.

(defrecord TupleGen [gens])

(defn- cartesian [colls limit]
  (reduce (fn [acc c] (into [] (take limit (mapcat (fn [row] (map (fn [x] (conj row x)) c)) acc))))
          [[]] colls))

(extend-type TupleGen Gen
  (gen-sample [g seed n]
    (let [per (map (fn [gg] (gen-sample gg seed (min 64 n))) (:gens g))]
      (cartesian per 64)))
  (gen-enumerate [g]
    (let [es (map (fn [gg] (gen-enumerate gg)) (:gens g))]
      (if (or (some #(= % :infinite) es)
              (> (reduce (fn [n xs] (if (> n 10000) n (* n (count xs)))) 1 es) 10000))
        :infinite
        (cartesian es 10000))))
  (gen-constrain [g var]
    (let [cons (map-indexed (fn [i gg] (gen-constrain gg (str var "_" i))) (:gens g))]
      (if (core/some? (core/some (fn [c] (if (nil? c) true nil)) cons))
        nil
        ; decls/asserts are FORM COMMAND vectors now: concatenate, don't join
        {:decls (vec (mapcat :decls cons))
         :assert (vec (mapcat :assert cons))
         ; the children's translator opts, merged: enum datatypes across
         ; children share one query; a collection child adds its length
         ; abstraction. Keys appear only when non-empty, so a plain scalar
         ; tuple still routes through the full translator.
         :smt (let [vs (reduce (fn [acc c] (let [m (:variants (:smt c))] (if (nil? m) acc (core/merge acc m)))) {} (into [] cons))
                    cs (reduce (fn [acc c] (let [m (:colls (:smt c))] (if (nil? m) acc (into acc m)))) #{} (into [] cons))]
                (into {} (concat (if (empty? vs) [] [[:variants vs]])
                                 (if (empty? cs) [] [[:colls cs]]))))})))
  (gen-tag [g] :tuple))

; Typed domains are independent of gen-constrain's legacy SMT commands.
; A backend receives these exact values through formal.query. Returning nil
; declines a runtime profile; it never substitutes an unrelated solver sort.
(defprotocol GenTerms (gen-term [g name]))
(extend-type IntGen GenTerms
 (gen-term [g name]
  (when (and (int? (:lo g)) (int? (:hi g)))
   (let [x (term/variable name term/Int)]
    (value/make x {:constraints [(term/ge x (term/int (:lo g))) (term/le x (term/int (:hi g)))]
                   :domain {:kind :scalar :profile :bl/bounded-integer-generator-v1}})))))
(extend-type BoolGen GenTerms
 (gen-term [g name] (value/lift (term/variable name term/Bool))))
(extend-type OneOf GenTerms
 (gen-term [g name]
  (let [xs (:values g)
        sort (cond (every? int? xs) term/Int
                   (every? #(or (= true %) (= false %)) xs) term/Bool
                   (every? string? xs) term/String :else nil)]
   (if (and (seq xs) (every? float? xs))
    (let [model (float/variable name) x (value/term model)]
     (assoc model :constraints [(term/any (mapv #(term/eq x (value/term (float/literal %))) xs))]))
    (when sort
     (let [x (term/variable name sort)]
      (value/make x {:constraints [(term/any (mapv #(term/eq x (term/literal sort %)) xs))]
                     :domain {:kind :scalar :profile :bl/finite-scalar-generator-v1}})))))))
(extend-type AnyGen GenTerms (gen-term [g name] nil))
(extend-type RealGen GenTerms (gen-term [g name] nil))
(extend-type StringGen GenTerms (gen-term [g name] nil))
(extend-type EnumGen GenTerms
 (gen-term [g name]
  (when-not (some #(= "Real" %) (vals (:arms g)))
   (rv/enum-value name (:tags g) (into {} (map (fn [[tag sort]] [tag (get {"Int" term/Int "Bool" term/Bool "String" term/String} sort)]) (:arms g)))))))
(extend-type CollGen GenTerms (gen-term [g name] (rv/length-domain name (:minlen g) (:maxlen g))))
(extend-type TupleGen GenTerms
 (gen-term [g name]
  (let [items (mapv (fn [i] (gen-term (nth (:gens g) i) (str name "/" i))) (range (count (:gens g))))]
   (when (every? some? items) (rv/product items)))))

; ── the public gen constructors ─────────────────────────────────────────────

(defn int-of    [lo hi] (->IntGen lo hi))
(defn real-of   [lo hi] (->RealGen lo hi))
(defn bool-of   [] (->BoolGen))
(defn one-of    [& values] (->OneOf (into [] values)))
(defn string-of [prefix minlen maxlen]
 (when-not (and (string? prefix) (String/valid? prefix) (int? minlen) (int? maxlen)
                (<= 0 minlen maxlen) (<= (count prefix) maxlen))
  (throw (ex-info "String domains require valid text and possible total grapheme bounds" {})))
 (->StringGen prefix minlen maxlen))
(defrecord TextGen [prefix])
(extend-type TextGen Gen
 (gen-sample [g seed n] [(:prefix g) (str (:prefix g) "x") (str (:prefix g) "é")])
 (gen-enumerate [g] :infinite)
 (gen-constrain [g name] nil)
 (gen-tag [g] :string))
(extend-type TextGen GenTerms
 (gen-term [g name]
  (let [x (term/variable name term/String)]
   (value/make x {:constraints [(term/app :str-prefix term/Bool [(term/text (:prefix g)) x] nil)]
                  :scope {:mode :abstract :model :solver-text :runtime-domain :valid-utf8-prefix}
                  :domain {:kind :scalar :profile :bl/valid-utf8-prefix-v1}}))))
(defn text-of [prefix]
 (when-not (and (string? prefix) (String/valid? prefix)) (throw (ex-info "Text prefix must be valid UTF-8" {})))
 (->TextGen prefix))
(defn enum-of [& specs]
 (let [tag (fn [s] (if (vector? s) (first s) s)) tags (mapv tag specs)]
  (when-not (and (<= (count tags) 256) (every? keyword? tags) (= (count tags) (count (set tags)))
                 (every? (fn [s] (or (keyword? s) (and (vector? s) (= 2 (count s)) (contains? #{:int :float :bool :string} (second s))))) specs))
   (throw (ex-info "Enum constructors require distinct complete keyword identities and reviewed payload sorts" {})))
  (->EnumGen tags (into {} (map (fn [s] [(tag s) (when (vector? s) (get {:int "Int" :float "Real" :bool "Bool" :string "String"} (second s)))]) specs)))))

(defn coll-of
  "A length-bounded collection (a bl vector): the length abstraction's gen.
   Symbolic rung: <var>_len arithmetic — count/conj/rest/pop/empty? over the
   var translate. bl rung: real vectors, elements (range 0 len), lengths drawn
   deterministically from the bounds. Elements are open ⇒ never finite; a
   content predicate falls to sampling."
  [minlen maxlen]
 (when-not (and (int? minlen) (int? maxlen) (<= 0 minlen maxlen)) (throw (ex-info "Collection lengths require an ordered nonnegative integer range" {})))
 (->CollGen minlen maxlen))

(defn tuple-of  [& gens] (->TupleGen (into [] gens)))
(defn any-of    [] (->AnyGen))

(defn samples
  "The concrete values a generator offers as a test domain: its finite enumeration
   when it has one, else a deterministic sample of `n`. Public so consumers
   (veritas.property) draw their fuzz domain from the SAME generator algebra the
   check escalator uses — one domain notion, not a parallel one."
  [gen n]
  (let [enum (gen-enumerate gen)]
    (if (= enum :infinite) (gen-sample gen 0 n) enum)))

; ═════════════════════════════════════════════════════════════════════════
; SPEC — a predicate over the bound value, as a self-contained lambda
; ═════════════════════════════════════════════════════════════════════════

(defn- lit [x] (str "(quote " (core/pr-str x) ")"))

(defn- positional-lets
  "When `v` is a vector, `let` bindings that name each coordinate <var>_i — the
   SAME positional names TupleGen/gen-constrain declares to z3. So a predicate
   written for the symbolic rung (p_0, p_1, …) also evaluates on the bl fallback,
   symmetric across both evaluators. A scalar value yields no bindings."
  [var v]
  (if (vector? v)
    (core/join " "
      (core/map-indexed (fn [i x] (str var "_" i " " (lit x))) v))
    ""))

(defn holds?
  "Does spec `pred` (a quoted bl form over the one variable `var`) hold for `v`?
   Evaluated as (let [var v  var_0 v0 …] pred) — self-contained, no scope leak.
   For a vector `v` the coordinates also bind as <var>_i so a positional
   predicate (p_0, p_1) evaluates on the fallback exactly as it does in z3. A
   predicate that RAISES counts as NOT holding (a property that errors failed)."
  [var pred v]
  (try
    (= true (env/eval (str "(let [" var " " (lit v) " " (positional-lets var v) "] " (pr-str (pred-form pred)) ")")))
    (catch _ false)))

; ── z3 model parsing: a SAT model IS the value (was mock/parse-model) ────────
;
; z3 answers a SAT query with `((define-fun name () Sort VALUE) …)`. VALUE is a
; scalar (16, true, "usr_"), a negative `(- 39)`, or a rational `(/ 1.0 2.0)`.
; Read the model with the bl reader (it is valid s-expression text) and project
; each define-fun to [name value]. veritas owns this now — the last thing it
; needed from mock.bl, so the dependency is severed and mock/fuzz/fault stand
; alone (zero consumers, superseded by this file).

(defn- model-value
  "The bl value of a define-fun's VALUE node: a bare scalar, (- n) → -n, or
   (/ a b) → a÷b (z3 renders a Real as an exact rational)."
  [vnode]
  (let [f (typed/node-form vnode)
        tg (typed/node-tag f)]
    (cond
      (= tg :scalar) f
      (= tg :list)
        (let [its (typed/node-items f)
              op (if (empty? its) nil (typed/node-name (typed/node-form (first its))))]
          (cond
            (and (= op "-") (= 2 (count its)))
              (- 0 (model-value (second its)))
            (and (= op "/") (= 3 (count its)))
              (/ (model-value (second its)) (model-value (nth its 2)))
            :else f))
      :else f)))

(defn parse-model
  "A z3 model TEXT → {field-name-string → bl value}. The model is `(…defs…)`;
   each def is (define-fun NAME () SORT VALUE). nil/empty text → {}."
  [model-text]
  (if (or (nil? model-text) (= "" model-text))
    {}
    (let [top (first (BeamLisp.Reader/read_string model-text))
          defs (typed/node-items top)]
      (into {}
        (keep (fn [d]
                (let [its (typed/node-items d)]
                  (if (and (>= (count its) 5)
                           (= "define-fun" (typed/node-name (typed/node-form (first its)))))
                    [(typed/node-name (typed/node-form (second its)))
                     (model-value (nth its 4))]
                    nil)))
              defs)))))

; ── witness projection: a z3 model value IS a bl value of the domain ───────
;
; z3 renders enum constructors as E_<var>-<tag> symbols (nullary) or
; (E_<var>-<tag> payload) lists, and a length-abstracted collection as its
; <var>_len. A verdict's :witness must be a REAL bl value — a tag keyword, a
; {tag payload} map, a vector of the modelled length — symmetrical with
; holds?, not a raw SMT term the caller cannot use.

(defn- enum-project
  "A z3 model NODE for an enum const → its bl value: strip the E_<var>-
   prefix, keyword the tag, project the payload. A plain scalar node unwraps
   to itself."
  [var node]
  (let [prefix (str "E_" var "-")
        tg (typed/node-tag node)]
    (cond
      (= tg :symbol)
        (let [nm (typed/node-name node)]
          (if (starts-with? nm prefix) (keyword (subs nm (count prefix))) nm))
      (= tg :list)
        (let [its (typed/node-items node)
              head (typed/node-form (core/first its))]
          (if (and (pos? (count its)) (starts-with? (typed/node-name head) prefix))
            {(keyword (subs (typed/node-name head) (count prefix)))
             (enum-project var (typed/node-form (core/first (rest its))))}
            node))
      :else (typed/node-form node))))

(defn- witness-key
  "The model key a gen's const appears under: the var itself, or <var>_len for
   a length-abstracted collection."
  [g var]
  (if (= :vec (gen-tag g)) (str var "_len") var))

(defn- project-witness
  "A z3 model value → a bl value in the gen's domain, so a :refuted/:exists
   witness reads like a sampled value. Enums project ctors; collections
   rebuild a vector of the modelled length (only the length is meaningful)."
  [g var raw]
  (cond
    (= :kw (gen-tag g)) (enum-project var raw)
    (and (= :vec (gen-tag g)) (core/int? raw)) (into [] (range 0 raw))
    :else raw))

; ── z3 fragment: delegate to system.smt, the verifier's OWN translator ──────
;
; smt-of reuses system.smt — the SAME source→SMT translator verify-process
; uses — so veritas and the verifier can NEVER disagree about what a predicate
; means, and veritas inherits every theory system.smt has: Int, Real, Bool,
; String, the enum datatypes (variants threaded — EnumGen's datatype decl and
; ctor map), the collection length abstraction (CollGen), and the unary
; desugarings. `vars` is the set of bound variable names (one for a scalar
; query, the positional names for a tuple). :untranslatable ⟹ nil ⟹ the
; escalator falls back to enumerate/sample (honest).

(defn pred-form
  "The authoring contract, enforced: a predicate is a QUOTED bl form, never a
   source string (the blueprint.constraint rule). The form is walkable and
   composable as data; Source compilation accepts the form as data; backend questions remain terms. A string here
   is a migration bug — throw, don't guess."
  [form]
  (if (string? form)
    (throw (str "veritas: predicates are quoted bl forms, not source strings — got " (pr-str form)))
    form))

(defn as-term
  "A TERM as a form: a legacy SMT TEXT predicate is READ once here, at the
   boundary (`smt/read-term`); a form passes through; nil stays nil. The wire
   sibling of `pred-form` (which guards the AUTHORING surface — quoted forms,
   never source strings). Malformed text THROWS, naming it, instead of reaching
   z3 as an inert literal."
  [t]
  (if (string? t) (smtlib/read-term t) t))

(defn smt-of [vars form]
  (let [r (smt/of-source (core/set vars) (pr-str (pred-form form)))]
    (if (or (nil? r) (= r :untranslatable)) nil r)))

(defn- smt-of-opts
  "smt-of with the gen's translator opts: :variants threads the enum
   datatypes, :colls the length abstraction. BOTH at once → nil — no single
   translator pass speaks variants and lengths together (a TupleGen mixing
   them falls to enumerate/sample, honestly)."
  [vars form opts]
  (let [src (pr-str (pred-form form))
        vs (:variants opts)
        cs (:colls opts)]
    (cond
      (and (core/some? vs) (core/some? cs)) nil
      (core/some? vs)
        (let [r (smt/of-source-variants (core/set vars) vs src)]
          (if (= r :untranslatable) nil r))
      (core/some? cs)
        (let [r (smt/of-source-len (core/set vars) cs src)]
          (if (= r :untranslatable) nil r))
      :else (smt-of vars form))))

; ═════════════════════════════════════════════════════════════════════════
; SHRINK — the minimal witness, still inside its generator's domain
; ═════════════════════════════════════════════════════════════════════════

; Shrinking is VALUE-directed: a counterexample is a plain bl value, and
; "simpler" is a property of the value's shape. That keeps ONE ladder for every
; caller — the quantifier core, veritas.property, and veritas.model (whose
; witness is a history: a vector of commands). Every candidate is STRICTLY
; simpler (smaller magnitude, shorter, fewer keys), so a shrink loop always
; terminates even without its fuel bound.
;
; A verdict's :witness, though, comes from the caller's GENERATOR, and a shrunk
; value that left the domain is no longer a counterexample of the supplied
; query — the review saw `(one-of 1 31 32 33)` refute with witness 1 and report
; `:shrunk 0`. So `shrink-in-domain` walks the ladder FILTERED through the
; generator's domain (GenShrink below); the plain `shrink` / `shrink-coords`
; stay for callers that hold no generator (veritas.model), and veritas.property
; — which does hold one — walks `shrink-in-domain` too.

(defn- smaller-int [v]
  (into [] (distinct (filter (fn [c] (< (core/abs c) (core/abs v)))
                             (list 0 (core/quot v 2) (if (> v 0) (- v 1) (+ v 1)))))))

(declare shrink-candidates)

(defn- drop-at [v i] (into (subvec v 0 i) (subvec v (+ i 1))))

(defn- smaller-vec
  "Shorter vectors first (empty, first half, second half, each one removed),
   then each element shrunk in place."
  [v]
  (let [n (count v)
        halves (if (> n 1) [(subvec v 0 (core/quot n 2)) (subvec v (core/quot n 2))] [])
        drops (map (fn [i] (drop-at v i)) (range 0 n))
        inner (mapcat (fn [i] (map (fn [s] (assoc v i s)) (shrink-candidates (nth v i))))
                      (range 0 n))]
    (into [] (concat (if (> n 0) [[]] []) halves drops inner))))

(defn shrink-candidates
  "Strictly simpler values than `v`, simplest first: an int walks toward 0, a
   string toward shorter prefixes, a vector toward fewer then simpler elements,
   a map toward fewer then simpler values, a keyword/bool/nil not at all.
   Public so every veritas layer shrinks the same way. Generator-BLIND: the
   domain filter lives in GenShrink/shrink-in-domain, not here."
  [v]
  (cond
    (core/int? v) (smaller-int v)
    (string? v) (if (= "" v) []
                  (into [] (distinct ["" (subs v 0 (core/quot (count v) 2)) (subs v 0 (- (count v) 1))])))
    (vector? v) (smaller-vec v)
    (map? v) (let [ks (into [] (keys v))]
               (into [] (concat (map (fn [k] (dissoc v k)) ks)
                                (mapcat (fn [k] (map (fn [s] (assoc v k s)) (shrink-candidates (get v k)))) ks))))
    :else []))

(defn shrink
  "Walk a failing `v` to a LOCAL MINIMUM: repeatedly take the first strictly
   simpler candidate that still satisfies `fail?`, until none does. `fuel`
   bounds the number of accepted steps (default 500). Generator-blind — see
   `shrink-in-domain` for the domain-preserving walk."
  ([fail? v] (shrink fail? v 500))
  ([fail? v fuel]
   (loop [best v fuel fuel]
     (if (<= fuel 0) best
       (let [next (core/some (fn [c] (if (fail? c) [c] nil)) (shrink-candidates best))]
         (if (nil? next) best (recur (core/first next) (- fuel 1))))))))

(defn shrink-coords
  "Shrink a TUPLE `v` coordinate-wise, keeping its arity — a tuple witness is a
   point in a product domain, and dropping a coordinate would leave the domain.
   Generator-BLIND (it holds no generator): a caller that DOES hold one should
   shrink with `shrink-in-domain`, whose candidates are the generator's own
   (GenShrink), so a tuple witness can never walk outside a child's domain."
  [fail? v]
  (loop [best v fuel 200]
    (if (<= fuel 0) best
      (let [cands (mapcat (fn [i] (map (fn [s] (assoc best i s)) (shrink-candidates (nth best i))))
                          (range 0 (count best)))
            next (core/some (fn [c] (if (fail? c) [c] nil)) cands)]
        (if (nil? next) best (recur (core/first next) (- fuel 1)))))))

; ── the generator's domain: a shrink may not leave it ────────────────────
;
; GenShrink is the OPTIONAL second half of a generator: which values its domain
; admits (`gen-domain?`) and which strictly simpler values stay inside it
; (`gen-shrink`). Each rung implements it beside its Gen half. Strictly-simpler
; candidates only — that is what lets the walk terminate without its fuel bound.
; A Gen with no GenShrink (a caller's own record) retains its original witness:
; no candidate is known to belong to its domain, so generic shrinking is unsafe.

(defprotocol GenShrink
  (gen-domain? [g v])   ; could this generator have produced v?
  (gen-shrink  [g v]))  ; strictly simpler in-domain values, simplest first

(defn- value-size
  "A coarse size of a plain value — magnitude/length — for `one-of` members,
   where the generic ladder has no in-domain recipe. Equal sizes never shrink,
   so a walk over it terminates."
  [v]
  (cond
    (core/int? v) (core/abs v)
    (float? v)    (core/abs v)
    (string? v)   (count v)
    (vector? v)   (count v)
    (map? v)      (count v)
    :else 0))

(defn- sized-smaller? [c v] (< (value-size c) (value-size v)))

(defn- in-domain?
  "Is `v` a value `gen` could produce? A generator that declares no GenShrink
   admits everything."
  [gen v]
  (if (satisfies? GenShrink gen) (gen-domain? gen v) true))

(defn- gen-candidates
  "Strictly simpler values of `v` that stay in `gen`'s domain. An unknown
   generator's witness is retained rather than shrunk outside its domain."
  [gen v]
  (if (satisfies? GenShrink gen) (gen-shrink gen v) []))

(defn- domain-filter [g v] (filter (fn [c] (in-domain? g c)) (shrink-candidates v)))

(extend-type IntGen GenShrink
  (gen-domain? [g v] (and (core/int? v) (>= v (:lo g)) (<= v (:hi g))))
  (gen-shrink [g v] (into [] (distinct (domain-filter g v)))))

(extend-type RealGen GenShrink
  (gen-domain? [g v] (and (number? v) (>= v (:lo g)) (<= v (:hi g))))
  (gen-shrink [g v]
    (into [] (distinct (filter (fn [c] (and (in-domain? g c) (sized-smaller? c v)))
                               (list 0.0 (:lo g) (/ v 2)))))))

(extend-type BoolGen GenShrink
  (gen-domain? [g v] (or (= true v) (= false v)))
  (gen-shrink [g v] []))

(extend-type AnyGen GenShrink
  (gen-domain? [g v] true)
  (gen-shrink [g v] (shrink-candidates v)))

(extend-type OneOf GenShrink
  (gen-domain? [g v]
    (boolean (core/some (fn [x]
      (cond
       (float? x) (and (float? v) (= (float/runtime-data x) (float/runtime-data v)))
       (core/int? x) (and (core/int? v) (= x v))
       :else (= x v))) (:values g))))
  (gen-shrink [g v]
    (into [] (distinct (filter (fn [c] (and (in-domain? g c) (sized-smaller? c v)))
                               (:values g))))))

(extend-type StringGen GenShrink
  (gen-domain? [g v] (and (string? v)
                          (starts-with? v (:prefix g))
                          (>= (count v) (:minlen g))
                          (<= (count v) (:maxlen g))))
  (gen-shrink [g v] (into [] (distinct (domain-filter g v)))))

(extend-type TextGen GenShrink
 (gen-domain? [g x] (and (string? x) (String/valid? x) (String/starts_with? x (:prefix g))))
 (gen-shrink [g x] (into [] (filter #(in-domain? g %) (shrink-candidates x)))))
(extend-type EnumGen GenShrink
 (gen-domain? [g x]
  (cond
   (keyword? x) (and (contains? (:arms g) x) (nil? (get (:arms g) x)))
   (and (map? x) (= 1 (count x)))
    (let [tag (first (keys x)) shape (get (:arms g) tag) payload (get x tag)]
     (and (contains? (:arms g) tag)
          (case shape "Int" (int? payload) "Real" (float? payload) "Bool" (or (= true payload) (= false payload))
                      "String" (and (string? payload) (String/valid? payload)) false)))
   :else false))
 (gen-shrink [g x] (into [] (filter #(and (in-domain? g %) (sized-smaller? % x)) (shrink-candidates x)))))

(extend-type CollGen GenShrink
  (gen-domain? [g v] (and (vector? v) (>= (count v) (:minlen g)) (<= (count v) (:maxlen g))))
  (gen-shrink [g v] (into [] (distinct (domain-filter g v)))))

(extend-type TupleGen GenShrink
  (gen-domain? [g v]
    (let [gs (:gens g) n (count gs)]
      (and (vector? v) (= (count v) n)
           (not (core/some (fn [i] (if (in-domain? (nth gs i) (nth v i)) nil true))
                           (range 0 n))))))
  (gen-shrink [g v]
    (let [gs (:gens g)]
      (into [] (mapcat (fn [i] (map (fn [s] (assoc v i s))
                                    (gen-candidates (nth gs i) (nth v i))))
                       (range 0 (count v)))))))

(defn shrink-in-domain
  "Shrink a failing witness `v` inside `gen`'s domain to a local minimum:
   accept the first candidate that STILL fails, until none does. Every accepted
   step is in-domain (gen-shrink) and violating (fail?), so the result is a
   genuine minimal counterexample of the supplied query. Public so a consumer
   that holds a generator (veritas.property) shrinks with the SAME domain-aware
   candidates the quantifier core uses — not a second, generator-blind ladder.
   An unknown generator (no GenShrink) offers no in-domain candidates, so its
   witness is retained unchanged."
  [gen fail? v]
  (loop [best v fuel 200]
    (if (<= fuel 0) best
      (let [next (core/some (fn [c] (if (fail? c) [c] nil)) (gen-candidates gen best))]
        (if (nil? next) best (recur (core/first next) (- fuel 1)))))))

; ═════════════════════════════════════════════════════════════════════════
; CHECK — one verb, modal verdict, engine escalator
; ═════════════════════════════════════════════════════════════════════════
;
; A query is {:q :exists|:for-all :var str :gen g :pred form} — the pred is a
; QUOTED bl form over var (blueprint.constraint's rule: no strings-as-constraints).
; check runs the strongest engine the (gen, pred) pair supports.

(defn- predicate-source [var pred arity]
 ;; Validate the binder separately, then pass the code datum directly to the
 ;; compiler. Runtime values and source literals never cross a printer/reader.
 (formal-inputs/prepare "formal.source.intrinsics" {var (term/int 0)})
 (let [parameter (symbol var) body (pred-form pred)
       body (if arity
              (list 'let (vec (mapcat (fn [i] [(symbol (str var "_" i)) (list 'core/nth parameter i)]) (range arity))) body)
              body)]
  (list 'fn [parameter] body)))

(defn prepare
 "Prepare one complete quantifier question without running its predicate.
  Runtime domains, source translation and backend support are separate facts."
 [request]
 (try
  (when-not (contains? #{:exists :for-all} (:q request)) (throw (ex-info "Expected exists or for-all" {})))
  (let [g (:gen request) var (:var request)
        input (or (gen-term g "veritas/input") (throw (ex-info "Generator has no reviewed term domain" {})))
        compiled (source/prepare-function (predicate-source var (:pred request) (when (= :tuple (gen-tag g)) (count (:gens g)))) [input])
        _ (when-not (= :translated (:status compiled)) (throw (ex-info (:reason compiled) {})))
        property (:value compiled)
        _ (when-not (= term/Bool (term/sort-of (value/term property))) (throw (ex-info "A property must return Bool" {})))
        options {:id :veritas/quantifier :inputs [input] :observe {"input" input "predicate" property}
                 :profile :bl/veritas-quantifier-v1 :origin {:variable var :predicate (pr-str (pred-form (:pred request))) :basis :compiler-anf}}
        problem (if (= :for-all (:q request)) (query/prove property options)
                  (query/sat (assoc options :inputs [input property] :assumptions [(value/term property)])))]
   {:status :translated :problem problem :question-identity (identity/hash problem) :input input
    :predicate compiled :request request :source-connection {:status :reviewed :basis :compiler-anf :metatheory :not-mechanized}
    :compiler-proof-authority false})
  (catch error {:status :unsupported :reason (ex-message error) :compiler-proof-authority false})))

(defn- replay-witness [prepared answer]
 (let [observed (get-in answer [:witness "input"])
       candidate (when (and (= true (:defined observed)) (= true (:within observed)))
                  (rv/concrete (:input prepared) (:value observed)))
       g (get-in prepared [:request :gen]) witness (:value candidate)]
  (if-not (and candidate (satisfies? GenShrink g) (gen-domain? g witness))
   {:status :unavailable :reason :input-observation-or-domain}
   (let [actual (source-runtime/run (get-in prepared [:predicate :anf]) [witness])
         predicted (get-in answer [:witness "predicate"])
         matched (and (= false (:module-loaded actual))
                      (or (and (= :raised (:status actual)) (= false (:defined predicted)))
                          (and (= :returned (:status actual)) (= true (:defined predicted)) (= (:value actual) (:value predicted)))))
         holds (= true (:value actual))
         expected (if (= :exists (get-in prepared [:request :q])) holds (not holds))]
    {:status (if (and matched expected) :reproduced :mismatch) :witness witness :predicate actual
     :projection (:projection candidate) :matches-term-model matched :holds holds}))))

(defn- solve-prepared [options prepared]
 (let [answer (if (:session options) (logic/solve-in (:session options) (:problem prepared)) (logic/run options (:problem prepared)))
       exists? (= :exists (get-in prepared [:request :q]))
       replay (when (contains? #{:sat :refuted} (:verdict answer)) (replay-witness prepared answer))
       modality (case (:verdict answer)
                  :proved :solver-claim :unsat :solver-claim
                  :sat (if (= :reproduced (:status replay)) :witnessed :candidate)
                  :refuted (if (= :reproduced (:status replay)) :refuted :candidate)
                  :vacuous :vacuous :unsupported :unsupported :error :error :candidate :candidate :unknown)
       base {:modality modality :engine :terms :question (:problem prepared) :answer answer
             :question-identity (:question-identity prepared) :runtime-replay replay
             :source-connection (:source-connection prepared) :compiler-proof-authority false
             :why (str "typed question answered " (name (:verdict answer)))}]
  (cond
   (= :reproduced (:status replay)) (assoc base :witness (:witness replay))
   (and exists? (= :unsat (:verdict answer))) (assoc base :none true :complete true)
   :else base)))

(defn- run-sample [request seed n enumerate?]
 (let [g (:gen request) var (:var request) pred (pred-form (:pred request))
       ;; Validate even an empty domain, before evaluating source.
       _ (formal-inputs/prepare "formal.source.intrinsics" {var (term/int 0)})
       enumeration (when enumerate? (gen-enumerate g))
       finite? (and enumerate? (not= enumeration :infinite))
       _ (when (and enumerate? (not finite?)) (throw (ex-info "Generator cannot be exhaustively enumerated within its limit" {})))
       values (if finite? enumeration (gen-sample g seed n))
       forall? (= :for-all (:q request))
       found (core/some (fn [x] (when (= forall? (not (holds? var pred x))) [x])) values)
       engine (if finite? :enumerate :sample)
       base {:engine engine :seed seed :tried (count values) :complete finite? :compiler-proof-authority false}]
  (cond
   found (let [witness (first found)]
          (merge base {:modality (if forall? :refuted :witnessed) :witness witness}
           (when forall? {:shrunk (shrink-in-domain g #(not (holds? var pred %)) witness)})))
   (and finite? forall? (empty? values)) (assoc base :modality :vacuous)
   finite? (merge base {:modality :exhausted} (when-not forall? {:none true}))
   forall? (assoc base :modality :witnessed)
   :else (assoc base :modality :unknown :search-exhausted false))))

(defn check
 "Check {:q :exists|:for-all :var name :gen generator :pred quoted-form}.
  Options select :backend and :engine (:auto, :terms, :enumerate, :sample).
  Auto tries reviewed terms, then actual finite enumeration or sampling.
  Native UNSAT is a solver claim. Only replayed runtime values are witnesses.
  A sample that finds nothing establishes no absence."
 ([options request] (check options request {}))
 ([options request settings]
  (when-not (and (map? options) (map? settings)) (throw (ex-info "Veritas needs an options map, not a legacy solver handle" {})))
  (let [options (merge options settings) engine (get options :engine :auto)
        _ (when-not (contains? #{:auto :terms :enumerate :sample} engine) (throw (ex-info "Unknown Veritas engine" {})))
        _ (when-not (contains? #{:exists :for-all} (:q request)) (throw (ex-info "Unknown quantifier" {})))
        _ (pred-form (:pred request))
        seed (get options :seed 0) n (get options :n 32)
        _ (when-not (and (int? seed) (int? n) (<= 0 n 4096)) (throw (ex-info "Sample count must be in 0..4096 and seed an integer" {})))
        prepared (when (contains? #{:auto :terms} engine) (prepare request))]
   (if (= :translated (:status prepared)) (solve-prepared options prepared)
    (if (= :terms engine) {:modality :unsupported :engine :terms :reason (:reason prepared) :compiler-proof-authority false}
     (let [finite? (not= :infinite (gen-enumerate (:gen request)))
           enumerate? (or (= :enumerate engine) (and (= :auto engine) finite?))
           result (run-sample request seed n enumerate?)]
      (assoc result :symbolic prepared
       :why (str (if enumerate? "exhausted a finite domain" (str "sampled with seed " seed))
              (when prepared (str "; symbolic declined: " (:reason prepared)))))))))))
(defn exists
 ([options var gen pred] (exists options var gen pred {}))
 ([options var gen pred settings] (check options {:q :exists :var var :gen gen :pred pred} settings)))
(defn for-all
 ([options var gen pred] (for-all options var gen pred {}))
 ([options var gen pred settings] (check options {:q :for-all :var var :gen gen :pred pred} settings)))

; ═════════════════════════════════════════════════════════════════════════
; COVERS — the third quantifier: does every input land in a clause?
; ═════════════════════════════════════════════════════════════════════════
;
; ∀ input ∈ gen, ∃ clause of `fn-src` whose guard accepts input. This is the
; COVERAGE property from priv/fuzz.bl, now a veritas query: the "spec" is read
; from the function's OWN guard clauses (system.model), so no property is
; written. Finite execution is :exhausted; sampling is :witnessed. A gap is a :refuted with the uncovered witness.

(defn covers
 "Check compiler clause selection. Bodies are not compiled or executed.
  Auto uses reviewed guard terms, then actual selection on finite or sampled
  values. Runtime compilation errors never count as uncovered inputs."
 [options fn-src gen]
 (when-not (map? options) (throw (ex-info "Coverage requires an options map" {})))
 (let [engine (get options :engine :auto)
       _ (when-not (contains? #{:auto :terms :enumerate :sample} engine) (throw (ex-info "Unknown coverage engine" {})))
       input (try (gen-term gen "veritas/input") (catch _ nil))
       placeholder (if (= :tuple (gen-tag gen)) (rv/product (mapv (fn [i] (term/variable (str "coverage/unmodeled/" i) term/Int)) (range (count (:gens gen)))))
                     (value/lift (term/variable "coverage/unmodeled" term/Int)))
       prepared (coverage/prepare fn-src (or input placeholder) (and input (contains? #{:auto :terms} engine)))]
  (cond
   (= :translated (:status prepared)) (solve-prepared options (assoc prepared :request {:q :for-all :gen gen}))
   (or (= :unsupported (:status prepared)) (= :terms engine))
    {:modality :unsupported :engine :terms :reason (:reason prepared) :preparation prepared :compiler-proof-authority false}
   :else
    (let [enum (gen-enumerate gen) finite? (and (not= :sample engine) (not= :infinite enum))
          _ (when (and (= :enumerate engine) (not finite?)) (throw (ex-info "Coverage domain cannot be enumerated within its limit" {})))
          seed (get options :seed 0) n (get options :n 32)
          _ (when-not (and (int? seed) (int? n) (<= 0 n 4096)) (throw (ex-info "Invalid coverage sampling settings" {})))
          values (if finite? enum (gen-sample gen seed n))
          base {:engine (if finite? :enumerate :sample) :complete finite? :seed seed :source-connection (:source-connection prepared)
                :arity (:arity prepared) :symbolic (select-keys prepared [:status :reason]) :compiler-proof-authority false}]
     (loop [remaining (seq values) tried 0]
      (if-not remaining
       (assoc base :modality (cond (and finite? (= 0 tried)) :vacuous finite? :exhausted :else :witnessed) :tried tried)
       (let [witness (first remaining) actual (source-runtime/run (get-in prepared [:predicate :anf]) [witness])]
        (cond
         (or (not= :returned (:status actual)) (:module-loaded actual)) (assoc base :modality :error :runtime actual :tried tried)
         (not= true (:value actual)) (assoc base :modality :refuted :witness witness :runtime actual :tried (inc tried))
         :else (recur (next remaining) (inc tried))))))))))

; ═════════════════════════════════════════════════════════════════════════
; FAULTS — the fault space as exists-not queries, with a MODALITY
; ═════════════════════════════════════════════════════════════════════════
;
; Fault isolation keeps a concrete violation separate from a native implication
; claim and from infeasible other-law premises. No result gains proof authority.

(defn isolate-fault
 "Ask for a value failing one law while all other laws hold. Typed preparation
  separates infeasible premises from implication; concrete faults replay every
  law. Explicit runtime engines retain their finite/sampled scope."
 [options gen laws i]
 (when-not (and (map? options) (vector? laws) (int? i) (<= 0 i) (< i (count laws)))
  (throw (ex-info "Fault queries require options, a law vector and an in-range index" {})))
 (let [engine (get options :engine :auto)
       _ (when-not (contains? #{:auto :terms :enumerate :sample} engine) (throw (ex-info "Unknown fault query engine" {})))
       model (when (contains? #{:auto :terms} engine) (try (gen-term gen "veritas/input") (catch _ nil)))
       predicates (mapv (fn [law]
                          (let [form (pred-form law)]
                           (if (= :tuple (gen-tag gen))
                            (list 'let (vec (mapcat (fn [j] [(symbol (str "v_" j)) (list 'core/nth 'v j)]) (range (count (:gens gen))))) form)
                            form))) laws)
       prepared (when model
                  (try {:contract (response-runtime/from-source [[:v model]] predicates)}
                       (catch error {:reason (ex-message error)})))]
  (if-let [contract (:contract prepared)]
   (let [question (response/question (:definition contract) {:mode :isolate :clause i})
         result (response-runtime/execute options {:contract contract :question question :request {:mode :isolate :clause i} :pins {}})]
    (if (= :witnessed (:modality result))
     (let [actual (get-in result [:value :v])]
      (if (and (satisfies? GenShrink gen) (gen-domain? gen actual))
       (assoc result :response-witness (:witness result) :witness actual :implied false)
       (-> result (dissoc :value :witness) (assoc :modality :candidate :reason :runtime-generator-admission)))) result))
   (if (= :terms engine)
    {:modality :unsupported :engine :terms :reason (or (:reason prepared) "Generator has no reviewed term model") :compiler-proof-authority false}
    (let [others (keep-indexed (fn [j law] (when (not= i j) law)) laws)
          pred (cons 'and (cons (list 'not (nth laws i)) others))]
     (assoc (exists options "v" gen pred) :premise-feasibility :not-separated :source-connection {:status :runtime-predicate-only}))))))

(defn faults
 "Every named fault result retains its complete question and evidence. Native
  implication remains a solver claim; vacuous premises stay a separate case."
 [options contract]
 (let [laws (:laws contract) gen (:gen contract)]
  (mapv (fn [i]
          (let [result (isolate-fault options gen laws i)]
           (assoc result :law i
                         :witness-present (contains? result :witness)
                         :isolated-fault (when (contains? result :witness) (:witness result))
                         :implied (cond (= :vacuous (:modality result)) nil
                                        (:none result) true
                                        (contains? result :witness) false)
                         :basis (:modality result)))) (range (count laws)))))

; ═════════════════════════════════════════════════════════════════════════
; ERGONOMICS — a managed solver, so the caller need not thread a z3 port
; ═════════════════════════════════════════════════════════════════════════
;
; with-solver owns a typed context and passes expiring options to its callback.

(defn with-solver
 "Share one owned typed context across a callback; its options expire on return."
 ([f] (with-solver {} f))
 ([options f] (logic/with-session options (fn [session] (f (assoc options :session session))))))
