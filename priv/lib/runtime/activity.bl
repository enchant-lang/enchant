;; An optional finite trace in the actual caller. No worker, timer or result cache.
(ns runtime.activity (:require [data.provenance :as provenance]))

(def max-scopes 16)
(def max-active 64)
(def max-recent 64)
(def ^:private ^:per-env tapes (atom {}))
(defn- scope [] (or (Process/get :runtime.activity/scope)
                       (Process/get :bl-vm-scope) (BeamLisp.Env/env_id)))
(defn- now [] (erlang/monotonic_time :millisecond))
(defn- label [s] (when (string? s) (subs s 0 (min 160 (count s)))))

(defn open
  "Trusted host captures its own scope. At most sixteen scopes and readers each.
   Close the returned reader when its development surface stops."
  []
  (let [key (scope) lease (erlang/make_ref)]
    (swap! tapes (fn [all]
      (let [t (get all key {:readers #{} :active {} :recent [] :dropped 0 :receipt-id 0})]
        (when (or (and (not (contains? all key)) (>= (count all) max-scopes))
                  (>= (count (:readers t)) max-scopes))
          (throw "Activity reader capacity reached"))
        (assoc all key (update t :readers conj lease)))))
    {:scope key :lease lease}))

(defn close! [reader]
  (swap! tapes (fn [all]
    (if-let [t (get all (:scope reader))]
      (let [readers (disj (:readers t) (:lease reader))]
        (if (empty? readers) (dissoc all (:scope reader))
          (assoc all (:scope reader) (assoc t :readers readers)))) all)))
  nil)

(defn with-reader
  "Attribute an authorized app callback to its captured tape when an HTTP/OTP
   callback lacks the host's VM marker. Never rebind execution/VM authority or
   override an explicitly different realm. A foreign/closed reader is inert."
  [reader f]
  (let [realm (Process/get :bl-vm-scope) key (:scope reader)]
    (if-not (and (or (nil? realm) (= realm key))
                 (contains? (get-in @tapes [key :readers] #{}) (:lease reader))) (f)
      (let [previous (Process/get :runtime.activity/scope)]
        (try (Process/put :runtime.activity/scope key) (f)
          (finally (Process/put :runtime.activity/scope previous)))))))

(defn- retain [rows]
  (let [v (vec rows) n (count v)]
    (if (> n max-recent) (subvec v (- n max-recent)) v)))

(defn- alive? [row] (erlang/is_process_alive (:pid row)))
(defn- public-row [row time]
  (-> row (dissoc :pid :started :source :revision :providers :prior :document-slot)
      (assoc :tool (name (:tool row)) :elapsed-ms (max 0 (- (or (:ended row) time) (:started row))))
      (dissoc :ended)))
(defn snapshot
  "Finite metadata only; never creates a tape, loads a tool or acknowledges work."
  [reader]
  (let [t (get @tapes (:scope reader)) time (now)]
    (if-not (contains? (:readers t #{}) (:lease reader))
      {:available false :running [] :recent []}
      {:available true
       :running (mapv #(public-row (if (alive? %) % (assoc % :state "interrupted")) time)
                       (sort-by :id (vals (:active t))))
       :recent (mapv #(public-row % time) (reverse (:recent t)))
       :dropped (:dropped t) :limits {:active max-active :recent max-recent}})))

(defn quick-error [reader]
  (let [t (get @tapes (:scope reader))]
    (when (contains? (:readers t #{}) (:lease reader))
      (loop [rows (reverse (:recent t)) seen #{}]
        (when-let [row (first rows)]
          (let [path (get-in row [:location :path])]
            (if (and path (= :quick-check (:tool row)) (not (contains? seen path)))
              (if (= "failed" (:state row)) (:id row)
                (recur (rest rows) (conj seen path)))
              (recur (rest rows) seen))))))))

(defn receipt
  "Read a decision by its sequence within this tape. Retired entries expire
   without retaining a tombstone or revealing another tape's decisions."
  [reader id]
  (let [t (get @tapes (:scope reader))]
    (cond
      (not (contains? (:readers t #{}) (:lease reader))) {:status :refused}
      (not (and (int? id) (<= 1 id (:receipt-id t 0)))) {:status :missing}
      :else (if-let [row (first (filter #(= id (:receipt-id %))
                                      (concat (vals (:active t)) (:recent t))))]
              {:status :available
               :receipt (public-row (if (or (:ended row) (alive? row)) row (assoc row :state "interrupted"))
                                    (now))}
              {:status :expired}))))

(defn current-id [] (Process/get :runtime.activity/current))
(defn- edit! [f]
  (when-let [id (current-id)]
    (let [key (scope)]
      (swap! tapes (fn [all]
        (if (get-in all [key :active id]) (update-in all [key :active id] f) all))))))

(defn location
  "A bounded project-relative reference for developer tooling."
  [path]
  (when (and (string? path) (<= 1 (count path) 160) (= :relative (Path/type path))
             (not (String/contains? path "\\"))
             (not-any? #{".." ""} (String/split path "/")))
    {:path path}))

(defn evidence!
  "Record the revision actually used by the memo and optional named providers."
  [revision namespaces]
  (when (and revision (current-id))
    (let [providers (into {}
                      (keep (fn [n] (when-let [v (provenance/namespace-revision [n])] [n v]))
                            (take 8 namespaces)))]
      (edit! (fn [row]
        (if (:revision row) row
          (let [prior (:prior row)
                current (assoc row :revision revision :providers providers)]
            (if (and (= "same-source" (:cause row)) (:revision prior) (not= revision (:revision prior)))
              (let [changed (keep (fn [[namespace receipt]]
                                    (let [before (get-in prior [:providers namespace])]
                                      (when (and before (not= before receipt)) namespace)))
                                  providers)]
                (assoc current :cause "definitions-changed" :changed (vec (sort changed))))
              current))))))))

(defn cache!
  "Charge only a confirmed cache admission in this run."
  [bytes evictions]
  (edit! #(-> % (update-in [:cache :kept-bytes] (fn [n] (+ (or n 0) bytes)))
               (update-in [:cache :evictions] (fn [n] (+ (or n 0) evictions))))))

(defn source-line! [line]
  (when (and (int? line) (pos? line))
    (edit! #(if (:location %) (assoc-in % [:location :line] line) %))))

(defn note! [summary]
  (edit! #(assoc % :summary (select-keys summary [:repeated :definitions :imports]))))

(defn with-cli [f]
  (let [previous (Process/get :runtime.activity/origin)]
    (try (Process/put :runtime.activity/origin "CLI") (f)
      (finally (if (nil? previous) (Process/delete :runtime.activity/origin)
                 (Process/put :runtime.activity/origin previous))))))

(defn mark!
  "Record actual decisions, never inferred hits. Only sixteen bounded item labels."
  ([kind] (mark! kind nil))
  ([kind detail]
   (when (contains? #{:computed :reused :unstable :declined :evaluated :failed} kind)
     (edit! (fn [r]
       (let [r (update-in r [:counts kind] (fn [n] (inc (or n 0))))]
         (if-let [s (label detail)]
           (if (< (count (:items r)) 16) (update r :items conj s) r) r)))))
   nil))

(defn waiting
  "Wrap only admission waiting. Nested calls charge the outer wait once."
  [f]
  (if (or (nil? (current-id)) (Process/get :runtime.activity/waiting)) (f)
    (let [started (now)]
      (try
        (Process/put :runtime.activity/waiting true)
        (edit! #(assoc % :state "waiting"))
        (f)
        (finally
          (Process/delete :runtime.activity/waiting)
          (edit! #(-> % (assoc :state "working") (update :wait-ms + (- (now) started)))))))))

(defn with-operation
  "Opt-in scope trace. Telemetry capacity never delays or refuses actual work.
   metadata accepts bounded subject/source strings, never source text or values."
  [tool metadata f]
  (let [key (scope)]
    (if-not (contains? @tapes key) (f)
      (let [id (erlang/unique_integer (list :positive :monotonic))
            tool (if (contains? #{:editor :check :index :render :quick-check :outline :formal-graph} tool) tool :other)
            parent (current-id) started (now)
            subject (or (label (:subject metadata)) "")
            document-slot (when (erlang/is_reference (:document-slot metadata)) (:document-slot metadata))
            source (label (:source metadata))
            origin (Process/get :runtime.activity/origin)
            location (location (:path metadata))
            admitted (get-in (swap! tapes (fn [all]
          (if-let [t (get all key)]
            (let [dead (filterv #(not (alive? %)) (vals (:active t)))
                  active (reduce #(dissoc %1 (:id %2)) (:active t) dead)
                  recent (retain (concat (:recent t) (map #(assoc % :state "interrupted" :ended started) dead)))
                  previous (last (filter #(and (= tool (:tool %)) (= subject (:subject %))
                                               (= document-slot (:document-slot %))) recent))
                  decision (inc (:receipt-id t 0))]
              (if (>= (count active) max-active)
                (assoc all key (assoc t :active active :recent recent :dropped (inc (:dropped t))))
                (assoc all key (assoc t :recent recent :receipt-id decision :active
                    (assoc active id {:id id :parent parent :tool tool :subject subject
                      :receipt-id decision :previous-receipt-id (:receipt-id previous)
                      :parent-receipt-id (get-in active [parent :receipt-id]) :document-slot document-slot
                      :origin origin :location location :prior (select-keys previous [:revision :providers])
                      :source source :cause (cond (nil? previous) "first-use"
                        (nil? source) "requested" (= source (:source previous)) "same-source" :else "source-changed")
                      :pid (erlang/self) :started started :state "working" :wait-ms 0 :counts {} :items []}))))) all))) [key :active id])]
        (if-not admitted (f)
          (try
            (Process/put :runtime.activity/current id)
            (try (f) (catch e (mark! :failed) (throw e)))
            (finally
              (Process/put :runtime.activity/current parent)
              (swap! tapes (fn [all]
                (if-let [r (get-in all [key :active id])]
                  (-> all (update-in [key :active] dissoc id)
                    (update-in [key :recent]
                      #(retain (conj % (assoc (dissoc r :prior) :ended (now)
                        :state (if (pos? (get-in r [:counts :failed] 0)) "failed" "done")))))) all))))))))))
