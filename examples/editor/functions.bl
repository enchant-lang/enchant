; An ordinary app namespace can contain both native server work and editor UI.
(ns ^:js editor.functions)
(defn- style [tone] {:class (str "studio-signal studio-signal-" tone)})
(defn signal
  {:editor/function {:id "studio/signal" :label "Signal" :kind "wrap" :scope "inline"
                     :params {:tone {:type "enum" :values ["violet" "coral"] :default "violet"}}
                     :ui {:icon "sparkles" :description "Give a phrase its own voice"}}}
  [args body] [:span (style (:tone args)) body])
(defn- private-server-work [] (File/read! "/server-only/studio-secret"))
