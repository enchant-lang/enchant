(ns example.interface-artifact (:require [auth.contract :as contract]))
(def file (str (System/tmp_dir!) "/namespace-interface-" (erlang/unique_integer (list :positive)) ".edn"))
(try
 (let [published (contract/publish! "provider/src/example/catalog.bl" file)
       imported (contract/read! file)]
  (assert (= published imported))
  (assert (= 1 (get-in imported [:exports "services-in"])))
  (assert (not (contains? imported :source)))
  (println "04: checked, versioned interface artifact; no implementation or credentials"))
 (finally (File/rm! file)))
