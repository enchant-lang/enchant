(ns example.interface-mismatch (:require [auth.contract :as contract] [example.entry :as entry]))
(def a {:namespace "example.catalog" :version 1 :exports {"services-in" 1}})
(assert (not= (contract/id a) (contract/id (assoc a :version 2))))
(assert (not= (contract/id a) (contract/id (assoc a :exports {"services-in" 2}))))
(assert (= :auth/contract-mismatch
 (entry/kind #(contract/validate (assoc a :format contract/FORMAT :id "forged")))))
(println "04: version, arity and artifact tampering alter/refuse interface identity")
