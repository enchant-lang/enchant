(ns example.identity-tasks
 (:require [world.catalog :as catalog] [example.entry :as entry] [auth.identity :as identity] [proc.task :as task]))
(entry/run
 (fn []
  (let [work (task/async #(catalog/count-in "project-a"))]
   (assert (= 1 (task/await work 5000))))))
(assert (nil? (identity/current)))
(println "02: native task carried verified context and parent restored it")
