(ns example.identity-adapters (:require [auth.ingress :as ingress]))
;; Gateway evidence is injected in this fixture. Real ingress uses the actual
;; connecting socket UID or a host-owned verifier; raw headers grant nothing.
(doseq [[provider header] ingress/ADAPTERS]
 (let [request (-> (Plug.Test/conn "GET" "/" "")
                   (Plug.Conn/put_req_header header "external-alice")
                   (Plug.Conn/put_req_header "x-forwarded-for" "100.64.0.2"))
       config {:provider provider :application "namespace-examples" :subjects {"external-alice" "person:alice"}
               :trusted-uids #{0} :peer-uid (fn [_ _] 0) :machine-addresses #{"100.64.0.1"}}]
  (assert (= "person:alice" (:subject ((ingress/adapter config) request))))
  (assert (nil? ((ingress/adapter (assoc config :peer-uid (fn [_ _] 1001))) request)))))
(println "02: four adapters, one principal shape, untrusted gateway denied")
