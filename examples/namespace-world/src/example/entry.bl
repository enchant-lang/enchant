(ns example.entry (:require [auth.identity :as identity]))
;; HOST FIXTURE: stand-in for already verified ingress, never a real login.
;; Application files below use the imported namespace without RPC or tokens.
(defn run [action]
 (identity/with-verified {:subject "person:alice" :application "namespace-examples" :kind :person} action))
(defn kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
