(ns example.host (:require [auth.interface :as interface]))
;; Trusted host fixture. Real providers obtain memberships and ports from their
;; own current authority/database; these atoms are deliberately test data.
(def roles (atom {["person:alice" "project-a"] #{:viewer :operator}}))
(def writes (atom []))
(defn open [config]
 (interface/open
  {:file (:source config) :world (:world config)
   :roles (fn [principal resource] (get @roles [(:subject principal) resource] #{}))
   :readers {:catalog (fn [_ resource] [{"title" resource}])}
   :effects {:counter (fn [_ resource value] (swap! writes conj [resource value]) {"receipt" "example-only"})}}))
