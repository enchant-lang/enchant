(ns example.effect-proof (:require [auth.logic :as logic] [veritas.assurance :as assurance]))
(def evidence (logic/policy-evidence))
(assert (= :exhausted (:modality evidence)))
(assert (= 32 (:domain-size evidence)))
(assert (= :unsupported (:status (assurance/combine :unproved [{:modality :solver-claim}]))))
(println "03: Veritas exhausted 32 entry cases; solver claims stay claims")
