(ns example.effect-admission (:require [auth.logic :as logic]))
(def source (File/read! "provider/src/example/catalog.bl"))
(def checked (logic/prepare source))
(assert (= :checked (:status checked)))
(assert (= :pure (get-in checked [:exports "label" :classification])))
(assert (= :read (get-in checked [:exports "count-in" :classification])))
(assert (= :effectful (get-in checked [:exports "change!" :classification])))
(assert (= :unsupported (:status (logic/prepare
 (String/replace source "(get value \"title\")" "(do (println value) (get value \"title\"))")))))
(println "03: actual source and helper effects checked; hidden I/O refused")
