(ns ^{:auth
      {:version 1
       :exports
       {services-in {:roles #{:viewer :operator} :resource {:arg 0} :effects {:read #{:catalog}}}
        count-in {:roles #{:viewer :operator} :resource {:arg 0} :effects {:read #{:catalog}}}
        label {:roles #{:viewer :operator} :resource {:arg 0} :effects :pure}
        change! {:roles #{:operator} :resource {:arg 0} :effects {:send #{:counter}}}}
       :grants {"namespace-examples" #{services-in count-in label change!}}}}
 example.catalog
 (:require [auth.resource :as resource]))

(defn services-in [project] (resource/read :catalog))
(defn count-in [project] (count (services-in project)))
(defn label [project value] (get value "title"))
(defn change! [project value] (resource/perform! :counter value))
(defn- private-helper [value] value)
