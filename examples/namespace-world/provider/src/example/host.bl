(ns example.host (:require [auth.interface :as interface]))
;; Trusted host fixture. Capture state references once when opening a provider;
;; namespace vars in a consumer Env are not the provider's authority store.
(def roles (atom {["person:alice" "project-a"] #{:viewer :operator}}))
(def writes (atom []))
(defn open [config]
 (let [memberships roles effects writes
       provider
       (interface/open
        {:file (:source config) :world (:world config)
         :roles (fn [principal resource] (get @memberships [(:subject principal) resource] #{}))
         :readers {:catalog (fn [_ resource] [{"title" resource}])}
         :effects {:counter (fn [_ resource value] (swap! effects conj [resource value]) {"receipt" "example-only"})}})]
  ;; Host fixture handles, never exported or returned over the namespace API.
  (assoc provider :example/roles memberships :example/writes effects)))
