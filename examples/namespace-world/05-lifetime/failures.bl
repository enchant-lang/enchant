(ns example.import-failures
 (:require [world.catalog :as catalog] [example.entry :as entry]))
;; HOST FIXTURE: change the actual provider's authority, not a consumer-local var.
(let [provider (elem (BeamLisp.Env/lookup (tuple :auth/import "world.catalog")) 1)
      memberships (:example/roles provider)]
 (entry/run
  (fn []
   (let [before @memberships]
    (try
     (reset! memberships {})
     (assert (= :auth/denied (entry/kind #(catalog/services-in "project-a"))))
     (finally (reset! memberships before)))))))
(println "05: provider membership changes are effective on the next call")
