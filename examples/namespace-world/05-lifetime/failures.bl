(ns example.import-failures
 (:require [world.catalog :as catalog] [example.entry :as entry] [example.host :as host]))
(entry/run
 (fn []
  (let [before @host/roles]
   (try
    (reset! host/roles {})
    (assert (= :auth/denied (entry/kind #(catalog/services-in "project-a"))))
    (finally (reset! host/roles before))))))
(println "05: provider membership changes are effective on the next call")
