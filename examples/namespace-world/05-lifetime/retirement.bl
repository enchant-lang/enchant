(ns example.import-retirement
 (:require [auth.imports :as imports] [bl.env :as project] [example.entry :as entry] [env]))
(let [owner (env/fork)]
 (try
  (env/with-env owner
   (fn []
    (imports/activate! (project/project (BeamLisp/cwd)))
    (let [old (BeamLisp.Env/fetch! "world.catalog" "services-in")]
     (entry/run #(assert (= [{"title" "project-a"}] (old "project-a"))))
     (imports/close!)
     (entry/run #(assert (= :auth/stale-code (entry/kind (fn [] (old "project-a"))))))
     (imports/close!))))
  (finally (env/destroy owner))))
(println "05: close retires retained functions; repeated cleanup is safe")
