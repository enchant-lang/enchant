(ns example.require-allowlist
 (:require [world.catalog :as catalog] [example.entry :as entry] [auth.identity :as identity]))
(assert (= :auth/unauthenticated (entry/kind #(catalog/services-in "project-a"))))
(entry/run #(assert (= :auth/denied (entry/kind (fn [] (catalog/services-in "project-b"))))))
(assert (nil? (identity/current)))
(println "01: missing identity and ungranted project denied")
