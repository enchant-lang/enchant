(ns example.require-functions (:require [world.catalog :as catalog] [example.entry :as entry]))
(entry/run
 (fn []
  (assert (= [{"title" "project-a"}] (catalog/services-in "project-a")))
  (assert (= 1 (catalog/count-in "project-a")))
  (println "01: ordinary require, direct call and transitive helper passed")))
