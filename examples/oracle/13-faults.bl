; Capture the actual complete fault question; no SMT text or raw solver port.
(ns example.response-oracle
 (:require [veritas.fault :as fault] [veritas.mock :as mock] [oracle]
           [formal.query :as query] [formal.identity :as identity]))
(def contract (mock/contract-from [["v" "Int"]] ['(>= v -40) '(<= v 60)]))
(defn captured [backend]
 (let [seen (atom nil)
       result (oracle/with-query-handler
                (fn [question execute]
                 (reset! seen (query/validate! question))
                 (oracle/query-answer question (execute)))
                #(fault/isolate {:backend backend} contract 0))]
  (assert (= :witnessed (:modality result)))
  {:backend backend :question (identity/hash @seen) :mode (:mode @seen)
   :assumptions (mapv :label (:assertions @seen)) :modality (:modality result) :value (:value result)
   :term-replay (get-in result [:answer :validation :status]) :runtime-replay (get-in result [:runtime-replay :status])
   :compiler-proof-authority false}))
(def answers (mapv captured [:z3 :oxiz]))
(assert (apply = (map :question answers)))
(println (pr-str answers))
(println "Changing the native engine keeps the whole question, including the other laws and every model condition.")
