(ns example.veritas.generators (:require [veritas :as v]))
(defn show [label result] (println (str label " " (pr-str (select-keys result [:modality :engine :witness :none :complete])))))
(show "Native integer domain" (v/for-all {:backend :oxiz :engine :terms} "n" (v/int-of 0 100000) '(>= n 0)))
(show "Exact finite runtime search" (v/for-all {:engine :enumerate} "b" (v/one-of false true) 'b))
(show "Unsuccessful sampling is unresolved" (v/exists {:engine :sample :seed 7} "x" (v/any-of) false))
(show "A product combines theories"
 (v/for-all {:backend :z3 :engine :terms} "p" (v/tuple-of (v/coll-of 0 4) (v/enum-of :on :off))
   '(and (<= (count (nth p 0)) 4) (keyword? p_1))))
(println "Sampled, exhausted, replayed and native answers retain different evidence.")
