; Both native backends generate typed faults; datalog measures their coverage.
(ns example.fault-space (:require [veritas.fault :as f] [veritas.mock :as m]))
(def band (m/contract-from [["v" "Int"]] ['(>= v -40) '(<= v 60) '(>= v -50)]))
(doseq [backend [:z3 :oxiz]]
 (let [options {:backend backend} report (f/report options band)]
  (println (name backend) (pr-str (select-keys report [:covered :uncovered :laws :measurements-complete? :generation-resolved?])))
  (println "Isolated requests" (pr-str (mapv #(select-keys % [:clause :modality :value :implied :question-identity]) (:isolation report))))
  (let [contradictory (m/contract-from [["v" "Int"]] ['(>= v 0) '(< v 0) true])]
   (println "Infeasible other laws" (pr-str (select-keys (f/isolate options contradictory 2) [:modality :premise-feasibility :implied]))))
  (let [server (f/make-server (m/make-mock options band :v) {:boom 0})]
   (println "Named fault" (pr-str (select-keys (f/serve server :boom) [:ok? :injected? :reason :modality :value]))))))
(println "Unknown measurements create no invented violation edges. Implication claims remain unchecked.")
