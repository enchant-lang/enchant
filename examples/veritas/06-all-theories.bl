; One typed question across generator theories and both native backends.
(ns example.veritas.theories (:require [veritas :as v]))
(defn show [label result]
 (println (str label " " (pr-str (select-keys result [:modality :engine :witness :none :complete :question-identity])))))
(doseq [backend [:z3 :oxiz]]
 (println (str "\n" (name backend) " — typed questions and concrete replay"))
 (let [options {:backend backend :engine :terms}]
  (show "Integer law" (v/for-all options "n" (v/int-of 0 100000) '(>= n 0)))
  (show "False is a witness" (v/exists options "b" (v/bool-of) '(= b false)))
  (show "Whole keyword identities" (v/exists options "phase" (v/enum-of :left/open :right/open) '(= phase :right/open)))
  (show "False enum payload" (v/exists options "mode" (v/enum-of [:on :bool] :off) '(and (some? (:on mode)) (= (:on mode) false))))
  (show "Length and enum compose" (v/for-all options "p" (v/tuple-of (v/coll-of 0 3) (v/enum-of :a :b)) '(and (<= (count p_0) 3) (keyword? p_1))))
  (show "Empty pop raises" (v/for-all options "c" (v/coll-of 0 3) '(>= (count (pop c)) 0)))
  (show "Rest returns a list" (v/exists options "c" (v/coll-of 0 3) '(vector? (rest c))))
  (show "Unicode prefix" (v/for-all options "s" (v/text-of "é") '(String/starts_with? s "é")))
  (show "Float interval needs its runtime model" (v/for-all options "x" (v/real-of 0.0 1.0) '(>= x 0)))
  (show "Grapheme bounds use runtime tests" (v/for-all options "s" (v/string-of "" 1 2) '(>= (count s) 1))))))
(println "A solver claim has an unchecked certificate. A witness is replayed in BL.")
(println "Collection length models erase elements. BL graphemes and SMT code points remain different.")
