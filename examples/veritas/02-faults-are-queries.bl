(ns example.veritas.faults (:require [veritas :as v]))
(def contract {:gen (v/int-of -100 100) :laws ['(>= v -40) '(<= v 60) '(>= v -50)]})
(doseq [backend [:z3 :oxiz]]
 (println (str (name backend) " " (pr-str (mapv #(select-keys % [:law :modality :isolated-fault :implied :basis])
                                                (v/faults {:backend backend} contract))))))
(println "Concrete isolated faults are replayed. Redundancy from native UNSAT remains a solver claim.")
