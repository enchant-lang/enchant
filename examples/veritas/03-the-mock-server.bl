; Typed response contracts, stable server answers and global integer boundaries.
(ns example.mock-server (:require [veritas.mock :as m]))
(def weather (m/contract-from [["temp" "Int"] ["code" "Int"]]
              ['(and (>= temp -40) (<= temp 60)) '(and (>= code 200) (< code 300))]))
(defn show [label result]
 (println label (pr-str (select-keys result [:modality :value :none :feasibility :optimality :question-identity]))))
(doseq [backend [:z3 :oxiz]]
 (let [options {:backend backend} server (m/make-mock options weather :code)]
  (println (str "\n" (name backend) " — one typed response relation"))
  (show "A valid response" (m/synth options weather))
  (show "Request 200" (m/answer server 200))
  (show "The retained response" (m/answer server 200))
  (show "Impossible request 500" (m/answer server 500))
  (show "Minimum temperature" (m/synth-boundary options weather :temp :min))
  (show "Maximum temperature" (m/synth-boundary options weather :temp :max))
  (show "An invalid response" (m/synth-invalid options weather))))
(println "Each server retains its first replayed response per key. Native optimality remains an unchecked claim.")
