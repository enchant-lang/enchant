(ns example.veritas.one (:require [veritas :as v]))
(def options {:backend :z3})
(defn show [label result] (println (str label " " (pr-str (select-keys result [:modality :engine :witness :none :complete])))))
(show "Find an input" (v/exists options "n" (v/int-of -90 60) '(> n 50)))
(show "Ask about every input" (v/for-all options "n" (v/int-of 0 100) '(>= n 0)))
(show "See an actual failure" (v/for-all options "n" (v/int-of 0 100) '(< n 50)))
(show "Check actual clause selection"
 (v/covers options "(defn sign ([n] :when (> n 0) :positive) ([other] :when (< other 0) :negative))" (v/int-of -100 100)))
(show "Sample the open type universe" (v/for-all options "x" (v/any-of) '(int? x)))
(println "Native UNSAT is a solver claim; checked term certificates and source/compiler proofs are separate.")
