; Chronology facts live in the database; a typed question checks their order.
; Run: ./bin/bl run examples/datom/time/08-chronolog.bl
(ns example.datom.time.chronolog
 (:require [datom] [datom.time :as time]))

(def conn
 (datom/connect
  [{:db/ident :ev/name :db/valueType :db.type/string}
   {:db/ident :ev/span :db/valueType :db.type/time}
   {:db/ident :ev/before :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}]))
(def tx (datom/transact! conn
          [{:db/id -1 :ev/name "the war" :ev/span #time"101X"}
           {:db/id -2 :ev/name "the treaty" :ev/span #time"101X"}]))
(def war (get (:tempids tx) -1))
(def treaty (get (:tempids tx) -2))
(datom/transact! conn [[:db/add war :ev/before treaty]])

; Inclusive integer-year ranges constrain each event's start. Ordering is
; strict: the first event must start before the second. Complete keys survive
; in the question and schedule, including their namespaces.
(def bounds {:history/war [1010 1019] :history/treaty [1010 1019]})
(def ordering [[:history/war :history/treaty]])
(def question (time/chronology-question bounds ordering))
(println {:profile (:profile question) :mode (:mode question) :scope (:scope question)})

(doseq [engine [:z3 :oxiz]]
 (let [options {:backend engine} answer (time/consistency-result options bounds ordering)]
  (assert (= true (:consistent answer)))
  (println {:engine engine :consistent (:consistent answer) :schedule (:schedule answer)
            :replay (get-in answer [:validation :status])
            :certificate (get-in answer [:certificate :status])})
  (assert (= false (time/consistent? options bounds
                    [[:history/war :history/treaty] [:history/treaty :history/war]])))))

; consistent? returns a Boolean for a decisive answer and raises if unresolved.
; consistency-result retains unknown/unsupported/error answers as inspectable
; data. Bound propagation, provenance explanations and schedule enumeration
; have separate interfaces; this program checks satisfiability of the order.
