; A masked decade and an unknown one-year date describe different inputs.
; Run: ./bin/bl run examples/datom/time/07-uncertain.bl
(ns example.datom.time.uncertain
 (:require [datom.time :as time] [formal.temporal :as temporal] [minikanren :as mk]))

(defn show [label value] (println (str label "  " (pr-str value))))

; miniKanren enumerates the unknown low digit. The interval reader gives the
; whole decade; expanding that interval gives its ten calendar-year members.
(show "156X low digits:"
 (sort (mk/run 10 q
         (mk/conde [(mk/=== q 0)] [(mk/=== q 1)] [(mk/=== q 2)] [(mk/=== q 3)]
                   [(mk/=== q 4)] [(mk/=== q 5)] [(mk/=== q 6)] [(mk/=== q 7)]
                   [(mk/=== q 8)] [(mk/=== q 9)]))))
(show "156X calendar-year members:" (map time/from (time/expand #time"156X")))

; Here the coordinates are integer years. Shift a one-year span by an unknown
; start in [1990,1999]. Its input constraint travels with the resulting value.
(def uncertain-year
 (temporal/shift (temporal/span 0 1) (temporal/endpoint-range "year.start" 1990 1999)))
(def fixed-year (temporal/span 1995 1996))

(doseq [engine [:z3 :oxiz]]
 (let [options {:backend engine} answer (time/overlap-result options uncertain-year fixed-year)]
  (assert (= :possible (:verdict answer)))
  (show (str engine " unknown one-year date:")
   {:verdict (:verdict answer)
    :intersecting-date (get-in answer [:answers :intersection :witness "left" :value])
    :separated-date (get-in answer [:answers :separation :witness "left" :value])
    :certificate (get-in answer [:certificate :status])})
  (show (str engine " whole decade against 1995:")
   (time/overlap-verdict options #time"199X" #time"1995/1996"))
  (show (str engine " disjoint crisp intervals:")
   (time/overlap-verdict options #time"1980/1990" #time"1995/2005"))))

; :possible requires replayed dates both ways. :unknown is a separate result.
; Exact input questions and both answers remain in overlap-result; native UNSAT
; answers retain unchecked certificate status and no compiler proof authority.
