;; Run: ./bin/bl --cold serve examples/tooling/work-observatory.bl
;; Open http://127.0.0.1:4056 — the small dev dock is injected into the app.
;; This example grants a developer principal because its listener is loopback.
(BeamLisp.Env/add_search_path
  (or (System/get_env "ENCHANT_INSPECTOR_ROOT")
      (Path/join (BeamLisp/cwd) "research/work-observatory/app")))
(ns tooling.work-observatory
  (:require [live.app :as app] [observatory.inspector :as inspector]
            [loom.box :as box] [loom.ui :as ui] [loom.token :as token]
            [bl.serve :as serve]
            [data.projection :as projection] [proc.work :as work]))

(def jobs (work/start! {:max-active 2 :history 8}))
(def totals (projection/start-incremental! :observatory/example {:source-id "observatory/example/v1"}))
(defn home [{:keys [locals]}]
  (let [clicks (:clicks locals 0) warm? (:warm locals false)]
    (token/install-theme!
      {:color {:bg "#f6f5f0" :surface "#fffef9" :surface-2 "#efeee7"
               :border "#dedfd5" :text "#233b33" :muted "#7a867b"
               :accent (if warm? "#b67548" "#28775e")}})
    (box/col {:gap :6 :max-w "760px" :style {:margin "0 auto" :padding "64px 24px"}}
      (box/row {:justify :between :align :center}
        (ui/heading 2 "Playground") (ui/badge {:tone :accent} "DEV"))
      (ui/card {}
        (box/col {:gap :4 :data-component "counter"}
          (ui/prose {:tone :muted} "Counter")
          (box/row {:justify :between :align :center}
            [:div {:id "demo-count"} (ui/heading 1 (str clicks))]
            (ui/button {:id "demo-add" :variant :primary :on-click [:assign :clicks (inc clicks)]} "Add one"))))
      (ui/card {}
        (box/row {:justify :between :align :center :gap :4 :data-component "palette"}
          (ui/prose {} "Palette")
          (ui/button {:id "demo-colour" :variant :subtle :on-click [:assign :warm (not warm?)]} "Change colour")))
      [:style "body{margin:0}button{touch-action:manipulation}"])))
(def application
  {:principal (fn [_] :local-developer) :worlds (fn [_ _] {}) :home "/"
   :routes [["/" home]]})

(app/serve
  (inspector/attach application
    {:enabled? true :authorize (fn [me] (= :local-developer me))
     :work {:example jobs} :projections {:totals (projection/reader totals)}})
  {:port (serve/port 4056) :ip (tuple 127 0 0 1)})
