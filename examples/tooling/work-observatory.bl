;; Pinned SDK example: bl --cold -p priv/lib serve examples/tooling/work-observatory.bl
;; Open http://127.0.0.1:4056 then follow Work Observatory.
;; This example grants a developer principal because its listener is loopback.
(ns tooling.work-observatory
  (:require [live.app :as app] [live.observatory :as observatory]
            [data.projection :as projection] [proc.work :as work] [bl.json :as json]))

(def jobs (work/start! {:max-active 2 :history 8}))
(def totals (projection/start-incremental! :observatory/example {:source-id "observatory/example/v1"}))
(def application
  {:principal (fn [_] :local-developer) :worlds (fn [_ _] {}) :home "/"
   :routes [["/" (fn [_] [:main [:h1 "Enchant development app"]
     [:p "Inspect this application's existing owners without starting new work."]
     [:a {:href observatory/path} "Open Work Observatory →"]])]]})

(if (= "snapshot" (first (BeamLisp/argv)))
  (try (println (json/encode (observatory/snapshot
         (observatory/open {:work {:example jobs} :projections {:totals (projection/reader totals)}}))))
       (finally (projection/stop! totals) (work/stop! jobs)))
  (app/serve
    (observatory/attach application
      {:enabled? true :authorize (fn [me] (= :local-developer me))
       :work {:example jobs} :projections {:totals (projection/reader totals)}})
    {:port 4056 :ip (tuple 127 0 0 1)}))
