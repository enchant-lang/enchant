;; Run: ./bin/bl serve examples/tooling/work-observatory.bl
;; Open http://127.0.0.1:4056 — the small dev dock is injected into the app.
;; This example grants a developer principal because its listener is loopback.
(ns tooling.work-observatory
  (:require [live.app :as app] [lsp] [bl.check :as check] [codebase]
            [loom.box :as box] [loom.ui :as ui] [loom.token :as token]
            [bl.serve :as serve]
            [data.projection :as projection] [proc.work :as work]))

(def jobs (work/start! {:max-active 2 :history 8}))
(def totals (projection/start-incremental! :observatory/example {:source-id "observatory/example/v1"}))
(def sample-source "(ns playground)\n(defn leaf [x] (+ x 1))\n(defn total [x] (leaf x))")
(defn run-tool [_ payload me]
  (when-not (= :local-developer me) (throw "Developer required"))
  (let [src (:source payload)]
    (when-not (and (string? src) (<= (count src) 8192)) (throw "Source exceeds 8 KiB"))
    (case (:tool payload)
      :editor (lsp/analyzed src)
      :check (check/analyze-source "playground.bl" src)
      :index (codebase/index-source {} "playground" src {:mode :calls})
      (throw "Unknown tool")))
  nil)

(defn home [{:keys [locals]}]
  (let [clicks (:clicks locals 0) warm? (:warm locals false) src (:source locals sample-source)]
    (token/install-theme!
      {:color {:bg "#f6f5f0" :surface "#fffef9" :surface-2 "#efeee7"
               :border "#dedfd5" :text "#233b33" :muted "#7a867b"
               :accent (if warm? "#b67548" "#28775e")}})
    (box/col {:gap :6 :max-w "760px" :style {:margin "0 auto" :padding "64px 24px"}}
      (box/row {:justify :between :align :center}
        (ui/heading 2 "Playground") (ui/badge {:tone :accent} "DEV"))
      (ui/card {}
        (box/col {:gap :4 :data-component "counter"}
          (ui/prose {:tone :muted} "Counter")
          (box/row {:justify :between :align :center}
            [:div {:id "demo-count"} (ui/heading 1 (str clicks))]
            (ui/button {:id "demo-add" :variant :primary :on-click [:assign :clicks (inc clicks)]} "Add one"))))
      (ui/card {}
        (box/row {:justify :between :align :center :gap :4 :data-component "palette"}
          (ui/prose {} "Palette")
          (ui/button {:id "demo-colour" :variant :subtle :on-click [:assign :warm (not warm?)]} "Change colour")))
      (ui/card {}
        (box/col {:gap :4 :data-component "source-tools"}
          (ui/prose {} "Try the tools")
          [:textarea {:id "demo-source" :aria-label "Source" :value src :rows 4 :maxlength 8192
                      :on-input [:assign :source [:from :value]]
                      :style "box-sizing:border-box;width:100%;resize:vertical;border:1px solid #dedfd5;border-radius:6px;padding:12px;background:#f6f5f0;color:#233b33;font:12px/1.6 monospace"}]
          (box/row {:gap :2}
            (ui/button {:id "demo-editor" :variant :subtle :on-click [:intent :tool {:tool :editor :source src}]} "Editor")
            (ui/button {:id "demo-check" :variant :subtle :on-click [:intent :tool {:tool :check :source src}]} "Check")
            (ui/button {:id "demo-index" :variant :subtle :on-click [:intent :tool {:tool :index :source src}]} "Index"))))
      [:style "body{margin:0}button{touch-action:manipulation}"])))
(def application
  {:principal (fn [_] :local-developer) :worlds (fn [_ _] {}) :home "/"
   :routes [["/" home]] :intents {:tool run-tool}})

(app/serve application
  {:port (serve/port 4056) :ip (tuple 127 0 0 1)
   :devtools {:enabled? true :authorize (fn [me] (= :local-developer me))
              :work {:example jobs} :projections {:totals (projection/reader totals)}}})
