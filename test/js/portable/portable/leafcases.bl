; test/js/portable/portable/leafcases.bl — host functions a renderer calls,
; printed on the BEAM and from the JS build; test/bl/js_portable_leaves_test.bl
; compares them line for line. Each case is [label (pr-str form)]: the BEAM's answer is
; the reference. An error prints as #error on both sides (its message is a
; host's business, not compared).
(ns portable.leafcases (:require [bl.json :as json] [portable.lit :as lit]))

(defn all []
  [
   ["round +2.5" (try (pr-str (erlang/round 2.5)) (catch e "#error"))]
   ["round -2.5" (try (pr-str (erlang/round -2.5)) (catch e "#error"))]
   ["round 2.4999" (try (pr-str (erlang/round 2.4999)) (catch e "#error"))]
   ["round int" (try (pr-str (erlang/round 7)) (catch e "#error"))]
   ["round big" (try (pr-str (erlang/round 1.0e20)) (catch e "#error"))]
   ["ceil 1.2" (try (pr-str (erlang/ceil 1.2)) (catch e "#error"))]
   ["ceil -1.2" (try (pr-str (erlang/ceil -1.2)) (catch e "#error"))]
   ["floor -1.2" (try (pr-str (erlang/floor -1.2)) (catch e "#error"))]
   ["floor int" (try (pr-str (erlang/floor 3)) (catch e "#error"))]
   ["b2i 42" (try (pr-str (erlang/binary_to_integer "42")) (catch e "#error"))]
   ["b2i -17" (try (pr-str (erlang/binary_to_integer "-17")) (catch e "#error"))]
   ["b2i +5" (try (pr-str (erlang/binary_to_integer "+5")) (catch e "#error"))]
   ["b2i big" (try (pr-str (erlang/binary_to_integer "123456789012345678901234567890")) (catch e "#error"))]
   ["b2i bad" (try (pr-str (erlang/binary_to_integer "4x")) (catch e "#error"))]
   ["b2i space" (try (pr-str (erlang/binary_to_integer " 4")) (catch e "#error"))]
   ["b2i empty" (try (pr-str (erlang/binary_to_integer "")) (catch e "#error"))]
   ["b2i hex" (try (pr-str (erlang/binary_to_integer "ff" 16)) (catch e "#error"))]
   ["b2i HEX" (try (pr-str (erlang/binary_to_integer "FF" 16)) (catch e "#error"))]
   ["b2i b36" (try (pr-str (erlang/binary_to_integer "zz" 36)) (catch e "#error"))]
   ["b2i hex bad" (try (pr-str (erlang/binary_to_integer "fg" 16)) (catch e "#error"))]
   ["b2f 1.5" (try (pr-str (erlang/binary_to_float "1.5")) (catch e "#error"))]
   ["b2f -2.25e3" (try (pr-str (erlang/binary_to_float "-2.25e3")) (catch e "#error"))]
   ["b2f int" (try (pr-str (erlang/binary_to_float "1")) (catch e "#error"))]
   ["b2f dot" (try (pr-str (erlang/binary_to_float ".5")) (catch e "#error"))]
   ["pow" (try (pr-str (math/pow 2 10)) (catch e "#error"))]
   ["pow frac" (try (pr-str (math/pow 9 0.5)) (catch e "#error"))]
   ["log10" (try (pr-str (math/log10 1000)) (catch e "#error"))]
   ["sqrt" (try (pr-str (math/sqrt 2)) (catch e "#error"))]
   ["days epoch" (try (pr-str (calendar/date_to_gregorian_days 1970 1 1)) (catch e "#error"))]
   ["days 2026" (try (pr-str (calendar/date_to_gregorian_days 2026 11 22)) (catch e "#error"))]
   ["days year 1" (try (pr-str (calendar/date_to_gregorian_days 1 1 1)) (catch e "#error"))]
   ["days leap" (try (pr-str (calendar/date_to_gregorian_days 2024 2 29)) (catch e "#error"))]
   ["www" (try (pr-str (URI/encode_www_form "a b/é~-_.!*'()")) (catch e "#error"))]
   ["www empty" (try (pr-str (URI/encode_www_form "")) (catch e "#error"))]
   ["www decode" (try (pr-str (URI/decode_www_form "a+b%2F%C3%A9")) (catch e "#error"))]
   ["trim_trailing" (try (pr-str (String/trim_trailing "a///" "/")) (catch e "#error"))]
   ["trim_trailing multi" (try (pr-str (String/trim_trailing "xabab" "ab")) (catch e "#error"))]
   ["trim_trailing none" (try (pr-str (String/trim_trailing "abc" "z")) (catch e "#error"))]
   ["trim_leading" (try (pr-str (String/trim_leading "--a-" "-")) (catch e "#error"))]
   ["hex" (try (pr-str (binary/encode_hex "aé")) (catch e "#error"))]
   ["hex lower" (try (pr-str (binary/encode_hex "aé" :lowercase)) (catch e "#error"))]
   ["match scope" (try (pr-str (binary/match "abcabc" "c" (list (tuple :scope (tuple 3 3))))) (catch e "#error"))]
   ["match scope none" (try (pr-str (binary/match "abcabc" "a" (list (tuple :scope (tuple 4 2))))) (catch e "#error"))]
   ["match scope utf8" (try (pr-str (binary/match "éaéa" "a" (list (tuple :scope (tuple 3 3))))) (catch e "#error"))]
   ["split plain" (try (pr-str (Regex/split (Regex/compile! "\\s+") "a  b c")) (catch e "#error"))]
   ["split edges" (try (pr-str (Regex/split (Regex/compile! ",") ",a,,b,")) (catch e "#error"))]
   ["split trim" (try (pr-str (Regex/split (Regex/compile! ",") ",a,,b," (list (tuple :trim true)))) (catch e "#error"))]
   ["split parts" (try (pr-str (Regex/split (Regex/compile! ",") "a,b,c,d" (list (tuple :parts 2)))) (catch e "#error"))]
   ["split captures" (try (pr-str (Regex/split (Regex/compile! "(\\*)([a-z]+)(\\*)") "x *bold* y *z*" (list (tuple :include_captures true)))) (catch e "#error"))]
   ["split captures none" (try (pr-str (Regex/split (Regex/compile! "\\d") "abc" (list (tuple :include_captures true)))) (catch e "#error"))]
   ["utf8 verb" (try (pr-str (Regex/run (Regex/compile! "(*UTF8)é+") "aééb")) (catch e "#error"))]
   ["utf8 verb scan" (try (pr-str (Regex/scan (Regex/compile! "(*UTF8)[×÷]") "2×3÷4")) (catch e "#error"))]
   ["get_env unset" (try (pr-str (System/get_env "BL_PORTABLE_LEAF_TEST_UNSET")) (catch e "#error"))]
   ["app env" (try (pr-str (do (Application/put_env :bl_portable_test :k 42) (Application/get_env :bl_portable_test :k))) (catch e "#error"))]
   ["app env default" (try (pr-str (Application/get_env :bl_portable_test :missing :dflt)) (catch e "#error"))]
   ["json encode" (try (pr-str (json/encode {:b [1 2 nil] :a "x\"é\n" "c" true :d (list 1 "two")})) (catch e "#error"))]
   ["json pretty" (try (pr-str (json/encode {:a [1 {:b 2}] :e []} {:pretty 2})) (catch e "#error"))]
   ["json decode" (try (pr-str (json/decode "{\"a\":[1,2.5,null,{\"b\":true}],\"z\":\"é\"}")) (catch e "#error"))]
   ["json decode kw" (try (pr-str (json/decode "{\"a\":{\"b\":1}}" {:keys :keyword})) (catch e "#error"))]
   ["json bad" (try (pr-str (json/decode "{")) (catch e "#error"))]
   ["json roundtrip" (try (pr-str (json/decode (json/encode {:k [1 "x" {:y nil}]}))) (catch e "#error"))]
   ["literate namespace" (try (pr-str (lit/hello "js")) (catch e "#error"))]
   ["path join" (try (pr-str (Path/join "a" "b")) (catch e "#error"))]
   ["path join slashes" (try (pr-str (Path/join "a/" "/b/")) (catch e "#error"))]
   ["path join root" (try (pr-str (Path/join "/" "x")) (catch e "#error"))]
   ["path join empty" (try (pr-str (Path/join "" "x")) (catch e "#error"))]
   ["basename" (try (pr-str (Path/basename "a/b.txt")) (catch e "#error"))]
   ["basename trailing" (try (pr-str (Path/basename "a/b/")) (catch e "#error"))]
   ["dirname" (try (pr-str (Path/dirname "a/b/c")) (catch e "#error"))]
   ["dirname bare" (try (pr-str (Path/dirname "b")) (catch e "#error"))]
   ["dirname root" (try (pr-str (Path/dirname "/b")) (catch e "#error"))]
   ["extname" (try (pr-str (Path/extname "a/b.tar.gz")) (catch e "#error"))]
   ["extname none" (try (pr-str (Path/extname "a/b")) (catch e "#error"))]
   ["extname dotfile" (try (pr-str (Path/extname ".bashrc")) (catch e "#error"))]
   ["rootname" (try (pr-str (Path/rootname "a/b.txt")) (catch e "#error"))]])
