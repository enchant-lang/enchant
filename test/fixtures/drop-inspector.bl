;; Invoked by the isolated portable-drop smoke check with bl --cold serve.
(ns drop-inspector (:require [live.app :as app]))

(def served
  (app/serve {:principal (fn [_] :developer)
              :routes [["/" (fn [_] [:main "App"])]]}
             {:ip (tuple 127 0 0 1) :port 0 :log false
              :devtools {:authorize #(= :developer %)}}))

(try
  (doseq [[path marker] [["/" "enchant-inspector-source"]
                         ["/__enchant/inspector.js" "Open dev tools"]
                         ["/__enchant/inspector.css" ":host"]]]
    (let [request (erlang/apply :Elixir.Plug.Test :conn (list "GET" path ""))
          response (app/router served request)]
      (when-not (and (= 200 (:status response))
                     (String/contains? (:resp_body response) marker))
        (throw (ex-info "Packaged development inspector missing" {:path path})))))
  (finally (app/stop! served)))
;; A successful serve normally parks the VM.
(erlang/halt 0)
