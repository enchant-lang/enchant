;; Focused source preflight on a retained SDK. Compile candidate libraries in
;; private namespaces; never replace the running SDK's protected definitions.
;; Actual SDK qualification uses the ordinary canonical test files unchanged.
(ns test.support.projection-candidate (:require [bl.json :as json]))

(def INVENTORY
  (json/decode (File/read! (Path/join (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
                                   "scripts/projection-preflight.json"))))
(def SOURCES (get INVENTORY "sources"))
(def TESTS (get INVENTORY "tests"))

(defn- cache-client-source [prefix source]
  ;; Native VM-lifetime owners require SDK identity. Delegate unchanged
  ;; infrastructure to the exact SDK; compile the candidate client functions.
  (let [start (elem (binary/match source "(defn computation-revision") 0)
        stop (elem (binary/match source "(defn clear!") 0)
        delegates '(key-data footprint fingerprint ready! lookup put! clear! key-identities stats)
        arities '[[x depth] [x] [x] [name] [name key revision] [name key revision value] [name] [name] [name]]]
    (str "(ns " prefix ".cache (:require [data.bounded-cache :as sdk-cache]))\n"
      (apply str (map (fn [name args]
         (str "(defn " name " " (pr-str args) " (sdk-cache/" name
              (apply str (map #(str " " %) args)) "))\n")) delegates arities))
      (binary/part source start (- stop start)))))

(defn with-candidate* [action]
  (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
        prefix (str "projection-preflight-" (erlang/unique_integer (list :positive)))
        dir (Path/join (System/tmp_dir!) prefix) modules (atom []) previous (BeamLisp.Env/capture)
        ;; Replace longer names before their prefixes; replacement names have
        ;; no canonical namespace substring and cannot be rewritten twice.
        renames (sort-by (fn [[_ canonical _]] (- (count canonical))) SOURCES)
        rename (fn [text]
                 (reduce (fn [text [_ canonical suffix]]
                           (String/replace text
                             (Regex/compile! (str "(?<![:A-Za-z0-9_.-])" (Regex/escape canonical) "(?![A-Za-z0-9_.-])"))
                             (str prefix "." suffix))) text renames))]
    (File/mkdir_p! dir)
    (try
      (doseq [[file _ suffix] SOURCES]
        (let [path (Path/join dir (str suffix ".bl"))]
          (let [source (BeamLisp.Loader/read_source (Path/join root file))]
            (File/write! path (if (= suffix "cache") (cache-client-source prefix source) (rename source))))
          (let [beams (BeamLisp.AOT/compile_file path (list (tuple :output_dir dir) (tuple :mark_loaded? true)))]
            (swap! modules into (mapv #(elem % 0) beams)))))
      (action (mapv (fn [path] {:path path :src (rename (File/read! (Path/join root path)))}) TESTS) rename)
      (finally
        (BeamLisp.Env/bind previous)
        (doseq [module @modules] (code/purge module) (code/delete module))
        (File/rm_rf! dir)))))

(defn with-candidate [action]
  (with-candidate* (fn [entries _rename] (action entries))))
