; warm_request_env_test.bl — a warm request carries the VM's engine environment.
;
; A command attached to a warm VM is given the CLIENT's environment, with every
; daemon-boot variable the client did not send explicitly tombstoned. The
; checkout launcher exports the engine variables (`BL_ROOT`, `BL_EBIN`) on the
; process that BOOTS the VM, not on the attach client, so tombstoning removed
; them from every warm request. `test/bl/seed_support.bl`'s `floor-ebin` then
; fell back to `<root>/build`, and `seed_runtime_abi_test` refused its floor on
; a checkout without one ("incomplete boot closure in <root>/build"). These are
; properties of the running image and a client must neither remove nor relabel
; them, so the daemon leaves the VM's own values in place.

;
; The variables belong to the VM, not to every `bl` process: `bin/bl` (the
; checkout launcher) exports them when it boots the VM, and a VM started from
; an SDK drop (CI's `bl test`) has neither. So the property is read against the
; VM's own OS table (`os:getenv`, which the request overlay does not touch):
; whatever engine variable the VM was booted with, the command sees, unchanged.

(ns warm-request-env-test
  (:require [vm.osenv]))

(defn- vm-own [name]
  (let [v (os/getenv (String/to_charlist name))]
    (when (not= v false) (List/to_string v))))

(deftest the-warm-request-sees-the-vms-engine-environment
  (doseq [name ["BL_ROOT" "BL_EBIN"]]
    (is (not (and (some? (vm-own name)) (contains? (vm.osenv/overlay) name)))
        (str "the request overlay neither removes nor relabels the VM's " name))
    (when-let [own (vm-own name)]
      (is (= own (System/get_env name))
          (str "the VM's " name " is visible to the command, unrelabelled"))))
  (when (vm-own "BL_EBIN")
    (is (File/dir? (System/get_env "BL_EBIN"))
        "and names a directory")
    (is (some? (System/get_env "BL_ROOT"))
        "a VM booted with an image ebin also carries its root")))
