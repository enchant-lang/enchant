; env.bl :tools — the programs a tree runs, declared as Nix packages.
(ns bl.env-tools-test
 (:require [bl.env :as env] [bl.tools :as tools]))

(defn- norm [tools-value] (env/normalize {:name "t" :tools tools-value} "/tmp/t" "/tmp/t/env.bl"))

(deftest a-string-names-the-package-and-the-executable-is-the-tool-name
 (let [p (norm {"scheme" "nixpkgs#chez" "gcc" "nixpkgs#gcc"})]
  (is (= {"scheme" {:package "nixpkgs#chez" :bin "scheme"} "gcc" {:package "nixpkgs#gcc" :bin "gcc"}} (:tools p)))
  (is (empty? (:errors p)))
  (is (= (:tools p) (tools/declared p)))))

(deftest a-map-can-name-another-executable-and-keyword-names-are-names
 (let [p (norm {:chez {:package "nixpkgs#chez" :bin "scheme"}})]
  (is (= {"chez" {:package "nixpkgs#chez" :bin "scheme"}} (:tools p)))
  (is (empty? (:errors p)))))

(deftest malformed-declarations-are-errors-and-are-left-out
 (doseq [bad [{"a b" "nixpkgs#x"} {"x" ""} {"x" "nixpkgs#has space"} {"x" {:package "nixpkgs#x" :bin "../sh"}}
              {"x" {:package "nixpkgs#x" :extra 1}} {"x" 3}]]
  (let [p (norm bad)]
   (is (= {} (:tools p)))
   (is (= 1 (count (filter #(clojure.string/includes? % ":tools") (:errors p)))))))
 (is (seq (:errors (norm [1 2])))))

(deftest no-declaration-is-no-tools-and-no-error
 (let [p (env/normalize {:name "t"} "/tmp/t" "/tmp/t/env.bl")]
  (is (= {} (:tools p)))
  (is (empty? (:errors p)))
  (is (= {} (:tools (env/empty-project "/tmp/t"))))))

(deftest an-undeclared-tool-is-refused-by-name
 (is (thrown? (tools/executable (norm {}) "scheme"))))
