; lazy_shared_callback_test.bl — a lazy transformer's callback is copied once
; per chain, not once per cell, whatever it captures.
;
; Each chunk cell of `map`/`filter`/… stores a new thunk and fold recipe that
; capture the callback, and a cell stores its state by copy. A callback closing
; over a big map therefore paid several deep copies of it per cell (Backdesk,
; 2026-11-26: 2 s for a 200-element `filter`, 2 ms with `filterv`).
; `BeamLisp.LazySeq/share_callback` moves a large callback into one native cell
; and hands the chain a one-word handle.
;
; Run: ./bin/bl test test/bl/lazy_shared_callback_test.bl

(ns lazy-shared-callback-test)

(defn- big-map [n] (into {} (map (fn [i] [i (str "v" i)]) (range n))))

(deftest a-large-callback-becomes-a-handle-and-a-small-one-stays-itself
 (let [ctx (big-map 20000)
       f (fn [x] (contains? ctx x))
       small (fn [x] (inc x))
       shared (BeamLisp.LazySeq/share_callback f)]
  (is (erlang/> (BeamLisp.LazyMemo/estimate_bytes f) 100000))
  (is (erlang/< (BeamLisp.LazyMemo/estimate_bytes shared) 1024))
  (is (identical? small (BeamLisp.LazySeq/share_callback small)))
  (is (identical? inc (BeamLisp.LazySeq/share_callback inc)))
  (is (= :k (BeamLisp.LazySeq/share_callback :k)))
  (is (= [true false] [(shared 1) (shared -1)]))))

(deftest every-shared-transformer-answers-what-the-eager-form-does
 (let [ctx (big-map 20000)
       keep? (fn [x] (and (contains? ctx 7) (odd? x)))
       f (fn [x] (if (contains? ctx 7) (* 2 x) x))
       g (fn [a b] (if (contains? ctx 7) (+ a b) 0))
       xs (vec (range 500))]
  (is (= (filterv keep? xs) (vec (filter keep? xs))))
  (is (= (vec (remove keep? xs)) (filterv (complement keep?) xs)))
  (is (= (mapv f xs) (vec (map f xs))))
  (is (= (mapv g xs xs) (vec (map g xs xs))))
  (is (= (filterv even? (range 100)) (vec (take-while #(and (contains? ctx 7) (< % 100)) (map f xs)))))
  (is (= 400 (count (drop-while #(and (contains? ctx 7) (< % 100)) xs))))
  (is (= [1 2 4 8 16] (vec (take 5 (iterate f 1)))))
  (is (= (reduce + (filterv keep? xs)) (reduce + (filter keep? xs))))
  (is (= (count (filterv keep? xs)) (count (filter keep? xs))))))

(deftest another-process-realizes-a-shared-chain
 (let [ctx (big-map 20000)
       s (filter (fn [x] (and (contains? ctx 3) (even? x))) (range 300))]
  (is (= (filterv even? (range 300)) @(future (vec s))))
  (is (= (filterv even? (range 300)) (vec s)))))

(deftest the-per-process-cache-is-bounded-and-eviction-stays-correct
 (let [ctx (big-map 5000)
       fs (mapv (fn [i] (BeamLisp.LazySeq/share_callback (fn [x] (if (contains? ctx 1) (+ x i) x)))) (range 20))]
  (is (erlang/=< (count (erlang/get :bl_lazy_shared_keys)) 8))
  (is (= (vec (range 20)) (mapv (fn [f] (f 0)) fs)))
  (is (= (vec (range 20)) @(future (mapv (fn [f] (f 0)) fs))))
  (is (erlang/=< (count (erlang/get :bl_lazy_shared_keys)) 8))))

(defn- ms [f]
 (let [t (System/monotonic_time :microsecond) _ (f)]
  (/ (- (System/monotonic_time :microsecond) t) 1000.0)))

;; The floor under the copy model: sharing pays ONE measure and ONE native copy
;; of the capture per chain (a cell may be forced by another process and outlive
;; its creator, so the callback must live off-heap). Before, every 32-element
;; cell paid several. So a long chain stops scaling with the capture; a chain of
;; one or two cells costs about what it did.
(deftest a-big-capture-no-longer-scales-a-long-chain
 (let [long-xs (vec (range 4000))
       chain (fn [ctx xs] (fn [] (count (doall (filter (fn [c] (and (contains? ctx 1) (odd? c)))
                                                       (filter even? xs))))))
       ctx-small (big-map 10) ctx-large (big-map 30000)
       f (fn [x] (contains? ctx-large x))
       measure (ms #(BeamLisp.LazyMemo/estimate_bytes f))
       share (ms #(BeamLisp.LazySeq/share_callback f))
       short-small (ms (chain ctx-small (vec (range 200))))
       short-large (ms (chain ctx-large (vec (range 200))))
       long-small (ms (chain ctx-small long-xs))
       long-large (ms (chain ctx-large long-xs))
       eager-large (ms #(count (filterv (fn [c] (and (contains? ctx-large 1) (odd? c))) (filterv even? long-xs))))]
  (println "LAZY-SHARED-BENCH measure" measure "share" share
           "short-small" short-small "short-large" short-large
           "long-small" long-small "long-large" long-large "eager-large" eager-large)
  ;; ~63 cells: before, the large capture made this ~60 copies of a 30k map.
  (is (erlang/< long-large (erlang/+ (erlang/+ (erlang/* 3 share) (erlang/* 3 long-small)) 5.0)))))

;; ── the same review's other reducible costs (2026-11-26) ──────────────────

(deftest sort-by-computes-each-key-once-and-stays-stable
 (let [calls (atom 0)
       xs (mapv (fn [i] {:k (mod i 7) :i i}) (range 300))
       sorted (sort-by (fn [m] (swap! calls inc) (:k m)) xs)]
  (is (= 300 @calls))
  (is (list? sorted))
  (is (= (sort-by :k > [{:k 1} {:k 3} {:k 2}]) [{:k 3} {:k 2} {:k 1}]))
  ;; stable: equal keys keep input order
  (is (= (map :i (filter #(= 0 (:k %)) sorted)) (filterv #(= 0 (mod % 7)) (range 300))))))

(deftest last-of-a-vector-is-direct
 (is (= 3 (last [1 2 3])))
 (is (nil? (last [])))
 (is (= 3 (last '(1 2 3))))
 (is (= 9999 (last (vec (range 10000))))))

(deftest a-map-or-a-string-walks-through-a-cursor
 (let [m (into {} (map (fn [i] [i (* i i)]) (range 2000)))
       s (apply str (repeat 100 "ab"))]
  (is (= m (into {} (map (fn [[k v]] [k v]) m))))
  (is (= (mapv identity m) (vec (map identity m))) "the same entries mapv sees")
  (is (= (filterv (fn [[k _]] (odd? k)) m) (vec (filter (fn [[k _]] (odd? k)) m))))
  (is (= 1000 (count (filter (fn [[k _]] (even? k)) m))))
  (is (= 100 (count (filter #(= "a" %) s))))
  (is (= (seq s) (seq (apply str (map identity s)))))
  (is (= [] (vec (map identity {}))))
  (is (= [] (vec (filter identity ""))))))
