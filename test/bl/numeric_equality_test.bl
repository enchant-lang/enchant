(ns numeric.equality-test (:require [decimal :as d]))

;; Algebraic laws and representation boundaries, rather than a second copy
;; of the rational comparison implementation. Run on the proposed SDK.
(def finite-numbers
 [0 -0.0 0M 0.00M 1 1.0 1M 1.00M 1.5 1.5M 1.50M
  0.1 0.1M 0.5 0.50M 9007199254740992 9007199254740992.0
  9007199254740993 -9007199254740993])

(deftest finite-numeric-equality-is-an-equivalence-relation
 (doseq [a finite-numbers]
  (is (= a a)))
 (doseq [a finite-numbers b finite-numbers]
  (is (= (= a b) (= b a)))
  (is (= (= a b) (zero? (compare a b)))))
 (doseq [a finite-numbers b finite-numbers c finite-numbers]
  (when (and (= a b) (= b c)) (is (= a c)))))

(deftest exact-ieee-values-do-not-follow-printed-approximations
 (is (= 1.5M 1.5))
 (is (= 1.5 1.50M))
 (is (= 1.5M 1.50M))
 (is (= 0.50M 0.5))
 (is (not= 0.1M 0.1))
 (is (not= 9007199254740993 9007199254740992.0)))

(deftest equality-is-compositional-and-metadata-insensitive
 (doseq [a finite-numbers b finite-numbers]
  (is (= (= a b) (= [a] [b])))
  (is (= (= a b) (= (list a) [b])))
  (is (= (= a b) (= {:value a} {:value b})))
  (is (= (= a b) (= (tuple :meta a {:origin :ignored}) b)))))

(deftest equal-values-have-equal-semantic-projections
 (doseq [a finite-numbers b finite-numbers]
  (when (= a b)
   (is (= (BeamLisp.Ns.Rt/semantic-key a) (BeamLisp.Ns.Rt/semantic-key b)))
   (is (= (BeamLisp.Ns.Rt/semantic-hash a) (BeamLisp.Ns.Rt/semantic-hash b))))))

(deftest decimal-representation-equality-is-explicit-and-preserves-scale
 (is (d/same-representation? 1.50M 1.50M))
 (is (not (d/same-representation? 1.5M 1.50M)))
 (is (not (d/same-representation? 1.5M 1.5)))
 (is (not (d/same-representation? 1M 1)))
 (is (= 2 (d/scale 1.50M)))
 (is (= 150 (d/unscaled 1.50M)))
 (is (= "1.50" (d/plain-str 1.50M))))

(run-tests)
