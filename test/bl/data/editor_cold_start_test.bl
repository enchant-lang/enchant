;; The first editor request must prepare its memo owner before taking evidence.
(ns data.editor-cold-start-test
  (:require [runtime.activity :as activity] [lsp]))

(deftest the-first-editor-request-retains-before-the-second
  (let [reader (activity/open)
        src "(ns cold.editor) (defn leaf [x] (+ x 319))"
        latest #(first (:recent (activity/snapshot reader)))]
    (try
      (lsp/analyzed src)
      (is (= 1 (get-in (latest) [:counts :computed])))
      (is (= 0 (get-in (latest) [:counts :unstable] 0)))
      (is (pos? (get-in (latest) [:cache :kept-bytes] 0)))
      (lsp/analyzed src)
      (is (= 1 (get-in (latest) [:counts :reused])))
      (is (= 0 (get-in (latest) [:counts :computed] 0)))
      (finally (activity/close! reader)))))
