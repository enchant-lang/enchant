(ns data.projection-candidate-test
  (:require [test.support.projection-candidate :as candidate] [reload.ward :as ward]))

(deftest current-projection-sources-on-one-retained-sdk
  (candidate/with-candidate
    (fn [entries]
      (let [result (ward/run entries)]
        (doseq [file (:files result)]
          (println "projection-source-preflight" (:path file) (:status file) (:totals file))
          (doseq [report (:reports file)]
            (when (contains? #{:fail :error} (:type report)) (println (pr-str report))))
          (doseq [error (:errors file)] (println "projection-preflight-error" (pr-str error)))
          (is (= :passed (:status file)) (pr-str (dissoc file :src))))
        (is (= (count candidate/TESTS) (count (:files result)))))
        (is (:ok? result))))))
