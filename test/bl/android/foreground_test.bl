(ns android.foreground-test
  (:require [android.foreground :as fg]))

;; The service itself runs on a device; here: what the build ships, and the
;; extras a start sends.

(def root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd)))
(def manifest (File/read! (Path/join root "priv/android/manifest.xml")))
(def kotlin (File/read! (Path/join root "priv/android/kotlin/BlForeground.kt")))

(deftest the-template-ships-the-service
  (is (includes? manifest "android:name=\"io.beamlisp.android.BlForegroundService\""))
  (is (includes? manifest "android:foregroundServiceType=\"specialUse\""))
  (is (includes? manifest "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"))
  (is (includes? manifest "android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE") "Android 14 requires the subtype for specialUse")
  (is (includes? kotlin "class BlForegroundService : Service()"))
  (is (includes? kotlin "package io.beamlisp.android"))
  (is (= fg/service-class "io.beamlisp.android.BlForegroundService")))

(deftest a-start-says-what-it-was-given
  (is (= [["title" "Pocket Harness"] ["text" "Watching work"]] (fg/intent-extras {:title "Pocket Harness" :text "Watching work"})))
  (is (= [["text" "Watching"]] (fg/intent-extras {:text "Watching"})))
  (is (= [] (fg/intent-extras {}))))

(deftest off-the-phone-it-says-no
  (is (= false (fg/start! {:text "x"})) "no JVM on the desk: refused, not thrown")
  (is (= false (fg/stop!))))
