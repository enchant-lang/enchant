(ns veritas.assumption-domain-baseline-test
 (:require [formal.term :as t] [formal.value :as value] [formal.query :as query] [formal.logic :as logic]))

(deftest semantic-assumptions-carry-their-domain-and-model-admission
 (let [x (t/variable "assumption.domain.x" t/Int)
       restricted (value/make x {:constraints [(t/ge x (t/int 5))]
                                 :scope {:mode :bounded :input [5 :unbounded]}})
       premise (value/scalar (t/bool true) [restricted] {})
       problem (query/prove (t/gt x (t/int 0)) {:assumptions [premise]})
       outside (query/sat {:assumptions [(assoc premise :within (t/bool false))]})]
  (doseq [backend [:z3 :oxiz]]
   (is (= :proved (:verdict (logic/run {:backend backend} problem))))
   (is (= :unsat (:verdict (logic/run {:backend backend} outside)))))
  (is (= :bounded (get-in problem [:scope :mode])))))
