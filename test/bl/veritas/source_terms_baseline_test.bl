(ns veritas.source-terms-baseline-test
 (:require [veritas.property :as p] [veritas :as v]))

(deftest behavioral-question-is-term-based
 (is (= :terms (:engine (p/prove {:backend :z3}
     '(defn floor [c] (if (< c 0) 0 c)) '(>= result 0) (v/int-of -1000000 1000000))))))
(deftest zero-divisor-is-a-replayed-source-failure
 (let [r (p/prove {:backend :z3} '(defn boom [n] (quot n 0)) '(= result 0) (v/int-of 1 10))]
  (is (and (= :refuted (:modality r)) (= true (:crash r))))))
(deftest unsupported-is-explicit-before-sampling
 (is (= :unsupported (:modality (p/prove {:backend :z3}
     '(defn ident [n] n) '(string? (str result)) (v/int-of 0 10))))))
(deftest legacy-port-is-refused
 (is (try (p/prove true '(defn ident [n] n) '(= result n) (v/int-of 0 10)) false
          (catch _ true))))
(deftest solver-claim-is-not-a-checked-source-proof
 (is (= :solver-claim (:modality (p/prove {:backend :z3}
     '(defn ident [n] n) '(= result n) (v/int-of 0 1000000))))))
(run-tests)
