(ns veritas.term-boundary-baseline-test (:require [veritas :as v] [oracle]))
(deftest native-unsat-is-a-solver-claim
 (is (= :solver-claim (:modality (v/for-all {} "n" (v/int-of 0 100) '(>= n 0))))))
(deftest false-is-a-real-failing-enumerated-value
 (let [r (v/for-all {:engine :enumerate} "b" (v/one-of false true) 'b)]
  (is (and (= :refuted (:modality r)) (= false (:witness r))))))
(deftest unsuccessful-sampling-does-not-prove-absence
 (let [r (v/exists {:engine :sample} "x" (v/any-of) false)]
  (is (and (= :unknown (:modality r)) (not (:none r)))))))
(deftest enum-membership-knows-payload-constructors
 (is (not (v/gen-domain? (v/enum-of [:on :int] :off) :on))))
(deftest every-string-sample-belongs-to-its-declared-domain
 (let [g (v/string-of "usr_" 8 12)]
  (is (every? #(v/gen-domain? g %) (v/gen-sample g 0 5)))))
(deftest coverage-respects-each-clauses-parameter-name
 (let [src "(defn sign ([a] :when (>= a 0) :p) ([renamed] :when (< renamed 0) :n))"]
  (is (= :solver-claim (:modality (v/covers {} src (v/int-of -1000000 1000000)))))))
(deftest the-typed-oracle-sees-a-complete-generator-question
 (let [seen (atom [])
       r (oracle/with-query-handler
          (fn [question _] (swap! seen conj question)
            (oracle/query-answer question {:phase :query :solver-status :unknown :verdict :unknown}))
          #(v/for-all {} "n" (v/int-of 0 100) '(>= n 0)))]
  (is (and (= 1 (count @seen)) (= 1 (:formal/query (first @seen))) (= :unknown (:modality r))))))
(run-tests)
