; test/bl/js_portable_leaves_test.bl — the host functions a renderer reaches
; (rounding, number parsing, calendar days, URI forms, Regex.split, scoped
; binary:match, Path, bl.json's twin, a literate namespace …) answer in JS
; exactly as on the BEAM.
;
; The corpus (test/js/portable/portable/: leafcases.bl and lit.bl.org) is
; copied into a fresh directory under UNIQUE namespace names for each run, so
; neither the cwd, a checkout's realm nor an earlier load can supply a
; different copy. It runs on the BEAM first, then through the SAME build
; `bl js build` runs; Node prints the JS side. Skipped when node is absent.
(ns bl.js.portable-leaves-test
  (:require [bl.js :as js] [bl.util :as u]))

(def ^:private corpus "test/js/portable/portable")

(defn- lines [pairs] (join "\n" (map (fn [[label v]] (str label "\t" v)) pairs)))

(deftest renderer-host-functions-answer-as-on-the-beam
  (if (nil? (System/find_executable "node"))
    (is true "node not installed: skipped")
    (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
          tag (str "p" (System/unique_integer (u/to-list [:positive])))
          dir (str (System/tmp_dir!) "/bl-js-portable-" tag)
          src (str dir "/src") out (str dir "/out")
          ns-main (str tag ".leafcases")
          copy! (fn [file] (File/write! (str src "/" tag "/" file)
                                        (String/replace (File/read! (str root "/" corpus "/" file)) "portable." (str tag "."))))]
      (File/mkdir_p! (str src "/" tag))
      (copy! "leafcases.bl")
      (copy! "lit.bl.org")
      (try
        (BeamLisp.Env/add_search_path src)
        (BeamLisp.Loader/ensure_loaded ns-main)
        (let [beam (lines ((BeamLisp.Env/fetch! ns-main "all")))]
          (js/build! ns-main {:paths (list src) :out out})
          (let [script (str out "/side.mjs")
                _ (File/write! script
                    (str "const C = await import('./ns/" ns-main ".mjs');\n"
                         "const rows = C.d_all();\n"
                         "const out = [];\n"
                         "for (const row of rows) { const [label, v] = [...row]; out.push(label + '\\t' + v); }\n"
                         "process.stdout.write(out.join('\\n'));\n"))
                [jsout code] (u/to-list (erlang/tuple_to_list (System/cmd "node" (u/to-list [script]) (u/kw [:stderr_to_stdout true]))))]
            (is (= 0 code) jsout)
            (let [b (split beam "\n") j (split jsout "\n")]
              (is (= (count b) (count j)) (str "case count " (count b) " vs " (count j)))
              (doseq [[x y] (map (fn [x y] [x y]) b j)]
                (is (= x y) (str "BEAM [" x "]  JS [" y "]"))))))
        (finally (File/rm_rf! dir))))))
