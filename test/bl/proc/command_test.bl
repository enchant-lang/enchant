(ns proc.command-test
 (:require [proc.command :as command] [proc.admission :as admission]
           [reload.generation :as generation]))

(defn- platform-executor
 "The executor package a checkout platform records in its platform.json."
 [platform]
 (let [record (when platform (Path/join platform "platform.json"))]
  (when (and record (File/regular? record))
   (get (Jason/decode! (File/read! record)) "executor"))))

(defn- executor-package
 "The exact executor package: a station's explicit one, else the one the selected
  SDK's own platform pins (the platform, directly or through the SDK's artifact)."
 []
 (or (System/get_env "STATION_COMMAND_EXECUTOR_PACKAGE")
     (platform-executor (System/get_env "BL_ARTIFACT_PLATFORM"))
     (let [sdk (System/get_env "BL_SDK_PRODUCT")
           artifact (when sdk (Path/join sdk "artifact.json"))]
      (when (and artifact (File/regular? artifact))
       (platform-executor (get (Jason/decode! (File/read! artifact)) "platform"))))
     (throw (ex-info "no command executor package: set STATION_COMMAND_EXECUTOR_PACKAGE or run under an SDK platform"
                     {:kind :command-executor-unavailable}))))

(defn- fixture [action]
 (let [root (str (System/get_env "HOME") "/tmp/command-facade-" (System/system_time :nanosecond))
       platform (str root "/platform") package (executor-package)
       before (System/get_env "BL_ARTIFACT_PLATFORM")]
  (File/mkdir_p! (str platform "/bin"))
  (File/ln_s! (str package "/bin/bl-command-executor") (str platform "/bin/bl-command-executor"))
  (File/cp! (str package "/executor.json") (str platform "/executor.json"))
  (try
   (System/put_env "BL_ARTIFACT_PLATFORM" platform)
   (action root)
   (finally
    (if before (System/put_env "BL_ARTIFACT_PLATFORM" before) (System/delete_env "BL_ARTIFACT_PLATFORM"))
    (File/rm_rf! root)))))

(defn- spec [root code]
 {:exec ["/bin/sh" "-c" code "command-fixture" root] :workspace (str root "/workspace") :cwd root
  :limits {:timeout-ms 5000 :memory-bytes 268435456 :output-bytes 65536}})

(deftest argv-output-and-nonzero-result-remain-distinct
 (fixture
  (fn [root]
   (let [output (atom []) states (atom [])
         result (command/run! (spec root "printf hello; exit 7")
                  {:on-output #(swap! output conj %) :on-state #(swap! states conj %)})]
    (is (= :exited (:status result)))
    (is (= 7 (:exit result)))
    (is (= "hello" (apply str @output)))
    (is (= true (:domain-empty result)))
    (is (= true (:output-complete result)))
    (is (= ["accepted"] (mapv #(get % "state") @states)))))))

(deftest a-failed-output-observer-drains-accepted-work-before-rethrowing
 (fixture
  (fn [root]
   (is (= :observer-failed
        (try
         (command/run! (spec root "printf begin; sleep 0.2; printf done >\"$1/completed\"")
          {:on-output (fn [_] (throw (ex-info "Controlled observer failure" {:kind :observer-failed})))})
         nil (catch error (:kind (ex-data error))))))
   (is (= "done" (File/read! (str root "/completed")))))))

(deftest cancellation-is-explicit-and-confirmed-by-the-empty-domain
 (fixture
  (fn [root]
   (let [stop (atom false)
         result (command/run! (spec root "sleep 30")
                  {:on-state (fn [_] (reset! stop true)) :cancel? #(deref stop)})]
    (is (= :cancelled (:status result)))
    (is (= true (:domain-empty result)))))))

(deftest expired-admission-does-not-create-a-workspace-or-a-child
 (fixture
  (fn [root]
   (is (= :cancelled
        (try
         (admission/with-request (admission/token (erlang/self) 0)
          #(command/run! (spec root "touch \"$1/born\"")))
         nil (catch error (:kind (ex-data error))))))
   (is (not (File/exists? (str root "/workspace"))))
   (is (not (File/exists? (str root "/born")))))))

(deftest request-local-env-and-explicit-env-never-revive-the-vms-old-values
 (fixture
  (fn [root]
   (let [before (System/get_env "STATION_COMMAND_SCOPED")
         original (System/get_env "STATION_COMMAND_REAL_ONLY")]
    (try
     (is (= "real-vm-value" (List/to_string (os/getenv (String/to_charlist "STATION_COMMAND_REAL_ONLY")))))
     (System/put_env "STATION_COMMAND_SCOPED" "request")
     (System/delete_env "STATION_COMMAND_REAL_ONLY")
     (let [out (atom [])
           declaration (spec root "printf '%s' \"$STATION_COMMAND_SCOPED:${STATION_COMMAND_REAL_ONLY-absent}\"")]
      (is (= :exited (:status (command/run! declaration {:on-output #(swap! out conj %)}))))
      (is (= "request:absent" (apply str @out)))
      (reset! out [])
      (is (= :exited (:status (command/run! (assoc declaration :env {"STATION_COMMAND_SCOPED" "explicit"})
                                {:on-output #(swap! out conj %)}))))
      (is (= "explicit:absent" (apply str @out))))
     (finally
      (if before (System/put_env "STATION_COMMAND_SCOPED" before) (System/delete_env "STATION_COMMAND_SCOPED"))
      (if original (System/put_env "STATION_COMMAND_REAL_ONLY" original) (System/delete_env "STATION_COMMAND_REAL_ONLY"))))))))

(deftest explicit-expired-budget-and-invalid-input-refuse-before-custody
 (fixture
  (fn [root]
   (doseq [[limits kind] [[{:deadline-ms (dec (System/monotonic_time :millisecond))} :cancelled]
                         [{:timeout-ms "invalid"} :invalid-command-declaration]]]
    (is (= kind
         (try (command/run! (assoc (spec root "touch \"$1/born\"") :limits limits))
              nil (catch error (:kind (ex-data error)))))))
   (is (not (File/exists? (str root "/workspace"))))
   (is (not (File/exists? (str root "/born")))))))

(deftest source-code-cannot-acquire-trusted-host-command-authority
 (fixture
  (fn [root]
   (let [sources (str root "/source") file (str sources "/command_probe/sample.bl")]
    (File/mkdir_p! (Path/dirname file))
    (File/write! file "(ns command-probe.sample (:require [proc.command :as command]))
                       (defn run [spec] (command/run! spec))")
    (let [graph (BeamLisp.Loader/with_load_path sources
                 #(generation/prepare! (generation/project-plan
                    {:application-id "command-probe" :entrypoint "command-probe.sample/run"
                     :fixed-runtime true :native-modules #{"erlang"}})))]
     (try
      (is (try (generation/invoke! graph "command-probe.sample/run" [(spec root "touch \"$1/born\"")])
               false (catch _ true)))
      (is (not (File/exists? (str root "/workspace"))))
      (is (not (File/exists? (str root "/born"))))
      (finally (generation/retire! graph))))))))

(deftest private-input-is-binary-and-child-sees-eof
 (fixture
  (fn [root]
   (doseq [input ["" (erlang/list_to_binary (list 0 1 255 10 13))]]
    (let [out (atom [])
          declaration (assoc (spec root "exec cat") :input input)
          result (command/run! declaration {:on-output #(swap! out conj %)})]
     (is (= :exited (:status result)))
     (is (= 0 (:exit result)))
     (is (= input (erlang/iolist_to_binary (to-list @out))))
     (is (= true (:domain-empty result))))))))

(deftest oversized-input-refuses-before-workspace-or-program-birth
 (fixture
  (fn [root]
   (is (= :invalid-command-declaration
        (try (command/run! (assoc (spec root "touch \"$1/born\"")
                                 :input (String/duplicate "x" 1048577)))
         nil (catch error (:kind (ex-data error))))))
   (is (not (File/exists? (str root "/workspace"))))
   (is (not (File/exists? (str root "/born")))))))
