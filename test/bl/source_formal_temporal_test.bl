(ns source-formal-temporal-test (:require [reload.generation :as generation]))

(deftest a-selected-source-function-uses-the-term-temporal-consumer
 (let [graph (generation/prepare!
              {:application-id "term-temporal-source"
               :stable-namespaces #{"datom.time" "formal.temporal"}
               :sources {"temporal.source"
                (str "(ns temporal.source (:require [datom.time :as time] [formal.temporal :as temporal])) "
                     "(defn answer [engine] "
                     " (let [start (temporal/endpoint-range \"source.temporal.start\" 0 4) "
                     "       a (temporal/span start 5)] "
                     "  (time/overlap-verdict {:backend engine} a {:from 2 :to 3})))")}})]
  (try
   (doseq [engine [:z3 :oxiz]]
    (is (= :possible (generation/invoke! graph "temporal.source/answer" [engine]))))
   (is (= :retired (:status (generation/retire! graph))))
   (finally (generation/retire! graph)))))
