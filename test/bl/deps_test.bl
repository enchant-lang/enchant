; Contract-derived package responses and the client transport use the selected SDK.
(ns test.deps (:require [veritas.mock :as m]))
(def options {:backend :z3})
(def package-contract
 (m/contract-from [["versions" "Int"] ["retired" "Int"]] ['(>= versions 1) '(<= retired versions)]))
(deftest the-contract-is-realizable
 (is (= :witnessed (:modality (m/synth options package-contract)))))
(deftest a-contract-is-the-mock
 (let [result (m/synth options package-contract) value (:value result)]
  (is (= :witnessed (:modality result)))
  (is (>= (:versions value) 1)) (is (<= (:retired value) (:versions value)))))
(deftest the-mock-retains-its-answer
 (let [server (m/make-mock options package-contract "versions")]
  (is (= (:value (m/answer server 4)) (:value (m/answer server 4))))
  (is (not= (:value (m/answer server 4)) (:value (m/answer server 9))))))
(deftest a-boundary-keeps-its-global-optimality-claim
 (let [result (m/synth-boundary options package-contract "versions" :min)]
  (is (= :solver-claim (:optimality result)))
  (is (= 1 (get-in result [:value :versions])))))
(deftest a-forbidden-response-is-outside-the-contract
 (let [result (m/synth-invalid options package-contract)]
  (is (= :witnessed (:modality result)))
  (is (not (m/check options package-contract (:value result))))))

; ── the client, over a transport that is a VALUE (no solver involved) ──────

(def q
  "A double quote, built rather than escaped: an escape inside a `.bl` string is
   the kind of thing that silently truncates instead of failing loudly (W5 paid
   for that lesson in a compiler docstring)."
  (str (binary/encode_unsigned 34)))

(defn doc-for
  "An API document with `n` versions — the shape the contract describes, written
   out so this test does not need a solver to have one."
  [n]
  (str "{" q "name" q ":" q "fake" q "," q "releases" q ":["
       (join "," (map (fn [i] (str "{" q "version" q ":" q "1." i ".0" q
                                   "," q "checksum" q ":" q "00" q "}"))
                      (range 0 n)))
       "]}"))

; The valid-document path is covered where it belongs: `test/bl/build_deps_test.bl`
; builds real API documents and real tarballs with Erlang's own tooling, and
; drives the client through a transport. What this file adds is the CONTRACT
; (above) and the client's decisions that need no well-formed document at all —
; asserting the JSON path twice, in two languages' string escaping, would be two
; places to be wrong about one thing.

(deftest the-client-asks-the-url-the-api-defines
  (let [seen (atom nil)
        t (fn [url _opts] (reset! seen url) {:error "stop here"})
        _ (hex/package t "jason")]
    (is (= "https://hex.pm/api/packages/jason" @seen)
        "the client's URL is the API's contract, not a detail of the mock")))

(deftest the-tarball-transport-is-asked-for-bytes
  (let [seen (atom nil)
        t (fn [url opts] (reset! seen [url opts]) {:error "stop here"})
        _ (hex/tarball t "jason" "1.4.4")]
    (is (= "https://repo.hex.pm/tarballs/jason-1.4.4.tar" (first @seen)))
    (is (= true (:binary? (second @seen)))
        "a tarball is fetched as bytes: decoding it as UTF-8 would corrupt it")))

(deftest an-unusable-document-is-an-error
  (let [t (fn [_url _opts] {:ok "not json at all"})
        r (hex/package t "fake")]
    (is (some? (:error r)))
    (is (nil? (:ok r)))))

(deftest a-document-with-no-releases-is-an-error
  (let [t (fn [_url _opts] {:ok "{\"name\":\"fake\"}"})
        r (hex/package t "fake")]
    (is (some? (:error r)))))

(deftest a-failing-transport-passes-through
  (let [t (fn [_url _opts] {:error "connection refused"})
        r (hex/package t "fake")]
    (is (= "connection refused" (:error r)))))

(deftest the-tarball-url-is-what-hex-serves
  (is (= "https://repo.hex.pm/tarballs/jason-1.4.4.tar"
         (hex/tarball-url "jason" "1.4.4"))))

; ── resolution: a fake registry, as a VALUE ────────────────────────────────
;
; A registry is two kinds of document: the package listing (versions only) and
; one release document per version (checksum + requirements). The fake answers
; both from a map, so each case states its registry in one place.

(defn- registry-transport
  "`reg` is `{name {vsn {:sha s :requires {dep req} :retired? b}}}`."
  [reg]
  (fn [url _opts]
    (let [tail (subs url (count "https://hex.pm/api/packages/"))
          parts (String/split tail "/")
          nm (first parts)
          pkg (get reg nm)]
      (cond
        (nil? pkg) {:error "HTTP 404"}
        (= 1 (count parts))
        {:ok (bl.json/encode {"name" nm
                              "releases" (vec (map (fn [v] {"version" v
                                                            "retirement" (if (:retired? (get pkg v)) {"reason" "x"} nil)})
                                                   (keys pkg)))})}
        :else
        (let [v (nth parts 2) r (get pkg v)]
          {:ok (bl.json/encode {"version" v "checksum" (:sha r)
                                "requirements" (into {} (map (fn [[d q]] [d {"app" d "requirement" q "optional" false}])
                                                             (or (:requires r) {})))})})))))

(def reg
  {"app"  {"0.9.0" {:sha "AA90" :requires {"lib" "~> 1.0"}}
           "0.9.3" {:sha "AA93" :requires {"lib" "~> 1.0"}}}
   "lib"  {"1.0.0" {:sha "BB10"} "1.2.0" {:sha "BB12"}
           "1.3.0" {:sha "BB13" :retired? true} "2.0.0" {:sha "BB20"}}})

(deftest resolve-picks-the-newest-satisfying-and-follows-requirements
  (let [r (deps/resolve [{:name "app" :vsn "~> 0.9"}] (registry-transport reg))]
    (is (:ok? r))
    (is (= [["app" "0.9.3" "aa93"] ["lib" "1.2.0" "bb12"]]
           (vec (map (fn [e] [(:name e) (:vsn e) (:sha e)]) (:entries r))))
        "newest 0.9.x; lib follows app's ~> 1.0, skips the retired 1.3.0 and the 2.0.0 it excludes")))

(deftest resolve-honours-an-exact-declared-version
  (let [r (deps/resolve [{:name "lib" :vsn "1.0.0"} {:name "app" :vsn "0.9.0"}] (registry-transport reg))]
    (is (:ok? r))
    (is (= "1.0.0" (:vsn (first (filter (fn [e] (= "lib" (:name e))) (:entries r))))))))

(deftest resolve-reports-a-conflict-with-both-sides
  (let [r (deps/resolve [{:name "lib" :vsn "2.0.0"} {:name "app" :vsn "0.9.3"}] (registry-transport reg))]
    (is (not (:ok? r)))
    (is (includes? (:why r) "lib 2.0.0 was chosen for env.bl"))
    (is (includes? (:why r) "app 0.9.3 requires ~> 1.0"))))

(deftest resolve-names-an-unknown-package
  (let [r (deps/resolve [{:name "nope" :vsn "1.0.0"}] (registry-transport reg))]
    (is (not (:ok? r)))
    (is (includes? (:why r) "nope"))))

(deftest lock-writes-the-resolution-and-keeps-path-entries
  (let [dir (str (System/tmp_dir) "/bl-lock-" (erlang/unique_integer (list :positive)))]
    (File/mkdir_p! dir)
    (deps/write-lock! dir [{:name "mine" :vsn "0.1.0" :sha "cc" :source :path}])
    (deps/lock! dir [{:name "app" :vsn "0.9.3"}] (registry-transport reg))
    (is (= ["app" "lib" "mine"] (vec (map :name (:deps (deps/read-lock dir))))))
    (is (= :path (:source (first (filter (fn [e] (= "mine" (:name e))) (:deps (deps/read-lock dir)))))))
    (File/rm_rf! dir)))
