(ns auth.namespace-examples-test)
(deftest all-five-example-sets-execute-with-native-project-imports
 (let [root (str (System/fetch_env! "BL_TEST_SOURCE_ROOT") "/examples/namespace-world/")]
  (doseq [file ["01-require/functions.bl" "01-require/allowlist.bl"
               "02-identity/tasks.bl" "02-identity/adapters.bl"
               "03-effects/admission.bl" "03-effects/proof.bl"
               "04-interfaces/artifact.bl" "04-interfaces/mismatch.bl"
               "05-lifetime/retirement.bl" "05-lifetime/failures.bl"]]
   (is (do (BeamLisp/run_file (str root file)) true)))))
(run-tests)
