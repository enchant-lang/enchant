; lazy_clean_capture_test.bl — a lazy cell costs O(1) BL work whatever it
; captures or publishes, and cycles are still detected, at force time.
;
; Big-O item M (research/native-seed/speed/native-speed.bl.org). A lazy cell
; used to walk its thunk's captured environment at create, and its value at
; publish, to feed the NIF's `would_cycle` edges; a bounded identity memo of
; "clean" big values made re-captures cheap, but ANF nodes (fewer than eight
; keys) never qualified, so nested emission re-walked every subtree at every
; level. The walk, the memo and the edges are gone. This file asserts the
; contract that replaced them:
;   * creating or publishing a cell records no memo-graph edge (so a data
;     cycle that the old walk refused is accepted), and the walk is gone;
;   * a value aliasing its own node is still terminal `:cyclic_memo`;
;   * a re-entrant force is still terminal `:recursive_force`;
;   * two processes forcing each other's running cells raise `:recursive_force`
;     instead of waiting forever;
;   * a value that merely embeds its own node is ordinary data.
;
; Run: ./bin/bl test test/bl/lazy_clean_capture_test.bl

(ns lazy-clean-capture-test)

(defn- force-reason [lazy]
  (try (do (BeamLisp.LazySeq/force lazy) :no-error)
       (catch BeamLisp.LazySeq.ForceError e (erlang/map_get :reason e))))

;; If create walked the thunk's capture, `inner`'s cell would hold an edge to
;; `outer`'s resource, and publishing `outer` with a value holding `inner`
;; would close a cycle in the NIF graph and answer `:cycle`. With no walk, the
;; graph has no edges and the publication is accepted.
(deftest creating-a-cell-records-no-edges-for-its-capture
  (let [outer (BeamLisp.LazySeq/new (fn [] :outer))
        inner (BeamLisp.LazySeq/new (fn [] (list outer)))
        resource (erlang/map_get :resource outer)
        current (BeamLisp.LazyMemo/read_versioned resource)]
    (is (= :ok (BeamLisp.LazyMemo/exchange_version resource (erlang/element 1 current)
                 (tuple :completed (list inner)) (list (erlang/map_get :resource inner)))))
    (is (erlang/=:= (list inner) (BeamLisp.LazySeq/force outer)))))

(deftest publishing-records-no-edges-for-the-value
  ;; `a` publishes a value holding `b`; then `b` publishes a value holding `a`.
  ;; The old publish walk refused the second as a retained cycle.
  (let [holder (atom nil)
        a (BeamLisp.LazySeq/new (fn [] (list :a @holder)))
        b (BeamLisp.LazySeq/new (fn [] (list :b a)))]
    (reset! holder b)
    (is (erlang/=:= b (second (BeamLisp.LazySeq/force a))))
    (is (erlang/=:= a (second (BeamLisp.LazySeq/force b))))))

(deftest the-walk-and-the-clean-value-memo-are-gone
  (doseq [[f n] [[:dependencies 1] [:deps_walk 6] [:deps_env 3] [:deps_clean_hit? 2]
                 [:deps_clean_remember! 1] [:plain! 1]]]
    (is (not (erlang/function_exported :Elixir.BeamLisp.LazyMemo f n)) (str f "/" n))))

(deftest a-value-aliasing-its-own-node-is-cyclic
  (let [holder (atom nil)
        self (BeamLisp.LazySeq/new (fn [] @holder))]
    (reset! holder self)
    (is (= :cyclic_memo (force-reason self)))
    (is (= (tuple :terminal :cyclic_memo) (BeamLisp.LazySeq/memo_state self))))
  (let [holder (atom {})
        left (BeamLisp.LazySeq/new (fn [] (:right @holder)))
        right (BeamLisp.LazySeq/new (fn [] (:left @holder)))]
    (reset! holder {:left left :right right})
    (is (erlang/=:= right (BeamLisp.LazySeq/force left)))
    (is (= :cyclic_memo (force-reason right)) "a chain of completed aliases closes the cycle")))

(deftest a-re-entrant-force-is-recursive
  (let [holder (atom nil)
        self (BeamLisp.LazySeq/new (fn [] (BeamLisp.LazySeq/force @holder)))]
    (reset! holder self)
    (is (= :recursive_force (force-reason self)))
    (is (= (tuple :terminal :recursive_force) (BeamLisp.LazySeq/memo_state self)))))

(deftest two-processes-forcing-each-other-do-not-deadlock
  (let [holder (atom {})
        parent (erlang/self)
        step (fn [mine theirs]
               (fn []
                 (erlang/send parent (tuple :running mine (erlang/self)))
                 (receive :go :ok (after 5000 :timeout))
                 (BeamLisp.LazySeq/force (get @holder theirs))))
        a (BeamLisp.LazySeq/new (step :a :b))
        b (BeamLisp.LazySeq/new (step :b :a))
        run (fn [l] (fn [] [(try (BeamLisp.LazySeq/force l) :no-error
                                 (catch BeamLisp.LazySeq.ForceError e (erlang/map_get :reason e)))
                            (erlang/get :bl_lazy_waits_on)]))]
    (reset! holder {:a a :b b})
    (let [ta (Task/async (run a))
          tb (Task/async (run b))
          pa (receive [:running :a pid] pid (after 5000 nil))
          pb (receive [:running :b pid] pid (after 5000 nil))]
      (erlang/send pa :go)
      (erlang/send pb :go)
      (is (= [:recursive_force :undefined] (Task/await ta 10000))
          "the recursive force is raised and no wait-for entry is left behind")
      (is (= [:recursive_force :undefined] (Task/await tb 10000))))))

(deftest a-value-embedding-its-own-node-is-data
  (let [holder (atom nil)
        ones (BeamLisp.LazySeq/new (fn [] (list 1 @holder)))]
    (reset! holder ones)
    (let [v (BeamLisp.LazySeq/force ones)]
      (is (= 1 (first v)))
      (is (erlang/=:= ones (second v))))
    (is (= 1 (first (second (BeamLisp.LazySeq/force ones)))) "never refused")))
