(ns formal.observation-native-test
 (:require [formal.term :as t] [formal.value :as v] [formal.query :as q]
           [formal.question-graph :as qg] [formal.logic :as logic]))

(deftest both-engines-reconstruct-the-same-list-observations
 (let [x (t/variable "observation.native" t/Int)
       descriptor (v/make (list x nil false [x]) {})
       question (q/sat {:assumptions [(t/eq x (t/int 7))] :observe {"list" descriptor}})
       context (qg/prepare question)]
  (doseq [engine [:z3 :oxiz]]
   (let [opts {:backend engine :solver-ms 500 :hard-ms 2000}
         ordinary (logic/run opts question) shared (logic/run-graph opts context)]
    (is (= :sat (:verdict ordinary)))
    (is (= :sat (:verdict shared)))
    (is (= (list 7 nil false [7]) (get-in ordinary [:witness "list" :value])))
    (is (= (list 7 nil false [7]) (get-in shared [:witness "list" :value])))
    (is (list? (get-in ordinary [:witness "list" :value])))
    (is (list? (get-in shared [:witness "list" :value])))
    (is (= false (:compiler-proof-authority ordinary)))
    (is (= false (:compiler-proof-authority shared)))))))
