(ns runtime.activity-test
  (:require [runtime.activity :as a] [data.single-flight :as flight] [lsp] [bl.cli :as cli]
            [bl.check :as check] [codebase :as cb]))
(defn- rows [r] (:recent (a/snapshot r)))

(deftest finite-scoped-readers-record-real-decisions-and-never-values
  (let [r (a/open) calls (atom 0) key (erlang/unique_integer (list :positive))
        f (fn [] (swap! calls inc) {:private "secret"})]
    (try
      (is (empty? (rows r)))
      (doseq [_ (range 2)]
        (a/with-operation :check {:subject "small.bl" :source "digest"}
          #(flight/value :activity.test key :v f)))
      (is (= 1 @calls))
      (is (= 1 (get-in (first (rows r)) [:counts :reused])))
      (is (= 1 (get-in (second (rows r)) [:counts :computed])))
      (is (pos? (get-in (second (rows r)) [:cache :kept-bytes])))
      (is (= "same-source" (:cause (first (rows r)))))
      (let [receipt-id (:receipt-id (second (rows r)))]
        (is (= receipt-id (:previous-receipt-id (first (rows r)))))
        (is (= (second (rows r)) (:receipt (a/receipt r receipt-id))))
        (is (= :refused (:status (a/receipt (assoc r :lease :invalid) receipt-id))))
        (is (= :missing (:status (a/receipt r 10000)))))
      (is (not (String/contains? (pr-str (a/snapshot r)) "secret")))
      (is (not (contains? (first (rows r)) :source)))
      (let [before (rows r)] (doseq [_ (range 40)] (a/snapshot r)) (is (= before (rows r))))
      (let [old (Process/get :bl-vm-scope)]
        (try (Process/put :bl-vm-scope (erlang/make_ref))
          (a/with-operation :index {} #(a/mark! :computed))
          (is (= 2 (count (rows r))))
          (finally (Process/put :bl-vm-scope old))))
      (doseq [i (range 100)]
        (a/with-operation :editor {:subject (apply str (repeat 200 "x")) :source (str i)}
          #(doseq [_ (range 30)] (a/mark! :evaluated "function"))))
      (is (= 64 (count (rows r))))
      (is (= :expired (:status (a/receipt r 1))))
      (is (= 16 (count (:items (first (rows r))))))
      (is (= 30 (get-in (first (rows r)) [:counts :evaluated])))
      (is (= 160 (count (:subject (first (rows r))))))
      (is (= "source-changed" (:cause (first (rows r)))))
      (is (thrown? (a/with-operation :check {} #(throw "private error"))))
      (is (= "failed" (:state (first (rows r)))))
      (is (nil? (a/current-id)))
      (finally (a/close! r)))
    (is (= false (:available (a/snapshot r))))
    (is (= :answer (a/with-operation :check {} (fn [] :answer))))))

(deftest actual-tools-produce-nested-traces-and-warm-work-cannot-recompute
  (let [r (a/open) src "(ns activity.fixture) (defn leaf [x] (+ x 17)) (defn root [x] (leaf x))"]
    (try
      (lsp/analyzed src) (lsp/analyzed src)
      (is (= "editor" (:tool (first (rows r)))))
      (is (pos? (get-in (first (rows r)) [:counts :reused] 0)))
      (is (= 0 (get-in (first (rows r)) [:counts :computed] 0)))
      (cb/index-source {} "activity.fixture" src {:mode :calls})
      (cb/index-source {} "activity.fixture" src {:mode :calls})
      (is (= "index" (:tool (first (rows r)))))
      (is (= 1 (get-in (first (rows r)) [:counts :reused])))
      (check/analyze-source "fixture.bl" src)
      (check/analyze-source "fixture.bl" src)
      (check/analyze-source "fixture.bl" src)
      (is (= "check" (:tool (first (rows r)))))
      (is (pos? (get-in (first (rows r)) [:counts :reused] 0)))
      (is (= 0 (get-in (first (rows r)) [:counts :computed] 0)))
      (let [children (filter :parent (rows r))]
        (is (seq children))
        (is (every? #(some (fn [p] (= (:id p) (:parent %))) (rows r)) children)))
      (finally (a/close! r)))))

(deftest independent-editor-documents-have-independent-causal-history
  (let [reader (a/open) one (erlang/make_ref) two (erlang/make_ref)
        src-one "(ns receipt.editor.one) (defn answer [] 1)"
        src-two "(ns receipt.editor.two) (defn answer [] 2)"
        edited "(ns receipt.editor.one) (defn answer [] 3)"]
    (try
      (lsp/with-document-memo one src-one #(lsp/analyzed src-one))
      (lsp/with-document-memo two src-two #(lsp/analyzed src-two))
      (lsp/with-document-memo one edited #(lsp/analyzed edited))
      (let [[change second-open first-open] (filter #(= "editor" (:tool %)) (rows reader))]
        (is (= ["source-changed" "first-use" "first-use"] (mapv :cause [change second-open first-open])))
        (is (= (:receipt-id first-open) (:previous-receipt-id change)))
        (is (nil? (:previous-receipt-id second-open)))
        (is (not (contains? (:receipt (a/receipt reader (:receipt-id change))) :document-slot))))
      (finally (lsp/release-document-memo! one)
               (lsp/release-document-memo! two)
               (a/close! reader)))))

(deftest waiting-is-real-bounded-and-restored-after-refusal
  (let [r (a/open) parent (erlang/self) key [:activity.wait (erlang/unique_integer (list :positive))]
        holder (spawn #(flight/with-key key (fn [] (erlang/send parent :held) (receive :release :ok))))]
    (try
      (is (= :held (receive :held :held (after 5000 nil))))
      (a/with-operation :check {}
        (fn [] (is (thrown? (flight/with-key key 30 #(throw "must not execute"))))))
      (is (>= (:wait-ms (first (rows r))) 30))
      (is (= "done" (:state (first (rows r)))))
      (is (nil? (Process/get :runtime.activity/waiting)))
      (finally (erlang/exit holder :kill) (a/close! r)))))

(deftest active-capacity-never-blocks-work-and-dead-callers-are-swept
  (let [r (a/open) parent (erlang/self) workers (atom [])]
    (try
      (doseq [_ (range 64)]
        (swap! workers conj (spawn (fn []
          (a/with-operation :editor {} (fn [] (erlang/send parent :entered) (receive :release nil)))))))
      (doseq [_ (range 64)] (is (= :entered (receive :entered :entered (after 5000 nil)))))
      (is (= 64 (count (:running (a/snapshot r)))))
      (is (= :still-runs (a/with-operation :check {} (fn [] :still-runs))))
      (is (= 1 (:dropped (a/snapshot r))))
      (doseq [pid @workers]
        (let [ref (Process/monitor pid)]
          (erlang/exit pid :kill)
          (receive [:DOWN r :process p _] :when (and (= r ref) (= p pid)) true
            (after 5000 (throw "Caller did not stop")))))
      (is (every? #(= "interrupted" (:state %)) (:running (a/snapshot r))))
      (a/with-operation :editor {} (fn [] :swept))
      (is (empty? (:running (a/snapshot r))))
      (is (= 64 (count (rows r))))
      (is (= false (:available (a/snapshot (assoc r :lease (erlang/make_ref))))))
      (finally (doseq [pid @workers] (when (Process/alive? pid) (erlang/exit pid :kill))) (a/close! r)))))

(deftest changed-evidence-is-explained-without-publishing-its-identities
  (let [r (a/open)]
    (try
      (doseq [revision ["old-definition-hash" "new-definition-hash"]]
        (a/with-operation :index {:subject "One" :path "src/one.bl" :source "source-hash"}
          #(a/evidence! revision [])))
      (let [row (first (rows r))]
        (is (= "definitions-changed" (:cause row)))
        (is (= {:path "src/one.bl"} (:location row)))
        (is (not (contains? row :revision)))
        (is (not (contains? row :prior)))
        (is (not (String/contains? (pr-str (rows r)) "-hash"))))
      (finally (a/close! r)))))

(deftest cheap-cli-check-and-outline-share-the-app-tape-and-parse
  (let [r (a/open)
        file (str "inspector-quick-" (erlang/unique_integer (list :positive)) ".bl")]
    (try
      (File/write! file "(ns inspector.fixture (:require [bl.util]))\n(defn leaf [] :ok)\n(defn leaf [] :again)")
      (is (= 0 (cli/dispatch-command "check" (cli/parse-argv (list "check" "--quick" file)))))
      (is (= 0 (cli/dispatch-command "codebase" (cli/parse-argv (list "codebase" file)))))
      (let [[outline check] (rows r)]
        (is (= ["outline" "quick-check"] (mapv :tool [outline check])))
        (is (= ["CLI" "CLI"] (mapv :origin [outline check])))
        (is (= {:path file} (:location outline)))
        (is (= {:definitions 2 :imports 1} (:summary outline)))
        (is (= {:repeated 1} (:summary check)))
        (is (= 1 (get-in check [:counts :computed])))
        (is (= 1 (get-in outline [:counts :reused]))))
      (File/write! file "(defn broken [")
      (is (= 1 (cli/dispatch-command "check" (cli/parse-argv (list "check" "--quick" file)))))
      (is (= "failed" (:state (first (rows r)))))
      (finally (File/rm! file) (a/close! r)))))
