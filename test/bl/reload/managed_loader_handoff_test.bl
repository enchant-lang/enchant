(ns reload.managed-loader-handoff-test
 (:require [reload.generation :as g] [reload.execution :as execution]))
(deftest loader-mailbox-retains-original-native-admission-and-restores-caller
 (let [graph (g/prepare! {:sources {"loader.handoff" "(ns loader.handoff) (defn value [] 23)"}})
       caller (erlang/self)]
  (try
   (g/with! graph
    (fn []
     (let [result (BeamLisp.Loader.Server/run
                   (fn [] [(:digest (g/current)) (execution/owned?) (erlang/self)]))]
      (is (= (:digest graph) (nth result 0)))
      (is (= true (nth result 1)))
      (is (not= caller (nth result 2))))
     (is (= :caught
            (try (BeamLisp.Loader.Server/run (fn [] (throw :managed-loader-fixture)))
                 (catch _ :caught))))
     (is (execution/owned?))
     (is (= 23 (g/invoke! graph "loader.handoff/value" [])))))
   (is (= 0 (:registrations (g/evidence graph))))
   (is (nil? (g/current)))
   (finally (g/retire! graph)))))
(deftest a-lazy-sdk-namespace-can-initialize-through-a-managed-loader-call
 (let [graph (g/prepare! {:sources {"loader.lazy" "(ns loader.lazy) (defn value [] 29)"}})]
  (try
   (g/with! graph
    (fn []
     (BeamLisp.Loader/ensure_loaded "auth.wire")
     (is (BeamLisp.Env/loaded_ns? "auth.wire"))
     (is (= true ((BeamLisp.Env/fetch! "auth.wire" "text?") "native")))
     (is (= 29 (g/invoke! graph "loader.lazy/value" [])))))
   (finally (g/retire! graph)))))
