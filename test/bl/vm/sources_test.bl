; sources_test.bl — vm.sources: the manifest of what a realm resolved.
;
; The checkout client digests exactly the paths this manifest lists (see
; tooling/drop/src/checkout.rs `read_realm_sources`), so its line format and its
; recording rules are a contract: pin them here. The Rust side has the matching
; tests (`checkout_tests::*manifest*`).

(ns vm.sources-test
  (:require [vm.sources :as sources]))

(defn- scratch []
  (let [dir (str "/tmp/vm-sources-test-" (erlang/unique_integer (list :positive)))]
    (File/mkdir_p! dir)
    dir))

(defn- lines [path]
  (vec (String/split (File/read! path) "\n" (list (tuple :trim true)))))

(deftest entry-lines-are-the-client-grammar
  (testing "a loaded file carries the sha256 of the bytes read"
    (is (= (str "L\tba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\t/p/a.bl\n")
           (sources/entry-line "/p/a.bl" "abc"))))
  (testing "an absent candidate is just its path"
    (is (= "A\t/p/b.bl\n" (sources/entry-line "/p/b.bl" nil))))
  (testing "a path that cannot sit on one line makes the manifest unusable"
    (is (= "X\n" (sources/entry-line "/p/a\tb.bl" "abc")))
    (is (= "X\n" (sources/entry-line "/p/a\nb.bl" nil)))))

(deftest tier-directories-are-recognised-by-containment
  (is (sources/under-any? "/img/std/a.bl" ["/img/std" "/img/lib"]))
  (is (not (sources/under-any? "/img/stdx/a.bl" ["/img/std"])))
  (is (not (sources/under-any? "/p/a.bl" []))))

(deftest an-era-starts-a-manifest-with-this-roots-header
  (let [root (scratch)
        row (sources/begin-era! root)
        path (sources/manifest-path root)]
    (is (= path (:path row)))
    (is (= [(str "bl-realm-sources 1\t" root)] (lines path)))
    (testing "a second era keeps what the first recorded"
      (sources/note! row (str root "/lib/a.bl") "abc")
      (let [row2 (sources/begin-era! root)]
        (is (not= (:token row) (:token row2)))
        (is (= 2 (count (lines path))))))
    (testing "a manifest of another root is replaced"
      (File/write! path "bl-realm-sources 1\t/elsewhere\nA\t/x\n")
      (sources/begin-era! root)
      (is (= [(str "bl-realm-sources 1\t" root)] (lines path))))
    (File/rm_rf! root)))

(deftest a-directory-that-does-not-exist-is-not-a-realm-to-record
  (is (nil? (sources/begin-era! "/nonexistent/vm-sources-test")))
  (is (nil? (sources/begin-era! nil))))

(deftest note-records-each-candidate-once-per-era
  (let [root (scratch)
        row (sources/begin-era! root)
        path (sources/manifest-path root)]
    (sources/note! row (str root "/lib/a.bl") "abc")
    (sources/note! row (str root "/lib/a.bl") "abc")
    (sources/note! row (str root "/lib/a.clj") nil)
    (sources/note! row (str root "/lib/a.clj") nil)
    (is (= [(str "bl-realm-sources 1\t" root)
            (str "L\tba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\t" root "/lib/a.bl")
            (str "A\t" root "/lib/a.clj")]
           (lines path)))
    (testing "a new era records afresh"
      (let [row2 (sources/begin-era! root)]
        (sources/note! row2 (str root "/lib/a.bl") "abc")
        (is (= 4 (count (lines path))))))
    (testing "the image's own tiers are not recorded"
      (let [tier (first (BeamLisp.Tiers/dirs))
            before (count (lines path))]
        (sources/note! row (str tier "/zz-not-there.bl") nil)
        (is (= before (count (lines path))))))
    (File/rm_rf! root)))

(deftest a-failed-write-removes-the-manifest
  (let [root (scratch)
        row (sources/begin-era! root)
        path (sources/manifest-path root)]
    ;; make the append fail: the manifest becomes a directory
    (File/rm! path)
    (File/mkdir_p! path)
    (sources/note! row (str root "/lib/a.bl") "abc")
    (is (not (File/regular? path)))
    (File/rm_rf! root)))
