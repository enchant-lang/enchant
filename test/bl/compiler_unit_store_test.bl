(ns compiler-unit-store-test)

;; Exercise the current helper with the retained immutable compiler. This
;; private namespace never replaces the selected SDK's build/runtime modules.
(let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
      source (File/read! (Path/join root "priv/build/unit-store.bl"))]
 (BeamLisp/eval (String/replace source "(ns unit-store " "(ns compiler-unit-store-under-test ")))

(ns compiler-unit-store-test)

(defn- artifact! [prepared directory previous]
 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "compiler-unit-store-under-test" "artifact!")
                       (list prepared directory previous)))

(defn- prepare [file module action]
 (let [handle (BeamLisp.AOT/open_workspace
               {:version 2 :phase-imports (list 'core 'sugar)
                :sources (list {:namespace 'compiler.cache.fixture :file file})} {})]
  (try (action (BeamLisp.AOT/prepare_host_unit handle {:namespace 'compiler.cache.fixture :module module}))
       (finally (BeamLisp.AOT/close_workspace! handle)))))

(deftest complete-units-reuse-without-publication-and-input-or-target-changes-miss
 (let [root (Path/join (System/tmp_dir!) (str "compiler-unit-cache-" (System/unique_integer (list :positive))))
       file (Path/join root "fixture.bl")
       a (Path/join root "a") b (Path/join root "b") c (Path/join root "c") d (Path/join root "d")
       module :Elixir.BeamLisp.CompilerCacheFixture]
  (File/mkdir_p! root)
  (try
   (File/write! file "(ns compiler.cache.fixture) (defn answer [] 42)")
   (prepare file module
    (fn [prepared]
     (let [first (artifact! prepared a nil)
           again (artifact! prepared b a)]
      (is (= true (:compiled first)))
      (is (= false (:compiled again)))
      (is (= (:key first) (:key again)))
      (is (= (get-in first [:verified :beams]) (get-in again [:verified :beams])))
      (is (= false (erlang/module_loaded module)))
      (is (= false (get-in again [:verified :native-admission])))
      ;; A real independent compilation remains available to the reproduction
      ;; stage; it must not consult the preceding stage's new cache entries.
      (let [fresh (artifact! prepared c nil)]
       (is (= true (:compiled fresh)))
       (is (= (get-in first [:verified :beams]) (get-in fresh [:verified :beams])))))))
   (File/write! file "(ns compiler.cache.fixture) (defn answer [] 99)")
   (prepare file module
    (fn [prepared]
     (let [changed (artifact! prepared d a)]
      (is (= true (:compiled changed)))
      (is (= false (erlang/module_loaded module))))))
   (prepare file :Elixir.BeamLisp.CompilerCacheOtherFixture
    (fn [prepared]
     (is (= true (:compiled (artifact! prepared (Path/join root "other") d))))))
   (finally (File/rm_rf! root)))))

(deftest corrupt-complete-unit-is-rejected-before-it-can-be-restored
 (let [root (Path/join (System/tmp_dir!) (str "compiler-unit-corrupt-" (System/unique_integer (list :positive))))
       file (Path/join root "fixture.bl") a (Path/join root "a") b (Path/join root "b")]
  (File/mkdir_p! root)
  (try
   (File/write! file "(ns compiler.cache.fixture) (defn answer [] 42)")
   (prepare file :Elixir.BeamLisp.CompilerCacheCorruptionFixture
    (fn [prepared]
     (let [result (artifact! prepared a nil)
           unit (Path/join a (:key result))
           beam (first (remove #(= "artifact-unit.term" %) (File/ls! unit)))]
      (File/write! (Path/join unit beam) "corrupted")
      (is (= :artifact-bytes-changed
             (try (artifact! prepared b a) nil (catch error (:kind (ex-data error))))))
      (is (= false (File/exists? b))))))
   (finally (File/rm_rf! root)))))

(let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
      source (File/read! (Path/join root "priv/build/seed.bl"))]
 (BeamLisp/eval (String/replace source "(ns seed\n" "(ns compiler-seed-under-test\n")))
(ns compiler-unit-store-test)

(deftest qualified-flat-floor-import-resolves-the-physical-sdk-root
 (let [directory (Path/join (System/tmp_dir!) (str "compiler-flat-import-" (System/unique_integer (list :positive))))
       sdk (System/fetch_env! "BL_SDK_PRODUCT")
       compiler (get (Jason/decode! (File/read! (Path/join sdk "artifact.json"))) "compiler")
       root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
       file (Path/join root "host/compiler_data.bl")
       prefix (first (String/split (File/read! (Path/join root "build/seed.bl"))
                                   ";; Artifact production owns preparation"))
       baseline {"version" 1 "compiler_key" (BeamLisp.AOTCache/compiler_key)
                 "abi_prefix_sha256" (Base/encode16 (crypto/hash :sha256 prefix) (list (tuple :case :lower)))
                 "floor" (Path/join compiler "seed")
                 "inputs" (Jason/decode! (File/read! (Path/join compiler "qualification/inputs.json")))}
       handle (BeamLisp.AOT/open_workspace
                {:version 2 :phase-imports (list 'core 'sugar)
                 :sources (list {:namespace 'host.compiler-data :file file})} {})]
  (try
   (let [prepared (BeamLisp.AOT/prepare_host_unit handle
                    {:namespace 'host.compiler-data :module :Elixir.BeamLisp.CompilerData})
         result (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "compiler-seed-under-test" "generation-import!")
                  (list prepared baseline directory))
         unit (BeamLisp.AOT/verify_unit directory)]
    (is (= true result))
    (is (= 1 (count (:beams unit))))
    (is (= (File/read! (Path/join compiler "seed/Elixir.BeamLisp.CompilerData.beam"))
           (second (first (:beams unit))))))
   (finally (BeamLisp.AOT/close_workspace! handle) (File/rm_rf! directory)))))

(deftest different-boot-targets-with-the-same-input-closure-have-distinct-cache-addresses
 (let [root (BeamLisp.Tiers/priv_root)
       handle (BeamLisp.AOT/open_workspace
                {:version 2 :phase-imports (list 'core 'sugar)
                 :sources (list {:namespace 'core :file (Path/join root "boot/core.bl")}
                                {:namespace 'sugar :file (Path/join root "boot/sugar.bl")})} {})]
  (try
   (let [core (BeamLisp.AOT/prepare_unit handle 'core)
         sugar (BeamLisp.AOT/prepare_unit handle 'sugar)
         key (fn [prepared] (BeamLisp.Ns.Rt/invoke
                             (BeamLisp.Env/fetch_exact! "compiler-unit-store-under-test" "artifact-key")
                             (list prepared)))]
    (is (not= (:namespace core) (:namespace sugar)))
    (is (not= (key core) (key sugar))))
   (finally (BeamLisp.AOT/close_workspace! handle)))))

(deftest captured-input-reuse-skips-preparation-and-keeps-independent-reproduction
 (let [directory (Path/join (System/tmp_dir!) (str "compiler-input-cache-" (System/unique_integer (list :positive))))
       root (BeamLisp.AOT/physical_sdk_path (BeamLisp.Tiers/priv_root))
       file (Path/join root "host/compiler_data.bl")
       a (Path/join directory "a") b (Path/join directory "b")
       phase (str (String/duplicate "a" 64))
       spec {:namespace 'host.compiler-data :module :Elixir.BeamLisp.CompilerData}
       selection {:namespace 'host.compiler-data :file file :host-spec spec}
       handle (BeamLisp.AOT/open_workspace
                {:version 2 :phase-imports (list 'core 'sugar)
                 :sources (list {:namespace 'host.compiler-data :file file})} {})
       invoke (fn [name args] (BeamLisp.Ns.Rt/invoke
                               (BeamLisp.Env/fetch_exact! "compiler-unit-store-under-test" name) args))
       before (BeamLisp.CompilerData/module_info :md5)]
  (try
   (let [prepared (BeamLisp.AOT/prepare_host_unit handle spec)
         captured (artifact! prepared a nil)
         baseline {"compiler_key" (BeamLisp.AOTCache/current_compiler_key)
                   "abi_prefix_sha256" (Base/encode16 (crypto/hash :sha256
                     (first (String/split (File/read! (Path/join root "build/seed.bl"))
                              ";; Artifact production owns preparation"))) (list (tuple :case :lower)))
                   "modules" (into {} (map (fn [[module bytes]]
                      [(str (Atom/to_string module) ".beam")
                       (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower)))])
                      (get-in captured [:verified :beams])))}
         _ (invoke "record-compiler-unit!" (list prepared (assoc captured :compiled false) a phase))
         restore (fn [out seen-phase old]
                   (invoke "restore-compiler-unit!" (list selection out a seen-phase true old)))
         reused (restore b phase baseline)]
    (is (= false (:compiled reused)))
    (is (= (get-in captured [:verified :beams]) (:beams reused)))
    (is (nil? (restore (Path/join directory "wrong-phase") "different" baseline)))
    (is (nil? (restore (Path/join directory "wrong-floor") phase {"modules" {}})))
    (let [context (System/get_env "BL_COMPILER_EMITTER_CONTEXT")]
     (try
      (System/put_env "BL_COMPILER_EMITTER_CONTEXT" "changed-emitter")
      (is (nil? (restore (Path/join directory "wrong-emitter") phase baseline)))
      (finally
       (if context (System/put_env "BL_COMPILER_EMITTER_CONTEXT" context)
                   (System/delete_env "BL_COMPILER_EMITTER_CONTEXT")))))
    ;; Even matching bytes must not let a planning stage claim its own newly
    ;; emitted unit as independently reproduced output.
    (invoke "record-compiler-unit!" (list prepared captured a phase))
    (is (nil? (restore (Path/join directory "new-output") phase baseline)))
    (invoke "record-compiler-unit!" (list prepared (assoc captured :compiled false) a phase))
    (let [other (assoc spec :module :Elixir.BeamLisp.OtherCompilerDataCacheTarget)]
     (invoke "record-compiler-unit!" (list (assoc prepared :host-spec other) (assoc captured :compiled false) a phase))
     ;; A second target for the same Source namespace has a separate record.
     (is (= (:beams reused) (:beams (restore (Path/join directory "multiple-targets") phase baseline))))
     ;; Even a forged matching target label cannot adopt different module bytes.
     (is (nil? (invoke "restore-compiler-unit!"
                 (list (assoc selection :host-spec other) (Path/join directory "forged-target")
                       a phase true baseline)))))
    (is (= before (BeamLisp.CompilerData/module_info :md5))))
   (finally (BeamLisp.AOT/close_workspace! handle) (File/rm_rf! directory)))))


(deftest cached-artifact-reuse-revalidates-the-retained-prepared-source
 (let [root (Path/join (System/tmp_dir!) (str "compiler-unit-stale-prepared-" (System/unique_integer (list :positive))))
       file (Path/join root "fixture.bl") a (Path/join root "a") b (Path/join root "b")
       module :Elixir.BeamLisp.CompilerCacheStalePreparedFixture
       source-a "(ns compiler.cache.fixture) (defn answer [] 41)"
       source-b "(ns compiler.cache.fixture) (defn answer [] 42)"]
  (File/mkdir_p! root)
  (try
   (is (= (erlang/byte_size source-a) (erlang/byte_size source-b)))
   (File/write! file source-a)
   (prepare file module
    (fn [prepared]
     (let [captured (artifact! prepared a nil)]
      (is (= true (:compiled captured)))
      ;; Cache membership is genuine; only the current Source has changed.
      ;; The old prepared value still names the prior bytes and address.
      (File/write! file source-b)
      (is (= :artifact-source-changed
             (try (artifact! prepared b a) nil (catch error (:kind (ex-data error))))))
      (is (= false (File/exists? b)))
      (is (= false (erlang/module_loaded module))))))
   (finally (File/rm_rf! root)))))

; Existing unit-store owner tests. The target below writes inert fixture DATA;
; it qualifies ownership/invalidation only, never a Scheme/native backend.
(defn- artifact-target! [prepared directory previous target]
 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "compiler-unit-store-under-test" "artifact-target!")
  (list prepared directory previous target)))
(defn- prepare-target [file imports action]
 (let [workspace (BeamLisp.AOT/open_workspace
                  {:version 2 :phase-imports imports
                   :sources (list {:namespace 'compiler.cache.fixture :file file})} {})]
  (try (action (BeamLisp.AOT/prepare_unit workspace 'compiler.cache.fixture))
   (finally (BeamLisp.AOT/close_workspace! workspace)))))
(defn- target-refusal [action]
 (try (action) nil (catch error (:kind (ex-data error)))))
(defn- inert-target [calls identity]
 (let [bytes-for (fn [selection]
                  (erlang/term_to_binary [:unit-store-policy-fixture selection] (list :deterministic)))
       product-name "owned-product.data"]
  {:identity identity
   :emit! (fn [_ directory selection]
            (swap! calls update :emits inc)
            (swap! calls update :environments conj (BeamLisp.Env/capture))
            (File/write! (Path/join directory product-name) (bytes-for selection)))
   :verify! (fn [directory selection]
              (swap! calls update :verifies inc)
              (swap! calls update :environments conj (BeamLisp.Env/capture))
              (let [members (set (File/ls! directory))
                    bytes (File/read! (Path/join directory product-name))]
               (when-not (and (or (= #{product-name} members)
                                  (= #{product-name "target-artifact.term"} members))
                              (= (bytes-for selection) bytes))
                (throw (ex-info "Changed policy fixture product" {:kind :fixture-product-changed})))
               {:manifest {:selection selection :members [product-name]} :bytes bytes}))}))
(defn- fresh-target-calls [] (atom {:emits 0 :verifies 0 :environments []}))
(defn- target-root []
 (Path/join (System/tmp_dir!) (str "compiler-target-policy-" (System/unique_integer (list :positive)))))

(deftest target-products-reuse-locally-and-from-prior-without-emission
 (let [root (target-root) file (Path/join root "fixture.bl")
       a (Path/join root "a") b (Path/join root "b") c (Path/join root "c")
       calls (fresh-target-calls) target (inert-target calls {:kind :fixture :abi 1})
       before (BeamLisp.Env/capture)]
  (File/mkdir_p! root)
  (try
   (File/write! file "(ns compiler.cache.fixture) (defn answer [] 42)")
   (prepare-target file (list 'core 'sugar)
    (fn [prepared]
     (let [cold (artifact-target! prepared a nil target)
           warm (artifact-target! prepared a nil target)
           copied (artifact-target! prepared b a target)]
      (is (= true (:compiled cold)))
      (is (= false (:compiled warm)))
      (is (= false (:compiled copied)))
      (is (= 1 (:emits @calls)) "Both warm paths emit zero products")
      (is (= (:key cold) (:key warm) (:key copied)))
      (is (= (get-in cold [:verified :bytes]) (get-in copied [:verified :bytes])))
      (is (= (:selection cold) (:selection copied)))
      (is (= (File/read! (Path/join (Path/join a (:key cold)) "target-artifact.term"))
             (File/read! (Path/join (Path/join b (:key copied)) "target-artifact.term"))))
      (let [independent (artifact-target! prepared c nil target)]
       (is (= true (:compiled independent)))
       (is (= 2 (:emits @calls)))
       (is (= (get-in cold [:verified :bytes]) (get-in independent [:verified :bytes]))))
      (is (every? #(= before %) (:environments @calls)))
      (is (= before (BeamLisp.Env/capture))))))
   (finally (File/rm_rf! root)))))

(deftest target-selection-binds-source-phase-target-plans-and-file-attribution
 (let [root (target-root) file (Path/join root "fixture.bl")
       other (Path/join root "other.bl") source "(ns compiler.cache.fixture) (defn answer [] 42)"
       calls (fresh-target-calls) target (inert-target calls {:kind :fixture :abi 1})
       original (atom nil)]
  (File/mkdir_p! root)
  (try
   (File/write! file source)
   (prepare-target file (list 'core 'sugar)
    (fn [prepared]
     (let [cold (artifact-target! prepared (Path/join root "a") nil target)
           abi (artifact-target! prepared (Path/join root "abi") (Path/join root "a")
                 (assoc target :identity {:kind :fixture :abi 2}))
           ; This private inert plan tag has no execution authority. It tests
           ; complete plan identity independently of Source input identity.
           changed-plans (assoc prepared :plans
                           (cons (assoc (first (:plans prepared)) :target-policy-fixture-version 2)
                                 (rest (:plans prepared))))
           plan (artifact-target! changed-plans (Path/join root "plans") (Path/join root "a") target)]
      (reset! original cold)
      (is (= true (:compiled abi)))
      (is (= true (:compiled plan)))
      (is (not= (:key cold) (:key abi)))
      (is (not= (:key cold) (:key plan))))))
   (prepare-target file (list 'core)
    (fn [prepared]
     (let [phase (artifact-target! prepared (Path/join root "phase") (Path/join root "a") target)]
      (is (= true (:compiled phase)))
      (is (not= (:key @original) (:key phase)))
      (is (not= (get-in @original [:selection :phase-world]) (get-in phase [:selection :phase-world]))))))
   (File/write! other source)
   (prepare-target other (list 'core 'sugar)
    (fn [prepared]
     (let [attributed (artifact-target! prepared (Path/join root "attribution") (Path/join root "a") target)]
      (is (= true (:compiled attributed)))
      (is (not= (:key @original) (:key attributed)))
      (is (not= (get-in @original [:selection :inputs]) (get-in attributed [:selection :inputs]))))))
   (File/write! file "(ns compiler.cache.fixture) (defn answer [] 43)")
   (prepare-target file (list 'core 'sugar)
    (fn [prepared]
     (let [edited (artifact-target! prepared (Path/join root "edited") (Path/join root "a") target)]
      (is (= true (:compiled edited)))
      (is (not= (:key @original) (:key edited)))
      (is (not= (get-in @original [:verified :bytes]) (get-in edited [:verified :bytes]))))))
   (is (= 6 (:emits @calls)))
   (finally (File/rm_rf! root)))))

(deftest corrupted-target-product-and-marker-refuse-without-stale-fallback
 (let [root (target-root) file (Path/join root "fixture.bl")
       calls (fresh-target-calls) target (inert-target calls {:kind :fixture :abi 1})]
  (File/mkdir_p! root)
  (try
   (File/write! file "(ns compiler.cache.fixture) (defn answer [] 42)")
   (prepare-target file (list 'core 'sugar)
    (fn [prepared]
     (let [cold (artifact-target! prepared (Path/join root "a") nil target)
           unit (Path/join (Path/join root "a") (:key cold))
           product (Path/join unit "owned-product.data") bytes (File/read! product)
           marker (Path/join unit "target-artifact.term") marker-bytes (File/read! marker)]
      (File/write! product "corrupt")
      (is (= :fixture-product-changed
           (target-refusal #(artifact-target! prepared (Path/join root "bad-product") (Path/join root "a") target))))
      (is (= false (File/exists? (Path/join root "bad-product"))))
      (File/write! product bytes)
      (File/write! marker "corrupt")
      (let [before (:verifies @calls)]
       (is (= :artifact-target-selection
            (target-refusal #(artifact-target! prepared (Path/join root "bad-marker") (Path/join root "a") target))))
       (is (= before (:verifies @calls)) "Reject wrong marker before target verifier"))
      (is (= false (File/exists? (Path/join root "bad-marker"))))
      (File/write! marker marker-bytes)
      (File/write! (Path/join unit "extra.data") "unexpected")
      (is (= :fixture-product-changed
           (target-refusal #(artifact-target! prepared (Path/join root "extra-member") (Path/join root "a") target))))
      (is (= 1 (:emits @calls)) "Corruption is not permission to emit a replacement"))))
   (finally (File/rm_rf! root)))))

(deftest target-failures-clean-only-newly-owned-products
 (let [root (target-root) file (Path/join root "fixture.bl")
       calls (fresh-target-calls) base (inert-target calls {:kind :fixture :abi 1})
       source "(ns compiler.cache.fixture) (defn answer [] 42)"]
  (File/mkdir_p! root)
  (try
   (File/write! file source)
   (prepare-target file (list 'core 'sugar)
    (fn [prepared]
     (let [cold (artifact-target! prepared (Path/join root "a") nil base)
           key (:key cold)
           failing (assoc base :emit! (fn [value directory selection]
                                      ((:emit! base) value directory selection)
                                      (throw (ex-info "Fixture emission failed" {:kind :fixture-emit-failed}))))
           fail-verify (assoc base :verify! (fn [_ _]
                                             (throw (ex-info "Fixture verification failed" {:kind :fixture-verify-failed}))))]
      (is (= :fixture-emit-failed
           (target-refusal #(artifact-target! prepared (Path/join root "emit-failed") nil failing))))
      (is (= false (File/exists? (Path/join (Path/join root "emit-failed") key))))
      (is (= :fixture-verify-failed
           (target-refusal #(artifact-target! prepared (Path/join root "verify-failed") nil fail-verify))))
      (is (= false (File/exists? (Path/join (Path/join root "verify-failed") key))))
      (let [seen (atom 0)
            copied (Path/join (Path/join root "copied-failed") key)
            verifier (assoc base :verify!
                        (fn [directory selection]
                         (let [verified ((:verify! base) directory selection)]
                          (if (= 2 (swap! seen inc))
                           (throw (ex-info "Fixture post-copy verification failed" {:kind :fixture-post-copy-failed}))
                           verified))))]
       (is (= :fixture-post-copy-failed
            (target-refusal #(artifact-target! prepared (Path/join root "copied-failed") (Path/join root "a") verifier))))
       (is (= false (File/exists? copied)))
       (is (File/regular? (Path/join (Path/join (Path/join root "a") key) "target-artifact.term"))))
      (let [partial (Path/join (Path/join root "unknown-partial") key)]
       (File/mkdir_p! partial)
       (File/write! (Path/join partial "unowned.data") "preserve")
       (is (= :artifact-target-output-not-empty
            (target-refusal #(artifact-target! prepared (Path/join root "unknown-partial") (Path/join root "a") base))))
       (is (= "preserve" (File/read! (Path/join partial "unowned.data")))))
      (let [changed (assoc base :emit!
                       (fn [value directory selection]
                        ((:emit! base) value directory selection)
                        (File/write! file "(ns compiler.cache.fixture) (defn answer [] 43)")))]
       (is (= :artifact-source-changed
            (target-refusal #(artifact-target! prepared (Path/join root "changed-during-emit") nil changed))))
       (is (= false (File/exists? (Path/join (Path/join root "changed-during-emit") key))))
       (File/write! file source)))))
   (finally (File/rm_rf! root)))))
