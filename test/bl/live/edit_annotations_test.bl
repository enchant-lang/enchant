(ns live.edit.annotations-test
  (:require [live.edit.annotations :as a] [live.edit.extensions :as e]))
(deftest declarations-derive-browser-roots-and-native-functions
  (let [entries (a/discover "editable-projections.functions")
        descriptor (a/descriptor "editable-projections.functions")
        ext (e/build [(:value descriptor)])]
    (is (= ["studio/signal"] (mapv :id entries)))
    (is (= "inline" (get-in ext [:functions "studio/signal" :scope])))
    (is (= "editable-projections.functions/signal" (str (get-in descriptor [:expression :provides :editor/functions "studio/signal" :render]))))
    (is (= [:span {:class "studio-signal studio-signal-coral"} "Hi"]
           ((get-in ext [:functions "studio/signal" :render]) {:tone "coral"} "Hi")))))
