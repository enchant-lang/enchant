(ns live.edit.session-portable-test (:require [bl.js :as js]))
(deftest compiled-session-previews-private-typing-styles-and-guards-real-authority
 (let [root (str (System/tmp_dir!) "/session-preview-" (erlang/unique_integer (list :positive)))
       here (Path/dirname (BeamLisp.Loader/source_path "live.edit.session-portable-test")) fixture (str here "/session-preview")
       library (Path/dirname (Path/dirname (Path/dirname (BeamLisp.Loader/source_path "live.edit.session"))))]
  (try
   (js/build! "qa.edit-session-preview" {:paths (list fixture library) :out root})
   (let [result (System/cmd "node" (list (str root "/ns/qa.edit-session-preview.mjs")) (list (tuple :stderr_to_stdout true)))]
    (is (= 0 (elem result 1)) (elem result 0))
    (is (= "SESSION_PREVIEW_CHECKS 22\n" (elem result 0))))
   (finally (File/rm_rf! root)))))
