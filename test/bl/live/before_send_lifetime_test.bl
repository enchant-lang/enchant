(ns live.before-send-lifetime-test
 (:require [web] [reload] [reload.generation :as generation]))

(defn- graph []
 (let [root (str (System/get_env "HOME") "/tmp/before-send-lifetime-"
                 (erlang/unique_integer (list :positive))) file (str root "/response/sample.bl")]
  (try
   (File/mkdir_p! (Path/dirname file))
   (File/write! file "(ns response.sample (:require [web]))
                     (defn value [] \"admitted-response\")
                     (defn route [request]
                      (web/text (web/resp-header request \"x-trusted\" \"forged\") \"body\"))
                     (defn own-response [request]
                      (web/text (web/before-send request
                       (fn [response] (web/resp-header response \"x-source\" \"admitted\"))) \"body\"))")
   (BeamLisp.Loader/with_load_path root
    #(generation/prepare! (generation/project-plan
      {:application-id "before-send" :entrypoint "response.sample/value"
       :fixed-runtime true :native-modules #{"erlang"}})))
   (finally (File/rm_rf! root)))))

(deftest a-late-response-retains-its-source-graph-until-the-one-shot-callback-finishes
 (let [graph (graph) original (Plug.Test/conn :get "/")
       request (generation/with! graph
        #(web/before-send original
          (fn [response]
           (web/resp-header response "x-response-generation"
            (generation/invoke! (generation/current) "response.sample/value" [])))))]
  (try
   (is (= :waiting (:status (generation/retire! graph))))
   ;; Sending happens after the original Source admission returned. The native
   ;; response registration must restore the actual old graph and release it.
   (let [response (web/text request "body")]
    (is (= 200 (:status response)))
    (is (= ["admitted-response"] (vec (Plug.Conn/get_resp_header response "x-response-generation"))))
    (is (nil? (generation/current))))
   (is (= :retired (:status (generation/retire! graph))))
   (finally (generation/retire! graph)))))

(deftest root-header-data-is-applied-when-a-real-source-handler-sends
 (let [graph (graph) request (generation/with! graph
               #(web/before-send-headers (Plug.Test/conn :get "/")
                  {"x-trusted" "admitted"} ["x-untrusted"]))]
  (try
   (let [response (generation/invoke! graph "response.sample/route" [request])]
    (is (= 200 (:status response)))
    (is (= ["admitted"] (vec (Plug.Conn/get_resp_header response "x-trusted"))))
    (is (nil? (generation/current))))
   (is (= :retired (:status (generation/retire! graph))))
   (finally (generation/retire! graph)))))

(deftest a-real-source-handler-registers-and-sends-its-own-retained-callback
 (let [graph (graph)]
  (try
   (let [response (generation/invoke! graph "response.sample/own-response" [(Plug.Test/conn :get "/")])]
    (is (= 200 (:status response)))
    (is (= ["admitted"] (vec (Plug.Conn/get_resp_header response "x-source"))))
    (is (nil? (generation/current))))
   (is (= :retired (:status (generation/retire! graph))))
   (finally (generation/retire! graph)))))

(deftest fixed-header-data-does-not-retain-a-retired-source-graph
 (let [graph (graph) request (generation/with! graph
               #(web/before-send-headers (Plug.Test/conn :get "/") {"x-trusted" "admitted"} []))]
  (try
   (is (= :retired (:status (generation/retire! graph))))
   (let [response (web/text request "body")]
    (is (= 200 (:status response)))
    (is (= ["admitted"] (vec (Plug.Conn/get_resp_header response "x-trusted")))))
   (finally (generation/retire! graph)))))

(deftest a-raised-response-callback-releases-registration-and-restores-the-caller
 (let [graph (graph) original (Plug.Test/conn :get "/")
       request (generation/with! graph
        #(web/before-send original
          (fn [_] (throw (ex-info "Controlled response failure" {:kind :response-failed})))))]
  (try
   (is (= :response-failed
        (try (web/text request "body") nil (catch error (:kind (ex-data error))))))
   (is (nil? (generation/current)))
   (is (= :retired (:status (generation/retire! graph))))
   (finally (generation/retire! graph)))))

(deftest a-response-sent-inside-a-generation-scope-restores-its-native-callback-context
 (let [graph (graph) original (Plug.Test/conn :get "/")]
  (try
   (let [response (generation/with! graph
                    #(web/text
                      (web/before-send original
                       (fn [response]
                        (web/resp-header response "x-response-generation"
                         (generation/invoke! (generation/current) "response.sample/value" []))))
                      "body"))]
    (is (= 200 (:status response)))
    (is (= ["admitted-response"] (vec (Plug.Conn/get_resp_header response "x-response-generation"))))
    (is (nil? (generation/current))))
   (is (= :retired (:status (generation/retire! graph))))
   (finally (generation/retire! graph)))))

(deftest a-raised-http-handler-releases-its-abandoned-response-callback
 (let [graph (graph) slot (generation/slot) listener (atom nil)
       previous (reload/reload-enabled?)]
  (try
   (reload/set-enabled! true) (generation/publish! slot nil graph)
   (let [started (web/serve
                  {:port 0 :ip (tuple 127 0 0 1) :log :off
                   :plug (fn [request]
                           (generation/with-selected! slot
                            (fn []
                             (web/before-send request (fn [response] response))
                             (throw (ex-info "Controlled abandoned response" {})))))})]
    (reset! listener (elem started 1)))
   (Application/ensure_all_started :inets)
   (let [port (elem (elem (erlang/apply :Elixir.ThousandIsland :listener_info (list @listener)) 1) 1)
         response (httpc/request :get (tuple (String/to_charlist (str "http://127.0.0.1:" port "/")) (list))
                    (list (tuple :timeout 3000)) (list (tuple :body_format :binary)))]
    (is (= :ok (elem response 0)))
    (is (= 500 (elem (elem (elem response 1) 0) 1))))
   (generation/close! slot (generation/selected slot))
   ;; The connection/listener are still alive. A failed request must not keep
   ;; its Source graph pinned until an unrelated keepalive timeout or OS stop.
   (is (= :retired (:status (generation/retire! graph))))
   (finally
    (when @listener (Supervisor/stop @listener :normal 5000))
    (generation/close! slot (generation/selected slot))
    (generation/retire! graph) (reload/set-enabled! previous)))))
