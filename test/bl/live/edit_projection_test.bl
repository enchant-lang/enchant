(ns live.edit.projection-test
  (:require [live.edit.view :as view] [live.edit.model :as m] [live.edit.registry :as r]
            [live.edit.tools :as tools] [live.edit.sync :as sync] [live.hiccup :as h]
            [live.edit.projection :as tree] [live.edit.document :as doc]
            [live.edit.extensions :as extensions] [live.edit.standard :as standard] [live.diff :as diff] [live.edit.store :as store] [datom] [live.socket :as socket]))
(def registry (r/functions [tools/package]))
(def document (m/document "notes" [(m/block "p1" "Hello 🍌")]))
(def initial (sync/authority registry document))
(defn projection [state] (view/editor registry state [:intent :edit] 0 nil))

(deftest semantic-region-serialization-and-reference-equivalence
  (let [before (projection initial)
        changed (:state (sync/decide registry initial {:id "a1" :basis 0 :digest (:digest initial)
                      :op {:op "text/replace" :block "p1" :from 0 :to 0 :text "Hi "}}))
        after (projection changed) ops (diff/diff before after)]
    (is (= :region (first (first ops))))
    (is (= 1 (count ops)))
    (is (= (diff/normalize after) (diff/apply-ops ops before)))
    (is (includes? (h/hiccup->html before) "data-live-region='"))
    (is (includes? (h/hiccup->html before) "data-edit-slot=\"p1\""))))

(deftest overlapping-functions-project-with-source-identities
  (let [a (:document (m/apply-op registry document {:op "text/apply" :block "p1" :from 0 :to 5
                   :id "a1" :function "text/highlight" :args {}}))
        b (:document (m/apply-op registry a {:op "text/apply" :block "p1" :from 3 :to 7
                   :id "a2" :function "text/emphasis" :args {}}))
        html (h/hiccup->html (into [:div] (view/body registry b)))]
    (is (includes? html "data-edit-call=\"a1\""))
    (is (includes? html "data-edit-call=\"a2\""))
    (is (includes? html "data-edit-from=\"3\""))
    (is (includes? html "🍌"))))

(deftest live-writer-serializes-authority-and-deduplicates-proposals
  (let [conn (datom/connect store/schema)
        p {:id "a1" :basis 0 :digest (:digest initial)
           :op {:op "text/replace" :block "p1" :from 0 :to 0 :text "A"}}]
    (try
      (store/initialize! conn registry document)
      (datom/transact! conn [[:db/fn (fn [db] (store/transaction db registry "notes" p))]])
      (is (= 0 (:revision (store/read-state (datom/db conn) "notes"))))
      (store/publish! conn "notes")
      (is (= "AHello 🍌" (get-in (store/read-state (datom/db conn) "notes") [:document :blocks 0 :text])))
      (is (thrown? (datom/transact! conn [[:db/fn (fn [db] (store/transaction db registry "notes" p))]])))
      (is (= 1 (:revision (store/read-state (datom/db conn) "notes"))))
      (finally (datom/close! conn)))))

(deftest package-renderers-see-current-siblings-after-a-structural-move
 (let [render (fn [block context]
                [:section {:data-scope (str (:id block) ":" (join "," (mapv :id (:siblings context))))}
                 (:text context) (get-in context [:slots "body"])])
       extensions (extensions/build [standard/package
                    {:name "context-observer" :provides {:editor/blocks {"paragraph" {:label "Text" :slots ["body"] :render render}}}}])
       initial (doc/prepare (doc/document "siblings"
                 [(doc/block "one" "First") (assoc (doc/block "child" "Nested") :parent "one") (doc/block "two" "Second")]))
       before (h/hiccup->html (into [:div] (tree/body extensions initial)))
       moved (:document (doc/apply-op (:functions extensions) initial
                           {:op "node/move" :block "child" :parent nil :after "two" :slot "body"}))
       after (h/hiccup->html (into [:div] (tree/body extensions moved)))
       standalone (h/hiccup->html (tree/node extensions (first (:blocks initial))))]
  (is (includes? before "data-scope=\"one:one,two\""))
  (is (includes? before "data-scope=\"child:child\""))
  (is (includes? after "data-scope=\"child:one,two,child\""))
  (is (not (includes? after "data-scope=\"child:child\"")))
  (is (includes? standalone "data-scope=\"one:\""))))

(deftest incremental-shells-use-package-sibling-context-and-expand-dependencies
 (let [calls (atom 0)
       provider (fn [context]
                  (swap! calls inc)
                  {:example/weight (reduce + 0 (map #(get-in % [:attrs :weight] 0) (:siblings context)))})
       render (fn [block context] [:section {:data-weight (:example/weight context)
                                            :data-peers (join "," (map :id (:siblings context)))} (:text context)])
       ext (extensions/build [standard/package {:name "sibling-observer"
             :provides {:editor/sibling-context provider
              :editor/blocks {"paragraph" {:label "Text" :slots ["body"] :render-context #{:siblings} :render render}}}}])
       initial (doc/prepare (doc/document "context"
                 [(assoc (doc/block "one" "First") :attrs {:weight 1})
                  (assoc (doc/block "child" "Nested") :parent "one" :attrs {:weight 10})
                  (assoc (doc/block "two" "Second") :attrs {:weight 2})
                  (doc/block "code" "code" "literal")]))
       before (h/hiccup->html (into [:div] (tree/project ext initial ["one" "two"])))
       changed (:document (doc/apply-op (:functions ext) initial
                          {:op "node/set" :block "one" :patch {:attrs {:weight 5}}}))
       ids (tree/targets ext changed ["one"] false)
       after (h/hiccup->html (into [:div] (tree/project ext changed ids)))]
  (is (= ["one" "two"] ids))
  (is (= ["one" "child" "two"] (tree/targets ext changed ["one"] true)))
  (is (= ["gone" "one" "child" "two"] (tree/targets ext changed ["gone"] true)))
  (is (= ["code" "one" "two"] (tree/targets ext changed ["code"] false)))
  (is (= ["one"] (tree/targets (extensions/build [standard/package]) changed ["one"] true)))
  (is (includes? before "data-weight=\"3\""))
  (is (includes? after "data-weight=\"7\""))
  (is (not (includes? after "data-weight=\"3\"")))
  (is (includes? after "data-peers=\"one,two,code\""))
  ;; Providers run once for each sibling scope, regardless of requested shells.
  (is (= 4 @calls))))
