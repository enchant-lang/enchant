(ns ^:js qa.edit-session-preview
 (:require [live.edit.session :as session] [live.edit.standard :as standard]
           [live.edit.document :as document] [live.edit.protocol :as protocol] [live.edit.extensions :as extensions]))
(def checks (atom 0))
(defn check [condition] (when-not condition (throw (ex-info "Session preview contract failed." {:at @checks}))) (swap! checks inc))
(def custom {:name "preview-check" :provides {:editor/commands
 {"test/noop" {:label "Current value" :run (fn [_ _] {:ops []})}
  "test/title" {:label "Title" :run (fn [_ args] {:ops [{:op "document/meta" :patch {:title (:title args)}}]})}}}})
(def packages [standard/package custom])
(def ext (extensions/build packages))
(def initial (protocol/snapshot (protocol/authority ext (document/document "preview" [(document/block "a" "Text")]))))
(def ed (session/open packages (bl->js initial)))
(defn read-state [] (js->bl (.read ed) :keywordize-keys true))
(.selection ed (bl->js {:anchor {:block "a" :offset 0} :head {:block "a" :offset 0}}))
(def baseline (read-state))
(def preview (js->bl (.preview ed "text/highlight" (bl->js {:tone "mint"}) #js {}) :keywordize-keys true))
(check (:preview preview))
(check (not (:unchanged preview)))
(check (zero? (:pending preview)))
(check (nil? (.outbound ed)))
(.cancelPreview ed)
(check (empty? (:pendingStyles (read-state))))
(.preview ed "text/highlight" (bl->js {:tone "mint"}) #js {})
(.commitPreview ed)
(check (= "mint" (get-in (read-state) [:pendingStyles 0 :args :tone])))
(check (zero? (:pending (read-state))))
(check (not (:canUndo (read-state))))
(.preview ed "text/highlight" (bl->js {:tone "rose"}) #js {})
(.commitPreview ed)
(check (= ["rose"] (mapv #(get-in % [:args :tone]) (:pendingStyles (read-state)))))
(def noop (js->bl (.preview ed "test/noop" #js {} #js {}) :keywordize-keys true))
(check (:unchanged noop))
(check (nil? (.outbound ed)))
(check (try (.commitPreview ed) false (catch _ true)))
(.cancelPreview ed)
(.preview ed "test/title" (bl->js {:title "New title"}) #js {})
(check (= "New title" (get-in (read-state) [:meta :title])))
(check (zero? (:pending (read-state))))
(.cancelPreview ed)
(check (not= "New title" (get-in (read-state) [:meta :title])))
(.preview ed "test/title" (bl->js {:title "New title"}) #js {})
(.commitPreview ed)
(check (= "New title" (get-in (read-state) [:meta :title])))
(check (= 1 (:pending (read-state))))
(check (some? (.outbound ed)))
(check (:canUndo (read-state)))
(.run ed "undo" #js {} #js {})
(check (not= "New title" (get-in (read-state) [:meta :title])))
(.preview ed "test/noop" #js {} #js {})
(.selection ed (bl->js {:anchor {:block "a" :offset 1} :head {:block "a" :offset 1}}))
(check (try (.commitPreview ed) false (catch _ true)))
(.cancelPreview ed)
(check (= (:revision baseline) (:revision (read-state))))
(println (str "SESSION_PREVIEW_CHECKS " @checks))
