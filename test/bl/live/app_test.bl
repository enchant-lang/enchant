; app_test.bl — the live.app wire boundary: which frames the ws endpoint
; accepts, and what each does to the socket process.
;
; ws-handle-in is private, but the PUBLIC ws-handlers map carries it — that
; map is the contract web/upgrade serves, so it is what these tests pin.
; :srv is nil throughout: any branch that (call (:srv state) …)s on a frame
; it should have swallowed crashes here, which is exactly the regression a
; heartbeat is meant to never cause.

(ns live.app.test
  (:require [live.app :as app] [diagnostics :as diag]))

(defn- handle-in [payload]
  ((get app/ws-handlers :handle-in) [:text payload] {:srv nil}))

(deftest browser-fragments-do-not-become-route-or-query-facts
  (is (= ["/machine/r" {}] (app/split-target "/machine/r")))
  (is (= ["/machine/r" {:tab "settings"}] (app/split-target "/machine/r?tab=settings")))
  (is (= ["/machine/r" {:tab "settings"}] (app/split-target "/machine/r?tab=settings#calibration-work")))
  (is (= ["/machine/r" {}] (app/split-target "/machine/r#calibration-work")))
  (is (= ["/machine/r" {}] (app/split-target "/machine/r#")))
  (is (= ["" {}] (app/split-target "#calibration-work")))
  (is (= ["/machine/r" {:label "a#b"}] (app/split-target "/machine/r?label=a%23b#calibration-work")))
  (is (= ["/machine/r%23named" {:label "a#b"}] (app/split-target "/machine/r%23named?label=a%23b")))
  (is (= ["/machine/r" {}] (app/split-target "/machine/r#field?tab=settings"))))

(deftest declared-navigation-renders-the-requested-tab-and-retains-its-browser-target
  (let [seen (atom nil)
        target "/machine/r?tab=settings#calibration-work"
        application {:worlds (fn [_ _] {})
                     :routes [["/machine/:id" (fn [ctx]
                                               (reset! seen ctx)
                                               [:p (get-in ctx [:query :tab])])]]}
        view (app/dispatch nil nil {:app application :route target})
        boundary (second view)]
    (is (= "/machine/r" (:route @seen)))
    (is (= {:id "r" :tab "settings"} (:params @seen)))
    (is (= {:tab "settings"} (:query @seen)))
    (is (= [:p "settings"] (nth boundary 2)))
    (is (= target (:data-live-route (second boundary))))))

;; ── ["ping"] — the heartbeat ─────────────────────────────────────────
;;
;; The client beats every heartbeatMs (default 30s) so a quiet page's socket
;; never hits the server's 120s idle timeout (web/upgrade). The keepalive is
;; the frame's ARRIVAL — the server answers with silence and the socket
;; process must not be touched.

(deftest ping-frame-is-a-noop
  (is (= [:ok {:srv nil}] (handle-in "[\"ping\"]"))))

;; ── anything unrecognised is ignored, not crashed on ─────────────────

(deftest unknown-frame-is-ignored
  (is (= [:ok {:srv nil}] (handle-in "[\"nope\"]"))))

(deftest malformed-payload-is-ignored
  (is (= [:ok {:srv nil}] (handle-in "\"just-a-string\""))))


(deftest navigation-receipt-is-stamped-by-server-not-browser-data
 (diag/with-options {:sink (fn [_] nil) :min-level :info}
  (let [state {:srv (erlang/self)}
        started (erlang/monotonic_time :microsecond)]
   (is (= [:ok state]
          ((get app/ws-handlers :handle-in)
           [:text "[\"event\",[\"navigate\",\"/private-route\"],{\"arrival\":42}]"] state)))
   (let [receipt (receive
                   [:"$gen_cast" [:event ev data arrival]] [ev data arrival]
                   (after 1000 nil))
         arrival (nth receipt 2)]
    (is (= [:navigate "/private-route"] (first receipt)))
    (is (= {:arrival 42} (nth receipt 1)))
    (is (>= arrival started))
    (is (<= arrival (erlang/monotonic_time :microsecond)))
    (is (not= 42 arrival))))))

;; ── ["remount"] — the client could not apply a patch ─────────────────
;; The client sends it when a patch op failed to land; the frame becomes a
;; cast to the session, which ships a fresh mount (live.socket/remount).

(deftest remount-frame-casts-to-the-session
  (let [state {:srv (erlang/self)}]
    (is (= [:ok state] ((get app/ws-handlers :handle-in) [:text "[\"remount\"]"] state)))
    (is (= :remount (receive [:"$gen_cast" [:live/remount]] :remount (after 1000 :none))))))
