(ns live.inspector-test
  (:require [live.inspector :as inspector] [live.app :as app]
            [live.hiccup :as html] [web] [bl.json :as json] [bl.util :as util]
            [runtime.activity :as activity]))

(defn options []
  (merge {:enabled? true :authorize #(= :developer %)}
    (when (= "source" (System/get_env "PROJECTION_PREFLIGHT_MODE"))
      {:assets-root (Path/join (System/fetch_env! "BL_TEST_SOURCE_ROOT") "priv/lib/live")})))

(defn request [path]
  (erlang/apply :Elixir.Plug.Test :conn (list "GET" path "")))

(deftest development-is-explicit-and-decoration-preserves-denied-views
  (let [application {:routes [["/" (fn [_] [:main "App"])]]}]
    (is (= application (inspector/attach application {})))
    (is (thrown? (inspector/attach application {:enabled? true}))))
  (let [decorated (inspector/decorate (fn [_] [:main "App"]) #(= :developer %))]
    (is (= [:main "App"] (decorated {:me :visitor})))
    (let [view (html/hiccup->html (decorated {:me :developer}))]
      (is (String/contains? view "id=\"enchant-inspector-source\""))
      (is (String/contains? view "data-loom-scale"))
      (is (String/contains? view "/__enchant/inspector.js"))
      (is (not (String/contains? view "__pulse/ws"))))))

(deftest every-asset-and-snapshot-reuses-host-authentication
  (let [me (atom :visitor) calls (atom 0) fallback (atom 0)
        application (inspector/attach
          {:principal (fn [_] (swap! calls inc) @me)
           :http (fn [c _] (swap! fallback inc) (web/text c "App endpoint"))
           :routes [["/" (fn [_] [:main "App"])]]}
          (options))]
    (doseq [path ["/__enchant" "/__enchant/inspector.js" "/__enchant/inspector.css" "/__enchant/snapshot.json"]]
      (is (= 404 (:status (app/router application (request path))))))
    (is (= 4 @calls)) (is (= 0 @fallback))
    (reset! me :developer)
    (let [redirect (app/router application (request "/__enchant"))
          script (app/router application (request "/__enchant/inspector.js"))
          data (app/router application (request "/__enchant/snapshot.json"))
          snapshot (json/decode (:resp_body data))]
      (is (= 302 (:status redirect)))
      (is (= "/" (elem (first (filter #(= "location" (elem % 0)) (:resp_headers redirect))) 1)))
      (is (= 200 (:status script)))
      (is (String/contains? (:resp_body script) "live:patch"))
      (is (= "enchant.observatory.v1" (get snapshot "schema")))
      (is (= (util/version) (get-in snapshot ["versions" "bl"])))
      (is (= (erlang/list_to_binary (erlang/system_info :otp_release))
             (get-in snapshot ["versions" "otp"]))))
    (is (= "App endpoint" (:resp_body (app/router application (request "/api")))))
    (is (= 1 @fallback))
    (inspector/close! application)))

(deftest serve-devtools-option-defaults-off-and-owns-its-reader
  (let [application {:routes [["/" (fn [_] [:main "App"])]]}
        plain (app/serve application {:port 0 :ip (tuple 127 0 0 1) :log false})]
    (try (is (nil? (:live/inspector plain))) (finally (app/stop! plain)))
    (let [served (app/serve application {:port 0 :ip (tuple 127 0 0 1) :log false :devtools (options)})
          reader (:live/inspector served)]
      (try (is (= true (:available (activity/snapshot reader))))
        (finally (app/stop! served)))
      (is (= false (:available (activity/snapshot reader))))
      (app/stop! served))))

(deftest serve-launch-preference-supplies-a-default-without-granting-access
  (let [previous (Process/get :bl.serve/devtools)
        authorize (fn [me] (= :developer me))]
    (try
      (Process/put :bl.serve/devtools :on)
      (is (= {} (inspector/serve-options {})))
      (is (= true (:enabled? (inspector/serve-options {:authorize authorize}))))
      (is (= false (:enabled? (inspector/serve-options {:enabled? false :authorize authorize}))))
      (Process/put :bl.serve/devtools :off)
      (is (= {} (inspector/serve-options {:enabled? true :authorize authorize})))
      (finally
        (if (nil? previous) (Process/delete :bl.serve/devtools)
          (Process/put :bl.serve/devtools previous))))))

(deftest authorized-callback-attribution-does-not-change-execution-realm
  (let [previous (Process/get :bl-vm-scope)
        mounted (try
                  (Process/put :bl-vm-scope "inspector-host")
                  (inspector/attach
                    {:routes [["/" (fn [_] [:main "App"])]]
                     :intents {:tool {:target :session :perform
                       (fn [_ _ _] (activity/with-operation :index {} #(activity/mark! :computed)) :original)}}}
                    (options))
                  (finally (Process/put :bl-vm-scope previous)))
        reader (:live/inspector mounted) perform (get-in mounted [:intents :tool :perform])]
    (try
      (is (= :session (get-in mounted [:intents :tool :target])))
      (is (= :original (perform nil nil :developer)))
      (is (= "index" (:tool (first (:recent (activity/snapshot reader))))))
      (is (= previous (Process/get :bl-vm-scope)))
      (is (nil? (Process/get :runtime.activity/scope)))
      (is (= :original (perform nil nil :visitor)))
      (is (= 1 (count (:recent (activity/snapshot reader)))))
      (try
        (Process/put :bl-vm-scope "different-realm")
        (is (= :original (perform nil nil :developer)))
        (is (= 1 (count (:recent (activity/snapshot reader)))))
        (finally (Process/put :bl-vm-scope previous)))
      (let [screen (second (first (:routes mounted)))]
        (screen {:me :developer})
        (is (= "render" (:tool (first (:recent (activity/snapshot reader)))))))
      (finally (inspector/close! mounted)))))
