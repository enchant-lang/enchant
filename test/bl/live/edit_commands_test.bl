(ns live.edit.commands-test
  (:require [live.edit.commands :as c] [live.edit.document :as d]
            [live.edit.extensions :as e] [live.edit.standard :as standard]))
(def ext (e/build [standard/package]))
(def doc (d/prepare (d/document "notes" [(d/block "a" "hello") (d/block "b" "world")])))
(def context {:document doc :selection {:anchor {:block "a" :offset 0} :head {:block "a" :offset 5}}})
(deftest current-parameter-presentation-keeps-enable-and-registry-validation-guards
 (let [policy (fn [_ item]
                (if (= "text/highlight" (:id item))
                 (-> item (assoc-in [:params :tone :default] "mint")
                          (assoc-in [:params :tone :values] ["mint"]) (assoc :enabled true)) item))
       current (e/build [standard/package {:name "current-values" :provides {:editor/command-policy policy}}])
       item (first (filter #(= "text/highlight" (:id %)) (c/query current context)))
       base (first (filter #(= "text/highlight" (:id %)) (c/catalogue current)))
       disabled (first (filter #(= "text/highlight" (:id %)) (c/query current (assoc context :conflict true))))
       plan (c/plan current context "text/highlight" {:tone "forged"} "bad-value")]
  (is (= "mint" (get-in item [:params :tone :default])))
  (is (= ["mint"] (get-in item [:params :tone :values])))
  (is (= "amber" (get-in base [:params :tone :default])))
  (is (false? (:enabled disabled)))
  (is (thrown? (d/apply-op (:functions current) doc (first (:ops plan)))))))
(deftest one-catalogue-describes-every-surface
  (let [items (c/query ext context) bold (first (filter #(= "text/bold" (:id %)) items))]
    (is (= true (:enabled bold))) (is (= "bold" (:icon bold)))
    (is (= "Mod-b" (:shortcut bold))) (is (= "off" (:active bold)))
    (is (some #(= "insert/code" (:id %)) items))))
(deftest a-selection-produces-semantic-operations
  (let [plan (c/plan ext context "text/bold" {} "call")
        changed (d/apply-op (:functions ext) doc (first (:ops plan)))
        next (assoc context :document (:document changed))
        item (first (filter #(= "text/bold" (:id %)) (c/query ext next)))]
    (is (= "style/set" (:op (first (:ops plan)))))
    (is (= "on" (:active item)))
    (is (= false (:enabled (first (:ops (c/plan ext next "text/bold" {} "call2"))))))))
(deftest a-caret-command-sets-future-typing-style
  (let [caret (assoc-in context [:selection :head :offset] 0)
        plan (c/plan ext caret "text/bold" {} "call")]
    (is (= [{:id "call" :function "text/bold" :version 1 :args {}}] (:pending-styles plan)))
    (is (nil? (:ops plan)))))
(deftest custom-commands-use-the-same-context-and-contract
  (let [custom {:name "custom" :provides {:editor/commands
                {"notes/title" {:label "Title" :run (fn [_ args] {:ops [{:op "document/meta" :patch {:title (:text args)}}]})}}}}
        ext (e/build [standard/package custom])
        plan (c/plan ext context "notes/title" {:text "Field notes"} "call")]
    (is (= "Field notes" (get-in plan [:ops 0 :patch :title])))))
(deftest code-blocks-expose-transforms-and-shared-history-without-hidden-rich-formatting
  (let [doc (d/document "code" [(d/block "c" "code" "(+ 1 2)" {})])
        context {:document doc :selection {:anchor {:block "c" :offset 0} :head {:block "c" :offset 7}}}
        commands (c/query ext context)
        bold (first (filter #(= "text/bold" (:id %)) commands))
        transform (first (filter #(= "text/uppercase" (:id %)) commands))]
    (is (= false (:enabled bold)))
    (is (= true (:enabled transform)))))

(deftest source-owned-blocks-render-without-offering-insert-or-turn-commands
 (let [retained {:name "retained" :provides {:editor/blocks
                   {"retained" {:label "Retained source" :slots [] :insertable false}}}}
       ext (e/build [standard/package retained])
       ids (set (map :id (c/query ext context)))]
  (is (contains? (:blocks ext) "retained"))
  (is (not (some #(= "retained" (:id %)) (:blocks (e/catalog ext)))))
  (is (not (contains? ids "insert/retained")))
  (is (not (contains? ids "turn/retained")))
  (is (contains? ids "insert/code"))
  (is (thrown? (c/plan ext context "insert/retained" {} "retained")))))

(deftest duplicate-rebases-declared-self-references-through-the-complete-subtree
 (let [attrs {:identity/self ["example/owner"] :example/owner "one" :example/other "one"}
       initial (d/prepare (d/document "ownership" [(d/block "one" "task" "Parent" attrs)
                 (assoc (d/block "child" "Nested") :parent "one" :attrs (assoc attrs :example/owner "child"))]))
       context {:document initial :selection {:anchor {:block "one" :offset 0} :head {:block "one" :offset 0}}}
       plan (c/plan ext context "block/duplicate" {} "copy")
       copied (:document (d/apply-op (:functions ext) initial (first (:ops plan))))
       clone (d/find-block copied "copy/0") child (d/find-block copied "copy/1")
       split (:document (d/apply-op (:functions ext) initial
                          {:op "block/split" :block "one" :at 6 :new "split" :rightMeta {:type "task" :attrs attrs}}))]
  (is (= "copy/0" (get-in clone [:attrs :example/owner])))
  (is (= "copy/1" (get-in child [:attrs :example/owner])))
  (is (= "one" (get-in clone [:attrs :example/other])))
  (is (= "copy/0" (:parent child)))
  (is (= "one" (get-in (d/find-block split "split") [:attrs :example/owner])))))

(deftest repeated-duplicates-keep-application-identities-fresh-and-bounded
 (let [original-block (assoc (d/block "original" "Rich text") :marks
               [{:from 0 :to 4 :call {:id (apply str (repeat 120 "a")) :function "text/bold" :version 1 :args {}}}])
       final (loop [doc (d/prepare (d/document "bounded-copy" [original-block])) id "original" at 0]
               (if (= at 6) doc
                (let [seed (str "copy-" at)
                      ctx {:document doc :selection {:anchor {:block id :offset 0} :head {:block id :offset 0}}}
                      plan (c/plan ext ctx "block/duplicate" {} seed)
                      next (:document (d/apply-op (:functions ext) doc (first (:ops plan))))]
                 (recur next (str seed "/0") (inc at)))))]
  (is (d/valid? final))
  (is (= 7 (count (:blocks final))))
  (is (= 7 (count (d/call-ids final))))
  (is (every? #(<= (d/length %) 128) (d/call-ids final)))))

(deftest configuring-a-caret-function-replaces-args-without-toggling-it-off
 (let [caret (-> context (assoc-in [:selection :head :offset] 0)
                        (assoc :pending-styles [{:id "old" :function "text/highlight" :version 1 :args {:tone "amber"}}]))
       ordinary (c/plan ext caret "text/highlight" {:tone "mint"} "ordinary")
       configured (c/plan ext (assoc caret :configure true) "text/highlight" {:tone "mint"} "configured")]
  (is (= [] (:pending-styles ordinary)))
  (is (= [{:id "configured" :function "text/highlight" :version 1 :args {:tone "mint"}}] (:pending-styles configured)))
  (is (thrown? (c/plan ext (assoc caret :configure true) "text/highlight" {:tone "invalid"} "invalid")))))
