(ns system.formal-temporal-baseline-test
 (:require [datom.time :as time] [oracle]))

(def uncertain
 {:script (fn [_ _] {:status "unknown"})
  :query (fn [question _] (oracle/query-answer question {:solver-status :unknown}))})

(deftest empty-half-open-spans-do-not-overlap
 (is (= false (time/overlaps? {:from 1 :to 1} {:from 0 :to 2})))
 (is (= true (time/disjoint? {:from 1 :to 1} {:from 0 :to 2}))))

(deftest missing-solver-information-is-not-mixed-temporal-possibilities
 (is (= :unknown (oracle/with-oracle uncertain
                  (fn [] (time/overlap-verdict {} {:from 0 :to 2} {:from 1 :to 3}))))))

(deftest a-strict-consistency-predicate-refuses-an-unresolved-answer
 (is (thrown? (oracle/with-oracle uncertain
               (fn [] (time/consistent? {} {:event [0 3]} []))))))

(deftest an-ignored-legacy-port-cannot-select-a-native-solver
 (is (thrown? (oracle/with-oracle uncertain
               (fn [] (time/overlap-verdict :legacy-port {:from 0 :to 2} {:from 1 :to 3}))))))
