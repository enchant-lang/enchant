(ns system.linear-term-baseline-test
 (:require [system.linear :as linear] [oracle]))

(deftest a-size-lemma-is-an-inspectable-portable-question
 (let [problem (linear/size-lemma 12 2 8)]
  (is (map? problem))
  (is (= 1 (:formal/query problem)))
  (is (= :prove (:mode problem)))))

(deftest a-size-bound-needs-checked-evidence-rather-than-an-oracle-label
 (let [seen (atom [])
       result (oracle/with-oracle
                {:script (fn [_ _] {:status :unknown})
                 :query (fn [question _]
                          (swap! seen conj question)
                          (oracle/query-answer question {:phase :query :solver-status :unknown :verdict :unknown}))}
                #(linear/prove-bound {:backend :oxiz} 12 8 2))]
  (is (= true (:holds result)))
  (is (= :declared-size-recurrence (:claim-scope result)))
  (is (= false (:compiler-proof-authority result)))
  (is (= 4 (count @seen)))
  (is (every? #(= :checked (get-in % [:linear :certificate :status])) (:arities result)))))
