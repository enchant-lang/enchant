(ns system.linear-verdict-baseline-test
 (:require [system.linear :as linear] [oracle]))

(deftest exhausted-proof-search-retains-unknown-truth
 (let [result (linear/prove-bound {:search {:nodes 1}} 12 8 1)]
  (is (= :unknown (get-in result [:arities 0 :linear :certificate :status])))
  (is (nil? (:holds result)))
  (is (= :unknown (:status result)))))

(deftest theorem-search-and-preparation-have-separate-budgets
 (let [seen (atom [])
       result (oracle/with-oracle
                {:query (fn [question _]
                          (swap! seen conj question)
                          (oracle/query-answer question {:phase :query :solver-status :unsat}))}
                #(linear/prove-bound {:backend :z3 :search {:nodes 1}} 12 8 1))]
  (is (= 2 (count @seen)))
  (is (= :proved (get-in result [:arities 0 :linear :native :result :verdict])))
  (is (nil? (:holds result)))
  (is (= :unknown (:status result)))))
