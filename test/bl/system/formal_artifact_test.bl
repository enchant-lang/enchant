(ns system.formal-artifact-test
 (:require [formal.term :as t] [formal.query :as q] [formal.logic :as logic]))

(def x (t/variable "sdk.artifact.x" t/Int))
(def problem (q/sat {:id :sdk/packaged-worker
                     :assumptions [(t/eq x (t/int 7))] :observe {"x" x}}))

(deftest either-backend-is-usable-without-a-research-path-or-worker-environment
 (doseq [engine [:z3 :oxiz]]
  (let [answer (try (logic/run {:backend engine} problem)
                   (catch error {:verdict :error :error (ex-message error)}))]
   (is (= :sat (:verdict answer)) (pr-str answer))
   (is (= :valid (get-in answer [:validation :status])))
   (is (= 7 (get-in answer [:witness "x"]))))))
