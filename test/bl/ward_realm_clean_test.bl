; ward_realm_clean_test.bl — the runner leaves the env it serves clean (W2).
;
; The test library is tier code: ward loads it into core at :global. A version
; that interns it into the env the command runs in (the project's realm under
; `bl test`) leaves a scoped `core` compiler generation there, and every
; `local_package_authority` in an env that chains through it declines with
; `:unsupported scoped compiler context` — the `Shared namespace admission
; refused` that broke realm_ownership in a multi-file run. This test asks the
; question directly: does any env this file chains through carry a core
; definition the global env does not?
;
; In this checkout the file's chain is [file fork, ward base, realm, :global];
; run through the shared runner it is [file fork, base, :global]. `:global`
; is the one env the compiler authority admits nonzero rows for.

(ns ward-realm-clean-test)

(deftest no-ancestor-carries-a-scoped-core-definition
  (let [rows (filter (fn [r] (and (not= :global (elem r 0))
                                  (not (and (= 0 (elem r 2)) (= 0 (elem r 3))))))
                     (BeamLisp.Env/namespace_generations (list "core")))]
    (is (empty? rows)
        (str "the runner left core definitions in an env this file chains through: "
             (pr-str rows)))))
