(ns unix-identity-client (:require [bl.json :as json]))
(let [mode (first (BeamLisp/argv))
      result (gen_tcp/connect (tuple :local (String/to_charlist "/run/peercheck/socket")) 0
               (list (tuple :inet_backend :inet) :local :binary (tuple :packet 4) (tuple :active false)) 3000)]
 (if (= "filesystem-denied" mode)
  (do
   (when-not (= (tuple :error :eacces) result) (throw (ex-info "Socket ACL did not refuse outsider" {})))
   (println "filesystem-denied"))
  (let [socket (elem result 1)]
   (try
    (gen_tcp/send socket (json/encode {"uid" 0 "subject" "forged-root" "roles" ["admin"]}))
    (let [response (gen_tcp/recv socket 0 3000)]
     (when-not (= :ok (elem response 0)) (throw (ex-info "No identity response" {})))
     (println (elem response 1)))
    (finally (gen_tcp/close socket))))))
