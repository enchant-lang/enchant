; Finite mechanism fixture, not a production acceptor. Three actual OS users.
(ns unix-identity-server (:require [auth.unix :as unix] [auth.identity :as identity] [bl.json :as json]))
(let [path "/run/peercheck/socket"
      opened (gen_tcp/listen 0 (list (tuple :inet_backend :inet) :local :binary
                                   (tuple :ifaddr (tuple :local (String/to_charlist path)))
                                   (tuple :packet 4) (tuple :packet_size 4096) (tuple :active false)))
      _ (when-not (= :ok (elem opened 0)) (throw (ex-info "Identity fixture listener unavailable" {})))
      listener (elem opened 1)
      resolver (fn [uid] (case uid 1000 {:subject "person:alice" :kind :person}
                                  1001 {:subject "person:bob" :kind :person} nil))]
 (try
  (let [started (System/monotonic_time :millisecond)]
   (identity/without-identity (fn [] nil))
   (IO/puts :stderr (json/encode {"stage" "identity-prepared" "elapsedMs" (- (System/monotonic_time :millisecond) started)})))
  (File/chmod! path 432)
  (File/write! "/run/peercheck/ready" "ready")
  (dotimes [_ 3]
   (let [accepted (gen_tcp/accept listener 60000)
         _ (when-not (= :ok (elem accepted 0)) (throw (ex-info "Identity fixture accept expired" {})))
         socket (elem accepted 1) started (System/monotonic_time :millisecond)]
    (try
     (IO/puts :stderr (json/encode {"stage" "accepted"}))
     (let [request (gen_tcp/recv socket 0 3000)
           _ (when-not (= :ok (elem request 0)) (throw (ex-info "Identity fixture frame missing" {})))
           reply (try
                  (do
                   (IO/puts :stderr (json/encode {"stage" "frame-received"}))
                   (unix/with-peer! socket "messages" resolver
                   (fn [] (let [principal (identity/current)]
                            {"ok" true "uid" (:uid principal) "subject" (:subject principal)
                             "application" (:application principal)}))))
                  (catch _ {"ok" false}))]
      (IO/puts :stderr (json/encode {"stage" "identity-resolved" "elapsedMs" (- (System/monotonic_time :millisecond) started)}))
      (gen_tcp/send socket (json/encode reply))
      (when (identity/current) (throw (ex-info "Identity leaked outside request" {}))))
     (finally (gen_tcp/close socket)))))
  (finally (gen_tcp/close listener) (File/rm path))))
