(ns unix-rpc-client
 (:require [rpc.unix :as rpc] [auth.interface :as interface] [auth.logic :as logic] [bl.json :as json]))
(let [mode (first (BeamLisp/argv))
      operation (if (= "claim" mode) "claim!" "inbox")
      resource (if (= "private" mode) "private" "ora")
      ;; The contract is host-enrolled checked metadata, not identity evidence.
      prepared (logic/prepare (File/read! (second (BeamLisp/argv))))
      p {:world "field-station/prototype" :manifest (interface/manifest prepared)}
      request (interface/request p operation
                (if (= "claim" mode) [resource "alice-message" "claim-one"] [resource]))
      request (if (= "forged" mode) (assoc request "uid" 0 "subject" "carol") request)
      reply (rpc/request! "/run/rpccheck/socket" request {:timeout-ms 15000})]
 (println (json/encode reply)))
(System/halt 0)
