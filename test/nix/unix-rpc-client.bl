(ns unix-rpc-client
 (:require [rpc.unix :as rpc] [auth.interface :as interface] [auth.contract :as contract] [bl.json :as json]))
(if (= "filesystem-denied" (first (BeamLisp/argv)))
 (let [result (gen_tcp/connect (tuple :local (String/to_charlist "/run/rpccheck/socket")) 0
                (list (tuple :inet_backend :inet) :local :binary (tuple :active false)) 3000)]
  (when-not (= (tuple :error :eacces) result) (throw (ex-info "Expected actual filesystem denial" {})))
  (println "filesystem-denied"))
 (let [mode (first (BeamLisp/argv))
      operation (if (= "claim" mode) "claim!" "inbox")
      resource (if (= "private" mode) "private" "ora")
      ;; The contract is host-enrolled checked metadata, not identity evidence.
      p {:world "field-station/prototype" :manifest (contract/read! "/run/rpccheck/interface.edn")}
      request (interface/request p operation
                (if (= "claim" mode) [resource "alice-message" "claim-one"] [resource]))
      request (if (= "forged" mode) (assoc request "uid" 0 "subject" "carol") request)
      reply (rpc/request! "/run/rpccheck/socket" request {:timeout-ms 15000})]
 (println (json/encode reply))))
(System/halt 0)
