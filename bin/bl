#!/bin/sh
# Checkout commands select immutable Nix prerequisites and SDK before BEAM.
# The native transport reaches a warm realm before doing cold preparation.
set -e
unset BL_INTERNAL_PRODUCER BL_CHECKOUT_PLATFORM_SELECTED

# Every fork here is paid by every command: resolve directories with the
# shell's own cd -P, and fall back to readlink only for what is not one.
case "$0" in */*) HERE=${0%/*} ;; *) HERE=. ;; esac
# Program argv after -- is opaque to the launcher.
COLD=
for arg in "$@"; do
  [ "$arg" = "--" ] && break
  if [ "$arg" = "--cold" ]; then COLD=1; break; fi
done

# The warm path is one exec, with no fork. The client selects the checkout
# platform itself (tooling/drop/src/checkout_platform.rs): it re-stats the
# listing the platform script recorded, runs the script only when that listing
# moved, and execs the selected platform's client when that is another binary.
# It starts as the client of the platform it last selected, which only such a
# client records, and canonicalizes the root it is given.
CLIENT="$HERE/../.bl/checkout-platform/bin/drop-launcher"
if [ -z "$COLD" ] && [ -z "${BL_CHECKOUT_COLD:-}" ] && [ -z "${BL_CHECKOUT_PLATFORM:-}" ] && [ -x "$CLIENT" ]; then
  exec "$CLIENT" --checkout "$HERE/.." -- "$@"
fi

ROOT=$(CDPATH='' cd "$HERE/.." && pwd -P)
resolve_dir() { (CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P) || readlink -f "$1"; }
export BL_CHECKOUT_ROOT="$ROOT"
[ -n "$COLD" ] && BL_CHECKOUT_COLD=$ROOT

# The managed platform supplies the stock client, runtime and mandatory NIF
# before any BEAM starts. Build sandboxes pass their already prepared platform.
PLATFORM=${BL_CHECKOUT_PLATFORM:-}
if [ -z "$PLATFORM" ]; then
  PLATFORM=$("$ROOT/scripts/prepare-checkout-platform")
  SELECTED=1
fi
PLATFORM=$(resolve_dir "$PLATFORM")
case "$PLATFORM" in
  /nix/store/*) ;;
  *) echo 'bl: checkout platform must be an immutable Nix product' >&2; exit 69 ;;
esac
if [ ! -f "$PLATFORM/platform.json" ] || [ ! -x "$PLATFORM/bin/drop-launcher" ]; then
  echo 'bl: checkout platform is incomplete' >&2
  exit 69
fi
export BL_CHECKOUT_PLATFORM="$PLATFORM"
export BL_ARTIFACT_PLATFORM="$PLATFORM/artifact-platform"
NATIVES=$(resolve_dir "$PLATFORM/native-products")
export BL_PREPARED_NATIVES="$NATIVES"
export BL_BIN="$PLATFORM/bin/drop-launcher"
export PATH="$PLATFORM/bin:$PATH"

# The native client reaches a running VM before any Elixir probe or staging.
# Its cold child comes back through this script exactly once. A preset
# platform (build sandboxes) is used as given.
if [ "${BL_CHECKOUT_COLD:-}" != "$ROOT" ]; then
  # The client captures checked engine bytes once and reuses their digests
  # for its overlapping runtime/project pins. Cold selection remains locked.
  CLIENT="$PLATFORM/bin/drop-launcher"
  # A client that selection named may record itself for the one-exec path.
  [ -n "${SELECTED:-}" ] && export BL_CHECKOUT_PLATFORM_SELECTED="$PLATFORM"
  exec "$CLIENT" --checkout "$ROOT" -- "$@"
fi
unset BL_CHECKOUT_COLD

# Stopping a realm needs no edited engine: while another caller prepares an
# SDK, it runs on the current one instead of queueing behind that build.
WORDS=''
for arg in "$@"; do
  [ "$arg" = "--" ] && break
  case "$arg" in -*) ;; *) WORDS="$WORDS $arg" ;; esac
done
case "$WORDS" in
  ' realm stop'|' realm stop '*) BL_SDK_REUSE_CURRENT=${BL_SDK_REUSE_CURRENT:-1}; export BL_SDK_REUSE_CURRENT ;;
esac
SELECTION=$("$ROOT/scripts/prepare-checkout-sdk" --selection)
SDK=${SELECTION% *}
BL_CHECKOUT_SDK_INPUTS=${SELECTION##* }
export BL_CHECKOUT_SDK_INPUTS
SDK=$(readlink -f "$SDK")
# The selection verified the product (scripts/prepare-checkout-sdk
# verify_selection, or its recorded verdict for a settled tree); these are
# the same shape checks without another interpreter start.
refuse() { echo "bl: $1" >&2; exit 1; }
case "$BL_CHECKOUT_SDK_INPUTS" in *[!0-9a-f]*|'') refuse 'SDK selection lacks its captured input fingerprint' ;; esac
[ "${#BL_CHECKOUT_SDK_INPUTS}" -eq 64 ] || refuse 'SDK selection lacks its captured input fingerprint'
case "$SDK" in /nix/store/*) ;; *) refuse 'SDK must be an immutable Nix product' ;; esac
NAME=${SDK#/nix/store/}
HASH=${NAME%%-*}
case "$NAME:$HASH" in */*|*:*[!0-9a-z]*) refuse 'SDK must be an immutable Nix product' ;; esac
[ "${#HASH}" -eq 32 ] && [ "$HASH" != "$NAME" ] && [ -n "${NAME#*-}" ] ||
  refuse 'SDK must be an immutable Nix product'
[ -f "$SDK/artifact.json" ] || refuse 'unsupported SDK product'
[ -f "$SDK/image/ebin/Elixir.BeamLisp.Launcher.beam" ] || refuse 'incomplete SDK product'
export BL_SDK_PRODUCT="$SDK"
COORDINATOR=$(readlink -f "$SDK/preparation-coordinator")
export BL_PREPARATION_COORDINATOR="$COORDINATOR"
export BL_ROOT="$SDK/image"
export BL_EBIN="$SDK/image/ebin"
export BL_BUILD_ID=src
export BEAM_LISP_DEV=0
# Only immutable SDK dependencies enter the VM. Producer/bootstrap staging is
# confined to bin/bl-producer inside the trusted Nix recipes.
# Boot exactly as the SDK's own bin/bl-cold does: its boot.exs puts the
# platform's Elixir ahead of the payload's ebin-only copy, then the image.
if [ -f "$SDK/boot.exs" ]; then
  exec elixir "$SDK/boot.exs" "$@"
fi
PA=""
for directory in "$SDK"/lib/*/ebin; do
  PA="$PA -pa $directory"
done
exec elixir $PA -e ':code.del_path(~c"."); BeamLisp.Launcher.start_app!(System.argv(), %{})' -- "$@"
