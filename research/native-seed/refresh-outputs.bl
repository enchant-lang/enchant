; Bound each independent producer's Env and reclaim it before the next one.
; A selector retries only the failed producer; completed artifacts are reused.
(ns native.refresh-outputs)
(def requested (BeamLisp/argv))
(def jobs {"assemble" "research/native-seed/src/native/chunks.bl"
           "scalar" "research/native-seed/direct/scalar.bl"
           "actors" "research/native-seed/corpus/prepare-all.bl"
           "real" "research/native-seed/real/prepare.bl"
           "proc-demand" "research/native-seed/build-runtime.bl"
           "proc-composed" "research/native-seed/build-runtime.bl"})
(def selected (if (empty? requested) ["assemble" "scalar" "actors"] requested))
(doseq [job selected]
 (assert (contains? jobs job))
 (BeamLisp.Env/isolated
  (fn []
   (BeamLisp/with_argv
    (case job
     "assemble" (list "assemble")
     "proc-demand" (list "research/native-seed/fixtures/proc-demand.bl" "research/native-seed/out/proc-demand.scm")
     "proc-composed" (list "research/native-seed/fixtures/proc-composed.bl" "research/native-seed/out/proc-composed.scm")
     (list))
    (fn [] (BeamLisp/run_file (get jobs job))))))
 (erlang/garbage_collect))
