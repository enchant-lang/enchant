; Refresh independent outputs in one capped VM using the retained SDK.
; No language compilation is repeated for the admitted compiler closure.
(ns native.refresh-outputs)
(assert (empty? (BeamLisp/argv)))
(BeamLisp/with_argv (list "assemble")
 (fn [] (BeamLisp/run_file "research/native-seed/src/native/chunks.bl")))
(BeamLisp/run_file "research/native-seed/direct/scalar.bl")
(BeamLisp/run_file "research/native-seed/corpus/prepare-all.bl")
