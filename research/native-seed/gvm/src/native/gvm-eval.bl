; The canonical reader/compiler owns Source -> ANF. This adapter selects the
; native GVM emitter and the DATA-only backend loader; it never evaluates text.
(ns native.gvm-eval
 (:require [native.gvm-lower :as gvm]))

(defn options [context]
 ; native.eval/context contains Scheme TEXT formatters. They are deliberately
 ; absent here: native.gvm-lower emits actual global/remote value operations.
 (dissoc context :global-resolver :remote-resolver
                 :arithmetic-resolver :binding-resolver))

(defn eval-node [node context]
 (let [name (host/native-gvm-next-name)
       emitted (gvm/emit-unit node (assoc (options context) :module name :unit-name name))]
  (host/eval-gvm-unit emitted)))
