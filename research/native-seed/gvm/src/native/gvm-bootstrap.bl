; The original canonical bootstrap owns reading, macros and ANF compilation.
; Only the selected backend and finite native packaging differ here.
(ns native.gvm-bootstrap
 (:require [native.bootstrap :as bootstrap] [native.gvm-units :as units]))
(defn compile-bundle [bundle host-source host-ledger output]
 (bootstrap/install-source-macros! bundle)
 (let [prepared (mapv bootstrap/prepare (:units bundle))]
  (units/write-plan! prepared (bootstrap/data (dissoc bundle :units)) host-source host-ledger
   {:write (fn [path text] (host/write-file path text))
    :mkdir (fn [path] (host/native-gvm-mkdir path))
    :digest (fn [text] (host/native-gvm-sha256 text))}
   output "(native-main (native-command-line))\n")))
(defn main [args]
 (if (and (= 5 (count args)) (= "--compile-gvm" (first args)))
  (let [bundle (host/eval-scheme (host/read-file (nth args 1)))
        host-source (host/read-file (nth args 2))
        host-ledger (host/eval-scheme (host/read-file (nth args 3)))
        plan (compile-bundle bundle host-source host-ledger (nth args 4))]
   (println (str "NATIVE_GVM_SELF_EMISSION " (count (:units plan)) " bounded units")))
  (throw (ex-info "usage: native-compiler --compile-gvm bundle.scm host.scm host.components.scm output-directory" {:args args}))))
