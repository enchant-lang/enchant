;; Importer DATA-reader checks only. Load after import.scm in root's GSC run.
(define gvm-reader-tripwire #f)
(define gvm-reader-checks 0)
(define (gvm-reader-check label ok)
 (if (not ok) (error "GVM data-only reader" label))
 (set! gvm-reader-checks (+ gvm-reader-checks 1)))
(define (gvm-reader-refuses? thunk)
 (with-exception-catcher (lambda (failure) #t) (lambda () (thunk) #f)))
(let* ((dir (or (getenv "BL_GVM_READ_PROBE_DIR" #f) "."))
       (path (string-append dir "/gvm-reader-negative.data"))
       (ambient (readtable-eval-allowed?-set (##make-standard-readtable) #t)))
 (define (input text)
  (call-with-output-file path (lambda (port) (display text port))))
 (dynamic-wind
  (lambda () #f)
  (lambda ()
   (parameterize ((current-readtable ambient))
    (input "(owned 42)")
    (gvm-reader-check 'plain-data (equal? '(owned 42) (gvm-import-read path)))
    (input "#.(begin (set! gvm-reader-tripwire #t) '(owned 42))")
    (gvm-reader-check 'reader-eval-refused (gvm-reader-refuses? (lambda () (gvm-import-read path))))
    (gvm-reader-check 'reader-eval-never-ran (not gvm-reader-tripwire))
    (input "#1=(cycle . #1#)")
    (gvm-reader-check 'reader-sharing-refused (gvm-reader-refuses? (lambda () (gvm-import-read path))))
    (gvm-reader-check 'ambient-table-restored (eq? (current-readtable) ambient))))
  (lambda () (if (file-exists? path) (delete-file path)))))
(if (not (= gvm-reader-checks 5)) (error "GVM reader check count" gvm-reader-checks))
(display "NATIVE_GVM_DATA_READER_PASS 5") (newline) (force-output)
