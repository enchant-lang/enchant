;; Observer of original BL ds-adder and ds-tail compiled to native GVM code.
(define gvm-capture-checks 0)
(define (gvm-capture-check label ok)
 (if (not ok) (error "native GVM capture" label))
 (set! gvm-capture-checks (+ gvm-capture-checks 1)))
(with-exception-catcher
 (lambda (failure) (display-exception failure) (exit 1))
 (lambda ()
  (load (or (getenv "BL_GVM_PROBE_MODULE" #f) (error "missing explicit GVM module")))
  (let ((adder (eval 'native-gvm-scalar/ds-adder))
        (tail (eval 'native-gvm-scalar/ds-tail)))
   (gvm-capture-check 'adder-native (and (procedure? adder) (not (##interp-procedure? adder))))
   (gvm-capture-check 'tail-native (and (procedure? tail) (not (##interp-procedure? tail))))
   (let ((a (adder 7)) (b (adder 11)))
    (gvm-capture-check 'first-native (and (procedure? a) (not (##interp-procedure? a))))
    (gvm-capture-check 'second-native (and (procedure? b) (not (##interp-procedure? b))))
    (gvm-capture-check 'distinct-closures (not (eq? a b)))
    (gvm-capture-check 'first-capture (= (a 9) 16))
    (gvm-capture-check 'second-capture (= (b 9) 20))
    (##gc)
    (gvm-capture-check 'first-after-gc (= (a 9) 16))
    (gvm-capture-check 'second-after-gc (= (b 9) 20))
    (gvm-capture-check 'tail-after-gc (= (tail @LARGE@ 0) (quotient (* @LARGE@ (+ @LARGE@ 1)) 2))))
   (if (not (= gvm-capture-checks 10)) (error "GVM capture check count" gvm-capture-checks))
   (display "NATIVE_GVM_CAPTURE_PASS ") (write gvm-capture-checks) (newline) (force-output)
   (exit 0))))
