; Bounded diagnostic of the SAME first canonical definition group. SDK only.
(ns native.gvm-emit-first
 (:require [native.artifact :as artifact] [native.gvm-lower :as gvm]
           [native.gvm-eval :as eval] [native.eval :as ev] [bl.json :as json]))
(def args (BeamLisp/argv))
(def closure (artifact/read-closure (first args)))
(def output (nth args 1))
(def size (Integer/parse! (or (nth args 2 nil) "1")))
(assert (<= 1 size 32))
(def definitions
 (vec (take size (mapcat (fn [ns]
       (let [unit (get (:units closure) ns)]
        (map #(assoc % :ns ns :path (:path unit)) (filter #(= :fn (:kind %)) (:defs unit)))))
       (:order closure)))))
(println (str "GVM_DIAGNOSTIC_BEGIN " (pr-str (mapv #(select-keys % [:ns :name]) definitions))))
(def emitted (gvm/emit-definitions definitions
 (assoc (eval/options (ev/context "user")) :unit-name "native_gvm_first")))
(File/mkdir_p! output)
(File/write! (str output "/module.gvm-data") (:data-source emitted))
(File/write! (str output "/manifest.json") (json/encode (:manifest emitted)))
(println (str "GVM_DIAGNOSTIC_EMITTED " (count definitions) " " (erlang/byte_size (:data-source emitted)) " bytes"))
