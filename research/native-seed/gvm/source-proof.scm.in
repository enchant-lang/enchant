;; Observation and no-fallback guards only. ORIGINAL bundle DATA follows.
;; No authored Source, Scheme function body, ANF or GVM is interpreted here.
(native-gvm-require-runtime-abi! 1)
(define gvm-source-data-bundle (native-read-file @BUNDLE_PATH@))
(define gvm-source-data-ledger (native-read-file @LEDGER_PATH@))
(define gvm-source-static-owner-names '@OWNER_GLOBALS@)
(define gvm-source-export-rows '@EXPORT_ROWS@)
(define gvm-source-required
 '(("rt" "k-first") ("reader" "read-string") ("compiler" "compile")
   ("native.bootstrap" "prepare") ("native.eval" "eval-form")
   ("native.gvm-lower" "emit-unit") ("native.gvm-eval" "eval-node")
   ("native.gvm-units" "write-plan!") ("native.gvm-bootstrap" "main")))
(define (gvm-source-binding name)
 ;; Only one generated SYMBOL lookup; never a parsed/evaluated function body.
 (eval (string->symbol name) (interaction-environment)))
(define (gvm-source-parent function)
 (if (not (and (procedure? function) (not (##interp-procedure? function))))
  (error "GVM Source export is not a genuine native procedure"))
 (let* ((code (if (##closure? function) (##closure-code function) function))
        (parent (##subprocedure-parent code)))
  (if (not (and (procedure? parent) (not (##interp-procedure? parent))))
   (error "GVM Source procedure has no genuine native owner")) parent))
(define gvm-source-static-parents (map (lambda (name)
 (gvm-source-parent (gvm-source-binding name))) gvm-source-static-owner-names))
(define (gvm-source-callable? value parents)
 (cond
  ((procedure? value)
   (and (not (##interp-procedure? value)) (memq (gvm-source-parent value) parents) #t))
  ((native-multi-callable? value)
   (let ((fixed (native-map-pairs (bl-nth value 1))) (variadic (bl-nth value 2)))
    (and (or (pair? fixed) (not (bl-is-nil variadic)))
     (let loop ((rows fixed))
      (or (null? rows)
       (and (gvm-source-callable? (bl-nth (car rows) 1) parents) (loop (cdr rows)))))
     (or (bl-is-nil variadic) (gvm-source-callable? (bl-nth variadic 1) parents)))))
  (else #f)))
(for-each (lambda (row)
 (let ((function (gvm-source-binding (car row)))
       (arity (cadr row)) (owner (gvm-source-binding (caddr row))))
  (if (not (and (eq? (gvm-source-parent function) (gvm-source-parent owner))
                (native-callable-accepts? function arity)))
   (error "GVM Source physical export/arity differs from emitted inventory" row))))
 gvm-source-export-rows)
(for-each (lambda (row)
 (if (not (gvm-source-callable? (native-global-exact (car row) (cadr row)) gvm-source-static-parents))
  (error "required authored compiler export is not actual native GVM" row))) gvm-source-required)
(if (not (eq? ((native-leaf "host/native-backend/0")) (bl-key "gvm")))
 (error "GVM Source qualification requires backend=gvm"))
(define gvm-source-original-scheme (native-leaf "host/eval-scheme/1"))
(if (not (eq? gvm-source-original-scheme native-eval-string))
 (error "GVM Source guard expected the original Scheme DATA boundary"))
(define (gvm-source-data-only text)
 (if (not (and (string? text)
               (or (string=? text gvm-source-data-bundle) (string=? text gvm-source-data-ledger))))
  (error "authored Source attempted Scheme evaluation during GVM qualification"))
 (gvm-source-original-scheme text))
(native-gvm-replace-leaf! "host/eval-scheme/1" gvm-source-original-scheme gvm-source-data-only 1)
(set! native-eval-string gvm-source-data-only)
(define gvm-source-original-set-backend (native-leaf "host/set-native-backend/1"))
(native-gvm-replace-leaf! "host/set-native-backend/1" gvm-source-original-set-backend
 (lambda (backend)
  (if (not (eq? backend (bl-key "gvm"))) (error "GVM Source gate forbids another backend"))
  (gvm-source-original-set-backend backend)) 1)
(define (native-c-drive . arguments) (error "old C stepper forbidden in GVM Source gate"))
(define (native-c-invoke . arguments) (error "old C descriptors forbidden in GVM Source gate"))
(define gvm-source-current-manifest (make-parameter #f))
(define gvm-source-retained '())
(define gvm-source-evaluations 0)
(define gvm-source-collections 0)
(define gvm-source-across-modules? #f)
(define gvm-source-entry-ticks 0)
(define gvm-source-original-tick h-tick)
(set! h-tick (lambda ()
 (set! gvm-source-entry-ticks (+ gvm-source-entry-ticks 1))
 (gvm-source-original-tick)))
(define (gvm-source-owner-parents manifest)
 (map (lambda (name) (gvm-source-parent (gvm-source-binding name)))
      (bl-items (bl-get manifest (bl-key "owner-globals")))))
(define gvm-source-original-register bl-register-callable!)
(set! bl-register-callable! (lambda (function arity)
 (let ((answer (gvm-source-original-register function arity))
       (manifest (gvm-source-current-manifest)))
  (if (and manifest (< (length gvm-source-retained) 3)
           (procedure? function) (not (##interp-procedure? function))
           (memq (gvm-source-parent function) (gvm-source-owner-parents manifest)))
   (set! gvm-source-retained
    (cons (vector function (gvm-source-parent function)
                  (bl-get manifest (bl-key "module")) arity) gvm-source-retained))) answer)))
(define gvm-source-original-eval (native-leaf "host/eval-gvm-unit/1"))
(native-gvm-replace-leaf! "host/eval-gvm-unit/1" gvm-source-original-eval
 (lambda (emitted)
  (let* ((manifest (native-gvm-validate-manifest! (bl-get emitted (bl-key "manifest"))))
         (name (bl-get manifest (bl-key "module")))
         (before (native-map-count native-gvm-loaded-modules))
         (answer (parameterize ((gvm-source-current-manifest manifest))
                   (gvm-source-original-eval emitted)))
         (artifact (car native-gvm-loaded-artifacts))
         (owners (gvm-source-owner-parents manifest)))
   (if (not (and (= (vector-length artifact) 4) (eq? (vector-ref artifact 1) emitted)
                 (> (native-map-count native-gvm-loaded-modules) before)
                 (pair? owners)))
    (error "GVM Source evaluation did not retain the actual emitted native module"))
   (set! gvm-source-evaluations (+ gvm-source-evaluations 1))
   (if (let loop ((rows gvm-source-retained))
        (and (pair? rows) (or (not (string=? name (vector-ref (car rows) 2))) (loop (cdr rows)))))
    (set! gvm-source-across-modules? #t))
   (if (and gvm-source-across-modules? (= gvm-source-collections 0))
    (begin (##gc) (set! gvm-source-collections 1)))
   (for-each (lambda (row)
    (if (not (and (eq? (gvm-source-parent (vector-ref row 0)) (vector-ref row 1))
                  (native-callable-accepts? (vector-ref row 0) (vector-ref row 3))))
     (error "retained native GVM closure lost owner/arity across module load or GC"))) gvm-source-retained)
   (if (not (and (eq? native-eval-string gvm-source-data-only)
                 (eq? (native-leaf "host/eval-scheme/1") gvm-source-data-only)
                 (eq? ((native-leaf "host/native-backend/0")) (bl-key "gvm"))))
    (error "GVM Source gate lost its no-fallback guard"))
   (display "NATIVE_GVM_DYNAMIC_WITNESS {\"backend\":\"gvm\",\"runtime_abi\":1,\"evaluations\":")
   (display gvm-source-evaluations)
   (display ",\"loaded_units\":") (display (native-map-count native-gvm-loaded-modules))
   (display ",\"retained_closures\":") (display (length gvm-source-retained))
   (display ",\"entry_ticks\":") (display gvm-source-entry-ticks)
   (display ",\"native_owners\":") (display (length owners))
   (display ",\"module\":") (write name)
   (display ",\"data_sha256\":") (write (native-gvm-text-sha256 (bl-get emitted (bl-key "data-source"))))
   (display ",\"artifact_directory\":") (write (vector-ref artifact 0))
   (display ",\"retained_across_modules\":") (display (if gvm-source-across-modules? "true" "false"))
   (display ",\"gc_retention_checked\":") (display (if (> gvm-source-collections 0) "true" "false"))
   (display ",\"required_gvm_exports\":9,\"scheme_data_only\":true,\"old_stepper\":false}\n")
   (force-output)
   answer)) 1)
;; The ORIGINAL owned Source bundle expression follows byte-for-byte.
