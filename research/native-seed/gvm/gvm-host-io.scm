;; IO/value services only. The pinned public _digest module owns SHA256;
;; canonical BL Source owns the compiler and all GVM emission decisions.
(import _digest)
(define (native-gvm-text-sha256 text)
 (if (not (string? text)) (error "GVM digest requires Scheme text"))
 (digest-string text 'sha-256 'hex))
(define (native-gvm-file-sha256 path)
 (digest-file path 'sha-256 'hex))
(define (native-gvm-mkdir! path)
 (if (not (and (string? path) (> (string-length path) 0)))
  (error "GVM compiler directory requires a nonempty path"))
 (let ((path (let trim ((end (string-length path)))
              (if (and (> end 1) (char=? (string-ref path (- end 1)) #\/))
               (trim (- end 1)) (substring path 0 end)))))
  (if (file-exists? path)
   (if (not (eq? (file-info-type (file-info path)) 'directory))
    (error "GVM compiler output path is not a directory" path))
   (let ((parent (path-directory path)))
    (if (and (> (string-length parent) 0) (not (string=? parent path)))
     (native-gvm-mkdir! parent))
    (create-directory path)))) bl-nil)
(native-add-leaf! "host/native-gvm-sha256/1" native-gvm-text-sha256)
(native-add-leaf! "host/native-gvm-mkdir/1" native-gvm-mkdir!)
