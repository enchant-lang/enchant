;; Pinned GSC backend adapter. Reads GVM DATA, NEVER evals Source/Scheme/ANF.
;; Run inside the pinned gsc interpreter, whose c# constructors are loaded.
(define (gvm-import-check ok message . detail)
 (if (not ok) (apply error (cons message detail))))
(define (gvm-import-row tag rows)
 (let ((matches (let loop ((rows rows) (out '()))
                 (if (null? rows) out
                  (loop (cdr rows) (if (and (pair? (car rows)) (eq? (caar rows) tag))
                                    (cons (car rows) out) out))))))
  (gvm-import-check (= (length matches) 1) "GVM field missing/repeated" tag)
  (car matches)))
(define (gvm-import-name x)
 (gvm-import-check (and (string? x) (> (string-length x) 0) (<= (string-length x) 4096))
  "GVM name must be a bounded nonempty string" x)
 x)
(define (gvm-import-natural x limit)
 (gvm-import-check (and (integer? x) (exact? x) (<= 0 x limit)) "GVM integer out of range" x)
 x)
(define (gvm-import-shape x tag size)
 (gvm-import-check (and (list? x) (= (length x) size) (eq? (car x) tag))
  "GVM record shape differs" tag x))
(define (gvm-import-bounded! datum)
 (let ((remaining 1000000))
  (let walk ((x datum) (depth 0))
   (set! remaining (- remaining 1))
   (gvm-import-check (and (>= remaining 0) (<= depth 128)) "GVM datum budget exceeded")
   (cond ((pair? x) (walk (car x) (+ depth 1)) (walk (cdr x) depth))
         ((or (null? x) (boolean? x) (number? x) (string? x) (symbol? x)) #t)
         (else (error "unsupported GVM datum value" x))))))
(define (gvm-import-read path)
 ;; A fresh standard table excludes caller-installed reader handlers. Disable
 ;; reader evaluation AND sharing explicitly before parsing any input bytes.
 (let* ((plain (##make-standard-readtable))
        (no-eval (readtable-eval-allowed?-set plain #f))
        (data-table (readtable-sharing-allowed?-set no-eval #f)))
  (parameterize ((current-readtable data-table))
   (call-with-input-file path
    (lambda (port)
     (let ((data (read port)))
      (gvm-import-check (eof-object? (read port)) "GVM file must contain exactly one DATA datum")
      (gvm-import-bounded! data) data))))))
(define (gvm-import-main input output linker-name)
 (let* ((data (gvm-import-read input))
        (_ (gvm-import-check (and (list? data) (= (length data) 6)
              (eq? (car data) 'bl-native-gvm) (eqv? (cadr data) 1)) "unsupported GVM schema"))
        (fields (cddr data))
        (module-row (gvm-import-row 'module fields))
        (entry-row (gvm-import-row 'entry fields))
        (constant-row (gvm-import-row 'constants fields))
        (procedure-row (gvm-import-row 'procedures fields))
        (_ (gvm-import-shape module-row 'module 2))
        (_ (gvm-import-shape entry-row 'entry 2))
        (module-name (gvm-import-name (cadr module-row)))
        (entry-name (gvm-import-name (cadr entry-row)))
        (constants '()) (procedures '()) (source-procedures (cdr procedure-row)))
  (gvm-import-name linker-name)
  (gvm-import-check (and (pair? source-procedures) (<= (length source-procedures) 100000))
   "GVM unit must have a bounded procedure list")
  (c#env.begin!)
  (c#virtual.begin!)
  (c#target-select! 'C '() #f)
  (dynamic-wind
   (lambda () #f)
   (lambda ()
    (define (lookup table id kind)
     (let ((row (assoc (gvm-import-name id) table)))
      (gvm-import-check row "unknown GVM reference" kind id) (cdr row)))
    (define (constant id) (cadr (or (assoc id constants) (error "unknown GVM constant" id))))
    (for-each (lambda (row)
     (gvm-import-check (and (list? row) (= (length row) 2)) "bad GVM constant row" row)
     (gvm-import-name (car row))
     (gvm-import-check (not (assoc (car row) constants)) "repeated GVM constant ID" (car row))
     (set! constants (cons row constants))) (cdr constant-row))
    ;; Allocate ALL procedure objects before resolving references/recursive knots.
    (for-each (lambda (row)
     (gvm-import-check (and (list? row) (>= (length row) 5) (eq? (car row) 'proc))
      "bad GVM procedure record" row)
     (let ((id (gvm-import-name (cadr row)))
           (arity (gvm-import-natural (caddr row) 1024)))
      (gvm-import-check (= (gvm-import-natural (cadddr row) 4096) 0)
       "captured entry must stay inside its owner BBS, not a standalone procedure" id)
      (gvm-import-check (not (assoc id procedures)) "repeated GVM procedure ID" id)
      (set! procedures
       (cons (cons id (c#make-proc-obj id #f #f #f (list arity) #t '() 0 '(#f) #f)) procedures))))
     source-procedures)
    (for-each
     (lambda (source)
      (let* ((id (cadr source)) (arity (caddr source)) (closed-count (cadddr source))
             (procedure (lookup procedures id 'proc)) (variables '())
             (blocks (cddddr source)) (bbs (c#make-bbs)) (labels '()))
       (define (variable id)
        (cond ((eq? id #f) c#empty-var)
              ((equal? id "return") c#ret-var)
              ((equal? id "closure-env") c#closure-env-var)
              (else
               (gvm-import-name id)
               (let ((old (assoc id variables)))
                (if old (cdr old)
                 (let ((v (c#make-temp-var (string->symbol id))))
                  (set! variables (cons (cons id v) variables)) v))))))
       (define (frame wire)
        (gvm-import-shape wire 'frame 6)
        (let ((size (gvm-import-natural (cadr wire) 4096))
              (slots (caddr wire)) (regs (cadddr wire))
              (closed (list-ref wire 4)) (live (list-ref wire 5)))
         (gvm-import-check (and (list? slots) (= (length slots) size)
               (list? regs) (= (length regs) c#target.nb-regs)
               (list? closed) (<= (length closed) 4096) (list? live))
          "GVM frame layout differs" id wire)
         (c#make-frame size (map variable slots) (map variable regs)
          (map variable closed) (c#list->varset (map variable live)))))
       (define (operand wire)
        (gvm-import-check (and (list? wire) (pair? wire)) "bad GVM operand" wire)
        (case (car wire)
         ((reg) (gvm-import-shape wire 'reg 2)
                (c#make-reg (gvm-import-natural (cadr wire) (- c#target.nb-regs 1))))
         ((stk) (gvm-import-shape wire 'stk 2)
                (gvm-import-check (> (gvm-import-natural (cadr wire) 4096) 0) "stack index starts at1")
                (c#make-stk (cadr wire)))
         ((lbl) (gvm-import-shape wire 'lbl 2)
                (gvm-import-check (memv (cadr wire) labels) "unknown GVM label" wire)
                (c#make-lbl (cadr wire)))
         ((glo) (gvm-import-shape wire 'glo 2) (c#make-glo (string->symbol (gvm-import-name (cadr wire)))))
         ((obj) (gvm-import-shape wire 'obj 2) (c#make-obj (constant (cadr wire))))
         ((proc) (gvm-import-shape wire 'proc 2) (c#make-obj (lookup procedures (cadr wire) 'proc)))
         ((clo) (gvm-import-shape wire 'clo 3)
                (gvm-import-check (> (gvm-import-natural (caddr wire) 4096) 0) "closed index starts at1")
                (c#make-clo (operand (cadr wire)) (caddr wire)))
         (else (error "unsupported GVM operand (fail closed)" wire))))
       (define (location wire)
        (gvm-import-check (and (pair? wire) (memq (car wire) '(reg stk glo clo)))
         "GVM destination is not a location" wire)
        (operand wire))
       (define (local-label value)
        (gvm-import-check (and (integer? value) (exact? value) (memv value labels))
         "unknown GVM local label" value) value)
       (define (primitive name capability)
        (let* ((value (c#target.prim-info (c#string->canonical-symbol (gvm-import-name name))))
               (spec (and value (capability value))))
         (gvm-import-check
          (and value
           (if (eq? capability c#proc-obj-test)
            (and (vector? spec) (= (vector-length spec) 3) (procedure? (vector-ref spec 1)))
            (procedure? spec))))
          "GVM primitive does not support requested operation" name) value))
       (for-each (lambda (block)
        (gvm-import-check (and (list? block) (>= (length block) 5) (eq? (car block) 'block))
         "bad GVM block" block)
        (let ((label (gvm-import-natural (cadr block) 1000000)))
         (gvm-import-check (and (> label 0) (not (memv label labels))) "repeated/zero GVM label" label)
         (set! labels (cons label labels)))) blocks)
       (c#bbs-next-lbl-num-set! bbs (+ 1 (apply max labels)))
       (let ((entries 0))
        (for-each
         (lambda (block)
          (let* ((label (cadr block)) (kind (caddr block)) (entry-frame (frame (cadddr block)))
                 (label-instruction
                  (cond
                   ((eq? kind 'entry)
                    (set! entries (+ entries 1)) (c#bbs-entry-lbl-num-set! bbs label)
                    (gvm-import-check (null? (c#frame-closed entry-frame)) "owner entry cannot have captures" id)
                    (c#make-label-entry label arity '() #f #f #f entry-frame #f))
                   ((and (list? kind) (= (length kind) 3) (eq? (car kind) 'entry))
                    (let ((child-arity (gvm-import-natural (cadr kind) 1024))
                          (captures (gvm-import-natural (caddr kind) 4096)))
                     (gvm-import-check (= captures (length (c#frame-closed entry-frame)))
                      "lexical entry capture count differs" label)
                     (c#make-label-entry label child-arity '() #f #f (> captures 0) entry-frame #f)))
                   ((eq? kind 'return) (c#make-label-return label entry-frame #f))
                   ((eq? kind 'simple) (c#make-label-simple label entry-frame #f))
                   (else (error "unsupported GVM label kind" kind))))
                 (bb (c#make-bb label-instruction bbs)) (instructions (cddddr block)))
           (let loop ((todo instructions))
            (gvm-import-check (pair? todo) "GVM block needs one final branch" label)
            (let ((instruction (car todo)))
             (gvm-import-check (and (list? instruction) (pair? instruction)) "bad GVM instruction")
             (case (car instruction)
              ((copy)
               (gvm-import-shape instruction 'copy 4)
               (c#bb-put-non-branch! bb
                (c#make-copy (operand (cadr instruction)) (location (caddr instruction))
                 (frame (cadddr instruction)) #f))
               (loop (cdr todo)))
              ((apply)
               (gvm-import-shape instruction 'apply 5)
               (gvm-import-check (list? (caddr instruction)) "GVM apply operands must be a list")
               (c#bb-put-non-branch! bb
                (c#make-apply (primitive (cadr instruction) c#proc-obj-inline)
                 (map operand (caddr instruction))
                 (and (cadddr instruction) (location (cadddr instruction)))
                 (frame (list-ref instruction 4)) #f))
               (loop (cdr todo)))
              ((close)
               (gvm-import-shape instruction 'close 3)
               (gvm-import-check (list? (cadr instruction)) "GVM close rows must be a list")
               (c#bb-put-non-branch! bb
                (c#make-close
                 (map (lambda (row)
                  (gvm-import-check (and (list? row) (= (length row) 3) (list? (caddr row)))
                   "bad GVM close row" row)
                  (let* ((label (local-label (cadr row)))
                         (target (let find ((rows blocks))
                                  (if (= (cadar rows) label) (car rows) (find (cdr rows)))))
                         (kind (caddr target)))
                   (gvm-import-check (and (list? kind) (= (length kind) 3)
                         (eq? (car kind) 'entry) (= (caddr kind) (length (caddr row))))
                    "closure target must be an explicit lexical entry with matching captures" label)
                   (c#make-closure-parms (location (car row)) label (map operand (caddr row)))))
                  (cadr instruction)) (frame (caddr instruction)) #f))
               (loop (cdr todo)))
              ((ifjump)
               (gvm-import-shape instruction 'ifjump 7)
               (gvm-import-check (and (null? (cdr todo)) (list? (caddr instruction))
                     (boolean? (list-ref instruction 5)))
                "GVM conditional branch must end block with boolean poll")
               (c#bb-put-branch! bb
                (c#make-ifjump (primitive (cadr instruction) c#proc-obj-test)
                 (map operand (caddr instruction))
                 (local-label (cadddr instruction)) (local-label (list-ref instruction 4))
                 (list-ref instruction 5) (frame (list-ref instruction 6)) #f)))
              ((jump)
               (gvm-import-shape instruction 'jump 7)
               (gvm-import-check (null? (cdr todo)) "branch must end GVM block")
               (let ((ret (caddr instruction)) (argc (cadddr instruction))
                     (poll (list-ref instruction 4)) (safe (list-ref instruction 5)))
                (gvm-import-check (and (boolean? poll) (boolean? safe)) "GVM jump flags must be booleans")
                (if argc (gvm-import-natural argc 4096))
                (c#bb-put-branch! bb (c#make-jump (operand (cadr instruction))
                 (and ret (local-label ret)) argc poll safe (frame (list-ref instruction 6)) #f))))
              (else (error "unsupported GVM opcode (fail closed)" (car instruction))))))))
         blocks)
        (gvm-import-check (= entries 1) "GVM procedure needs exactly one entry label" id))
       (c#proc-obj-code-set! procedure bbs)))
     source-procedures)
    (let* ((main (lookup procedures entry-name 'entry))
           (main-source (or (assoc entry-name (map (lambda (row) (cons (cadr row) row)) source-procedures))
                            (error "missing GVM module entry")))
           (all (cons main (let loop ((rows procedures) (out '()))
                            (if (null? rows) (reverse out)
                             (loop (cdr rows) (if (eq? (cdar rows) main) out (cons (cdar rows) out)))))))
           (descriptor (vector (vector (string->symbol module-name)) '#() '() 1 main #f)))
     (gvm-import-check (and (= (caddr (cdr main-source)) 0) (= (cadddr (cdr main-source)) 0))
      "GVM module entry must be0arity/0capture")
     (let ((result (c#target.dump all output (c#make-c-intf '() '() '() '()) descriptor linker-name)))
      (gvm-import-check (procedure? result) "GVM C backend did not produce loader-compatible output")
      (display "GVM_NATIVE_C_EMITTED ") (write output) (newline) (force-output)
      output)))
   (lambda () (c#target-unselect!) (c#virtual.end!) (c#env.end!)))))
