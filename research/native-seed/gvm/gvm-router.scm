;; These are the only backend-selection seams. Canonical BL still owns reader,
;; expansion, Source compilation, GVM lowering, and bootstrap packaging.
(define native-gvm-original-main native-main)
(set! native-main (lambda (arguments)
 (if (and (pair? arguments) (string=? (car arguments) "--compile-gvm"))
  (bl-invoke (native-global-exact "native.gvm-bootstrap" "main") (list arguments))
  (native-gvm-original-main arguments))))
(define (native-gvm-replace-leaf! key original replacement arity)
 (if (not (eq? (native-leaf key) original))
  (error "GVM backend leaf changed before checked replacement" key))
 (if (not (procedure? replacement)) (error "GVM replacement is not a host procedure" key))
 (native-check-function-arity arity)
 (native-mark-host-callable! replacement)
 (bl-register-callable! replacement arity)
 (set! native-leaf-registry (bl-assoc native-leaf-registry key replacement)) replacement)
(define native-gvm-original-eval-node (native-leaf "host/eval-node/2"))
(if (not (eq? native-gvm-original-eval-node native-eval-node-scheme))
 (error "GVM host requires the captured canonical emission boundary"))
(native-gvm-replace-leaf! "host/eval-node/2" native-gvm-original-eval-node
 (lambda (node context)
  (if (not native-gvm-toolchain) (error "GVM evaluation requires a configured native backend"))
  (let ((emitter (native-global-exact "native.gvm-eval" "eval-node")))
   (if (not (and (procedure? emitter) (not (##interp-procedure? emitter))))
    (error "GVM evaluation requires a compiled native eval-node body"))
   (bl-invoke emitter (list node context)))) 2)
(native-add-leaf! "host/native-backend/0" (lambda () (bl-key "gvm")))
(native-add-leaf! "host/set-native-backend/1" (lambda (backend)
 (if (not (eq? backend (bl-key "gvm")))
  (error "GVM-only host refuses a different Source backend" backend)) backend))
