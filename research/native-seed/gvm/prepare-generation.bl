; SDK-only sequential coordinator. Every producer retains its own finite
; admission; this reuses one cold VM for capture, partition, then GVM emission.
(ns native.gvm-prepare-generation)
(def args (BeamLisp/argv))
(when-not (= 5 (count args))
 (throw (ex-info "usage: prepare-generation.bl BASE18 PROFILEOUT HOSTDIR COMPILEROUT PYTHON" {})))
(def parent (nth args 0))
(def profile (nth args 1))
(def host (nth args 2))
(def compiler (nth args 3))
(def python (nth args 4))
(defn overlaps? [a b]
 (let [a (Path/expand a) b (Path/expand b)]
  (or (= a b) (String/starts_with? a (str b "/")) (String/starts_with? b (str a "/")))))
(doseq [output [profile compiler] input [(Path/dirname parent) host]]
 (when (overlaps? output input) (throw (ex-info "GVM generation output overlaps a retained input" {}))))
(when (or (overlaps? profile compiler)
          (File/regular? (str profile "/closure.etf")) (File/regular? (str compiler "/index.tsv")))
 (throw (ex-info "GVM generation requires fresh disjoint outputs" {})))
(defn producer [path arguments]
 (BeamLisp.Env/isolated
  (fn [] (BeamLisp/with_argv (to-list arguments) (fn [] (BeamLisp/run_file path))))))
(producer "research/native-seed/src/native/extend-gvm-closure.bl" [parent profile])
(def partition (System/cmd python ["research/native-seed/partition-closure.py" "--out" profile]))
(when-not (= 0 (elem partition 1))
 (throw (ex-info "GVM partition failed" {:output (elem partition 0)})))
(println (elem partition 0))
(producer "research/native-seed/src/native/gvm-produce.bl"
 [(str profile "/partition.json") compiler (str host "/host.scm") (str host "/host.components.json")])
(println "GVM_GENERATION_EMITTED")
