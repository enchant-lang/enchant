;; Translate Gambit-dialect prelude.scm into Chez forms.
;; Usage: scheme --script translate.ss IN.scm OUT.ss OUT.c
;; Gambit #!optional / #!rest lambda lists become rest-argument destructuring.
(define c-out #f)
(define (extract-c-declare text)
  ;; (c-declare #<<c-end ... c-end) heredocs become one C file and (void).
  (let ((open "(c-declare #<<c-end\n") (close "\nc-end"))
    (let loop ((text text))
      (let ((i (string-search text open)))
        (if (not i) text
            (let* ((j (string-search-from text close (+ i (string-length open))))
                   (k (string-search-from text ")" (+ j (string-length close)))))
              (display (substring text (+ i (string-length open)) j) c-out) (newline c-out)
              (loop (string-append (substring text 0 i) "(void)" (substring text (+ k 1) (string-length text))))))))))
(define (string-search s pat) (string-search-from s pat 0))
(define (string-search-from s pat start)
  (let ((n (string-length s)) (m (string-length pat)))
    (let loop ((i start))
      (cond ((> (+ i m) n) #f) ((string=? (substring s i (+ i m)) pat) i) (else (loop (+ i 1)))))))
(define (read-gambit path)
  (let* ((text (extract-c-declare (call-with-input-file path get-string-all)))
         (text (fold-left (lambda (t r) (string-replace t (car r) (cdr r))) text
                 '(("#!optional" . "ab:optional") ("#!rest" . "ab:rest") ("#!void" . "ab:void-literal") ("##make-global-var" . "ab-make-global-var")
                   ("##global-var-ref" . "ab-global-var-ref") ("##global-var-set!" . "ab-global-var-set!")
                   ("##unbound?" . "ab-unbound?") ("##gc" . "collect")))))
    (let ((p (open-input-string text)))
      (let loop ((acc '())) (let ((f (read p))) (if (eof-object? f) (reverse acc) (loop (cons f acc))))))))
(define (string-replace s from to)
  (let ((n (string-length s)) (m (string-length from)) (out (open-output-string)))
    (let loop ((i 0) (q #f))
      (cond ((>= i n) (get-output-string out))
            ;; do not rewrite inside string literals
            ((char=? (string-ref s i) #\") (write-char #\" out)
             (let sl ((j (+ i 1)))
               (let ((c (string-ref s j))) (write-char c out)
                 (cond ((char=? c #\\) (write-char (string-ref s (+ j 1)) out) (sl (+ j 2)))
                       ((char=? c #\") (loop (+ j 1) q))
                       (else (sl (+ j 1)))))))
            ((and (char=? (string-ref s i) #\#) (char=? (string-ref s (min (+ i 1) (- n 1))) #\\))
             (write-char #\# out) (write-char #\\ out) (write-char (string-ref s (+ i 2)) out) (loop (+ i 3) q))
            ((and (<= (+ i m) n) (string=? (substring s i (+ i m)) from)) (display to out) (loop (+ i m) q))
            (else (write-char (string-ref s i) out) (loop (+ i 1) q))))))
(load (string-append (path-parent (car (command-line))) "/gambit-forms.ss"))
(define args (command-line-arguments))
(set! c-out (open-output-file (caddr args) '(replace)))
(define forms (map xform (read-gambit (car args))))
(call-with-output-file (cadr args)
  (lambda (out) (parameterize ((print-gensym #f)) (for-each (lambda (f) (write f out) (newline out)) forms)))
  '(replace))
(close-port c-out)
(printf "translated ~a forms\n" (length forms))
