;; Gambit host API used by the native seed prelude, implemented on Chez Scheme 10.
;; Loaded before prelude.so. Semantics follow the Gambit 4.9 manual for the
;; subset the prelude uses; anything else is deliberately absent.
(define test: 'test:) (define weak-keys: 'weak-keys:) (define weak-values: 'weak-values:)
(define (exact-integer? x) (and (integer? x) (exact? x)))
(define (arithmetic-shift n k) (bitwise-arithmetic-shift n k))
(define (force-output . port) (flush-output-port (if (pair? port) (car port) (current-output-port))))
(define (write-substring s start end port) (put-string port s start (- end start)))
(define (substring-move! s1 start1 end1 s2 start2) (string-copy! s1 start1 s2 start2 (- end1 start1)))
(define (subvector v s e) (let ((r (make-vector (- e s)))) (do ((i s (+ i 1))) ((= i e) r) (vector-set! r (- i s) (vector-ref v i)))))
(define (subvector-move! v1 s1 e1 v2 s2)
  (if (and (eq? v1 v2) (< s1 s2))
      (do ((i (- e1 1) (- i 1))) ((< i s1)) (vector-set! v2 (+ s2 (- i s1)) (vector-ref v1 i)))
      (do ((i s1 (+ i 1))) ((= i e1)) (vector-set! v2 (+ s2 (- i s1)) (vector-ref v1 i)))))
(define (time->seconds t) (+ (time-second t) (/ (time-nanosecond t) 1e9)))
;; Gambit tables: (make-table [test: proc] [weak-keys: b] [weak-values: b]); default test equal?.
(define (make-table . opts)
  (let loop ((o opts) (test equal?) (weak #f))
    (cond ((null? o)
           (cond ((eq? test eq?) (if weak (make-weak-eq-hashtable) (make-eq-hashtable)))
                 ((eq? test eqv?) (if weak (make-weak-eqv-hashtable) (make-eqv-hashtable)))
                 ((eq? test string=?) (make-hashtable string-hash string=?))
                 (else (make-hashtable equal-hash equal?))))
          ((eq? (car o) 'test:) (loop (cddr o) (cadr o) weak))
          ((eq? (car o) 'weak-keys:) (loop (cddr o) test (and (cadr o) #t)))
          (else (loop (cddr o) test weak)))))
(define ab-missing (list 'missing))
(define (table-ref t k . default)
  (let ((v (hashtable-ref t k ab-missing)))
    (if (eq? v ab-missing)
        (if (pair? default) (car default) (ab-error "table-ref: unbound key" k))
        v)))
(define (table-set! t k . v) (if (pair? v) (hashtable-set! t k (car v)) (hashtable-delete! t k)))
(define (table-for-each proc t)
  (let-values (((ks vs) (hashtable-entries t))) (vector-for-each proc ks vs)))
;; Gambit-style errors: (error message irritant ...) raises an error object.
(define-record-type ab-error-object (fields message irritants))
(define (ab-error message . irritants) (raise (make-ab-error-object message irritants)))
(define (display-exception e . port)
  (let ((port (if (pair? port) (car port) (current-error-port))))
    (cond ((ab-error-object? e)
           (display (ab-error-object-message e) port)
           (for-each (lambda (x) (display " " port) (write x port)) (ab-error-object-irritants e))
           (newline port))
          ((condition? e) (display-condition e port) (newline port))
          (else (write e port) (newline port)))))
(define (with-exception-catcher handler thunk)
  ((call/cc (lambda (k)
     (with-exception-handler
       (lambda (e) (k (lambda () (handler e))))
       (lambda () (call-with-values thunk (lambda vs (lambda () (apply values vs))))))))))
(define (ab-with-output-to-string prefix thunk)
  (let ((p (open-output-string)))
    (display prefix p)
    (parameterize ((current-output-port p)) (thunk))
    (get-output-string p)))
;; ##global-var primitives map onto Chez top-level bindings.
(define ab-unbound-marker (list 'unbound))
(define (ab-make-global-var sym) sym)
(define (ab-global-var-ref sym) (if (top-level-bound? sym) (top-level-value sym) ab-unbound-marker))
(define (ab-unbound? v) (eq? v ab-unbound-marker))
(define (ab-global-var-set! sym v) (set-top-level-value! sym v))
;; Gambit signatures that differ from Chez namesakes (translate.ss renames calls).
(define (ab-getenv name . default)
  (or (getenv name) (if (pair? default) (car default) (ab-error "Unbound OS environment variable" name))))
(define (ab-call-with-output-file path proc) (call-with-output-file path proc '(replace)))
(load (string-append (getenv "BL_CHEZ_HOST_DIR") "/gambit-forms.ss"))
(define (ab-eval form . env) (eval (xform form) (if (pair? env) (car env) (interaction-environment))))
;; Gambit's map applies its procedure left to right; Chez leaves the order
;; unspecified. The compiler's fresh-name counters depend on that order.
;; Chez's safe reverse walks the list twice (list-length, then the copy). Gambit's
;; refuses an improper list too; this does it in the one copying pass.
(define (ab-reverse xs)
  (let loop ((xs xs) (acc '()))
    (cond ((pair? xs) (loop (cdr xs) (cons (car xs) acc)))
          ((null? xs) acc)
          (else (ab-error "reverse: improper list" xs)))))
(define ab-map
  ;; One pass, building the result front to back on fresh pairs: the same calls in
  ;; the same order as an accumulate-and-reverse, without the second walk.
  (case-lambda
    ((f xs) (if (pair? xs)
                (let ((head (cons (f (car xs)) '())))
                  (let loop ((xs (cdr xs)) (tail head))
                    (if (pair? xs)
                        (let ((cell (cons (f (car xs)) '()))) (set-cdr! tail cell) (loop (cdr xs) cell))
                        head)))
                '()))
    ((f xs ys) (if (and (pair? xs) (pair? ys))
                   (let ((head (cons (f (car xs) (car ys)) '())))
                     (let loop ((xs (cdr xs)) (ys (cdr ys)) (tail head))
                       (if (and (pair? xs) (pair? ys))
                           (let ((cell (cons (f (car xs) (car ys)) '()))) (set-cdr! tail cell) (loop (cdr xs) (cdr ys) cell))
                           head)))
                   '()))
    ((f . lists) (let loop ((ls lists) (acc '()))
                   (if (ormap null? ls) (reverse acc) (loop (map cdr ls) (cons (apply f (map car ls)) acc)))))))
;; Quoted data holding Gambit #!void (see gambit-forms.ss): substitute once, cache by literal.
(define (ab-void-data x)
  (cond ((eq? x 'ab:void-literal) (void))
        ((pair? x) (cons (ab-void-data (car x)) (ab-void-data (cdr x))))
        ((vector? x) (vector-map ab-void-data x))
        (else x)))
(define ab-void-cache (make-weak-eq-hashtable))
(define (ab-void-subst datum)
  (or (hashtable-ref ab-void-cache datum #f)
      (let ((v (ab-void-data datum))) (hashtable-set! ab-void-cache datum v) v)))
