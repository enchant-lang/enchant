; FRAMES corpus: BL functions whose budget sites and source frames N4 changes.
; check.bl compiles every definition of this file for native (release and
; debug emission) and runs the value probes on BEAM as the oracle.
(ns frames.corpus)

; ---- values and raises (BEAM differential) ---------------------------------
(defn outcome [f args] (try {:ok (erlang/apply f args)} (catch e {:raised e})))
(defn leaf-add [a b] (erlang/+ a b))
(defn leaf-pick [x] (if (erlang/is_integer x) (erlang/* x 2) {:not-int x}))
(defn sum-to [n] (loop [i n acc 0] (if (erlang/> i 0) (recur (erlang/- i 1) (erlang/+ acc i)) acc)))
(defn deep [n] (if (erlang/> n 0) (erlang/+ 1 (deep (erlang/- n 1))) 0))
(defn tail-count [n acc] (if (erlang/> n 0) (tail-count (erlang/- n 1) (erlang/+ acc 1)) acc))
(defn even-down? [n] (if (erlang/== n 0) true (odd-down? (erlang/- n 1))))
(defn odd-down? [n] (if (erlang/== n 0) false (even-down? (erlang/- n 1))))
(defn twice [f x] (f (f x)))
(defn add3 [x] (erlang/+ x 3))
(defn mapped [xs] (lists/map (fn [x] (erlang/* x x)) xs))
(defn raiser [x] (erlang/throw {:bad x}))
(defn error-raiser [x] (erlang/error {:bad x}))
(defn raise-mid [x] (let [r (raiser x)] (erlang/+ r 1)))
(defn raise-top [x] (raise-mid x))
(defn thrower [x] (erlang/throw {:thrown x}))
(defn catch-and-tag [x] (try (raise-mid x) (catch e {:caught e})))
(defn rethrow [x] (try (thrower x) (catch e (erlang/throw {:again e}))))
(defn finally-order [x] (try (raiser x) (catch e [:caught e]) (finally (leaf-add 1 2))))
(defn hof-raise [x] (twice (fn [y] (if (erlang/> y 10) (raiser y) (erlang/+ y 10))) x))
(defn badarith [x] (erlang/+ x :not-a-number))
(defn clause-fail [x] (case x 1 :one 2 :two))

; ---- logical stacks (old vs new source-frame emission) ---------------------
(defn stack-here [] (host/logical-stack))
(defn stack-inner [x] (stack-here))
(defn stack-mid [x] (let [s (stack-inner x)] s))
(defn stack-outer [] (stack-mid 1))
(defn stack-after-call [] (let [a (leaf-add 1 2) s (stack-here)] [a s]))
(defn stack-tail-down [n] (if (erlang/> n 0) (stack-tail-down (erlang/- n 1)) (host/logical-stack)))
(defn stack-deep [n] (if (erlang/> n 0) (let [s (stack-deep (erlang/- n 1))] s) (host/logical-stack)))
(defn stack-hof [f] (let [x (f)] x))
(defn stack-via-hof [] (stack-hof (fn [] (host/logical-stack))))
(defn stack-map [] (lists/map (fn [x] (host/logical-stack)) (list 1 2 3)))
(defn stack-loop [] (loop [i 3] (if (erlang/== i 0) (host/logical-stack) (recur (erlang/- i 1)))))
(defn stack-multi ([x] (host/logical-stack)) ([x y] (stack-multi x)))
(defn stack-variadic [x & more] (host/logical-stack))
(defn stack-catch [x] (try (raise-mid x) (catch e [(host/logical-stack) e])))
(defn stack-catch-deep [x] (try (raise-top x) (catch e (host/logical-stack))))
(defn stack-finally [x] (try (try (raiser x) (finally (thrower x))) (catch e [(host/logical-stack) e])))
(defn stack-after-catch [x] (let [r (catch-and-tag x)] [r (host/logical-stack)]))
(defn stack-raw-apply [] (erlang/apply stack-here (list)))
(defn stack-depth [] (host/max-frames))

; ---- preemption (actor turns) ---------------------------------------------
(defn spin [] (spin))
(defn spin-loop [] (loop [i 0] (recur (erlang/+ i 1))))
(defn ping [n] (pong (erlang/+ n 1)))
(defn pong [n] (ping (erlang/+ n 1)))
(defn grow [n] (erlang/+ 1 (grow n)))
(defn self-apply [f] (f f))
(defn spin-self [] (self-apply self-apply))
(defn hof-spin [] (lists/foreach (fn [x] (spin)) (list 1)))
(defn spin-catch [] (try (spin) (catch e e)))
(defn work [n] (sum-to n))
(defn work-calls [n] (if (erlang/> n 0) (erlang/+ (leaf-add n 1) (work-calls (erlang/- n 1))) 0))
(defn work-hof [n] (lists/foldl (fn [x acc] (erlang/+ x acc)) 0 (lists/seq 1 n)))
