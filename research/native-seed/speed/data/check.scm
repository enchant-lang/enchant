;; DATA differential, native half. Loaded after the host/prelude, the new
;; category-(b) host files, the emitted modules (out/data.scm) and the
;; generated out/targets.scm (key -> compiled arity cell, old leaf or #f).
;; Rows come from the BEAM oracle (oracle.bl): one datum per line.
(define check-counts (make-table))
(define (count! label) (table-set! check-counts label (+ 1 (table-ref check-counts label 0))))
(define check-failures '())
(define (fail! . parts)
 (count! 'failures)
 (if (< (length check-failures) 60) (set! check-failures (cons parts check-failures))))
(define slice-from (string->number (getenv "DATA_FROM" "0")))
(define slice-to (string->number (getenv "DATA_TO" "1000000000")))
(define data-cases
 (call-with-input-file (path-expand (getenv "DATA_CASES" "oracle-cases.sexp"))
  (lambda (port)
   (let loop ((rows '()) (i 0))
    (let ((datum (read port)))
     (cond ((eof-object? datum) (reverse rows))
           ((or (< i slice-from) (>= i slice-to)) (loop rows (+ i 1)))
           (else (loop (cons datum rows) (+ i 1)))))))))

;; Strict structural sameness (types, float bits, content), as speed/kernel.
(define (data-tuple? x) (and (vector? x) (fx= 2 (vector-length x)) (eq? (vector-ref x 0) 'tuple)))
(define (data-tagged? x tag) (and (vector? x) (fx= 2 (vector-length x)) (eq? (vector-ref x 0) tag)))
(define (same? a b)
 (cond ((eq? a b) #t)
       ((and (data-tagged? a 'float) (data-tagged? b 'float)) (eqv? (vector-ref a 1) (vector-ref b 1)))
       ((and (pair? a) (pair? b)) (and (same? (car a) (car b)) (same? (cdr a) (cdr b))))
       ((and (data-tuple? a) (data-tuple? b))
        (let ((x (vector-ref a 1)) (y (vector-ref b 1)))
         (and (= (vector-length x) (vector-length y))
          (let loop ((i 0)) (or (= i (vector-length x)) (and (same? (vector-ref x i) (vector-ref y i)) (loop (+ i 1))))))))
       ((and (exact-integer? a) (exact-integer? b)) (= a b))
       ((and (string? a) (string? b)) (string=? a b))
       ((and (data-tagged? a 'map) (data-tagged? b 'map))
        (and (= (native-map-count a) (native-map-count b))
             (let loop ((ps (native-map-pairs a)))
              (or (null? ps)
                  (let ((v (bl-get b (bl-nth (car ps) 0) native-missing)))
                   (and (not (eq? v native-missing)) (same? (bl-nth (car ps) 1) v) (loop (cdr ps))))))))
       ((or (data-tagged? a 'vec) (data-tagged? a 'set))
        (and (vector? b) (eq? (vector-ref a 0) (vector-ref b 0)) (bl-key-equal? a b)))
       (else #f)))

;; The Elixir exception module BEAM's `catch` binds for a raised reason
;; (Exception.normalize/3 for class :error), and its message when the reason
;; is already an exception struct.
(define (data-reason-module reason)
 (cond ((native-error-value? reason) (native-atom-name (bl-get reason (bl-key "__struct__"))))
       ((eq? reason (bl-key "badarith")) "Elixir.ArithmeticError")
       ((eq? reason (bl-key "badarg")) "Elixir.ArgumentError")
       ((eq? reason (bl-key "function_clause")) "Elixir.FunctionClauseError")
       ((eq? reason (bl-key "undef")) "Elixir.UndefinedFunctionError")
       ((and (data-tuple? reason) (> (bl-count reason) 0))
        (let ((tag (bl-nth reason 0)))
         (cond ((eq? tag (bl-key "badkey")) "Elixir.KeyError")
               ((eq? tag (bl-key "badmap")) "Elixir.BadMapError")
               ((eq? tag (bl-key "case_clause")) "Elixir.CaseClauseError")
               ((eq? tag (bl-key "badmatch")) "Elixir.MatchError")
               ((eq? tag (bl-key "badarity")) "Elixir.BadArityError")
               ((eq? tag (bl-key "badfun")) "Elixir.BadFunctionError")
               (else "Elixir.ErlangError"))))
       (else "Elixir.ErlangError")))
(define (run thunk)
 (with-exception-catcher (lambda (e) (cons 'raised e)) (lambda () (cons 'ok (thunk)))))
(define (outcome-text o)
 (if (eq? (car o) 'ok) (list 'ok (bl-show (cdr o)))
  (let ((e (cdr o)))
   (if (native-raised? e)
    (list 'raised (native-exception-kind e) (data-reason-module (native-exception-reason e))
          (let ((r (native-exception-reason e))) (if (native-error-value? r) (data-message r) #f)))
    (list 'host-error (call-with-output-string "" (lambda (p) (display-exception e p))))))))
(define (data-message reason)
 (let ((o (run (lambda () (native-exception-message reason))))) (if (eq? (car o) 'ok) (cdr o) #f)))
;; BEAM row outcome against a native outcome. Errors: same class (:error),
;; same normalized module, and the same message whenever the native reason is
;; itself an exception struct (raw reasons carry no message natively).
(define (agrees? row native)
 (let ((tag (caddr row)))
  (cond
   ((eq? tag 'ok) (and (eq? (car native) 'ok) (same? (eval (cadddr row)) (cdr native))))
   ((eq? tag 'raised)
    (and (eq? (car native) 'raised) (native-raised? (cdr native))
         (let* ((e (cdr native)) (reason (native-exception-reason e))
                (module (data-reason-module reason)) (beam-module (cadddr row))
                (beam-message (car (cddddr row))))
          (and (eq? (native-exception-kind e) (bl-key "error"))
               (string=? module beam-module)
               (or (not (native-error-value? reason)) (not (string? beam-message))
                   (equal? (data-message reason) beam-message))))))
   (else #t))))
(for-each (lambda (row)
 (let* ((key (car row)) (args (map eval (cadr row))) (target (assoc key data-targets)))
  (count! 'rows)
  (if (eq? (caddr row) 'unencodable) (count! 'beam-unencodable))
  (if (not (and target (cadr target)))
   (fail! 'no-compiled-target key)
   (let ((compiled (run (lambda () (apply (cadr target) args)))))
    (if (agrees? row compiled) (count! 'compiled=beam)
     (fail! key (cadr row) 'beam (cddr row) 'compiled (outcome-text compiled)))
    (if (eq? (car compiled) 'ok) (count! 'compiled-ok) (count! 'compiled-raised))
    ;; The replica the cutover deletes, where the reference host still has it.
    (if (caddr target)
     (let ((leaf (run (lambda () (apply (caddr target) args)))))
      (if (agrees? row leaf) (count! 'old-leaf=beam) (count! 'old-leaf/=beam))))))))
 data-cases)
(for-each (lambda (f) (display "FAIL ") (write f) (newline)) (reverse check-failures))
(define (data-insert p xs)
 (if (or (null? xs) (string<? (symbol->string (car p)) (symbol->string (caar xs)))) (cons p xs)
  (cons (car xs) (data-insert p (cdr xs)))))
(for-each (lambda (p) (display (car p)) (display " ") (display (cdr p)) (newline))
 (let loop ((xs (table->list check-counts)) (out '())) (if (null? xs) out (loop (cdr xs) (data-insert (car xs) out)))))
(display (if (= 0 (table-ref check-counts 'failures 0)) "DATA_DIFFERENTIAL_PASS" "DATA_DIFFERENTIAL_FAIL"))
(newline)
