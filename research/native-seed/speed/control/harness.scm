;; gsi harness for control.check. new/old are thunks; failures are printed.
(define control-checks 0)
(define control-failures 0)
(define control-old-differs 0)
(define control-shape-values 0)
(define (control-run thunk)
 (with-exception-catcher (lambda (e) (vector 'raised)) (lambda () (vector 'ok (thunk)))))
(define (control-equal? a b)
 (and (eq? (vector-ref a 0) (vector-ref b 0))
      (or (eq? (vector-ref a 0) 'raised)
          ;; Closures have identity only: two fresh closures count as equal.
          (and (procedure? (vector-ref a 1)) (procedure? (vector-ref b 1)))
          (bl-key-equal? (vector-ref a 1) (vector-ref b 1)))))
(define (control-fail label what)
 (set! control-failures (+ control-failures 1))
 (display "CONTROL_FAIL ") (display label) (display " ")
 (write what) (newline))
;; Source corpus: the new emission must reproduce BEAM; the frozen reference
;; emitter is reported when it differs (it is not the oracle here).
(define (control-beam label expected new old)
 (let ((n (control-run new)) (o (control-run old)))
  (set! control-checks (+ control-checks 1))
  (if (not (control-equal? expected n)) (control-fail label (list 'beam expected 'new n)))
  (if (not (control-equal? o n))
   (begin (set! control-old-differs (+ control-old-differs 1))
    (display "CONTROL_OLD_DIFFERS ") (display label) (display " ") (write (list 'old o 'new n 'beam expected)) (newline)))))
;; Hand-built ANF: the reference generic matcher is the oracle.
(define (control-same label new old)
 (let ((n (control-run new)) (o (control-run old)))
  (set! control-checks (+ control-checks 1))
  (if (eq? (vector-ref n 0) 'ok) (set! control-shape-values (+ control-shape-values 1)))
  (if (not (control-equal? o n)) (control-fail label (list 'old o 'new n)))))
(define (control-report)
 (display "CONTROL_CHECKS ") (display control-checks)
 (display " FAILURES ") (display control-failures)
 (display " OLD_DIFFERS ") (display control-old-differs)
 (display " SHAPE_VALUES ") (display control-shape-values) (newline)
 (exit (if (= control-failures 0) 0 1)))
