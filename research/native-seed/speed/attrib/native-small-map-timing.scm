;; Arguments: stage1 --eval native-small-map-timing.scm eval-bundle.scm
(define raw-keys
 (map bl-key '("op" "ann" "file" "ns" "name" "args" "def" "tag" "guard" "body"
                "pats" "test" "then" "else" "init" "offset")))
(define (prefix n xs)
 (if (= n 0) '() (cons (car xs) (prefix (- n 1) (cdr xs)))))
(define (entries keys)
 (if (null? keys) '() (cons (car keys) (cons (symbol->string (car keys)) (entries (cdr keys))))))
(define (fixture n)
 (let* ((keys (prefix n raw-keys)) (input (entries keys))
        (reversed (entries (reverse keys))) (last-key (car keys))
        (value (apply bl-map input)) (other (apply bl-map reversed))
        (replace (apply bl-map (append (entries (prefix (min n 15) keys)) (list last-key "replaced")))))
  (if (or (not (= n (native-map-count value)))
          (not (equal? (native-map-pairs value) (native-map-pairs other)))
          (not (string=? "replaced" (native-map-ref replace last-key "")))
          (not (= (min n 15) (native-map-count replace))))
   (error "map construction changed key order, values or duplicates" n))
  (for-each (lambda (k)
    (if (not (string=? (symbol->string k) (native-map-ref value k "")))
     (error "wrong map value" k))) keys)
  input))
(define (time-one input n count)
 (let ((start (real-time)))
  (let loop ((left count) (total 0))
   (if (= left 0)
    (begin
     (if (not (= total (* n count))) (error "invalid map benchmark accumulator" total))
     (* 1000 (- (real-time) start)))
    (loop (- left 1) (+ total (native-map-count (apply bl-map input))))))))
(for-each (lambda (n)
 (let ((input (fixture n)))
  (time-one input n 1000)
  (let trials ((i 0))
   (if (< i 7)
    (begin (write (list 'SMALL_MAP n i (time-one input n 20000))) (newline)
           (trials (+ i 1))))))) '(4 8 16))
(exit 0)
