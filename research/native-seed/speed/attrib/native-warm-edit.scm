;; Arguments: stage1 --eval native-warm-edit.scm eval-bundle.scm
(define bundle-path (caddr (native-command-line)))
(define bundle (native-eval-string (native-read-file bundle-path)))
(define macro-install (native-global-exact "native.bootstrap" "install-source-macros!"))
(define eval-source (native-global-exact "native.eval" "eval-string"))
(define source-one "(defn total [n] (loop [i n, sum 0] (if (zero? i) sum (recur (dec i) (+ sum i))))) (total 32)")
(define source-two "(defn total [n] (loop [i n, sum 1] (if (zero? i) sum (recur (dec i) (+ sum i))))) (total 32)")
(define (evaluate source expected)
 (let* ((start (real-time)) (result (bl-invoke eval-source (list source "speedwork-edit.bl")))
        (milliseconds (* 1000 (- (real-time) start))))
  (if (not (= result expected)) (error "unexpected warm edit result" result))
  milliseconds))
(bl-invoke macro-install (list bundle))
(bl-invoke eval-source (list "(ns native.speedwork-edit)" "speedwork-edit.bl"))
(evaluate source-one 528)
(let loop ((trial 0))
 (if (< trial 12)
  (let ((time (if (even? trial) (evaluate source-two 529) (evaluate source-one 528))))
   (write (list 'EDIT trial time)) (newline) (loop (+ trial 1)))))
(exit 0)
