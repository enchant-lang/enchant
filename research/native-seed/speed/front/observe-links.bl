;; Keep the profiling CLI separate from the updater's receipt validation.
(let [observer "native.observe-links"]
 (BeamLisp.Loader/with_load_path "research/native-seed/speed/front"
  (fn [] (BeamLisp.Loader/load_provider observer)))
 ((BeamLisp.Env/fetch_exact! observer "run-observation") (BeamLisp/argv)))
