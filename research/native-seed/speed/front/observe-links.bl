;; Observe exact installed-link row consultations during one real source compile.
;; This diagnostic has no authority to reuse a namespace.
;; Run with research/native-seed/run run and pass arguments after --:
;;   PARTITION LINK_ROWS NAMESPACE REPORT [CANDIDATE_LINK_ROWS]
;;   PARTITION LINK_ROWS --all REPORT [CANDIDATE_LINK_ROWS]
;;   PARTITION LINK_ROWS --sequential-scoped REPORT
;;   PARTITION LINK_ROWS --write-control REPORT
;;   QUALIFIED_PARTITION BASELINE_LINK_ROWS --shadow REPORT CANDIDATE_LINK_ROWS
;;   BASE_PARTITION BASE_LINK_ROWS --capture-source RECEIPT.etf
;;   EDITED_PARTITION EDITED_LINK_ROWS --source-shadow REPORT BASE_PARTITION RECEIPT.etf
;;   PARTITION LINK_ROWS --macro-context-control REPORT
;;   PARTITION LINK_ROWS --outer-control REPORT
;; --all isolates each member. --sequential-scoped keeps the updater's shared
;; staging environment and scopes generated names per member. --sequential
;; retains the historical ambient naming mode for comparison.
(ns native.observe-links
 (:require [native.artifact :as artifact] [js.build :as build] [bl.json :as json]
           [reader-node :as rn]))

(def trace-limit 100000)
(def source-read-entries [(tuple :Elixir.File :read! 1)
                          (tuple :file :read_file 1) (tuple :prim_file :read_file 1)])
(def source-read-entry-set (set source-read-entries))
(def macro-entry (tuple :Elixir.BeamLisp.Ns.Compiler :expand-macro 4))
(def link-put-entry (tuple :ets :insert 2))
(def link-delete-entry (tuple :ets :delete 2))
(defn- source-path [raw]
 (let [path (if (erlang/is_list raw) (unicode/characters_to_binary raw) raw)]
  (when (and (string? path) (<= (erlang/byte_size path) 4096)
             (or (String/ends_with? path ".bl") (String/ends_with? path ".bl.md")))
   path)))

(defn- source-result [entry value]
 (let [bytes (if (= entry (first source-read-entries)) value
              (when (and (erlang/is_tuple value) (= (erlang/tuple_size value) 2)
                         (= (elem value 0) :ok))
               (elem value 1)))]
  (if (erlang/is_binary bytes) (artifact/sha bytes) :unavailable)))

(defn- effect [effects kind key]
 (let [n (inc (:count effects 0))]
  (if (> n trace-limit) (assoc effects :count n)
   (-> effects (assoc :count n) (update-in [kind key] (fn [old] (inc (or old 0))))))))

(defn- value-identity [value]
 (artifact/sha (erlang/term_to_binary value (list :deterministic))))

(defn- fun-field [callable field] (elem (erlang/fun_info callable field) 1))

(defn- fun-origin [callable]
 (let [module (fun-field callable :module) path (code/which module)
       product (str (System/get_env "BL_SDK_PRODUCT") "/")
       path (when (erlang/is_list path) (unicode/characters_to_binary path))
       pinned? (and (string? path) (String/starts_with? path product))]
  {:module (erlang/atom_to_binary module) :name (erlang/atom_to_binary (fun-field callable :name))
   :arity (fun-field callable :arity) :type (fun-field callable :type)
   :capture-count (count (fun-field callable :env)) :pinned-code-path (boolean pinned?)
   :code-md5 (Base/encode16 (erlang/apply module :module_info (list :md5)) (list (tuple :case :lower)))}))

(defn- macro-origin [callable]
 (cond
  (erlang/is_function callable) {:shape :beam-function :entries [(fun-origin callable)]}
  (and (erlang/is_tuple callable) (= 3 (erlang/tuple_size callable)) (= :"$blfn" (elem callable 0)))
  (let [entries (vals (elem callable 1)) variadic (elem callable 2)
        entries (if variadic (cons (elem variadic 1) entries) entries)]
   (if (every? erlang/is_function entries)
    {:shape :multi-function :entries (vec (sort (map fun-origin entries)))}
    {:shape :opaque}))
  :else {:shape :opaque}))

(defn- record-macro [effects ns head callable]
 (let [cached (get-in effects [:macro-origins callable])
       origin (or cached (macro-origin callable))
       next (effect effects :expansions [ns head])]
  (if (>= (:count next) trace-limit) next
   (-> next (assoc-in [:macro-origins callable] origin)
       (update-in [:macro-bindings [ns head]] (fn [known] (conj (or known #{}) origin)))))))

(defn- record-link [effects op key value]
 (let [events (:ordered-links effects []) scope (elem key 0) member [(elem key 2) (elem key 3)]]
  (cond
   (not= scope (:scope effects))
   (let [ancestor (get-in effects [:ancestor-slots scope])
         next (update effects :outside-links (fn [n] (inc (or n 0))))]
    (if (and (= op :read) ancestor)
     (update next :ancestor-reads (fn [reads] (conj (or reads #{}) [ancestor member value])))
     (assoc next :unexplained-scope true)))
   (>= (count events) (inc trace-limit)) effects
   :else (assoc effects :ordered-links (conj events [op member value])))))

(defn- collector [calls pending hits misses reads sources effects]
 (receive
  [:trace _ :call [:ets :lookup arguments]]
  (recur calls (second arguments) hits misses reads sources effects)
  [:trace _ :return_from [:ets :lookup 2] value]
  (if (>= calls trace-limit) (recur (inc calls) nil hits misses reads sources effects)
   (let [key [(elem pending 2) (elem pending 3)]
         outcome (when-not (empty? value) (value-identity (elem (first value) 1)))
         next-effects (record-link effects :read pending outcome)]
    (if outcome
     (recur (inc calls) nil (conj hits key) misses reads sources next-effects)
     (recur (inc calls) nil hits (conj misses key) reads sources next-effects))))
  [:trace _ :call [module function arguments]]
  (let [entry (tuple module function (count arguments)) key (first arguments)]
   (cond
    (= entry macro-entry)
    (let [head (rn/node-name (first (rn/node-items (second arguments)))) env (nth arguments 3)]
     (recur calls pending hits misses reads sources (record-macro effects (:ns env) head key)))
    (or (= entry link-put-entry) (= entry link-delete-entry))
    (let [writing? (= entry link-put-entry) row (second arguments)
          key (if writing? (elem row 0) row)
          outcome (when writing? (value-identity (elem row 1)))
          kind (if writing? :link-writes :link-deletions)]
     (recur calls pending hits misses reads sources
      (-> effects (effect kind [(elem key 2) (elem key 3)]) (record-link :write key outcome))))
    (contains? source-read-entry-set entry)
    (recur calls pending hits misses (conj reads [entry (source-path key)]) sources effects)
    :else (throw (ex-info "Unexpected native observation call" {:entry entry}))))
  [:trace _ kind [module function 1] value] :when (or (= kind :return_from) (= kind :exception_from))
  (let [[entry path] (peek reads)]
   (when-not (= entry (tuple module function 1))
    (throw (ex-info "Unexpected Source read return"
             {:module module :function function :pending-entry entry})))
   (recur calls pending hits misses (pop reads)
    (if (and path (< (count sources) 1025))
     (conj sources [path (if (= kind :return_from) (source-result entry value) :unavailable)])
     sources) effects))
  [:finish parent ticket]
  (erlang/send parent [:observed ticket
    {:calls calls :hits hits :misses misses :sources sources :effects effects
     :complete? (and (nil? pending) (empty? reads) (<= calls trace-limit)
                    (<= (count (:ordered-links effects [])) trace-limit)
                    (<= (:count effects 0) trace-limit) (<= (count sources) 1024))}])))

(defn- trace! [action]
 (let [owner (erlang/self) scope (BeamLisp.Env/env_id)
       ancestors (into {} (map-indexed (fn [index id] [id index]) (rest (BeamLisp.Env/chain))))
       observer (spawn (fn [] (collector 0 nil #{} #{} [] #{} {:scope scope :ancestor-slots ancestors})))
       session (erlang/apply :trace :session_create (list :native_link_observation observer (list)))
       match (list (tuple (list :beam_lisp_vars (tuple :_ :link :_ :_)) (list) (list (tuple :return_trace))))
       source-match (list (tuple (list :_) (list) (list (tuple :exception_trace))))
       link-key (tuple :_ :link :_ :_)]
  (try
   (assert (= 1 (erlang/apply :trace :function
                  (list session (tuple :ets :lookup 2) match (list :local)))))
   (doseq [entry source-read-entries]
    (assert (= 1 (erlang/apply :trace :function (list session entry source-match (list :local))))))
   (doseq [[entry spec] [[macro-entry true]
                         [link-put-entry (list (tuple (list :beam_lisp_vars (tuple link-key :_)) (list) (list)))]
                         [link-delete-entry (list (tuple (list :beam_lisp_vars link-key) (list) (list)))]]]
    (assert (= 1 (erlang/apply :trace :function (list session entry spec (list :local))))))
   (assert (= 1 (erlang/apply :trace :process (list session owner true (list :call)))))
   (let [result (action)
         barrier (erlang/apply :trace :delivered (list session owner))
         ticket (erlang/make_ref)]
    (receive [:trace_delivered seen ref] :when (and (= seen owner) (= ref barrier))
      :ready (after 10000 (throw :trace-delivery-timeout)))
    (erlang/send observer [:finish owner ticket])
    (let [observation (receive [:observed ref value] :when (= ref ticket)
                       value (after 10000 (throw :trace-collector-timeout)))]
     (assert (:complete? observation))
     [result observation]))
   (finally
    (erlang/apply :trace :session_destroy (list session))
    (Process/exit observer :kill)))))

(defn- read-rows [path]
 (let [text (File/read! path)]
  (BeamLisp.CompilerData/check_closed_etf! text artifact/limits)
  {:sha256 (artifact/sha text) :rows (erlang/binary_to_term text)}))

(defn- installed-rows [rows]
 (into {} (map (fn [[ns name info private?]] [[ns name] [info private?]]) rows)))

(defn- local-links [closure rows]
 ;; Core rows shadow the ordinary member rows, just as in install-rows!.
 (into (into {} (map (fn [[ns name info _]] [[ns name] (value-identity info)]) rows))
       (map (fn [[name info]] [["core" name] (value-identity info)]) (:core-links closure))))

(defn- replay-links [observation initial]
 ;; This validates only traced reads of the closure's own link registry.
 ;; The entire compiler and its macro effects require broader provenance.
 (loop [state initial events (seq (get-in observation [:effects :ordered-links]))]
  (if-let [[op key outcome] (first events)]
   (if (= op :read)
    (if (= outcome (get state key)) (recur state (next events))
     {:accepted false :different-read key})
    (recur (if outcome (assoc state key outcome) (dissoc state key)) (next events)))
   {:accepted true})))

(defn- link-receipt [observation]
 ;; Once a link has been written by this unit, subsequent reads depend on
 ;; that write. Keep the reads before the first write and the last write.
 (reduce (fn [receipt [op key outcome]]
           (if (= op :write)
            (assoc-in receipt [:writes key] outcome)
            (if (contains? (:writes receipt) key) receipt
             (assoc-in receipt [:reads key] outcome))))
  {:reads {} :writes {}} (get-in observation [:effects :ordered-links] [])))

(defn- receipt-matches? [receipt initial]
 (every? (fn [[key outcome]] (= outcome (get initial key))) (:reads receipt)))

(defn- ancestor-outcome [chain [index [ns name]]]
 (if-let [scope (nth chain index nil)]
  (let [rows (ets/lookup :beam_lisp_vars (BeamLisp.Env/pfx scope (tuple :link ns name)))]
   (when (seq rows) (value-identity (elem (first rows) 1))))
  :unavailable))

(defn- ancestor-snapshot [receipts]
 (let [chain (vec (BeamLisp.Env/chain))
       keys (distinct (mapcat (fn [receipt]
                               (map (fn [[index member _]] [index member]) (:ancestor-reads receipt))) receipts))]
  (into {} (map (fn [key] [key (ancestor-outcome chain key)]) keys))))

(defn- ancestor-matches? [receipt snapshot]
 (and (not (:unexplained-scope receipt))
      (every? (fn [[index member outcome]] (= outcome (get snapshot [index member] :unavailable)))
              (:ancestor-reads receipt))))

(defn- scope-receipt [observation]
 {:ancestor-reads (vec (sort (get-in observation [:effects :ancestor-reads])))
  :unexplained-scope (boolean (get-in observation [:effects :unexplained-scope]))})

(defn- outer-control []
 (BeamLisp.Env/isolated
  (fn []
   (let [ns "native.ancestor-write-control" name "target" qualified (str ns "/" name)
         initial (tuple :Elixir.BeamLisp.Ns.Compiler {} nil)
         later (tuple :Elixir.BeamLisp.Env {} nil)
         _ (BeamLisp.Env/put_link ns name initial)
         [seen observation] (BeamLisp.Env/isolated (fn [] (trace! (fn [] (BeamLisp.Env/link ns qualified)))))
         receipt (scope-receipt observation)]
    (assert (= (tuple :ok initial) seen))
    (assert (= [[0 [ns name] (value-identity initial)]] (:ancestor-reads receipt)))
    (assert (ancestor-matches? receipt (ancestor-snapshot [receipt])))
    (BeamLisp.Env/put_link ns name later)
    (assert (not (ancestor-matches? receipt (ancestor-snapshot [receipt]))))
    {:schema "bl.native.link-ancestor-control" :version 1
     :verified-ancestor-reads (count (:ancestor-reads receipt)) :changed-parent-row-refused true}))))

(defn- ordered-report [observation]
 (let [{:keys [reads writes]} (link-receipt observation)]
  {:local-operations (count (get-in observation [:effects :ordered-links] []))
   :outside-operations (get-in observation [:effects :outside-links] 0)
   :local-operation-sha256 (value-identity (get-in observation [:effects :ordered-links] []))
   :external-read-keys (count reads) :final-write-keys (count writes)}))

(defn- write-control []
 (BeamLisp.Env/isolated
  (fn []
   (let [ns "native.link-write-control" member "target" key [ns member] qualified (str ns "/" member)
         info (tuple :Elixir.BeamLisp.Ns.Compiler {} nil)
         [result observation]
         (trace! (fn []
                   (let [before (BeamLisp.Env/link ns qualified)]
                    (BeamLisp.Env/put_link ns member info)
                    (let [present (BeamLisp.Env/link ns qualified)]
                     (BeamLisp.Env/delete_key (tuple :link ns member))
                     [before present (BeamLisp.Env/link ns qualified)]))))
         fingerprint (value-identity info)
         events (get-in observation [:effects :ordered-links])
         different {key (value-identity (tuple :Elixir.BeamLisp.Env {} nil))}
         overwritten (assoc-in observation [:effects :ordered-links] (subvec events 1))]
    (assert (= [:error (tuple :ok info) :error] result))
    (assert (= [[:read key nil] [:write key fingerprint] [:read key fingerprint]
                [:write key nil] [:read key nil]] events))
    (assert (:accepted (replay-links observation {})))
    (assert (= key (:different-read (replay-links observation different))))
    (assert (:accepted (replay-links overwritten different)))
    (assert (receipt-matches? (link-receipt observation) {}))
    (assert (not (receipt-matches? (link-receipt observation) different)))
    (assert (receipt-matches? (link-receipt overwritten) different))
    {:schema "bl.native.link-order-write-control" :version 1 :events events
     :changed-value-refused-before-write true :changed-value-accepted-after-write true}))))

(defn- install-rows! [closure rows]
 (doseq [[ns name info _] rows] (BeamLisp.Env/put_link ns name info))
 (doseq [[name info] (:core-links closure)] (BeamLisp.Env/put_link "core" name info)))

(defn- compile-staged [member]
 (trace! (fn [] (build/compile-prepared (build/prepare-ns (:path member)) {:check-node identity}))))

(defn- compile-member [closure member rows]
 (BeamLisp.Env/isolated
  (fn []
   (install-rows! closure rows)
   (BeamLisp.Compiler/with_fresh_names (fn [] (compile-staged member))))))

(defn- def-bytes [unit]
 (erlang/term_to_binary (:defs unit) (list :deterministic)))

(defn- macro-context-control [closure baseline]
 (let [path "research/native-seed/speed/front/macro-context-fixture.bl"
       compile-under (fn [value]
                        (Process/put :native_relink_context_fixture value)
                        (compile-member closure {:path path} (:rows baseline)))
       [left left-observation] (compile-under 1)
       [right right-observation] (compile-under 2)
       same-links? (= (link-receipt left-observation) (link-receipt right-observation))
       same-source? (= (:source-sha256 left) (:source-sha256 right))
       same-files? (= (:sources left-observation) (:sources right-observation))
       same-anf? (erlang/=:= (def-bytes left) (def-bytes right))]
  (assert same-source?)
  (assert same-links?)
  (assert same-files?)
  (assert (not same-anf?))
  {:schema "bl.native.macro-context-control" :version 1 :reuse-authority false
   :source-sha256 (:source-sha256 left) :link-rows-sha256 (:sha256 baseline)
   :same-source-read-outcomes same-files? :same-link-receipt same-links?
   :same-definition-bytes same-anf? :input "process dictionary read during a staged macro"}))

(defn- source-identity [path]
 (let [absolute (Path/expand path) root (str (File/cwd!) "/")]
  (if (String/starts_with? absolute root) (subs absolute (count root)) absolute)))

(defn- capture-source [closure baseline]
 {:schema :native-source-shadow-v2
  :sdk (:sdk-pin closure) :options (:options closure) :order (:order closure)
  :link-rows-sha256 (:sha256 baseline)
  :members (into {}
   (map (fn [ns]
          (let [member (get-in closure [:units ns])
                [compiled observed] (compile-member closure member (:rows baseline))]
           (assert (= (:source-sha256 member) (:source-sha256 compiled)))
           (assert (erlang/=:= (def-bytes member) (def-bytes compiled)))
           (assert (:accepted (replay-links observed (:local-links baseline))))
           [ns {:defs (artifact/sha (def-bytes member)) :link-receipt (link-receipt observed)
                :scope-receipt (scope-receipt observed)
                :paths (vec (sort (distinct (map (fn [[path digest]] [(source-identity path) digest])
                                                (:sources observed)))))}]))
        (:order closure)))})

(defn- read-source-identity [path]
 (try (artifact/sha (File/read! path)) (catch _ :unavailable)))

(defn- source-shadow [closure candidate baseline-path receipt-path]
 (let [baseline (artifact/read-closure baseline-path)
       bytes (File/read! receipt-path)
       _ (BeamLisp.CompilerData/check_closed_etf! bytes artifact/limits)
       receipt (erlang/binary_to_term bytes)
       _ (assert (= :native-source-shadow-v2 (:schema receipt)))
       _ (assert (= (:sdk-pin baseline) (:sdk-pin closure) (:sdk receipt)))
       _ (assert (= (:options baseline) (:options closure) (:options receipt)))
       _ (assert (= (:order baseline) (:order closure) (:order receipt)))
       _ (assert (= (:host-modules baseline) (:host-modules closure)))
       _ (assert (= (:stubs baseline) (:stubs closure)))
       _ (assert (= (:core-links baseline) (:core-links closure)))
       before-scan (erlang/monotonic_time :microsecond)
       identities (into {} (map (fn [path] [path (read-source-identity path)])
                          (distinct (mapcat (fn [entry] (map first (:paths entry))) (vals (:members receipt))))))
       outer (ancestor-snapshot (map :scope-receipt (vals (:members receipt))))
       started (erlang/monotonic_time :microsecond)
       plan (mapv (fn [ns]
                    (let [old (get-in baseline [:units ns]) new (get-in closure [:units ns])
                          record (get-in receipt [:members ns])
                          changed-paths (vec (filter (fn [[path digest]]
                                                      (or (= digest :unavailable) (not= digest (get identities path))))
                                                    (:paths record)))
                          own? (not= (:source-sha256 old) (:source-sha256 new))
                          links? (not (receipt-matches? (:link-receipt record) (:local-links candidate)))
                          outer? (not (ancestor-matches? (:scope-receipt record) outer))]
                     (assert (= (:path old) (:path new)))
                     (assert (= (:defs record) (artifact/sha (def-bytes old))))
                     {:namespace ns :changed-source own? :changed-dependencies (mapv first changed-paths)
                      :changed-links links? :changed-ancestor-links outer?
                      :reused (not (or own? links? outer? (seq changed-paths)))}))
                  (:order closure))
       planned (erlang/monotonic_time :microsecond)
       results (mapv (fn [decision]
                       (let [ns (:namespace decision) member (get-in closure [:units ns])
                             actual (if (:reused decision) (get-in baseline [:units ns])
                                      (first (compile-member closure member (:rows candidate))))]
                        (assoc decision :exact-clean-definitions
                               (and (= (:source-sha256 actual) (:source-sha256 member))
                                    (erlang/=:= (def-bytes actual) (def-bytes member)))))) plan)]
  {:schema "bl.native.source-replay-shadow" :version 2 :reuse-authority false
   :baseline-receipt-sha256 (artifact/sha bytes) :candidate-link-rows-sha256 (:sha256 candidate)
   :baseline-link-rows-sha256 (:link-rows-sha256 receipt)
   :observed-source-paths (count identities) :observed-ancestor-keys (count outer)
   :source-and-ancestor-scan-us (- started before-scan) :plan-us (- planned started)
   :candidate-compilation-and-oracle-comparison-us (- (erlang/monotonic_time :microsecond) planned)
   :members results}))

(defn- observe-shadow [closure baseline candidate]
 ;; The qualified partition is the independent clean candidate oracle. Only
 ;; members that fail their baseline link receipt enter candidate compilation.
 (assert (some? candidate))
 (let [started (erlang/monotonic_time :microsecond)
       prior (mapv (fn [ns]
                     (let [member (get-in closure [:units ns])
                           [compiled observed] (compile-member closure member (:rows baseline))
                           receipt (link-receipt observed)]
                      (assert (= (:source-sha256 member) (:source-sha256 compiled)))
                      (assert (:accepted (replay-links observed (:local-links baseline))))
                      [member (def-bytes compiled) receipt (ordered-report observed)]))
                   (:order closure))
       seeded (erlang/monotonic_time :microsecond)
       plan (mapv (fn [[member bytes receipt operations]]
                    {:member member :baseline-bytes bytes :operations operations
                     :reuse? (receipt-matches? receipt (:local-links candidate))}) prior)
       planned (erlang/monotonic_time :microsecond)
       result (mapv (fn [{:keys [member baseline-bytes operations reuse?]}]
                      (let [bytes (if reuse? baseline-bytes
                                   (def-bytes (first (compile-member closure member (:rows candidate)))))
                            exact? (erlang/=:= bytes (def-bytes member))]
                       {:namespace (:ns member) :reused reuse? :exact-clean-definitions exact?
                        :operations operations})) plan)
       checked (erlang/monotonic_time :microsecond)]
  {:schema "bl.native.link-replay-shadow" :version 1 :reuse-authority false
   :baseline-link-rows-sha256 (:sha256 baseline) :candidate-link-rows-sha256 (:sha256 candidate)
   :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
   :baseline-compilation-us (- seeded started) :plan-us (- planned seeded)
   :candidate-compilation-and-oracle-comparison-us (- checked planned)
   :members result}))

(defn- effect-report [observation]
 (into {} (map (fn [kind] [kind (mapv (fn [[[ns name] occurrences]] [ns name occurrences])
                                     (sort (get-in observation [:effects kind])))])
               [:expansions :link-writes :link-deletions])))

(defn- macro-report [observation]
 (mapv (fn [[[ns head] origins]] [ns head (vec (sort origins))])
       (sort (get-in observation [:effects :macro-bindings]))))

(defn- observe-sequential [closure {:keys [rows sha256]} scoped?]
 (let [results (BeamLisp.Env/isolated
                (fn []
                 (install-rows! closure rows)
                 (mapv (fn [ns]
                         (let [member (get-in closure [:units ns])
                               [compiled observed] (if scoped?
                                                     (BeamLisp.Compiler/with_fresh_names (fn [] (compile-staged member)))
                                                     (compile-staged member))]
                          (assert (= (:source-sha256 member) (:source-sha256 compiled)))
                          {:namespace ns :same-definitions (erlang/=:= (def-bytes compiled) (def-bytes member))
                           :actual-definitions-sha256 (artifact/sha (def-bytes compiled))
                           :source-read-outcomes (vec (sort (:sources observed)))
                           :staging-effects (effect-report observed)
                           :macro-origins (macro-report observed)
                           :ordered-links (ordered-report observed)
                           :lookup-hits (vec (sort (:hits observed)))
                           :lookup-misses (vec (sort (:misses observed)))}))
                       (:order closure))))]
  {:schema "bl.native.link-sequential-observation" :version 3 :link-rows-sha256 sha256
   :per-member-fresh-names scoped?
   :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
   :members results :reuse-authority false}))

(defn- compare-rows [closure member installed compiled observation consulted-keys candidate]
 (let [incoming (installed-rows (:rows candidate))
       changed (vec (filter (fn [key] (not= (get installed key) (get incoming key)))
                           (sort (into (set (keys installed)) (keys incoming)))))
       consulted (vec (filter consulted-keys changed))
       [next next-observation] (compile-member closure member (:rows candidate))
       prediction (replay-links observation (:local-links candidate))
       exact? (erlang/=:= (def-bytes compiled) (def-bytes next))]
  (assert (= (:accepted prediction) (receipt-matches? (link-receipt observation) (:local-links candidate))))
  (when (and (empty? consulted) (not exact?))
   (throw (ex-info "The recorded links missed an actual ANF change" {:changed changed})))
  {:candidate-rows-sha256 (:sha256 candidate)
   :changed-rows changed :changed-consulted-rows consulted :exact-anf exact?
   :ordered-link-replay prediction
   :staging-effects (effect-report next-observation)
   :source-read-outcomes (vec (sort (:sources next-observation)))}))

(defn- observe [closure {:keys [rows sha256 local-links]} selected comparison]
 (let [member (get-in closure [:units selected])
       installed (installed-rows rows)
       _ (assert (some? member))
       [compiled observation] (compile-member closure member rows)
       keys (sort (into (:hits observation) (:misses observation)))]
  (assert (= (:source-sha256 member) (:source-sha256 compiled)))
  (assert (:accepted (replay-links observation local-links)))
  (assert (some (fn [[path sha]] (and (= (Path/expand (:path member)) (Path/expand path))
                                     (= (:source-sha256 member) sha))) (:sources observation)))
  {:schema "bl.native.installed-link-observation" :version 4
   :namespace selected :source-sha256 (:source-sha256 member)
   :definitions-sha256 (artifact/sha (def-bytes compiled))
   :link-rows-sha256 sha256
   :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
   :lookups (:calls observation)
   :lookup-hits (vec (sort (:hits observation)))
   :lookup-misses (vec (sort (:misses observation)))
   :source-file-consultations (vec (sort (distinct (map first (:sources observation)))))
   :source-read-outcomes (vec (sort (:sources observation)))
   :staging-effects (effect-report observation)
   :macro-origins (macro-report observation)
   :ordered-links (ordered-report observation)
   :present-in-member-rows (vec (filter installed keys))
   :absent-from-member-rows (vec (remove installed keys))
   :comparison (when comparison (compare-rows closure member installed compiled observation (set keys) comparison))
   :scope "Filtered ETS consultations in synchronous staged compilation of unchanged Source. A missing installed member row can still have another resolver fallback."
   :reuse-authority false}))

(let [[partition rows selected output comparison source-receipt] (BeamLisp/argv)]
 (let [closure (artifact/read-closure partition)
       pinned-rows (fn [path] (let [rowset (read-rows path)]
                               (assoc rowset :local-links (local-links closure (:rows rowset)))))
       baseline (pinned-rows rows)
       source-shadow? (= selected "--source-shadow")
       candidate (when (and comparison (not source-shadow?)) (pinned-rows comparison))
       report (cond
                (= selected "--capture-source") (capture-source closure baseline)
                source-shadow? (source-shadow closure baseline comparison source-receipt)
                (= selected "--macro-context-control") (macro-context-control closure baseline)
                (= selected "--outer-control") (outer-control)
                (= selected "--write-control") (write-control)
                (= selected "--shadow") (observe-shadow closure baseline candidate)
                (= selected "--sequential") (observe-sequential closure baseline false)
                (= selected "--sequential-scoped") (observe-sequential closure baseline true)
                (= selected "--all")
                {:schema "bl.native.link-observation-inventory" :version 4
                 :members (mapv (fn [ns] (observe closure baseline ns candidate)) (:order closure))
                 :reuse-authority false}
                :else (observe closure baseline selected candidate))]
  (File/write! output (if (= selected "--capture-source")
                       (erlang/term_to_binary report (list :deterministic)) (json/encode report)))
  (when (or (= selected "--shadow") source-shadow?)
   (let [different (mapv :namespace (remove :exact-clean-definitions (:members report)))]
    (when (seq different)
     (throw (ex-info "Selective relink differs from the qualified clean closure" {:members different})))))))
