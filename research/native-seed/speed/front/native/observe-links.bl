;; Observe exact installed-link row consultations during one real source compile.
;; The checked updater and diagnostic share the same receipt validation.
;; Run with research/native-seed/run run and pass arguments after --:
;;   PARTITION LINK_ROWS NAMESPACE REPORT [CANDIDATE_LINK_ROWS]
;;   PARTITION LINK_ROWS --all REPORT [CANDIDATE_LINK_ROWS]
;;   PARTITION LINK_ROWS --sequential-scoped REPORT
;;   PARTITION LINK_ROWS --write-control REPORT
;;   QUALIFIED_PARTITION BASELINE_LINK_ROWS --shadow REPORT CANDIDATE_LINK_ROWS
;;   BASE_PARTITION BASE_LINK_ROWS --capture-source RECEIPT.etf
;;   EDITED_PARTITION EDITED_LINK_ROWS --source-shadow REPORT BASE_PARTITION RECEIPT.etf
;;   PARTITION LINK_ROWS --macro-context-control REPORT
;;   PARTITION LINK_ROWS --phase-macros REPORT
;;   PARTITION LINK_ROWS --phase-compile REPORT PHASE_MACRO_SAMPLES
;;   PARTITION LINK_ROWS --registry-phases REPORT
;;   PARTITION LINK_ROWS --registry-inputs REPORT [NAMESPACE]
;;   PARTITION LINK_ROWS --lowering-effects REPORT PHASE_MACRO_SAMPLES [NAMESPACE]
;;   PARTITION LINK_ROWS --env-read-control REPORT
;;   PARTITION LINK_ROWS --runtime-read-control REPORT
;;   PARTITION LINK_ROWS --code-read-control REPORT
;;   PARTITION LINK_ROWS --resolver-read-control REPORT
;;   PARTITION BASE_LINK_ROWS --registry-shadow REPORT NEW_LINK_ROWS PHASE_MACRO_SAMPLES
;;   PARTITION BASE_LINK_ROWS --capture-registry RECEIPT NEW_LINK_ROWS PHASE_MACRO_SAMPLES
;;   PARTITION NEW_LINK_ROWS --cached-registry REPORT RECEIPT PHASE_MACRO_SAMPLES [--force-lower]
;;   DONOR_PARTITION DONOR_LINK_ROWS --capture-bound-registry RECEIPT PHASE_MACRO_SAMPLES QUALIFICATION
;;   PARTITION LINK_ROWS --bound-registry REPORT RECEIPT PHASE_MACRO_SAMPLES DONOR_PARTITION QUALIFICATION RECEIPT_SHA
;;   PARTITION LINK_ROWS --bound-export REPORT RECEIPT PHASE_MACRO_SAMPLES DONOR_PARTITION QUALIFICATION RECEIPT_SHA CLOSURE_ETF
;;   PARTITION LINK_ROWS --bound-env-control REPORT RECEIPT PHASE_MACRO_SAMPLES DONOR_PARTITION QUALIFICATION RECEIPT_SHA
;;   DONOR_PARTITION LINK_ROWS --bound-registry-controls REPORT RECEIPT QUALIFICATION RECEIPT_SHA
;;   PARTITION LINK_ROWS --source-probe-control REPORT
;;   PARTITION LINK_ROWS --row-install-control REPORT
;;   PARTITION LINK_ROWS --stage-link-subset REPORT [NAMESPACE|--all] [--timed]
;;   DONOR_PARTITION DONOR_LINK_ROWS --capture-stage-link-plan PLAN QUALIFICATION
;;   EDITED_PARTITION EDITED_LINK_ROWS --replay-stage-link-plan REPORT PLAN PLAN_SHA [OMISSION_CONTROL_NAMESPACE]
;;   EDITED_PARTITION EDITED_LINK_ROWS --guard-stage-link-plan REPORT PLAN PLAN_SHA [OMISSION_CONTROL_NAMESPACE]
;;   PARTITION LINK_ROWS --declaration-snapshot REPORT NAMESPACE
;;   PARTITION LINK_ROWS --ambient-roots REPORT NAMESPACE
;;   PARTITION LINK_ROWS --ambient-roots-control REPORT
;;   PARTITION LINK_ROWS --outer-control REPORT
;; --all isolates each member. --sequential-scoped keeps the updater's shared
;; staging environment and scopes generated names per member. --sequential
;; retains the historical ambient naming mode for comparison.
(ns native.observe-links
 (:require [native.artifact :as artifact] [js.build :as build] [bl.json :as json]
           [compiler :as compiler] [reader-node :as rn]
           [native.checked-relink :refer [normalized-registry-value value-identity fun-field fun-origin
                   small-env-text? application-setting env-read-result changed-env-reads
                   resolver-result changed-resolver-reads code-location live-code-md5 changed-code-reads
                   install-rows! install-batched-rows! def-bytes bind-core-macro! phase-invoker with-phase-entries
                   registry-input-state presence-snapshot changed-source-probes read-source-identity
                   with-registry-stage lower-with-snapshot prepared-inputs closed-identity
                   registry-row-signature receipt-key-description read-registry-member replay-registry-member
                   refuse-bound-registry qualified-donor authenticated-registry replay-bound-registry]]))

(def trace-limit 100000)
(def registry-trace-limit 1000000)
(def registry-input-limit 16384)
(def source-probe-limit 1000000)
(def source-read-entries [(tuple :Elixir.File :read! 1)
                          (tuple :file :read_file 1) (tuple :prim_file :read_file 1)])
(def source-read-entry-set (set source-read-entries))
(def source-probe-entry (tuple :Elixir.File :regular? 1))
(def macro-entry (tuple :Elixir.BeamLisp.Ns.Compiler :expand-macro 4))
(def macro-lookup-entry (tuple :Elixir.BeamLisp.Ns.Compiler :macro-lookup 2))
(def macro-result-entry (tuple :Elixir.BeamLisp.Ns.Compiler :datum-macro-result 1))
(def link-put-entry (tuple :ets :insert 2))
(def link-delete-entry (tuple :ets :delete 2))
(def registry-operations
 (set (map (fn [[operation arity]] (tuple :ets operation arity))
       [[:lookup 2] [:lookup_element 3] [:lookup_element 4] [:member 2] [:select 2] [:select 3]
        [:match 2] [:match_object 2] [:tab2list 1]
        [:insert 2] [:insert_new 2] [:update_counter 3] [:update_counter 4]
        [:delete 1] [:delete 2] [:delete_object 2] [:delete_all_objects 1]
        [:select_delete 2] [:select_replace 2] [:match_delete 2] [:take 2]])))
(def registry-writes #{:insert :insert_new :update_counter :delete :delete_object
                       :delete_all_objects :select_delete :select_replace :match_delete :take})
(def table-lifecycle-operations #{(tuple :ets :new 2) (tuple :ets :rename 2) (tuple :ets :give_away 3)})
(def registry-lookup-entry (tuple :ets :lookup 2))
(def registry-member-entry (tuple :ets :member 2))
(def env-read-entries #{(tuple :Elixir.BeamLisp.Env :loaded_ns? 1)
                        (tuple :Elixir.BeamLisp.Env :search_paths 0)})
(def runtime-read-entries #{(tuple :Elixir.BeamLisp.Env :op_of 2)
                            (tuple :Elixir.BeamLisp.Env :source_head 0)
                            (tuple :Elixir.BeamLisp.Env :source_target_declaration! 3)
                            (tuple :application_controller :get_env 2)
                            (tuple :application_controller :get_env 3)
                            (tuple :Elixir.File :cwd! 0)
                            (tuple :Elixir.File :dir? 1)
                            (tuple :code :lib_dir 1)
                            (tuple :code :priv_dir 1)
                            (tuple :code :ensure_loaded 1)})
(def env-private-entry (tuple :Elixir.BeamLisp.Env :source_private 1))
(def resolver-read-entries #{(tuple :Elixir.BeamLisp.Loader :source_decls 1)
                             (tuple :Elixir.BeamLisp.Loader :source_path 1)})
(def loader-owner-entries
 (set (map (fn [[name arity]] (tuple :Elixir.BeamLisp.Loader name arity))
           [[:source_decls 1] [:source_path 1] [:resolvable? 1]
            [:find_file 1] [:find_file 2] [:search_dirs 0] [:ambient_dirs 0]])))
(def code-read-entry (tuple :code :is_loaded 1))
(def code-mutation-entries [(tuple :erlang :finish_loading 1)
                            (tuple :erlang :delete_module 1)
                            (tuple :erlang :finish_after_on_load 2)
                            (tuple :erts_internal :purge_module 2)
                            (tuple :erlang :load_nif 2)
                            (tuple :code_server :add_path 6)
                            (tuple :code_server :add_paths 6)
                            (tuple :code_server :set_path 5)
                            (tuple :code_server :del_path 4)
                            (tuple :code_server :del_paths 4)
                            (tuple :code_server :replace_path 6)
                            (tuple :code :clear_cache 0)])

(defn- link-key? [key]
 (and (erlang/is_tuple key) (= 4 (erlang/tuple_size key)) (= :link (elem key 1))))
(def source-extensions (BeamLisp.Loader/doc_extensions))
(defn- source-path [raw]
 (let [path (if (erlang/is_list raw) (unicode/characters_to_binary raw) raw)]
  (when (and (string? path) (<= (erlang/byte_size path) 4096)
             (some #(String/ends_with? path %) source-extensions))
   path)))

(defn- source-result [entry value]
 (let [bytes (if (= entry (first source-read-entries)) value
              (when (and (erlang/is_tuple value) (= (erlang/tuple_size value) 2)
                         (= (elem value 0) :ok))
               (elem value 1)))]
  (if (erlang/is_binary bytes) (artifact/sha bytes) :unavailable)))

(defn- effect [effects kind key]
 (let [n (inc (:count effects 0))]
  (if (> n trace-limit) (assoc effects :count n)
   (-> effects (assoc :count n) (update-in [kind key] (fn [old] (inc (or old 0))))))))

(defn- registry-call [effects operation]
 (let [n (inc (:registry-call-count effects 0))
       effects (assoc effects :registry-call-count n)]
  (if (> n registry-trace-limit) effects
   (update-in effects [:registry-calls operation] (fn [old] (inc (or old 0)))))))

(defn- link-pattern-relation [pattern]
 ;; Installed link objects are {{scope, :link, namespace, name}, info}.
 ;; ETS wildcards and match variables can bind a whole key or its tag.
 (if (and (erlang/is_tuple pattern) (= 2 (erlang/tuple_size pattern)))
  (let [key (elem pattern 0)]
   (cond
    (not (erlang/is_tuple key)) :possible-key
    (not= 4 (erlang/tuple_size key)) [:different-key-arity (erlang/tuple_size key)]
    :else (let [tag (elem key 1)]
            (if (and (erlang/is_atom tag) (not (contains? #{:link :_} tag))
                     (not (String/starts_with? (erlang/atom_to_binary tag) "$")))
             :different-key-tag
             :possible-key-tag))))
  :possible-object))

(defn- disjoint-link-pattern? [relation]
 (or (= :different-key-tag relation)
     (and (vector? relation) (= :different-key-arity (first relation)))))

(defn- process-destination [destination]
 (if (erlang/is_pid destination)
  (let [name (erlang/process_info destination :registered_name)]
   (if (erlang/is_tuple name) (elem name 1) :unregistered))
  (if (erlang/is_atom destination) destination :external-name)))

(defn- message-request [message]
 (if (and (erlang/is_tuple message) (= 3 (erlang/tuple_size message))
          (= :"$gen_call" (elem message 0)))
  (elem message 2)
  message))

(defn- message-operation [request]
 (let [operation (if (and (erlang/is_tuple request) (pos? (erlang/tuple_size request))) (elem request 0) request)]
  (when (erlang/is_atom operation) operation)))

(defn- callback-name [reader]
 (if (erlang/is_function reader)
  [(elem (erlang/fun_info reader :module) 1)
   (elem (erlang/fun_info reader :name) 1)]
  [:unclassified]))

(defn- env-agent-reader [request]
 (if (and (erlang/is_tuple request) (= 2 (erlang/tuple_size request)))
  (callback-name (elem request 1))
  [:unclassified]))

(defn- boundary-event [effects category key]
 (let [total (inc (:boundary-event-count effects 0))
       events (get effects category {})
       effects (assoc effects :boundary-event-count total)]
  (if (and (<= total registry-trace-limit)
           (or (contains? events key) (< (count events) 256)))
   (assoc effects category (update events key (fn [count] (inc (or count 0)))))
   (assoc effects :boundary-event-limit true))))

(defn- other-table-event [effects operation arguments]
 (let [table (first arguments)
       name (if (erlang/is_atom table) table :anonymous-table)
       observed (boundary-event effects :other-tables [operation name])]
  (if (:ownership? effects)
   (let [[owner] (peek (:pending-env-reads effects))]
    (cond-> (boundary-event observed :table-read-owners
             [operation name (cond owner (elem owner 1)
                              (contains? effects :pending-code-read) :is_loaded
                              :else :outside-observed-api)])
     (and (= :lookup operation) (= :beam_lisp_source_extent_heads name))
     (boundary-event :extent-read-kinds
      (let [key (second arguments)]
       (cond
        (erlang/is_atom key) key
        (erlang/is_pid key) :process
        (and (erlang/is_tuple key) (pos? (erlang/tuple_size key)) (erlang/is_atom (elem key 0)))
        [(elem key 0) (erlang/tuple_size key)]
        :else :unknown)))))
   observed)))

(defn- process-event [effects kind message target sources]
 (let [destination (process-destination target)
       request (message-request message)
       operation (message-operation request)
       observed (boundary-event effects :process-boundary [kind destination operation])]
  (cond
   (and (= :send kind) (= :Elixir.BeamLisp.Env destination) (= :get operation))
   (let [reader (env-agent-reader request)
         observed (boundary-event observed :env-agent-readers reader)]
    (if (:ownership? effects)
     (boundary-event observed :env-read-owners
      [reader (or (peek (:pending-private-env effects))
                  (when-let [[entry _] (peek (:pending-env-reads effects))] [(elem entry 1)])
                  [:outside-observed-api])])
     observed))
   (and (:ownership? effects) (= :send kind) (= :file_server_2 destination))
   (let [parents (:pending-loader-owners effects)
         frame (fn [entry] (if entry [(elem entry 1) (elem entry 2)] [:outside-observed-api]))
         [runtime-owner] (peek (:pending-env-reads effects))
         [source-owner path] (peek sources)
         owner (if (and source-owner path) source-owner runtime-owner)]
    (-> observed
        (boundary-event :file-read-owners [operation (frame (first parents)) (frame (peek parents))])
        (boundary-event :file-server-read-owners [operation (when owner (elem owner 1))])))
   (and (:ownership? effects) (= :send kind) (= :code_server destination))
   (let [rpc (when (and (= :code_call operation) (erlang/is_tuple request)
                        (= 3 (erlang/tuple_size request))) (elem request 2))
         outer (first (:pending-loader-owners effects))
         [owner] (peek (:pending-env-reads effects))]
    (-> observed
        (boundary-event :code-server-owners [(message-operation rpc) (when outer (elem outer 1))])
        (boundary-event :code-server-read-owners [(message-operation rpc) (when owner (elem owner 1))])))
   :else observed)))

(defn- record-source-probe [effects path outcome]
 (let [n (inc (:source-probe-count effects 0))
       effects (assoc effects :source-probe-count n)]
  (if (> n source-probe-limit) effects
   (update effects :source-probes (fn [seen] (conj (or seen #{}) [path outcome]))))))

(defn- registry-key-shape [key]
 (cond
  (erlang/is_atom key) [:atom key]
  (erlang/is_tuple key)
  (let [head (elem key 0)
        kind (cond
              (erlang/is_atom head) head
              (erlang/is_tuple head) :environment
              :else :other)
        second (when (> (erlang/tuple_size key) 1) (elem key 1))]
   [:tuple (erlang/tuple_size key) kind
    (cond (erlang/is_atom second) second (erlang/is_pid second) :pid :else :data)])
  :else [:other]))

(defn- note-input-shape [effects field operation key]
 (let [shapes (get effects field {})
       shape [operation (registry-key-shape key)]]
  (if (or (contains? shapes shape) (< (count shapes) 64))
   (assoc effects field (update shapes shape (fn [n] (inc (or n 0)))))
   (assoc effects :truncated-registry-shapes true))))

(defn- sdk-registry-key? [key]
 (or (= :bl_code_evidence_generation key)
     (and (erlang/is_tuple key) (= 2 (erlang/tuple_size key))
          (= :bl_sdk_emission (elem key 0)) (erlang/is_atom (elem key 1)))))

(defn- registry-input-key [effects operation key]
 (let [scope (when (and (erlang/is_tuple key) (pos? (erlang/tuple_size key))) (elem key 0))
       slot (if (= scope (:scope effects)) :own (get (:ancestor-slots effects) scope))]
  (cond
   (some? slot) [operation slot (erlang/delete_element 1 key)]
   (sdk-registry-key? key) [operation :sdk key])))

(defn- record-changing-input [effects operation key prior outcome]
 (let [next (note-input-shape (assoc effects :changing-registry-input true) :changing-registry-shapes operation key)]
  (if (and (= :lookup operation) (erlang/is_tuple key) (= 4 (erlang/tuple_size key))
           (= :meta (elem key 1)))
   (let [a (first prior) b (first outcome)
         a (when a (elem a 0)) b (when b (elem b 0))
         fields (if (and (map? a) (map? b))
                   (vec (sort (filter (fn [field] (not= (find a field) (find b field)))
                                     (into (set (keys a)) (keys b)))))
                   [:row-shape])
         changes (:changing-metadata next #{})]
    (assoc next :changing-metadata (if (< (count changes) 64)
                                   (conj changes [(elem key 2) (elem key 3) fields]) changes)))
   next)))

(defn- record-registry-input [effects operation key value]
 (let [input (registry-input-key effects operation key)
       inputs (:registry-inputs effects {})]
  (cond
   (nil? input) (note-input-shape (assoc effects :unexplained-registry-scope true) :unknown-registry-shapes operation key)
   :else
   (let [prior (find inputs input)
         outcome (normalized-registry-value operation value)]
    (cond
     prior (if (erlang/=:= (val prior) outcome) effects
            (record-changing-input effects operation key (val prior) outcome))
     (< (count inputs) registry-input-limit) (assoc effects :registry-inputs (assoc inputs input outcome))
     :else (assoc effects :registry-input-limit true))))))

(defn- macro-origin [callable]
 (cond
  (erlang/is_function callable) {:shape :beam-function :entries [(fun-origin callable)]}
  (and (erlang/is_tuple callable) (= 3 (erlang/tuple_size callable)) (= :"$blfn" (elem callable 0)))
  (let [entries (vals (elem callable 1)) variadic (elem callable 2)
        entries (if variadic (cons (elem variadic 1) entries) entries)]
   (if (every? erlang/is_function entries)
    {:shape :multi-function :entries (vec (sort (map fun-origin entries)))}
    {:shape :opaque}))
  :else {:shape :opaque}))

(defn- record-macro [effects ns head callable]
 (let [cached (get-in effects [:macro-origins callable])
       origin (or cached (macro-origin callable))
       next (effect effects :expansions [ns head])]
  (if (>= (:count next) trace-limit) next
   (-> next (assoc-in [:macro-origins callable] origin)
       (update-in [:macro-bindings [ns head]] (fn [known] (conj (or known #{}) origin)))))))

(defn- macro-route [effects callable]
 (if (nil? callable) :miss
  (if-let [name (get (:phase-callables effects) callable)] [:interpreted name] :fallback)))

(defn- record-macro-lookup [effects callable]
 (let [[ns name] (peek (:pending-macro-lookups effects))
       n (inc (:macro-lookup-count effects 0))
       effects (-> effects (update :pending-macro-lookups pop) (assoc :macro-lookup-count n))]
  (if (> n trace-limit) effects
   (update effects :macro-lookups (fn [events] (conj (or events []) [ns name (macro-route effects callable)]))))))

(defn- start-macro-sample [effects [callable form args env] head]
 (let [key [(:ns env) head (get-in effects [:macro-origins callable])]
       samples (:macro-samples effects {})
       sample (when-not (or (contains? samples key) (>= (count samples) 32))
                {:key key :form form :args args :locals (keys (:locals env))})]
  (-> effects
      (update :macro-stack (fn [stack] (conj (or stack []) sample)))
      (cond-> (and (nil? sample) (not (contains? samples key))) (assoc :sample-limit true)))))

(defn- record-macro-sample [effects value]
 (if-let [{:keys [key] :as sample} (peek (:macro-stack effects))]
  (if (contains? (get-in effects [:macro-samples key] {}) :outcome)
   effects
   (assoc-in effects [:macro-samples key] (assoc (dissoc sample :key) :outcome value)))
  effects))

(defn- record-link [effects op key value]
 (let [events (:ordered-links effects []) scope (elem key 0) member [(elem key 2) (elem key 3)]]
  (cond
   (not= scope (:scope effects))
   (let [ancestor (get-in effects [:ancestor-slots scope])
         next (update effects :outside-links (fn [n] (inc (or n 0))))]
    (if (and (= op :read) ancestor)
     (update next :ancestor-reads (fn [reads] (conj (or reads #{}) [ancestor member value])))
     (assoc next :unexplained-scope true)))
   (>= (count events) (inc trace-limit)) effects
   :else (assoc effects :ordered-links (conj events [op member value])))))

(defn- start-env-read [effects entry arguments]
 (let [function (elem entry 1)
       argument (first arguments)
       key (case function
            :loaded_ns? (when (small-env-text? argument) [function argument])
            :search_paths [function]
            :source_head [function]
            :cwd! [function]
            :dir? (when (small-env-text? argument) [function argument])
            :source_target_declaration! (let [[module name arity] arguments]
                                          (when (and (erlang/is_atom module) (erlang/is_atom name)
                                                     (int? arity) (<= 0 arity 255))
                                           [function module name arity]))
            :lib_dir (when (erlang/is_atom argument) [function argument])
            :priv_dir (when (erlang/is_atom argument) [function argument])
            :ensure_loaded (when (erlang/is_atom argument) [function argument])
            :op_of (when (every? erlang/is_atom arguments) (into [function] arguments))
            :get_env (let [name (second arguments)]
                       (when (and (erlang/is_atom argument) (erlang/is_atom name))
                        [:application-setting argument name])))]
  (update effects :pending-env-reads
   (fn [stack] (conj (or stack []) [entry key (when (= :get_env function) (nth arguments 2 nil))])))))

(defn- finish-env-read [effects entry kind value]
 (let [[expected key default] (peek (:pending-env-reads effects))
       reads (:env-reads effects {})
       outcome (when (and key (= kind :return_from))
                 (if (= entry (tuple :application_controller :get_env 3))
                  ;; A fresh opaque default (as used by Application) is not
                  ;; an input. Confirm this apparent miss via get_env/2
                  ;; before persisting an application key.
                  (if (erlang/=:= default value) :missing-application-setting (application-setting value))
                  (env-read-result key value)))
       total (inc (:env-read-count effects 0))
       rejected (or (nil? key) (nil? outcome) (= :unavailable outcome))]
  (when-not (= entry expected) (throw (ex-info "Unexpected Env read return" {:entry entry :expected expected})))
  (cond-> (-> effects (update :pending-env-reads pop) (assoc :env-read-count total))
   rejected (assoc :unknown-env-read true)
   (and rejected (:ownership? effects))
   (boundary-event :rejected-env-reads
    [(elem entry 1) key (cond
                        (not= kind :return_from) :exception
                        (nil? key) :unsupported-arguments
                        (erlang/is_tuple value) [:tuple (erlang/tuple_size value)]
                        (erlang/is_map value) :map
                        (erlang/is_list value) :list
                        :else :other-value)])
   (and key (contains? reads key) (not= outcome (get reads key))) (assoc :unstable-env-read true)
   (and key (<= total registry-trace-limit) (< (count reads) registry-input-limit))
   (assoc-in [:env-reads key] outcome))))

(defn- start-loader-read [effects entry argument]
 (cond-> effects
  (:ownership? effects)
  (update :pending-loader-owners (fn [stack] (conj (or stack []) entry)))
  (and (:resolver-reads? effects) (contains? resolver-read-entries entry))
  (update :pending-resolver-reads
   (fn [stack] (conj (or stack []) [entry (when (small-env-text? argument) [(elem entry 1) argument])])))))

(defn- finish-loader-read [effects entry kind value]
 (when (:ownership? effects)
  (assert (= entry (peek (:pending-loader-owners effects)))))
 (let [effects (cond-> effects (:ownership? effects) (update :pending-loader-owners pop))]
  (if (and (:resolver-reads? effects) (contains? resolver-read-entries entry))
   (let [[expected key] (peek (:pending-resolver-reads effects))
         reads (:resolver-reads effects {})
         outcome (if (= kind :return_from) (resolver-result (elem entry 1) value) :unavailable)
         total (inc (:resolver-read-count effects 0))]
    (assert (= entry expected))
    (cond-> (-> effects (update :pending-resolver-reads pop) (assoc :resolver-read-count total))
     (or (nil? key) (= :unavailable outcome)) (assoc :unknown-resolver-read true)
     (and key (contains? reads key) (not= outcome (get reads key))) (assoc :unstable-resolver-read true)
     (and key (<= total registry-trace-limit) (< (count reads) registry-input-limit))
     (assoc-in [:resolver-reads key] outcome)))
   effects)))

(defn- resolver-receipt [effects]
 (into {} (map (fn [[key outcome]] [key (value-identity outcome)]) (:resolver-reads effects))))

(defn- code-snapshot []
 (into {} (map (fn [row]
                 (let [module (elem row 0)]
                  [module [(code-location (tuple :file (elem row 1))) (live-code-md5 module)]]))
               (code/all_loaded))))

(defn- with-code-mutation-observation [action]
 ;; These counters cover calls on the VM, including code_server and the code
 ;; purger. Use counters so the tracer never receives compiled binaries.
 (let [session (erlang/apply :trace :session_create (list :native_code_mutations (erlang/self) (list)))
       flags (list :call_count)]
  (try
   (doseq [entry code-mutation-entries]
    (assert (= 1 (erlang/apply :trace :function (list session entry true flags)))))
   (let [result (action)]
    (doseq [entry code-mutation-entries]
     (assert (= 1 (erlang/apply :trace :function (list session entry :pause flags)))))
    [result (into {} (keep (fn [entry]
                            (let [info (erlang/apply :trace :info (list session entry :call_count))
                                  calls (elem info 1)]
                             (assert (and (= :call_count (elem info 0)) (int? calls)))
                             (when (pos? calls) [entry calls])))
                          code-mutation-entries))])
   (finally (erlang/apply :trace :session_destroy (list session))))))

(defn- captured-code-reads [before observed after]
 (into {} (map (fn [[module location]]
                 (let [[prior md5 :as initial] (get before module [false nil])
                       final (get after module [false nil])]
                  [module (cond
                            (or (not= prior location) (not= initial final) (= location :unavailable)) :unavailable
                            (false? location) (if (= :non_existing (code/which module))
                                               [false nil :non_existing] :unavailable)
                            (and (erlang/is_binary md5) (= 16 (erlang/byte_size md5))) initial
                            :else :unavailable)]))
               observed)))

(defn- observed-code-modules [effects after]
 (reduce (fn [observed [[function module] outcome]]
           (if (= :ensure_loaded function)
            (let [location (if (= :loaded-module outcome) (first (get after module)) false)]
             (if (and (some? location) (or (not (contains? observed module)) (= location (get observed module))))
              (assoc observed module location)
              (assoc observed module :unavailable)))
            observed))
         (:code-reads effects {}) (:env-reads effects)))

(defn- finish-code-read [effects kind value]
 (let [module (:pending-code-read effects)
       reads (:code-reads effects {})
       location (if (= kind :return_from) (code-location value) :unavailable)
       total (inc (:code-read-count effects 0))]
  (cond-> (-> effects (dissoc :pending-code-read) (assoc :code-read-count total))
   (or (not (erlang/is_atom module)) (= location :unavailable)) (assoc :unknown-code-read true)
   (and (contains? reads module) (not= location (get reads module))) (assoc :unstable-code-read true)
   (and (erlang/is_atom module) (<= total registry-trace-limit) (< (count reads) registry-input-limit))
   (assoc-in [:code-reads module] location))))

(defn- collector [calls pending hits misses reads sources effects]
 (receive
  [:trace _ :call [:ets :lookup arguments]]
  (if (= :beam_lisp_vars (first arguments))
   (recur calls (second arguments) hits misses reads sources
    (if (:registry? effects) (registry-call effects [:lookup 2]) effects))
   (recur calls pending hits misses reads sources (other-table-event effects :lookup arguments)))
  [:trace _ :return_from [:ets :lookup 2] value]
  (let [effects (if (:registry-inputs? effects) (record-registry-input effects :lookup pending value) effects)]
  (if-not (link-key? pending) (recur calls nil hits misses reads sources effects)
  (if (>= calls trace-limit) (recur (inc calls) nil hits misses reads sources effects)
   (let [key [(elem pending 2) (elem pending 3)]
         outcome (when-not (empty? value) (value-identity (elem (first value) 1)))
         next-effects (record-link effects :read pending outcome)]
    (if outcome
     (recur (inc calls) nil (conj hits key) misses reads sources next-effects)
     (recur (inc calls) nil hits (conj misses key) reads sources next-effects))))))
  [:trace _ :return_from [:ets :member 2] value]
  (let [key (:pending-registry-member effects)]
   (recur calls pending hits misses reads sources
    (record-registry-input (dissoc effects :pending-registry-member) :member key value)))
  [:trace _ :return_from [:Elixir.BeamLisp.Ns.Compiler :expand-macro 4] _]
  (recur calls pending hits misses reads sources (update effects :macro-stack pop))
  [:trace _ :return_from [:Elixir.BeamLisp.Ns.Compiler :macro-lookup 2] callable]
  (recur calls pending hits misses reads sources (record-macro-lookup effects callable))
  [:trace _ kind [:Elixir.BeamLisp.Env :source_private 1] _]
  :when (or (= kind :return_from) (= kind :exception_from))
  (recur calls pending hits misses reads sources (update effects :pending-private-env pop))
  [:trace _ kind [:Elixir.BeamLisp.Env function arity] value]
  :when (or (= kind :return_from) (= kind :exception_from))
  (recur calls pending hits misses reads sources
   (finish-env-read effects (tuple :Elixir.BeamLisp.Env function arity) kind value))
  [:trace _ kind [:application_controller :get_env arity] value]
  :when (or (= kind :return_from) (= kind :exception_from))
  (recur calls pending hits misses reads sources
   (finish-env-read effects (tuple :application_controller :get_env arity) kind value))
  [:trace _ kind [:Elixir.BeamLisp.Loader function arity] value]
  :when (or (= kind :return_from) (= kind :exception_from))
  (recur calls pending hits misses reads sources
   (finish-loader-read effects (tuple :Elixir.BeamLisp.Loader function arity) kind value))
  [:trace _ kind [:code :is_loaded 1] value]
  :when (or (= kind :return_from) (= kind :exception_from))
  (recur calls pending hits misses reads sources (finish-code-read effects kind value))
  [:trace _ kind [:code function 1] value]
  :when (or (= kind :return_from) (= kind :exception_from))
  (recur calls pending hits misses reads sources
   (finish-env-read effects (tuple :code function 1) kind value))
  [:trace _ kind [:Elixir.File function arity] value]
  :when (and (or (= function :cwd!) (= function :dir?))
             (or (= kind :return_from) (= kind :exception_from)))
  (recur calls pending hits misses reads sources
   (finish-env-read effects (tuple :Elixir.File function arity) kind value))
  [:trace _ :send message target]
  (recur calls pending hits misses reads sources (process-event effects :send message target reads))
  [:trace _ :send_to_non_existing_process message target]
  (recur calls pending hits misses reads sources (process-event effects :send-miss message target reads))
  [:trace _ :spawn _ _]
  (recur calls pending hits misses reads sources (boundary-event effects :process-boundary [:spawn]))
  [:trace _ kind _] :when (or (= kind :link) (= kind :unlink) (= kind :getting_linked) (= kind :getting_unlinked)
                             (= kind :register) (= kind :unregister) (= kind :exit))
  (recur calls pending hits misses reads sources (boundary-event effects :process-boundary [kind]))
  [:trace _ :call [module function arguments]]
  (let [arity (count arguments) entry (tuple module function arity) key (first arguments)
        effects (if (and (:registry? effects) (contains? registry-operations entry) (= :beam_lisp_vars key))
                   (cond-> (registry-call effects [function arity])
                    (and (:link-scan-patterns? effects) (= :match_object function) (= 2 arity))
                    (boundary-event :link-scan-patterns (link-pattern-relation (second arguments))))
                   effects)]
   (cond
    (or (contains? env-read-entries entry) (contains? runtime-read-entries entry))
    (recur calls pending hits misses reads sources (start-env-read effects entry arguments))
    (= entry env-private-entry)
    (recur calls pending hits misses reads sources
     (update effects :pending-private-env (fn [stack] (conj (or stack []) (callback-name key)))))
    (contains? loader-owner-entries entry)
    (recur calls pending hits misses reads sources (start-loader-read effects entry key))
    (= entry code-read-entry)
    (recur calls pending hits misses reads sources (assoc effects :pending-code-read key))
    (and (:boundary? effects) (or (contains? table-lifecycle-operations entry)
                                (and (contains? registry-operations entry) (not= :beam_lisp_vars key))))
    (recur calls pending hits misses reads sources (other-table-event effects function arguments))
    (= entry macro-entry)
    (let [head (rn/node-name (first (rn/node-items (second arguments)))) env (nth arguments 3)
          next-effects (record-macro effects (:ns env) head key)
          next-effects (if (:macro-lookups? effects)
                         (effect next-effects :macro-routes [(:ns env) head (macro-route effects key)])
                         next-effects)]
     (recur calls pending hits misses reads sources
      (if (:sample-macros? effects) (start-macro-sample next-effects arguments head) next-effects)))
    (= entry macro-result-entry)
    (recur calls pending hits misses reads sources (record-macro-sample effects key))
    (= entry macro-lookup-entry)
    (recur calls pending hits misses reads sources
     (update effects :pending-macro-lookups (fn [stack] (conj (or stack []) (vec arguments)))))
    (and (:registry-inputs? effects) (= entry registry-member-entry))
    (recur calls pending hits misses reads sources (assoc effects :pending-registry-member (second arguments)))
    (or (= entry link-put-entry) (= entry link-delete-entry))
    (let [writing? (= entry link-put-entry) row (second arguments)
          key (if (and writing? (erlang/is_tuple row)) (elem row 0) row)]
     (recur calls pending hits misses reads sources
      (if (link-key? key)
       (let [outcome (when writing? (value-identity (elem row 1))) kind (if writing? :link-writes :link-deletions)]
        (-> effects (effect kind [(elem key 2) (elem key 3)]) (record-link :write key outcome)))
       effects)))
    (and (:registry? effects) (contains? registry-operations entry))
    (recur calls pending hits misses reads sources effects)
    (or (contains? source-read-entry-set entry) (= entry source-probe-entry))
    (recur calls pending hits misses (conj reads [entry (source-path key)]) sources effects)
    :else (throw (ex-info "Unexpected native observation call" {:entry entry}))))
  [:trace _ kind [module function 1] value] :when (or (= kind :return_from) (= kind :exception_from))
  (let [[entry path] (peek reads)]
   (when-not (= entry (tuple module function 1))
    (throw (ex-info "Unexpected Source read return"
             {:module module :function function :pending-entry entry})))
   (if (= entry source-probe-entry)
    (recur calls pending hits misses (pop reads) sources
     (if path (record-source-probe effects path (if (= kind :return_from) value :unavailable)) effects))
    (recur calls pending hits misses (pop reads)
     (if (and path (< (count sources) 1025))
      (conj sources [path (if (= kind :return_from) (source-result entry value) :unavailable)])
      sources) effects)))
  [:finish parent ticket]
  (erlang/send parent [:observed ticket
    {:calls calls :hits hits :misses misses :sources sources :effects effects
     :complete? (and (nil? pending) (empty? reads) (empty? (:macro-stack effects)) (<= calls trace-limit)
                    (nil? (:pending-registry-member effects)) (not (:registry-input-limit effects))
                    (not (:boundary-event-limit effects))
                    (empty? (:pending-loader-owners effects)) (empty? (:pending-private-env effects))
                    (empty? (:pending-resolver-reads effects)) (< (count (:resolver-reads effects)) registry-input-limit)
                    (<= (:resolver-read-count effects 0) registry-trace-limit)
                    (empty? (:pending-env-reads effects)) (< (count (:env-reads effects)) registry-input-limit)
                    (<= (:env-read-count effects 0) registry-trace-limit)
                    (not (contains? effects :pending-code-read)) (< (count (:code-reads effects)) registry-input-limit)
                    (<= (:code-read-count effects 0) registry-trace-limit)
                    (empty? (:pending-macro-lookups effects)) (<= (:macro-lookup-count effects 0) trace-limit)
                    (<= (:registry-call-count effects 0) registry-trace-limit)
                    (<= (:source-probe-count effects 0) source-probe-limit)
                    (<= (count (:ordered-links effects [])) trace-limit)
                    (<= (:count effects 0) trace-limit) (<= (count sources) 1024))}])))

(defn- registry-trace-spec [arity result? boundary?]
 (let [args (apply list (repeat (dec arity) :_))
       scoped (tuple (cons :beam_lisp_vars args) (list) (if result? (list (tuple :return_trace)) (list)))]
  (if boundary? (list scoped (tuple (cons :_ args) (list) (list))) (list scoped))))

(defn- trace!
 ([action] (trace! action {}))
 ([action options]
 (let [owner (erlang/self) scope (BeamLisp.Env/env_id)
       sample-macros? (Process/get :native_phase_macro_samples false)
       ancestors (into {} (map-indexed (fn [index id] [id index]) (rest (BeamLisp.Env/chain))))
       observer (spawn (fn [] (collector 0 nil #{} #{} [] #{}
                               (assoc options :scope scope :ancestor-slots ancestors :sample-macros? sample-macros?))))
       session (erlang/apply :trace :session_create (list :native_link_observation observer (list)))
       match (if (:registry? options)
               (registry-trace-spec 2 true (:boundary? options))
               (list (tuple (list :beam_lisp_vars (tuple :_ :link :_ :_)) (list) (list (tuple :return_trace)))))
       source-match (list (tuple (list :_) (list) (list (tuple :exception_trace))))
       link-key (tuple :_ :link :_ :_)
       returns (list (tuple :_ (list) (list (tuple :return_trace))))
       flags (if (:boundary? options) (list :call :send :procs) (list :call))]
  (try
   (assert (= 1 (erlang/apply :trace :function
                  (list session registry-lookup-entry match (list :local)))) "could not trace registry lookup")
   (doseq [entry (cond-> source-read-entries (:source-probes? options) (conj source-probe-entry))]
    (assert (= 1 (erlang/apply :trace :function (list session entry source-match (list :local))))
            (str "could not trace Source read " (pr-str entry))))
   (doseq [entry (cond-> (if (:env-reads? options) env-read-entries #{})
                  (:runtime-reads? options) (into runtime-read-entries)
                  (:code-reads? options) (conj code-read-entry)
                  (:resolver-reads? options) (into resolver-read-entries)
                  (:ownership? options) (into (conj loader-owner-entries env-private-entry)))]
    (let [matched (erlang/apply :trace :function
                    (list session entry (list (tuple :_ (list) (list (tuple :exception_trace)))) (list :local)))]
     (when-not (= 1 matched)
      (throw (ex-info (str "Native observation could not install owner trace " (pr-str entry))
                       {:entry entry :matched matched})))))
   (when sample-macros?
    (assert (= 1 (erlang/apply :trace :function (list session macro-result-entry true (list :local))))))
   (when (:macro-lookups? options)
    (assert (= 1 (erlang/apply :trace :function (list session macro-lookup-entry returns (list :local))))
            "could not trace macro lookup"))
   (assert (= 1 (erlang/apply :trace :function
                 (list session macro-entry (if sample-macros? returns true) (list :local)))) "could not trace macro expansion")
   (doseq [[entry spec] (if (:registry? options)
                         (map (fn [entry]
                                [entry (registry-trace-spec (elem entry 2)
                                         (and (:registry-inputs? options) (= entry registry-member-entry))
                                         (:boundary? options))])
                              (if (:boundary? options)
                               (into (disj registry-operations registry-lookup-entry) table-lifecycle-operations)
                               (disj registry-operations registry-lookup-entry)))
                         [[link-put-entry (list (tuple (list :beam_lisp_vars (tuple link-key :_)) (list) (list)))]
                          [link-delete-entry (list (tuple (list :beam_lisp_vars link-key) (list) (list)))]])]
    (let [matched (erlang/apply :trace :function (list session entry spec (list :local)))]
     (when-not (= 1 matched)
      (throw (ex-info (str "Native observation could not install trace " (pr-str entry))
                       {:entry entry :matched matched})))))
   (assert (= 1 (erlang/apply :trace :process (list session owner true flags))) "could not start owner trace")
   (let [result (action)
         _ (when (:boundary? options)
             (assert (= 1 (erlang/apply :trace :process (list session owner false flags))) "could not stop owner trace"))
         barrier (erlang/apply :trace :delivered (list session owner))
         ticket (erlang/make_ref)]
    (receive [:trace_delivered seen ref] :when (and (= seen owner) (= ref barrier))
      :ready (after 10000 (throw :trace-delivery-timeout)))
    (erlang/send observer [:finish owner ticket])
    (let [observation (receive [:observed ref value] :when (= ref ticket)
                       value (after 10000 (throw :trace-collector-timeout)))]
     (when-not (:complete? observation)
      (let [details {:link-lookups (:calls observation) :source-reads (count (:sources observation))
                     :effects (get-in observation [:effects :count])
                     :macro-lookups (get-in observation [:effects :macro-lookup-count])
                     :registry-calls (get-in observation [:effects :registry-call-count])
                     :source-probes (get-in observation [:effects :source-probe-count])}]
       (throw (ex-info (str "Native observation exceeded its bounds or returned a partial trace " (pr-str details))
                       details))))
     [result observation]))
   (finally
    (erlang/apply :trace :session_destroy (list session))
    (Process/exit observer :kill))))))

(defn- read-rows [path]
 (let [text (File/read! path)]
  (BeamLisp.CompilerData/check_closed_etf! text artifact/limits)
  {:sha256 (artifact/sha text) :rows (erlang/binary_to_term text)}))

(defn- installed-rows [rows]
 (into {} (map (fn [[ns name info private?]] [[ns name] [info private?]]) rows)))

(defn- local-links [closure rows]
 ;; Core rows shadow the ordinary member rows, just as in install-rows!.
 (into (into {} (map (fn [[ns name info _]] [[ns name] (value-identity info)]) rows))
       (map (fn [[name info]] [["core" name] (value-identity info)]) (:core-links closure))))

(defn- replay-links [observation initial]
 ;; This validates only traced reads of the closure's own link registry.
 ;; The entire compiler and its macro effects require broader provenance.
 (loop [state initial events (seq (get-in observation [:effects :ordered-links]))]
  (if-let [[op key outcome] (first events)]
   (if (= op :read)
    (if (= outcome (get state key)) (recur state (next events))
     {:accepted false :different-read key})
    (recur (if outcome (assoc state key outcome) (dissoc state key)) (next events)))
   {:accepted true})))

(defn- link-receipt [observation]
 ;; Once a link has been written by this unit, subsequent reads depend on
 ;; that write. Keep the reads before the first write and the last write.
 (reduce (fn [receipt [op key outcome]]
           (if (= op :write)
            (assoc-in receipt [:writes key] outcome)
            (if (contains? (:writes receipt) key) receipt
             (assoc-in receipt [:reads key] outcome))))
  {:reads {} :writes {}} (get-in observation [:effects :ordered-links] [])))

(defn- receipt-matches? [receipt initial]
 (every? (fn [[key outcome]] (= outcome (get initial key))) (:reads receipt)))

(defn- link-consumers [members]
 (reduce (fn [index [member _ receipt _]]
           (reduce (fn [out key]
                     (update out key (fn [names] (conj (or names #{}) (:ns member)))))
                   index (keys (:reads receipt))))
         {} members))

(defn- changed-links [baseline candidate]
 (let [edits (reduce-kv (fn [keys key outcome]
                          (if (= outcome (get baseline key)) keys (conj keys key))) [] candidate)]
  (reduce-kv (fn [keys key _]
               (if (contains? candidate key) keys (conj keys key))) edits baseline)))

(defn- affected-members [consumers changed]
 (reduce (fn [members key] (into members (get consumers key #{}))) #{} changed))

(defn- directly-invalidated [members candidate]
 (reduce (fn [selected [member _ receipt _]]
           (if (receipt-matches? receipt candidate) selected (conj selected (:ns member))))
         #{} members))

(defn- compare-selection [members candidate consumers changed expected]
 (let [samples (mapv (fn [_]
                       (let [start (erlang/monotonic_time :microsecond)
                             indexed (affected-members consumers changed)
                             selected (erlang/monotonic_time :microsecond)
                             direct (directly-invalidated members candidate)
                             checked (erlang/monotonic_time :microsecond)]
                        (assert (= expected indexed direct))
                        [(- selected start) (- checked selected)])) (range 11))]
  {:repetitions (count samples) :indexed-median-us (nth (sort (map first samples)) 5)
   :direct-median-us (nth (sort (map second samples)) 5)}))

(defn- ancestor-outcome [chain [index [ns name]]]
 (if-let [scope (nth chain index nil)]
  (let [rows (ets/lookup :beam_lisp_vars (BeamLisp.Env/pfx scope (tuple :link ns name)))]
   (when (seq rows) (value-identity (elem (first rows) 1))))
  :unavailable))

(defn- ancestor-snapshot [receipts]
 (let [chain (vec (BeamLisp.Env/chain))
       keys (distinct (mapcat (fn [receipt]
                               (map (fn [[index member _]] [index member]) (:ancestor-reads receipt))) receipts))]
  (into {} (map (fn [key] [key (ancestor-outcome chain key)]) keys))))

(defn- ancestor-matches? [receipt snapshot]
 (and (not (:unexplained-scope receipt))
      (every? (fn [[index member outcome]] (= outcome (get snapshot [index member] :unavailable)))
              (:ancestor-reads receipt))))

(defn- scope-receipt [observation]
 {:ancestor-reads (vec (sort (get-in observation [:effects :ancestor-reads])))
  :unexplained-scope (boolean (get-in observation [:effects :unexplained-scope]))})

(defn- outer-control []
 (BeamLisp.Env/isolated
  (fn []
   (let [ns "native.ancestor-write-control" name "target" qualified (str ns "/" name)
         initial (tuple :Elixir.BeamLisp.Ns.Compiler {} nil)
         later (tuple :Elixir.BeamLisp.Env {} nil)
         _ (BeamLisp.Env/put_link ns name initial)
         [seen observation] (BeamLisp.Env/isolated (fn [] (trace! (fn [] (BeamLisp.Env/link ns qualified)))))
         receipt (scope-receipt observation)]
    (assert (= (tuple :ok initial) seen))
    (assert (= [[0 [ns name] (value-identity initial)]] (:ancestor-reads receipt)))
    (assert (ancestor-matches? receipt (ancestor-snapshot [receipt])))
    (BeamLisp.Env/put_link ns name later)
    (assert (not (ancestor-matches? receipt (ancestor-snapshot [receipt]))))
    {:schema "bl.native.link-ancestor-control" :version 1
     :verified-ancestor-reads (count (:ancestor-reads receipt)) :changed-parent-row-refused true}))))

(defn- ordered-report [observation]
 (let [{:keys [reads writes]} (link-receipt observation)]
  {:local-operations (count (get-in observation [:effects :ordered-links] []))
   :outside-operations (get-in observation [:effects :outside-links] 0)
   :local-operation-sha256 (value-identity (get-in observation [:effects :ordered-links] []))
   :external-read-keys (count reads) :final-write-keys (count writes)}))

(defn- write-control []
 (BeamLisp.Env/isolated
  (fn []
   (let [ns "native.link-write-control" member "target" key [ns member] qualified (str ns "/" member)
         info (tuple :Elixir.BeamLisp.Ns.Compiler {} nil)
         [result observation]
         (trace! (fn []
                   (let [before (BeamLisp.Env/link ns qualified)]
                    (BeamLisp.Env/put_link ns member info)
                    (let [present (BeamLisp.Env/link ns qualified)]
                     (BeamLisp.Env/delete_key (tuple :link ns member))
                     [before present (BeamLisp.Env/link ns qualified)]))))
         fingerprint (value-identity info)
         events (get-in observation [:effects :ordered-links])
         different {key (value-identity (tuple :Elixir.BeamLisp.Env {} nil))}
         overwritten (assoc-in observation [:effects :ordered-links] (subvec events 1))]
    (assert (= [:error (tuple :ok info) :error] result))
    (assert (= [[:read key nil] [:write key fingerprint] [:read key fingerprint]
                [:write key nil] [:read key nil]] events))
    (assert (:accepted (replay-links observation {})))
    (assert (= key (:different-read (replay-links observation different))))
    (assert (:accepted (replay-links overwritten different)))
    (assert (receipt-matches? (link-receipt observation) {}))
    (assert (not (receipt-matches? (link-receipt observation) different)))
    (assert (receipt-matches? (link-receipt overwritten) different))
    {:schema "bl.native.link-order-write-control" :version 1 :events events
     :changed-value-refused-before-write true :changed-value-accepted-after-write true}))))

(defn- compile-staged
 ([member] (compile-staged member {}))
 ([member options]
  (trace! (fn [] (build/compile-prepared (build/prepare-ns (:path member)) {:check-node identity})) options)))

(defn- compile-member
 ([closure member rows] (compile-member closure member rows {}))
 ([closure member rows options]
  (BeamLisp.Env/isolated
   (fn []
    (install-rows! closure rows)
    (BeamLisp.Compiler/with_fresh_names (fn [] (compile-staged member options)))))))

(defn- macro-context-control [closure baseline]
 (let [path "research/native-seed/speed/front/macro-context-fixture.bl"
       compile-under (fn [value]
                        (Process/put :native_relink_context_fixture value)
                        (compile-member closure {:path path} (:rows baseline)))
       [left left-observation] (compile-under 1)
       [right right-observation] (compile-under 2)
       same-links? (= (link-receipt left-observation) (link-receipt right-observation))
       same-source? (= (:source-sha256 left) (:source-sha256 right))
       same-files? (= (:sources left-observation) (:sources right-observation))
       same-anf? (erlang/=:= (def-bytes left) (def-bytes right))]
  (assert same-source?)
  (assert same-links?)
  (assert same-files?)
  (assert (not same-anf?))
  {:schema "bl.native.macro-context-control" :version 1 :reuse-authority false
   :source-sha256 (:source-sha256 left) :link-rows-sha256 (:sha256 baseline)
   :same-source-read-outcomes same-files? :same-link-receipt same-links?
   :same-definition-bytes same-anf? :input "process dictionary read during a staged macro"}))

(defn- pinned-core-macro? [origin]
 (let [entries (:entries origin)]
  (and (seq entries)
       (every? (fn [entry] (and (:matches-pinned-module entry)
                                (= "Elixir.BeamLisp.Ns.Init.Core.Macros" (:module entry))
                                (zero? (:capture-count entry)))) entries))))

(defn- interpreted-macro [head origin {:keys [form args locals outcome]}]
 (if-not (pinned-core-macro? origin)
  {:status :declined :reason :not-pinned-core-macro}
  (let [session (BeamLisp.AOT/open_constructor_session!)]
   (try
    (let [identity (bind-core-macro! session head)
          before (:budget (BeamLisp.AOT/constructor_session_status session))
          environment (into {} (map (fn [name] [(rn/sym-node name) name]) locals))
          arguments (concat [(BeamLisp.Compiler/datum form) environment] (map BeamLisp.Compiler/datum args))
          calculated ((phase-invoker session identity) arguments)
          after (:budget (BeamLisp.AOT/constructor_session_status session))
          raw? (erlang/=:= outcome calculated)
          canonicalize (fn [value] (BeamLisp.Compiler/with_fresh_names #(compiler/datum-macro-result value)))
          canonical? (or raw? (erlang/=:= (canonicalize outcome) (canonicalize calculated)))]
     {:status (cond raw? :matched canonical? :matched-after-canonicalization :different)
      :fresh-symbols-used (- (:fresh-symbols before) (:fresh-symbols after))
      :constructor-work (into {} (map (fn [[key remaining]] [key (- (get before key) remaining)]) after))})
    (catch error {:status :declined :reason (or (:detail (ex-data error)) (:kind (ex-data error)) (ex-message error))})
    (finally (BeamLisp.AOT/close_constructor_session! session))))))

(defn- sample-phase-macros [closure baseline]
 (Process/put :native_phase_macro_samples true)
 (try
  (let [started (erlang/monotonic_time :microsecond)
        observed (reduce (fn [acc ns]
                           (let [member (get-in closure [:units ns])
                                 [unit observation] (compile-member closure member (:rows baseline))
                                 effects (:effects observation)
                                 samples (:macro-samples effects {})]
                            (assert (erlang/=:= (def-bytes unit) (def-bytes member)))
                            (assert (not (:sample-limit effects)))
                            (assert (= (count samples) (reduce + 0 (map count (vals (:macro-bindings effects))))))
                            (reduce (fn [out [[_ head origin] sample]]
                                      (update out [head origin]
                                       (fn [entry] {:namespaces (conj (:namespaces entry []) ns)
                                                    :sample (or (:sample entry) sample)})))
                                    acc samples))) {} (:order closure))
        captured (erlang/monotonic_time :microsecond)
        results (mapv (fn [[[head origin] {:keys [namespaces sample]}]]
                        (assoc (interpreted-macro head origin sample)
                               :head head :origin origin :affected-members (vec (sort (distinct namespaces)))))
                      (sort observed))
        control-path "research/native-seed/speed/front/macro-context-fixture.bl"
        _ (Process/put :native_relink_context_fixture 19)
        [unit control] (compile-member closure {:path control-path} (:rows baseline))
        [[[_ head origin] sample]] (filter (fn [[[_ head _] _]] (= "staged-input" head))
                                           (get-in control [:effects :macro-samples]))
        denied (interpreted-macro head origin sample)]
   (assert (= 19 (:outcome sample)))
   (assert (= :not-pinned-core-macro (:reason denied)))
   {:schema "bl.native.pinned-macro-phase-samples" :version 2 :reuse-authority false
    :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
    :link-rows-sha256 (:sha256 baseline) :exact-members (count (:order closure))
    :capture-us (- captured started)
    :interpreter-and-control-us (- (erlang/monotonic_time :microsecond) captured)
    :samples results :ambient-control denied})
  (finally
   (Process/delete :native_relink_context_fixture)
   (Process/delete :native_phase_macro_samples))))

(defn- macro-lookup-summary [observation]
 (let [effects (:effects observation)
       lookups (:macro-lookups effects [])
       misses (filter (fn [[_ _ route]] (= :miss route)) lookups)
       routes (:macro-routes effects {})
       fallback (filter (fn [[[ns name route] _]] (= :fallback route)) routes)]
  {:lookups (count lookups) :misses (count misses)
   :distinct-miss-keys (count (set (map (fn [[ns name _]] [ns name]) misses)))
   :resolution-sha256 (value-identity (mapv (fn [[ns name route]] [ns name (not= :miss route)]) lookups))
   :fallback-expansions (mapv (fn [[[ns name _] calls]] [ns name calls]) (sort fallback))
   :all-expansions-owned (empty? fallback)}))

(defn- macro-miss-control [closure baseline]
 (let [path "research/native-seed/speed/front/macro-miss-fixture.bl"
       scope "native.macro-miss-fixture"
       name "selected-value"
       compile-under (fn [transformer]
                       (BeamLisp.Env/isolated
                        (fn []
                         (install-rows! closure (:rows baseline))
                         (BeamLisp.Compiler/with_fresh_names
                          (fn []
                           (trace! (fn []
                                     (let [prepared (build/prepare-ns path
                                                       {:after-staging (fn [_]
                                                         (when transformer
                                                          (BeamLisp.Env/put_key (tuple scope name)
                                                           (tuple :"$macro" transformer))))})]
                                      (build/compile-prepared prepared {:check-node identity})))
                            {:macro-lookups? true}))))))
       [old before] (compile-under nil)
       [new after] (compile-under (fn [_form _locals] 19))
       outcomes (fn [observation]
                  (set (keep (fn [[ns head route]] (when (= [scope name] [ns head]) route))
                             (get-in observation [:effects :macro-lookups]))))]
  (assert (= (:source-sha256 old) (:source-sha256 new)))
  (assert (= (:sources before) (:sources after)))
  (assert (receipt-matches? (link-receipt before) (:local-links baseline)))
  (assert (= #{:miss} (outcomes before)))
  (assert (= #{:fallback} (outcomes after)))
  (assert (not (erlang/=:= (def-bytes old) (def-bytes new))))
  {:name name :installed-link-inputs-still-match true :source-inputs-still-match true
   :lookup-before :miss :lookup-after :fallback :same-definition-bytes false}))

(defn- compile-phase-member [closure rows ns macros calls]
 (let [member (get-in closure [:units ns])
       before (atomics/get calls 1)
       started (erlang/monotonic_time :microsecond)
       macros (if (= ns "core") [] macros)
       phase-callables (into {} (map (fn [[name entry]] [entry name]) macros))
       [compiled observation] (BeamLisp.Env/isolated
                  (fn []
                   (install-rows! closure rows)
                   (doseq [[name entry] macros]
                    (BeamLisp.Env/put_key (tuple "core" name) (tuple :"$macro" entry)))
                   (BeamLisp.Compiler/with_fresh_names
                    (fn []
                     (trace! (fn [] (build/compile-prepared (build/prepare-ns (:path member)) {:check-node identity}))
                             {:macro-lookups? true :phase-callables phase-callables})))))
       interpreted (reduce + 0 (keep (fn [[[_ _ route] n]] (when (vector? route) n))
                                     (get-in observation [:effects :macro-routes])))
       elapsed (- (erlang/monotonic_time :microsecond) started)]
  (assert (= interpreted (- (atomics/get calls 1) before)))
  {:namespace ns :compile-us elapsed :interpreted-expansions interpreted
   :macro-lookup (macro-lookup-summary observation)
   :same-definitions (erlang/=:= (def-bytes compiled) (def-bytes member))}))

(defn- compile-with-phase-macros [closure baseline samples-path]
 (let [control (macro-miss-control closure baseline)
       ordinary (mapv #(compile-phase-member closure (:rows baseline) % [] (atomics/new 1 (list))) (:order closure))]
  (assert (every? :same-definitions ordinary))
  (with-phase-entries baseline samples-path
   (fn [entries calls]
    (let [interpreted (mapv #(compile-phase-member closure (:rows baseline) % entries calls) (:order closure))]
     (assert (pos? (atomics/get calls 1)))
     {:schema "bl.native.interpreted-phase-compile" :version 2 :reuse-authority false
      :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
      :link-rows-sha256 (:sha256 baseline) :macro-miss-control control
      :ordinary ordinary :interpreted interpreted})))))

(defn- registry-phase-status [observation]
 (let [calls (get-in observation [:effects :registry-calls])
       writes (fn [[[operation _] _]] (contains? registry-writes operation))
       summarize (fn [entries] (mapv (fn [[[operation arity] count]] [operation arity count]) (sort entries)))]
  {:reads (summarize (remove writes calls)) :writes (summarize (filter writes calls))
   :source-reads (count (:sources observation)) :link-reads (:calls observation)}))

(defn- registry-input-mismatches [inputs]
 (let [scope (BeamLisp.Env/env_id) ancestors (vec (rest (BeamLisp.Env/chain)))]
  (count (remove (fn [[input outcome]] (erlang/=:= outcome (registry-input-state input scope ancestors))) inputs))))

(defn- registry-lowering-supported? [effects phase]
 (and (empty? (:writes phase)) (not (:unexplained-registry-scope effects))
      (not (:changing-registry-input effects))
      (every? (fn [[operation _ _]] (contains? #{:lookup :member} operation)) (:reads phase))))

(defn- registry-read-proof [closure baseline member observation phase]
 (let [effects (:effects observation)
       inputs (:registry-inputs effects {})
       supported? (registry-lowering-supported? effects phase)
       mismatches (when supported?
                    (BeamLisp.Env/isolated
                     (fn []
                      (install-rows! closure (:rows baseline))
                      (BeamLisp.Compiler/with_fresh_names
                       (fn []
                        (build/prepare-ns (:path member))
                        (registry-input-mismatches inputs))))))]
  {:distinct-inputs (count inputs) :rewritable-reads supported?
   :unexplained-scope (boolean (:unexplained-registry-scope effects))
   :changed-during-lowering (boolean (:changing-registry-input effects))
   :unknown-key-shapes (vec (sort (:unknown-registry-shapes effects)))
   :changing-key-shapes (vec (sort (:changing-registry-shapes effects)))
   :changing-metadata (vec (sort (:changing-metadata effects)))
   :truncated-key-shapes (boolean (:truncated-registry-shapes effects))
   :fresh-stage-mismatches mismatches}))

(defn- registry-input-control []
 (BeamLisp.Env/isolated
  (fn []
   (let [key (tuple :alias "native.registry-input-control" "route")
         physical (BeamLisp.Env/key key)
         [_ first] (trace! (fn [] [(ets/lookup :beam_lisp_vars physical) (ets/member :beam_lisp_vars physical)])
                           {:registry? true :registry-inputs? true})
         inputs (get-in first [:effects :registry-inputs])]
    (assert (= 2 (count inputs)))
    (assert (= 0 (registry-input-mismatches inputs)))
    (BeamLisp.Env/put_key key "rebound")
    (assert (= 2 (registry-input-mismatches inputs)))
    {:lookup-and-membership-miss-invalidated true}))))

(defn- registry-phases [closure baseline selected inputs?]
 {:schema "bl.native.registry-by-phase" :version 1 :reuse-authority false
  :table "beam_lisp_vars" :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
  :scoped-declarations inputs?
  :input-control (when inputs? (registry-input-control))
  :members (mapv (fn [ns]
                   (let [member (get-in closure [:units ns])]
                    (let [[summary lowering] (BeamLisp.Env/isolated
                     (fn []
                      (install-rows! closure (:rows baseline))
                      (BeamLisp.Compiler/with_fresh_names
                       (fn []
                        (let [options {:registry? true}
                              [prepared staging] (trace! #(build/prepare-ns (:path member)) options)
                              lower (fn [] (build/compile-prepared prepared {:check-node identity}))
                              [compiled lowering] (trace! (if inputs? #(BeamLisp.Loader/with_declaration_snapshot lower) lower)
                                                    (assoc options :registry-inputs? inputs?))]
                         (assert (erlang/=:= (def-bytes compiled) (def-bytes member)))
                         [{:namespace ns :same-definitions true
                           :staging (registry-phase-status staging) :lowering (registry-phase-status lowering)}
                          lowering])))))]
                     (cond-> summary inputs?
                      (assoc :registry-inputs (registry-read-proof closure baseline member lowering (:lowering summary)))))))
                 (if selected [selected] (:order closure)))})

(defn- declaration-snapshot-sample [closure baseline member mode observed?]
 (BeamLisp.Env/isolated
  (fn []
   (install-rows! closure (:rows baseline))
   (BeamLisp.Compiler/with_fresh_names
    (fn []
     (let [prepared (build/prepare-ns (:path member))
           lower (fn [] (build/compile-prepared prepared {:check-node identity}))
           lower (if (= :direct mode) lower (fn [] (BeamLisp.Loader/with_declaration_snapshot lower)))
           lower (if (= :ambient mode)
                  (fn []
                   ;; This paired probe uses the checkout runner's static roots.
                   ;; The full Loader path remains responsible for dynamic roots.
                   (assert (contains? #{nil ""} (System/get_env "BEAM_LISP_PATH")))
                   (assert (nil? (Process/get :bl_ambient_dirs)))
                   (BeamLisp.Loader/with_ambient_dirs
                    (cons (File/cwd!) (BeamLisp.Env/search_paths))
                    lower))
                  lower)
           before (elem (erlang/process_info (erlang/self) :reductions) 1)
           started (erlang/monotonic_time :microsecond)
           [compiled observation] (if observed? (trace! lower observed?) [(lower) nil])
           elapsed (- (erlang/monotonic_time :microsecond) started)
           reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) before)]
      (assert (erlang/=:= (def-bytes compiled) (def-bytes member)))
      (if observed?
       (let [effects (:effects observation)]
        (cond-> {:mode mode :source-probes (:source-probe-count effects 0)
                 :distinct-outcomes (count (:source-probes effects))}
         (:boundary? observed?)
         (assoc :cwd-queries (get-in effects [:process-boundary [:send :file_server_2 :get_cwd]] 0)
                :search-path-reads (get-in effects
                                    [:env-agent-readers [:Elixir.BeamLisp.Env :"-search_paths/0-anonymous-0-"]] 0))))
       {:mode mode :wall-us elapsed :reductions reductions})))))))

(defn- declaration-snapshot-report [closure baseline selected]
 (let [member (get-in closure [:units selected])
       _ (assert (some? member))
       samples (mapv #(declaration-snapshot-sample closure baseline member % false)
                     [:direct :snapshot :snapshot :direct])
       observations (mapv #(declaration-snapshot-sample closure baseline member % {:source-probes? true})
                          [:direct :snapshot])]
  {:schema "bl.native.declaration-snapshot-cost" :version 1
   :namespace selected :exact-definitions true
   :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
   :samples samples :observations observations}))

(defn- ambient-root-report [closure baseline selected]
 (let [member (get-in closure [:units selected])
       _ (assert (some? member))
       sample (fn [options mode] (declaration-snapshot-sample closure baseline member mode options))]
  {:schema "bl.native.ambient-root-cost" :version 1 :reuse-authority false
   :namespace selected :exact-definitions true :link-rows-sha256 (:sha256 baseline)
   :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
   :samples (mapv #(sample nil %) [:snapshot :ambient :ambient :snapshot])
   :observations (mapv #(sample {:source-probes? true :boundary? true :registry? true} %)
                       [:snapshot :ambient])}))

(defn- ambient-root-control [report-path]
 (let [root (Path/expand (str report-path ".roots-" (System/unique_integer (list :positive))))
       provider "native_ambient_root_control"
       source (Path/join root (str provider ".bl"))
       find-provider #(BeamLisp.Loader/source_path provider)]
  (File/mkdir! root)
  (try
   (File/write! source (str "(ns " provider ")\n"))
   (BeamLisp.Env/isolated
    (fn []
     (assert (nil? (find-provider)))
     (BeamLisp.Loader/with_ambient_dirs
      (cons (File/cwd!) (BeamLisp.Env/search_paths))
      (fn []
       (BeamLisp.Env/add_search_path root)
       (assert (nil? (find-provider)))))
     (assert (= source (find-provider)))))
   {:schema "bl.native.ambient-root-control" :version 1 :reuse-authority false
    :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
    :missing-before true :hidden-by-captured-roots true :resolved-after-restoring-live-roots true}
   (finally (File/rm_rf! root)))))

(defn- source-identity [path]
 (let [absolute (Path/expand path) root (str (File/cwd!) "/")]
  (if (String/starts_with? absolute root) (subs absolute (count root)) absolute)))

(defn- source-probes [observation]
 (vec (sort (distinct (map (fn [[path present?]] [(source-identity path) present?])
                           (get-in observation [:effects :source-probes]))))))

(defn- source-probe-control [report-path]
 (let [root (Path/expand (str report-path ".probe-" (System/unique_integer (list :positive))))
       nested (str root "/native")
       preferred (str nested "/probe-provider.bl")
       fallback (str nested "/probe_provider.bl")
       ns "native.probe-provider"
       contents (str "(ns " ns ")\n")
       resolve (fn [] (BeamLisp.Loader/with_search_dir root #(BeamLisp.Loader/source_path ns)))]
  (File/mkdir! root)
  (try
   (File/mkdir! nested)
   (File/write! fallback contents)
   (let [[prior observation] (trace! resolve {:source-probes? true})
         probes (source-probes observation)
         preferred-key (source-identity preferred)]
    (assert (= fallback prior))
    (assert (some #{[preferred-key false]} probes))
    (assert (empty? (changed-source-probes probes (presence-snapshot probes))))
    (File/write! preferred contents)
    (assert (= preferred (resolve)))
    (assert (= [preferred-key] (changed-source-probes probes (presence-snapshot probes))))
    (assert (= contents (File/read! fallback)))
    {:schema "bl.native.negative-source-probe-control" :version 1 :reuse-authority false
     :receipted-probes (count probes) :old-source-bytes-match true :changed-probes 1
     :preferred-source-replaced-fallback true})
   (finally
    (File/rm preferred)
    (File/rm fallback)
    (File/rmdir nested)
    (File/rmdir root)))))

(defn- capture-source [closure baseline]
 {:schema :native-source-shadow-v3
  :sdk (:sdk-pin closure) :options (:options closure) :order (:order closure)
  :link-rows-sha256 (:sha256 baseline)
  :members (into {}
   (map (fn [ns]
          (let [member (get-in closure [:units ns])
                [compiled observed] (compile-member closure member (:rows baseline) {:source-probes? true})]
           (assert (= (:source-sha256 member) (:source-sha256 compiled)))
           (assert (erlang/=:= (def-bytes member) (def-bytes compiled)))
           (assert (:accepted (replay-links observed (:local-links baseline))))
           [ns {:defs (artifact/sha (def-bytes member)) :link-receipt (link-receipt observed)
                :scope-receipt (scope-receipt observed)
                :source-probes (source-probes observed)
                :paths (vec (sort (distinct (map (fn [[path digest]] [(source-identity path) digest])
                                                (:sources observed)))))}]))
        (:order closure)))})

(defn- observed-effect-refusals [effects]
 (let [tables #{[:lookup :beam_lisp_ops :op_of]
                [:lookup :beam_lisp_source_extent_heads :source_head]
                [:lookup :beam_lisp_source_extent_heads :source_target_declaration!]
                [:lookup_element :ac_tab :get_env]
                [:lookup :code_server :is_loaded]}
       code #{[:dir :priv_dir] [:dir :lib_dir] [:get_object_code_for_loading :ensure_loaded]}
       files #{[:get_cwd :cwd!] [:read_file_info :dir?] [:read_file_info :regular?]
               [:read_file :read!] [:read_file :read_file]}
       messages #{[:send :code_server :code_call] [:send :Elixir.BeamLisp.Env :get]
                  [:send :file_server_2 :get_cwd] [:send :file_server_2 :read_file_info]
                  [:send :file_server_2 :read_file]}]
  (vec (take 12
        (concat
         (map (fn [entry] [:table entry]) (sort (remove tables (keys (:table-read-owners effects)))))
         (map (fn [entry] [:code-server entry]) (sort (remove code (keys (:code-server-read-owners effects)))))
         (map (fn [entry] [:file-server entry]) (sort (remove files (keys (:file-server-read-owners effects)))))
         (map (fn [entry] [:env entry]) (sort (remove (fn [[_ owner]] (contains? #{[:loaded_ns?] [:search_paths]} owner))
                                         (keys (:env-read-owners effects)))))
         (map (fn [entry] [:process entry]) (sort (remove messages (keys (:process-boundary effects))))))))))

(defn- observe-lowering
 ([closure baseline member entries] (observe-lowering closure baseline member entries {}))
 ([closure baseline member entries options]
 (with-registry-stage closure (:rows baseline) member entries
  (fn [prepared callables]
   (let [lower! (fn [] (build/compile-prepared prepared {:check-node identity}))
         observe! #(trace! (fn [] (BeamLisp.Loader/with_declaration_snapshot lower!))
                            (merge {:registry? true :registry-inputs? true :source-probes? true
                                    :macro-lookups? true :phase-callables callables} options))
         [compiled observed] (if (:code-reads? options)
                              (let [[[compiled observed] mutations]
                                    (with-code-mutation-observation
                                     (fn []
                                      (let [before (code-snapshot)
                                            [compiled observed] (observe!)
                                            after (code-snapshot)
                                            reads (captured-code-reads before
                                                                       (observed-code-modules (:effects observed) after)
                                                                       after)]
                                       [compiled (assoc-in observed [:effects :code-reads] reads)])))]
                               [compiled (assoc-in observed [:effects :code-mutations] mutations)])
                              (observe!))]
    (let [self-reads (filter (fn [[_ _ key]]
                               (and (erlang/is_tuple key) (> (erlang/tuple_size key) 1)
                                    (= :fwd (elem key 0)) (contains? #{"native.observe-links" "native.checked-relink"} (elem key 1))))
                            (keys (get-in observed [:effects :registry-inputs])))]
     (assert (empty? self-reads)
             (str "Probe leaked into lowering reads for " (:ns member) ": " (pr-str self-reads))))
    [(prepared-inputs prepared) compiled observed callables])))))

(defn- lowering-boundary-control []
 (let [table (ets/new :native_lowering_boundary_control (list :set))]
  (try
   (let [[_ observation] (trace! (fn []
                                  (ets/insert table (tuple :key 1))
                                  (ets/lookup table :key)
                                  (Agent/get :Elixir.BeamLisp.Env (fn [_] :lowering-env-control))
                                  (erlang/send (erlang/self) :lowering-boundary-control))
                            {:registry? true :boundary? true})
         effects (:effects observation)]
    (receive :lowering-boundary-control :ok (after 1000 (throw :boundary-control-timeout)))
    (assert (= 1 (get-in effects [:other-tables [:insert :anonymous-table]])))
    (assert (= 1 (get-in effects [:other-tables [:lookup :anonymous-table]])))
    (assert (= 2 (reduce + 0 (vals (:process-boundary effects)))))
    (assert (= 1 (get-in effects [:process-boundary [:send :Elixir.BeamLisp.Env :get]])))
    (assert (= 1 (reduce + 0 (vals (:env-agent-readers effects)))))
    (assert (not (contains? (:env-agent-readers effects) [:unclassified])))
    (assert (some #(= :process (first %)) (observed-effect-refusals effects)))
    {:table-read-observed true :table-write-observed true :message-observed true :env-reader-observed true})
   (finally (ets/delete table)))))

(defn- lowering-effects [closure rows samples-path selected]
 (when (and selected (not (contains? (:units closure) selected)))
  (throw (ex-info "Unknown native lowering member" {:namespace selected})))
 (with-phase-entries rows samples-path
  (fn [entries _]
   {:schema "bl.native.lowering-effects" :version 4 :reuse-authority false
    :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
    :link-rows-sha256 (:sha256 rows)
    :control (lowering-boundary-control)
    :members (mapv (fn [ns]
                    (let [member (get-in closure [:units ns])
                          [_ output observation]
                          (try (observe-lowering closure rows member entries {:boundary? true :ownership? true :env-reads? true
                                                                               :runtime-reads? true :code-reads? true})
                               (catch error
                                (throw (ex-info (str "Lowering probe failed for " ns ": " (pr-str (ex-data error)))
                                                {:namespace ns :observation-error (ex-data error)}))))
                          effects (:effects observation)
                          phase (registry-phase-status observation)]
                     (assert (erlang/=:= (def-bytes member) (def-bytes output)))
                     {:namespace ns :same-definitions true
                      :registry-supported (registry-lowering-supported? effects phase)
                      :owned-macros (:all-expansions-owned (macro-lookup-summary observation))
                      :other-tables (vec (sort (:other-tables effects)))
                      :env-agent-readers (vec (sort (:env-agent-readers effects)))
                      :env-read-owners (vec (sort (:env-read-owners effects)))
                      :file-read-owners (vec (sort (:file-read-owners effects)))
                      :file-server-read-owners (vec (sort (:file-server-read-owners effects)))
                      :table-read-owners (vec (sort (:table-read-owners effects)))
                      :extent-read-kinds (vec (sort (:extent-read-kinds effects)))
                      :code-server-owners (vec (sort (:code-server-owners effects)))
                      :code-server-read-owners (vec (sort (:code-server-read-owners effects)))
                      :effect-refusals (observed-effect-refusals effects)
                      :rejected-env-reads (vec (sort (:rejected-env-reads effects)))
                      :process-events (vec (sort (:process-boundary effects)))}))
                   (if selected [selected] (:order closure)))})))

(defn- env-read-control [report-path]
 (BeamLisp.Env/isolated
  (fn []
   (let [provider "native_env_read_control"
         root (Path/expand (str report-path ".control-root"))
         capture (fn [action] (get-in (second (trace! action {:env-reads? true})) [:effects]))
         consult (fn [] [(BeamLisp.Env/loaded_ns? provider) (BeamLisp.Env/search_paths)])
         original (capture consult)
         reads (:env-reads original)]
    (assert (false? (get reads [:loaded_ns? provider])))
    (assert (empty? (changed-env-reads reads)))
    (let [unstable (capture (fn [] (consult) (BeamLisp.Env/mark_loaded provider) (consult)))]
     (assert (:unstable-env-read unstable)))
    (assert (= [[:loaded_ns? provider]] (changed-env-reads reads)))
    (BeamLisp.Env/add_search_path root)
    (assert (= #{[:loaded_ns? provider] [:search_paths]} (set (changed-env-reads reads))))
    {:schema "bl.native.env-read-control" :version 1 :reuse-authority false
     :recorded-negative-read true :unchanged-outcomes true :changed-readiness true
     :changed-search-paths true :unstable-read-detected true}))))

(defn- runtime-read-control []
 (let [control :native_relink_runtime_control
       operation-key [:op_of :erlang control]
       setting-key [:application-setting :kernel control]
       extent-key [:source_head]
       read (fn []
              (BeamLisp.Env/op_of :erlang control)
              (application/get_env :kernel control)
              (application/get_env :kernel control (erlang/make_ref))
              (BeamLisp.Env/source_execution_active?))
       capture (fn [] (get-in (second (trace! read {:runtime-reads? true})) [:effects :env-reads]))]
  (assert (= :undefined (application/get_env :kernel control)))
  (assert (nil? (BeamLisp.Env/op_of :erlang control)))
  (try
   (let [before (capture)]
    (assert (= {operation-key [:operation nil] setting-key :missing-application-setting
                extent-key :no-source-extent} before))
    (assert (empty? (changed-env-reads before)))
    (BeamLisp.Env/register_op :erlang control :read)
    (assert (= [operation-key] (changed-env-reads before)))
    (assert (= :ok (application/set_env :kernel control :undefined)))
    (assert (= #{operation-key setting-key} (set (changed-env-reads before))))
    (let [after (capture)]
     (assert (= [:application-value :undefined] (get after setting-key)))
     (assert (empty? (changed-env-reads after))))
    (let [[_ observed] (trace! #(application/get_env :kernel control :undefined) {:runtime-reads? true})]
     (assert (= [setting-key] (changed-env-reads (get-in observed [:effects :env-reads])))))
    (assert (= :unavailable (env-read-result extent-key (tuple :unportable (erlang/self)))))
    (let [target [:source_target_declaration! :erlang :length 1]
          ensure [:ensure_loaded control]
          directory [:lib_dir :kernel]
          [_ observation] (trace! (fn []
                                    (BeamLisp.Env/source_target_declaration! :erlang :length 1)
                                    (code/ensure_loaded control)
                                    (code/lib_dir :kernel))
                                   {:runtime-reads? true})
          reads (get-in observation [:effects :env-reads])]
     (assert (= #{target ensure directory} (set (keys reads))))
     (assert (= :missing-module (get reads ensure)))
     (assert (empty? (changed-env-reads reads)))
     (assert (not (erlang/module_loaded control))))
    {:schema "bl.native.runtime-read-control" :version 1 :reuse-authority false
     :operation-miss-tracked true :operation-change-detected true :application-change-detected true
     :unset-distinguished-from-configured-undefined true
     :opaque-application-default-excluded true :configured-default-collision-refused true
     :source-target-checked true :library-directory-checked true :ensure-loaded-miss-rechecked-without-loading true
     :no-source-extent-tracked true :live-source-extent-refused true})
   (finally
    (application/unset_env :kernel control)
    (ets/delete :beam_lisp_ops (tuple :erlang control))))))

(defn- code-control-binary [module value]
 (let [forms (list (tuple :attribute 1 :module module)
                   (tuple :attribute 1 :export (list (tuple :value 0)))
                   (tuple :function 1 :value 0
                          (list (tuple :clause 1 (list) (list) (list (tuple :integer 1 value))))))
       compiled (compile/forms forms (list :binary))]
  (assert (= :ok (elem compiled 0)))
  (elem compiled 2)))

(defn- code-read-control [output]
 (let [module :bl_native_code_state_control
       filename (String/to_charlist "/native-code-state-control.beam")
       root (Path/expand (str output ".beam-control-" (System/unique_integer (list :positive))))
       root-chars (String/to_charlist root)
       first-code (code-control-binary module 1)
       second-code (code-control-binary module 2)
       capture (fn []
                (let [before (code-snapshot)
                      [_ trace] (trace! #(code/is_loaded module) {:code-reads? true})]
                 (captured-code-reads before (get-in trace [:effects :code-reads]) (code-snapshot))))]
  (assert (false? (code/is_loaded module)))
  (File/mkdir! root)
  (try
   (let [absent (capture)]
    (assert (= [false nil :non_existing] (get absent module)))
    (assert (empty? (changed-code-reads absent)))
    (File/write! (Path/join root "bl_native_code_state_control.beam") first-code)
    (let [[_ changes] (with-code-mutation-observation
                      (fn []
                       (assert (= true (code/add_patha root-chars)))
                       (assert (= [module] (changed-code-reads absent)))
                       (assert (false? (code/is_loaded module)))
                       (assert (= :unavailable (get (capture) module)))
                       (assert (= true (code/del_path root-chars)))))]
     (assert (pos? (get changes (tuple :code_server :add_path 6) 0)))
     (assert (pos? (get changes (tuple :code_server :del_path 4) 0))))
    (assert (empty? (changed-code-reads absent)))
    (assert (= (tuple :module module) (code/load_binary module filename first-code)))
    (assert (= [module] (changed-code-reads absent)))
    (let [present (capture)
          location (code/is_loaded module)]
     (assert (empty? (changed-code-reads present)))
     (assert (= (tuple :module module) (code/load_binary module filename second-code)))
     (assert (= location (code/is_loaded module)))
     (assert (= [module] (changed-code-reads present)))
     (assert (= :unavailable (get (captured-code-reads present {module (code-location location)} (code-snapshot)) module)))
     (let [twice (fn []
                  (code/purge module)
                  (assert (= (tuple :module module) (code/load_binary module filename first-code)))
                  (code/purge module)
                  (assert (= (tuple :module module) (code/load_binary module filename second-code))))
           original (capture)
           ;; The calls happen through a different actor and code_server.
           [_ writes] (with-code-mutation-observation
                       (fn []
                        (let [parent (erlang/self) done (erlang/make_ref)]
                         (spawn (fn [] (twice) (erlang/send parent done)))
                         (receive reply :when (= done reply) :ok
                           (after 3000 (throw :code-control-worker-timeout))))))]
      (assert (empty? (changed-code-reads original)))
      (assert (<= 2 (get writes (tuple :erlang :finish_loading 1) 0))))))
   (finally
    (code/del_path root-chars)
    (File/rm_rf! root)
    (code/purge module)
    (code/delete module)
    (code/purge module)))
  (assert (false? (code/is_loaded module)))
  {:schema "bl.native.code-read-control" :version 3 :reuse-authority false
   :recorded-absence true :loaded-after-miss true :same-path-code-replacement true
   :unloaded-object-invalidates-miss true :path-change-and-restoration-observed true
   :changed-during-snapshot true :same-state-after-two-writes true :module-cleaned-up true}))

(defn- resolver-read-control [output]
 (let [provider "native_resolver_read_control"
       root (Path/expand (str output ".resolver-" (System/unique_integer (list :positive))))
       preferred (Path/join root "preferred")
       fallback (Path/join root "fallback")
       filename (str provider ".bl")
       preferred-file (Path/join preferred filename)
       fallback-file (Path/join fallback filename)
       expected-keys #{[:source_decls provider] [:source_path provider]}
       consult (fn [] (BeamLisp.Loader/with_declaration_snapshot
                       (fn [] [(BeamLisp.Loader/source_decls provider)
                               (BeamLisp.Loader/source_path provider)])))
       capture (fn []
                (let [[results trace] (trace! consult {:resolver-reads? true})]
                 [results (resolver-receipt (:effects trace))]))]
  (File/mkdir! root)
  (try
   (File/mkdir! preferred)
   (File/mkdir! fallback)
   (BeamLisp.Loader/with_ambient_dirs
    (list preferred fallback)
    (fn []
     (let [[missing absent] (capture)]
      (assert (= [nil nil] missing))
      (assert (= expected-keys (set (keys absent))))
      (assert (empty? (changed-resolver-reads absent)))
      (File/write! fallback-file (str "(ns " provider ")\n(defn old-name [] 1)\n"))
      (assert (= expected-keys (set (changed-resolver-reads absent))))
      (let [[[_ previous] reads] (capture)]
       (assert (= fallback-file previous))
       (File/write! preferred-file "(ns wrong_provider)\n(defn other-name [] 2)\n")
       (assert (empty? (changed-resolver-reads reads)))
       (File/write! preferred-file (str "(ns " provider ")\n(defn new-name [] 2)\n"))
       (assert (= expected-keys (set (changed-resolver-reads reads))))
       (let [[[_ selected] preferred-reads] (capture)
             source-before [(File/read! preferred-file) (File/read! fallback-file)]
             paths-before (BeamLisp.Env/search_paths)]
        (assert (= preferred-file selected))
        (BeamLisp.Loader/with_ambient_dirs
         (list fallback preferred)
         (fn []
          (assert (= expected-keys (set (changed-resolver-reads preferred-reads))))
          (assert (= fallback-file (second (consult))))
          (assert (= paths-before (BeamLisp.Env/search_paths)))
          (assert (= source-before [(File/read! preferred-file) (File/read! fallback-file)])))))))))
   {:schema "bl.native.resolver-read-control" :version 2 :reuse-authority false
    :namespace-miss-rechecked true :wrong-declaration-ignored true
    :preferred-provider-detected true :declaration-change-detected true
    :root-order-change-detected true :provider-bytes-and-configured-paths-unchanged true}
   (finally (File/rm_rf! root)))))

(defn- registry-shadow-member [closure baseline candidate member entries]
 (let [[prior-inputs prior observation] (observe-lowering closure baseline member entries)
       effects (:effects observation)
       inputs (:registry-inputs effects {})
       supported? (registry-lowering-supported? effects (registry-phase-status observation))
       macros? (:all-expansions-owned (macro-lookup-summary observation))
       probes (source-probes observation)
       paths? (and (empty? (changed-source-probes probes (presence-snapshot probes)))
                   (every? (fn [[path digest]]
                             (and (not= :unavailable digest) (= digest (read-source-identity path))))
                           (:sources observation)))]
  (with-registry-stage closure (:rows candidate) member entries
   (fn [prepared _]
    (let [same-prepared? (erlang/=:= prior-inputs (prepared-inputs prepared))
          reason (cond
                   (not supported?) :unaccounted-registry
                   (not macros?) :ordinary-macro
                   (not paths?) :source-input-changed
                   (not same-prepared?) :prepared-input-changed
                   (pos? (registry-input-mismatches inputs)) :registry-input-changed)
          started (erlang/monotonic_time :microsecond)
          actual (if reason (lower-with-snapshot prepared) prior)]
     {:namespace (:ns member) :distinct-registry-inputs (count inputs)
      :reason reason :reused (nil? reason)
      :candidate-lowering-us (- (erlang/monotonic_time :microsecond) started)
      :exact-clean-definitions (erlang/=:= (def-bytes actual) (def-bytes member))})))))

(defn- registry-shadow [closure baseline candidate samples-path]
 (assert (some? candidate))
 (with-phase-entries candidate samples-path
  (fn [entries _]
   {:schema "bl.native.registry-lowering-shadow" :version 1 :reuse-authority false
    :baseline-link-rows-sha256 (:sha256 baseline) :candidate-link-rows-sha256 (:sha256 candidate)
    :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
    :members (mapv (fn [ns] (registry-shadow-member closure baseline candidate (get-in closure [:units ns]) entries))
                   (:order closure))})))

(defn- registry-value-signature [value callables]
 (if-let [identity (closed-identity value)] [:closed identity]
  (registry-row-signature value callables)))

(defn- opaque-value-shape [value depth]
 (cond
  (erlang/is_function value)
  [:function (erlang/atom_to_binary (fun-field value :module)) (fun-field value :type)
   (count (fun-field value :env))]
  (erlang/is_reference value) :reference
  (erlang/is_pid value) :pid
  (and (erlang/is_tuple value) (pos? depth))
  (mapv #(opaque-value-shape % (dec depth)) (take 8 (erlang/tuple_to_list value)))
  (erlang/is_tuple value) :tuple
  (erlang/is_map value) :map
  (erlang/is_list value) :list
  (erlang/is_atom value) value
  :else :data))

(defn- describe-opaque [reads inputs]
 (mapv (fn [[input _]]
         {:key (receipt-key-description input)
          :shape (mapv #(opaque-value-shape % 4) (get inputs input))})
       (take 12 (sort (filter (fn [[_ fingerprint]] (nil? fingerprint)) reads)))))

(defn- capture-registry-member [closure baseline member entries bound?]
 (let [[prepared compiled observed callables]
       (observe-lowering closure baseline member entries
                        {:env-reads? bound? :code-reads? bound? :resolver-reads? bound? :runtime-reads? bound?
                         :boundary? bound? :ownership? bound?})
       _ (when (and bound? (not (erlang/=:= (def-bytes compiled) (def-bytes member))))
           (throw (ex-info "Native registry capture diverged from the qualified donor"
                    {:namespace (:ns member)})))
       effects (:effects observed)
       effect-refusals (when bound? (observed-effect-refusals effects))
       application-reads (filter (fn [[[function] _]] (= :application-setting function)) (:env-reads effects))
       reason (cond
                (not (registry-lowering-supported? effects (registry-phase-status observed))) :unaccounted-registry
                (not (:all-expansions-owned (macro-lookup-summary observed))) :ordinary-macro
                (:unknown-env-read effects) :unknown-env-read
                (:unstable-env-read effects) :unstable-env-read
                (seq (changed-env-reads application-reads)) :unstable-application-read
                (:unknown-code-read effects) :unknown-code-read
                (seq (:code-mutations effects)) :code-mutated-during-lowering
                (:unknown-resolver-read effects) :unknown-resolver-read
                (:unstable-resolver-read effects) :unstable-resolver-read
                (seq effect-refusals) :unaccounted-effects
                (or (:unstable-code-read effects) (some #{:unavailable} (vals (:code-reads effects)))) :unstable-code-read)
       prepared-id (when-not reason (closed-identity prepared))
       reads (when prepared-id (into {} (map (fn [[key value]] [key (registry-value-signature value callables)])
                                            (:registry-inputs effects))))
       opaque (count (filter (fn [[_ fingerprint]] (nil? fingerprint)) reads))
       reason (or reason (when-not prepared-id :opaque-prepared-input) (when (pos? opaque) :opaque-registry-value))]
  (if reason
   (cond-> {:reason reason :opaque-inputs opaque :opaque-keys (describe-opaque reads (:registry-inputs effects))}
    (seq effect-refusals) (assoc :effect-refusals effect-refusals)
    (seq (:code-mutations effects)) (assoc :code-mutations (vec (sort (:code-mutations effects)))))
   (cond-> {:prepared prepared-id :registry reads :probes (source-probes observed)
            :sources (vec (sort (distinct (map (fn [[path digest]] [(source-identity path) digest]) (:sources observed)))))
            :module (:module member) :path (:path member) :source-sha256 (:source-sha256 compiled)}
    bound? (assoc :env-reads (:env-reads effects {}) :env-read-calls (:env-read-count effects 0)
                  :code-reads (:code-reads effects {}) :code-read-calls (:code-read-count effects 0)
                  :resolver-reads (resolver-receipt effects) :resolver-read-calls (:resolver-read-count effects 0)
                  :checked-observable-effects true)
    (not bound?) (assoc :definition-bytes (BeamLisp.CompilerData/check_closed_etf! (def-bytes compiled) artifact/limits))))))

(defn- registry-member-bytes [entry]
 (BeamLisp.CompilerData/check_closed_etf!
  (erlang/term_to_binary entry (list :deterministic)) artifact/limits))

(defn- capture-registry [closure baseline candidate samples-path anchor]
 (assert (some? candidate))
 (with-phase-entries candidate samples-path
  (fn [entries _]
   {:schema (if anchor :native-bound-registry-v9 :native-portable-registry-v4)
    :donor anchor :sdk (:sdk-pin closure) :options (:options closure)
    :order (:order closure) :base-links (:sha256 baseline) :core-links (value-identity (:core-links closure))
    :members (into {} (map (fn [ns]
                           [ns (registry-member-bytes
                                (capture-registry-member closure baseline (get-in closure [:units ns]) entries (some? anchor)))])
                         (:order closure)))})))

(defn- cached-registry [closure candidate receipt-path samples-path force?]
 (let [started (erlang/monotonic_time :microsecond)
       reductions (elem (erlang/process_info (erlang/self) :reductions) 1)
       bytes (when-not force? (File/read! receipt-path))
       receipt (when bytes (read-registry-member bytes))]
  (when receipt
   (assert (= :native-portable-registry-v4 (:schema receipt)))
   (assert (= (:sdk-pin closure) (:sdk receipt)))
   (assert (= (:options closure) (:options receipt)))
   (assert (= (:order closure) (:order receipt)))
   (assert (= (value-identity (:core-links closure)) (value-identity (:core-links donor)) (:core-links receipt))
                 (= (:stubs closure) (:stubs donor)))
   (assert (= (artifact/sha (File/read! samples-path)) (:sample-report-sha256 receipt))))
  (let [result (with-phase-entries candidate samples-path
                (fn [entries _]
                 {:schema "bl.native.portable-registry-shadow" :version 2 :reuse-authority false
                  :mode (if force? :force-lower :replay)
                  :receipt-sha256 (when bytes (artifact/sha bytes)) :receipt-bytes (when bytes (erlang/byte_size bytes))
                  :baseline-link-rows-sha256 (:base-links receipt) :candidate-link-rows-sha256 (:sha256 candidate)
                  :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
                  :members (mapv (fn [ns]
                                   (let [entry (if force? {:reason :force-lower}
                                                (read-registry-member (get-in receipt [:members ns])))]
                                    (replay-registry-member closure candidate (get-in closure [:units ns]) entry entries)))
                                 (:order closure))}))]
   (assoc result :wall-us (- (erlang/monotonic_time :microsecond) started)
    :pinned-module-identities (count (Process/get :native_observer_pinned_module_ids {}))
    :reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) reductions)))))

(defn- capture-bound-registry [closure rows samples-path qualification-path]
 (let [donor (qualified-donor closure qualification-path)]
  (when-not (= (:links-sha256 donor) (:sha256 rows))
   (refuse-bound-registry :wrong-donor-links))
  (capture-registry closure rows rows samples-path donor)))

(defn- refusal-kind [action]
 (try (action) :accepted (catch error (:kind (ex-data error)))))

(defn- bound-registry-controls [closure rows receipt-path qualification-path expected-sha]
 (let [anchor (qualified-donor closure qualification-path)
       data (File/read! receipt-path)
       _ (authenticated-registry data expected-sha anchor)
       changed-bytes (str "tampered" data)
       stale-anchor (assoc anchor :closure-sha256 (artifact/sha "different qualified closure"))
       first-member (first (:order closure))
       unrelated (update-in closure [:units first-member :source] str "\n; unrelated closure")
       observed {:receipt-bytes (refusal-kind #(authenticated-registry changed-bytes expected-sha anchor))
                 :other-donor (refusal-kind #(authenticated-registry data expected-sha stale-anchor))
                 :spliced-partitions (refusal-kind #(qualified-donor unrelated qualification-path))
                 :wrong-donor-links (refusal-kind #(capture-bound-registry
                                                    closure (assoc rows :sha256 (artifact/sha "different links"))
                                                    nil qualification-path))}]
  (assert (= {:receipt-bytes :receipt-digest-mismatch :other-donor :receipt-donor-mismatch
              :spliced-partitions :wrong-qualified-donor :wrong-donor-links :wrong-donor-links} observed))
  {:schema "bl.native.bound-registry-controls" :version 1 :donor anchor :checks observed}))

(defn- source-shadow [closure candidate baseline-path receipt-path]
 (let [baseline (artifact/read-closure baseline-path)
       bytes (File/read! receipt-path)
       _ (BeamLisp.CompilerData/check_closed_etf! bytes artifact/limits)
       receipt (erlang/binary_to_term bytes)
       _ (assert (= :native-source-shadow-v3 (:schema receipt)))
       _ (assert (= (:sdk-pin baseline) (:sdk-pin closure) (:sdk receipt)))
       _ (assert (= (:options baseline) (:options closure) (:options receipt)))
       _ (assert (= (:order baseline) (:order closure) (:order receipt)))
       _ (assert (= (:host-modules baseline) (:host-modules closure)))
       _ (assert (= (:stubs baseline) (:stubs closure)))
       _ (assert (= (:core-links baseline) (:core-links closure)))
       before-scan (erlang/monotonic_time :microsecond)
       identities (into {} (map (fn [path] [path (read-source-identity path)])
                          (distinct (mapcat (fn [entry] (map first (:paths entry))) (vals (:members receipt))))))
       probe-snapshot (presence-snapshot (mapcat :source-probes (vals (:members receipt))))
       outer (ancestor-snapshot (map :scope-receipt (vals (:members receipt))))
       started (erlang/monotonic_time :microsecond)
       plan (mapv (fn [ns]
                    (let [old (get-in baseline [:units ns]) new (get-in closure [:units ns])
                          record (get-in receipt [:members ns])
                          changed-paths (vec (filter (fn [[path digest]]
                                                      (or (= digest :unavailable) (not= digest (get identities path))))
                                                    (:paths record)))
                          changed-probes (changed-source-probes (:source-probes record) probe-snapshot)
                          own? (not= (:source-sha256 old) (:source-sha256 new))
                          links? (not (receipt-matches? (:link-receipt record) (:local-links candidate)))
                          outer? (not (ancestor-matches? (:scope-receipt record) outer))]
                     (assert (= (:path old) (:path new)))
                     (assert (= (:defs record) (artifact/sha (def-bytes old))))
                     {:namespace ns :changed-source own? :changed-dependencies (mapv first changed-paths)
                      :changed-links links? :changed-ancestor-links outer?
                      :changed-source-probes changed-probes
                      :reused (not (or own? links? outer? (seq changed-paths) (seq changed-probes)))}))
                  (:order closure))
       planned (erlang/monotonic_time :microsecond)
       results (mapv (fn [decision]
                       (let [ns (:namespace decision) member (get-in closure [:units ns])
                             actual (if (:reused decision) (get-in baseline [:units ns])
                                      (first (compile-member closure member (:rows candidate))))]
                        (assoc decision :exact-clean-definitions
                               (and (= (:source-sha256 actual) (:source-sha256 member))
                                    (erlang/=:= (def-bytes actual) (def-bytes member)))))) plan)]
  {:schema "bl.native.source-replay-shadow" :version 3 :reuse-authority false
   :baseline-receipt-sha256 (artifact/sha bytes) :candidate-link-rows-sha256 (:sha256 candidate)
   :baseline-link-rows-sha256 (:link-rows-sha256 receipt)
   :observed-source-paths (count identities) :observed-ancestor-keys (count outer)
   :observed-source-probes (count probe-snapshot)
   :source-and-ancestor-scan-us (- started before-scan) :plan-us (- planned started)
   :candidate-compilation-and-oracle-comparison-us (- (erlang/monotonic_time :microsecond) planned)
   :members results}))

(defn- observe-shadow [closure baseline candidate]
 ;; The qualified partition is the independent clean candidate oracle. Only
 ;; members that fail their baseline link receipt enter candidate compilation.
 (assert (some? candidate))
 (let [started (erlang/monotonic_time :microsecond)
       prior (mapv (fn [ns]
                     (let [member (get-in closure [:units ns])
                           [compiled observed] (compile-member closure member (:rows baseline))
                           receipt (link-receipt observed)]
                      (assert (= (:source-sha256 member) (:source-sha256 compiled)))
                      (assert (:accepted (replay-links observed (:local-links baseline))))
                      [member (def-bytes compiled) receipt (ordered-report observed)]))
                   (:order closure))
       seeded (erlang/monotonic_time :microsecond)
       consumers (link-consumers prior)
       indexed (erlang/monotonic_time :microsecond)
       changed (changed-links (:local-links baseline) (:local-links candidate))
       before-select (erlang/monotonic_time :microsecond)
       invalidated (affected-members consumers changed)
       selected (erlang/monotonic_time :microsecond)
       plan (mapv (fn [[member bytes receipt operations]]
                    (let [reuse? (not (contains? invalidated (:ns member)))]
                     (assert (= reuse? (receipt-matches? receipt (:local-links candidate))))
                     {:member member :baseline-bytes bytes :operations operations :reuse? reuse?}))
                  prior)
       planned (erlang/monotonic_time :microsecond)
       result (mapv (fn [{:keys [member baseline-bytes operations reuse?]}]
                      (let [bytes (if reuse? baseline-bytes
                                   (def-bytes (first (compile-member closure member (:rows candidate)))))
                            exact? (erlang/=:= bytes (def-bytes member))]
                       {:namespace (:ns member) :reused reuse? :exact-clean-definitions exact?
                        :operations operations})) plan)
       checked (erlang/monotonic_time :microsecond)
       selections (compare-selection prior (:local-links candidate) consumers changed invalidated)]
  {:schema "bl.native.link-replay-shadow" :version 2 :reuse-authority false
   :baseline-link-rows-sha256 (:sha256 baseline) :candidate-link-rows-sha256 (:sha256 candidate)
   :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
   :baseline-compilation-us (- seeded started) :plan-us (- planned seeded)
   :reverse-index {:keys (count consumers) :changed-keys (count changed)
                   :consulted-changed-keys (count (filter #(contains? consumers %) changed))
                   :affected-members (vec (sort invalidated))
                   :index-us (- indexed seeded) :link-table-diff-us (- before-select indexed)
                   :selection-us (- selected before-select) :warm-selection selections}
   :candidate-compilation-and-oracle-comparison-us (- checked planned)
   :members result}))

(defn- effect-report [observation]
 (into {} (map (fn [kind] [kind (mapv (fn [[[ns name] occurrences]] [ns name occurrences])
                                     (sort (get-in observation [:effects kind])))])
               [:expansions :link-writes :link-deletions])))

(defn- macro-report [observation]
 (mapv (fn [[[ns head] origins]] [ns head (vec (sort origins))])
       (sort (get-in observation [:effects :macro-bindings]))))

(defn- observe-sequential [closure {:keys [rows sha256]} scoped?]
 (let [results (BeamLisp.Env/isolated
                (fn []
                 (install-rows! closure rows)
                 (mapv (fn [ns]
                         (let [member (get-in closure [:units ns])
                               [compiled observed] (if scoped?
                                                     (BeamLisp.Compiler/with_fresh_names (fn [] (compile-staged member)))
                                                     (compile-staged member))]
                          (assert (= (:source-sha256 member) (:source-sha256 compiled)))
                          {:namespace ns :same-definitions (erlang/=:= (def-bytes compiled) (def-bytes member))
                           :actual-definitions-sha256 (artifact/sha (def-bytes compiled))
                           :source-read-outcomes (vec (sort (:sources observed)))
                           :staging-effects (effect-report observed)
                           :macro-origins (macro-report observed)
                           :ordered-links (ordered-report observed)
                           :lookup-hits (vec (sort (:hits observed)))
                           :lookup-misses (vec (sort (:misses observed)))}))
                       (:order closure))))]
  {:schema "bl.native.link-sequential-observation" :version 3 :link-rows-sha256 sha256
   :per-member-fresh-names scoped?
   :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
   :members results :reuse-authority false}))

(defn- compare-rows [closure member installed compiled observation consulted-keys candidate]
 (let [incoming (installed-rows (:rows candidate))
       changed (vec (filter (fn [key] (not= (get installed key) (get incoming key)))
                           (sort (into (set (keys installed)) (keys incoming)))))
       consulted (vec (filter consulted-keys changed))
       [next next-observation] (compile-member closure member (:rows candidate))
       prediction (replay-links observation (:local-links candidate))
       exact? (erlang/=:= (def-bytes compiled) (def-bytes next))]
  (assert (= (:accepted prediction) (receipt-matches? (link-receipt observation) (:local-links candidate))))
  (when (and (empty? consulted) (not exact?))
   (throw (ex-info "The recorded links missed an actual ANF change" {:changed changed})))
  {:candidate-rows-sha256 (:sha256 candidate)
   :changed-rows changed :changed-consulted-rows consulted :exact-anf exact?
   :ordered-link-replay prediction
   :staging-effects (effect-report next-observation)
   :source-read-outcomes (vec (sort (:sources next-observation)))}))

(defn- observe [closure {:keys [rows sha256 local-links]} selected comparison]
 (let [member (get-in closure [:units selected])
       installed (installed-rows rows)
       _ (assert (some? member))
       [compiled observation] (compile-member closure member rows)
       keys (sort (into (:hits observation) (:misses observation)))]
  (assert (= (:source-sha256 member) (:source-sha256 compiled)))
  (assert (:accepted (replay-links observation local-links)))
  (assert (some (fn [[path sha]] (and (= (Path/expand (:path member)) (Path/expand path))
                                     (= (:source-sha256 member) sha))) (:sources observation)))
  {:schema "bl.native.installed-link-observation" :version 4
   :namespace selected :source-sha256 (:source-sha256 member)
   :definitions-sha256 (artifact/sha (def-bytes compiled))
   :link-rows-sha256 sha256
   :sdk-descriptor-sha256 (:sdk-descriptor-sha256 artifact/validation-context)
   :lookups (:calls observation)
   :lookup-hits (vec (sort (:hits observation)))
   :lookup-misses (vec (sort (:misses observation)))
   :source-file-consultations (vec (sort (distinct (map first (:sources observation)))))
   :source-read-outcomes (vec (sort (:sources observation)))
   :staging-effects (effect-report observation)
   :macro-origins (macro-report observation)
   :ordered-links (ordered-report observation)
   :present-in-member-rows (vec (filter installed keys))
   :absent-from-member-rows (vec (remove installed keys))
   :comparison (when comparison (compare-rows closure member installed compiled observation (set keys) comparison))
   :scope "Filtered ETS consultations in synchronous staged compilation of unchanged Source. A missing installed member row can still have another resolver fallback."
   :reuse-authority false}))

(defn- row-install-control [closure rows]
 (let [reductions #(elem (erlang/process_info (erlang/self) :reductions) 1)
       keys (vec (distinct (concat (map (fn [[ns name _ _]] (tuple :link ns name)) rows)
                                   (map (fn [[name _]] (tuple :link "core" name)) (:core-links closure)))))
       sample (fn [mode]
                (BeamLisp.Env/isolated
                 (fn []
                  (let [before (reductions) epoch (BeamLisp.Env/publication_epoch)
                        started (erlang/monotonic_time :microsecond)
                        _ (if (= mode :batched) (install-batched-rows! closure rows) (install-rows! closure rows))
                        wall (- (erlang/monotonic_time :microsecond) started)
                        work (- (reductions) before)
                        publications (- (BeamLisp.Env/publication_epoch) epoch)
                        outcomes (mapv BeamLisp.Env/lookup keys)]
                   (assert (every? #(= :ok (elem % 0)) outcomes))
                   {:mode mode :wall-us wall :caller-reductions work :epoch-delta publications
                    :sha256 (value-identity outcomes)}))))
       samples (mapv sample [:individual :batched :batched :individual])
       ns "native.link-placement-control"
       name "binding"
       info (tuple :native_link_placement_control {0 :binding} nil)
       masked (fn [inherited?]
                (BeamLisp.Env/isolated
                 (fn []
                  (when inherited? (BeamLisp.Env/put_link ns name info))
                  (BeamLisp.Env/isolated
                   (fn []
                    (when-not inherited? (BeamLisp.Env/put_link ns name info))
                    (BeamLisp.Env/put_key (tuple ns name) :placeholder)
                    (BeamLisp.Env/link_owner ns name))))))]
  (assert (apply = (map #(select-keys % [:sha256 :epoch-delta]) samples)))
  (assert (= (tuple :ok ns info) (masked false)))
  (assert (= :error (masked true)))
  {:schema "bl.native.row-install-control" :version 1 :distinct-rows (count keys)
   :samples samples :child-binding-masks-inherited-link true}))

(defn- link-pattern-control []
 (let [table (ets/new :native_link_pattern_control (list :set))
       link (tuple (tuple :scope :link "probe" "x") :link-value)
       other (tuple (tuple :scope :ns_defs "probe") :namespace-value)
       cases [[(tuple (tuple :_ :ns_defs :_) :_) :disjoint]
              [(tuple (tuple :_ :ns_defs :_ :_) :_) :disjoint]
              [(tuple (tuple :_ :link :_ :_) :_) :possible]
              [(tuple (tuple :_ :"$1" :_ :_) :_) :possible]
              [(tuple (tuple :_ :_ :_ :_) :_) :possible]
              [(tuple :"$1" :_) :possible]
              [:_ :possible]]]
  (try
   (ets/insert table link)
   (ets/insert table other)
   (doseq [[pattern expected] cases]
    (let [disjoint? (= :disjoint expected)
          matched (ets/match_object table pattern)]
     (assert (= disjoint? (disjoint-link-pattern? (link-pattern-relation pattern))))
     (assert (= (not disjoint?) (boolean (some #(erlang/=:= link %) matched))))))
   (count cases)
   (finally (ets/delete table)))))

(defn- indexed-link-rows [rows key-of]
 (reduce-kv (fn [index position row]
              (update index (key-of row) #(conj (or % []) [position row])))
             {} rows))

(defn- select-indexed-link-rows [index inputs]
 (mapv second (sort-by first (mapcat #(get index % []) inputs))))

(defn- stage-row-index [closure rows]
 [(indexed-link-rows rows (fn [[provider name _ _]] [provider name]))
  (indexed-link-rows (:core-links closure) (fn [[name _]] ["core" name]))])

(defn- stage-installed [closure rows member action]
 (BeamLisp.Env/isolated
  (fn []
   (install-batched-rows! closure rows)
   (BeamLisp.Compiler/with_fresh_names #(action member)))))

(defn- stage-compile [member]
 (let [prepared (build/prepare-ns (:path member))
       compiled (lower-with-snapshot prepared)]
  [(prepared-inputs prepared)
   (assoc (dissoc compiled :cache-status :cache-key) :source (:source prepared)
          :module (BeamLisp.Link/module_for (:ns member)) :base-module (BeamLisp.Emit/base_module_for (:ns member)))]))

(defn- stage-trace [member]
 (trace! #(stage-compile member) {:registry? true :registry-inputs? true :link-scan-patterns? true}))

(defn- stage-link-inputs [observed]
 (let [effects (:effects observed)
       scans (:link-scan-patterns effects)
       _ (assert (= (get-in effects [:registry-calls [:match_object 2]] 0) (reduce + 0 (vals scans))))
       inputs (into (set (keys (:reads (link-receipt observed))))
                    (keep (fn [[_ slot key]]
                            (when (and (= :own slot) (erlang/is_tuple key) (= 3 (erlang/tuple_size key))
                                       (= :link (elem key 0)))
                             [(elem key 1) (elem key 2)]))
                          (keys (:registry-inputs effects))))
       remaining (vec (keep (fn [[[operation arity] calls]]
                             (when-not (or (contains? registry-writes operation) (contains? #{:lookup :member} operation)
                                           (and (= [:match_object 2] [operation arity])
                                                (every? disjoint-link-pattern? (keys scans))))
                              [operation arity calls]))
                           (sort (:registry-calls effects))))]
  {:inputs inputs :scans scans :unsupported remaining}))

(defn- phase-cost [action]
 (let [started (erlang/monotonic_time :microsecond)
       before (elem (erlang/process_info (erlang/self) :reductions) 1)
       result (action)]
  [result {:wall-us (- (erlang/monotonic_time :microsecond) started)
           :caller-reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) before)}]))

(defn- link-key-membership [keys]
 (into {} (map (fn [[ns name]] [(tuple ns name) true]) keys)))

(defn- omitted-link-spec [tables scope live retained arity]
 (let [key (tuple (tuple :$2 :$3))]
  (apply list (map (fn [table]
   (tuple (apply list (concat [table (tuple :$1 :link :$2 :$3)] (repeat (- arity 2) :_)))
         (list (tuple :"=:=" :$1 (tuple :const scope))
               (tuple :is_map_key key (tuple :const live))
               (tuple :not (tuple :is_map_key key (tuple :const retained))))
         (list true)))
   tables))))

(defn- namespace-existence-match? [pattern limit caller]
 ;; The pinned Env callback checks only whether the first page has one row.
 ;; A continuation or ordering-sensitive consumer stays on the full path.
 (and (= caller (tuple :Elixir.BeamLisp.Env :"-ns_exists_uncached?/1-anonymous-0-" 1))
      (= 1 limit)
      (erlang/is_tuple pattern) (= 2 (erlang/tuple_size pattern)) (= :_ (elem pattern 1))
      (let [key (elem pattern 0)]
       (and (erlang/is_tuple key) (= 3 (erlang/tuple_size key))
            (erlang/is_binary (elem key 1)) (= :_ (elem key 2))))))

(defn- stage-link-guard-collector [events omitted unsupported]
 (receive
  [:trace _ :call [:ets :match arguments] caller]
  (let [[_ pattern limit] arguments]
   (recur (inc events) omitted
    (if (namespace-existence-match? pattern limit caller) unsupported
     (conj unsupported [:match 3 (pr-str caller)]))))
  [:trace _ :call [:ets operation arguments]]
  (let [point? (contains? #{:lookup :member :lookup_element :update_counter :update_element :take} operation)
        info-item (when (and (= operation :info) (= 2 (count arguments))) (second arguments))
        metadata? (contains? #{:owner :name :type :protection :named_table :keypos :node :id} info-item)
        scan-ok? (and (= operation :match_object) (<= 2 (count arguments))
                      (disjoint-link-pattern? (link-pattern-relation (second arguments))))
        omitted (if (and point? (< (count omitted) 32))
                   (let [key (second arguments)] (conj omitted [(elem key 2) (elem key 3)]))
                   omitted)
        unsupported (if (or point? scan-ok? metadata?) unsupported
                     (conj unsupported (cond-> [operation (count arguments)]
                                        (and (some? info-item) (erlang/is_atom info-item)) (conj info-item))))]
   (recur (inc events) omitted unsupported))
  [:finish owner ticket]
  (erlang/send owner [:stage-link-guard ticket {:trace-events events :complete? (<= events trace-limit)
                                                :omitted-inputs (vec (sort omitted))
                                                :unsupported (vec (sort unsupported))}])))

(defn- guard-stage-links [scope live retained action]
 (let [owner (erlang/self)
       observer (spawn #(stage-link-guard-collector 0 #{} #{}))
       session (erlang/apply :trace :session_create (list :native_stage_link_guard observer (list)))
       tables [:beam_lisp_vars (ets/whereis :beam_lisp_vars)]
       install (fn [operation arity spec]
                 (assert (= 1 (erlang/apply :trace :function
                               (list session (tuple :ets operation arity) spec (list :local))))))]
  (try
   (doseq [[operation arity] [[:lookup 2] [:member 2] [:lookup_element 3] [:lookup_element 4]
                              [:update_counter 3] [:update_counter 4] [:update_element 3] [:update_element 4] [:take 2]]]
    (when (erlang/function_exported :ets operation arity)
     (install operation arity (omitted-link-spec tables scope live retained arity))))
   (doseq [[operation arity] [[:match_object 2] [:match_object 3] [:match 2]
                              [:select 2] [:select 3] [:select_count 2] [:select_reverse 2] [:select_reverse 3] [:tab2list 1]
                              [:first 1] [:last 1] [:next 2] [:prev 2] [:slot 2]
                              [:first_lookup 1] [:last_lookup 1] [:next_lookup 2] [:prev_lookup 2] [:info 1] [:info 2]
                              [:select_delete 2] [:select_replace 2] [:match_delete 2]
                              [:delete_all_objects 1] [:delete 1]]]
    (when (erlang/function_exported :ets operation arity)
     (install operation arity (apply list (map (fn [table]
       (tuple (apply list (cons table (repeat (dec arity) :_))) (list) (list true))) tables)))))
   (doseq [operation [:match_object :match :select :select_reverse]]
    (install operation 1 (list (tuple (list :_) (list) (list true)))))
   (install :match 3 (apply list (map (fn [table]
    (tuple (list table :_ :_) (list) (list (tuple :message (tuple :caller))))) tables)))
   ;; put/replace alone does not inspect the old value. insert_new does.
   ;; Watch single link objects and conservatively refuse row lists.
   (install :insert_new 2 (apply list (mapcat (fn [table]
      [(tuple (list table (tuple (tuple :_ :link :_ :_) :_)) (list) (list true))
       (tuple (list table :$1) (list (tuple :is_list :$1)) (list true))]) tables)))
   (assert (= 1 (erlang/apply :trace :process (list session owner true (list :call)))))
   (let [compiled (action)
         _ (assert (= 1 (erlang/apply :trace :process (list session owner false (list :call)))))
         barrier (erlang/apply :trace :delivered (list session owner))
         ticket (erlang/make_ref)]
    (receive [:trace_delivered seen ref] :when (and (= seen owner) (= ref barrier))
     :ready (after 10000 (throw :stage-link-guard-delivery-timeout)))
    (erlang/send observer [:finish owner ticket])
    [compiled (receive [:stage-link-guard ref result] :when (= ref ticket)
                result (after 10000 (throw :stage-link-guard-collector-timeout)))])
   (finally
    (erlang/apply :trace :session_destroy (list session))
    (Process/exit observer :kill)))))

(defn- stage-link-table-id-control []
 (BeamLisp.Env/isolated
  (fn []
   (let [scope (BeamLisp.Env/env_id)
         table (ets/whereis :beam_lisp_vars)
         key (BeamLisp.Env/pfx scope (tuple :link "control" "omitted"))
         [result evidence] (guard-stage-links scope {(tuple "control" "omitted") true} {}
                             (fn [] (ets/lookup table key)
                              (ets/match_object table (tuple (tuple scope :_ :_ :_) :_))
                              (ets/match table (tuple (tuple scope "control" :_) :_) 1)
                              (ets/info table :size)
                              :checked))]
    (assert (= :checked result))
    (assert (= [["control" "omitted"]] (:omitted-inputs evidence)))
    (assert (= #{[:info 2] [:match_object 2] [:match 3]}
               (set (map #(subvec % 0 2) (:unsupported evidence)))))
    evidence))))

(defn- capture-stage-link-plan [closure rowset qualification]
 (let [anchor (qualified-donor closure qualification)
       _ (assert (= (:links-sha256 anchor) (:sha256 rowset)))
       members (into {} (map (fn [ns]
                              (let [member (get-in closure [:units ns])
                                    [compiled observed] (stage-installed closure (:rows rowset) member stage-trace)
                                    _ (assert (erlang/=:= member (second compiled)) ns)
                                    {:keys [inputs unsupported]} (stage-link-inputs observed)]
                               [ns {:source-sha256 (:source-sha256 member) :path (:path member)
                                    :inputs (vec (sort inputs)) :unsupported unsupported}]))
                            (:order closure)))]
  {:schema :native-stage-link-plan-v1 :donor anchor :sdk (:sdk-pin closure)
   :order (:order closure) :options (:options closure) :members members}))

(defn- replay-stage-link-member [closure rows [row-index core-index] ns prior live]
 (let [member (get-in closure [:units ns])
       retained (set (:inputs prior))
       source-changed? (not= [(:path member) (:source-sha256 member)] [(:path prior) (:source-sha256 prior)])
       initial-refusal (cond source-changed? :member-source-changed
                             (seq (:unsupported prior)) :donor-table-read-unmodeled)
       subset-rows (when-not initial-refusal (select-indexed-link-rows row-index retained))
       subset-core (when-not initial-refusal (select-indexed-link-rows core-index retained))
       action (if live (fn [member] (guard-stage-links (BeamLisp.Env/env_id) live
                                                      (link-key-membership retained) #(stage-compile member)))
                       stage-trace)
       [[compiled observed] verification-cost] (when-not initial-refusal
                                                 (phase-cost #(stage-installed (assoc closure :core-links subset-core)
                                                                                subset-rows member action)))
       input (when observed (if live observed (stage-link-inputs observed)))
       omitted (if live (:omitted-inputs input [])
                (vec (sort (keep (fn [key]
                                 (when (and (not (contains? retained key))
                                            (or (contains? row-index key) (contains? core-index key)))
                                  key))
                               (:inputs input)))))
       refusal (or initial-refusal (when (false? (:complete? input)) :candidate-trace-incomplete)
                   (when (seq (:unsupported input)) :candidate-table-read-unmodeled)
                   (when (seq omitted) :candidate-link-not-installed))
       result (if refusal (stage-installed closure rows member stage-compile) compiled)]
  (assert (erlang/=:= member (second result)) (str "Edited stage plan changed output for " ns))
  {:namespace ns :exact-unit true :used-subset (nil? refusal) :fallback refusal
   :attempted-subset-rows (when-not initial-refusal (+ (count subset-rows) (count subset-core)))
   :verification-cost verification-cost :guard-events (:trace-events input)
   :unmodeled-operations (:unsupported input)
   :omitted-inputs omitted :fallback-rows (if refusal (+ (count rows) (count (:core-links closure))) 0)}))

(defn- replay-stage-link-plan [closure rowset path expected-sha omission-control guarded?]
 (let [bytes (File/read! path)
       _ (assert (= expected-sha (artifact/sha bytes)))
       plan (read-registry-member bytes)
       _ (assert (and (= :native-stage-link-plan-v1 (:schema plan))
                      (= (:sdk plan) (:sdk-pin closure))
                      (= (:options plan) (:options closure))
                      (= (:order plan) (:order closure))
                      (= (set (:order closure)) (set (keys (:members plan))))))
       rows (:rows rowset)
       [row-index core-index :as index] (stage-row-index closure rows)
       live (when guarded? (link-key-membership (concat (keys row-index) (keys core-index))))
       members (if omission-control [omission-control] (:order closure))
       results (mapv (fn [ns]
                       (let [prior (get-in plan [:members ns])
                             _ (assert (some? prior) ns)
                             prior (if omission-control (assoc prior :inputs []) prior)
                             result (replay-stage-link-member closure rows index ns prior live)]
                        (when omission-control
                         (assert (= :candidate-link-not-installed (:fallback result)))
                         (assert (seq (:omitted-inputs result))))
                        result))
                     members)]
  {:schema "bl.native.edited-stage-link-plan-shadow" :version 1 :reuse-authority false
   :donor (:donor plan) :plan-sha256 expected-sha :candidate-link-rows-sha256 (:sha256 rowset)
   :guarded guarded? :table-id-control (when guarded? (stage-link-table-id-control))
   :omission-control omission-control :members results}))

(defn- stage-link-subset-member [closure rows row-index core-index ns timed?]
 (let [member (get-in closure [:units ns])
       _ (assert (some? member))
       compile! (fn []
                  (let [prepared (build/prepare-ns (:path member))
                        compiled (lower-with-snapshot prepared)]
                   [(prepared-inputs prepared)
                    (assoc (dissoc compiled :cache-status :cache-key) :source (:source prepared)
                           :module (BeamLisp.Link/module_for ns) :base-module (BeamLisp.Emit/base_module_for ns))]))
       scoped (fn [install action]
                (BeamLisp.Env/isolated
                 (fn []
                  (install)
                  (BeamLisp.Compiler/with_fresh_names action))))
       install-full #(install-batched-rows! closure rows)
       [full observed] (scoped install-full #(trace! compile! {:registry? true :registry-inputs? true :link-scan-patterns? true}))
       effects (:effects observed)
       input-links (into (set (keys (:reads (link-receipt observed))))
                         (keep (fn [[_ slot key]]
                                 (when (and (= :own slot) (erlang/is_tuple key) (= 3 (erlang/tuple_size key))
                                            (= :link (elem key 0)))
                                  [(elem key 1) (elem key 2)]))
                               (keys (:registry-inputs effects))))
       select-member (fn [] [(select-indexed-link-rows row-index input-links)
                             (select-indexed-link-rows core-index input-links)])
       [retained retained-core] (select-member)
       scans (:link-scan-patterns effects)
       _ (assert (= (get-in effects [:registry-calls [:match_object 2]] 0) (reduce + 0 (vals scans))))
       install-subset (fn []
                       (let [[rows core-links] (select-member)]
                        (install-batched-rows! (assoc closure :core-links core-links) rows)))
       subset (scoped install-subset compile!)
       sample (when timed?
                (fn [mode]
                 (let [install (if (= :full mode) install-full install-subset)
                       install-cost (volatile! nil)
                       [result total] (phase-cost #(scoped (fn []
                                                           (let [[_ cost] (phase-cost install)]
                                                            (vswap! install-cost (fn [_] cost))))
                                                          compile!))]
                  (assert (erlang/=:= full result) (str "Timed " (name mode) " changed output for " ns))
                  {:mode mode :total total :row-install @install-cost})))]
  (assert (erlang/=:= member (second full)) (str "Full link run drifted for " ns))
  (assert (erlang/=:= full subset) (str "Stage or compilation changed after pruning rows for " ns))
  {:namespace ns :full-rows (+ (count rows) (count (:core-links closure)))
   :subset-rows (+ (count retained) (count retained-core)) :observed-link-reads (:calls observed)
   :exact-prepared-inputs true :exact-unit true
   :untraced-samples (when timed? (mapv sample [:full :subset :subset :full]))
   :match-object-patterns (mapv (fn [[relation calls]] {:relation relation :calls calls
                                                       :disjoint-from-link-rows (disjoint-link-pattern? relation)})
                                (sort-by (comp pr-str first) scans))
   :remaining-table-read-operations
   (vec (keep (fn [[[operation arity] calls]]
                (when-not (or (contains? registry-writes operation) (contains? #{:lookup :member} operation)
                              (and (= [:match_object 2] [operation arity])
                                   (every? disjoint-link-pattern? (keys scans))))
                 [operation arity calls]))
              (sort (:registry-calls effects))))}))

(defn- stage-link-subset [closure rowset selected option]
 (let [rows (:rows rowset)
       [[row-index core-index] index-cost]
       (phase-cost (fn [] [(indexed-link-rows rows (fn [[provider name _ _]] [provider name]))
                           (indexed-link-rows (:core-links closure) (fn [[name _]] ["core" name]))]))
       members (cond
                 (= selected "--all") (:order closure)
                 (and selected (not= selected "--timed")) [selected]
                 :else ["rt" "compiler" "native.scheme" "host.link" "host.delay" "sugar"])
       timed? (or (= selected "--timed") (= option "--timed"))]
  {:schema "bl.native.stage-link-subset-shadow" :version 3 :reuse-authority false
   :link-rows-sha256 (:sha256 rowset) :pattern-controls (link-pattern-control) :index-build index-cost
   :members (mapv #(stage-link-subset-member closure rows row-index core-index % timed?) members)}))

(defn run-observation [argv]
 (let [[partition rows selected output comparison source-receipt mode qualification receipt-sha closure-output] argv]
 (let [closure (artifact/read-closure partition)
       pinned-rows (fn [path] (let [rowset (read-rows path)]
                               (assoc rowset :local-links (local-links closure (:rows rowset)))))
       baseline (pinned-rows rows)
       source-shadow? (= selected "--source-shadow")
       candidate (when (and comparison (not source-shadow?)
                            (not (contains? #{"--phase-compile" "--registry-phases" "--registry-inputs" "--declaration-snapshot" "--ambient-roots" "--stage-link-subset"
                                              "--capture-stage-link-plan" "--replay-stage-link-plan" "--guard-stage-link-plan"
                                              "--cached-registry" "--capture-bound-registry" "--bound-registry" "--bound-env-control" "--bound-export"
                                              "--bound-registry-controls" "--lowering-effects"} selected)))
                   (pinned-rows comparison))
       report (cond
                (= selected "--capture-source") (capture-source closure baseline)
                source-shadow? (source-shadow closure baseline comparison source-receipt)
                (= selected "--macro-context-control") (macro-context-control closure baseline)
                (= selected "--phase-macros") (sample-phase-macros closure baseline)
                (= selected "--phase-compile") (compile-with-phase-macros closure baseline comparison)
                (= selected "--registry-phases") (registry-phases closure baseline comparison false)
                (= selected "--registry-inputs") (registry-phases closure baseline comparison true)
                (= selected "--registry-shadow") (registry-shadow closure baseline candidate source-receipt)
                (= selected "--lowering-effects") (lowering-effects closure baseline comparison source-receipt)
                (= selected "--env-read-control") (env-read-control output)
                (= selected "--runtime-read-control") (runtime-read-control)
                (= selected "--code-read-control") (code-read-control output)
                (= selected "--resolver-read-control") (resolver-read-control output)
                (= selected "--capture-registry") (capture-registry closure baseline candidate source-receipt nil)
                (= selected "--capture-bound-registry") (capture-bound-registry closure baseline comparison source-receipt)
                (= selected "--cached-registry") (cached-registry closure baseline comparison source-receipt (= "--force-lower" mode))
                (contains? #{"--bound-registry" "--bound-env-control" "--bound-export"} selected)
                (let [root (when (= selected "--bound-env-control") (Path/expand (str output ".unused-root")))
                      export-path (when (= selected "--bound-export") closure-output)]
                 (assert (or (nil? root) (not (File/exists? root))))
                 (when (and (= selected "--bound-export")
                            (or (nil? export-path) (= (Path/expand output) (Path/expand export-path))))
                  (throw (ex-info "Pass a separate new closure destination for --bound-export" {})))
                 (replay-bound-registry closure baseline comparison source-receipt
                  (if (= partition mode) closure (artifact/read-closure mode)) qualification receipt-sha root export-path false nil))
                (= selected "--bound-registry-controls") (bound-registry-controls closure baseline comparison source-receipt mode)
                (= selected "--declaration-snapshot") (declaration-snapshot-report closure baseline comparison)
                (= selected "--ambient-roots") (ambient-root-report closure baseline comparison)
                (= selected "--ambient-roots-control") (ambient-root-control output)
                (= selected "--source-probe-control") (source-probe-control output)
                (= selected "--row-install-control") (row-install-control closure (:rows baseline))
                (= selected "--stage-link-subset") (stage-link-subset closure baseline comparison source-receipt)
                (= selected "--capture-stage-link-plan") (capture-stage-link-plan closure baseline comparison)
                (contains? #{"--replay-stage-link-plan" "--guard-stage-link-plan"} selected)
                (replay-stage-link-plan closure baseline comparison source-receipt mode (= selected "--guard-stage-link-plan"))
                (= selected "--outer-control") (outer-control)
                (= selected "--write-control") (write-control)
                (= selected "--shadow") (observe-shadow closure baseline candidate)
                (= selected "--sequential") (observe-sequential closure baseline false)
                (= selected "--sequential-scoped") (observe-sequential closure baseline true)
                (= selected "--all")
                {:schema "bl.native.link-observation-inventory" :version 4
                 :members (mapv (fn [ns] (observe closure baseline ns candidate)) (:order closure))
                 :reuse-authority false}
                :else (observe closure baseline selected candidate))]
  (File/write! output (if (contains? #{"--capture-source" "--capture-registry" "--capture-bound-registry" "--capture-stage-link-plan"} selected)
                       (BeamLisp.CompilerData/check_closed_etf! (erlang/term_to_binary report (list :deterministic)) artifact/limits)
                       (json/encode report)))
  (when (or (contains? #{"--shadow" "--registry-shadow" "--cached-registry" "--bound-registry" "--bound-env-control" "--bound-export"} selected) source-shadow?)
   (let [different (mapv :namespace (remove :exact-clean-definitions (:members report)))]
    (when (seq different)
     (throw (ex-info "Selective relink differs from the qualified clean closure" {:members different})))))
  (when (= selected "--phase-compile")
   (let [different (mapv :namespace (remove :same-definitions (:interpreted report)))
         resolution (fn [members] (mapv #(get-in % [:macro-lookup :resolution-sha256]) members))]
    (when (seq different)
     (throw (ex-info "Interpreted macro compilation differs from the qualified clean closure" {:members different})))
    (when-not (= (resolution (:ordinary report)) (resolution (:interpreted report)))
     (throw (ex-info "Interpreted macro compilation changed macro lookup decisions" {}))))))))
