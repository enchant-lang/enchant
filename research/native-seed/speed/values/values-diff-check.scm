  (else (old-bl-key-compare a b)))))

;; ---- Differential checks: former (old-*) versus current host procedures ----
(define diff-checks 0)
(define diff-failures 0)
(define (diff-fail! label detail)
 (set! diff-failures (+ diff-failures 1))
 (if (< diff-failures 20)
  (begin (display "DIFF FAIL ") (display label) (display ": ") (write detail) (newline))))
(define diff-error (list 'diff-error))
(define (diff-try thunk) (with-exception-catcher (lambda (e) diff-error) thunk))
;; Same outcome: both raise, or both return values equal under SAME.
(define (diff-same! label same old new detail)
 (set! diff-checks (+ diff-checks 1))
 (let ((a (diff-try old)) (b (diff-try new)))
  (if (not (if (or (eq? a diff-error) (eq? b diff-error)) (eq? a b) (same a b)))
   (diff-fail! label (list detail a b)))))
(define (diff-list-eq? a b)
 (cond ((null? a) (null? b)) ((null? b) #f)
       (else (and (eq? (car a) (car b)) (diff-list-eq? (cdr a) (cdr b))))))
;; Pairs lists compare by key/value identity (fresh tuples differ in identity).
(define (diff-pairs-eq? a b)
 (diff-list-eq? (apply append (map bl-items a)) (apply append (map bl-items b))))

(define diff-seed 12345)
(define (diff-random n)
 (set! diff-seed (modulo (+ (* diff-seed 1103515245) 12345) 2147483648))
 (modulo (quotient diff-seed 65536) n))

(define diff-fragment (native-from-utf16 (list 97 55296 98)))
(define diff-fragment-2 (native-from-utf16 (list 56320)))
(define diff-proc-a (lambda (x) x))
(define diff-proc-b (lambda (x) x))
(define diff-scalars
 (list bl-nil #t #f '()
  (bl-key "a") (bl-key "b") (bl-key "ab") (bl-key "") (bl-key "line") (bl-key "lines") (bl-key "z")
  (bl-key "Elixir.BeamLisp.Decimal") (bl-key "\x1F600;") (bl-key "\xFFFF;") (bl-key "é")
  (string->symbol ":nil") (string->symbol ":true") (string->symbol ":false")
  (bl-key diff-fragment) (bl-key diff-fragment-2)
  'plain-symbol 'other-plain
  0 1 -1 2 3 7 100 -100 536870911 -536870912 2305843009213693951 -2305843009213693952
  (expt 2 70) (- (expt 2 70)) (+ (expt 2 70) 1) 1/2 -3/4
  (bl-float 0) (bl-float 1) (bl-float -1) (bl-float 1.5) (bl-float -0.0) (bl-float 1e300) 1.5 -0.0
  (bl-decimal 10 1) (bl-decimal 1 0) (bl-decimal 15 1) (bl-decimal -3 2)
  "" "a" "b" "ab" "abc" "B" "line" "lines" "é" "\xFFFF;" "\x1F600;" "\x1F600;a" "a\x1F600;" "\x10000;" "\xE000;"
  diff-fragment diff-fragment-2
  diff-proc-a diff-proc-b car (native-make-reference) (native-make-reference)
  (native-ref-new 'atom 1) (vector 'nil) (vector 'other 1) (vector 'tuple) #\a))
(define diff-composites
 (list '(1 2) '(1 2 3) '(1) '(2) '(1 . 2) '(1 2 . 3) '((1) 2) (list (bl-key "a")) (list "a" "b") (list diff-proc-a)
  (bl-tuple '()) (bl-tuple '(1)) (bl-tuple '(1 2)) (bl-tuple '(1 3)) (bl-tuple '(2)) (bl-tuple (list (bl-key "a") 1))
  (bl-tuple (list (bl-key "a") (bl-float 1))) (bl-tuple (list diff-proc-b 1)) (bl-tuple (list (bl-tuple '(1)) '(2)))
  (bl-vec '()) (bl-vec '(1)) (bl-vec '(1 2)) (bl-vec '(1 2 3)) (bl-vec (list (bl-float 1) 2)) (bl-vec '((1) 2))
  (bl-empty-map) (bl-map (bl-key "a") 1) (bl-map (bl-key "a") (bl-float 1)) (bl-map (bl-key "a") 1 (bl-key "b") 2)
  (bl-map (bl-key "b") 2 (bl-key "a") 1) (bl-map 1 (bl-key "a")) (bl-map "k" '(1))
  (native-set-from-list '()) (native-set-from-list '(1 2)) (native-set-from-list '(2 1)) (native-set-from-list (list (bl-key "a")))
  (native-set-from-list (list diff-proc-a 1))))
(define (diff-iota n) (let loop ((i (- n 1)) (out '())) (if (< i 0) out (loop (- i 1) (cons i out)))))
(define diff-big-map
 (let loop ((i 0) (m (bl-empty-map))) (if (= i 40) m (loop (+ i 1) (bl-assoc m (if (even? i) i (bl-key (number->string i))) i)))))
(define diff-big-map-float
 (let loop ((i 0) (m (bl-empty-map))) (if (= i 40) m (loop (+ i 1) (bl-assoc m (if (even? i) i (bl-key (number->string i))) (if (= i 7) (bl-float 7) i))))))
(define diff-corpus
 (append diff-scalars diff-composites
  (list diff-big-map diff-big-map-float (bl-vec (diff-iota 33)) (bl-vec (diff-iota 40)) (native-set-from-list (diff-iota 20)))))

;; 1. Pairwise compare, raw equality, language equality and Erlang order.
(for-each (lambda (a)
 (for-each (lambda (b)
  (diff-same! "bl-key-compare" eqv? (lambda () (old-bl-key-compare a b)) (lambda () (bl-key-compare a b)) (list a b))
  (diff-same! "bl-key-equal?" eq? (lambda () (old-bl-key-equal? a b)) (lambda () (bl-key-equal? a b)) (list a b))
  (diff-same! "bl-equal?" eq? (lambda () (old-bl-equal? a b)) (lambda () (bl-equal? a b)) (list a b))
  (diff-same! "erlang-equal" eq? (lambda () (old-native-erlang-equal? a b)) (lambda () (native-erlang-equal? a b)) (list a b))
  (diff-same! "term-compare" eqv? (lambda () (old-native-term-compare a b)) (lambda () (native-term-compare a b)) (list a b)))
  diff-corpus)) diff-corpus)

;; 2. Unary predicates and projections.
(for-each (lambda (x)
 (diff-same! "native-keyword?" eq? (lambda () (old-native-keyword? x)) (lambda () (native-keyword? x)) x)
 (diff-same! "native-key-rank" eqv? (lambda () (old-native-key-rank x)) (lambda () (native-key-rank x)) x)
 (diff-same! "native-atom-name" equal? (lambda () (old-native-atom-name x)) (lambda () (native-atom-name x)) x)
 (diff-same! "native-number?" eq? (lambda () (old-native-number? x)) (lambda () (native-number? x)) x)
 (diff-same! "native-struct-module" eq? (lambda () (old-native-struct-module x)) (lambda () (native-struct-module x)) x)
 (diff-same! "bl-items" diff-list-eq? (lambda () (old-bl-items x)) (lambda () (bl-items x)) x)
 (diff-same! "h-map-keys" diff-list-eq? (lambda () (old-h-map-keys x)) (lambda () (h-map-keys x)) x)
 (diff-same! "native-set-items" diff-list-eq? (lambda () (old-native-set-items x)) (lambda () (native-set-items x)) x)
 (diff-same! "native-map-pairs" diff-pairs-eq? (lambda () (old-native-map-pairs x)) (lambda () (native-map-pairs x)) x)
 (for-each (lambda (n)
  (diff-same! "bl-nth" eq? (lambda () (old-bl-nth x n)) (lambda () (bl-nth x n)) (list x n))
  (diff-same! "bl-nth/default" eq? (lambda () (old-bl-nth x n 'dflt)) (lambda () (bl-nth x n 'dflt)) (list x n)))
  (list -1 0 1 2 5 32 39 40 (expt 2 70) 1.0)))
 diff-corpus)

;; 3. Vector construction: identical trie storage for every size and the
;; improper-input path.
(let loop ((n 0))
 (if (<= n 140)
  (let ((xs (map (lambda (i) (if (= i 3) #f (* i 10))) (diff-iota n))))
   (diff-same! "bl-vec storage" equal? (lambda () (old-bl-vec xs)) (lambda () (bl-vec xs)) n)
   (diff-same! "bl-vec items" equal? (lambda () (old-bl-items (old-bl-vec xs))) (lambda () (bl-items (bl-vec xs))) n)
   (diff-same! "bl-vec conj" equal? (lambda () (bl-conj (old-bl-vec xs) 'x)) (lambda () (bl-conj (bl-vec xs) 'x)) n)
   (loop (+ n 1)))))
(diff-same! "bl-vec improper" equal? (lambda () (old-bl-vec '(1 2 . 3))) (lambda () (bl-vec '(1 2 . 3))) 'improper)

;; 4. Maps: random assoc/remove/literal sequences over scalar, composite and
;; opaque keys; storage, lookups, membership, counts and iteration agree.
(define diff-keys (append diff-scalars diff-composites))
(define diff-key-vector (list->vector diff-keys))
(define (diff-pick) (vector-ref diff-key-vector (diff-random (vector-length diff-key-vector))))
(define (diff-map-agree! label old new)
 (set! diff-checks (+ diff-checks 1))
 (if (not (equal? (vector-ref old 1) (vector-ref new 1))) (diff-fail! (string-append label " storage") (list old new)))
 (diff-same! (string-append label " pairs") diff-pairs-eq? (lambda () (old-native-map-pairs old)) (lambda () (native-map-pairs new)) label)
 (diff-same! (string-append label " count") eqv? (lambda () (native-map-count old)) (lambda () (native-map-count new)) label)
 (for-each (lambda (k)
  (diff-same! (string-append label " get") eq? (lambda () (old-bl-get old k)) (lambda () (bl-get new k)) k)
  (diff-same! (string-append label " get/default") eq? (lambda () (old-bl-get old k 'absent)) (lambda () (bl-get new k 'absent)) k)
  (diff-same! (string-append label " has?") eq? (lambda () (old-native-map-has? old k)) (lambda () (native-map-has? new k)) k)
  (diff-same! (string-append label " entry") equal? (lambda () (old-native-map-entry old k)) (lambda () (native-map-entry new k)) k)
  (diff-same! (string-append label " ref") eq?
   (lambda () (let ((e (old-native-map-entry old k))) (if (eq? e native-missing) 'none (cdr e))))
   (lambda () (native-map-ref new k 'none)) k))
  diff-keys))
(let rounds ((round 0))
 (if (< round 60)
  (let ((steps (+ 1 (diff-random 40))))
   (let walk ((step 0) (old (old-bl-map)) (new (bl-map)))
    (if (< step steps)
     (let* ((op (diff-random 10)) (k (diff-pick)) (v (if (= 0 (diff-random 3)) (diff-pick) step)))
      (cond ((< op 7) (walk (+ step 1) (old-bl-assoc old k v) (bl-assoc new k v)))
       ((< op 9) (walk (+ step 1) (old-native-map-remove old k) (native-map-remove new k)))
       (else (let ((old2 (old-bl-assoc old k (old-bl-get old k))) (new2 (bl-assoc new k (bl-get new k))))
        (walk (+ step 1) old2 new2)))))
     (begin
      (diff-map-agree! "random map" old new)
      (let ((k (diff-pick)))
       (diff-same! "map equality" eq? (lambda () (old-bl-equal? old (old-bl-assoc old k 1)))
        (lambda () (bl-equal? new (bl-assoc new k 1))) k))
      (rounds (+ round 1))))))))
;; Literal construction, duplicate keys and the >16 pair fallback.
(let rounds ((round 0))
 (if (< round 60)
  (let* ((n (diff-random 22))
         (kvs (let loop ((i 0) (out '())) (if (= i n) out (loop (+ i 1) (cons (diff-pick) (cons i out)))))))
   (diff-map-agree! "bl-map literal" (apply old-bl-map kvs) (apply bl-map kvs))
   (rounds (+ round 1)))))
(diff-same! "bl-map odd" eq? (lambda () (old-bl-map 1 2 3)) (lambda () (bl-map 1 2 3)) 'odd)
;; Small-map search positions themselves, against every corpus key.
(for-each (lambda (m)
 (if (native-map-small? (vector-ref m 1))
  (for-each (lambda (k)
   (diff-same! "small-map-search" eqv? (lambda () (old-native-small-map-search (vector-ref m 1) k))
    (lambda () (native-small-map-search (vector-ref m 1) k)) k)) diff-keys)))
 (list (apply bl-map (apply append (map (lambda (k) (list k 1)) (native-take diff-keys 16))))
       (apply bl-map (apply append (map (lambda (k) (list k 1)) (native-take (reverse diff-keys) 16))))
       (bl-map (bl-key "a") 1 (bl-key "c") 2 "x" 3 4 5 '(1) 6)))

;; 5. Map pattern matching (flat patterns) still binds the same values.
(for-each (lambda (k)
 (diff-same! "bl-match map" equal?
  (lambda () (old-bl-match (list 'map (list (list k (list 'var "x")))) diff-big-map '()))
  (lambda () (bl-match (list 'map (list (list k (list 'var "x")))) diff-big-map '())) k))
 (append diff-keys (list 0 2 38 (bl-key "1") (bl-key "39"))))

(display "native value differential checks: ") (display diff-checks)
(display " failures: ") (display diff-failures) (newline)
(if (> diff-failures 0) (exit 1))
(display "NATIVE_VALUE_DIFFERENTIAL_PASS") (newline)
