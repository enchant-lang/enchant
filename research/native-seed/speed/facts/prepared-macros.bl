; Run with the Source and prepared evaluation bundles on the same image.
(ns native.prepared-macros
  (:require [sugar :as sugar]))

(assert (= 1 (sugar/when-some [flag false] (if flag 0 1))))
(assert (= 8 (sugar/cond-> 3 true inc false (throw :wrong-branch) true (* 2))))
(assert (= 8 (sugar/if-some [value (get {:key 7} :key)] (-> value (+ 1)) -1)))
(assert (= -1 (sugar/if-some [value (get {} :key)] value -1)))
(println "NATIVE_PREPARED_MACROS_OK")
