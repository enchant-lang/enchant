; FACTS (E1): run the existing native fact-scope checks
; (research/native-seed/scan/emission-check.bl: shadowing by let, fn, case and
; loops; is_integer refinement only in the then-branch) against this
; checkout's facts.bl. The pinned SDK predates BeamLisp.Facts, so compile it first.
; Usage: research/native-seed/run run research/native-seed/speed/facts/scope-check.bl -- OUT-DIR
(ns native.facts-scope-check)
(def out-dir (Path/expand (or (first (BeamLisp/argv)) ".local/facts/scope")))
(File/mkdir_p! out-dir)
(code/ensure_loaded :Elixir.BeamLisp.Facts)
(when-not (erlang/function_exported :Elixir.BeamLisp.Facts :function-facts 2)
 (BeamLisp.Env/isolated (fn [] (BeamLisp.AOT/compile_host_file (Path/expand "priv/host/facts.bl")
  (list (tuple :module :Elixir.BeamLisp.Facts) (tuple :output_dir out-dir)
        (tuple :file (Path/expand "priv/host/facts.bl")))))))
(BeamLisp/run_file (Path/expand "research/native-seed/scan/emission-check.bl"))
