(ns native.try-total)

(assert (= 5 (try (erlang/+ 2 3) (catch _ :unexpected))))
(let [events (atom [])]
  (assert (= 7 (try 7
                (catch _ (swap! events conj :unexpected))
                (finally (swap! events conj :cleanup)))))
  (assert (= [:cleanup] @events)))

(let [events (atom [])
      fail (fn [] (erlang/throw :body))]
  (assert (= :body (try (fail)
                    (catch reason (swap! events conj :caught) reason)
                    (finally (swap! events conj :cleanup)))))
  (assert (= [:caught :cleanup] @events)))

(assert (= :cleanup (try (try :body (finally (erlang/throw :cleanup))) (catch reason reason))))
(println "NATIVE_RAISE_FREE_BODY_PASS")
