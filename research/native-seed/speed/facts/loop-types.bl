(ns native.loop-types)

(defn total [limit]
  (loop [index 0, sum 0]
    (if (erlang/< index limit)
      (recur (erlang/+ index 1) (erlang/+ sum index))
      sum)))

(assert (= 0 (total 0)))
(assert (= 496 (total 32)))

(defn changes-on-a-later-edge []
  (loop [phase 0, value 1, dependent 0]
    (if (erlang/== phase 0)
      (recur 1 :changed value)
      (if (erlang/== phase 1)
        (recur 2 value value)
        (erlang/== dependent 0)))))

(assert (= false (changes-on-a-later-edge)))
(println "NATIVE_LOOP_TYPES_PASS")
