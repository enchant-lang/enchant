;; N3 sealed-vs-dev differential in gsi: answers of compiled clojure.string on
;; the round-2 dev image, then after loading the SEALED re-emission of
;; sugar, server-clause, reader-node and clojure.string (seal-diff.bl output)
;; and sealing the image.
;; gsi -e '(load HOST)' -e '(load IMAGE-BODY)' seal-units-check.scm
(define (call ns name . args) (bl-invoke (native-global ns name) args))
(define (answers)
 (list (call "clojure.string" "join" ", " (list "a" "b" "c"))
       (call "clojure.string" "join" (list 1 2 3))
       (call "clojure.string" "upper-case" "straße")
       (call "clojure.string" "lower-case" "ÀB")
       (call "clojure.string" "trim" "  x y  ")
       (call "clojure.string" "triml" "  x ")
       (call "clojure.string" "blank?" "   ")
       (call "clojure.string" "includes?" "haystack" "st")
       (call "clojure.string" "starts-with?" "native" "nat")
       (call "clojure.string" "ends-with?" "native" "ive")
       (call "clojure.string" "replace" "a-b-c" "-" "+")
       (call "clojure.string" "capitalize" "hello")
       (call "clojure.string" "reverse" "abc")
       (call "clojure.string" "index-of" "banana" "an")
       (call "clojure.string" "last-index-of" "banana" "an")
       (call "clojure.string" "split-lines" "a\nb\r\nc")))
(define dev (answers))
(for-each (lambda (f) (load f))
 '("/tmp/r3link/seal/sealed-sugar.scm" "/tmp/r3link/seal/sealed-server-clause.scm"
   "/tmp/r3link/seal/sealed-reader-node.scm" "/tmp/r3link/seal/sealed-clojure.string.scm"))
(define sealed-loaded (answers))
(native-seal-image!)
(define sealed (answers))
(define (same? a b) (bl-equal? (bl-vec a) (bl-vec b)))
(display "SEAL_UNITS answers=") (display (length dev))
(display " sealed-text-equal=") (display (same? dev sealed-loaded))
(display " after-seal-equal=") (display (same? dev sealed))
(newline)
(if (not (and (same? dev sealed-loaded) (same? dev sealed))) (exit 1))
(display "SEAL_UNITS_PASSED") (newline)
(exit 0)
