; Run a BL script on the pinned SDK with this checkout's Elixir.BeamLisp.Facts
; (priv/host/facts.bl, E1) compiled and loaded first: the pinned SDK predates
; it, and native.scheme reads facts through it. (speed/facts/sites.bl's `hot`.)
; Usage: run speed/backend3/facts-run.bl -- FACTS.bl SCRIPT.bl ARGS...
(ns backend3.facts-run (:require [compiler :as compiler]))
(def args (BeamLisp/argv))
(def facts-path (Path/expand (first args)))
(def script (second args))
(def ebin (str (System/tmp_dir!) "/backend3-facts-" (System/unique_integer (list :positive))))
(File/mkdir_p! ebin)
(BeamLisp.Env/isolated
 (fn [] (BeamLisp.AOT/compile_host_file facts-path
         (list (tuple :module :Elixir.BeamLisp.Facts) (tuple :output_dir ebin) (tuple :file facts-path)))))
(println "BACKEND3_FACTS_LOADED" (erlang/function_exported :Elixir.BeamLisp.Facts :expr 2))
(BeamLisp/with_argv (lists/nthtail 2 args)
 (fn [] (compiler/eval_string (File/read! script) (compiler/new-env "user") script)))
