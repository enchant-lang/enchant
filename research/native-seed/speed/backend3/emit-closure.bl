; Whole-closure AOT emission with the ONE link plan, as `native.chunks inspect`
; does for every named definition, without its check that the main checkout's
; sources still match the closure (they moved on after integration; the
; closure's own parts carry the ANF). Order: units in closure order, then
; definitions in unit order.
; Usage: run speed/backend3/emit-closure.bl -- PARTITION.json LEAVES.json OUT.scm
(ns native.backend3-closure
 (:require [native.artifact :as artifact] [native.bootstrap :as bootstrap]
           [clojure.string :as string] [bl.json :as json] [native.resolution-ledger :as ledger]))
(def args (BeamLisp/argv))
(def closure (artifact/read-closure (nth args 0)))
(def leaves (set (get (json/decode (File/read! (nth args 1))) "registered_leaves")))
(def units (mapv #(get (:units closure) %) (:order closure)))
(def plan (bootstrap/link-plan (ledger/bundle-metadata closure leaves) units))
(def text
 (string/join ""
  (for [u units d (:defs u) :when (:name d)]
   (bootstrap/emit-definition plan u d))))
(File/write! (nth args 2) text)
(println (str "BACKEND3_CLOSURE_EMITTED " (count units) " units " (erlang/byte_size text) " bytes, sealed "
              (:sealed? plan)))
