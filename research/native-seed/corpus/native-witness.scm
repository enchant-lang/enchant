;; Observation/configuration only. Append after source-frame ABI and the shared
;; actor-invariants.scm sampler, BEFORE emitted original runtime/application.
(define native-corpus-budget-name (or (getenv "NATIVE_ACTOR_BUDGET" #f) "default"))
(define native-corpus-budget
 (cond ((string=? native-corpus-budget-name "default") #f)
       ((string=? native-corpus-budget-name "17") 17)
       ((string=? native-corpus-budget-name "41") 41)
       (else (error "unsupported original-corpus budget" native-corpus-budget-name))))
(if (not native-virtual-time?) (error "original-corpus semantic run requires the recorded virtual clock"))
(define native-corpus-max-procs 0)
(define native-corpus-max-monitors 0)
(define native-corpus-max-tables 0)
(define native-corpus-max-links 0)
(define native-corpus-sampled-turn h-run-turn)
(define (native-corpus-observe)
 (let ((procs (bl-get seed-state (bl-key "procs"))))
  (if (and (= seed-critical 0) (not (bl-is-nil procs)))
   (begin
    (set! native-corpus-max-procs (max native-corpus-max-procs (h-map-size procs)))
    (set! native-corpus-max-monitors (max native-corpus-max-monitors (h-map-size (bl-get seed-state (bl-key "monitors")))))
    (set! native-corpus-max-tables (max native-corpus-max-tables (h-map-size (bl-get seed-state (bl-key "tables")))))
    (let ((links 0))
     (for-each (lambda (pid) (set! links (+ links (h-map-size (bl-get (bl-get procs pid) (bl-key "links"))))))
      (h-map-keys procs))
     (set! native-corpus-max-links (max native-corpus-max-links links)))))))
(set! h-run-turn (lambda (frames budget)
 (native-corpus-observe)
 (let ((answer (native-corpus-sampled-turn frames (or native-corpus-budget budget))))
  (native-corpus-observe) answer)))
(native-mark-host-callable! h-run-turn)
(bl-register-callable! h-run-turn 2)
(define (native-corpus-finish)
 (native-sample-boundary)
 (native-corpus-observe)
 (if (not (null? seed-errors)) (error "original corpus recorded runtime errors"))
 (for-each (lambda (name)
  (if (not (= 0 (h-map-size (bl-get seed-state (bl-key name)))))
   (error "original corpus final resource leak" name)))
  '("procs" "monitors" "tables" "names" "table-names"))
 (if (not (= 0 (h-vec-size (bl-get seed-state (bl-key "runnable"))))) (error "original corpus runnable leak"))
 (if (not (bl-is-nil (bl-get seed-state (bl-key "input-sink")))) (error "original corpus input sink leak"))
 (if (not (= 0 seed-critical)) (error "original corpus critical depth leak"))
 (if (not (and (> native-boundary-samples 0) (> native-boundary-deaths 0)
               (> native-corpus-max-procs 0) (> native-corpus-max-monitors 0)
               (> native-corpus-max-tables 0) (> native-corpus-max-links 0)))
  (error "original corpus lacks required lifecycle observations"))
 (display "NATIVE_CORPUS_WITNESS {\"budget\":\"") (display native-corpus-budget-name)
 (display "\",\"samples\":") (display native-boundary-samples)
 (display ",\"deaths\":") (display native-boundary-deaths)
 (display ",\"max_procs\":") (display native-corpus-max-procs)
 (display ",\"max_monitors\":") (display native-corpus-max-monitors)
 (display ",\"max_tables\":") (display native-corpus-max-tables)
 (display ",\"max_links\":") (display native-corpus-max-links)
 (display ",\"cleanup\":{\"procs\":0,\"monitors\":0,\"tables\":0,\"names\":0,\"table_names\":0,\"runnable\":0,\"input_sink\":null,\"critical\":0,\"errors\":0}}\n"))
