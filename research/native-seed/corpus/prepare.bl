; One canonical compilation of the ORIGINAL complete acceptance source. No
; rewritten test file, assertion replacement, scheduler or ANF interpretation.
(ns native.prepare-original-corpus
 (:require [native.proc-link :as linker] [bl.json :as json]))
(def base "research/native-seed")
(def args (BeamLisp/argv))
(def closure-dir (or (first args) (str base "/out/compiler-closure")))
(def out (or (second args) (str base "/out/original-actor-corpus")))
(def app "research/js-actors/test.bl")
(def runtime "priv/lib/js/actor/runtime.bl")
(def extensions [(str base "/host/host-source-frames.scm")
                 (str base "/host/actor-invariants.scm")
                 (str base "/corpus/native-witness.scm")])
(def result (linker/build-project
 {:application app :runtime runtime :bridges (str base "/bridges.bl")
  :links (str base "/actor-links.edn") :sdk-pin (str base "/sdk-pin.json")
  :host-link (str base "/host/host-proc-link.scm")
  :prelude (str closure-dir "/prelude.scm")
  :closure-manifest (str closure-dir "/partition.json") :leaves (str closure-dir "/leaves.json")
  :host-extensions extensions :source-frames? true :original-actor-corpus? true}))
(when-not (String/contains? (:program result) "(bl-source-call ")
 (throw (ex-info "original corpus requires the source-call emitter; source frames were not emitted" {})))
(when-not (= 202 (get-in result [:manifest :runtime-definitions]))
 (throw (ex-info "original corpus requires every canonical runtime definition" {})))
(File/mkdir_p! out)
(def program-path (str out "/program.scm"))
(def prelude-source (File/read! (str closure-dir "/prelude.scm")))
(def program (str (:program result) "\n(native-corpus-finish)\n"))
(when-not (String/starts_with? program (str prelude-source "\n"))
 (throw (ex-info "original corpus prelude boundary differs; cannot produce an exact body" {})))
(File/write! program-path program)
(def body-offset (inc (erlang/byte_size prelude-source)))
(File/write! (str out "/body.scm") (binary/part program body-offset (- (erlang/byte_size program) body-offset)))
(File/write! (str out "/program.anf.etf")
 (erlang/term_to_binary {:schema "bl.native.anf-unit" :version 1 :definitions (:definitions result)
                       :entry (:entry result) :link-manifest (:manifest result)} (list :deterministic)))
(File/write! (str out "/manifest.json")
 (json/encode {:schema "bl.native.original-actor-corpus" :version 1 :target :scheme
  :status :prepared-not-executed :application (linker/source-identity app)
  :runtime (linker/source-identity runtime) :assertion-adaptation :none :source-path-adaptation :none
  :clock :virtual-deadlines :link (:manifest result)
  :inputs (mapv linker/source-identity
   (concat [app runtime (str base "/bridges.bl") (str base "/actor-links.edn")
            (str base "/sdk-pin.json") (str base "/src/native/proc-link.bl")
            (str base "/src/native/proc.bl") (str base "/src/native/scheme.bl")
            (str base "/corpus/prepare.bl")] extensions))
  :artifact (linker/source-identity program-path)
  :body (linker/source-identity (str out "/body.scm"))}))
(println (str "ORIGINAL_ACTOR_CORPUS_PREPARED " (count (:definitions result)) " exact source bodies"))
