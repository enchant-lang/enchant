; Prepare ONLY a new original production-JS actor baseline. The immutable
; canonical graph and historical full/native qualification remain untouched.
(ns native.prepare-original-js-only
 (:require [native.js-producer :as producer] [bl.json :as json]))
(def args (BeamLisp/argv))
(def out (or (first args) "research/native-seed/out/original-actor-js-env"))
(def parent (or (second args) "research/native-seed/out/original-actor-js/manifest.json"))
(def native (or (nth args 2 nil) "research/native-seed/out/original-actor-corpus/manifest.json"))
(def source-manifest (json/decode (File/read! native)))
(assert (= {"path" "research/js-actors/test.bl" "sha256" "5f2ad8223fd9f053157b65266d3ee14e7fe8567b6196a78ed7ac955132b9a5c5"}
           (get source-manifest "application")))
(def built (producer/prepare! (producer/activate)
 {:application "research/js-actors/test.bl" :output out :graph-parent parent}))
(File/write! (str out "/manifest.json")
 (json/encode (assoc built :original-body (get source-manifest "body")
   :clock-model (get source-manifest "clock-model") :javascript-clock :node-real-millisecond
   :preparer (producer/identity "research/native-seed/corpus/prepare-js-only.bl"))))
(println "ORIGINAL_ACTOR_JS_ONLY_PREPARED exact production Source; canonical graph reused; native executions=0")
