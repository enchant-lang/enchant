; Baseline generated by the production JS emitter from the SAME original
; source. The canonical core graph is built once; subsequent fixes reuse it.
(ns native.prepare-original-js-corpus
 (:require [js.actor :as actor] [bl.js :as js] [native.proc-link :as linker] [bl.json :as json]))
(def base "research/native-seed")
(def out (or (first (BeamLisp/argv)) (str base "/out/original-actor-js")))
(def graph (str out "/canonical"))
(def app "research/js-actors/test.bl")
(def runtime "priv/lib/js/actor/runtime.bl")
(when-not (= linker/original-actor-corpus (linker/source-identity app))
 (throw (ex-info "original JS baseline requires the exact original acceptance source" {})))
; The production content cache, source admission and compiler identity decide
; reuse. A pre-existing hand-authored/old historical bundle is never trusted.
(js/build! "core" {:out graph})
(actor/write-runtime! out "./canonical/rt.mjs")
(actor/build-one out "test.bl" "bundle.mjs" []
 {:source-root "research/js-actors" :native-manifest (str graph "/native-modules.json")
  :native-base "../canonical"})
(def dependencies (json/decode (File/read! (str graph "/dependencies.json"))))
(def source-inputs
 (mapv (fn [[namespace spec]]
  (let [identity (linker/source-identity (get spec "path"))]
   (when-not (= (:sha256 identity) (get spec "source-sha256"))
    (throw (ex-info "original JS graph source changed during preparation" {:namespace namespace}))) identity))
  (get dependencies "namespaces")))
(def assets (vec (sort (Path/wildcard (str out "/**/*.mjs")))))
(File/write! (str out "/manifest.json")
 (json/encode {:schema "bl.native.original-actor-corpus" :version 1 :target :javascript
  :status :prepared-not-executed :application (linker/source-identity app)
  :runtime (linker/source-identity runtime) :assertion-adaptation :none :source-path-adaptation :none
  :sdk-pin (json/decode (File/read! (str base "/sdk-pin.json")))
  :inputs (vec (concat source-inputs (mapv linker/source-identity
   [app runtime "priv/lib/js/actor.bl" "priv/lib/js/actor/host.mjs" "priv/lib/js/actor/module.mjs"
    "priv/lib/js/emit.bl" (str base "/corpus/prepare-js.bl")
    (str graph "/dependencies.json") (str graph "/native-modules.json")])))
  :assets (mapv linker/source-identity assets)
  :artifact (linker/source-identity (str out "/out/bundle.mjs"))
  :host (linker/source-identity (str out "/host.mjs"))}))
(println "ORIGINAL_ACTOR_JS_PREPARED production emitter; original source")
