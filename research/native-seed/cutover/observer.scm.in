;; Only measurement and publication orchestration are interpreted. All reader,
;; fixture and lowering bodies come from the verified compiled modules/image.
(define cut-checks 0)
(define (cut-check label value)
 (if (not value) (error "cutover prototype failed" label))
 (set! cut-checks (+ cut-checks 1)))
(define (cut-roots)
 (vector native-env-rows native-global-registry native-module-names
         native-namespace-modules native-export-arities native-stub-names))
(define (cut-restore roots)
 (set! native-env-rows (vector-ref roots 0))
 (set! native-global-registry (vector-ref roots 1))
 (set! native-module-names (vector-ref roots 2))
 (set! native-namespace-modules (vector-ref roots 3))
 (set! native-export-arities (vector-ref roots 4))
 (set! native-stub-names (vector-ref roots 5)))
(define cut-original (cut-roots))
(define cut-original-reader bench-reader)
(define cut-reference #f)
(define cut-candidate #f)
(define cut-active #f)
(define (cut-product path initializer guard physical)
 (load path)
 (let ((init (linked-proof-binding initializer)) (check (linked-proof-binding guard)))
  (bench-check-native init) (bench-check-native check)
  (cut-check 'new-native-owners (pair? (linked-proof-parents physical linked-proof-existing-parents)))
  (cut-check 'pinned-primitives (check))
  (bl-invoke init '())
  (vector (cut-roots) (bench-select @NAMESPACE@ "read-string") check)))
(define (cut-select product)
 ;; Closed serial prototype boundary. Refuse before touching serving state.
 ;; This is not the production native generation/custody implementation.
 (if (not ((vector-ref product 2))) (error "pinned primitive changed"))
 (cut-restore (vector-ref product 0))
 (set! bench-reader (vector-ref product 1))
 (set! cut-active product))
(define (cut-read product source)
 (cut-select product)
 (with-exception-catcher
  (lambda (e) (cons 'error (native-exception-reason e)))
  (lambda () (cons 'ok (bl-invoke bench-reader (list source bench-attribution))))))
(define (cut-call name args) (bl-invoke (bench-select @NAMESPACE@ name) args))
(define (cut-observe phase label batch product)
 (cut-select product)
 (let ((action (if (string=? phase "read") bench-parse
                 (lambda () (bench-emit-nodes (bench-compile-forms (bench-parse)))))))
  (bench-repeat 3 action)
  (##get-monotonic-time! bench-clock 1)
  (bench-repeat 5 action)
  (##get-monotonic-time! bench-clock 2)
  (cut-check 'primitive-still-current ((vector-ref product 2)))
  (display "CUTOVER_TIMING\t") (display phase) (display "\t") (display label)
  (display "\t") (write batch) (display "\t5\t")
  (write (exact->inexact (/ (- (u64vector-ref bench-clock 2) (u64vector-ref bench-clock 1)) bench-clock-frequency)))
  (newline) (force-output)))
(define (cut-count label product)
 (cut-select product)
 (let ((remote native-remote) (matcher bl-match-args) (calls 0) (matches 0))
  (dynamic-wind
   (lambda ()
    (set! native-remote (lambda (key) (set! calls (+ calls 1)) (remote key)))
    (set! bl-match-args (lambda (p v e) (set! matches (+ matches 1)) (matcher p v e))))
   bench-parse
   (lambda () (set! native-remote remote) (set! bl-match-args matcher)))
  (display "CUTOVER_COUNTS\t") (display label) (display "\t") (write calls)
  (display "\t") (write matches) (newline)))
(define (cut-run)
 (native-mark-host-callable! bench-no-eval)
 (bl-register-callable! bench-no-eval 1)
 (set! native-leaf-registry (bl-assoc native-leaf-registry "host/eval-scheme/1" bench-no-eval))
 (set! native-eval-string bench-no-eval)
 (set! cut-reference (cut-product @REFERENCE_MODULE@ @REFERENCE_INITIALIZER@ @REFERENCE_CHECK@ '@REFERENCE_PHYSICAL@))
 (cut-restore cut-original)
 (set! cut-candidate (cut-product @CANDIDATE_MODULE@ @CANDIDATE_INITIALIZER@ @CANDIDATE_CHECK@ '@CANDIDATE_PHYSICAL@))
 (for-each (lambda (source)
   (let ((reference (cut-read cut-reference source)) (candidate (cut-read cut-candidate source)))
    (if (not (bl-equal? reference candidate))
     (begin (display "READER_DIFFERENCE ") (write source) (newline)
      (display "REFERENCE ") (write reference) (newline)
      (display "CANDIDATE ") (write candidate) (newline)))
    (cut-check 'reader-differential (bl-equal? reference candidate))))
  (list bench-source "" "1" "nil true false" "(a [1 2] {:x 3})" "#{1 2 3}" "'hello" "λ Ω"
    "\"hello\\nworld\"" "1.5 -3 1/2" "; comment\n42" "#_ ignored kept" "(fn [x] (+ x 1))"
    "(let [x 1] x)" "[[:a] {:b [1 2]}]" "\\newline" "0xff 077 2r101" "^:private foo"
    "(" "[" "{" "\"open" ")" "]" "(]" "{:a}" "#"))
 (for-each (lambda (product)
  (cut-select product)
  (cut-check 'guard-integer (= 4 (cut-call "cut-guard" '(3))))
  (cut-check 'guard-fallback (eq? (bl-key "fallback") (cut-call "cut-guard" '("x"))))
  (cut-check 'guard-throws-falls-through (eq? (bl-key "fallback") (cut-call "cut-guard-error" '(7))))
  (cut-check 'guard-tuple (eq? (bl-key "positive") (cut-call "cut-guard-error" (list (bl-tuple '(7))))))
  (for-each (lambda (value expected)
   (cut-check 'literal-clause (eq? (bl-key expected) (cut-call "cut-case" (list value)))))
   '(1 2 3) '("one" "two" "other"))
  (let ((held (cut-call "cut-capture" '()))
        (live (bench-select @NAMESPACE@ "cut-live"))
        (replacement (bench-select @NAMESPACE@ "cut-two")))
   (cut-check 'live-original (= 1 (bl-invoke live '())))
   (native-intern @NAMESPACE@ "cut-one" replacement)
   (native-register! (string-append "@aot/" @NAMESPACE@) "cut-one" replacement)
   (##gc)
   (cut-check 'old-consumer-live-provider (= 2 (bl-invoke live '())))
   (cut-check 'captured-closure-retains-old (= 1 (bl-invoke held '())))
   (cut-select product)
   (cut-check 'rollback-provider (= 1 (bl-invoke live '())))))
  (list cut-reference cut-candidate))
 (cut-select cut-reference)
 (let ((before native-global-registry) (leaves native-leaf-registry))
  (dynamic-wind
   (lambda () (set! native-leaf-registry (bl-assoc native-leaf-registry @GUARD_KEY@ bench-no-eval)))
   (lambda ()
    (cut-check 'changed-primitive-refused
     (with-exception-catcher (lambda (e) #t) (lambda () (cut-select cut-candidate) #f)))
    (cut-check 'refusal-preserves-serving (and (eq? cut-active cut-reference) (eq? before native-global-registry))))
   (lambda () (set! native-leaf-registry leaves))))
 (cut-count "reference" cut-reference)
 (cut-count "candidate" cut-candidate)
 (for-each (lambda (phase)
  (let loop ((batch 0))
   (if (< batch 5)
    (begin
     (if (even? batch)
      (begin (cut-observe phase "reference" batch cut-reference) (cut-observe phase "candidate" batch cut-candidate))
      (begin (cut-observe phase "candidate" batch cut-candidate) (cut-observe phase "reference" batch cut-reference)))
     (loop (+ batch 1)))))) '("read" "pipeline"))
 (cut-select cut-reference)
 (let ((reference (bench-emit-nodes (bench-compile-forms (bench-parse)))))
  (cut-select cut-candidate)
  (let ((candidate (bench-emit-nodes (bench-compile-forms (bench-parse)))))
   (cut-check 'whole-pipeline-scheme-bytes (equal? reference candidate))
   (native-write-file (string-append @OUTPUT@ "/reference.txt") (object->string reference))
   (native-write-file (string-append @OUTPUT@ "/candidate.txt") (object->string candidate))))
 (cut-restore cut-original)
 (set! bench-reader cut-original-reader)
 (cut-check 'original-serving-restored (eq? native-global-registry (vector-ref cut-original 1)))
 (display "CUTOVER_CHECKS ") (write cut-checks) (newline)
 (display "CUTOVER_PASS\n") (force-output) (exit 0))
(with-exception-catcher
 (lambda (e) (cut-restore cut-original) (set! bench-reader cut-original-reader)
  (display-exception e) (newline) (exit 1)) cut-run)
