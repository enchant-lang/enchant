; One prepared Source, two backend selections, one existing native image.
(ns native.cutover.build
 (:require [native.aot-target :as target] [unit-store :as store]
           [bl.json :as json] [reader :as reader] [reader-node :as rn] [codebase]))
(def output (Path/expand (first (BeamLisp/argv))))
(assert (not (File/exists? output)))
(File/mkdir_p! output)
(def pin (json/decode (File/read! "research/native-seed/sdk-pin.json")))
(def source-file (Path/join (get pin "source") "priv/boot/reader.bl"))
(def original (File/read! source-file))
(def forms (reader/read-syntax original source-file))
(def facts (codebase/index-forms {} "reader" forms nil {:mode :calls}))
(assert (some #(= "read-string" (:fn/name %)) (:fn facts)))
(defn node-name [n] (rn/node-name (rn/node-form n)))
(def header (first (filter #(= "ns" (node-name (first (rn/node-items %)))) forms)))
(def position (rn/node-pos (second (rn/node-items header))))
(assert (= "reader" (node-name (second (rn/node-items header)))))
(def chars (unicode/characters_to_list original))
(def namespace 'native.cutover.reader)
(def source (str (unicode/characters_to_binary
 (list (lists/sublist chars (:offset position)) "native.cutover.reader"
       (lists/nthtail (:end-offset position) chars)))
 "\n" (File/read! "research/native-seed/cutover/fixtures.source")))
(def derived (Path/join output "reader.bl"))
(File/write! derived source)
(def workspace (BeamLisp.AOT/open_workspace
 {:version 2 :phase-imports (list 'core 'sugar)
  :sources (list {:namespace namespace :file derived})} {}))
(try
 (let [prepared (BeamLisp.AOT/prepare_unit workspace namespace)
       rows
       (mapv (fn [mode]
        (let [base (Path/join output (name mode))
              observations (Path/join base "tools")
              adapter (target/adapter {:prototype "research/native-seed" :python (System/find_executable "python3")
                        :observations observations :object-cache (Path/join output "objects") :emission-mode mode})
              built (store/artifact-target! prepared (Path/join base "artifacts") nil adapter)
              unit (Path/join (Path/join base "artifacts") (:key built))
              before (count (Path/wildcard (Path/join observations "build-*-request.json"))))
              reused (store/artifact-target! prepared (Path/join base "artifacts") (:selection built) adapter)
              after (count (Path/wildcard (Path/join observations "build-*-request.json"))))]
         (assert (:compiled built)) (assert (not (:compiled reused))) (assert (= before after))
         {:mode (name mode) :directory unit :selection-key (target/selection-key (:selection built))
          :request (first (Path/wildcard (Path/join observations "identity-*-request.json"))))
          :compiled (:compiled built) :reuse-compiled (:compiled reused) :reuse-build-jobs (- after before)}))
        [:reference :specialize-v1])]
  (File/write! (Path/join output "modules.json") (json/encode
   {:schema "bl.native.cutover-modules" :namespace "native.cutover.reader"
    :source {:path source-file :sha256 (target/sha original) :namespace-position position}
    :derived {:path derived :sha256 (target/sha source)} :modules rows}))
  (println "CUTOVER_MODULES_BUILT"))
 (finally (BeamLisp.AOT/close_workspace! workspace)))
