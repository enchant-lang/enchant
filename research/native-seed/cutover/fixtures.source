(defn cut-one [] 1)
(defn cut-two [] 2)
(defn cut-live [] (cut-one))
(defn cut-capture [] cut-one)
(defn cut-guard ([x] :when (int? x) (erlang/+ x 1)) ([x] :fallback))
(defn cut-guard-error ([x] :when (> (tuple-size x) 0) :positive) ([x] :fallback))
(defn cut-case [x] (case x 1 :one 2 :two :other))
(defn cut-read [s] (try (read-string s "native-devtool-benchmark.bl") (catch e (ex-data e))))
