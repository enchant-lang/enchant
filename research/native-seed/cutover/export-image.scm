;; Observe actual initialized exports of the qualified image, not guessed names.
(for-each (lambda (module-row)
 (let ((module (bl-nth module-row 0)) (ns (bl-nth module-row 1)))
  (for-each (lambda (arity-row)
   (let* ((key (bl-nth arity-row 0)) (arities (bl-nth arity-row 1))
          (owner (bl-nth key 0)) (name (bl-nth key 1)))
    (if (equal? owner ns)
     (begin
      (for-each (lambda (arity)
       (if (native-remote-available? module name arity)
        (begin (display "CUTOVER_MFA\t") (display module) (display "/") (display name)
         (display "/") (write arity) (newline)))) (bl-items (bl-nth arities 0)))
      (if (not (bl-is-nil (bl-nth arities 1)))
       (let ((physical (string-append name "__bl_v")) (arity (+ 1 (bl-nth arities 1))))
        (if (native-remote-available? module physical arity)
         (begin (display "CUTOVER_MFA\t") (display module) (display "/") (display physical)
          (display "/") (write arity) (newline))))))))) (native-map-pairs native-export-arities))))
 (native-map-pairs native-module-names))
(display "CUTOVER_EXPORTS_PASS\n") (force-output) (exit 0)
