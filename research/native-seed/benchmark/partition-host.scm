;; Trusted READ/WRITE transport only. Application forms are never evaluated.
;; Driver provides canonical pilot-input, frozen pilot-frozen-input, output/limits.
(define (pilot-size text)
 (let loop ((i 0) (n 0))
  (if (= i (string-length text)) n
   (let ((c (char->integer (string-ref text i))))
    (loop (+ i 1) (+ n (cond ((< c 128) 1) ((< c 2048) 2) ((< c 65536) 3) (else 4))))))))
(define (pilot-text form)
 (let ((p (open-output-string))) (write form p) (newline p) (get-output-string p)))
(define (pilot-read-all path)
 (call-with-input-file (list path: path char-encoding: 'UTF-8)
  (lambda (p) (let loop ((out '()))
   (let ((f (read p))) (if (eof-object? f) (reverse out) (loop (cons f out))))))))
(define forms (pilot-read-all pilot-input))
(if (not (equal? forms (pilot-read-all pilot-frozen-input)))
 (error "qualified ordinal-zero forms differ from frozen host forms"))
(define (head? f h) (and (pair? f) (eq? (car f) h)))
(define (global-name f)
 (and (head? f 'define) (pair? (cdr f))
  (cond ((symbol? (cadr f)) (cadr f))
        ((and (pair? (cadr f)) (symbol? (caadr f))) (caadr f)) (else #f))))
(define (bare? f) (and (head? f 'define) (pair? (cadr f)) (symbol? (caadr f))))
(define (walk tree visit)
 (visit tree) (if (pair? tree) (begin (walk (car tree) visit) (walk (cdr tree) visit))))
(define names '())
(define set-targets '())
(for-each (lambda (f)
 (let ((n (global-name f))) (if n (set! names (cons n names))))
 (walk f (lambda (x)
  (if (and (head? x 'set!) (pair? (cdr x)) (symbol? (cadr x)))
   (set! set-targets (cons (cadr x) set-targets)))))) forms)
(define (occurrences n) (let loop ((xs names) (n0 0))
 (if (null? xs) n0 (loop (cdr xs) (+ n0 (if (eq? n (car xs)) 1 0))))))
(define (any? p xs) (and (pair? xs) (or (p (car xs)) (any? p (cdr xs)))))
(define (prefix? text prefix)
 (and (>= (string-length text) (string-length prefix))
      (string=? (substring text 0 (string-length prefix)) prefix)))
(define (ffi-head? symbol)
 (and (symbol? symbol)
  (or (memq symbol '(c-lambda c-declare ##c-lambda ##c-declare))
      (prefix? (symbol->string symbol) "c-define")
      (prefix? (symbol->string symbol) "##c-define"))))
(define (ffi? f)
 (let ((found #f))
  (walk f (lambda (x)
   (if (and (pair? x) (ffi-head? (car x))) (set! found #t)))) found))
(define macro-heads '(define-macro define-syntax syntax-rules let-syntax letrec-syntax ##define-macro ##define-syntax include namespace ##namespace))
(for-each (lambda (f)
 (walk f (lambda (x)
  (if (and (pair? x) (memq (car x) macro-heads)) (error "macro/module syntax is outside this pilot" (car x)))))) forms)
(define forbidden '(eval interaction-environment defined? ##global-var ##global-var-ref ##global-var-set! ##global-var-primitive-ref
                    ##make-global-var ##global-var? ##global-var-name ##interaction-environment load dynamic-load eval-string))
;; Find reflective named bodies and their transitive named callers. This is a
;; denial analysis only: no supplied body is executed or treated as proof data.
(define reflected forbidden)
(define (references? body symbols)
 (let ((found #f))
  (walk body (lambda (x) (if (and (pair? x) (memq (car x) symbols)) (set! found #t)))) found))
(let loop ()
 (let ((before (length reflected)))
  (for-each (lambda (f)
   (if (and (bare? f) (not (memq (global-name f) reflected)) (references? (cddr f) reflected))
    (set! reflected (cons (global-name f) reflected)))) forms)
  (if (> (length reflected) before) (loop))))
(define eager-risks '())
(define (eager f)
 (cond
  ((not (pair? f)) #f)
  ((memq (car f) '(quote lambda case-lambda c-lambda c-declare)) #f)
  ((and (head? f 'define) (bare? f)) #f)
  ((and (symbol? (car f)) (memq (car f) reflected)) (set! eager-risks (cons (car f) eager-risks)))
  ;; The exact host's four eager for-each calls use literal lambdas to register
  ;; leaves. Inspect those lambda bodies; never treat them as delayed here.
  ((head? f 'for-each)
   (if (not (and (pair? (cdr f)) (head? (cadr f) 'lambda))) (error "unknown eager callback" f))
   (for-each eager (cddr (cadr f))) (for-each eager (cddr f)))
  ;; This fixed host also constructs its five immutable reference-class names
  ;; with bl-key. Its checked body only appends ':' and interns the symbol.
  ;; Keep every other eager map/callback outside the admitted grammar.
  ((head? f 'map)
   (if (or (memq 'bl-key reflected)
           (not (equal? f '(map bl-key '("Elixir.BeamLisp.Atom" "Elixir.BeamLisp.Volatile"
                                        "Elixir.BeamLisp.Promise" "Elixir.BeamLisp.Future"
                                        "Elixir.BeamLisp.Reduced")))))
    (error "unreviewed eager map" f)))
  ((memq (car f) '(apply call-with-values call/cc with-exception-catcher))
   (error "unreviewed eager higher-order operation" (car f)))
  (else (for-each eager f))))
(for-each (lambda (f)
 (if (not (and (pair? f) (memq (car f) '(define set! native-add-leaf! native-env-leaf! for-each c-declare))))
  (error "unreviewed top-level form" f))
 (eager f)) forms)
(if (pair? eager-risks) (error "eager reflection could observe moved global definitions" eager-risks))
(define (eligible? f)
 (and (bare? f) (= (occurrences (global-name f)) 1)
      (not (memq (global-name f) set-targets)) (not (ffi? f))))
(define helpers (let loop ((xs forms) (out '()))
 (if (null? xs) (reverse out) (loop (cdr xs) (if (eligible? (car xs)) (cons (car xs) out) out)))))
(define remainder (let loop ((xs forms) (out '()))
 (if (null? xs) (reverse out) (loop (cdr xs) (if (eligible? (car xs)) out (cons (car xs) out))))))
(define (write-unit name fs role)
 (let* ((path (string-append pilot-output "/" name))
        (text (let ((p (open-output-string))) (for-each (lambda (f) (display (pilot-text f) p)) fs) (get-output-string p))))
  (if (> (pilot-size text) pilot-hard) (error "unit exceeds original hard bound" name))
  (call-with-output-file (list path: path char-encoding: 'UTF-8 eol-encoding: 'lf) (lambda (p) (display text p)))
  (if (not (equal? fs (pilot-read-all path))) (error "Scheme roundtrip changed forms" name))
  (display "UNIT\t") (display role) (display "\t") (display name) (display "\t")
  (display (length fs)) (display "\t") (display (pilot-size text)) (newline)))
(define groups '())
(let loop ((xs helpers) (current '()) (size 0))
 (if (null? xs)
  (if (pair? current) (set! groups (reverse (cons (reverse current) groups))) (set! groups (reverse groups)))
  (let ((n (pilot-size (pilot-text (car xs)))))
   (if (> n pilot-target) (error "single helper exceeds conservative target" (global-name (car xs)) n))
   (if (and (pair? current) (> (+ size n) pilot-target))
    (begin (set! groups (cons (reverse current) groups)) (loop xs '() 0))
    (loop (cdr xs) (cons (car xs) current) (+ size n))))))
(let loop ((gs groups) (i 0))
 (if (pair? gs) (begin (write-unit (string-append "helpers-" (number->string i) ".scm") (car gs) "O1") (loop (cdr gs) (+ i 1)))))
(write-unit "host-remainder.scm" remainder "O0")
;; Reconstruction proves no missing/duplicated/reordered form in either lane.
(let ((hs helpers) (rs remainder))
 (for-each (lambda (f)
  (if (eligible? f)
   (begin (if (or (null? hs) (not (equal? f (car hs)))) (error "helper reconstruction failed")) (set! hs (cdr hs)))
   (begin (if (or (null? rs) (not (equal? f (car rs)))) (error "remainder reconstruction failed")) (set! rs (cdr rs))))) forms)
 (if (or (pair? hs) (pair? rs)) (error "partition left extra forms")))
(display "PLAN\t") (display (length forms)) (display "\t") (display (length helpers)) (display "\t")
(display (length remainder)) (display "\t") (display (length groups)) (display "\t0\n")
(for-each (lambda (name) (if (not (memq name forbidden)) (begin (display "DELAYED_REFLECTION\t") (display name) (newline)))) reflected)
(display "PARTITION_ACCEPTED\n")
(exit 0)
