;; ONE operation per phase. These counters perturb execution: no timing claim.
(define prof-enabled? #f)
(define prof-counts (make-table test: equal?))
(define prof-callables (make-table test: eq?))
(define prof-old-invoke bl-invoke)
(define prof-old-leaf native-leaf)
(define prof-old-global native-global)
(define prof-old-global-exact native-global-exact)
(define prof-old-remote native-remote)
(define prof-old-get bl-get)
(define prof-old-assoc bl-assoc)
(define prof-old-map bl-map)
(define prof-old-entry native-map-entry)
(define prof-old-pairs native-map-pairs)
(define prof-old-small-search native-small-map-search)
(define prof-old-tree-find native-tree-find)
(define prof-old-equal bl-equal?)
(define prof-old-compare bl-key-compare)
(define (prof-shape value)
 (cond ((symbol? value) "symbol") ((string? value) "string")
       ((number? value) "number") ((null? value) "nil-list")
       ((pair? value) "pair") ((procedure? value) "procedure")
       ((vector? value)
        (if (and (> (vector-length value) 0) (symbol? (vector-ref value 0)))
         (symbol->string (vector-ref value 0)) "vector"))
       (else "other")))
(define (prof-key value)
 (cond ((symbol? value) (symbol->string value))
       ((string? value) (if (> (string-length value) 160) "long-string-key" value))
       ((number? value) (number->string value))
       (else (prof-shape value))))
(define (prof-note kind key)
 (if prof-enabled?
  (let ((identity (string-append kind "\t" key)))
   (table-set! prof-counts identity (+ 1 (table-ref prof-counts identity 0))))))
(define (prof-map-key owner key)
 (string-append
  (cond ((eq? owner native-global-registry) "globals:")
        ((eq? owner native-leaf-registry) "leaves:")
        ((eq? owner native-env-rows) "environment:") (else "value:"))
  (prof-key key)))
(define (prof-label-callable value name)
 (cond
  ((procedure? value)
   (if (not (table-ref prof-callables value #f))
    (table-set! prof-callables value name)))
  ((native-multi-callable? value)
   (table-set! prof-callables value name)
   (for-each
    (lambda (row)
     (prof-label-callable (bl-nth row 1)
      (string-append name "/" (number->string (bl-nth row 0)))))
    (prof-old-pairs (bl-nth value 1)))
   (if (not (bl-is-nil (bl-nth value 2)))
    (prof-label-callable (bl-nth (bl-nth value 2) 1)
     (string-append name "/variadic"))))))
(for-each
 (lambda (registry)
  (for-each (lambda (row)
             (prof-label-callable (bl-nth row 1) (prof-key (bl-nth row 0))))
            (prof-old-pairs registry)))
 (list native-global-registry native-leaf-registry))
(define prof-control-tag (bench-select "reader-node" "node-tag"))
(define (prof-install!)
 (set! native-leaf (lambda (key)
  (prof-note "leaf-lookup" (prof-key key)) (prof-old-leaf key)))
 (set! native-global (lambda (ns name)
  (prof-note "global" (string-append ns "/" name)) (prof-old-global ns name)))
 (set! native-global-exact (lambda (ns name)
  (prof-note "global-exact" (string-append ns "/" name))
  (prof-old-global-exact ns name)))
 (set! native-remote (lambda (key)
  (prof-note "remote" (prof-key key)) (prof-old-remote key)))
 (set! bl-invoke (lambda (callee arguments)
  (prof-note "invoke" (table-ref prof-callables callee "unregistered-callable"))
  (prof-old-invoke callee arguments)))
 (set! bl-get (lambda (owner key . fallback)
  (prof-note "map-get" (prof-map-key owner key))
  (apply prof-old-get (cons owner (cons key fallback)))))
 (set! bl-assoc (lambda (owner key value)
  (prof-note "map-assoc" (prof-map-key owner key))
  (prof-old-assoc owner key value)))
 (set! bl-map (lambda arguments
  (prof-note "map-create" (number->string (quotient (length arguments) 2)))
  (apply prof-old-map arguments)))
 (set! native-map-entry (lambda (owner key)
  (prof-note "map-entry" (prof-map-key owner key)) (prof-old-entry owner key)))
 (set! native-map-pairs (lambda (owner)
  (prof-note "map-pairs" (prof-shape owner)) (prof-old-pairs owner)))
 (set! native-small-map-search (lambda (storage key)
  (prof-note "small-map-search" (prof-key key))
  (prof-old-small-search storage key)))
 (set! native-tree-find (lambda (tree key)
  (prof-note "tree-find" (prof-key key)) (prof-old-tree-find tree key)))
 (set! bl-equal? (lambda (left right)
  (prof-note "equal" (string-append (prof-shape left) "/" (prof-shape right)))
  (prof-old-equal left right)))
 (set! bl-key-compare (lambda (left right)
  (prof-note "key-compare" (string-append (prof-shape left) "/" (prof-shape right)))
  (prof-old-compare left right))))
(define (prof-print phase)
 (table-for-each
  (lambda (identity count)
   (display "BL_COMPILER_PROFILE\t") (display phase) (display "\t")
   (display identity) (display "\t") (write count) (newline)) prof-counts)
 (force-output))
(define (prof-operation phase action)
 (set! prof-counts (make-table test: equal?))
 (set! prof-enabled? #t)
 (let ((value (action)))
  (set! prof-enabled? #f)
  (prof-print phase) value))
(define (prof-run)
 (native-mark-host-callable! bench-no-eval)
 (bl-register-callable! bench-no-eval 1)
 (set! native-leaf-registry
  (prof-old-assoc native-leaf-registry "host/eval-scheme/1" bench-no-eval))
 (set! native-eval-string bench-no-eval)
 (let* ((forms (bench-parse)) (nodes (bench-compile-forms forms)))
  (if (not (= 6 (length forms))) (error "profile corpus changed shape"))
  ;; Warm the same actual algorithms before installing any counters.
  (bench-repeat 3 (lambda () (bench-emit-nodes (bench-compile-forms (bench-parse)))))
  (prof-install!)
  (let ((value (prof-operation "control"
                (lambda () (prof-old-invoke prof-control-tag (list 7))))))
   (if (not (eq? value (bl-key "scalar"))) (error "compiled profile control differs"))
   (display "BL_COMPILER_PROFILE_CONTROL\tcompiled-remote-interception\t")
   (display (if (> (table-ref prof-counts "remote\terlang/is_tuple/1" 0) 0)
             "observed" "not-observed")) (newline))
  (prof-operation "read" bench-parse)
  (prof-operation "compile" (lambda () (bench-compile-forms forms)))
  (let ((texts (prof-operation "emit" (lambda () (bench-emit-nodes nodes)))))
   (native-write-file @OUTPUT@
    (let loop ((remaining texts))
     (if (null? remaining) ""
      (if (null? (cdr remaining)) (car remaining)
       (string-append (car remaining) "\n" (loop (cdr remaining)))))))))
 (display "BL_COMPILER_PROFILE_DONE\n") (force-output) (exit 0))
(with-exception-catcher
 (lambda (failure) (set! prof-enabled? #f)
  (display-exception failure) (newline) (exit 1)) prof-run)
