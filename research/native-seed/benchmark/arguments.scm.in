;; Counts only. Instrumented target wrappers call the original compiled BL;
;; no timings, optimization, runtime policy, SDK or ELF changes.
(define p2-enabled? #f)
(define p2-counts (make-table test: equal?))
(define p2-eqv (bench-select "rt" "eqv"))
(define p2-k-eqv (bench-select "rt" "k-eqv"))
(define p2-k-compare (bench-select "rt" "k-compare"))
(define p2-integer (native-leaf "erlang/is_integer/1"))
(bench-check-native p2-integer)
(define (p2-parent value)
 (if (not (and (procedure? value) (not (##interp-procedure? value))))
  (error "P2 original target is not a compiled native procedure"))
 (let ((parent (##subprocedure-parent (if (##closure? value) (##closure-code value) value))))
  (if (or (not (procedure? parent)) (##interp-procedure? parent))
   (error "P2 original target has no native parent")) parent))
(define p2-parents (map p2-parent (list bench-reader p2-eqv p2-k-eqv p2-k-compare p2-integer)))
(define (p2-class value)
 (cond ((eq? value bl-nil) "nil") ((boolean? value) "boolean")
       ((p2-integer value) "integer") ((bl-tag? value 'float) "float")
       ((native-string? value) "binary") ((native-keyword? value) "atom")
       ((null? value) "empty-list") ((pair? value) "cons")
       ((bl-tag? value 'tuple)
        (let ((fields (vector-ref value 1)))
         (if (and (> (vector-length fields) 0) (eq? (vector-ref fields 0) (bl-key "meta")))
          "meta-tuple" "tuple")))
       ((bl-tag? value 'vec) "vector-struct") ((bl-tag? value 'set) "set-struct")
       ((bl-tag? value 'map) "map") ((procedure? value) "function") (else "other")))
(define (p2-note function a b)
 (if p2-enabled?
  (let* ((both-int (and (p2-integer a) (p2-integer b)))
         (category
          (if both-int (if (= a b) "integer-equal" "integer-unequal")
           (string-append (p2-class a) "/" (p2-class b))))
         (key (string-append function "\t" category)))
   ;; Separate Gambit table primitives never enter BL rt equality.
   (table-set! p2-counts key (+ 1 (table-ref p2-counts key 0))))))
(define p2-eqv-wrapper
 (lambda (a b) (p2-note "k-eqv" a b) (bl-invoke p2-k-eqv (list a b))))
(define p2-compare-wrapper
 (lambda (a b) (p2-note "k-compare" a b) (bl-invoke p2-k-compare (list a b))))
(define (p2-print phase)
 (table-for-each
  (lambda (key count)
   (display "BL_NATIVE_EQUALITY_ARGS\t") (display phase) (display "\t")
   (display key) (display "\t") (write count) (newline)) p2-counts)
 (force-output))
(define (p2-originals-retained?)
 (let loop ((values (list bench-reader p2-eqv p2-k-eqv p2-k-compare p2-integer))
            (parents p2-parents))
  (or (null? values)
   (and (eq? (p2-parent (car values)) (car parents)) (loop (cdr values) (cdr parents))))))
(define (p2-run)
 (native-mark-host-callable! bench-no-eval)
 (bl-register-callable! bench-no-eval 1)
 (set! native-leaf-registry
  (bl-assoc native-leaf-registry "host/eval-scheme/1" bench-no-eval))
 (set! native-eval-string bench-no-eval)
 (let ((baseline (bench-parse)) (measured #f))
  (if (not (= (length baseline) 6)) (error "P2 original corpus shape differs"))
  ;; Three original-reader warmups in total; only the later single parse is
  ;; counted. Classification adds no BL comparison calls and reports no time.
  (bench-repeat 2 bench-parse)
  (native-mark-host-callable! p2-eqv-wrapper)
  (native-mark-host-callable! p2-compare-wrapper)
  (bl-register-callable! p2-eqv-wrapper 2)
  (bl-register-callable! p2-compare-wrapper 2)
  (dynamic-wind
   (lambda ()
    (native-register! "rt" "k-eqv" p2-eqv-wrapper)
    (native-register! "rt" "k-compare" p2-compare-wrapper))
   (lambda ()
    ;; Enter through actual compiled rt/eqv; this detects whether its compiled
    ;; body uses the live registry slots we instrument, rather than fabricating
    ;; a nonzero count by invoking an instrumentation wrapper directly.
    (set! p2-counts (make-table test: equal?)) (set! p2-enabled? #t)
    (let ((unequal (bl-invoke p2-eqv (list 1 2)))
          (equal (bl-invoke p2-eqv (list 1 1))))
     (set! p2-enabled? #f)
     (if (not (and (eq? unequal #f) (eq? equal #t)
                   (= (table-ref p2-counts "k-eqv\tinteger-unequal" 0) 1)
                   (= (table-ref p2-counts "k-eqv\tinteger-equal" 0) 1)
                   (= (table-ref p2-counts "k-compare\tinteger-unequal" 0) 1)
                   (= (table-ref p2-counts "k-compare\tinteger-equal" 0) 0)))
      (error "P2 compiled-call interception control failed")))
    (p2-print "control")
    (set! p2-counts (make-table test: equal?)) (set! p2-enabled? #t)
    (set! measured (bench-parse))
    (set! p2-enabled? #f)
    (if (not (and (eq? (native-global-exact "rt" "k-eqv") p2-eqv-wrapper)
                  (eq? (native-global-exact "rt" "k-compare") p2-compare-wrapper)))
     (error "P2 observed binding changed during the closed parse")))
   (lambda ()
    (set! p2-enabled? #f)
    (native-register! "rt" "k-eqv" p2-k-eqv)
    (native-register! "rt" "k-compare" p2-k-compare)))
  (if (not (and (p2-originals-retained?)
                (eq? (native-global-exact "rt" "k-eqv") p2-k-eqv)
                (eq? (native-global-exact "rt" "k-compare") p2-k-compare)
                (bl-equal? baseline measured)))
   (error "P2 original compiled parents/bindings or Reader output parity differs"))
  (p2-print "read")
  (display "BL_NATIVE_EQUALITY_ARGS_PARITY PASS\n")
  (display "BL_NATIVE_EQUALITY_ARGS_CONTROL PASS\n")
  (display "BL_NATIVE_EQUALITY_ARGS_DONE\n") (force-output) (exit 0)))
(with-exception-catcher
 (lambda (failure)
  (set! p2-enabled? #f)
  (native-register! "rt" "k-eqv" p2-k-eqv)
  (native-register! "rt" "k-compare" p2-k-compare)
  (display-exception failure) (newline) (exit 1)) p2-run)
