; Macro-free frontend corpus. No authored bodies execute in this benchmark.
(fn [value] (if value 42 0))
(fn [value] (let [one 1 two 2] [value one two]))
(fn [value] (fn [other] [value other]))
(fn [value] (let [first-value (if value "yes" "no")]
              (if value [first-value true] [first-value false])))
(fn local ([value] (local value 0)) ([value other] [value other]))
(fn [value] (loop [remaining value]
              (if remaining (recur nil) [remaining])))
