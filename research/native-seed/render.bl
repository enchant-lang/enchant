(ns native.render
 (:require [dossier.org :as org] [dossier.page :as page] [bl.doc :as doc] [bl.json :as json]
           [codebase-review.blocks :as review] [live.hiccup :as h]))
(def base "research/native-seed")
(def kit "/home/othman/projects/enchanted-skills/bl-org-dossier/kit")
(def review-kit "/home/othman/projects/enchanted-skills/codebase-review/kit")
(def checked (doc/run-and-write! (str base "/native-seed.bl.org") {:check? true}))
(assert (nil? (:error checked)))
(assert (empty? (:errors checked)))
(assert (= false (:drift checked)))
(File/write! (str base "/evidence/document.json") (json/encode checked))
(def document (-> (org/read-doc (File/read! (str base "/native-seed.bl.org")))
                  review/enrich (assoc-in [:meta :locked] "t") (assoc-in [:meta :published] true)))
(File/write! (str base "/evidence/native-seed.html")
 (str "<!doctype html>"
  (h/hiccup->html
   (page/page-h document
    (str (File/read! (str kit "/style.css")) (File/read! (str review-kit "/review.css"))
         "\n.tally,.live>a{display:none!important}")
    (File/read! (str kit "/live.js"))))))
(println "DOSSIER_RENDERED")
