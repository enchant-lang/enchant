;; Native ABI extension. Append after host.scm, before compiled BL definitions.
;; Language algorithms remain in compiled core/rt. This file owns storage,
;; raw BEAM-shaped primitives, call/exception control, and host capabilities.
;; Native map storage is a persistent AVL tree and vectors are persistent
;; binary tries. Neither representation exposes mutable storage to BL code.

(define native-key-intern bl-key)
(set! bl-key (lambda (name)
 (cond ((string=? name "nil") bl-nil) ((string=? name "true") #t) ((string=? name "false") #f)
  (else (native-key-intern name)))))
(define native-opaque-structs (make-table test: eq? weak-keys: #t))
(define (native-register-struct! value module fields-reader)
 (table-set! native-opaque-structs value (cons module fields-reader)) value)
(define (native-opaque-struct? value) (if (table-ref native-opaque-structs value #f) #t #f))
(define native-host-callables (make-table test: eq? weak-keys: #t))
(define (native-mark-host-callable! value)
 (if (procedure? value) (table-set! native-host-callables value #t)) value)
(define native-missing (list 'native-missing))
(define native-opaque-counter 0)
(define native-opaque-ids (make-table test: eq? weak-keys: #t))
(define (native-opaque-id x)
 (let ((hit (table-ref native-opaque-ids x #f)))
  (if hit hit
   (begin (set! native-opaque-counter (+ native-opaque-counter 1))
    (table-set! native-opaque-ids x native-opaque-counter)
    native-opaque-counter))))
(define (native-list? x)
 (let loop ((p x)) (cond ((null? p) #t) ((pair? p) (loop (cdr p))) (else #f))))
(define (native-keyword? x)
 (and (symbol? x) (let ((s (symbol->string x)))
   (and (> (string-length s) 0) (char=? (string-ref s 0) #\:)))))
(define (native-compare-number a b) (cond ((< a b) -1) ((> a b) 1) (else 0)))
(define (native-compare-string a b) (cond ((string<? a b) -1) ((string>? a b) 1) (else 0)))
(define (native-key-rank x)
 (cond ((and (number? x) (exact? x) (integer? x)) 0)
       ((bl-tag? x 'float) 1)
       ((or (boolean? x) (bl-is-nil x) (native-keyword? x)) 2)
       ((bl-tag? x 'tuple) 3) ((bl-tag? x 'map) 4)
       ((bl-tag? x 'vec) 5) ((bl-tag? x 'set) 6)
       ((null? x) 7) ((pair? x) 8) ((native-string? x) 9) (else 10)))
(define (native-atom-name x)
 (cond ((bl-is-nil x) "nil") ((eq? x #t) "true") ((eq? x #f) "false")
       (else (substring (symbol->string x) 1 (string-length (symbol->string x))))))
(define (native-compare-lists a b)
 (cond ((null? a) (if (null? b) 0 -1)) ((null? b) 1)
       ((and (pair? a) (pair? b))
        (let ((n (bl-key-compare (car a) (car b))))
         (if (= n 0) (native-compare-lists (cdr a) (cdr b)) n)))
       (else (bl-key-compare a b))))
;; Raw tuple keys are fixed Scheme vectors. Compare their existing
;; lexicographic/prefix relation directly, without allocating vector->list.
(define (native-compare-tuples a b)
 (let* ((a-items (vector-ref a 1)) (b-items (vector-ref b 1))
        (a-size (vector-length a-items)) (b-size (vector-length b-items)))
  (let loop ((index 0))
   (cond ((= index a-size) (if (= index b-size) 0 -1))
    ((= index b-size) 1)
    (else (let ((order (bl-key-compare (vector-ref a-items index) (vector-ref b-items index))))
     (if (= order 0) (loop (+ index 1)) order)))))))
(define (bl-key-compare a b)
 (if (eq? a b) 0
  (let ((ra (native-key-rank a)) (rb (native-key-rank b)))
   (if (not (= ra rb)) (native-compare-number ra rb)
    (case ra
     ((0) (native-compare-number a b))
     ((1) (native-compare-number (vector-ref a 1) (vector-ref b 1)))
     ((2) (native-compare-string (native-atom-name a) (native-atom-name b)))
     ((3) (native-compare-tuples a b))
     ((5) (native-compare-lists (bl-items a) (bl-items b)))
     ((4) (native-compare-lists (native-map-pairs a) (native-map-pairs b)))
     ((6) (native-compare-lists (native-set-items a) (native-set-items b)))
     ((7) 0) ((8) (native-compare-lists a b))
     ((9) (native-compare-string a b))
     (else (native-compare-number (native-opaque-id a) (native-opaque-id b))))))))
(define (bl-key-equal? a b) (= (bl-key-compare a b) 0))

;; Persistent AVL map: #(map #(pmap-v1 root count)); node = #(k v l r height).
(define (native-map-tree? x)
 (and (vector? x) (= (vector-length x) 3) (eq? (vector-ref x 0) 'pmap-v1)))
(define (native-map-root m)
 (let ((s (vector-ref m 1)))
  (if (native-map-tree? s) (vector-ref s 1)
   (let loop ((xs s) (root #f))
    (if (null? xs) root (loop (cdr xs) (native-tree-put root (caar xs) (cdar xs))))))))
(define (native-height n) (if n (vector-ref n 4) 0))
(define (native-node k v l r) (vector k v l r (+ 1 (max (native-height l) (native-height r)))))
(define (native-left n) (vector-ref n 2))
(define (native-right n) (vector-ref n 3))
(define (native-rotate-right n)
 (let* ((l (native-left n)) (mid (native-right l)))
  (native-node (vector-ref l 0) (vector-ref l 1) (native-left l)
   (native-node (vector-ref n 0) (vector-ref n 1) mid (native-right n)))))
(define (native-rotate-left n)
 (let* ((r (native-right n)) (mid (native-left r)))
  (native-node (vector-ref r 0) (vector-ref r 1)
   (native-node (vector-ref n 0) (vector-ref n 1) (native-left n) mid) (native-right r))))
(define (native-balance n)
 (let ((d (- (native-height (native-left n)) (native-height (native-right n)))))
  (cond ((> d 1)
   (let ((l (native-left n)))
    (native-rotate-right
     (if (< (native-height (native-left l)) (native-height (native-right l)))
      (native-node (vector-ref n 0) (vector-ref n 1) (native-rotate-left l) (native-right n)) n))))
   ((< d -1)
    (let ((r (native-right n)))
     (native-rotate-left
      (if (> (native-height (native-left r)) (native-height (native-right r)))
       (native-node (vector-ref n 0) (vector-ref n 1) (native-left n) (native-rotate-right r)) n))))
   (else n))))
(define (native-tree-ref n k)
 (if (not n) native-missing
  (let ((c (bl-key-compare k (vector-ref n 0))))
   (cond ((= c 0) (cons (vector-ref n 0) (vector-ref n 1)))
         ((< c 0) (native-tree-ref (native-left n) k))
         (else (native-tree-ref (native-right n) k))))))
(define (native-tree-put n k v)
 (if (not n) (native-node k v #f #f)
  (let ((c (bl-key-compare k (vector-ref n 0))))
   (native-balance
    (cond ((= c 0) (native-node (vector-ref n 0) v (native-left n) (native-right n)))
          ((< c 0) (native-node (vector-ref n 0) (vector-ref n 1)
                    (native-tree-put (native-left n) k v) (native-right n)))
          (else (native-node (vector-ref n 0) (vector-ref n 1)
                 (native-left n) (native-tree-put (native-right n) k v))))))))
(define (native-tree-min n) (if (native-left n) (native-tree-min (native-left n)) n))
(define (native-tree-remove n k)
 (if (not n) #f
  (let ((c (bl-key-compare k (vector-ref n 0))))
   (cond
    ((< c 0) (native-balance (native-node (vector-ref n 0) (vector-ref n 1)
                (native-tree-remove (native-left n) k) (native-right n))))
    ((> c 0) (native-balance (native-node (vector-ref n 0) (vector-ref n 1)
                (native-left n) (native-tree-remove (native-right n) k))))
    ((not (native-left n)) (native-right n))
    ((not (native-right n)) (native-left n))
    (else (let ((r (native-tree-min (native-right n))))
     (native-balance (native-node (vector-ref r 0) (vector-ref r 1) (native-left n)
      (native-tree-remove (native-right n) (vector-ref r 0))))))))))
(define (native-tree-pairs n tail)
 (if n (native-tree-pairs (native-left n)
   (cons (bl-tuple (list (vector-ref n 0) (vector-ref n 1))) (native-tree-pairs (native-right n) tail))) tail))
(define (native-map-pairs m) (native-tree-pairs (native-map-root m) '()))
(define (native-map-count m)
 (let ((s (vector-ref m 1))) (if (native-map-tree? s) (vector-ref s 2) (length s))))
(set! bl-empty-map (lambda () (vector 'map (vector 'pmap-v1 #f 0))))
(set! bl-get (lambda (m k . default)
 (let ((entry (if (bl-tag? m 'map) (native-tree-ref (native-map-root m) k) native-missing)))
  (if (eq? entry native-missing) (if (null? default) bl-nil (car default)) (cdr entry)))))
(define (native-map-has? m k)
 (and (bl-tag? m 'map) (not (eq? native-missing (native-tree-ref (native-map-root m) k)))))
(set! bl-assoc (lambda (m k v)
 (let* ((m (if (bl-tag? m 'map) m (bl-empty-map))) (root (native-map-root m))
        (added (eq? native-missing (native-tree-ref root k))))
  (vector 'map (vector 'pmap-v1 (native-tree-put root k v) (+ (native-map-count m) (if added 1 0)))))))
(define (native-map-remove m k)
 (if (not (native-map-has? m k)) m
  (vector 'map (vector 'pmap-v1 (native-tree-remove (native-map-root m) k) (- (native-map-count m) 1)))))
(set! bl-map (lambda xs
 (let loop ((xs xs) (m (bl-empty-map)))
  (cond ((null? xs) m) ((null? (cdr xs)) (error "map needs key/value pairs"))
        (else (loop (cddr xs) (bl-assoc m (car xs) (cadr xs))))))))

;; Persistent vector binary trie. Each update copies one root-to-leaf path.
;; #(vec #(pvec-v1 count capacity root)); internal nodes are two-slot vectors.
(define (native-vector-storage? x)
 (and (vector? x) (or (= (vector-length x) 4) (= (vector-length x) 5)) (eq? (vector-ref x 0) 'pvec-v1)))
(define (native-vector-meta v)
 (let ((s (vector-ref v 1))) (if (and (native-vector-storage? s) (= (vector-length s) 5)) (vector-ref s 4) bl-nil)))
(define (native-vector-with-meta v meta)
 (let* ((v (if (native-vector-storage? (vector-ref v 1)) v (bl-vec (bl-items v)))) (s (vector-ref v 1)))
  (vector 'vec (vector 'pvec-v1 (vector-ref s 1) (vector-ref s 2) (vector-ref s 3) meta))))
(define (native-vector-count v)
 (let ((s (vector-ref v 1))) (if (native-vector-storage? s) (vector-ref s 1) (vector-length s))))
(define (native-vector-at node cap i)
 (if (= cap 1) node
  (let ((half (quotient cap 2)))
   (if (< i half) (native-vector-at (vector-ref node 0) half i)
       (native-vector-at (vector-ref node 1) half (- i half))))))
(define (native-vector-put node cap i value)
 (if (= cap 1) value
  (let* ((half (quotient cap 2)) (l (if node (vector-ref node 0) #f)) (r (if node (vector-ref node 1) #f)))
   (if (< i half) (vector (native-vector-put l half i value) r)
    (vector l (native-vector-put r half (- i half) value))))))
(define (native-vector-ref v i)
 (if (or (not (and (integer? i) (exact? i))) (< i 0) (>= i (native-vector-count v)))
  (error "vector index out of range")
  (let ((s (vector-ref v 1)))
   (if (native-vector-storage? s) (native-vector-at (vector-ref s 3) (vector-ref s 2) i)
    (vector-ref s i)))))
(define (native-vector-assoc v i value)
 (cond ((or (< i 0) (> i (native-vector-count v))) (error "vector index out of range"))
       ((not (native-vector-storage? (vector-ref v 1))) (native-vector-assoc (bl-vec (vector->list (vector-ref v 1))) i value))
       (else
        (let* ((s (vector-ref v 1)) (n (vector-ref s 1)) (cap (vector-ref s 2)) (root (vector-ref s 3))
               (grow (and (= i n) (= n cap))) (cap2 (if grow (* 2 cap) cap))
               (root2 (if grow (vector root #f) root)))
         (vector 'vec (vector 'pvec-v1 (if (= i n) (+ n 1) n) cap2
          (native-vector-put root2 cap2 i value) (native-vector-meta v)))))))
(set! bl-vec (lambda (xs)
 (let loop ((xs xs) (v (vector 'vec (vector 'pvec-v1 0 1 #f))))
  (if (null? xs) v (loop (cdr xs) (native-vector-assoc v (native-vector-count v) (car xs)))))))
(set! bl-items (lambda (v)
 (if (bl-tag? v 'vec)
  (let loop ((i (- (native-vector-count v) 1)) (out '()))
   (if (< i 0) out (loop (- i 1) (cons (native-vector-ref v i) out))))
  (vector->list (vector-ref v 1)))))
(set! bl-nth (lambda (v n . default)
 (let ((valid (and (integer? n) (exact? n) (>= n 0)
                   (< n (cond ((bl-tag? v 'vec) (native-vector-count v))
                               ((bl-tag? v 'tuple) (vector-length (vector-ref v 1)))
                               ((native-list? v) (length v)) (else 0))))))
  (if valid (cond ((bl-tag? v 'vec) (native-vector-ref v n))
                  ((bl-tag? v 'tuple) (vector-ref (vector-ref v 1) n)) (else (list-ref v n)))
   (if (null? default) (error "index out of range") (car default))))))
(set! bl-conj (lambda (v x)
 (cond ((bl-tag? v 'vec) (native-vector-assoc v (native-vector-count v) x))
       ((bl-tag? v 'set) (native-set-put v x))
       ((bl-tag? v 'map)
        (let ((entry (if (bl-tag? x 'vec) (bl-items x) x)))
         (if (and (native-list? entry) (= (length entry) 2)) (bl-assoc v (car entry) (cadr entry))
          (error "map conj needs a pair"))))
       (else (cons x (if (bl-is-nil v) '() v))))))
(set! bl-count (lambda (x)
 (cond ((bl-is-nil x) 0) ((bl-tag? x 'map) (native-map-count x))
       ((bl-tag? x 'vec) (native-vector-count x)) ((bl-tag? x 'set) (native-map-count (vector-ref x 1)))
       ((bl-tag? x 'tuple) (vector-length (vector-ref x 1))) ((string? x) (string-length x))
       ((native-list? x) (length x)) (else (error "value has no count")))))

(define (native-set-items s)
 (map (lambda (entry) (bl-nth entry 0)) (native-map-pairs (vector-ref s 1))))
(define (native-set-put s x) (vector 'set (bl-assoc (vector-ref s 1) x #t)))
(define (native-set-remove s x) (vector 'set (native-map-remove (vector-ref s 1) x)))
(define (native-set-from-list xs)
 (let loop ((xs xs) (s (vector 'set (bl-empty-map))))
  (if (null? xs) s (loop (cdr xs) (native-set-put s (car xs))))))

;; Generic structs remain maps tagged with :__struct__, just as on BEAM.
(define (native-module-key mod) (if (string? mod) (bl-key mod) mod))
(define (bl-struct mod fields)
 (let ((mod (native-module-key mod)))
  (cond ((eq? mod (bl-key "Elixir.BeamLisp.Vector"))
         (native-vector-with-meta (native-vector-from-canonical-items (bl-get fields (bl-key "items"))) (bl-get fields (bl-key "meta"))))
        ((eq? mod (bl-key "Elixir.BeamLisp.Set"))
         (let ((members (bl-get fields (bl-key "members") (bl-get fields (bl-key "map") native-missing))))
          (if (eq? members native-missing) (error "set struct requires members")
           (vector 'set (if (eq? (native-struct-module members) (bl-key "Elixir.MapSet")) (bl-get members (bl-key "map")) members)))))
        (else (bl-assoc fields (bl-key "__struct__") mod)))))
(define (native-struct-module x)
 (cond ((bl-tag? x 'vec) (bl-key "Elixir.BeamLisp.Vector"))
       ((bl-tag? x 'set) (bl-key "Elixir.BeamLisp.Set"))
       ((bl-tag? x 'map) (bl-get x (bl-key "__struct__")))
       (else (let ((descriptor (table-ref native-opaque-structs x #f))) (if descriptor (car descriptor) bl-nil)))))
(define (native-struct-fields x)
 (cond ((bl-tag? x 'vec) (bl-map (bl-key "__struct__") (bl-key "Elixir.BeamLisp.Vector") (bl-key "items") (native-vector-canonical-items x) (bl-key "meta") (native-vector-meta x)))
       ((bl-tag? x 'set) (bl-map (bl-key "__struct__") (bl-key "Elixir.BeamLisp.Set") (bl-key "members")
         (bl-map (bl-key "__struct__") (bl-key "Elixir.MapSet")
          (bl-key "map") (let loop ((xs (native-set-items x)) (m (bl-empty-map)))
           (if (null? xs) m (loop (cdr xs) (bl-assoc m (car xs) '())))))))
       ((bl-tag? x 'map) x)
       (else (let ((descriptor (table-ref native-opaque-structs x #f)))
        (if descriptor (bl-assoc ((cdr descriptor) x) (bl-key "__struct__") (car descriptor)) (bl-empty-map))))))

;; Numeric storage is exact. Floats are boxed to retain type identity; decimal
;; coefficient/scale are canonical struct fields and retain representation.
(define (bl-float value)
 (let ((f (exact->inexact value)))
  (if (or (not (= f f)) (= f +inf.0) (= f -inf.0)) (error "non-finite float is unsupported")
   (vector 'float f))))
(define (bl-decimal unscaled scale)
 (if (not (and (integer? unscaled) (exact? unscaled) (integer? scale) (exact? scale)))
  (error "invalid decimal storage")
  (bl-map (bl-key "__struct__") (bl-key "Elixir.BeamLisp.Decimal")
          (bl-key "unscaled") unscaled (bl-key "scale") scale)))
(define (native-decimal? x) (eq? (native-struct-module x) (bl-key "Elixir.BeamLisp.Decimal")))
(define (native-number? x)
 (or (and (number? x) (integer? x) (exact? x)) (bl-tag? x 'float) (native-decimal? x)))
(define (native-ratio x)
 (cond ((and (number? x) (integer? x) (exact? x)) x)
       ((bl-tag? x 'float)
        (let ((f (vector-ref x 1)))
         (if (or (not (= f f)) (= f +inf.0) (= f -inf.0)) (error "non-finite number") (inexact->exact f))))
       ((native-decimal? x) (/ (bl-get x (bl-key "unscaled")) (expt 10 (bl-get x (bl-key "scale")))))
       (else (error "not a number"))))
(define (native-number-compare a b) (native-compare-number (native-ratio a) (native-ratio b)))
(define (native-decimal-parts x)
 (cond ((native-decimal? x) (cons (bl-get x (bl-key "unscaled")) (bl-get x (bl-key "scale"))))
       ((and (number? x) (integer? x) (exact? x)) (cons x 0))
       (else (error "a float cannot enter exact decimal arithmetic"))))
(define (native-terminating-decimal rational)
 (let* ((n (numerator rational)) (d (denominator rational)))
  (let twos ((d d) (p2 0))
   (if (= (modulo d 2) 0) (twos (quotient d 2) (+ p2 1))
    (let fives ((d d) (p5 0))
     (if (= (modulo d 5) 0) (fives (quotient d 5) (+ p5 1))
      (if (not (= d 1)) (error "non-terminating decimal expansion")
       (let ((scale (max p2 p5)))
        (bl-decimal (* n (expt 2 (- scale p2)) (expt 5 (- scale p5))) scale)))))))))
(define (native-num op a b)
 (cond
  ((or (eq? op 'lt) (eq? op 'gt) (eq? op 'le) (eq? op 'ge) (eq? op 'num_eq))
   ;; host/num.bl keeps raw term order/equality for non-decimal operands;
   ;; decimal promotion refuses an implicit float, even for comparisons.
   (if (and (or (native-decimal? a) (native-decimal? b))
            (or (bl-tag? a 'float) (bl-tag? b 'float)))
    (native-decimal-inexact! (if (bl-tag? a 'float) a b)))
   (if (and (eq? op 'num_eq) (not (or (native-decimal? a) (native-decimal? b))))
    (native-erlang-equal? a b)
    (let ((n (if (or (native-decimal? a) (native-decimal? b))
              (native-number-compare a b) (native-term-compare a b))))
     (case op ((lt) (< n 0)) ((gt) (> n 0)) ((le) (<= n 0)) ((ge) (>= n 0)) (else (= n 0))))))
  ((and (or (native-decimal? a) (native-decimal? b))
        (or (bl-tag? a 'float) (bl-tag? b 'float))) (native-decimal-inexact! (if (bl-tag? a 'float) a b)))
  ((or (native-decimal? a) (native-decimal? b))
   (let* ((pa (native-decimal-parts a)) (pb (native-decimal-parts b))
          (scale (max (cdr pa) (cdr pb)))
          (u (* (car pa) (expt 10 (- scale (cdr pa)))))
          (v (* (car pb) (expt 10 (- scale (cdr pb))))))
    (case op ((add) (bl-decimal (+ u v) scale)) ((sub) (bl-decimal (- u v) scale))
     ((mul) (bl-decimal (* (car pa) (car pb)) (+ (cdr pa) (cdr pb))))
     ((div) (native-terminating-decimal (/ (native-ratio a) (native-ratio b))))
     ((quot) (truncate (/ (native-ratio a) (native-ratio b))))
     (else (error "unsupported decimal arithmetic operation")))))
  ((or (bl-tag? a 'float) (bl-tag? b 'float))
   (let ((x (exact->inexact (native-ratio a))) (y (exact->inexact (native-ratio b))))
    (case op ((add) (bl-float (+ x y))) ((sub) (bl-float (- x y))) ((mul) (bl-float (* x y)))
     ((div) (bl-float (/ x y))) ((quot) (inexact->exact (truncate (/ x y))))
     ((rem) (bl-float (- x (* (truncate (/ x y)) y))))
     ((mod) (bl-float (- x (* (floor (/ x y)) y))))
     (else (error "unsupported float arithmetic operation")))))
  (else
   (case op ((add) (+ a b)) ((sub) (- a b)) ((mul) (* a b))
    ((div) (bl-float (/ (exact->inexact a) (exact->inexact b))))
    ((quot) (quotient a b)) ((rem) (remainder a b)) ((mod) (modulo a b))
    (else (error "unsupported numeric arithmetic operation"))))))
(set! bl-div (lambda (a b) (native-num 'div a b)))
(set! bl-inc (lambda (x) (native-num 'add x 1)))
(set! bl-dec (lambda (x) (native-num 'sub x 1)))

;; Generic language equality is separate from the raw map-key predicate.
(define (native-sequential? x) (or (native-list? x) (bl-tag? x 'vec)))
(define (native-seq-list x) (if (bl-tag? x 'vec) (bl-items x) x))
(set! bl-equal? (lambda (a b)
 (cond ((eq? a b) #t)
       ((and (native-number? a) (native-number? b)) (= (native-number-compare a b) 0))
       ((and (native-string? a) (native-string? b)) (= (native-compare-string a b) 0))
       ((and (native-sequential? a) (native-sequential? b))
        (let loop ((a (native-seq-list a)) (b (native-seq-list b)))
         (cond ((null? a) (null? b)) ((null? b) #f)
               (else (and (bl-equal? (car a) (car b)) (loop (cdr a) (cdr b)))))))
       ((and (bl-tag? a 'map) (bl-tag? b 'map))
        (and (= (native-map-count a) (native-map-count b))
         (let loop ((pairs (native-map-pairs a)))
          (or (null? pairs)
           (let* ((p (car pairs)) (k (bl-nth p 0)) (entry (native-tree-ref (native-map-root b) k)))
            (and (not (eq? entry native-missing)) (bl-equal? (bl-nth p 1) (cdr entry)) (loop (cdr pairs))))))))
       ((and (bl-tag? a 'set) (bl-tag? b 'set))
        (and (= (bl-count a) (bl-count b))
         (let loop ((xs (native-set-items a)))
          (or (null? xs) (and (native-map-has? (vector-ref b 1) (car xs)) (loop (cdr xs)))))))
       ((and (bl-tag? a 'tuple) (bl-tag? b 'tuple))
        (let loop ((a (bl-items a)) (b (bl-items b)))
         (cond ((null? a) (null? b)) ((null? b) #f)
          (else (and (bl-equal? (car a) (car b)) (loop (cdr a) (cdr b)))))))
       (else #f))))

;; $blfn is compiler data: {:$blfn {arity -> closure} {minimum closure}|nil}.
(define (native-multi-callable? f)
 (and (bl-tag? f 'tuple) (= (bl-count f) 3) (eq? (bl-nth f 0) (bl-key "$blfn"))))
(define (native-take xs n)
 (if (= n 0) '() (cons (car xs) (native-take (cdr xs) (- n 1)))))
(define (native-drop xs n) (if (= n 0) xs (native-drop (cdr xs) (- n 1))))
(define (native-resolve-call f xs)
 (if (native-multi-callable? f)
  (let* ((n (length xs)) (fixed (bl-get (bl-nth f 1) n native-missing)) (variadic (bl-nth f 2)))
   (cond ((not (eq? fixed native-missing)) (native-resolve-call fixed xs))
    ((and (not (bl-is-nil variadic)) (>= n (bl-nth variadic 0)))
     (let ((minimum (bl-nth variadic 0)))
      (native-resolve-call (bl-nth variadic 1) (append (native-take xs minimum) (list (native-drop xs minimum))))))
    (else (error "no callable arity"))))
  (cons f xs)))
(set! bl-invoke (lambda (f xs)
 (let* ((call (native-resolve-call f xs)) (f (car call)) (xs (cdr call)))
  (cond ((procedure? f) (apply f xs))
   ((native-keyword? f) (apply bl-get (cons (car xs) (cons f (cdr xs)))))
   ((bl-tag? f 'map) (apply bl-get (cons f xs)))
   ((bl-tag? f 'vec) (apply bl-nth (cons f xs)))
   ((bl-tag? f 'set) (if (native-map-has? (vector-ref f 1) (car xs)) (car xs) bl-nil))
   (else (error "value is not callable"))))))

;; A raise has explicit class/reason/raw trace. Catch variables and finally
;; flags are lexical; scheduler suspension never runs language finally.
(define (native-capture-stack) (h-logical-stack))
(define native-raise-marker (list 'native-raise-marker))
(define (native-raised? x)
 (and (vector? x) (= (vector-length x) 4) (eq? (vector-ref x 0) native-raise-marker)))
(define (native-raise kind reason trace) (raise (vector native-raise-marker kind reason trace)))
(define (native-exception-kind e)
 (cond ((native-raised? e) (vector-ref e 1)) ((bl-tag? e 'bl-exit) (bl-key "exit")) (else (bl-key "error"))))
(define (native-exception-reason e)
 (cond ((native-raised? e) (vector-ref e 2)) ((bl-tag? e 'bl-exit) (vector-ref e 1))
       (else (with-output-to-string "" (lambda () (display-exception e (current-output-port)))))))
(define (native-exception-trace e) (if (native-raised? e) (vector-ref e 3) (native-capture-stack)))
(define (bl-reraise kind reason trace) (native-raise kind reason trace))
(define (bl-try body handler after)
 ;; No dynamic-wind here: parking/yielding is suspension, not a language exit.
 ;; The continuation retains these lexical flags until normal/exceptional exit.
 (let ((finished? #f))
  (let ((cleanup (lambda () (if (not finished?)
                  (begin (set! finished? #t) (if after (after)))))))
   (with-exception-catcher
    (lambda (e) (cleanup) (raise e))
    (lambda ()
     (let ((value (with-exception-catcher
       (lambda (e) (handler (native-exception-kind e) (native-exception-reason e) (native-exception-trace e))) body)))
      (cleanup) value))))))
(set! bl-guard (lambda (thunk) (with-exception-catcher (lambda (e) #f) (lambda () (bl-truthy (thunk))))))
(set! h-exit (lambda (reason) (native-raise (bl-key "exit") reason (native-capture-stack))))
(set! h-raise (lambda (reason) (native-raise (bl-key "error") (if (string? reason) reason (bl-show reason)) (native-capture-stack))))
(define (native-throw reason) (native-raise (bl-key "throw") reason (native-capture-stack)))

;; Extend pattern matching with generic struct fields. Missing keys stay
;; distinct from nil-valued keys, and raw map patterns use exact key equality.
(set! bl-match (lambda (p v env)
 (and env
  (case (car p)
   ((var) (if (string=? (cadr p) "_")
           ;; Wildcards never unify, but the frozen emitter still emits an
           ;; unused assoc binding for _. Keep it present until emitter refresh.
           (cons (cons "_" v) env)
           (let ((old (assoc (cadr p) env)))
            (if old (and (bl-key-equal? (cdr old) v) env) (cons (cons (cadr p) v) env)))))
   ((lit) (and (bl-key-equal? (cadr p) v) env))
   ((nil) (and (null? v) env))
   ((tuple) (and (bl-tag? v 'tuple) (bl-match-args (cadr p) (bl-items v) env)))
   ((vector) (and (bl-tag? v 'vec) (bl-match (cadr p) (bl-tuple (bl-items v)) env)))
   ((cons) (and (pair? v) (bl-match (caddr p) (cdr v) (bl-match (cadr p) (car v) env))))
   ((alias) (bl-match (caddr p) v (bl-match (cadr p) v env)))
   ((map struct)
    (let* ((struct? (eq? (car p) 'struct))
           (fields (if struct? (native-struct-fields v) v))
           (patterns (if struct? (caddr p) (cadr p))))
     (and (bl-tag? fields 'map)
          (or (not struct?) (bl-key-equal? (native-struct-module v) (cadr p)))
          (let loop ((ps patterns) (b env))
           (if (or (not b) (null? ps)) b
            (let ((entry (native-tree-ref (native-map-root fields) (caar ps))))
             (and (not (eq? entry native-missing))
              (loop (cdr ps) (bl-match (cadar ps) (cdr entry) b)))))))))
   (else (error "native host: unsupported pattern"))))))

;; Diagnostics store real emitted source frames. Emitter may wrap entry with
;; native-with-frame; frames remain runtime observations, never source authority.
(define native-logical-frames (make-parameter '()))
(define native-max-frames 0)
(define (bl-with-source-frame frame thunk)
 (let ((stack (cons frame (native-logical-frames))))
  (set! native-max-frames (max native-max-frames (length stack)))
  ;; Parameters follow the captured continuation across scheduler suspension.
  (parameterize ((native-logical-frames stack))
   (with-exception-catcher
    (lambda (e)
     (if (native-raised? e) (raise e)
      (native-raise (native-exception-kind e) (native-exception-reason e) stack))) thunk))))
(define native-with-frame bl-with-source-frame)
(define (h-logical-stack) (native-logical-frames))
(define (h-max-frames) native-max-frames)
(set! h-make-frames (lambda (f args)
 (vector (lambda () (bl-invoke f (if (bl-tag? args 'vec) (bl-items args) args))
                   (seed-return (bl-map (bl-key "status") (bl-key "done")))))))
(set! h-run-turn (lambda (frame budget)
 (let ((prior-critical seed-critical))
  (set! seed-frame frame) (set! seed-budget budget)
  (let ((result
   (call-with-current-continuation
    (lambda (return)
     (set! seed-return return)
     (with-exception-catcher
      (lambda (e) (seed-return
       (bl-map (bl-key "status") (bl-key "error")
               (bl-key "kind") (native-exception-kind e)
               (bl-key "reason") (native-exception-reason e)
               (bl-key "frames") (native-exception-trace e))))
      (lambda () ((vector-ref frame 0)) (bl-map (bl-key "status") (bl-key "done"))))))))
   (set! seed-frame #f) (set! seed-return #f) (set! seed-critical prior-critical) result))))
(set! h-park-release (lambda ()
 (if (not (= seed-critical 1)) (h-raise "park-release requires exactly one critical section"))
 (set! seed-critical 0) (h-park "park")))

