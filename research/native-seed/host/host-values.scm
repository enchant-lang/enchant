    (case op ((add) (bl-decimal (+ u v) scale)) ((sub) (bl-decimal (- u v) scale))
     ((mul) (bl-decimal (* (car pa) (car pb)) (+ (cdr pa) (cdr pb))))
     ((div) (native-terminating-decimal (/ (native-ratio a) (native-ratio b))))
     ((quot) (truncate (/ (native-ratio a) (native-ratio b))))
     (else (error "unsupported decimal arithmetic operation")))))
  ((or (bl-tag? a 'float) (bl-tag? b 'float))
   (let ((x (exact->inexact (native-ratio a))) (y (exact->inexact (native-ratio b))))
    (case op ((add) (bl-float (+ x y))) ((sub) (bl-float (- x y))) ((mul) (bl-float (* x y)))
     ((div) (bl-float (/ x y))) ((quot) (inexact->exact (truncate (/ x y))))
     ((rem) (bl-float (- x (* (truncate (/ x y)) y))))
     ((mod) (bl-float (- x (* (floor (/ x y)) y))))
     (else (error "unsupported float arithmetic operation")))))
  (else
   (case op ((add) (+ a b)) ((sub) (- a b)) ((mul) (* a b))
    ((div) (bl-float (/ (exact->inexact a) (exact->inexact b))))
    ((quot) (quotient a b)) ((rem) (remainder a b)) ((mod) (modulo a b))
    (else (error "unsupported numeric arithmetic operation"))))))
(set! bl-div (lambda (a b) (native-num 'div a b)))
(set! bl-inc (lambda (x) (native-num 'add x 1)))
(set! bl-dec (lambda (x) (native-num 'sub x 1)))

;; Generic language equality is separate from the raw map-key predicate.
(define (native-sequential? x) (or (native-list? x) (bl-tag? x 'vec)))
(define (native-seq-list x) (if (bl-tag? x 'vec) (bl-items x) x))
(set! bl-equal? (lambda (a b)
 (cond ((eq? a b) #t)
       ;; Exact shortcuts. Distinct fixnums are unequal numbers; a symbol or
       ;; boolean is no number/string/collection, so only identity equals it
       ;; (while no non-vector is an opaque struct); scalar strings compare
       ;; equal exactly when their characters agree.
       ((and (fixnum? a) (fixnum? b)) #f)
       (native-opaque-nonvector-structs? (native-equal-general? a b))
       ((and (string? a) (string? b)) (string=? a b))
       ((or (symbol? a) (boolean? a) (symbol? b) (boolean? b)) #f)
       (else (native-equal-general? a b)))))
(define (native-equal-general? a b)
 (cond ((and (native-number? a) (native-number? b)) (= (native-number-compare a b) 0))
       ((and (native-string? a) (native-string? b)) (= (native-compare-string a b) 0))
       ((and (native-sequential? a) (native-sequential? b))
        (let loop ((a (native-seq-list a)) (b (native-seq-list b)))
         (cond ((null? a) (null? b)) ((null? b) #f)
               (else (and (bl-equal? (car a) (car b)) (loop (cdr a) (cdr b)))))))
       ((and (bl-tag? a 'map) (bl-tag? b 'map))
        (and (= (native-map-count a) (native-map-count b))
         (native-map-every?
          (lambda (k v) (let ((other (native-map-ref b k native-missing)))
           (and (not (eq? other native-missing)) (bl-equal? v other)))) a)))
       ((and (bl-tag? a 'set) (bl-tag? b 'set))
        (and (= (bl-count a) (bl-count b))
         (native-map-every? (lambda (k v) (native-map-has? (vector-ref b 1) k)) (vector-ref a 1))))
       ((and (bl-tag? a 'tuple) (bl-tag? b 'tuple))
        ;; Elementwise over the common prefix first, as the former list walk
        ;; did (element comparisons may assign lazy opaque ids), then sizes.
        (let* ((a (vector-ref a 1)) (b (vector-ref b 1))
               (n (vector-length a)) (m (vector-length b)) (k (fxmin n m)))
         (let loop ((i 0))
          (if (fx= i k) (fx= n m)
           (and (bl-equal? (vector-ref a i) (vector-ref b i)) (loop (fx+ i 1)))))))
       (else #f)))

;; $blfn is compiler data: {:$blfn {arity -> closure} {minimum closure}|nil}.
(define (native-multi-callable? f)
 (and (bl-tag? f 'tuple) (= (bl-count f) 3) (eq? (bl-nth f 0) (quote |:$blfn|))))
(define (native-take xs n)
 (if (= n 0) '() (cons (car xs) (native-take (cdr xs) (- n 1)))))
(define (native-drop xs n) (if (= n 0) xs (native-drop (cdr xs) (- n 1))))
(define (native-resolve-call f xs)
 (if (native-multi-callable? f)
  (let* ((n (length xs)) (fixed (bl-get (bl-nth f 1) n native-missing)) (variadic (bl-nth f 2)))
   (cond ((not (eq? fixed native-missing)) (native-resolve-call fixed xs))
    ((and (not (bl-is-nil variadic)) (>= n (bl-nth variadic 0)))
     (let ((minimum (bl-nth variadic 0)))
      (native-resolve-call (bl-nth variadic 1) (append (native-take xs minimum) (list (native-drop xs minimum))))))
    (else (error "no callable arity"))))
  (cons f xs)))
;; The original resolver leaves genuine procedures and their argument spine
;; unchanged. Avoid allocating its transient (callee . arguments) pair only
;; while that exact planner is still installed. C/Source/custom planners keep
;; the complete generic path, including target/argument replacement and errors.
(define native-invoke-original-resolve native-resolve-call)
(set! bl-invoke (lambda (f xs)
 (if (and (procedure? f) (eq? native-resolve-call native-invoke-original-resolve))
  (apply f xs)
  (let* ((call (native-resolve-call f xs)) (f (car call)) (xs (cdr call)))
   (cond ((procedure? f) (apply f xs))
    ((native-keyword? f) (apply bl-get (cons (car xs) (cons f (cdr xs)))))
    ((bl-tag? f 'map) (apply bl-get (cons f xs)))
    ((bl-tag? f 'vec) (apply bl-nth (cons f xs)))
    ;; the STORED (canonical) member, as on BEAM: (#{1} 1.0) is 1
    ((bl-tag? f 'set) (let ((k (native-key-canon (car xs)))) (if (native-map-has? (vector-ref f 1) k) k bl-nil)))
    (else (error "value is not callable")))))))

;; A raise has explicit class/reason/raw trace. Catch variables and finally
;; flags are lexical; scheduler suspension never runs language finally.
(define (native-capture-stack) (h-logical-stack))
(define native-raise-marker (list 'native-raise-marker))
(define (native-raised? x)
 (and (vector? x) (= (vector-length x) 4) (eq? (vector-ref x 0) native-raise-marker)))
(define (native-raise kind reason trace) (raise (vector native-raise-marker kind reason trace)))
(define (native-exception-kind e)
 (cond ((native-raised? e) (vector-ref e 1)) ((bl-tag? e 'bl-exit) (bl-key "exit")) (else (bl-key "error"))))
(define (native-exception-reason e)
 (cond ((native-raised? e) (vector-ref e 2)) ((bl-tag? e 'bl-exit) (vector-ref e 1))
       (else (with-output-to-string "" (lambda () (display-exception e (current-output-port)))))))
(define (native-exception-trace e) (if (native-raised? e) (vector-ref e 3) (native-capture-stack)))
(define (bl-reraise kind reason trace) (native-raise kind reason trace))
(define (bl-try body handler after)
 ;; No dynamic-wind here: parking/yielding is suspension, not a language exit.
 ;; The continuation retains these lexical flags until normal/exceptional exit.
 (let ((finished? #f))
  (let ((cleanup (lambda () (if (not finished?)
                  (begin (set! finished? #t) (if after (after)))))))
   (with-exception-catcher
    (lambda (e) (cleanup) (raise e))
    (lambda ()
     (let ((value (with-exception-catcher
       (lambda (e) (handler (native-exception-kind e) (native-exception-reason e) (native-exception-trace e))) body)))
      (cleanup) value))))))
(set! bl-guard (lambda (thunk) (with-exception-catcher (lambda (e) #f) (lambda () (bl-truthy (thunk))))))
(set! h-exit (lambda (reason) (native-raise (bl-key "exit") reason (native-capture-stack))))
(set! h-raise (lambda (reason) (native-raise (bl-key "error") (if (string? reason) reason (bl-show reason)) (native-capture-stack))))
(define (native-throw reason) (native-raise (bl-key "throw") reason (native-capture-stack)))

;; Extend pattern matching with generic struct fields. Missing keys stay
;; distinct from nil-valued keys, and raw map patterns use exact key equality.
(set! bl-match (lambda (p v env)
 (and env
  (case (car p)
   ((var) (if (string=? (cadr p) "_")
           ;; Wildcards never unify, but the frozen emitter still emits an
           ;; unused assoc binding for _. Keep it present until emitter refresh.
           (cons (cons "_" v) env)
           (let ((old (assoc (cadr p) env)))
            (if old (and (bl-key-equal? (cdr old) v) env) (cons (cons (cadr p) v) env)))))
   ((lit) (and (bl-key-equal? (cadr p) v) env))
   ((nil) (and (null? v) env))
   ((tuple) (and (bl-tag? v 'tuple) (bl-match-args (cadr p) (bl-items v) env)))
   ((vector) (and (bl-tag? v 'vec) (bl-match (cadr p) (bl-tuple (bl-items v)) env)))
   ((cons) (and (pair? v) (bl-match (caddr p) (cdr v) (bl-match (cadr p) (car v) env))))
   ((alias) (bl-match (caddr p) v (bl-match (cadr p) v env)))
   ((map struct)
    (let* ((struct? (eq? (car p) 'struct))
           (fields (if struct? (native-struct-fields v) v))
           (patterns (if struct? (caddr p) (cadr p))))
     (and (bl-tag? fields 'map)
          (or (not struct?) (bl-key-equal? (native-struct-module v) (cadr p)))
          (let loop ((ps patterns) (b env))
           (if (or (not b) (null? ps)) b
            (let ((value (native-map-ref fields (caar ps) native-missing)))
             (and (not (eq? value native-missing))
              (loop (cdr ps) (bl-match (cadar ps) value b)))))))))
   (else (error "native host: unsupported pattern"))))))

;; The logical source stack of debug (source-frame) emission: records
;; #(site critical depth), innermost first, and the pending call site.
;; Release code never touches them; host/host-source-frames.scm installs the
;; site operations and answers frames. Frames are runtime observations, never
;; source authority.
(define native-source-frames '())
(define native-source-pending #f)
(define native-max-frames 0)
(define (h-logical-stack) '())
(define (native-logical-frames) (h-logical-stack))
(define (h-max-frames) native-max-frames)
(set! h-make-frames (lambda (f args)
 (vector (lambda () (bl-invoke f (if (bl-tag? args 'vec) (bl-items args) args))
                   (seed-return (bl-map (bl-key "status") (bl-key "done")))))))
(set! h-run-turn (lambda (frame budget)
 (let ((prior-critical seed-critical))
  (set! seed-frame frame) (set! seed-budget budget)
  (let ((result
   (call-with-current-continuation
    (lambda (return)
     (set! seed-return return)
     (with-exception-catcher
      (lambda (e) (seed-return
       (bl-map (bl-key "status") (bl-key "error")
               (bl-key "kind") (native-exception-kind e)
               (bl-key "reason") (native-exception-reason e)
               (bl-key "frames") (native-exception-trace e))))
      (lambda () ((vector-ref frame 0)) (bl-map (bl-key "status") (bl-key "done"))))))))
   (set! seed-frame #f) (set! seed-return #f) (set! seed-critical prior-critical) result))))
(set! h-park-release (lambda ()
 (if (not (= seed-critical 1)) (h-raise "park-release requires exactly one critical section"))
 (set! seed-critical 0) (h-park "park")))

;; Pure actor ABI. These adapters own storage/predicates only; actor policy is BL.
(define h-kw bl-key)
(define h-kw-name native-atom-name)
(define h-is-kw native-keyword?)
(define h-cons cons)
(define h-is-cons pair?)
(define h-is-list native-list?)
(define h-cons-head car)
(define h-cons-tail cdr)
;; The native transport for a JavaScript host array is a canonical Vector.
;; Consume its logical elements, including a >32-element trie, before building
;; the raw BL tuple. Backend-owned raw proper lists keep their existing ABI.
(define (h-list->array items)
 (if (not (native-list? items)) (error "host/list->array requires a proper BL list"))
 (bl-vec items))
(define (h-tup items)
 (cond ((bl-tag? items 'vec) (bl-tuple (bl-items items)))
       ((native-list? items) (bl-tuple items))
       (else (error "host/tup requires a native host array transport"))))
(define (h-is-tup x) (bl-tag? x 'tuple))
(define h-tup-el bl-nth)
(define h-tup-size bl-count)
(define h-struct bl-struct)
(define (h-is-struct x) (not (bl-is-nil (native-struct-module x))))
(define (h-struct-mod x)
 (let ((mod (native-struct-module x))) (if (bl-is-nil mod) bl-nil (native-atom-name mod))))
(define (h-struct-field x field)
 (bl-get (native-struct-fields x) (if (string? field) (bl-key field) field)))
(set! h-vec-from-list bl-vec)
(set! h-vec-size native-vector-count)
(set! h-vec-el native-vector-ref)
(define h-vec-append bl-conj)
(define h-vec-to-list bl-items)
(set! h-vec-remove (lambda (v index)
 (if (or (< index 0) (>= index (native-vector-count v))) (error "vector index out of range")
  (let loop ((xs (bl-items v)) (i 0) (out '()))
   (if (null? xs) (bl-vec (reverse out))
    (loop (cdr xs) (+ i 1) (if (= i index) out (cons (car xs) out))))))))
(define (h-is-set x) (bl-tag? x 'set))
(define h-set-from-list native-set-from-list)
(define h-set-put native-set-put)
(define h-set-remove native-set-remove)
(define (h-set-has s x) (native-map-has? (vector-ref s 1) x))
(define h-set-size bl-count)
(define h-set-to-list native-set-items)
(define (h-bmap pairs)
 (let loop ((pairs pairs) (m (bl-empty-map)))
  (if (null? pairs) m (let ((p (car pairs)))
   (loop (cdr pairs) (native-raw-assoc m (bl-nth p 0) (bl-nth p 1)))))))
(set! h-empty-map bl-empty-map)
(define (h-is-map x) (bl-tag? x 'map))
(define h-map-get bl-get)
(define h-map-put bl-assoc)
(set! h-map-remove native-map-remove)
(set! h-map-keys (lambda (m) (if (bl-tag? m 'map) (native-map-keys m) '())))
(set! h-map-size (lambda (m) (if (bl-tag? m 'map) (native-map-count m) 0)))
(set! h-eq bl-equal?)
(define h-identical bl-key-equal?)
(set! h-is-int (lambda (x) (and (number? x) (integer? x) (exact? x))))
(define (h-is-float x) (bl-tag? x 'float))
(define h-is-num native-number?)
(define (h-is-bool x) (boolean? x))
(define (h-is-fn x) (or (procedure? x) (native-multi-callable? x)))
(set! h-lt (lambda (a b)
 (cond ((and (native-number? a) (native-number? b)) (< (native-number-compare a b) 0))
       ((and (native-string? a) (native-string? b)) (< (native-compare-string a b) 0))
       (else (h-raise "order requires numbers or strings")))))
(set! h-arith (lambda (op a b) (native-num (string->symbol op) a b)))
(define (h-to-str x)
 (cond ((string? x) x) ((native-keyword? x) (native-atom-name x))
       ((bl-is-nil x) "nil") ((eq? x #t) "true") ((eq? x #f) "false")
       (else (bl-show x))))
(set! h-str-cat (lambda xs (apply string-append (map h-to-str xs))))
(define h-str-size string-length)
(define (h-str-codepoints s) (map char->integer (string->list s)))
(define h-str-slice substring)
(define h-str-cmp native-compare-string)
(define (h-ex-kind e) (native-exception-kind e))
(define (h-ex-reason e) (native-exception-reason e))
(define (h-ex-trace e) (native-exception-trace e))

;; Mutable table storage has a private marker and runtime identity. There is no
;; owner/heir/name/access policy here. BL runtime owns all those decisions.
(define native-table-marker (list 'native-table-marker))
(define native-runtime-marker (list 'native-runtime-marker))
(define native-tables '())
(define (h-is-table x)
 (and (vector? x) (= (vector-length x) 5) (eq? (vector-ref x 0) native-table-marker)))
(define (native-table-check x)
 (if (not (and (h-is-table x) (eq? (vector-ref x 1) native-runtime-marker) (vector-ref x 2)))
  (h-raise "table handle is dead, foreign, or invalid") x))
(define (h-table-new)
 (if (>= (length native-tables) 65536) (h-raise "too many live tables"))
 (let ((table (vector native-table-marker native-runtime-marker #t (bl-empty-map) '())))
  (set! native-tables (cons table native-tables)) table))
(define (h-table-lookup table key)
 (native-table-check table)
 (let ((entry (native-map-entry (vector-ref table 3) (native-key-canon key))))
  (if (eq? entry native-missing) bl-nil (bl-tuple (list (car entry) (cdr entry))))))
(define (h-table-insert table key value)
 (native-table-check table)
 ;; the key order list holds the stored (canonical) key, like the map
 (let ((map (vector-ref table 3)) (key (native-key-canon key)))
  (if (not (native-map-has? map key))
   (begin (if (>= (native-map-count map) 1048576) (h-raise "table is full"))
    (vector-set! table 4 (append (vector-ref table 4) (list key)))))
  (vector-set! table 3 (bl-assoc map key value)) #t))
(define (h-table-delete table key)
 (native-table-check table)
 (let* ((key (native-key-canon key)) (map (vector-ref table 3)) (found (native-map-has? map key)))
  (if found
   (begin (vector-set! table 3 (native-map-remove map key))
    (vector-set! table 4 (let loop ((xs (vector-ref table 4)))
      (cond ((null? xs) '()) ((bl-key-equal? key (car xs)) (cdr xs))
       (else (cons (car xs) (loop (cdr xs))))))))) found))
(define (h-table-size table) (native-table-check table) (native-map-count (vector-ref table 3)))
(define (h-table-destroy table)
 (native-table-check table) (vector-set! table 2 #f)
 (vector-set! table 3 #f) (vector-set! table 4 '())
 (set! native-tables (let loop ((xs native-tables))
  (cond ((null? xs) '()) ((eq? table (car xs)) (cdr xs)) (else (cons (car xs) (loop (cdr xs))))))) #t)
(define (h-table-snapshot table)
 (native-table-check table)
 (map (lambda (key) (h-table-lookup table key)) (vector-ref table 4)))

;; Input is an actual bounded queue, not a manufactured capability result.
;; No producer is registered by default. A finite deadline remains waitable;
;; an indefinite empty-input wait without a producer fails explicitly.
(define native-input-queue '())
(define native-input-producer #f)
(define (native-input! value)
 (if (>= (length native-input-queue) 4096) (h-raise "native input queue is full"))
 (set! native-input-queue (append native-input-queue (list value))) bl-nil)
(define (h-input-size) (length native-input-queue))
(define (h-take-input)
 (let ((batch native-input-queue)) (set! native-input-queue '()) (bl-vec batch)))
(set! h-wait-input (lambda ()
 (cond ((pair? native-input-queue) bl-nil)
       (native-input-producer (native-input-producer #f))
       (else (h-raise "no native input producer is registered")))))
(define native-output-sink #f)
(define (h-emit topic value)
 (if native-output-sink (native-output-sink topic value) (h-raise "no native output sink is registered")))
(define native-global-registry (bl-empty-map))
(define (h-ref ns name) (bl-get native-global-registry (string-append ns "/" name)))
;; AOT link records, one per "ns/name" slot: #(compiled-value slot-setter
;; global-setter). AOT code reads Scheme cells that these setters maintain
;; (native-link! in host-compiler.scm); the dynamic native-remote path reads
;; the record's value. Publication is the only way a slot changes.
(define native-link-records (make-table test: equal?))
(define (native-link-record key)
 (or (table-ref native-link-records key #f)
  (let ((record (vector native-missing #f #f)))
   (table-set! native-link-records (string-copy key) record) record)))
;; Installed by host-compiler.scm: publishes the global view of a slot.
(define native-publish-global! (lambda (ns name record) #f))
(define (native-register! ns name value)
 (let* ((key (string-append ns "/" name)) (record (native-link-record key)))
  (set! native-global-registry (bl-assoc native-global-registry key value))
  (vector-set! record 0 value)
  (if (vector-ref record 1) ((vector-ref record 1) value))
  (native-publish-global! ns name record)
  value))

;; File and evaluation leaves used by the native bootstrap driver.
(define (native-eval-string text)
 (let ((port (open-input-string text)))
  (let loop ((answer bl-nil))
   (let ((form (read port)))
    (if (eof-object? form) answer (loop (eval form (interaction-environment))))))))
(define (native-read-file path)
 (call-with-input-file path
  (lambda (port)
   ;; Preserve the original decoder, newline policy and read-char errors.
   (let ((capacity 4096))
    (let loop ((chunk (make-string capacity)) (used 0) (prefix 0) (previous '()))
     (let ((ch (read-char port)))
      (cond ((eof-object? ch)
             (if (= prefix 0) (substring chunk 0 used)
                 (let ((text (make-string (+ prefix used))))
                  (substring-move! chunk 0 used text prefix)
                  (let copy ((blocks previous) (end prefix))
                   (if (null? blocks) text
                       (let ((start (- end capacity)))
                        (substring-move! (car blocks) 0 capacity text start)
                        (copy (cdr blocks) start)))))))
            ((= used capacity)
             (let ((next (make-string capacity)))
              (string-set! next 0 ch)
              (loop next 1 (+ prefix capacity) (cons chunk previous))))
            (else
             (string-set! chunk used ch)
             (loop chunk (+ used 1) prefix previous)))))))))
(define (native-write-file path text)
 (call-with-output-file path (lambda (port) (display text port))) bl-nil)
(define (native-command-line) (cdr (command-line)))

;; Native-only real-time bindings are installed by native-posix.scm. The
;; deterministic clock remains selectable for replayable semantic fixtures.
(define native-clock-reader #f)
(define native-readiness-waiter #f)
(define native-virtual-time? #t)
(define (native-use-real-time!)
 (if (not (and native-clock-reader native-readiness-waiter)) (h-raise "native POSIX clock/readiness adapter is not installed"))
 (set! native-virtual-time? #f) bl-nil)
(set! h-now (lambda () (if native-virtual-time? seed-clock (native-clock-reader))))
(set! h-wait-until (lambda (ms input?)
 ;; JS hostWait arms its finite timer even when no input transport is active.
 ;; Enabling optional input must not remove that independent deadline wake.
 (cond ((and input? (pair? native-input-queue)) bl-nil)
       ((and input? native-input-producer) (native-input-producer ms))
       (native-virtual-time? (set! seed-clock (+ seed-clock ms)))
       (else (native-readiness-waiter ms))) bl-nil))

(define (bl-arithmetic op a b)
 (native-num (cond ((string? op) (string->symbol op))
                   ((native-keyword? op) (string->symbol (native-atom-name op)))
                   (else op)) a b))

;; Diagnostic rendering only. Canonical print/str algorithms remain in rt.bl.
(define (native-decimal-text x)
 (let* ((u (bl-get x (bl-key "unscaled"))) (scale (bl-get x (bl-key "scale")))
        (digits (number->string (abs u))) (sign (if (< u 0) "-" "")))
  (if (<= scale 0) (string-append sign digits (make-string (- scale) #\0))
   (let* ((padded (if (<= (string-length digits) scale)
          (string-append (make-string (+ 1 (- scale (string-length digits))) #\0) digits) digits))
          (split (- (string-length padded) scale)))
    (string-append sign (substring padded 0 split) "." (substring padded split (string-length padded)))))))
(define (native-render x readable?)
 (cond ((bl-is-nil x) "nil") ((eq? x #t) "true") ((eq? x #f) "false")
  ((string? x) (if readable? (let ((p (open-output-string))) (write x p) (get-output-string p)) x))
  ((native-keyword? x) (symbol->string x)) ((h-is-int x) (number->string x))
  ((bl-tag? x 'float) (native-shortest-float-text x))
  ((native-decimal? x) (string-append (native-decimal-text x) "M"))
  ((procedure? x) "#<function>")
  ((or (native-list? x) (bl-tag? x 'vec) (bl-tag? x 'tuple) (bl-tag? x 'set) (bl-tag? x 'map))
