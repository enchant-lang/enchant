  ((and (string? a) (string? b)) (native-scalar-string-compare a b))
  (else (native-unit-compare (native-utf16-units a) (native-utf16-units b))))))
(set! h-is-str native-string?)
(set! h-str-size native-utf16-size)
(set! h-str-cmp native-compare-string)
(set! h-str-codepoints (lambda (text)
 (let loop ((xs (native-utf16-units text)) (out '()))
  (if (null? xs) (reverse out)
   (if (and (>= (car xs) 55296) (< (car xs) 56320) (pair? (cdr xs)) (>= (cadr xs) 56320) (< (cadr xs) 57344))
    (loop (cddr xs) (cons (+ 65536 (* (- (car xs) 55296) 1024) (- (cadr xs) 56320)) out))
    (loop (cdr xs) (cons (car xs) out)))))))
(define native-scalar-to-str h-to-str)
(set! h-to-str (lambda (x) (if (native-utf16-fragment? x) x (native-scalar-to-str x))))
(set! h-str-cat (lambda xs
