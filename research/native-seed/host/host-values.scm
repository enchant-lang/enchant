;; Mutable table storage has a private marker and runtime identity. There is no
;; owner/heir/name/access policy here. BL runtime owns all those decisions.
(define native-table-marker (list 'native-table-marker))
(define native-runtime-marker (list 'native-runtime-marker))
(define native-tables '())
(define (h-is-table x)
 (and (vector? x) (= (vector-length x) 5) (eq? (vector-ref x 0) native-table-marker)))
(define (native-table-check x)
 (if (not (and (h-is-table x) (eq? (vector-ref x 1) native-runtime-marker) (vector-ref x 2)))
  (h-raise "table handle is dead, foreign, or invalid") x))
(define (h-table-new)
 (if (>= (length native-tables) 65536) (h-raise "too many live tables"))
 (let ((table (vector native-table-marker native-runtime-marker #t (bl-empty-map) '())))
  (set! native-tables (cons table native-tables)) table))
(define (h-table-lookup table key)
 (native-table-check table)
 (let ((entry (native-tree-ref (native-map-root (vector-ref table 3)) key)))
  (if (eq? entry native-missing) bl-nil (bl-tuple (list (car entry) (cdr entry))))))
(define (h-table-insert table key value)
 (native-table-check table)
 (let ((map (vector-ref table 3)))
  (if (not (native-map-has? map key))
   (begin (if (>= (native-map-count map) 1048576) (h-raise "table is full"))
    (vector-set! table 4 (append (vector-ref table 4) (list key)))))
  (vector-set! table 3 (bl-assoc map key value)) #t))
(define (h-table-delete table key)
 (native-table-check table)
 (let* ((map (vector-ref table 3)) (found (native-map-has? map key)))
  (if found
   (begin (vector-set! table 3 (native-map-remove map key))
    (vector-set! table 4 (let loop ((xs (vector-ref table 4)))
      (cond ((null? xs) '()) ((bl-key-equal? key (car xs)) (cdr xs))
       (else (cons (car xs) (loop (cdr xs))))))))) found))
(define (h-table-size table) (native-table-check table) (native-map-count (vector-ref table 3)))
(define (h-table-destroy table)
 (native-table-check table) (vector-set! table 2 #f)
 (vector-set! table 3 #f) (vector-set! table 4 '())
 (set! native-tables (let loop ((xs native-tables))
  (cond ((null? xs) '()) ((eq? table (car xs)) (cdr xs)) (else (cons (car xs) (loop (cdr xs))))))) #t)
(define (h-table-snapshot table)
 (native-table-check table)
 (map (lambda (key) (h-table-lookup table key)) (vector-ref table 4)))

;; Input is an actual bounded queue, not a manufactured capability result.
;; No producer is registered by default. Waiting without one fails explicitly.
(define native-input-queue '())
(define native-input-producer #f)
(define (native-input! value)
 (if (>= (length native-input-queue) 4096) (h-raise "native input queue is full"))
 (set! native-input-queue (append native-input-queue (list value))) bl-nil)
(define (h-input-size) (length native-input-queue))
(define (h-take-input)
 (let ((batch native-input-queue)) (set! native-input-queue '()) (bl-vec batch)))
(set! h-wait-input (lambda ()
 (if native-input-producer (native-input-producer #f) (h-raise "no native input producer is registered"))))
(define native-output-sink #f)
(define (h-emit topic value)
 (if native-output-sink (native-output-sink topic value) (h-raise "no native output sink is registered")))
(define native-global-registry (bl-empty-map))
(define (h-ref ns name) (bl-get native-global-registry (string-append ns "/" name)))
(define (native-register! ns name value)
 (set! native-global-registry (bl-assoc native-global-registry (string-append ns "/" name) value)) value)

;; File and evaluation leaves used by the native bootstrap driver.
(define (native-eval-string text)
 (let ((port (open-input-string text)))
  (let loop ((answer bl-nil))
   (let ((form (read port)))
    (if (eof-object? form) answer (loop (eval form (interaction-environment))))))))
(define (native-read-file path)
 (call-with-input-file path
  (lambda (port) (let loop ((chars '()))
   (let ((ch (read-char port)))
    (if (eof-object? ch) (list->string (reverse chars)) (loop (cons ch chars))))))))
(define (native-write-file path text)
 (call-with-output-file path (lambda (port) (display text port))) bl-nil)
(define (native-command-line) (cdr (command-line)))

;; Native-only real-time bindings are installed by native-posix.scm. The
;; deterministic clock remains selectable for replayable semantic fixtures.
(define native-clock-reader #f)
(define native-readiness-waiter #f)
(define native-virtual-time? #t)
(define (native-use-real-time!)
 (if (not (and native-clock-reader native-readiness-waiter)) (h-raise "native POSIX clock/readiness adapter is not installed"))
 (set! native-virtual-time? #f) bl-nil)
(set! h-now (lambda () (if native-virtual-time? seed-clock (native-clock-reader))))
(set! h-wait-until (lambda (ms input?)
 (if input?
  (if native-input-producer (native-input-producer ms) (h-raise "no native input producer is registered"))
  (if native-virtual-time? (set! seed-clock (+ seed-clock ms)) (native-readiness-waiter ms))) bl-nil))

(define (bl-arithmetic op a b)
 (native-num (cond ((string? op) (string->symbol op))
                   ((native-keyword? op) (string->symbol (native-atom-name op)))
                   (else op)) a b))

;; Diagnostic rendering only. Canonical print/str algorithms remain in rt.bl.
(define (native-decimal-text x)
 (let* ((u (bl-get x (bl-key "unscaled"))) (scale (bl-get x (bl-key "scale")))
        (digits (number->string (abs u))) (sign (if (< u 0) "-" "")))
  (if (<= scale 0) (string-append sign digits (make-string (- scale) #\0))
   (let* ((padded (if (<= (string-length digits) scale)
          (string-append (make-string (+ 1 (- scale (string-length digits))) #\0) digits) digits))
          (split (- (string-length padded) scale)))
    (string-append sign (substring padded 0 split) "." (substring padded split (string-length padded)))))))
(define (native-render x readable?)
 (cond ((bl-is-nil x) "nil") ((eq? x #t) "true") ((eq? x #f) "false")
  ((string? x) (if readable? (let ((p (open-output-string))) (write x p) (get-output-string p)) x))
  ((native-keyword? x) (symbol->string x)) ((h-is-int x) (number->string x))
  ((bl-tag? x 'float) (native-shortest-float-text x))
  ((native-decimal? x) (string-append (native-decimal-text x) "M"))
  ((procedure? x) "#<function>")
  ((or (native-list? x) (bl-tag? x 'vec) (bl-tag? x 'tuple) (bl-tag? x 'set) (bl-tag? x 'map))
   (let* ((list? (native-list? x)) (vec? (bl-tag? x 'vec)) (map? (bl-tag? x 'map)) (set? (bl-tag? x 'set))
      (xs (cond (list? x) (map? (apply append (map bl-items (native-map-pairs x))))
           (set? (native-set-items x)) (else (bl-items x))))
      (open (cond (list? "(") (vec? "[") (set? "#{") (else "{")))
      (close (cond (list? ")") (vec? "]") (else "}"))))
    (string-append open
     (let loop ((xs xs)) (if (null? xs) ""
      (string-append (native-render (car xs) #t) (if (null? (cdr xs)) "" " ") (loop (cdr xs))))) close)))
  ((pair? x) (string-append "(" (native-render (car x) #t) " . " (native-render (cdr x) #t) ")"))
  (else "#<native-resource>")))
(set! bl-show (lambda (x) (native-render x #f)))
(set! h-describe (lambda (x) (native-render x #t)))

;; The emitter annotates fixed Scheme closures; $blfn already carries clauses.
(define native-callable-arities (make-table test: eq? weak-keys: #t))
(define (bl-register-callable! f arity)
 (if (not (and (procedure? f) (h-is-int arity) (>= arity 0))) (error "invalid native callable annotation"))
 (let ((arities (table-ref native-callable-arities f '())))
  (if (not (memv arity arities)) (table-set! native-callable-arities f (cons arity arities)))) f)
(define (native-callable-accepts? f n)
 (and (h-is-int n) (>= n 0)
  (cond ((native-multi-callable? f)
   (or (native-map-has? (bl-nth f 1) n)
    (let ((v (bl-nth f 2))) (and (not (bl-is-nil v)) (>= n (bl-nth v 0))))))
   ((procedure? f) (let ((entry (table-ref native-callable-arities f #f)))
     (if entry (if (memv n entry) #t #f) (error "native callable lacks emitted arity annotation"))))
   (else #f))))

;; Actor strings use JavaScript UTF16 offsets independently of canonical
;; Elixir.String grapheme APIs and Unicode/UTF8 binary APIs.
(define (native-utf16-units text)
 (let loop ((cs (string->list text)) (out '()))
  (if (null? cs) (reverse out) (let ((cp (char->integer (car cs))))
   (if (< cp 65536) (loop (cdr cs) (cons cp out))
    (let ((n (- cp 65536))) (loop (cdr cs)
     (cons (+ 56320 (modulo n 1024)) (cons (+ 55296 (quotient n 1024)) out)))))))))
(define (native-from-utf16 units)
 (let loop ((xs units) (out '()))
  (if (null? xs) (list->string (reverse out))
   (if (and (>= (car xs) 55296) (< (car xs) 56320) (pair? (cdr xs)) (>= (cadr xs) 56320) (< (cadr xs) 57344))
    (loop (cddr xs) (cons (integer->char (+ 65536 (* (- (car xs) 55296) 1024) (- (cadr xs) 56320))) out))
    (loop (cdr xs) (cons (integer->char (car xs)) out))))))
(define (native-utf16-size text)
 (let loop ((cs (string->list text)) (n 0))
  (if (null? cs) n (loop (cdr cs) (+ n (if (> (char->integer (car cs)) 65535) 2 1))))))
(set! h-str-size native-utf16-size)
(set! h-str-slice (lambda (text start end)
 (let* ((xs (native-utf16-units text)) (n (length xs))
        (a (if (< start 0) (max 0 (+ n start)) (min n start)))
        (b (if (< end 0) (max 0 (+ n end)) (min n end))))
  (native-from-utf16 (native-take (native-drop xs a) (max 0 (- b a)))))))
(define (native-js-float-text value)
 (if (= value 0) "0"
  (let* ((text (number->string (abs value))) (size (string-length text))
         (split (let loop ((i 0)) (cond ((= i size) size)
                  ((or (char=? (string-ref text i) #\e) (char=? (string-ref text i) #\E)) i) (else (loop (+ i 1))))))
         (exp (if (= split size) 0 (string->number (substring text (+ split 1) size))))
         (mantissa (substring text 0 split))
         (point (let loop ((i 0)) (cond ((= i split) split) ((char=? (string-ref mantissa i) #\.) i) (else (loop (+ i 1))))))
         (digits (list->string (let loop ((cs (string->list mantissa)))
                   (cond ((null? cs) '()) ((char=? (car cs) #\.) (loop (cdr cs))) (else (cons (car cs) (loop (cdr cs))))))))
         (first (let loop ((i 0)) (if (and (< i (string-length digits)) (char=? (string-ref digits i) #\0)) (loop (+ i 1)) i)))
         (last (let loop ((i (string-length digits))) (if (and (> i (+ first 1)) (char=? (string-ref digits (- i 1)) #\0)) (loop (- i 1)) i)))
         (digits (substring digits first last)) (scientific (+ exp (- point first 1)))
         (length (string-length digits)) (sign (if (< value 0) "-" "")))
   (string-append sign
    (if (and (>= scientific -6) (< scientific 21))
     (let ((at (+ scientific 1)))
      (cond ((<= at 0) (string-append "0." (make-string (- at) #\0) digits))
       ((>= at length) (string-append digits (make-string (- at length) #\0)))
       (else (string-append (substring digits 0 at) "." (substring digits at length)))))
     (string-append (substring digits 0 1) (if (= length 1) "" (string-append "." (substring digits 1 length)))
      "e" (if (>= scientific 0) "+" "") (number->string scientific)))))))
(define (native-actor-encoded-length lengths)
 (+ 3 (string-length (number->string (length lengths)))
    (let loop ((xs lengths) (n 0))
     (if (null? xs) n (loop (cdr xs) (+ n (string-length (number->string (car xs))) 1 (car xs)))))))
(define (native-actor-key-length x)
 (cond ((bl-is-nil x) 3) ((boolean? x) 3)
  ((h-is-int x) (+ 2 (string-length (number->string x))))
  ((bl-tag? x 'float) (+ 2 (string-length (native-js-float-text (vector-ref x 1)))))
  ((native-decimal? x) (+ 3 (string-length (number->string (bl-get x (bl-key "unscaled")))) (string-length (number->string (bl-get x (bl-key "scale"))))))
