;; Native ABI extension. Append after host.scm, before compiled BL definitions.
;; Language algorithms remain in compiled core/rt. This file owns storage,
;; raw BEAM-shaped primitives, call/exception control, and host capabilities.
;; Native map storage is a persistent AVL tree and vectors are persistent
;; binary tries. Neither representation exposes mutable storage to BL code.

(define native-key-intern bl-key)
(set! bl-key (lambda (name)
 (cond ((string=? name "nil") bl-nil) ((string=? name "true") #t) ((string=? name "false") #f)
  (else (native-key-intern name)))))
(define native-opaque-structs (make-table test: eq? weak-keys: #t))
;; True once any non-vector value has been registered as an opaque struct.
;; Until then a struct-module query on a non-vector is exactly bl-nil without
;; a weak-table lookup (today only 7-slot reference vectors are registered).
(define native-opaque-nonvector-structs? #f)
(define (native-register-struct! value module fields-reader)
 (if (not (vector? value)) (set! native-opaque-nonvector-structs? #t))
 (table-set! native-opaque-structs value (cons module fields-reader)) value)
(define (native-opaque-struct? value) (if (table-ref native-opaque-structs value #f) #t #f))
(define native-host-callables (make-table test: eq? weak-keys: #t))
(define (native-mark-host-callable! value)
 (if (procedure? value) (table-set! native-host-callables value #t)) value)
(define native-missing (list 'native-missing))
(define native-opaque-counter 0)
(define native-opaque-ids (make-table test: eq? weak-keys: #t))
(define (native-opaque-id x)
 (let ((hit (table-ref native-opaque-ids x #f)))
  (if hit hit
   (begin (set! native-opaque-counter (+ native-opaque-counter 1))
    (table-set! native-opaque-ids x native-opaque-counter)
    native-opaque-counter))))
(define (native-list? x)
 (let loop ((p x)) (cond ((null? p) #t) ((pair? p) (loop (cdr p))) (else #f))))
;; Gambit 4.9.5 symbol->string returns the symbol's own interned name string
;; without copying ((eq? (symbol->string s) (symbol->string s)) => #t). Host
;; code only READS that string; it is never mutated or published by itself.
(define (native-colon-symbol? x)
 (let ((s (symbol->string x))) (and (fx> (string-length s) 0) (char=? (string-ref s 0) #\:))))
;; Keywords are colon symbols, or interned UTF16-fragment keyword wrappers.
(define (native-keyword? x)
 (if (symbol? x) (native-colon-symbol? x) (bl-tag? x 'utf16-keyword)))
(define (native-compare-number a b) (cond ((< a b) -1) ((> a b) 1) (else 0)))
;; Normal Scheme strings contain Unicode scalars, so scalar indexing can
;; compare their UTF16 order without allocating code-unit lists. The start
;; offsets let keyword names be compared inside their symbol strings (after
;; the shared colon) without a substring. Surrogate fragment wrappers retain
;; the full unit-list path in native-compare-string.
(define (native-scalar-string-compare-from a a-start b b-start)
 (let ((a-size (string-length a)) (b-size (string-length b)))
  (let loop ((i a-start) (j b-start))
   (cond ((fx= i a-size) (if (fx= j b-size) 0 -1))
    ((fx= j b-size) 1)
    (else
     (let ((a-code (char->integer (string-ref a i)))
           (b-code (char->integer (string-ref b j))))
      (cond ((fx= a-code b-code) (loop (fx+ i 1) (fx+ j 1)))
       ;; Both supplementary scalars have the same ordering as their UTF16
       ;; surrogate pairs; two BMP scalars compare directly as well.
       ((or (and (fx< a-code 65536) (fx< b-code 65536))
            (and (fx>= a-code 65536) (fx>= b-code 65536)))
        (if (fx< a-code b-code) -1 1))
       (else
        (let ((a-unit (if (fx< a-code 65536) a-code (fx+ 55296 (fxquotient (fx- a-code 65536) 1024))))
              (b-unit (if (fx< b-code 65536) b-code (fx+ 55296 (fxquotient (fx- b-code 65536) 1024)))))
         ;; A normal BMP scalar cannot equal a high surrogate, so this
         ;; mixed-width comparison decides at the first UTF16 unit.
         (if (fx< a-unit b-unit) -1 1))))))))))
(define (native-compare-string a b)
 (cond ((eq? a b) 0)
  ((and (string? a) (string? b)) (native-scalar-string-compare-from a 0 b 0))
  (else (native-unit-compare (native-utf16-units a) (native-utf16-units b)))))
;; Erlang term-order class. One type dispatch instead of up to ten tag tests;
;; the classes and their numbering are exactly the previous cond's.
(define (native-key-rank x)
 (cond ((symbol? x) (if (native-colon-symbol? x) 2 10))
       ((vector? x)
        (cond ((eq? x bl-nil) 2)
         ((fx= (vector-length x) 2)
          (case (vector-ref x 0)
           ((float) 1) ((tuple) 3) ((map) 4) ((vec) 5) ((set) 6)
           ((utf16-keyword) 2) ((utf16-string) 9) (else 10)))
         (else 10)))
       ((pair? x) 8) ((null? x) 7) ((string? x) 9) ((boolean? x) 2)
       ((and (number? x) (exact? x) (integer? x)) 0)
       (else 10)))
;; Interned Scheme symbol names are immutable. Reuse their decoded BL atom
;; spelling without allocating a colon-stripping substring on every call.
;; Weak keys keep this host memo from retaining unused atoms.
(define native-symbol-atom-names (make-table test: eq? weak-keys: #t))
(define (native-atom-name x)
 (cond ((symbol? x)
        (let ((cached (table-ref native-symbol-atom-names x #f)))
         (or cached
          (let* ((s (symbol->string x)) (name (substring s 1 (string-length s))))
           (table-set! native-symbol-atom-names x name) name))))
       ((bl-tag? x 'utf16-keyword) (vector-ref x 1))
       ((bl-is-nil x) "nil") ((eq? x #t) "true") ((eq? x #f) "false")
       (else (substring (symbol->string x) 1 (string-length (symbol->string x))))))
;; Two term-order atoms (nil/true/false/keyword). Scalar spellings compare in
;; place: a symbol's name starts after its colon, booleans/nil use literals.
(define (native-scalar-atom-text x)
 (cond ((symbol? x) (symbol->string x)) ((eq? x #t) "true") ((eq? x #f) "false") (else "nil")))
(define (native-compare-atoms a b)
 (if (or (bl-tag? a 'utf16-keyword) (bl-tag? b 'utf16-keyword))
  (native-compare-string (native-atom-name a) (native-atom-name b))
  (native-scalar-string-compare-from (native-scalar-atom-text a) (if (symbol? a) 1 0)
                                     (native-scalar-atom-text b) (if (symbol? b) 1 0))))
(define (native-compare-lists a b)
 (cond ((null? a) (if (null? b) 0 -1)) ((null? b) 1)
       ((and (pair? a) (pair? b))
        (let ((n (bl-key-compare (car a) (car b))))
         (if (= n 0) (native-compare-lists (cdr a) (cdr b)) n)))
       (else (bl-key-compare a b))))
;; Raw tuple keys are fixed Scheme vectors. Compare their existing
;; lexicographic/prefix relation directly, without allocating vector->list.
(define (native-compare-tuples a b)
 (let* ((a-items (vector-ref a 1)) (b-items (vector-ref b 1))
        (a-size (vector-length a-items)) (b-size (vector-length b-items)))
  (let loop ((index 0))
   (cond ((= index a-size) (if (= index b-size) 0 -1))
    ((= index b-size) 1)
    (else (let ((order (bl-key-compare (vector-ref a-items index) (vector-ref b-items index))))
     (if (= order 0) (loop (+ index 1)) order)))))))
;; Same-kind cases first, in observed frequency order; each returns exactly
;; what the ranked comparison returns for that pair. Everything else ranks.
(define (bl-key-compare a b)
 (cond ((eq? a b) 0)
  ((symbol? a)
   ;; Two keywords: one name fetch and one first-character test per side, in
   ;; place (the same order as before: names compared after the shared colon).
   (if (symbol? b)
    (let ((sa (symbol->string a)) (sb (symbol->string b)))
     (if (and (fx> (string-length sa) 0) (char=? (string-ref sa 0) #\:)
              (fx> (string-length sb) 0) (char=? (string-ref sb 0) #\:))
      (native-scalar-string-compare-from sa 1 sb 1)
      (native-key-compare-ranked a b)))
    (native-key-compare-ranked a b)))
  ((string? a) (if (string? b) (native-scalar-string-compare-from a 0 b 0) (native-key-compare-ranked a b)))
  ((fixnum? a) (if (fixnum? b) (cond ((fx< a b) -1) ((fx< b a) 1) (else 0)) (native-key-compare-ranked a b)))
  ((pair? a) (cond ((pair? b) (native-compare-lists a b)) ((null? b) 1) (else (native-key-compare-ranked a b))))
  ((null? a) (if (pair? b) -1 (native-key-compare-ranked a b)))
  (else (native-key-compare-ranked a b))))
(define (native-key-compare-ranked a b)
 (let ((ra (native-key-rank a)) (rb (native-key-rank b)))
  (if (not (fx= ra rb)) (if (fx< ra rb) -1 1)
   (case ra
    ((0) (native-compare-number a b))
    ((1) (native-compare-number (vector-ref a 1) (vector-ref b 1)))
    ((2) (native-compare-atoms a b))
    ((3) (native-compare-tuples a b))
    ((5) (native-compare-lists (bl-items a) (bl-items b)))
    ((4) (native-compare-lists (native-map-pairs a) (native-map-pairs b)))
    ((6) (native-compare-lists (native-set-items a) (native-set-items b)))
    ((7) 0) ((8) (native-compare-lists a b))
    ((9) (native-compare-string a b))
    (else (native-compare-number (native-opaque-id a) (native-opaque-id b)))))))
(define (bl-key-equal? a b) (or (eq? a b) (eqv? (bl-key-compare a b) 0)))

;; Q3 value-equal keys (research/native-seed/speed/keys/DECISION.md). Every BL
;; map entry point replaces its key by the canonical representative of its `=`
;; class, the same one BEAM's rt.bl `hash-key` chooses: an integral number is
;; the exact integer (1.0 -> 1, -0.0 -> 0, 1.00M -> 1); a non-integral decimal
;; whose value a binary64 float holds exactly is that float (1.50M -> 1.5);
;; any other decimal drops trailing zeros (0.10M -> 0.1M); composites rebuild
;; only when an element changes. Storage then holds canonical keys only, so the
;; raw ordered comparison (bl-key-compare) needs no change and equal keys are
;; identical terms. Keywords, fixnums and strings return after one type test.
(define (native-key-canon k)
 (if (or (symbol? k) (fixnum? k) (string? k)) k
  (if (native-key-dirty? k) (native-key-rebuild k) k)))
(define (native-integral-float? f)
 (and (integer? f) (< (abs f) +inf.0)))
;; The decimal's canonical value, or the decimal itself when it already is.
(define (native-decimal-canon d)
 (let ((u (bl-get d (bl-key "unscaled"))) (s (bl-get d (bl-key "scale"))))
  (cond ((<= s 0) (* u (expt 10 (- s))))
        ((= u 0) 0)
        (else
         (let loop ((u2 u) (s2 s))
          (cond ((= s2 0) u2)
                ((= 0 (remainder u2 10)) (loop (quotient u2 10) (- s2 1)))
                (else
                 (let* ((r (/ u2 (expt 10 s2))) (f (exact->inexact r)))
                  (cond ((and (< (abs f) +inf.0) (= (inexact->exact f) r)) (vector 'float f))
                        ((= s2 s) d)
                        (else (bl-decimal u2 s2)))))))))))
(define (native-key-dirty? k)
 (cond ((or (symbol? k) (fixnum? k) (string? k) (null? k)) #f)
       ((pair? k) (or (native-key-dirty? (car k)) (native-key-dirty? (cdr k))))
       ((not (vector? k)) #f)
       ((eq? k bl-nil) #f)
       ((bl-tag? k 'float) (native-integral-float? (vector-ref k 1)))
       ((bl-tag? k 'vec) (native-vector-any? native-key-dirty? k))
       ((bl-tag? k 'tuple)
        (let ((items (vector-ref k 1)))
         (let loop ((i 0))
          (and (fx< i (vector-length items)) (or (native-key-dirty? (vector-ref items i)) (loop (fx+ i 1)))))))
       ((bl-tag? k 'map)
        (if (native-decimal? k) (not (eq? (native-decimal-canon k) k))
         (not (native-map-every? (lambda (key value) (not (or (native-key-dirty? key) (native-key-dirty? value)))) k))))
       ((bl-tag? k 'set)
        (not (native-map-every? (lambda (key value) (not (native-key-dirty? key))) (vector-ref k 1))))
       (else #f)))
;; (pred item) over a vector's items without building the item list: a key
;; lookup with a clean vector key allocates nothing.
(define (native-vector-any? pred v)
 (let ((s (vector-ref v 1)))
  (if (native-vector-storage? s)
   (let ((n (vector-ref s 1)))
    (let walk ((node (vector-ref s 3)) (cap (vector-ref s 2)) (start 0))
     (cond ((fx>= start n) #f)
           ((fx= cap 1) (pred node))
           (else (let ((half (fxquotient cap 2)))
                  (or (walk (vector-ref node 0) half start)
                      (walk (vector-ref node 1) half (fx+ start half))))))))
   (let loop ((i 0)) (and (fx< i (vector-length s)) (or (pred (vector-ref s i)) (loop (fx+ i 1))))))))
(define (native-key-rebuild k)
 (cond ((pair? k) (cons (native-key-canon (car k)) (native-key-canon (cdr k))))
       ((bl-tag? k 'float) (let ((f (vector-ref k 1))) (if (native-integral-float? f) (inexact->exact f) k)))
       ((bl-tag? k 'vec) (bl-vec (map native-key-canon (bl-items k))))
       ((bl-tag? k 'tuple) (vector 'tuple (list->vector (map native-key-canon (vector->list (vector-ref k 1))))))
       ((bl-tag? k 'map)
        (if (native-decimal? k) (native-decimal-canon k)
         (let loop ((ps (native-map-pairs k)) (out (bl-empty-map)))
          (if (null? ps) out
           (let ((items (vector-ref (car ps) 1)))
            (loop (cdr ps) (bl-assoc out (vector-ref items 0) (native-key-canon (vector-ref items 1)))))))))
       ((bl-tag? k 'set) (native-set-from-list (native-set-items k)))
       (else k)))
(set! bl-key-value native-key-canon)

;; Immutable small maps use sorted flat entries through16 keys; larger maps
;; use the existing persistent AVL nodes. Old alist and pmap-v1 inputs remain
;; accepted. Neither flat storage nor tree nodes escape through public leaves.
(define native-small-map-limit 16)
(define (native-map-tree? x)
 (and (vector? x) (= (vector-length x) 3) (eq? (vector-ref x 0) 'pmap-v1)))
(define (native-map-small? x)
 (and (vector? x) (= (vector-length x) 3) (eq? (vector-ref x 0) 'pmap-small-v1)))
;; These are field layouts, independent of the value in :op. A node remains a
;; BL map across assoc, iteration, matching, serialization and use as a key.
;; One shared descriptor replaces the repeated field keys on every instance.
(define native-lit-fields '#(|:ann| |:op| |:val|))
(define native-var-fields '#(|:ann| |:name| |:op|))
(define native-if-fields '#(|:ann| |:else| |:op| |:test| |:then|))
(define native-remote-fields '#(|:ann| |:args| |:fun| |:mod| |:op|))
(define (native-field-storage? s)
 (and (vector? s) (fx> (vector-length s) 0) (vector? (vector-ref s 0))))
(define (native-field-slot storage key)
 (let ((f (vector-ref storage 0)))
  (case key
   ((|:ann|) 1)
   ((|:op|) (cond ((eq? f native-lit-fields) 2) ((eq? f native-remote-fields) 5) (else 3)))
   ((|:val|) (and (eq? f native-lit-fields) 3))
   ((|:name|) (and (eq? f native-var-fields) 2))
   ((|:else|) (and (eq? f native-if-fields) 2))
   ((|:test|) (and (eq? f native-if-fields) 4))
   ((|:then|) (and (eq? f native-if-fields) 5))
   ((|:args|) (and (eq? f native-remote-fields) 2))
   ((|:fun|) (and (eq? f native-remote-fields) 3))
   ((|:mod|) (and (eq? f native-remote-fields) 4))
   (else (and (or (bl-tag? key 'utf16-keyword) (uninterned-symbol? key))
              (let exact ((j 0))
               (cond ((fx= j (vector-length f)) #f)
                     ((zero? (bl-key-compare key (vector-ref f j))) (fx+ j 1))
                     (else (exact (fx+ j 1))))))))))
(define (native-field-map pairs count)
 ;; Match the complete key sequence. Duplicates, reordered literals and all
 ;; user extensions continue through the ordinary raw map constructor.
 (and (or (fx= count 3) (fx= count 5)) (eq? (car pairs) '|:op|)
  (let ((tail (cddr pairs)))
   (if (fx= count 3)
    (let ((fields (case (car tail) ((|:val|) native-lit-fields)
                                   ((|:name|) native-var-fields) (else #f))))
     (and fields (eq? (caddr tail) '|:ann|)
          (vector 'map (if (eq? fields native-lit-fields)
                        (vector fields (cadddr tail) (cadr pairs) (cadr tail))
                        (vector fields (cadddr tail) (cadr tail) (cadr pairs))))))
    (let* ((more (cddr tail)) (last (cddr more))
           (fields (cond ((and (eq? (car tail) '|:test|) (eq? (car more) '|:then|)
                               (eq? (car last) '|:else|)) native-if-fields)
                         ((and (eq? (car tail) '|:mod|) (eq? (car more) '|:fun|)
                               (eq? (car last) '|:args|)) native-remote-fields)
                         (else #f))))
     (and fields (eq? (caddr last) '|:ann|)
          (vector 'map (if (eq? fields native-if-fields)
                        (vector fields (cadddr last) (cadr last) (cadr pairs) (cadr tail) (cadr more))
                        (vector fields (cadddr last) (cadr last) (cadr more) (cadr tail) (cadr pairs))))))))))
(define (native-field-materialize storage)
 (let* ((fields (vector-ref storage 0)) (n (vector-length fields)) (entries (make-vector (fx* 2 n))))
  (let loop ((i 0))
   (if (fx= i n) (vector 'map (vector 'pmap-small-v1 entries n))
    (begin (vector-set! entries (fx* 2 i) (vector-ref fields i))
           (vector-set! entries (fx+ (fx* 2 i) 1) (vector-ref storage (fx+ i 1)))
           (loop (fx+ i 1)))))))
(define (native-map-root m)
 (let ((s (vector-ref m 1)))
  (cond ((native-map-tree? s) (vector-ref s 1))
   ((native-map-small? s) (native-small-map-root s))
   ((native-field-storage? s) (native-small-map-root (vector-ref (native-field-materialize s) 1)))
   (else (let loop ((xs s) (root #f))
    (if (null? xs) root (loop (cdr xs) (native-tree-put root (caar xs) (cdar xs)))))))))
(define (native-height n) (if n (vector-ref n 4) 0))
(define (native-node k v l r) (vector k v l r (+ 1 (max (native-height l) (native-height r)))))
(define (native-left n) (vector-ref n 2))
(define (native-right n) (vector-ref n 3))
(define (native-rotate-right n)
 (let* ((l (native-left n)) (mid (native-right l)))
  (native-node (vector-ref l 0) (vector-ref l 1) (native-left l)
   (native-node (vector-ref n 0) (vector-ref n 1) mid (native-right n)))))
(define (native-rotate-left n)
 (let* ((r (native-right n)) (mid (native-left r)))
  (native-node (vector-ref r 0) (vector-ref r 1)
   (native-node (vector-ref n 0) (vector-ref n 1) (native-left n) mid) (native-right r))))
(define (native-balance n)
 (let ((d (- (native-height (native-left n)) (native-height (native-right n)))))
  (cond ((> d 1)
   (let ((l (native-left n)))
    (native-rotate-right
     (if (< (native-height (native-left l)) (native-height (native-right l)))
      (native-node (vector-ref n 0) (vector-ref n 1) (native-rotate-left l) (native-right n)) n))))
   ((< d -1)
    (let ((r (native-right n)))
     (native-rotate-left
      (if (> (native-height (native-left r)) (native-height (native-right r)))
       (native-node (vector-ref n 0) (vector-ref n 1) (native-left n) (native-rotate-right r)) n))))
   (else n))))
(define (native-tree-find n k)
 (if (not n) #f
  (let ((c (bl-key-compare k (vector-ref n 0))))
   (cond ((= c 0) n) ((< c 0) (native-tree-find (native-left n) k))
         (else (native-tree-find (native-right n) k))))))
(define (native-tree-ref n k)
 (let ((node (native-tree-find n k)))
  (if node (cons (vector-ref node 0) (vector-ref node 1)) native-missing)))
(define (native-tree-put n k v #!optional (on-insert #f))
 (if (not n)
  (begin (if on-insert (on-insert)) (native-node k v #f #f))
  (let ((c (bl-key-compare k (vector-ref n 0))))
   (native-balance
    (cond ((= c 0) (native-node (vector-ref n 0) v (native-left n) (native-right n)))
          ((< c 0) (native-node (vector-ref n 0) (vector-ref n 1)
                    (native-tree-put (native-left n) k v on-insert) (native-right n)))
          (else (native-node (vector-ref n 0) (vector-ref n 1)
                 (native-left n) (native-tree-put (native-right n) k v on-insert))))))))
(define (native-tree-min n) (if (native-left n) (native-tree-min (native-left n)) n))
(define (native-tree-remove n k)
 (if (not n) #f
  (let ((c (bl-key-compare k (vector-ref n 0))))
   (cond
    ((< c 0)
     (let* ((left (native-left n)) (remaining (native-tree-remove left k)))
      (if (eq? left remaining) n
       (native-balance (native-node (vector-ref n 0) (vector-ref n 1) remaining (native-right n))))))
    ((> c 0)
     (let* ((right (native-right n)) (remaining (native-tree-remove right k)))
      (if (eq? right remaining) n
       (native-balance (native-node (vector-ref n 0) (vector-ref n 1) (native-left n) remaining)))))
    ((not (native-left n)) (native-right n))
    ((not (native-right n)) (native-left n))
    (else (let ((r (native-tree-min (native-right n))))
     (native-balance (native-node (vector-ref r 0) (vector-ref r 1) (native-left n)
      (native-tree-remove (native-right n) (vector-ref r 0))))))))))
(define (native-tree-pairs n tail)
 (if n (native-tree-pairs (native-left n)
   (cons (vector 'tuple (vector (vector-ref n 0) (vector-ref n 1))) (native-tree-pairs (native-right n) tail))) tail))
;; A nonnegative search result is the existing row. A negative result
;; encodes insertion position as -(position+1), without allocating a result pair.
;; Identity hits avoid all semantic comparisons; misses use the SAME exact key
;; comparator as AVL storage. Entries stay strictly sorted by that total order.
;; A scalar key (integer, float, atom, (), text) compares against any entry
;; without side effects, so bisection finds exactly the row a left-to-right
;; scan finds. Composite/opaque keys keep the scan: comparing them may assign
;; lazy opaque ids, whose order must stay that of the former comparison
;; sequence. Enumeration needs no sort.
(define (native-scalar-key? key)
 (let ((rank (native-key-rank key))) (or (fx<= rank 2) (fx= rank 7) (fx= rank 9))))
(define (native-small-map-search storage key)
 (let* ((entries (vector-ref storage 1)) (count (vector-ref storage 2))
        (hit (if (string? key) -1
              (let identity ((index 0))
               (cond ((fx= index count) -1)
                ((eq? key (vector-ref entries (fx* 2 index))) index)
                (else (identity (fx+ index 1))))))))
  (cond ((fx>= hit 0) hit)
   ((native-scalar-key? key)
    (let ordered ((low 0) (high count))
     (if (fx= low high) (fx- -1 low)
      (let* ((middle (fxquotient (fx+ low high) 2))
             (order (bl-key-compare key (vector-ref entries (fx* 2 middle)))))
       (cond ((eqv? order 0) middle) ((< order 0) (ordered low middle))
             (else (ordered (fx+ middle 1) high)))))))
   (else
    (let ordered ((index 0))
     (if (fx= index count) (fx- -1 index)
      (let ((order (bl-key-compare key (vector-ref entries (fx* 2 index)))))
       (cond ((eqv? order 0) index) ((< order 0) (fx- -1 index))
             (else (ordered (fx+ index 1)))))))))))
(define (native-small-map-root storage)
 (let ((entries (vector-ref storage 1)))
  (let build ((start 0) (end (vector-ref storage 2)))
   (if (= start end) #f
    (let ((middle (quotient (+ start end) 2)))
