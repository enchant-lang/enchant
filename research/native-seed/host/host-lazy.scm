;; Lazy memo host state machine; producer/reducer algorithms stay compiled BL.
;; A resource is #(state owner-frame edges owner-pid); aliases share it.
(define native-live-memos (make-table test: eq? weak-keys: #t))
(define (native-new-memo state)
 (let ((resource (vector state #f '() bl-nil))) (table-set! native-live-memos resource #t) resource))
(define (native-lazy? x) (eq? (native-struct-module x) (bl-key "Elixir.BeamLisp.LazySeq")))
(define (native-lazy-resource x) (bl-get x (bl-key "resource")))
(define (native-lazy-state x) (vector-ref (native-lazy-resource x) 0))
(define (native-lazy-state! x state)
 (let ((resource (native-lazy-resource x)))
  (vector-set! resource 0 state)
  (if (not (eq? (car state) 'running))
   (begin (vector-set! resource 1 #f) (vector-set! resource 3 bl-nil)))))
(define (native-lazy-new thunk . recipe)
 (if (not (h-is-fn thunk)) (native-badarg "lazy thunk is not callable"))
 (if (and (pair? recipe) (not (h-is-fn (car recipe)))) (native-badarg "lazy recipe is not callable"))
 (bl-map (bl-key "__struct__") (bl-key "Elixir.BeamLisp.LazySeq")
  (bl-key "metadata") bl-nil (bl-key "resource")
  (native-new-memo (if (null? recipe) (list 'pending thunk) (list 'pending thunk (car recipe))))))
(define (native-lazy-failure reason)
 (native-raise (bl-key "error")
  (bl-map (bl-key "__struct__") (bl-key "Elixir.BeamLisp.LazySeq.ForceError")
   (bl-key "reason") reason (bl-key "message") (string-append "LazySeq force failed: " (bl-show reason))) (native-capture-stack)))
(define (native-lazy-edges value)
 (let loop ((todo (list value)) (seen '()) (edges '()))
  (if (null? todo) edges
   (let ((x (car todo)))
    (cond ((or (memq x seen) (not (or (pair? x) (vector? x)))) (loop (cdr todo) seen edges))
     ((native-lazy? x) (loop (cdr todo) (cons x seen) (cons (native-lazy-resource x) edges)))
     ((pair? x) (loop (cons (car x) (cons (cdr x) (cdr todo))) (cons x seen) edges))
     ((or (bl-tag? x 'vec) (bl-tag? x 'tuple)) (loop (append (bl-items x) (cdr todo)) (cons x seen) edges))
     ((bl-tag? x 'set) (loop (append (native-set-items x) (cdr todo)) (cons x seen) edges))
     ((bl-tag? x 'map) (loop (append (native-map-pairs x) (cdr todo)) (cons x seen) edges))
     (else (loop (cdr todo) (cons x seen) edges)))))))
(define (native-lazy-publish x value)
 (let* ((resource (native-lazy-resource x)) (edges (native-lazy-edges value)))
  (let walk ((todo edges) (seen '()))
   (cond ((null? todo) (vector-set! resource 2 edges) (native-lazy-state! x (list 'completed value)) (bl-key "ok"))
    ((eq? (car todo) resource) (native-lazy-state! x (list 'terminal (bl-key "cyclic_memo"))) (native-lazy-failure (bl-key "cyclic_memo")))
    ((memq (car todo) seen) (walk (cdr todo) seen))
    (else (walk (append (vector-ref (car todo) 2) (cdr todo)) (cons (car todo) seen)))))))
(define (native-lazy-force x)
 (let again ()
  (let ((state (native-lazy-state x)) (resource (native-lazy-resource x)))
   (case (car state)
    ((completed) (cadr state)) ((terminal) (native-lazy-failure (cadr state)))
    ((running)
     (if (and seed-frame (not (eq? seed-frame (vector-ref resource 1))))
      (begin (h-park "yield") (again))
      (begin (native-lazy-state! x (list 'terminal (bl-key "recursive_force"))) (native-lazy-failure (bl-key "recursive_force")))))
    (else
     (let ((thunk (cadr state)))
      (vector-set! resource 1 seed-frame) (vector-set! resource 3 seed-self)
      (native-lazy-state! x (list 'running (native-make-reference)))
      (let ((value (with-exception-catcher
       (lambda (e)
        (if (not (eq? (car (native-lazy-state x)) 'terminal))
         (native-lazy-state! x (list 'failed thunk (native-exception-kind e) (native-exception-reason e) (native-exception-trace e))))
        (raise e))
       (lambda () (bl-invoke thunk '())))))
       (if (eq? (car (native-lazy-state x)) 'terminal) (native-lazy-failure (cadr (native-lazy-state x))))
       (native-lazy-publish x value) value)))))))
(define (native-cursor-new xs)
 (bl-map (bl-key "__struct__") (bl-key "Elixir.BeamLisp.SeqCursor") (bl-key "list") xs))
(define (native-cursor? x) (eq? (native-struct-module x) (bl-key "Elixir.BeamLisp.SeqCursor")))
(define (native-cursor-cell x)
 (let ((xs (bl-get x (bl-key "list")))) (if (pair? xs) (cons (car xs) (native-cursor-new (cdr xs))) bl-nil)))
(define (native-lazy-head value)
 (cond ((or (null? value) (bl-is-nil value)) bl-nil)
  ((pair? value) value) ((bl-tag? value 'vec) (let ((xs (bl-items value))) (if (null? xs) bl-nil xs)))
  ((bl-tag? value 'set) (let ((xs (native-set-items value))) (if (null? xs) bl-nil xs)))
  ((native-cursor? value) (native-cursor-cell value)) (else value)))
(define (native-lazy-realize x)
 (let loop ((x x) (depth 0))
  (if (> depth 100000) (h-raise "LazySeq.realize: thunk chain exceeds 100000 without a head"))
  (let ((v (native-lazy-force x))) (if (native-lazy? v) (loop v (+ depth 1)) (native-lazy-head v)))))
(define (native-lazy-cell x)
 (cond ((native-lazy? x) (native-lazy-realize x)) ((native-cursor? x) (native-cursor-cell x))
  ((bl-tag? x 'map) (native-lazy-head (native-map-pairs x)))
  (else (native-lazy-head x))))
(define (native-lazy-input x)
 (let ((xs (if (bl-tag? x 'vec) (bl-items x) x)))
  (if (and (native-list? xs) (> (length xs) 32)) (native-cursor-new xs) xs)))
(define (native-lazy-chain elems tail)
 (if (null? elems) bl-nil (append (native-assert-list elems) (native-lazy-new tail))))
(define (native-lazy-memo-state x)
 (let ((s (native-lazy-state x)))
  (bl-tuple (if (eq? (car s) 'running)
   (list (bl-key "running") bl-nil (vector-ref (native-lazy-resource x) 3) (cadr s) '())
   (cons (bl-key (symbol->string (car s))) (cdr s))))))
(define (native-lazy-claim x)
 (if (not (native-lazy? x)) bl-nil
  (let ((s (native-lazy-state x)))
   (if (not (and (eq? (car s) 'pending) (= (length s) 3))) bl-nil
    (let ((attempt (native-make-reference)) (pending (native-lazy-memo-state x)))
     (vector-set! (native-lazy-resource x) 1 seed-frame)
     (vector-set! (native-lazy-resource x) 3 seed-self)
     (native-lazy-state! x (list 'running attempt)) (bl-tuple (list (bl-key "claimed") attempt pending)))))))
(define (native-lazy-owned? x attempt)
 (let ((s (native-lazy-state x))) (and (eq? (car s) 'running) (eq? (cadr s) attempt))))
(define (native-lazy-capture thunk)
 (with-exception-catcher
  (lambda (e) (bl-tuple (list (bl-key "failed") (native-exception-kind e) (native-exception-reason e) (native-exception-trace e))))
  (lambda () (bl-tuple (list (bl-key "ok") (bl-invoke thunk '()))))))
(define (native-lazy-complete x attempt value)
 (cond ((native-lazy-owned? x attempt) (native-lazy-publish x (if (null? value) bl-nil value)))
  ((eq? (car (native-lazy-state x)) 'terminal) (native-lazy-failure (cadr (native-lazy-state x))))
  (else (native-lazy-failure (bl-tuple (list (bl-key "stale_force_owner") attempt))))))
(define (native-lazy-fail x attempt thunk kind reason stack)
 (if (native-lazy-owned? x attempt) (native-lazy-state! x (list 'failed thunk kind reason stack)))
 (bl-reraise kind reason stack))
(define (native-lazy-release x attempt pending)
 (cond ((native-lazy-owned? x attempt) (native-lazy-state! x (cons 'pending (cdr (bl-items pending)))) (bl-key "ok"))
  ((eq? (car (native-lazy-state x)) 'terminal) (bl-tuple (list (bl-key "terminal") (cadr (native-lazy-state x)))))
  (else (native-lazy-failure (bl-tuple (list (bl-key "stale_force_owner") attempt))))))
(define (native-lazy-list x)
 (let loop ((cell (native-lazy-cell x)) (out '()))
  (if (bl-is-nil cell) (reverse out)
   (if (not (pair? cell)) (native-badarg "not a list cell") (loop (native-lazy-cell (cdr cell)) (cons (car cell) out))))))
(define (native-lazy-prefix x n)
 (let loop ((x x) (n n) (out '()))
  (if (<= n 0) (reverse out) (let ((cell (native-lazy-cell x)))
   (if (bl-is-nil cell) (reverse out) (loop (cdr cell) (- n 1) (cons (car cell) out)))))))
(define (native-delay? x) (eq? (native-struct-module x) (bl-key "Elixir.BeamLisp.Delay")))
(define (native-delay thunk) (bl-map (bl-key "__struct__") (bl-key "Elixir.BeamLisp.Delay") (bl-key "seq") (native-lazy-new thunk)))
(define (native-delay-force x) (if (native-delay? x) (native-lazy-force (bl-get x (bl-key "seq"))) x))
(define (native-delay-realized? x)
 (or (not (native-delay? x)) (eq? (car (native-lazy-state (bl-get x (bl-key "seq")))) 'completed)))
(define (native-seen-admit seen keys)
 (map (lambda (key) (let ((old (native-map-has? (vector-ref seen 1) key)))
  (if (not old) (vector-set! seen 1 (bl-assoc (vector-ref seen 1) key #t))) (not old))) keys))
(native-add-leaf! "Elixir.BeamLisp.LazySeq/lazy?/1" native-lazy?)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/chunk_size/0" (lambda () 32))
(native-add-leaf! "Elixir.BeamLisp.LazySeq/new/1" native-lazy-new)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/new/2" native-lazy-new)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/from_fun/1" native-lazy-new)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/input/1" native-lazy-input)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/chain/2" native-lazy-chain)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/cell/1" native-lazy-cell)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/force/1" native-lazy-force)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/realize/1" native-lazy-realize)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/memo_state/1" native-lazy-memo-state)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/pending?/1" (lambda (x) (eq? (car (native-lazy-state x)) 'pending)))
(native-add-leaf! "Elixir.BeamLisp.LazySeq/claim_recipe/1" native-lazy-claim)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/capture_attempt/1" native-lazy-capture)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/complete_attempt/3" native-lazy-complete)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/fail_attempt/6" native-lazy-fail)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/release_recipe/3" native-lazy-release)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/to_list/1" native-lazy-list)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/count/1" (lambda (x) (length (native-lazy-list x))))
(native-add-leaf! "Elixir.BeamLisp.LazySeq/run/1" (lambda (x) (native-lazy-list x) (bl-key "ok")))
(native-add-leaf! "Elixir.BeamLisp.LazySeq/prefix/2" native-lazy-prefix)
(native-add-leaf! "Elixir.BeamLisp.LazySeq/sample/2" (lambda (x n) (let ((xs (native-lazy-prefix x (+ n 1)))) (bl-tuple (list (native-take xs (min n (length xs))) (> (length xs) n))))))
(native-add-leaf! "Elixir.BeamLisp.LazySeq/nth/2" (lambda (x n) (let ((xs (native-lazy-prefix x (+ n 1)))) (if (and (>= n 0) (> (length xs) n)) (list-ref xs n) bl-nil))))
(native-add-leaf! "Elixir.BeamLisp.SeqCursor/new/1" native-cursor-new)
(native-add-leaf! "Elixir.BeamLisp.SeqCursor/cell/1" native-cursor-cell)
(native-add-leaf! "Elixir.BeamLisp.LazyMemo/seen/0" (lambda () (vector 'seen (bl-empty-map))))
(native-add-leaf! "Elixir.BeamLisp.LazyMemo/seen_admit/2" native-seen-admit)
(native-add-leaf! "Elixir.BeamLisp.Deferred/delay/1" native-delay)
(native-add-leaf! "Elixir.BeamLisp.Deferred/force/1" native-delay-force)
(native-add-leaf! "Elixir.BeamLisp.Deferred/realized?/1" native-delay-realized?)
(native-add-leaf! "Elixir.BeamLisp.Deferred/delay?/1" native-delay?)

;; Observe committed storage removal, after BL's canonical atomic death policy.
;; Source owner_lost publishes this exact terminal reason; no thunk is retried.
(define (native-storage-owner-dead! frame owner)
 (table-for-each
  (lambda (resource ignored)
   (let ((state (vector-ref resource 0)))
    (if (and (eq? (car state) 'running) (eq? frame (vector-ref resource 1)))
     (begin
      (vector-set! resource 0 (list 'terminal (bl-tuple (list (bl-key "force_owner_lost") owner (cadr state)))))
      (vector-set! resource 1 #f) (vector-set! resource 3 bl-nil))))) native-live-memos)
 bl-nil)
(define native-set-state-without-memo-observer h-set-state)
(set! h-set-state (lambda (state)
 (let* ((before (bl-get seed-state (bl-key "procs"))) (after (bl-get state (bl-key "procs"))))
  (native-set-state-without-memo-observer state)
  ;; Canonical rt-forget! is the only process removal; other edits preserve or
  ;; grow count, so ordinary mailbox/scheduler updates never scan live processes.
  (if (and (bl-tag? before 'map) (bl-tag? after 'map) (< (native-map-count after) (native-map-count before)))
   (for-each (lambda (pair)
    (let ((pid (bl-nth pair 0))) (if (not (native-map-has? after pid))
     (native-storage-owner-dead! (bl-get (bl-nth pair 1) (bl-key "frames")) pid)))) (native-map-pairs before)))
  bl-nil)))
