;; OTP gb_trees for the native host (category b: Erlang/OTP stdlib).
;; host/sorted.bl reaches it through (erlang/apply :gb_trees F ARGS), so every
;; function below is registered under its exact "gb_trees/F/A" key. This is a
;; port of stdlib's gb_trees.erl (OTP 29): the same node shapes
;; {Size, Tree} and {Key, Value, Smaller, Bigger} with nil leaves, the same
;; size-based balancing (p = 2) and the same iterator {ordered, Nodes}, so a
;; tree built natively is the term BEAM builds for the same operations.
;; Keys compare in Erlang term order (erlang:</2 and >/2), where an integer
;; and a float of equal value are EQUAL (1 == 1.0) inside tuples and lists too.
(define native-gbt-none (bl-key "none"))
(define native-gbt-ordered (bl-key "ordered"))
(define (native-gbt-clause!)
 (native-raise (bl-key "error") (bl-key "function_clause") (native-capture-stack)))
(define (native-gbt-node? t)
 (and (bl-tag? t 'tuple) (fx= 4 (vector-length (vector-ref t 1)))))
(define (native-gbt-k t) (vector-ref (vector-ref t 1) 0))
(define (native-gbt-v t) (vector-ref (vector-ref t 1) 1))
(define (native-gbt-s t) (vector-ref (vector-ref t 1) 2))
(define (native-gbt-b t) (vector-ref (vector-ref t 1) 3))
(define (native-gbt-mk k v s b) (bl-make-tuple k v s b))
;; Erlang orders tuples by size, then element-wise; lists element-wise with
;; the shorter prefix first; numbers arithmetically. Other terms keep the
;; host's term order (native-term-compare).
(define (native-gbt-compare a b)
 (cond ((and (native-gbt-tuple? a) (native-gbt-tuple? b))
        (let* ((x (vector-ref a 1)) (y (vector-ref b 1)) (n (vector-length x)) (m (vector-length y)))
         (if (not (= n m)) (if (< n m) -1 1)
          (let loop ((i 0))
           (if (= i n) 0
            (let ((c (native-gbt-compare (vector-ref x i) (vector-ref y i))))
             (if (= c 0) (loop (+ i 1)) c)))))))
       ((and (pair? a) (pair? b))
        (let ((c (native-gbt-compare (car a) (car b)))) (if (= c 0) (native-gbt-compare (cdr a) (cdr b)) c)))
       (else (native-term-compare a b))))
(define (native-gbt-tuple? x) (and (vector? x) (fx= 2 (vector-length x)) (eq? (vector-ref x 0) 'tuple)))
(define (native-gbt-lt a b) (< (native-gbt-compare a b) 0))
(define (native-gbt-gt a b) (> (native-gbt-compare a b) 0))
;; The {Size, Tree} wrapper. Every public entry checks it as the OTP clause
;; heads do (size/delete/insert guard is_integer(Size)).
(define (native-gbt-wrapper? t)
 (and (bl-tag? t 'tuple) (fx= 2 (vector-length (vector-ref t 1)))))
(define (native-gbt-size-of t) (vector-ref (vector-ref t 1) 0))
(define (native-gbt-root t) (vector-ref (vector-ref t 1) 1))
(define (native-gbt-checked t)
 (if (native-gbt-wrapper? t) (native-gbt-root t) (native-gbt-clause!)))
(define (native-gbt-sized t)
 (if (and (native-gbt-wrapper? t) (exact-integer? (native-gbt-size-of t)) (>= (native-gbt-size-of t) 0))
  (native-gbt-size-of t) (native-gbt-clause!)))

(define (native-gbt-empty) (bl-make-tuple 0 bl-nil))
(define (native-gbt-size t) (native-gbt-sized t))
(define (native-gbt-find key t)
 (let loop ((t t))
  (cond ((native-gbt-node? t)
         (cond ((native-gbt-lt key (native-gbt-k t)) (loop (native-gbt-s t)))
               ((native-gbt-gt key (native-gbt-k t)) (loop (native-gbt-b t)))
               (else t)))
        ((bl-is-nil t) #f)
        (else (native-gbt-clause!)))))
(define (native-gbt-lookup key tree)
 (let ((n (native-gbt-find key (native-gbt-checked tree))))
  (if n (bl-make-tuple (bl-key "value") (native-gbt-v n)) native-gbt-none)))
(define (native-gbt-is-defined key tree)
 (if (native-gbt-find key (native-gbt-checked tree)) #t #f))
(define (native-gbt-update-1 key value t)
 (cond ((native-gbt-lt key (native-gbt-k t))
        (native-gbt-mk (native-gbt-k t) (native-gbt-v t) (native-gbt-update-1 key value (native-gbt-s t)) (native-gbt-b t)))
       ((native-gbt-gt key (native-gbt-k t))
        (native-gbt-mk (native-gbt-k t) (native-gbt-v t) (native-gbt-s t) (native-gbt-update-1 key value (native-gbt-b t))))
       (else (native-gbt-mk key value (native-gbt-s t) (native-gbt-b t)))))
;; count/1: {Height, Size}, returned as a pair.
(define (native-gbt-count t)
 (cond ((bl-is-nil t) (cons 1 0))
       ((and (bl-is-nil (native-gbt-s t)) (bl-is-nil (native-gbt-b t))) (cons 1 1))
       (else (let ((a (native-gbt-count (native-gbt-s t))) (b (native-gbt-count (native-gbt-b t))))
              (cons (* 2 (max (car a) (car b))) (+ (cdr a) (cdr b) 1))))))
(define (native-gbt-to-list-1 t acc)
 (if (bl-is-nil t) acc
  (native-gbt-to-list-1 (native-gbt-s t)
   (cons (cons (native-gbt-k t) (native-gbt-v t)) (native-gbt-to-list-1 (native-gbt-b t) acc)))))
;; balance_list_unchecked_1: returns (tree . rest).
(define (native-gbt-balance-list l s)
 (cond ((> s 1)
        (let* ((s2 (quotient (- s 1) 2)) (s1 (- s 1 s2))
               (left (native-gbt-balance-list l s1)) (kv (car (cdr left)))
               (right (native-gbt-balance-list (cdr (cdr left)) s2)))
         (cons (native-gbt-mk (car kv) (cdr kv) (car left) (car right)) (cdr right))))
       ((= s 1) (cons (native-gbt-mk (car (car l)) (cdr (car l)) bl-nil bl-nil) (cdr l)))
       (else (cons bl-nil l))))
(define (native-gbt-balance t s) (car (native-gbt-balance-list (native-gbt-to-list-1 t '()) s)))
;; insert_1: a pair (tree height . size) when the subtree size is tracked,
;; else the bare tree, exactly as the OTP clause results (a tree is never a
;; Scheme pair: nodes are tuples and the empty tree is nil).
(define (native-gbt-insert-1 key value t s)
 (cond
  ((native-gbt-node? t)
   (let ((k1 (native-gbt-k t)) (v (native-gbt-v t)) (sm (native-gbt-s t)) (bi (native-gbt-b t)))
    (cond
     ((native-gbt-lt key k1)
      (let ((r (native-gbt-insert-1 key value sm (quotient s 2))))
       (if (pair? r)
        (let* ((tt (native-gbt-mk k1 v (car r) bi)) (c (native-gbt-count bi))
               (h (* 2 (max (cadr r) (car c)))) (ss (+ (cddr r) (cdr c) 1)))
         (if (> h (* ss ss)) (native-gbt-balance tt ss) (cons tt (cons h ss))))
        (native-gbt-mk k1 v r bi))))
     ((native-gbt-gt key k1)
      (let ((r (native-gbt-insert-1 key value bi (quotient s 2))))
       (if (pair? r)
        (let* ((tt (native-gbt-mk k1 v sm (car r))) (c (native-gbt-count sm))
               (h (* 2 (max (cadr r) (car c)))) (ss (+ (cddr r) (cdr c) 1)))
         (if (> h (* ss ss)) (native-gbt-balance tt ss) (cons tt (cons h ss))))
        (native-gbt-mk k1 v sm r))))
     (else (native-raise (bl-key "error") (bl-make-tuple (bl-key "key_exists") key) (native-capture-stack))))))
  ((bl-is-nil t)
   (if (= s 0) (cons (native-gbt-mk key value bl-nil bl-nil) (cons 1 1)) (native-gbt-mk key value bl-nil bl-nil)))
  (else (native-gbt-clause!))))
(define (native-gbt-insert key value tree)
 (let* ((s (native-gbt-sized tree)) (s1 (+ s 1))
        (r (native-gbt-insert-1 key value (native-gbt-root tree) (* s1 s1))))
  ;; A balanced result is the bare tree (balance/2 returns T); a tracked one
  ;; is the triple's tree. OTP stores whichever insert_1 returned as the root
  ;; only in the bare case; the triple case cannot reach the top (S1^2 bound).
  (bl-make-tuple s1 (if (pair? r) (car r) r))))
(define (native-gbt-enter key value tree)
 (if (native-gbt-is-defined key tree)
  (bl-make-tuple (native-gbt-size-of tree) (native-gbt-update-1 key value (native-gbt-root tree)))
  (native-gbt-insert key value tree)))
(define (native-gbt-take-smallest1 t)
 ;; {Key, Value, Larger} as the list (key value . larger).
 (if (bl-is-nil (native-gbt-s t)) (cons (native-gbt-k t) (cons (native-gbt-v t) (native-gbt-b t)))
  (let ((r (native-gbt-take-smallest1 (native-gbt-s t))))
   (cons (car r) (cons (cadr r) (native-gbt-mk (native-gbt-k t) (native-gbt-v t) (cddr r) (native-gbt-b t)))))))
(define (native-gbt-merge sm la)
 (cond ((bl-is-nil la) sm) ((bl-is-nil sm) la)
       (else (let ((r (native-gbt-take-smallest1 la))) (native-gbt-mk (car r) (cadr r) sm (cddr r))))))
(define (native-gbt-delete-1 key t)
 (cond ((not (native-gbt-node? t)) (native-gbt-clause!))
       ((native-gbt-lt key (native-gbt-k t))
        (native-gbt-mk (native-gbt-k t) (native-gbt-v t) (native-gbt-delete-1 key (native-gbt-s t)) (native-gbt-b t)))
       ((native-gbt-gt key (native-gbt-k t))
        (native-gbt-mk (native-gbt-k t) (native-gbt-v t) (native-gbt-s t) (native-gbt-delete-1 key (native-gbt-b t))))
       (else (native-gbt-merge (native-gbt-s t) (native-gbt-b t)))))
(define (native-gbt-delete key tree)
 (let ((s (native-gbt-sized tree))) (bl-make-tuple (- s 1) (native-gbt-delete-1 key (native-gbt-root tree)))))
(define (native-gbt-extreme tree side)
 (let loop ((t (native-gbt-checked tree)))
  (if (not (native-gbt-node? t)) (native-gbt-clause!)
   (let ((next (if (eq? side 'small) (native-gbt-s t) (native-gbt-b t))))
    (if (bl-is-nil next) (bl-make-tuple (native-gbt-k t) (native-gbt-v t)) (loop next))))))
(define (native-gbt-values tree)
 (let walk ((t (native-gbt-checked tree)) (acc '()))
  (if (bl-is-nil t) acc (walk (native-gbt-s t) (cons (native-gbt-v t) (walk (native-gbt-b t) acc))))))
(define (native-gbt-iterator-1 t as)
 (cond ((bl-is-nil t) as)
       ((bl-is-nil (native-gbt-s t)) (cons t as))
       (else (native-gbt-iterator-1 (native-gbt-s t) (cons t as)))))
(define (native-gbt-iterator tree) (bl-make-tuple native-gbt-ordered (native-gbt-iterator-1 (native-gbt-checked tree) '())))
(define (native-gbt-iterator-from key tree)
 (bl-make-tuple native-gbt-ordered
  (let loop ((t (native-gbt-checked tree)) (as '()))
   (cond ((bl-is-nil t) as)
         ((native-gbt-lt (native-gbt-k t) key) (loop (native-gbt-b t) as))
         ((bl-is-nil (native-gbt-s t)) (cons t as))
         (else (loop (native-gbt-s t) (cons t as)))))))
(define (native-gbt-next iter)
 (if (not (and (native-gbt-wrapper? iter) (eq? (native-gbt-size-of iter) native-gbt-ordered)))
  (native-gbt-clause!)
  (let ((as (native-gbt-root iter)))
   (if (null? as) native-gbt-none
    (let ((t (car as)))
     (bl-make-tuple (native-gbt-k t) (native-gbt-v t)
      (bl-make-tuple native-gbt-ordered (native-gbt-iterator-1 (native-gbt-b t) (cdr as)))))))))
(native-add-leaf! "gb_trees/empty/0" native-gbt-empty)
(native-add-leaf! "gb_trees/size/1" native-gbt-size)
(native-add-leaf! "gb_trees/lookup/2" native-gbt-lookup)
(native-add-leaf! "gb_trees/is_defined/2" native-gbt-is-defined)
(native-add-leaf! "gb_trees/insert/3" native-gbt-insert)
(native-add-leaf! "gb_trees/enter/3" native-gbt-enter)
(native-add-leaf! "gb_trees/delete/2" native-gbt-delete)
(native-add-leaf! "gb_trees/smallest/1" (lambda (t) (native-gbt-extreme t 'small)))
(native-add-leaf! "gb_trees/largest/1" (lambda (t) (native-gbt-extreme t 'large)))
(native-add-leaf! "gb_trees/values/1" native-gbt-values)
(native-add-leaf! "gb_trees/iterator/1" native-gbt-iterator)
(native-add-leaf! "gb_trees/iterator_from/2" native-gbt-iterator-from)
(native-add-leaf! "gb_trees/next/1" native-gbt-next)
