   ((eq? (bl-nth (car ps) 0) key) (bl-nth (car ps) 1)) (else (loop (cdr ps)))))))
(define (native-error-constructor module input)
 (native-error-value module (if (string? input) input (native-options-get input (bl-key "message") (string-append module " exception")))))
(define (native-function-clause-error options)
 (let* ((module (native-options-get options (bl-key "module") bl-nil))
