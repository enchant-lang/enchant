(define (native-iolist-bytes x)
 ;; Fast path: build the byte list back to front onto its tail, no append
 ;; copies. Any element it does not accept sends the whole term through the
 ;; original walk, which raises exactly the error it raised before.
 (let ((fast (native-iolist-bytes-onto x '())))
  (if (eq? fast native-missing) (native-iolist-bytes-checked x) fast)))
(define (native-iolist-bytes-onto x tail)
 (cond ((eq? tail native-missing) tail)
  ((string? x) (native-utf8-bytes-onto x tail))
  ((and (fixnum? x) (fx>= x 0) (fx< x 256)) (cons x tail))
  ((null? x) tail)
  ((pair? x) (native-iolist-bytes-onto (car x) (native-iolist-bytes-onto (cdr x) tail)))
  (else native-missing)))
(define (native-iolist-bytes-checked x)
 (cond ((string? x) (native-utf8-bytes x))
  ((and (h-is-int x) (>= x 0) (< x 256)) (list x))
  ((null? x) '()) ((pair? x) (append (native-iolist-bytes-checked (car x)) (native-iolist-bytes-checked (cdr x))))
  (else (native-badarg "iolist byte or binary expected"))))
(define (native-iolist-binary x) (native-utf8-string (native-iolist-bytes x)))
(define (native-error-value? x)
