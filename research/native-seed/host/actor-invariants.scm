;; Observational qualification sampler. Append AFTER host-values.scm; it never
;; selects an actor, changes a mailbox, or repairs state. Run the full shared
;; corpus at normal, 17- and 41-step budgets and preserve these observations.
(define native-boundary-samples 0)
(define native-boundary-deaths 0)
(define native-boundary-prior-pids '())
(define (native-sample-assert value label)
 (if (not value) (error "native actor boundary invariant" label)))
(define (native-sample-key? value tag)
 (and (h-is-vec value) (= 3 (h-vec-size value))
      (bl-equal? (h-vec-el value 0) (bl-key tag)) (h-is-int (h-vec-el value 2))))
(define (native-sample-boundary)
 (if (and (= seed-critical 0) (not (bl-is-nil (bl-get seed-state (bl-key "procs")))))
  (let* ((procs (bl-get seed-state (bl-key "procs")))
         (pids (h-map-keys procs))
         (live? (lambda (pid) (not (bl-is-nil (bl-get procs pid))))))
   (set! native-boundary-samples (+ native-boundary-samples 1))
   (for-each (lambda (old) (if (not (live? old))
               (set! native-boundary-deaths (+ native-boundary-deaths 1)))) native-boundary-prior-pids)
   (set! native-boundary-prior-pids pids)
   (for-each (lambda (pid)
    (native-sample-assert (native-sample-key? pid "pid") "typed pid")
    (let ((p (bl-get procs pid)))
     (for-each (lambda (other)
       (native-sample-assert (live? other) "link to dead actor")
       (native-sample-assert (not (bl-is-nil
        (bl-get (bl-get (bl-get procs other) (bl-key "links")) pid))) "one-sided link"))
      (h-map-keys (bl-get p (bl-key "links"))))
     (for-each (lambda (child)
       (native-sample-assert (live? child) "dead owned child")
       (native-sample-assert (bl-equal? pid (bl-get (bl-get procs child) (bl-key "owner"))) "ownership backlink"))
      (h-map-keys (bl-get p (bl-key "owned")))))) pids)
   (let ((monitors (bl-get seed-state (bl-key "monitors"))))
    (for-each (lambda (ref)
      (native-sample-assert (native-sample-key? ref "ref") "typed monitor ref")
      (let ((entry (bl-get monitors ref)))
       (native-sample-assert (live? (bl-get entry (bl-key "from"))) "monitor from dead actor")
       (native-sample-assert (live? (bl-get entry (bl-key "to"))) "monitor to dead actor")))
     (h-map-keys monitors)))
   (for-each (lambda (pid) (native-sample-assert (live? pid) "dead runnable actor"))
    (bl-items (bl-get seed-state (bl-key "runnable"))))
   (let ((sink (bl-get seed-state (bl-key "input-sink"))))
    (native-sample-assert (or (bl-is-nil sink) (live? sink)) "dead input sink"))
   (for-each (lambda (name)
     (native-sample-assert (live? (bl-get (bl-get seed-state (bl-key "names")) name)) "name points to dead actor"))
    (h-map-keys (bl-get seed-state (bl-key "names"))))
   (let ((tables (bl-get seed-state (bl-key "tables")))
         (names (bl-get seed-state (bl-key "table-names"))))
    (for-each (lambda (tid)
      (native-sample-assert (native-sample-key? tid "table") "typed table id")
      (native-sample-assert (live? (bl-get (bl-get tables tid) (bl-key "owner"))) "table owned by dead actor"))
     (h-map-keys tables))
    (for-each (lambda (name)
      (let ((meta (bl-get tables (bl-get names name))))
       (native-sample-assert (not (bl-is-nil meta)) "table name points to missing table")
       (native-sample-assert (bl-equal? name (bl-get meta (bl-key "name"))) "table name backlink")))
     (h-map-keys names))))))
(define native-unsampled-run-turn h-run-turn)
(set! h-run-turn (lambda (frames budget)
 (native-sample-boundary)
 (let ((result (native-unsampled-run-turn frames budget)))
  (native-sample-boundary) result)))
