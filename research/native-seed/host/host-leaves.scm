;; accessors remain strict; nominal Source guards and errors live at this ABI.
(define (native-vector-function-clause! name arity)
 (native-raise (bl-key "error")
  (native-function-clause-error
   (list (bl-tuple (list (bl-key "module") (bl-key "Elixir.BeamLisp.Vector")))
         (bl-tuple (list (bl-key "function") (bl-key name)))
         (bl-tuple (list (bl-key "arity") arity))))
  (native-capture-stack)))
