;; Raw erlang:apply/2 follows the canonical BEAM fun-only BIF contract.
;; Language callable maps/keywords/$blfn remain owned by bl-invoke.
(define native-raw-function? procedure?)
(define (native-check-raw-apply! function arguments)
 (if (not (native-list? arguments))
  (native-raise (bl-key "error") (bl-key "badarg") (native-capture-stack)))
 (if (not (native-raw-function? function))
  (native-raise (bl-key "error") (bl-tuple (list (bl-key "badfun") function)) (native-capture-stack)))
 (if (not (native-callable-accepts? function (length arguments)))
  (native-raise (bl-key "error")
   (bl-tuple (list (bl-key "badarity") (bl-tuple (list function arguments)))) (native-capture-stack))))
(define (native-raw-apply function arguments)
 (native-check-raw-apply! function arguments)
 (bl-invoke function arguments))
