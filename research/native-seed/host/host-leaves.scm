;; Raw host/module leaves. Canonical core/rt/compiler definitions are linked
;; separately; these implement host storage, finite Enum, and Erlang primitives.
(define native-leaf-registry (bl-empty-map))
;; Every leaf also has a stable named top-level binding, the exact spelling of
;; native.bootstrap/leaf-binding-name ("l" + scheme/ident), which AOT code
;; calls directly. The registry stays the runtime lookup authority.
(define (native-leaf-binding-name key)
 (string-append "lv"
  (apply string-append
   (map (lambda (c) (string-append "_" (number->string (char->integer c)))) (string->list key)))))
(define native-link-changed! (lambda () #f))
(define (native-bind-leaf! key value)
 (##global-var-set! (##make-global-var (string->symbol (native-leaf-binding-name key))) value)
 (set! native-leaf-registry (bl-assoc native-leaf-registry key value))
 (native-link-changed!))
(define (native-add-leaf! key value)
 (native-mark-host-callable! value)
 (if (native-map-has? native-leaf-registry key) (error (string-append "duplicate native leaf: " key)))
 (if (procedure? value)
  (let find ((i (- (string-length key) 1)))
   (if (char=? (string-ref key i) #\/) (bl-register-callable! value (string->number (substring key (+ i 1) (string-length key)))) (find (- i 1)))))
 (native-bind-leaf! key value) value)
;; Replace an EXISTING leaf (source-frame transport rebinding): registry,
;; named binding and dynamic lookups change together.
(define (native-replace-leaf! key value)
 (if (not (native-map-has? native-leaf-registry key)) (error "native leaf replacement expected an existing leaf" key))
 (native-bind-leaf! key value) value)
(define (native-leaf key) (bl-get native-leaf-registry key native-missing))
(define (native-badarg who) (native-raise (bl-key "error") (bl-tuple (list (bl-key "badarg") who)) (native-capture-stack)))
(define (native-assert-list xs) (if (native-list? xs) xs (native-badarg "proper list expected")))
(define (native-assert-tuple t) (if (bl-tag? t 'tuple) t (native-badarg "tuple expected")))
(define (native-assert-map m) (if (or (bl-tag? m 'map) (bl-tag? m 'vec) (bl-tag? m 'set) (native-opaque-struct? m)) (native-struct-fields m) (native-badarg "map expected")))
;; Specialised values (vector, set, opaque struct) answer their struct fields
;; directly, as BEAM's maps:get/is_key on the struct would: `:__struct__` (the
;; key every kind test reads) never materialises the member map (MEASURE A3).
;; Field keys are interned once here rather than per call.
(define native-meta-key (bl-key "meta"))
(define native-items-key (bl-key "items"))
(define native-members-key (bl-key "members"))
(define (native-raw-map-has? m key)
 (cond ((bl-tag? m 'vec) (or (eq? key native-struct-key) (eq? key native-meta-key) (eq? key native-items-key)))
  ((bl-tag? m 'set) (or (eq? key native-struct-key) (eq? key native-members-key)))
  ((and (eq? key native-struct-key) (not (bl-tag? m 'map)) (native-opaque-struct? m)) #t)
  (else (native-raw-has? (native-assert-map m) key))))
(define (native-raw-map-size m)
 (cond ((bl-tag? m 'vec) 3) ((bl-tag? m 'set) 2)
  (else (native-map-count (native-assert-map m)))))
(define (native-badkey key)
 (native-raise (bl-key "error") (bl-tuple (list (bl-key "badkey") key)) (native-capture-stack)))
(define (native-map-fetch key m)
 (cond
  ((bl-tag? m 'vec)
   (cond ((eq? key native-struct-key) native-vector-module-key)
    ((eq? key native-meta-key) (native-vector-meta m))
    ((eq? key native-items-key) (native-vector-canonical-items m))
    (else (native-badkey key))))
  ((and (bl-tag? m 'set) (eq? key native-struct-key)) native-set-module-key)
  ((and (eq? key native-struct-key) (not (bl-tag? m 'map)) (native-opaque-struct? m)) (native-struct-module m))
  (else
   (let ((v (native-raw-get (native-assert-map m) key native-missing)))
    (if (eq? v native-missing) (native-badkey key) v)))))
(define (native-raw-map-get m key default)
 ;; Ordinary maps (including plain tagged structs) already have the raw
 ;; fields. Search once; retain existing specialized projection/type gates.
 ;; Raw Erlang keys (Q3 keeps them raw): 1 and 1.0 are two keys here.
 (if (bl-tag? m 'map) (native-raw-get m key default)
  (if (native-raw-map-has? m key) (native-map-fetch key m) default)))
;; Deferred collection algorithms belong to the compiled canonical runtime.
;; Storage-only hosts intentionally cannot enumerate a deferred struct as data.
(define native-canonical-sequence-items #f)
(define (native-deferred-items value)
 (if (procedure? native-canonical-sequence-items)
  (native-canonical-sequence-items value)
  (native-raise (bl-key "error")
   (bl-map (bl-key "type") (bl-key "native/runtime-unavailable")
           (bl-key "operation") "rt/k-to-list") (native-capture-stack))))
;; Struct-tag predicates for the compiled lazy modules' values (their behaviour
;; is the compiled BL of priv/host/lazy_seq.bl and seq_cursor.bl).
(define (native-lazy? x) (eq? (native-struct-module x) (bl-key "Elixir.BeamLisp.LazySeq")))
(define (native-cursor? x) (eq? (native-struct-module x) (bl-key "Elixir.BeamLisp.SeqCursor")))
(define (native-finite-items x)
 (cond ((bl-is-nil x) '()) ((native-list? x) x)
       ((or (bl-tag? x 'tuple) (bl-tag? x 'vec)) (bl-items x))
       ((bl-tag? x 'set) (native-set-items x))
       ((or (native-lazy? x) (native-cursor? x)) (native-deferred-items x))
       ((bl-tag? x 'map) (native-map-pairs x))
       (else (native-badarg "finite collection expected"))))
(define (native-fold f acc xs)
 (let loop ((xs xs) (acc acc)) (if (null? xs) acc (loop (cdr xs) (bl-invoke f (list (car xs) acc))))))
(define (native-filter f xs)
 (let loop ((xs xs) (out '())) (if (null? xs) (reverse out)
  (loop (cdr xs) (if (bl-truthy (bl-invoke f (list (car xs)))) (cons (car xs) out) out)))))
(define (native-merge cmp a b)
 (cond ((null? a) b) ((null? b) a) ((cmp (car a) (car b)) (cons (car a) (native-merge cmp (cdr a) b)))
       (else (cons (car b) (native-merge cmp a (cdr b))))))
(define (native-sort cmp xs)
 (if (or (null? xs) (null? (cdr xs))) xs
  (let* ((n (quotient (length xs) 2)) (a (native-take xs n)) (b (native-drop xs n)))
   (native-merge cmp (native-sort cmp a) (native-sort cmp b)))))
(define (native-term-compare a b)
 (if (and (native-number? a) (native-number? b)) (native-number-compare a b) (bl-key-compare a b)))
(define (native-term-le a b) (<= (native-term-compare a b) 0))
(define (native-unique xs)
 (let loop ((xs xs) (seen (bl-empty-map)) (out '()))
  (if (null? xs) (reverse out)
   (if (native-map-has? seen (car xs)) (loop (cdr xs) seen out)
    (loop (cdr xs) (bl-assoc seen (car xs) #t) (cons (car xs) out))))))
(define (native-zip a b)
 (if (or (null? a) (null? b)) '() (cons (bl-tuple (list (car a) (car b))) (native-zip (cdr a) (cdr b)))))
(define (native-map-merge a b)
 (let loop ((ps (native-map-pairs (native-assert-map b))) (out (native-assert-map a)))
  (if (null? ps) out (loop (cdr ps) (native-raw-assoc out (bl-nth (car ps) 0) (bl-nth (car ps) 1))))))
(define (native-map-filter f m)
 (let loop ((ps (native-map-pairs (native-assert-map m))) (out (bl-empty-map)))
  (if (null? ps) out (let* ((p (car ps)) (k (bl-nth p 0)) (v (bl-nth p 1)))
   (loop (cdr ps) (if (bl-truthy (bl-invoke f (list k v))) (native-raw-assoc out k v) out))))))
(define native-pdict (make-parameter (bl-empty-map)))
(define native-unique-counter 0)
(define (native-unique-integer . ignored)
 (set! native-unique-counter (+ 1 native-unique-counter)) native-unique-counter)
(define (native-pdict-put key value missing)
 (let* ((m (native-pdict)) (old (native-raw-get m key missing))) (native-pdict (native-raw-assoc m key value)) old))
(define (native-pdict-erase key)
 (let* ((m (native-pdict)) (old (native-raw-get m key (bl-key "undefined"))))
  (native-pdict (native-raw-remove m key)) old))

;; UTF-8 binary primitives preserve BEAM byte indices independently of Scheme
;; strings' Unicode scalar indices. Invalid/split sequences are refused.
(define (native-utf8-bytes text)
 (if (not (string? text)) (native-badarg "invalid scalar string: lone UTF16 surrogate cannot become a text binary"))
 (let loop ((cs (string->list text)) (out '()))
  (if (null? cs) (reverse out) (let ((c (char->integer (car cs))))
   (cond ((< c 128) (loop (cdr cs) (cons c out)))
    ((< c 2048) (loop (cdr cs) (cons (+ 128 (modulo c 64)) (cons (+ 192 (quotient c 64)) out))))
    ((and (>= c 55296) (< c 57344)) (native-badarg "surrogate is not a UTF-8 scalar"))
    ((< c 65536) (loop (cdr cs) (cons (+ 128 (modulo c 64)) (cons (+ 128 (modulo (quotient c 64) 64)) (cons (+ 224 (quotient c 4096)) out)))))
    ((< c 1114112) (loop (cdr cs) (cons (+ 128 (modulo c 64)) (cons (+ 128 (modulo (quotient c 64) 64)) (cons (+ 128 (modulo (quotient c 4096) 64)) (cons (+ 240 (quotient c 262144)) out))))))
    (else (native-badarg "invalid Unicode scalar")))))))
(define (native-utf8-string bytes)
 (let loop ((xs bytes) (out '()))
  (if (null? xs) (list->string (reverse out))
   (let* ((b (car xs)) (width (cond ((< b 128) 1) ((and (>= b 194) (< b 224)) 2)
      ((and (>= b 224) (< b 240)) 3) ((and (>= b 240) (< b 245)) 4) (else (native-badarg "invalid UTF-8 leader"))))
      (minimum (case width ((1) 0) ((2) 128) ((3) 2048) (else 65536))))
    (let consume ((n (- width 1)) (p (cdr xs)) (value (if (= width 1) b (modulo b (expt 2 (- 7 width))))))
     (if (= n 0)
      (if (or (< value minimum) (> value 1114111) (and (>= value 55296) (< value 57344))) (native-badarg "invalid UTF-8 scalar")
       (loop p (cons (integer->char value) out)))
      (if (or (null? p) (< (car p) 128) (>= (car p) 192)) (native-badarg "invalid UTF-8 continuation")
       (consume (- n 1) (cdr p) (+ (* value 64) (- (car p) 128))))))))))
(define (native-binary-part text start size)
 (let* ((bytes (native-utf8-bytes text)) (n (length bytes))
        (offset (if (< size 0) (+ start size) start)) (count (abs size)))
  (if (or (< offset 0) (> (+ offset count) n)) (native-badarg "binary_part bounds")
   (native-utf8-string (native-take (native-drop bytes offset) count)))))
(define (native-char-data text)
 (cond ((string? text) text) ((integer? text) (string (integer->char text)))
  ((null? text) "") ((pair? text) (apply string-append (map native-char-data (native-assert-list text))))
  (else (native-badarg "Unicode character data expected"))))
(define (native-parse-integer chars)
 (let* ((negative? (and (pair? chars) (= (car chars) 45)))
        (start (if (and (pair? chars) (or (= (car chars) 43) (= (car chars) 45))) (cdr chars) chars)))
  (if (or (null? start) (< (car start) 48) (> (car start) 57)) (bl-tuple (list (bl-key "error") (bl-key "no_integer")))
   (let loop ((p start) (n 0))
    (if (and (pair? p) (>= (car p) 48) (<= (car p) 57)) (loop (cdr p) (+ (* n 10) (- (car p) 48)))
     (bl-tuple (list (if negative? (- n) n) p)))))))
(define (native-decimal-parse text)
 (let* ((chars (string->list text))
        (sign (if (and (pair? chars) (char=? (car chars) #\-)) -1 1))
        (chars (if (and (pair? chars) (or (char=? (car chars) #\-) (char=? (car chars) #\+))) (cdr chars) chars)))
  (let loop ((p chars) (n 0) (digits 0) (scale #f))
   (cond ((null? p) (if (= digits 0) (bl-key "error") (bl-tuple (list (bl-key "ok") (bl-decimal (* sign n) (if scale scale 0))))))
    ((and (char>=? (car p) #\0) (char<=? (car p) #\9))
     (loop (cdr p) (+ (* n 10) (- (char->integer (car p)) 48)) (+ digits 1) (if scale (+ scale 1) #f)))
    ((and (not scale) (char=? (car p) #\.)) (loop (cdr p) n digits 0))
    (else (bl-key "error"))))))
(define (native-split-with f xs)
 (let loop ((xs xs) (out '()))
  (if (and (pair? xs) (bl-truthy (bl-invoke f (list (car xs))))) (loop (cdr xs) (cons (car xs) out))
   (bl-tuple (list (reverse out) xs)))))
(define (native-list-all f xs)
 (or (null? xs) (let ((answer (bl-invoke f (list (car xs)))))
  (cond ((eq? answer #f) #f) ((eq? answer #t) (native-list-all f (cdr xs))) (else (native-badarg "nonboolean predicate"))))))
(define (native-list-seq a b)
 (if (or (not (h-is-int a)) (not (h-is-int b)) (< b (- a 1))) (native-badarg "invalid seq range")
  (let loop ((i b) (out '())) (if (< i a) out (loop (- i 1) (cons i out))))))

;; OTP-29.0.1 lists.erl:2866-2880: is_list is a cell tag check. Consume
;; only the requested prefix; the residual term may be an improper tail.
;; Reader/take-token calls this on the whole remaining Source every token.
;; A full proper-list/length preflight here makes that linear Reader quadratic.
(define (native-lists-split count items)
 (define (fail reason)
  (native-raise (bl-key "error") (bl-key reason) (native-capture-stack)))
 (if (not (and (h-is-int count) (>= count 0) (or (null? items) (pair? items))))
  (fail "badarg")
  (let loop ((remaining count) (tail items) (prefix '()))
   (cond ((= remaining 0) (bl-tuple (list (reverse prefix) tail)))
    ((pair? tail) (loop (- remaining 1) (cdr tail) (cons (car tail) prefix)))
    ((null? tail) (fail "badarg"))
    (else (fail "function_clause"))))))

