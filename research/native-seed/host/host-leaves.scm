 ;; guard, then length/1 raises badarg. A non-list is a FunctionClauseError.
 (cond ((or (null? items) (pair? items))
        (if (native-list? items) (bl-vec items)
         (native-raise (bl-key "error") (bl-key "badarg") (native-capture-stack))))
       (else (native-vector-function-clause! "new" 1))))
(define (native-vector-count-public value)
