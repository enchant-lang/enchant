; Prepare both complementary helper fixtures in ONE existing SDK process.
(ns native.prepare-proc-corpora
 (:require [native.proc-corpus :as corpus] [bl.json :as json]))
(def args (BeamLisp/argv))
(def base "research/native-seed")
(def closure-dir (or (first args) (str base "/out/compiler-closure")))
(def out (or (second args) (str base "/out/proc-corpora")))
(def selected (if-let [fixture (nth args 2 nil)] [fixture] ["proc-demand" "proc-composed"]))
(assert (every? #(contains? #{"proc-demand" "proc-composed"} %) selected))
(doseq [fixture selected]
 (let [directory (str out "/" fixture)
       manifest (corpus/write!
        {:application (str base "/fixtures/" fixture ".bl") :output (str directory "/program.scm")
         :prelude (str closure-dir "/prelude.scm")
         :closure-manifest (str closure-dir "/partition.json") :leaves (str closure-dir "/leaves.json")})]
  (File/write! (str directory "/manifest.json") (json/encode manifest))))
(println "NATIVE_PROC_CORPORA_PREPARED 2 exact original fixtures")
