;; Budget/clock observations only. The compiled Source owns every process,
;; delayed reply, registry update, demand credit, timer and cleanup transition.
(define native-proc-budget-name (or (getenv "NATIVE_ACTOR_BUDGET" #f) "default"))
(define native-proc-budget
 (cond ((string=? native-proc-budget-name "default") #f)
  ((string=? native-proc-budget-name "17") 17)
  ((string=? native-proc-budget-name "41") 41)
  (else (error "unsupported proc fixture budget" native-proc-budget-name))))
(define native-proc-max-procs 0)
(define native-proc-max-monitors 0)
(define native-proc-max-tables 0)
(define (native-proc-observe)
 (let ((procs (bl-get seed-state (bl-key "procs"))))
  (if (and (= seed-critical 0) (not (bl-is-nil procs)))
   (begin
    (set! native-proc-max-procs (max native-proc-max-procs (h-map-size procs)))
    (set! native-proc-max-monitors (max native-proc-max-monitors (h-map-size (bl-get seed-state (bl-key "monitors")))))
    (set! native-proc-max-tables (max native-proc-max-tables (h-map-size (bl-get seed-state (bl-key "tables")))))))))
(define native-proc-run-turn h-run-turn)
(set! h-run-turn (native-mark-host-callable! (lambda (frames budget)
 (native-proc-observe)
 (let ((answer (native-proc-run-turn frames (or native-proc-budget budget))))
  (native-proc-observe) answer))))
(bl-register-callable! h-run-turn 2)
(define (native-proc-finish)
 (native-sample-boundary) (native-proc-observe)
 (if (not native-virtual-time?) (error "proc fixture changed its declared virtual clock"))
 (if (not (null? seed-errors)) (error "proc fixture recorded runtime errors"))
 (for-each (lambda (key)
  (if (not (= 0 (h-map-size (bl-get seed-state (bl-key key)))))
   (error "proc fixture actor resource leak" key))) '("procs" "monitors" "tables" "names" "table-names"))
 (if (not (= 0 (h-vec-size (bl-get seed-state (bl-key "runnable"))))) (error "proc fixture runnable leak"))
 (if (not (bl-is-nil (bl-get seed-state (bl-key "input-sink")))) (error "proc fixture input sink leak"))
 (if (not (= seed-critical 0)) (error "proc fixture critical section leak"))
 (if (or native-input-producer (pair? native-input-queue)) (error "proc fixture input capability leak"))
 (if (not (and (> native-boundary-samples 0) (> native-boundary-deaths 0)
               (> native-proc-max-procs 1) (> native-proc-max-monitors 0)
               (> native-virtual-turn-clock-completed 0)
               (= native-virtual-turn-clock-turn-ms native-virtual-turn-clock-completed)
               (>= (- seed-clock native-virtual-turn-clock-start) native-virtual-turn-clock-turn-ms)
               (<= native-virtual-turn-clock-yields native-virtual-turn-clock-completed)
               (or (not native-proc-budget) (> native-virtual-turn-clock-yields 0))))
  (error "proc fixture lacks actual lifecycle/clock observations"))
 (display "PASS full-runtime-cleanup\n")
 (display "NATIVE_PROC_WITNESS {\"budget\":\"") (display native-proc-budget-name)
 (display "\",\"samples\":") (display native-boundary-samples)
 (display ",\"deaths\":") (display native-boundary-deaths)
 (display ",\"max_procs\":") (display native-proc-max-procs)
 (display ",\"max_monitors\":") (display native-proc-max-monitors)
 (display ",\"max_tables\":") (display native-proc-max-tables)
 (display ",\"clock\":{\"model\":\"virtual-turn-ms-v1\",\"tick_ms\":1,\"completed_turns\":")
 (display native-virtual-turn-clock-completed)
 (display ",\"yield_turns\":") (display native-virtual-turn-clock-yields)
 (display ",\"turn_ms\":") (display native-virtual-turn-clock-turn-ms)
 (display ",\"elapsed_ms\":") (display (- seed-clock native-virtual-turn-clock-start))
 (display "},\"cleanup\":{\"procs\":0,\"monitors\":0,\"tables\":0,\"names\":0,\"table_names\":0,\"runnable\":0,\"input_sink\":null,\"critical\":0,\"errors\":0}}\n"))
