; Canonical Source helpers, finite linker, and exact native ELF gate artifacts.
(ns native.build-runtime (:require [native.proc-corpus :as corpus]))
(def args (BeamLisp/argv))
(def base "research/native-seed")
(corpus/write!
 {:application (or (first args) (str base "/fixtures/proc-demand.bl"))
  :output (or (second args) (str base "/out/linked-proc.scm"))
  :prelude (or (nth args 2 nil) (str base "/out/compiler-closure/prelude.scm"))
  :closure-manifest (or (nth args 3 nil) (str base "/out/compiler-closure/partition.json"))
  :leaves (or (nth args 4 nil) (str base "/out/compiler-closure/leaves.json"))})
