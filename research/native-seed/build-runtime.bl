; This delegates namespace staging, module admission and arity/link selection
; to native.proc-link. Run under the existing frozen SDK/run transport.
(ns native.build-runtime
 (:require [native.proc-link :as linker] [bl.json :as json]))
(def args (BeamLisp/argv))
(def base "research/native-seed")
(def application (or (first args) (str base "/fixtures/proc-demand.bl")))
(def output (or (second args) (str base "/out/linked-proc.scm")))
(def prelude (or (nth args 2 nil) (str base "/out/compiler-closure/prelude.scm")))
(def closure (or (nth args 3 nil) (str base "/out/compiler-closure/partition.json")))
(def leaves (or (nth args 4 nil) (str base "/out/compiler-closure/leaves.json")))
(def result (linker/build-project
 {:application application :runtime "priv/lib/js/actor/runtime.bl" :bridges (str base "/bridges.bl")
  :links (str base "/actor-links.edn") :sdk-pin (str base "/sdk-pin.json")
  :host-link (str base "/host/host-proc-link.scm")
  :prelude prelude :closure-manifest closure :leaves leaves}))
(File/mkdir_p! (Path/dirname output))
(File/write! output
 (str (:program result)
  "(for-each (lambda (key) (if (not (= (h-map-size (bl-get seed-state (bl-key key))) 0)) (error \"actor resource leak\" key))) '(\"procs\" \"monitors\" \"tables\" \"names\" \"table-names\"))\n"
  "(if (not (= (h-vec-size (bl-get seed-state (bl-key \"runnable\"))) 0)) (error \"runnable leak\"))\n"
  "(if (not (bl-is-nil (bl-get seed-state (bl-key \"input-sink\")))) (error \"input sink leak\"))\n"
  "(if (not (= seed-critical 0)) (error \"critical section leak\"))\n"
  "(display \"PASS full-runtime-cleanup\\n\")\n"))
(File/write! (str output ".manifest.json") (json/encode (:manifest result)))
(File/write! (str output ".anf.etf")
 (erlang/term_to_binary {:schema "bl.native.anf-unit" :version 1 :definitions (:definitions result)
                        :entry (:entry result) :link-manifest (:manifest result)} (list :deterministic)))
(println (str "NATIVE_PROC_LINKED " (count (:definitions result)) " exact source bodies"))
