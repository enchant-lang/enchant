;; Host observation only; all authored functions come from actual .o1 modules.
(define linked-proof-checks 0)
(define (linked-proof-check label value)
 (if (not value) (error "native Scheme module probe failed" label))
 (set! linked-proof-checks (+ linked-proof-checks 1)))
(define (linked-proof-native? value)
 (and (procedure? value) (not (##interp-procedure? value))))
(define (linked-proof-parent value)
 (if (not (linked-proof-native? value)) (error "module procedure is interpreted or absent"))
 (let ((parent (##subprocedure-parent (if (##closure? value) (##closure-code value) value))))
  (if (not (linked-proof-native? parent)) (error "module procedure lacks a native owner"))
  parent))
(define (linked-proof-binding name)
 ;; One metadata-selected SYMBOL read, never an authored Scheme body.
 (eval (string->symbol name) (interaction-environment)))
(define linked-proof-existing-parents '())
(define (linked-proof-observe-existing value)
 (cond
  ((linked-proof-native? value)
   (let ((parent (with-exception-catcher (lambda (failure) #f)
                  (lambda () (linked-proof-parent value)))))
    (if (and parent (not (memq parent linked-proof-existing-parents)))
     (set! linked-proof-existing-parents (cons parent linked-proof-existing-parents)))))
  ((native-multi-callable? value)
   (for-each (lambda (row) (linked-proof-observe-existing (bl-nth row 1)))
             (native-map-pairs (bl-nth value 1)))
   (if (not (bl-is-nil (bl-nth value 2)))
    (linked-proof-observe-existing (bl-nth (bl-nth value 2) 1))))))
(for-each (lambda (registry)
 (for-each (lambda (row) (linked-proof-observe-existing (bl-nth row 1)))
           (native-map-pairs registry)))
 (list native-global-registry native-leaf-registry))
(define (linked-proof-parents names forbidden)
 (if (null? names) (error "module physical inventory is empty"))
 (map (lambda (name)
        (let ((parent (linked-proof-parent (linked-proof-binding name))))
         (if (memq parent forbidden) (error "module aliases an existing compiled owner" name))
         parent)) names))

(define linked-provider @PROVIDER@)
(define linked-consumer @CONSUMER@)
(define linked-refuse-eval (lambda arguments (error "authored Scheme eval is forbidden in linked probe")))
(define (linked-proof-init name)
 (linked-proof-check 'initializer-native
  (not (memq (linked-proof-parent (linked-proof-binding name)) linked-proof-existing-parents)))
 (bl-invoke (linked-proof-binding name) '()))
(define (linked-proof-run)
 (let ((original (native-leaf "host/eval-scheme/1")))
  (if (not (eq? original native-eval-string)) (error "unexpected native eval boundary"))
  (native-mark-host-callable! linked-refuse-eval)
  (bl-register-callable! linked-refuse-eval 1)
  (set! native-leaf-registry (bl-assoc native-leaf-registry "host/eval-scheme/1" linked-refuse-eval))
  (set! native-eval-string linked-refuse-eval))
 (load @FIRST_PROVIDER_MODULE@)
 (linked-proof-init @FIRST_PROVIDER_INITIALIZER@)
 (let* ((provider-first-answer-parents (linked-proof-parents '@FIRST_PROVIDER_ANSWER_PHYSICAL@ linked-proof-existing-parents))
        (provider-first-adder-parents (linked-proof-parents '@FIRST_PROVIDER_ADDER_PHYSICAL@ linked-proof-existing-parents))
        (answer-provider-first (native-global-exact linked-provider "answer")))
  (linked-proof-check 'first-provider-answer-physical (pair? provider-first-answer-parents))
  (linked-proof-check 'first-provider-adder-physical (pair? provider-first-adder-parents))
  (load @FIRST_CONSUMER_MODULE@)
  (linked-proof-init @FIRST_CONSUMER_INITIALIZER@)
  (let* ((consumer-first-answer-parents (linked-proof-parents '@FIRST_CONSUMER_ANSWER_PHYSICAL@ linked-proof-existing-parents))
         (consumer-first-capture-parents (linked-proof-parents '@FIRST_CONSUMER_CAPTURE_PHYSICAL@ linked-proof-existing-parents))
         (answer-consumer-first (native-global-exact linked-consumer "answer"))
         (capture-consumer-first (native-global-exact linked-consumer "capture"))
         (held (bl-invoke capture-consumer-first (list 7)))
         (held-parent (linked-proof-parent held))
         (consumer-parent (linked-proof-parent answer-consumer-first)))
   (linked-proof-check 'first-consumer-answer-physical (pair? consumer-first-answer-parents))
   (linked-proof-check 'first-consumer-capture-physical (pair? consumer-first-capture-parents))
   (linked-proof-check 'consumer-linked-first-answer (= (bl-invoke answer-consumer-first '()) 42))
   (linked-proof-check 'consumer-linked-first-capture (= (bl-invoke held (list 9)) 16))
   (linked-proof-check 'held-capture-owned-by-provider (memq held-parent provider-first-adder-parents))
   (load @SECOND_PROVIDER_MODULE@)
   (linked-proof-init @SECOND_PROVIDER_INITIALIZER@)
   (let* ((forbidden (append linked-proof-existing-parents provider-first-answer-parents provider-first-adder-parents))
          (provider-second-answer-parents (linked-proof-parents '@SECOND_PROVIDER_ANSWER_PHYSICAL@ forbidden))
          (provider-second-adder-parents (linked-proof-parents '@SECOND_PROVIDER_ADDER_PHYSICAL@ forbidden))
          (answer-provider-second (native-global-exact linked-provider "answer"))
          (fresh (bl-invoke capture-consumer-first (list 7))))
    (linked-proof-check 'second-provider-answer-physical (pair? provider-second-answer-parents))
    (linked-proof-check 'second-provider-adder-physical (pair? provider-second-adder-parents))
    (linked-proof-check 'old-consumer-keeps-native-parent (eq? consumer-parent (linked-proof-parent answer-consumer-first)))
    (linked-proof-check 'old-consumer-calls-new-provider (= (bl-invoke answer-consumer-first '()) 99))
    (linked-proof-check 'current-consumer-calls-new-provider (= (bl-invoke (native-global-exact linked-consumer "answer") '()) 99))
    (linked-proof-check 'new-provider-capture-through-old-consumer (= (bl-invoke fresh (list 9)) 116))
    (linked-proof-check 'held-provider-capture-stays-old (= (bl-invoke held (list 9)) 16))
    (linked-proof-check 'fresh-capture-owned-by-new-provider (memq (linked-proof-parent fresh) provider-second-adder-parents))
    (linked-proof-check 'provider-revisions-distinct (not (eq? answer-provider-first answer-provider-second)))
    (linked-proof-check 'captured-provider-answer-stays-old (= (bl-invoke answer-provider-first '()) 42))
    (##gc)
    (linked-proof-check 'held-capture-after-gc (and (eq? held-parent (linked-proof-parent held)) (= (bl-invoke held (list 9)) 16)))
    (linked-proof-check 'fresh-capture-after-gc (= (bl-invoke fresh (list 9)) 116))
    (linked-proof-check 'old-consumer-after-gc (= (bl-invoke answer-consumer-first '()) 99))
    ;; Deliberately malformed ELF module bytes fail before any initializer.
    ;; This proves this one loader failure leaves serving registry data alone;
    ;; it is not a general candidate transaction or native admission proof.
    (let* ((before native-global-registry)
           (failed (with-exception-catcher (lambda (failure) #t)
                    (lambda () (load @INVALID_MODULE@) #f))))
     (linked-proof-check 'invalid-module-load-refused failed)
     (linked-proof-check 'failed-load-keeps-registry (eq? before native-global-registry))
     (linked-proof-check 'old-consumer-after-failed-load (= (bl-invoke answer-consumer-first '()) 99))
     (linked-proof-check 'held-capture-after-failed-load (= (bl-invoke held (list 9)) 16)))
    ;; Exact current owner emitted a conservative fresh consumer artifact.
    ;; Loading it here is separate from the old-consumer late-link observation.
    (load @SECOND_CONSUMER_MODULE@)
    (linked-proof-init @SECOND_CONSUMER_INITIALIZER@)
    (let* ((new-forbidden (append forbidden consumer-first-answer-parents consumer-first-capture-parents))
           (consumer-second-answer-parents (linked-proof-parents '@SECOND_CONSUMER_ANSWER_PHYSICAL@ new-forbidden))
           (consumer-second-capture-parents (linked-proof-parents '@SECOND_CONSUMER_CAPTURE_PHYSICAL@ new-forbidden))
           (answer-consumer-second (native-global-exact linked-consumer "answer"))
           (capture-consumer-second (native-global-exact linked-consumer "capture"))
           (newest (bl-invoke capture-consumer-second (list 7))))
     (linked-proof-check 'second-consumer-answer-physical (pair? consumer-second-answer-parents))
     (linked-proof-check 'second-consumer-capture-physical (pair? consumer-second-capture-parents))
     (linked-proof-check 'second-consumer-answer (= (bl-invoke answer-consumer-second '()) 99))
     (linked-proof-check 'second-consumer-capture (= (bl-invoke newest (list 9)) 116))
     (linked-proof-check 'old-consumer-after-new-consumer (= (bl-invoke answer-consumer-first '()) 99))
     (linked-proof-check 'consumer-revisions-distinct (not (eq? answer-consumer-first answer-consumer-second)))
     (##gc)
     (linked-proof-check 'held-capture-after-all-gc (= (bl-invoke held (list 9)) 16))
     (linked-proof-check 'second-consumer-after-gc (= (bl-invoke answer-consumer-second '()) 99))))))
 (if (not (= linked-proof-checks 36)) (error "native linked probe count differs" linked-proof-checks))
 (display "NATIVE_LINKED_MODULE_PROOF_PASS 36\n") (force-output) (exit 0))
(with-exception-catcher
 (lambda (failure) (display-exception failure) (newline) (exit 1)) linked-proof-run)
;; The ORIGINAL owned bundle DATA follows; exit above prevents macro boot.
