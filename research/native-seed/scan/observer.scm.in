;; Observation only: scan, fallback, reader/compiler/emitter are actual native BL.
(define scan-original (bench-select "reader" "skip-pos"))
(define scan-checks 0)
(define scan-baseline-root #f)
(define scan-candidate-root #f)
(define scan-candidate #f)
(define scan-guard #f)
(define (scan-check label value)
 (if (not value) (error "scan experiment failed" label))
 (set! scan-checks (+ scan-checks 1)))
(define (scan-select candidate?)
 (if (not (and (scan-guard)
              (or (eq? native-global-registry scan-baseline-root)
                  (eq? native-global-registry scan-candidate-root))))
  (error "scan compiler world or primitive changed"))
 (set! native-global-registry (if candidate? scan-candidate-root scan-baseline-root)))
(define (scan-result helper chars pos)
 (with-exception-catcher
  (lambda (e) (bl-tuple (list (bl-key "error") (native-exception-reason e))))
  (lambda () (bl-tuple (list (bl-key "ok") (bl-invoke helper (list chars pos)))))))
(define (scan-pair helper chars pos)
 (let ((a (scan-result scan-original chars pos)) (b (scan-result helper chars pos)))
  (if (not (bl-equal? a b))
   (begin (display "SCAN_DIFFERENCE ") (write chars) (display " ") (write pos) (newline)
    (write a) (newline) (write b) (newline)))
  (scan-check 'scan-value-differential (bl-equal? a b))
  (if (and (eq? (bl-nth a 0) (bl-key "ok"))
           (not (eq? (bl-nth (bl-nth a 1) 0) (bl-nth (bl-nth b 1) 0))))
   (begin (display "SCAN_SUFFIX ") (write chars) (newline) (write a) (newline) (write b) (newline)))
  (if (eq? (bl-nth a 0) (bl-key "ok"))
   (scan-check 'same-unconsumed-suffix (eq? (bl-nth (bl-nth a 1) 0) (bl-nth (bl-nth b 1) 0))))))
(define (scan-charlist text) (map char->integer (string->list text)))
(define (scan-cases depth)
 (if (= depth 0) (list '())
  (cons '() (apply append (map (lambda (c) (map (lambda (tail) (cons c tail)) (scan-cases (- depth 1)))) '(32 9 10 13 44 59 65))))))
(define (scan-read-result source)
 (with-exception-catcher
  (lambda (e) (bl-tuple (list (bl-key "error") (native-exception-reason e))))
  (lambda () (bl-tuple (list (bl-key "ok") (bl-invoke bench-reader (list source bench-attribution)))))))
(define (scan-sample phase label selected batch)
 (scan-select selected)
 (let ((action (if (string=? phase "read") bench-parse
                 (lambda () (bench-emit-nodes (bench-compile-forms (bench-parse)))))))
  (bench-repeat 3 action)
  (##get-monotonic-time! bench-clock 1)
  (bench-repeat 5 action)
  (##get-monotonic-time! bench-clock 2)
  (display "CUTOVER_TIMING\t") (display phase) (display "\t") (display label)
  (display "\t") (write batch) (display "\t5\t")
  (write (exact->inexact (/ (- (u64vector-ref bench-clock 2) (u64vector-ref bench-clock 1)) bench-clock-frequency)))
  (newline) (force-output)))
(define (scan-count label selected)
 (scan-select selected)
 (let ((remote native-remote) (matcher bl-match-args) (calls 0) (matches 0))
  (dynamic-wind
   (lambda ()
    (set! native-remote (lambda (key) (set! calls (+ calls 1)) (remote key)))
    (set! bl-match-args (lambda (p v e) (set! matches (+ matches 1)) (matcher p v e))))
   bench-parse
   (lambda () (set! native-remote remote) (set! bl-match-args matcher)))
  (display "CUTOVER_COUNTS\t") (display label) (display "\t") (write calls)
  (display "\t") (write matches) (newline)))
(define (scan-run)
 (native-mark-host-callable! bench-no-eval)
 (bl-register-callable! bench-no-eval 1)
 (set! native-leaf-registry (bl-assoc native-leaf-registry "host/eval-scheme/1" bench-no-eval))
 (set! native-eval-string bench-no-eval)
 (load @CANDIDATE_MODULE@)
 (let ((initializer (linked-proof-binding @CANDIDATE_INITIALIZER@)))
  (bench-check-native initializer) (bl-invoke initializer '()))
 (set! scan-guard (linked-proof-binding @CANDIDATE_CHECK@))
 (bench-check-native scan-guard)
 (let* ((factory (bench-select @NAMESPACE@ "make-helper"))
        (parents (linked-proof-parents '@CANDIDATE_PHYSICAL@ linked-proof-existing-parents))
        (pos (bl-tuple (list 1 1 "scan.bl" 0)))
        (fallback-count 0)
        (fallback (lambda (chars pos)
                   (set! fallback-count (+ fallback-count 1))
                   (bl-invoke scan-original (list chars pos))))
        (observed (bl-invoke factory (list fallback))))
  (set! scan-candidate (bl-invoke factory (list scan-original)))
  (scan-check 'compiled-candidate-owner (memq (linked-proof-parent scan-candidate) parents))
  (set! scan-baseline-root native-global-registry)
  (native-register! "reader" "skip-pos" scan-candidate)
  (set! scan-candidate-root native-global-registry)
  (scan-select #f)
  (for-each (lambda (chars) (scan-pair scan-candidate chars pos)) (scan-cases 3))
  (for-each (lambda (text)
   (for-each (lambda (position) (scan-pair scan-candidate (scan-charlist text) position))
    (list pos (bl-tuple (list -3 -4 bl-nil -5))
     (bl-tuple (list 1000000000000000000000000000000000000 1000000000000000000000000000000000000
                (bl-key "opaque-file") 1000000000000000000000000000000000000)))))
   '(";" ";comment" ";comment\n" ";\r\n ;λΩ\n  token" "\t\r\n, x" "λ" ""))
  (for-each (lambda (chars) (scan-pair observed chars pos))
   (list (list (bl-float 32.0) 65) (list (bl-decimal 10 0) 65)
         (list 59 (bl-key "inside-comment") 10 65) (cons 32 7) bl-nil (bl-vec '(32 65))))
  (scan-pair observed '(32 65) (bl-tuple (list (bl-float 1.0) 1 "scan.bl" 0)))
  (scan-check 'fallback-exercised (> fallback-count 0))
  (for-each (lambda (text)
   (scan-select #f)
   (let ((reference (scan-read-result text)))
    (scan-select #t)
    (scan-check 'full-reader-parity (bl-equal? reference (scan-read-result text)))))
   (list bench-source "" "  ;comment\n (a [1 2] {:x 3})" ";λΩ\r\nλ" "(\n" " ;x\n[" ";eof" "(]" "\"unterminated"))
  (scan-select #f)
  (let ((root native-global-registry) (leaves native-leaf-registry))
   (dynamic-wind
    (lambda () (set! native-leaf-registry (bl-assoc leaves @GUARD_KEY@ bench-no-eval)))
    (lambda ()
     (scan-check 'changed-primitive-refused
      (with-exception-catcher (lambda (e) #t) (lambda () (scan-select #t) #f)))
     (scan-check 'refusal-preserves-root (eq? root native-global-registry)))
    (lambda () (set! native-leaf-registry leaves))))
  (scan-count "reference" #f) (scan-count "candidate" #t)
  (for-each (lambda (phase)
   (let loop ((batch 0))
    (if (< batch 5)
     (begin
      (if (even? batch)
       (begin (scan-sample phase "reference" #f batch) (scan-sample phase "candidate" #t batch))
       (begin (scan-sample phase "candidate" #t batch) (scan-sample phase "reference" #f batch)))
      (loop (+ batch 1)))))) '("read" "pipeline"))
  (for-each (lambda (selected label)
   (scan-select selected) (display "CUTOVER_ALLOCATION ") (display label) (newline) (force-output)
   (time (bench-repeat 5 bench-parse))) '(#f #t) '("reference" "candidate"))
  (scan-select #f)
  (let ((reference (bench-emit-nodes (bench-compile-forms (bench-parse)))))
   (scan-select #t)
   (let ((candidate (bench-emit-nodes (bench-compile-forms (bench-parse)))))
    (scan-check 'full-pipeline-byte-parity (equal? reference candidate))
    (native-write-file (string-append @OUTPUT@ "/reference.txt") (object->string reference))
    (native-write-file (string-append @OUTPUT@ "/candidate.txt") (object->string candidate))))
  (scan-select #f)
  (##gc)
  (scan-check 'rollback (eq? (native-global-exact "reader" "skip-pos") scan-original))
  (scan-pair scan-candidate (scan-charlist " ;after GC\n x") pos)
  (display "CUTOVER_CHECKS ") (write scan-checks) (newline)
  (display "CUTOVER_PASS\n") (force-output) (exit 0)))
(with-exception-catcher
 (lambda (e) (if scan-baseline-root (set! native-global-registry scan-baseline-root))
  (display-exception e) (newline) (exit 1)) scan-run)
