; Closed serial reader experiment. Public inputs outside this guarded domain
; use the original captured implementation with the ORIGINAL arguments.
(ns native.scan-kernel)
(defn make-helper [fallback]
 (fn [chars pos]
  (if (erlang/is_tuple pos)
   (if (erlang/== (erlang/tuple_size pos) 4)
    (let [line0 (erlang/element 1 pos) col0 (erlang/element 2 pos)
          file (erlang/element 3 pos) off0 (erlang/element 4 pos)]
     (if (erlang/is_integer line0)
      (if (erlang/is_integer col0)
       (if (erlang/is_integer off0)
        (loop [rem chars line line0 col col0 off off0 comment false]
         (if (erlang/is_integer line)
          (if (erlang/is_integer col)
           (if (erlang/is_integer off)
         (if (erlang/=:= rem ())
          [rem (erlang/list_to_tuple (list line col file off))]
          (if (erlang/is_list rem)
           (let [c (erlang/hd rem)]
            (if (erlang/is_integer c)
             (if comment
              (if (erlang/== c 10)
               (recur (erlang/tl rem) (erlang/+ line 1) 1 (erlang/+ off 1) false)
               (recur (erlang/tl rem) line (erlang/+ col 1) (erlang/+ off 1) true))
              (if (erlang/== c 59)
               (recur (erlang/tl rem) line (erlang/+ col 1) (erlang/+ off 1) true)
               (if (or (erlang/== c 32) (erlang/== c 9) (erlang/== c 10)
                       (erlang/== c 13) (erlang/== c 44))
                (if (erlang/== c 10)
                 (recur (erlang/tl rem) (erlang/+ line 1) 1 (erlang/+ off 1) false)
                 (recur (erlang/tl rem) line (erlang/+ col 1) (erlang/+ off 1) false))
                [rem (erlang/list_to_tuple (list line col file off))])))
             (fallback chars pos)))
           (fallback chars pos)))
           (fallback chars pos))
          (fallback chars pos))
         (fallback chars pos)))
        (fallback chars pos))
       (fallback chars pos))
      (fallback chars pos)))
    (fallback chars pos))
   (fallback chars pos))))
