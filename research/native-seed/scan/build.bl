; One small Source module through the existing AOT/unit-store/native transport.
(ns native.scan-build
 (:require [native.aot-target :as target] [native.aot-scheme :as emitter]
           [unit-store :as store] [bl.json :as json] [codebase] [reader] [reader-node :as rn]))
(def output (Path/expand (first (BeamLisp/argv))))
(assert (not (File/exists? output)))
(File/mkdir_p! output)
(def source (Path/expand "research/native-seed/scan/kernel.bl"))
(def namespace 'native.scan-kernel)
(def adapter (target/adapter {:prototype "research/native-seed" :python (System/find_executable "python3")
 :compiler-image? true :emission-mode :scan-v1
 :observations (Path/join output "tools") :object-cache (Path/join output "objects")}))
(def workspace (BeamLisp.AOT/open_workspace {:version 2 :phase-imports (list 'core 'sugar)
 :sources (list {:namespace namespace :file source})} {}))
(try
 (let [prepared (BeamLisp.AOT/prepare_unit workspace namespace)
       preview (emitter/emit-prepared prepared {:unit-id "scan-preview" :emission-mode :scan-v1
                  :source-frames? false :external-mfas (set (get (:identity adapter) "external_mfas"))})
       counts (:emission-counts preview)
       _ (File/write! (Path/join output "preview.scm") (:scheme preview))
       _ (File/write! (Path/join output "preflight.json") (json/encode
           {:emission-counts counts :source-sha256 (target/sha (File/read! source))
            :scheme-sha256 (target/sha (:scheme preview)) :compiled-yet false}))
       ; Stop BEFORE C if the intended loop/comparisons have not disappeared.
       _ (assert (pos? (get counts :direct-loops 0)) (pr-str counts))
       _ (assert (>= (get counts :integer-intrinsics 0) 15) (pr-str counts))
       _ (println "SCAN_PREFLIGHT" (pr-str counts))
       built (store/artifact-target! prepared (Path/join output "artifacts") nil adapter)
       unit (Path/join (Path/join output "artifacts") (:key built))
       pin (json/decode (File/read! "research/native-seed/sdk-pin.json"))
       reader-file (Path/join (get pin "source") "priv/boot/reader.bl")
       reader-source (File/read! reader-file)
       forms (reader/read-syntax reader-source reader-file)
       facts (codebase/index-forms {} "reader" forms nil {:mode :calls})
       names #{"skip-pos" "skip-ignored" "skip-comment" "advance-to"}
       rows (mapv (fn [form] {:name (codebase/defn-form form) :position (rn/node-pos form)})
                    (filter #(contains? names (codebase/defn-form %)) forms))
       _ (assert (= 4 (count rows)))
       _ (assert (every? (fn [name] (some #(= name (:fn/name %)) (:fn facts))) names))]
  (File/write! (Path/join output "module.json") (json/encode
   {:schema "bl.native.scan-module" :namespace "native.scan-kernel" :directory unit
    :selection-key (target/selection-key (:selection built))
    :request (first (Path/wildcard (Path/join output "tools/identity-*-request.json")))
    :source {:path source :sha256 (target/sha (File/read! source))}
    :original {:path reader-file :sha256 (target/sha reader-source) :definitions rows}
    :emission-counts counts :compiled (:compiled built)}))
  (println "SCAN_MODULE_BUILT"))
 (catch e (println "SCAN_ERROR_DATA" (pr-str (ex-data e))) (throw e))
 (finally (BeamLisp.AOT/close_workspace! workspace)))
