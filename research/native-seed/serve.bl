; Live development host: the working Org file, connected source cards and the
; shared owner-authenticated review writer. The listener stays on loopback.
(ns native.serve
 (:require [web] [live.hiccup :as h] [bl.json :as json]
           [dossier.org :as org] [dossier.page :as page] [dossier.notebook :as notebook]
           [dossier.feedback :as feedback] [dossier.review.http :as comments]
           [dossier.share.assets :as assets] [codebase-review.blocks :as cards]))

(def path (Path/expand (or (first (BeamLisp/argv)) "research/native-seed/native-seed.bl.org")))
(def kit (Path/expand "~/projects/enchanted-skills/bl-org-dossier/kit"))
(def review-kit (Path/expand "~/projects/enchanted-skills/codebase-review/kit"))
(when (blank? (System/get_env "DOSSIER_OWNER"))
 (throw (ex-info "Live dossier requires DOSSIER_OWNER in its private service environment" {})))
(defn owner? [request]
 (= (System/get_env "DOSSIER_OWNER") (web/req-header request "tailscale-user-login")))
(defn document [text]
 (cards/enrich (notebook/with-imports (org/read-doc text) (Path/dirname path))))
(defn revision [text] (str (erlang/phash2 (comments/content-source text))))
(def css (str (File/read! (str kit "/style.css"))
              (File/read! (str review-kit "/review.css")) "\n.tally{display:none!important}"))
(def javascript (File/read! (str kit "/live.js")))
(def fonts (assets/fonts))
(defn handler [request]
 (or (comments/route request path)
  (let [route (web/path request) text (File/read! path)]
   (cond
    (and (= "get" (web/method request)) (get fonts route))
      (let [font (get fonts route)] (web/bytes request (:type font) (File/read! (:path font))))
    (= route "/") (web/html request (str "<!doctype html>" (h/hiccup->html (page/page-h (document text) css javascript))))
    (= route "/rev") (web/json request {:rev (revision text)})
    (= route "/doc") (web/json request {:rev (revision text) :html (join "" (map h/hiccup->html (page/doc-h (document text))))})
    (= route "/src") (web/text request text)
    (= route "/answers") (web/json request (vec (page/feedback-items (document text))))
    (and (= route "/answer") (= "post" (web/method request)))
      (if-not (owner? request) (web/json request 403 {:error "Only the dossier owner may answer"})
       (let [read (web/read-body-limited* request 16384 10000)]
        (if (:error read) (web/json (:conn read) 413 {:error "Answer too large"})
         (let [result (feedback/submit! path (or (System/get_env "DOSSIER_HANDLE") "owner") (:body read))]
          (web/json (:conn read) (:status result) (:body result))))))
    :else (web/text request 404 "Not found")))))

; Load the render graph before the server pins callback code.
(page/page-h (document (File/read! path)) css javascript)
(def port (erlang/binary_to_integer (or (System/get_env "PORT") "4072")))
(web/serve {:port port :ip (tuple 127 0 0 1) :plug handler :log :off})
(println (str "native BL dev review: " path " at http://127.0.0.1:" port "/"))
