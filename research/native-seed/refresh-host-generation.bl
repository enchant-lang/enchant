; SDK-only orchestration: reuse checked emission jobs, then replay exact actors.
; Canonical producers own all Source/ANF/hash/bounds checks and output policy.
(ns native.refresh-host-generation)
(def args (BeamLisp/argv))
(assert (= 3 (count args)))
(def directory (first args))
(def original-actors (second args))
(def actor-output (nth args 2))
(defn request [path arguments]
 (BeamLisp.Env/isolated
  (fn [] (BeamLisp/with_argv (to-list arguments) (fn [] (BeamLisp/run_file path))))))
(request "research/native-seed/src/native/chunks.bl"
 ["build-next" (str directory "/partition.json") (str directory "/host.scm")
  directory (str directory "/leaves.json")])
(if (File/regular? (str directory "/prelude.scm"))
 (request "research/native-seed/corpus/replay.bl" [original-actors directory actor-output])
 (println "NATIVE_HOST_GENERATION_YIELD resume after checkpoint"))
