; ONE invocation through research/native-seed/run: reuse the immutable SDK,
; checked compiler closure, and already-qualified production JS graph.
(ns native.prepare-values-parity
 (:require [native.proc-link :as linker] [native.artifact :as artifact]
           [js.actor :as actor] [bl.json :as json]))
(def base "research/native-seed")
(def args (BeamLisp/argv))
(def closure (or (first args) (str base "/out/compiler-closure")))
(def out (or (second args) (str base "/out/values-parity")))
(def js-parent (or (nth args 2 nil) (str base "/out/original-actor-js/manifest.json")))
(def app (str base "/fixtures/values-parity.bl"))
(def witness (str base "/values/values-witness.scm"))
(def source (File/read! app))
(def source-sha (linker/digest source))
(when-not (= "f073dfeee16d6078bc4c50bcdd23b7c98d1432153df56c6d9bec049f6e0e3e7a" source-sha)
 (throw (ex-info "values parity requires the exact shared Source fixture" {})))
(def pin (json/decode (File/read! (str base "/sdk-pin.json"))))
; artifact/validation-context checks BL_SDK_PRODUCT against the immutable SDK
; descriptor before this module evaluates any application Source.
(assert (= (get pin "descriptor_sha256") (:sdk-descriptor-sha256 artifact/validation-context)))
(File/mkdir_p! out)
(when (File/exists? (str out "/manifest.json")) (File/rm! (str out "/manifest.json")))
(def beam-lines
 (BeamLisp.Env/isolated (fn []
  (BeamLisp.Compiler/eval_string source
    (assoc (BeamLisp.Compiler/new_env "native.values-parity") :target :beam) app)
  ((BeamLisp.Env/fetch_exact! "native.values-parity" "parity-lines")))))
(assert (= 377 (count beam-lines)))
(assert (every? string? beam-lines))
(File/write! (str out "/beam.json")
 (json/encode {:schema "bl.native.values-beam-oracle" :version 1 :status :executed
  :target :beam :sdk-pin pin :vm-pid (System/pid) :application (linker/source-identity app)
  :compiler :canonical-Compiler.eval_string :compiler-target :beam
  :otp (erlang/list_to_binary (erlang/system_info :otp_release))
  :rows beam-lines :observation-count (count beam-lines)}))
; Reuse only the existing graph whose immutable inputs/assets still match.
(def parent (json/decode (File/read! js-parent)))
(def parent-proof-path (str base "/evidence/original-actor-corpus/qualification.json"))
(def parent-proof (json/decode (File/read! parent-proof-path)))
(assert (= "bl.native.original-actor-qualification" (get parent-proof "schema")))
(assert (= "pass" (get parent-proof "status")))
(assert (= pin (get parent-proof "sdk")))
(assert (= (linker/digest (File/read! js-parent))
           (get (get parent-proof "inputs") (Path/expand js-parent))))
; Exact ORIGINAL finite BEAM oracle literals. The source hashes make this a
; checked packaging operation, not a general JavaScript parser or policy port.
(def original-oracles
 [{:family "lifecycle" :path "research/js-actors/verify-lifecycle.mjs" :binding "BEAM_PARITY" :source-sha256 "6a91affd9b08f795d272d4b4816e5bdead75a44b55ffaaa185ca52b0a206dced" :raw-sha256 "3af42bd8b1824e71c455dec83a91ea3bcfc3dc7f372236bc32ebf898d80658d7" :code-sha256 "3af42bd8b1824e71c455dec83a91ea3bcfc3dc7f372236bc32ebf898d80658d7"}
  {:family "names" :path "research/js-actors/verify-names.mjs" :binding "BEAM_NAMES" :source-sha256 "7b97da69fbcfc815d9f1ae7a52954c1533dbbadd17e587ee2198b9629a2b3137" :raw-sha256 "57178288839edfe5947b7a6d4dd0ca80ac6b5e5e4e8db1b18156a46d128a41ed" :code-sha256 "57178288839edfe5947b7a6d4dd0ca80ac6b5e5e4e8db1b18156a46d128a41ed"}
  {:family "tables" :path "research/js-actors/verify-tables.mjs" :binding "BEAM_TABLES" :source-sha256 "4a3b7ba2f4afdc977e8de27f2fc440d439d4253a5aa03a267f98d218ea6fc080" :raw-sha256 "f935826c83f777d48266f8862631f44d454fdd306dab57af2c9f873f2a47e69b" :code-sha256 "f935826c83f777d48266f8862631f44d454fdd306dab57af2c9f873f2a47e69b"}
  {:family "supervision" :path "research/js-actors/verify-supervision.mjs" :binding "BEAM_SUPERVISION" :source-sha256 "8f6a4a70c7fc7ec2dae99f56bbe5d0f227fb8e8f9878dcffd100cba5e0126bee" :raw-sha256 "d93b6ec0f66a32d4f5d8e0d30659bca827d6d2ab3cfd38396e37056cfa51a352" :code-sha256 "547c2b1cabd71deb8f62f707d0365bf5cfafa8cff5f9ec3edaec6cb03e1d0fb8"}])
(defn run-original-oracle [spec]
 (let [source (File/read! (:path spec))
       _ (assert (= (:source-sha256 spec) (linker/digest source)))
       marker (str "const " (:binding spec) " = `")
       parts (String/split source marker)
       _ (assert (= 2 (count parts)))
       remainder (second parts) found (binary/match remainder "`;")
       _ (assert (erlang/is_tuple found))
       raw (binary/part remainder 0 (elem found 0))
       _ (assert (= (:raw-sha256 spec) (linker/digest raw)))
       _ (assert (not (String/contains? raw "${")))
       ; These four exact literals contain only one escaped run: the four
       ; JS backslashes encoding two Elixir default-argument backslashes.
       code (String/replace raw "\\\\" "\\")
       _ (assert (= (:code-sha256 spec) (linker/digest code)))
       directory (str out "/beam-oracles")
       _ (File/mkdir_p! directory)
       code-path (str directory "/" (:family spec) ".exs")
       _ (File/write! code-path code)
       capture-open (StringIO/open "")
       _ (assert (= :ok (elem capture-open 0))) capture (elem capture-open 1)
       task (Task/async (fn []
        (Process/group_leader (erlang/self) capture)
        (Code/eval_string code (list) (list (tuple :file (:path spec))))
        :original-oracle-evaluated))
       _ (assert (= :original-oracle-evaluated (Task/await task 120000)))
       output (elem (StringIO/contents capture) 1)
       _ (StringIO/close capture)
       output-path (str directory "/" (:family spec) ".log")
       _ (File/write! output-path output)
       _ (assert (= (:source-sha256 spec) (linker/digest (File/read! (:path spec)))))]
  {:family (:family spec) :binding (:binding spec) :status :executed
   :source (linker/source-identity (:path spec)) :raw-sha256 (:raw-sha256 spec)
   :code (linker/source-identity code-path) :output (linker/source-identity output-path)
   :execution :Elixir.Code.eval_string :template-transport :original-JS-cooked-literal
   :timeout-ms 120000}))
; Sequential tasks isolate trap_exit/group-leader state. This is the same
; one-shot capped SDK VM: the launcher retires it and remaining oracle children.
(def beam-actor-oracles (mapv run-original-oracle original-oracles))
(def retained-actor-logs
 (vec (for [role ["native" "javascript"] budget ["default" "17" "41"]]
  (let [path (str (Path/dirname parent-proof-path) "/" role "-" budget ".log")
        bytes (File/read! path) expected (get (get parent-proof "logs") (Path/expand path))]
   (assert (= (get expected "sha256") (linker/digest bytes)))
   (assert (= (get expected "bytes") (erlang/byte_size bytes)))
   {:role role :budget budget :log (linker/source-identity path)}))))
(File/write! (str out "/actor-oracles.json")
 (json/encode {:schema "bl.native.original-beam-actor-oracles" :version 1 :status :executed
  :sdk-pin pin :vm-pid (System/pid) :otp (erlang/list_to_binary (erlang/system_info :otp_release))
  :actor-receipt (linker/source-identity parent-proof-path)
  :application (linker/source-identity "research/js-actors/test.bl")
  :runtime (linker/source-identity "priv/lib/js/actor/runtime.bl")
  :oracles beam-actor-oracles :retained-actor-logs retained-actor-logs
  :policy-adaptation :none :optional-oracles false :path-elixir false
  :cancellation-scope [:explicit-and-linked-process-kill :bounded-GenServer.call-exit]
  :standalone-timer-cancellation-oracle false}))

(assert (= "bl.native.original-actor-corpus" (get parent "schema")))
(assert (= "javascript" (get parent "target")))
(assert (= pin (get parent "sdk-pin")))
(doseq [row (concat (get parent "inputs") (get parent "assets"))]
 (assert (= (get row "sha256") (linker/digest (File/read! (get row "path"))))))
(def graph (Path/expand (str (Path/dirname js-parent) "/canonical")))
(def js-out (str out "/javascript"))
(actor/write-runtime! js-out (str graph "/rt.mjs"))
(actor/build-one js-out "values-parity.bl" "bundle.mjs" []
 {:source-root (str base "/fixtures") :native-manifest (str graph "/native-modules.json")
  :native-base graph})
(def js-assets (vec (sort (Path/wildcard (str js-out "/**/*.mjs")))))
(def result (linker/build-project
 {:application app :runtime "priv/lib/js/actor/runtime.bl"
  :bridges (str base "/bridges.bl") :links (str base "/actor-links.edn")
  :sdk-pin (str base "/sdk-pin.json") :host-link (str base "/host/host-proc-link.scm")
  :prelude (str closure "/prelude.scm") :closure-manifest (str closure "/partition.json")
  :leaves (str closure "/leaves.json") :helper-namespaces [] :host-extensions [witness]
  :source-frames? false}))
(assert (= 202 (get-in result [:manifest :runtime-definitions])))
(def program (str (:program result) "\n(native-values-finish)\n"))
(def prelude (File/read! (str closure "/prelude.scm")))
(def host (str closure "/host.scm"))
(assert (String/starts_with? prelude
 (str ";; BL native compiler. Generated from canonical BL source.\n" (File/read! host) "\n")))
(assert (String/starts_with? program (str prelude "\n")))
(File/write! (str out "/program.scm") program)
(File/write! (str out "/link.json") (json/encode (:manifest result)))
; Bind output and Source provenance in one small receipt. No compiler rebuild,
; new SDK, numeric host oracle, assertion adaptation, or Source rewriting.
(assert (= source-sha (linker/digest (File/read! app))))
(File/write! (str out "/manifest.json")
 (json/encode {:schema "bl.native.values-parity" :version 1 :status :prepared-not-executed
  :sdk-pin pin :application (linker/source-identity app) :observation-count 377
  :assertion-adaptation :none :source-path-adaptation :none :source-interpreter false
  :beam (linker/source-identity (str out "/beam.json"))
  :actor-oracles (linker/source-identity (str out "/actor-oracles.json"))
  :javascript {:parent (linker/source-identity js-parent)
               :qualification (linker/source-identity parent-proof-path)
               :artifact (linker/source-identity (str js-out "/out/bundle.mjs"))
               :assets (mapv linker/source-identity js-assets)}
  :native {:program (linker/source-identity (str out "/program.scm"))
           :host (linker/source-identity host) :prelude (linker/source-identity (str closure "/prelude.scm"))
           :link (linker/source-identity (str out "/link.json"))}
  :inputs (mapv linker/source-identity
   [app witness (str base "/values/prepare.bl") (str base "/values/qualify.py")
    (str base "/sdk-pin.json") (str base "/toolchain-pin.json")
    (str base "/src/native/proc-link.bl") (str base "/src/native/proc.bl")
    (str base "/src/native/artifact.bl") (str base "/src/native/scheme.bl")
    "priv/lib/js/actor.bl" "priv/lib/js/actor/host.mjs" "priv/lib/js/actor/module.mjs"
    "priv/lib/js/emit.bl" "priv/boot/core.bl" "priv/boot/rt.bl"
    "test/bl/numeric_equality_test.bl" "research/js-actors/numeric-values.bl"])}))
(println "VALUES_PARITY_PREPARED beam-values=377 original-BEAM-actor-oracles=4 retained-native-JS-logs=6 SDK-builds=0")
