; Card N2, native side: descriptor ETF in, Core ETF out, through the real
; lower namespace on Chez. The native eval file is the concatenation
;   priv/boot/lower-core.bl priv/boot/lower.bl THIS OUT/jobs.bl
; where dump.bl writes OUT/jobs.bl as one (run-jobs [[IN OUT] ...]) form
; (the native host has no argv or directory listing for eval files).
;
;   qualify.bl -- eval --image IMG --file F.bl
(ns native-beam.lower
 (:require [lower :as lower]))

(defn- job [[in out]]
 (println (str "JOB start " in))
 (try
  (let [descriptor (erlang/binary_to_term (host/read-bytes in))
        core (lower/module->core descriptor)]
   (host/write-bytes out (erlang/term_to_binary core))
   (println (str "JOB ok " in)))
  (catch e (println (str "JOB fail " in " " (pr-str e))))))

(defn run-jobs [jobs]
 (doseq [j jobs] (job j))
 (println (str "JOBS-DONE " (count jobs))))
