;; Seed ABI: exact integers, tagged values, persistent association maps and
;; one-shot continuations. Association maps are intentionally not production HAMTs.
;; The clock is VIRTUAL. OS readiness, real monotonic time and blocking FFI
;; are later qualification gates, not claims made by this host.
(define bl-nil (vector 'nil))
(define (bl-is-nil x) (eq? x bl-nil))
(define (bl-key s) (string->symbol (string-append ":" s)))
(define (bl-truthy x) (and (not (bl-is-nil x)) (not (eq? x #f))))
(define (bl-not x) (not (bl-truthy x)))
(define (bl-tag? x tag) (and (vector? x) (= (vector-length x) 2) (eq? (vector-ref x 0) tag)))
(define (bl-vec xs) (vector 'vec (list->vector xs)))
(define (bl-tuple xs) (vector 'tuple (list->vector xs)))
(define (bl-make-vec . xs) (bl-vec xs))
(define (bl-make-tuple . xs) (bl-tuple xs))
(define (bl-items v) (vector->list (vector-ref v 1)))
(define (bl-empty-map) (vector 'map '()))
(define (bl-map . xs)
 (if (null? xs) (bl-empty-map)
  (bl-assoc (apply bl-map (cddr xs)) (car xs) (cadr xs))))
(define (bl-get m k . d)
 (let ((entry (and (bl-tag? m 'map) (assoc k (vector-ref m 1)))))
  (if entry (cdr entry) (if (null? d) bl-nil (car d)))))
(define (bl-remove-key entries k)
 (cond ((null? entries) '()) ((equal? k (caar entries)) (cdr entries))
       (else (cons (car entries) (bl-remove-key (cdr entries) k)))))
(define (bl-assoc m k v)
 (vector 'map (cons (cons k v) (bl-remove-key (if (bl-tag? m 'map) (vector-ref m 1) '()) k))))
(define (bl-nth v n) (if (list? v) (list-ref v n) (vector-ref (vector-ref v 1) n)))
(define (bl-conj v x)
 (if (bl-tag? v 'vec) (bl-vec (append (bl-items v) (list x))) (cons x v)))
(define (bl-first x) (if (null? x) bl-nil (car x)))
(define (bl-rest x) (if (null? x) '() (cdr x)))
(define (bl-count x)
 (cond ((bl-is-nil x) 0) ((bl-tag? x 'map) (length (vector-ref x 1)))
       ((vector? x) (vector-length (vector-ref x 1))) ((string? x) (string-length x))
       (else (length x))))
(define (bl-empty x) (= (bl-count x) 0))
(define (bl-inc x) (+ x 1))
(define (bl-dec x) (- x 1))
(define (bl-div a b) (if (= (remainder a b) 0) (quotient a b) (error "seed decimal division unsupported")))
(define (bl-show x) (cond ((string? x) x) ((symbol? x) (symbol->string x))
                         ((number? x) (number->string x)) (else "<value>")))
(define (bl-str . xs) (apply string-append (map bl-show xs)))
(define (bl-str-v xs) (apply bl-str xs))
(define (bl-list-v xs) xs)
(define (bl-key-value x) x)
(define (bl-invoke f xs)
 (cond ((procedure? f) (apply f xs)) ((symbol? f) (apply bl-get (cons (car xs) (cons f (cdr xs)))))
       ((bl-tag? f 'map) (apply bl-get (cons f xs)))
       (else (error "native seed: unsupported callable"))))

;; Pattern matching returns #f or a binding alist; empty alists are successful.
(define (bl-match p v env)
 (and env
  (case (car p)
   ((var) (let ((old (assoc (cadr p) env)))
            (if old (and (equal? (cdr old) v) env) (cons (cons (cadr p) v) env))))
   ((lit) (and (equal? (cadr p) v) env))
   ((nil) (and (null? v) env))
   ((tuple) (and (bl-tag? v 'tuple) (bl-match-args (cadr p) (bl-items v) env)))
   ((vector) (and (bl-tag? v 'vec) (bl-match (cadr p) (bl-tuple (bl-items v)) env)))
   ((cons) (and (pair? v) (bl-match (caddr p) (cdr v) (bl-match (cadr p) (car v) env))))
   ((alias) (bl-match (caddr p) v (bl-match (cadr p) v env)))
   ((map) (and (bl-tag? v 'map)
    (let loop ((ps (cadr p)) (b env))
     (if (or (not b) (null? ps)) b
      (let ((entry (assoc (caar ps) (vector-ref v 1))))
       (and entry (loop (cdr ps) (bl-match (cadar ps) (cdr entry) b))))))))
   (else (error "native seed: unknown pattern")))))
(define (bl-match-args ps vs env)
 (cond ((not env) #f) ((null? ps) (and (null? vs) env)) ((null? vs) #f)
       (else (bl-match-args (cdr ps) (cdr vs) (bl-match (car ps) (car vs) env)))))

(define seed-state (bl-map (bl-key "runtime") "native-seed-1"))
(define seed-self bl-nil)
(define seed-clock 0)
(define seed-critical 0)
(define seed-frame #f)
(define seed-return #f)
(define seed-budget 0)
(define seed-yields 0)
(define seed-errors '())
(define (h-state) seed-state)
(define (h-set-state s) (set! seed-state s) bl-nil)
(define (h-self) seed-self)
(define (h-set-self p) (set! seed-self p) bl-nil)
(define (h-critical-enter) (set! seed-critical (+ seed-critical 1)) bl-nil)
(define (h-critical-leave)
 (if (<= seed-critical 0) (error "unbalanced critical section"))
 (set! seed-critical (- seed-critical 1)) bl-nil)
(define (h-park status)
 (if (> seed-critical 0) (error "park inside critical section"))
 (call-with-current-continuation
  (lambda (k)
   (let ((spent #f))
    (vector-set! seed-frame 0
     (lambda () (if spent (error "continuation reused")) (set! spent #t) (k bl-nil)))
    (seed-return (bl-map (bl-key "status") (bl-key status)))))))
(define (h-park-release) (h-critical-leave) (h-park "park"))
(define (h-tick)
 (if seed-frame
  (begin (set! seed-budget (- seed-budget 1))
   (if (and (<= seed-budget 0) (= seed-critical 0))
    (begin (set! seed-yields (+ seed-yields 1)) (h-park "yield"))))))
(define (h-make-frames f args)
 (vector (lambda () (apply f args) (seed-return (bl-map (bl-key "status") (bl-key "done"))))))
(define (h-run-turn frame budget)
 (set! seed-frame frame) (set! seed-budget budget)
 (let ((result
  (call-with-current-continuation
   (lambda (return)
    (set! seed-return return)
    (with-exception-catcher
     (lambda (e) (seed-return (bl-map (bl-key "status") (bl-key "error") (bl-key "kind") (bl-key "error") (bl-key "reason") e)))
     (lambda () ((vector-ref frame 0)) (bl-map (bl-key "status") (bl-key "done"))))))))
  (set! seed-frame #f) (set! seed-return #f) (set! seed-critical 0) result))
(define (h-now) seed-clock)
(define (h-wait-input) (error "native seed: browser input unsupported"))
(define (h-wait-until ms input?)
 (if input? (h-wait-input)) (set! seed-clock (+ seed-clock ms)) bl-nil)
(define h-empty-map bl-empty-map)
(define (h-empty-list) '())
(define (h-map-remove m k) (vector 'map (bl-remove-key (vector-ref m 1) k)))
(define (h-map-keys m) (map car (vector-ref m 1)))
(define h-map-size bl-count)
(define h-vec-from-list bl-vec)
(define h-vec-size bl-count)
(define h-vec-el bl-nth)
(define (h-vec-remove v i)
 (let loop ((xs (bl-items v)) (n 0))
  (if (null? xs) (bl-vec '())
   (if (= n i) (bl-vec (cdr xs))
    (bl-vec (cons (car xs) (bl-items (loop (cdr xs) (+ n 1)))))))))
(define h-is-nil bl-is-nil)
(define h-is-kw symbol?)
(define (h-kw-name x) (substring (symbol->string x) 1 (string-length (symbol->string x))))
(define (h-is-int x) (and (integer? x) (exact? x)))
(define h-is-str string?)
(define (h-is-vec x) (bl-tag? x 'vec))
(define h-is-enil null?)
(define h-eq equal?)
(define h-lt <)
(define (h-arith op a b)
 (cond ((equal? op "add") (+ a b)) ((equal? op "sub") (- a b))
       ((equal? op "mul") (* a b)) (else (error "seed arithmetic unsupported"))))
(define (h-write s) (display s) (newline) bl-nil)
(define h-str-cat bl-str)
(define h-describe bl-show)
(define (h-raise reason) (raise reason))
(define (h-record-error e) (set! seed-errors (cons e seed-errors)) bl-nil)
(define h-truthy bl-truthy)
