; SDK-only fixture producer. Never loaded into the closed compiler image.
(ns native.direct-loader-produce
 (:require [compiler :as compiler] [native.c :as c] [native.c-remote :as remote]
           [native.eval :as ev] [native.bootstrap :as bootstrap] [bl.json :as json]))
(def output (or (first (BeamLisp/argv)) "research/native-seed/out/direct-loader-corpus"))
(def fixture "research/native-seed/direct/fixtures/loader-values.bl")
(defn sha [text] (Base/encode16 (crypto/hash :sha256 text) (list (tuple :case :lower))))
(def emitted
 (BeamLisp.Env/isolated (fn []
  (BeamLisp.Env/mark_loaded "native.loader")
  (BeamLisp.Env/intern "native.loader" "first-function" nil)
  (BeamLisp.Env/put_link "native.loader" "first-function" (tuple :erlang {} nil))
  (mapv (fn [[index form]]
   (compiler/reset-fresh!)
   (c/emit-unit (compiler/compile form (assoc (compiler/new-env "native.loader") :target :js :file fixture))
    (assoc (remote/options (ev/context "native.loader")) :unit-name (str "dynamic_loader_" index))))
   (map-indexed (fn [index form] [index form]) (BeamLisp.Ns.Reader/read (File/read! fixture) {:file fixture}))))))
(assert (= 3 (count emitted)))
(File/mkdir_p! output)
(def units
 (mapv (fn [[index unit]]
  (let [path (str output "/value" index ".data.scm") text (bootstrap/data unit)]
   (File/write! path text) {:path path :sha256 (sha text)}))
  (map-indexed (fn [index unit] [index unit]) emitted)))
(File/write! (str output "/manifest.json")
 (json/encode {:schema "bl.native.direct-loader-corpus" :version 1 :status :emitted-not-executed
               :fixture {:path fixture :sha256 (sha (File/read! fixture))} :units units
               :inputs (mapv (fn [path] {:path path :sha256 (sha (File/read! path))})
                ["research/native-seed/direct/loader-produce.bl" "research/native-seed/src/native/c.bl"
                 "research/native-seed/src/native/c-remote.bl" "research/native-seed/src/native/scheme.bl"
                 "research/native-seed/sdk-pin.json"])}))
(println "DIRECT_LOADER_CORPUS_EMITTED 3 canonical-source expressions")
