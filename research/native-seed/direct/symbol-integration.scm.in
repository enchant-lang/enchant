;; NEW COMPILED HOST ONLY. Fixed host dispatch diagnostic, no Source body eval.
;; An older image lacks these private globals and must fail, never install an
;; interpreted adapter. Original guarded bundle bytes follow but EXIT0 below
;; deliberately prevents macro bootstrap: this is NOT a Source qualification.
(define symbol-integration-checks 0)
(define (symbol-integration-check label ok)
 (if (not ok) (error "compiled symbolic MFA integration" label))
 (set! symbol-integration-checks (+ symbol-integration-checks 1)))
(define symbol-integration-mode native-c-symbol-remotes-enabled?)
(define symbol-integration-module
 (native-module-name (bl-get native-namespace-modules "rt")))
(define symbol-integration-list '(17 29))
(define symbol-integration-vector (bl-vec '(17 29)))
(define (symbol-integration-reference name arity)
 (native-c-remote (string-append symbol-integration-module "/" name "/" (number->string arity))))
(for-each
 (lambda (row)
  (let* ((name (car row)) (arity (cadr row)) (expected (caddr row))
         (key (string-append symbol-integration-module "/" name "/" (number->string arity)))
         (descriptor (native-c-remote key)) (legacy (native-c-parse-remote key))
         (target (native-c-remote-target descriptor)))
   (symbol-integration-check (list name 'factory-mode)
    (eq? (and (native-c-symbol-remote? descriptor) #t) (and symbol-integration-mode #t)))
   (symbol-integration-check (list name 'same-published-target)
    (eq? target (native-c-remote-target legacy)))
   (symbol-integration-check (list name 'actual-C-control) (native-c-closure? target))
   (for-each (lambda (value)
    (let* ((before native-c-step-count)
           (args (if (= arity 1) (list value) (list value 1)))
           (answer (bl-invoke descriptor args)))
     (symbol-integration-check (list name 'actual-result-and-C-steps)
      (and (equal? answer expected) (> native-c-step-count before)))))
    (list symbol-integration-list symbol-integration-vector))))
 '( ("k-first" 1 17) ("k-count" 1 2) ("k-nth" 2 29) ))
(let* ((iterations @ITERATIONS@)
       (descriptor (symbol-integration-reference "k-first" 1))
       (args (list symbol-integration-list))
       (before native-c-step-count) (start (time->seconds (current-time)))
       (checksum (let loop ((left iterations) (total 0))
                  (if (= left 0) total
                   (loop (- left 1) (+ total (bl-invoke descriptor args))))))
       (seconds (- (time->seconds (current-time)) start)))
 (symbol-integration-check 'fixed-work-checksum (= checksum (* iterations 17)))
 (symbol-integration-check 'fixed-work-actual-C-control
  (or (= iterations 0) (> native-c-step-count before)))
 (display "DIRECT_C_SYMBOL_MFA_FIXED_WORK ")
 (write (list (cons 'mode (if symbol-integration-mode 'symbols 'legacy))
              (cons 'iterations iterations) (cons 'checksum checksum)
              (cons 'seconds seconds) (cons 'C-steps (- native-c-step-count before))
              (cons 'tick-opt-in native-c-noactor-tick-enabled?)
              (cons 'pure-opt-in native-c-pure-bif-enabled?)
              (cons 'source-qualification #f)))
 (newline) (force-output))
(if (not (= symbol-integration-checks 17))
 (error "compiled symbolic MFA integration count" symbol-integration-checks))
(display "NATIVE_C_SYMBOL_MFA_INTEGRATION_PASS 17") (newline) (force-output)
(exit 0)
