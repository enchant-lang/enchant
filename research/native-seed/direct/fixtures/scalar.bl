; Direct ABI smoke independent of the actor runtime and canonical prelude.
(defn ds-check [label actual expected]
 (if (host/eq actual expected) (host/write (str "PASS " label))
  (host/raise (str "FAIL " label ": " (host/describe actual)))))
(defn ds-adder [x] (fn [y] (+ x y)))
(defn ds-tail [n sum] (if (= n 0) sum (ds-tail (- n 1) (+ sum n))))
(defn ds-apply-tail [n sum]
 (if (= n 0) sum (erlang/apply ds-apply-tail (list (- n 1) (+ sum n)))))
(defn ds-operand [label value]
 (host/write (str "SCALAR_ORDER " label)) value)
(defn ds-call-mark [label value]
 (host/write (str "SCALAR_CALL " label)) value)
(defn ds-call-raise [label]
 (host/write (str "SCALAR_CALL " label)) (erlang/throw label))
(defn ds-cross-arity ([x] (ds-cross-arity x 1)) ([x y] (+ x y)))
(defn ds-cross-variadic
 ([x] (if (< x 0) x (ds-cross-variadic x 2 3)))
 ([x y & more] (ds-cross-variadic (- 0 (+ (+ x y) (count more))))))
(defn ds-nested-cross
 ([x] ((fn inner-cross ([y] (inner-cross y 1))
          ([y z] (ds-nested-cross (+ y z) 2))) x))
 ([x y] (+ x y)))
; Retain different captured VALUES while every defining activation is retired
; by a tail edge. The scalar qualifier also reruns this exact Source under
; BL_NATIVE_C_GC_INTERVAL on both C and LLVM.
(defn ds-retain-frames [left saved]
 (if (= left 0) saved
  (let [captured left]
   (ds-retain-frames (- left 1) (cons (fn [delta] (+ captured delta)) saved)))))
(defn ds-check-retained-frames [saved expected]
 (if (empty? saved) expected
  (let [closure (first saved)]
   (if (= (closure 1000) (+ expected 1000))
    (ds-check-retained-frames (rest saved) (+ expected 1))
    (host/raise "retired tail frame changed a retained closure")))))
(declare ds-grow-frame)
(defn ds-shrink-frame [left saved]
 (if (= left 0) saved
  (ds-grow-frame (- left 1) saved left (+ left 10) [:payload left] (fn [] left))))
(defn ds-grow-frame [left saved a b payload held]
 (let [captured (fn [] [a b payload (held)])]
  (ds-shrink-frame left (cons captured saved))))
(defn ds-check-grown-frames [saved expected]
 (if (empty? saved) expected
  (if (= ((first saved)) [expected (+ expected 10) [:payload expected] expected])
   (ds-check-grown-frames (rest saved) (+ expected 1))
   (host/raise "cross-arity tail frame changed captured values"))))
(defn ds-protected-frame-parent [value]
 (let [marker [:caller value] held (fn [] marker)
       children (ds-shrink-frame 16 (list))]
  [marker (held) (count children)]))

(defn main []
 (let [f (ds-adder 7)]
  (ds-check "direct-scalar-closure"
   [(f 9) (erlang/apply f (list 9)) (erlang/is_function f) (erlang/is_function f 1)
    (erlang/is_function (fn ([x] x) ([x y] y)))
    (try (erlang/apply {:a 1} (list :a))
     (catch-raw [kind reason stack] [kind (erlang/element 1 reason)]))
    (try (erlang/apply f (list 1 2))
     (catch-raw [kind reason stack] [kind (erlang/element 1 reason)]))
    (try (erlang/is_function f -1) (catch-raw [kind reason stack] [kind reason]))
    (ds-cross-arity 5)
    ((fn local-cross ([x] (local-cross x 2)) ([x y] (+ x y))) 5)
    (ds-cross-variadic 5) (ds-nested-cross 5)
    (let [self (fn same-self [] same-self)]
     [(host/identical self (self)) (host/identical self ((self)))])
    (let [outer (fn outer-self [x]
                  (fn inner-self [y]
                   (case y :self inner-self :outer outer-self (+ x y))))
          inner (outer 7)]
     [(host/identical inner (inner :self)) (host/identical outer (inner :outer))
      (host/identical inner (outer 7))
      (inner 5) (((inner :outer) 9) 5)])]
   [16 16 true true false [:error :badfun] [:error :badarity] [:error :badarg] 6 7 -8 8
    [true true] [true true false 12 14]]))
 (let [saved (ds-retain-frames 128 (list))
       grown (ds-shrink-frame 64 (list))]
  (ds-check "direct-scalar-tail-frame-retention"
   [(count saved) ((first saved) 7) (ds-check-retained-frames saved 1)
    (count grown) (ds-check-grown-frames grown 1) (ds-protected-frame-parent 9)]
   [128 8 129 64 65 [[:caller 9] [:caller 9] 16]]))
 (ds-check "direct-scalar-tail"
  [(ds-tail 2000 0) (ds-apply-tail 512 0) (< (host/max-frames) 32)] [2001000 131328 true])
 (ds-check "direct-scalar-loop"
  (loop [n 100 sum 0] (if (= n 0) sum (recur (- n 1) (+ sum n)))) 5050)
 (ds-check "direct-scalar-operand-order"
  ((fn [a b] [a b]) (ds-operand "first" 1) (ds-operand "second" 2)) [1 2])
 (ds-check "direct-scalar-call-slots"
  [((ds-call-mark "zero-callee" (fn [] :zero)))
   ((ds-call-mark "callee" (fn [a b c] [a b c]))
    (ds-call-mark "first" 1) (ds-call-mark "second" 2) (ds-call-mark "third" 3))
   (try ((ds-call-raise "callee-throws") (ds-call-mark "unreached-argument" 1))
    (catch e e))
   (try ((ds-call-mark "throw-callee" (fn [a b c] (ds-call-mark "unreached-body" [a b c])))
          (ds-call-mark "before-throw" 1) (ds-call-raise "argument-throws")
          (ds-call-mark "unreached-tail" 3))
    (catch e e))
   (try ((ds-call-mark "arity-callee" (fn [x] (ds-call-mark "unreached-arity-body" x)))
          (ds-call-mark "arity-first" 1) (ds-call-mark "arity-second" 2))
    (catch-raw [kind reason stack] kind))
   ((fn fuse-self ([x] (fuse-self x 2 3)) ([x y & more] [x y more])) 1)
   ((let [held [:callee 7]] (fn [f value] [held (f value)]))
     (ds-adder 70) (ds-tail 512 0))]
  [:zero [1 2 3] "callee-throws" "argument-throws" :error
   [1 2 (list 3)] [[:callee 7] 131398]])
 (ds-check "direct-scalar-try"
  [(try (erlang/throw :expected) (catch e e))
   (try (erlang/error :expected) (catch e (BeamLisp.ExInfo/ex_original e)))]
  [:expected :expected])
 (ds-check "direct-scalar-finally-value"
  (try 17 (finally (host/write "SCALAR_FINALLY once"))) 17)
 (ds-check "direct-scalar-map" (:a {:a [1 2]}) [1 2])
 (ds-check "direct-scalar-truthy-zero" (if 0 true false) true)
 (ds-check "direct-scalar-nil-list-distinct" (host/eq nil (list)) false)
 (ds-check "direct-scalar-exact-int" (+ 9007199254740993 1) 9007199254740994)
 (host/write "NATIVE_DIRECT_SCALAR_OK"))
