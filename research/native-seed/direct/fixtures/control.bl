; Small direct-backend smoke. The FULL 461-check corpus remains mandatory.
(defn dc-check [label actual expected]
 (if (host/eq actual expected) (host/write (str "PASS " label))
  (host/raise (str "FAIL " label ": " (host/describe actual)))))
(defn dc-tail [left total]
 (if (= left 0) total (dc-tail (- left 1) (+ total left))))
(defn dc-adder [x] (fn [y] (+ x y)))
(defn dc-sender [to] (rt-send to [:answer 42]))
(defn main []
 (dc-check "direct-closure-capture" ((dc-adder 7) 8) 15)
 (dc-check "direct-tail-call" (dc-tail 2000 0) 2001000)
 (dc-check "direct-loop" (loop [i 0 sum 0] (if (= i 100) sum (recur (+ i 1) (+ sum i)))) 4950)
 (dc-check "direct-try-catch"
  (try (erlang/error :expected) (catch e (if (= e :expected) :caught :wrong))) :caught)
 (rt-spawn dc-sender [(rt-self)])
 (dc-check "direct-receive-yield"
  (receive [:answer n] n (after 5000 :timeout)) 42)
 (dc-check "direct-finally-survives-park"
  (try (receive :never :bad (after 1 :finished))
   (finally (rt-send (rt-self) [:cleanup :once]))) :finished)
 (dc-check "direct-finally-ran-once"
  (receive [:cleanup :once] :clean (after 0 :missing)) :clean)
 (dc-check "direct-finally-no-duplicate"
  (receive [:cleanup :once] :duplicate (after 0 :none)) :none)
 (host/write "NATIVE_DIRECT_CONTROL_OK"))
