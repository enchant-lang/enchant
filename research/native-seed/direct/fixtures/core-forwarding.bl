; Run as ORIGINAL Source through the completed direct compiler --eval path.
; core/apply is seeded by rt's make_fun rows, not a fabricated host substitute.
(ns native.core-forwarding-corpus)
(defn through-core [n sum]
 (if (= n 0) sum
  (apply through-core (list (dec n) (inc sum)))))
(host/native-c-reset-control-stats)
(assert (= 2000 (through-core 2000 0)))
(let [stats (host/native-c-control-stats)]
 (assert (< (:max-driver-depth stats) 32))
 (assert (< (:max-explicit-depth stats) 128)))
(let [external (erlang/make_fun :Elixir.BeamLisp.Ns.Rt :apply_to 2)]
 (assert (erlang/is_function external))
 (assert (erlang/is_function external 2))
 (assert (not (erlang/is_function external 3)))
 (assert (= 7 (erlang/apply external (list (fn [x] (+ x 3)) (list 4))))))
(println "NATIVE_CORE_FORWARDING_TAIL_OK")
