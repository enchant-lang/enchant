;; DIAGNOSTIC ONLY. No Source/ANF evaluation, hook replacement, or step wrapper.
;; Capture the target ONCE, before starting the helper thread.
(define c-stack-main (current-thread))
(define c-stack-port (current-error-port))
(define c-stack-interval @INTERVAL@)
(define c-stack-duration @DURATION@)
(define c-stack-delay @DELAY@)
(define c-stack-max-depth @DEPTH@)
(define c-stack-samples 0)
(define c-stack-truncated 0)
(define c-stack-next-id 0)
(define c-stack-start #f)
(define c-stack-rows (make-table test: eq?))
(define c-stack-examples '())
(define c-stack-stop-status 'complete)
(define (c-stack-now) (time->seconds (current-time)))
(define (c-stack-line label value)
 (display label c-stack-port) (display " " c-stack-port)
 (write value c-stack-port) (newline c-stack-port) (force-output c-stack-port))
(define (c-stack-text object)
 (let ((port (open-output-string))) (write object port) (get-output-string port)))
(define (c-stack-location cont)
 (let ((locat (##continuation-locat cont)))
  (and locat
   (let ((port (open-output-string)))
    (##display-locat locat #f port) (get-output-string port)))))
(define (c-stack-row creator cont)
 ;; creator collapses all lexical lambdas to host#. The saved return code
 ;; preserves the exact compiled subprocedure, including its return label.
 (let ((ret (##continuation-ret cont)))
  (or (table-ref c-stack-rows ret #f)
   (let ((row (vector c-stack-next-id creator (##procedure-name creator)
                (c-stack-location cont) 0 0 ret
                (##subprocedure-parent-name ret) (##subprocedure-id ret))))
    (set! c-stack-next-id (+ c-stack-next-id 1))
    (table-set! c-stack-rows ret row) row))))
(define (c-stack-interrupt-frame? name)
 ;; Reported counts explicitly omit the capture/RPC plumbing from leaf
 ;; attribution. Inclusive attribution still retains every interesting frame.
 (memq name '(##thread-continuation-capture ##thread-call ##thread-int!
              ##thread-interrupt! ##thread-check-interrupts! ##thread-void-action!
              ##continuation-capture ##continuation-capture-aux)))
(define (c-stack-sample!)
 (let ((captured (##thread-continuation-capture c-stack-main)))
  (set! c-stack-samples (+ c-stack-samples 1))
  (let loop ((cont (##continuation-first-frame captured #f))
             (remaining c-stack-max-depth) (seen '()) (leaf? #t) (example '()))
   (cond
    ((or (not cont) (= remaining 0))
     (if cont (set! c-stack-truncated (+ c-stack-truncated 1)))
     (if (< c-stack-samples 4)
      (set! c-stack-examples (cons (reverse example) c-stack-examples))))
    (else
     (let ((creator (##continuation-creator cont)))
      (if (procedure? creator)
       (let* ((row (c-stack-row creator cont)) (name (vector-ref row 2))
              (count-leaf? (and leaf? (not (c-stack-interrupt-frame? name)))))
        (if (not (memq (vector-ref row 6) seen))
         (vector-set! row 4 (+ (vector-ref row 4) 1)))
        (if count-leaf? (vector-set! row 5 (+ (vector-ref row 5) 1)))
        (loop (##continuation-next-frame cont #f) (- remaining 1)
              (cons (vector-ref row 6) seen) (and leaf? (not count-leaf?))
              (cons (vector-ref row 0) example)))
       (loop (##continuation-next-frame cont #f) (- remaining 1) seen leaf? example))))))))
(define (c-stack-insert row rows)
 (cond ((null? rows) (list row))
       ((> (vector-ref row 4) (vector-ref (car rows) 4)) (cons row rows))
       (else (cons (car rows) (c-stack-insert row (cdr rows))))))
(define (c-stack-report)
 (let ((rows (let loop ((pairs (table->list c-stack-rows)) (out '()))
              (if (null? pairs) out
               (loop (cdr pairs) (c-stack-insert (cdr (car pairs)) out))))))
  (c-stack-line "DIRECT_C_STACK_PROFILE"
   (list (cons 'status c-stack-stop-status) (cons 'diagnostic-only #t)
         (cons 'interval-seconds c-stack-interval)
         (cons 'requested-seconds c-stack-duration)
         (cons 'elapsed-seconds (- (c-stack-now) c-stack-start))
         (cons 'samples c-stack-samples) (cons 'truncated c-stack-truncated)
         (cons 'C-steps native-c-step-count)
         (cons 'noactor-ticks-elided native-c-noactor-ticks-elided)
         (cons 'pure-bif-steps native-c-pure-bif-steps)))
  (for-each (lambda (row)
   (c-stack-line "DIRECT_C_STACK_PROCEDURE"
    (list (cons 'id (vector-ref row 0))
          (cons 'name (or (vector-ref row 2) (c-stack-text (vector-ref row 1))))
          (cons 'return-parent (vector-ref row 7))
          (cons 'return-subprocedure-id (vector-ref row 8))
          (cons 'representative-location (vector-ref row 3))
          (cons 'inclusive-samples (vector-ref row 4))
          (cons 'leaf-samples (vector-ref row 5))))) rows)
  (c-stack-line "DIRECT_C_STACK_EXAMPLES" (reverse c-stack-examples))
  ;; Live global closure entry IDs are exact identity facts, not a guess that
  ;; a nearby numeric return ID belongs to that binding. C labels resolve it.
  (for-each (lambda (binding)
   (let* ((value (cdr binding))
          (code (if (##closure? value) (##closure-code value) value)))
    (c-stack-line "DIRECT_C_STACK_GLOBAL_CODE"
     (list (cons 'binding (car binding))
           (cons 'code-parent (##subprocedure-parent-name code))
           (cons 'entry-subprocedure-id (##subprocedure-id code))))))
   (list (cons 'bl-get bl-get) (cons 'bl-assoc bl-assoc)
         (cons 'bl-key bl-key) (cons 'bl-truthy bl-truthy)
         (cons 'bl-invoke bl-invoke) (cons 'native-resolve-call native-resolve-call)
         (cons 'native-c-resolve-call native-c-resolve-call)
         (cons 'native-c-site-stack native-c-site-stack)
         (cons 'native-c-source-stack native-c-source-stack)
         (cons 'native-c-apply-action native-c-apply-action)
         (cons 'native-c-refresh-pure-bifs! native-c-refresh-pure-bifs!)
         (cons 'native-c-record-pure-bifs! native-c-record-pure-bifs!)
         (cons 'native-c-noactor-tick-allowed? native-c-noactor-tick-allowed?)))))
(c-stack-line "DIRECT_C_STACK_PROFILE_START"
 (list (cons 'delay-seconds c-stack-delay) (cons 'interval-seconds c-stack-interval)
       (cons 'duration-seconds c-stack-duration)
       (cons 'max-interesting-frames c-stack-max-depth)
       (cons 'tick-opt-in native-c-noactor-tick-enabled?)
       (cons 'pure-opt-in native-c-pure-bif-enabled?)))
(define c-stack-observer
 (thread-start!
  (make-thread
   (lambda ()
    (thread-sleep! c-stack-delay)
    (set! c-stack-start (c-stack-now))
    (with-exception-catcher
     (lambda (failure)
      (set! c-stack-stop-status 'sampling-error)
      (c-stack-line "DIRECT_C_STACK_PROFILE_ERROR" (c-stack-text failure))
      (c-stack-report))
     (lambda ()
      (let loop ()
       (if (< (- (c-stack-now) c-stack-start) c-stack-duration)
        (begin (thread-sleep! c-stack-interval) (c-stack-sample!) (loop))
        (c-stack-report))))))
   'native-c-continuation-sampler)))
;; Original guarded proof and Source bundle bytes follow unchanged.
