;; Source authority: pinned _digest/_digest.scm digest-string and its test.scm.
(import _digest)
(define (native-c-text-sha256 text)
 (if (not (string? text)) (error "direct compiler digest requires UTF8 Scheme text"))
 (digest-string text 'sha-256 'hex))
(define (native-c-mkdir! path)
 (if (not (and (string? path) (> (string-length path) 0)))
  (error "direct compiler directory requires nonempty path"))
 (let* ((path (let trim ((end (string-length path)))
               (if (and (> end 1) (char=? (string-ref path (- end 1)) #\/))
                (trim (- end 1)) (substring path 0 end)))))
  (if (file-exists? path)
   (if (not (eq? (file-info-type (file-info path)) 'directory))
    (error "direct compiler output path is not a directory" path))
   (let ((parent (path-directory path)))
    (if (and (> (string-length parent) 0) (not (string=? parent path))) (native-c-mkdir! parent))
    (create-directory path)))) bl-nil)
(native-add-leaf! "host/native-c-sha256/1" native-c-text-sha256)
(native-add-leaf! "host/native-c-mkdir/1" native-c-mkdir!)
