;; Observations only. Authored BL bodies remain the existing compiled C units.
(define direct-observer-start (time->seconds (current-time)))
(define direct-observer-machine (make-parameter #f))
(define direct-observer-last-machine #f)
(define direct-observer-interval @INTERVAL@)
(define direct-observer-next direct-observer-interval)
(define direct-observer-apply-count 0)
(define (direct-observer-frames frames)
 (let loop ((frames frames) (left 12) (out '()))
  (if (or (= left 0) (null? frames)) (reverse out)
   (loop (cdr frames) (- left 1)
    (cons (map (lambda (name) (cons name (bl-get (car frames) (bl-key name))))
             '("fn" "file" "arity" "line" "col" "call")) out)))))
(define (direct-observer-sample machine)
 (with-exception-catcher
  (lambda (error) (display "DIRECT_OBSERVER_SAMPLE_ERROR ") (write error) (newline) (force-output))
  (lambda ()
   (display "DIRECT_OBSERVER_STEP ")
   (write (list (cons 'steps native-c-step-count)
          (cons 'calls direct-observer-apply-count)
          (cons 'wall-seconds (- (time->seconds (current-time)) direct-observer-start))
          (cons 'pc (if machine (vector-ref machine 1) #f))
          (cons 'physical-depth (if machine (length (vector-ref machine 3)) #f))
          (cons 'critical seed-critical)
          (cons 'source (if machine (direct-observer-frames (vector-ref machine 10)) '()))
          (cons 'site (if machine
           (map (lambda (name) (cons name (bl-get (vector-ref machine 11) (bl-key name))))
                '("fn" "file" "arity" "line" "call" "internal")) '()))))
   (newline) (force-output))))
(define direct-observer-original-drive native-c-drive)
(set! native-c-drive (lambda (machine)
 (parameterize ((direct-observer-machine machine))
  (direct-observer-original-drive machine))))
(define direct-observer-original-apply native-c-apply-action)
(set! native-c-apply-action (lambda (machine function arguments)
 (set! direct-observer-last-machine machine)
 (set! direct-observer-apply-count (+ direct-observer-apply-count 1))
 (direct-observer-original-apply machine function arguments)))
(define direct-observer-original-after-step native-c-after-step!)
(set! native-c-after-step! (lambda ()
 (direct-observer-original-after-step)
 (if (>= native-c-step-count direct-observer-next)
  (begin
   (set! direct-observer-next (+ native-c-step-count direct-observer-interval))
   (direct-observer-sample (or (direct-observer-machine) direct-observer-last-machine))))))
(display "DIRECT_OBSERVER_HOOKS_INSTALLED\n") (force-output)
