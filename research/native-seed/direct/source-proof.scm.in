;; Qualification observation only; ORIGINAL bundle bytes follow unchanged.
;; This code supplies no authored BL reader/compiler/emitter implementation.
(native-c-require-action-abi! 2)
(define direct-proof-data-bundle (native-read-file @BUNDLE_PATH@))
(define direct-proof-data-ledger (native-read-file @LEDGER_PATH@))
(define direct-proof-retained '())
(define direct-proof-evaluations 0)
(define direct-proof-in-dynamic? #f)
(define direct-proof-collected? #f)
(define (direct-proof-c-function? value)
 (cond ((native-c-closure? value) #t)
  ((native-multi-callable? value)
   (let ((fixed (native-map-pairs (bl-nth value 1))) (variadic (bl-nth value 2)))
    (and (or (pair? fixed) (not (bl-is-nil variadic)))
     (let loop ((rows fixed))
      (or (null? rows)
       (and (direct-proof-c-function? (bl-nth (car rows) 1)) (loop (cdr rows)))))
     (or (bl-is-nil variadic) (direct-proof-c-function? (bl-nth variadic 1))))))
  (else #f)))
(if (not (eq? native-c-backend (bl-key "c"))) (error "direct compiler qualification requires backend :c"))
(for-each (lambda (row)
 (if (not (direct-proof-c-function? (native-global-exact (car row) (cadr row))))
  (error "authored compiler export is not actual C control" row)))
 '( ("rt" "k-first") ("reader" "read-string") ("compiler" "compile")
    ("native.bootstrap" "prepare") ("native.eval" "eval-form")
    ("native.c" "emit-unit") ("native.c-eval" "eval-node")
    ("native.c-units" "write-plan!") ("native.c-bootstrap" "main") ))
(define direct-proof-original-scheme (native-leaf "host/eval-scheme/1"))
(native-c-replace-leaf! "host/eval-scheme/1" direct-proof-original-scheme
 (lambda (text)
  (if (not (and (string? text)
            (or (string=? text direct-proof-data-bundle) (string=? text direct-proof-data-ledger))))
   (error "authored Source attempted Scheme evaluation during direct C qualification"))
  (direct-proof-original-scheme text)) 1)
(define direct-proof-original-set-backend (native-leaf "host/set-native-backend/1"))
(native-c-replace-leaf! "host/set-native-backend/1" direct-proof-original-set-backend
 (lambda (backend)
  (if (not (eq? backend (bl-key "c"))) (error "direct qualification forbids switching to Scheme"))
  (direct-proof-original-set-backend backend)) 1)
(define direct-proof-new-closure native-c-new-closure)
(set! native-c-new-closure
 (bl-register-callable! (native-mark-host-callable! (lambda (unit metadata captures)
  (let ((value (direct-proof-new-closure unit metadata captures)))
   (if (and direct-proof-in-dynamic? (< (length direct-proof-retained) 3)
            (bl-tag? (vector-ref value 6) 'map)
            (h-is-int (bl-get (vector-ref value 6) (bl-key "arity")))
            (eq? (bl-get (vector-ref value 6) (bl-key "native-control")) #f))
    (set! direct-proof-retained (cons value direct-proof-retained)))
   value))) 3))
(define direct-proof-original-eval (native-leaf "host/eval-c-unit/1"))
(native-c-replace-leaf! "host/eval-c-unit/1" direct-proof-original-eval
 (lambda (emitted)
  (let* ((manifest (bl-get emitted (bl-key "manifest")))
         (steps-before native-c-step-count)
         (loads-before (length native-c-loaded-artifacts)))
   (if (not (and (eq? native-c-backend (bl-key "c"))
                 (eq? (bl-get manifest (bl-key "program-control")) (bl-key "emitted-c"))
                 (eqv? (bl-get manifest (bl-key "action-abi")) 2)
                 (eq? (bl-get manifest (bl-key "source-interpreter")) #f)
                 (eq? (bl-get manifest (bl-key "anf-interpreter")) #f)))
    (error "dynamic Source unit lacks concrete C program control"))
   (set! direct-proof-in-dynamic? #t)
   (let ((answer (with-exception-catcher
          (lambda (failure) (set! direct-proof-in-dynamic? #f) (raise failure))
          (lambda () (direct-proof-original-eval emitted)))))
    (set! direct-proof-in-dynamic? #f)
    (if (or (not (eq? native-c-backend (bl-key "c")))
            (<= native-c-step-count steps-before)
            (<= (length native-c-loaded-artifacts) loads-before)
            (not (eq? (vector-ref (car native-c-loaded-artifacts) 1) emitted)))
     (error "dynamic Source evaluation did not execute/retain actual C control"))
    (set! direct-proof-evaluations (+ direct-proof-evaluations 1))
    (if (and (< (length direct-proof-retained) 3) (direct-proof-c-function? answer))
     (set! direct-proof-retained (cons answer direct-proof-retained)))
    (if (and (pair? direct-proof-retained) (not direct-proof-collected?))
     (begin (##gc) (set! direct-proof-collected? #t)))
    (if (not (let loop ((values direct-proof-retained))
               (or (null? values) (and (direct-proof-c-function? (car values)) (loop (cdr values))))))
     (error "dynamic C function retention failed across collection"))
    (display "DIRECT_C_DYNAMIC_WITNESS {\"backend\":\"c\",\"evaluations\":")
    (display direct-proof-evaluations) (display ",\"loaded_units\":")
    (display (length native-c-loaded-artifacts)) (display ",\"retained_closures\":")
    (display (length direct-proof-retained)) (display ",\"c_steps\":")
    (display native-c-step-count)
    (display ",\"artifact_directory\":") (write (vector-ref (car native-c-loaded-artifacts) 0))
    (display ",\"gc_retention_checked\":") (display (if direct-proof-collected? "true" "false"))
    (display ",\"required_c_exports\":9,\"action_abi\":2,\"scheme_data_only\":true}\n") (force-output)
    answer))) 1)
;; ORIGINAL, already captured Source bundle expression follows as final value.
