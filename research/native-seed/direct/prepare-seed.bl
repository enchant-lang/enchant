; Replay selected captured-ANF producers in ONE SDK VM. Each job owns an
; isolated Env; native qualification runs separately. No argv means all jobs.
(ns native.prepare-direct-seed)
(def requested (BeamLisp/argv))
(def job-order ["profile" "assemble" "compiler" "actors" "loader" "scalar"])
(def jobs
 {"profile" ["research/native-seed/src/native/extend-direct-closure.bl"
   ["research/native-seed/out/compiler-closure/partition.json"
    "research/native-seed/out/direct-closure"]]
  ; Transport-only retry after a completed profile capture; never a BL VM.
  "partition" nil
  "assemble" ["research/native-seed/src/native/chunks.bl" ["assemble"]]
  "compiler" ["research/native-seed/src/native/c-produce.bl"
   ["research/native-seed/out/direct-closure/partition.json"
    "research/native-seed/out/direct-compiler"
    "research/native-seed/out/direct-host-current/host.scm"
    "research/native-seed/out/direct-host-current/host.components.json"]]
  "actors" ["research/native-seed/src/native/c-actor-produce.bl"
   ["research/native-seed/out/original-actor-corpus/manifest.json"
    "research/native-seed/out/direct-actors"
    "research/native-seed/out/direct-closure/partition.json"]]
  "loader" ["research/native-seed/direct/loader-produce.bl" []]
  "scalar" ["research/native-seed/direct/scalar.bl" []]})
(def selected (if (empty? requested) job-order (vec (distinct requested))))
; Validate every selector before any producer mutates its owned output.
(doseq [job selected] (assert (contains? jobs job)))
(defn partition-direct-profile! []
 ; The canonical CompilerData validators own passive shape admission. This
 ; existing Python helper only preserves bounded structural ETF byte spans.
 (let [result (System/cmd "python3"
                (list "research/native-seed/partition-closure.py"
                      "--out" "research/native-seed/out/direct-closure")
                (list (tuple :stderr_to_stdout true)))
       output (elem result 0) status (elem result 1)]
  (print output)
  (when-not (= status 0)
   (throw (ex-info "direct seed: structural profile partition failed"
           {:exit status :output output})))))
(doseq [job selected]
 (when-not (= job "partition")
  (let [[path arguments] (get jobs job)]
   (BeamLisp.Env/isolated
    (fn [] (BeamLisp/with_argv (to-list arguments) (fn [] (BeamLisp/run_file path)))))))
 ; This must finish successfully before compiler/actor producers read the
 ; refreshed manifest. No second SDK, compiler or Source parser is launched.
 (when (contains? #{"profile" "partition"} job) (partition-direct-profile!))
 (erlang/garbage_collect))
(println (str "DIRECT_SEED_PREPARED " (pr-str selected) "; one pinned SDK VM"))
