; Replay captured ANF and prepare the independent ABI fixtures in ONE SDK VM.
; Each producer owns an isolated Env; native qualification runs separately.
(ns native.prepare-direct-seed)
(assert (empty? (BeamLisp/argv)))
(def jobs
 [["research/native-seed/src/native/chunks.bl" ["assemble"]]
  ["research/native-seed/src/native/c-produce.bl"
   ["research/native-seed/out/direct-closure/partition.json"
    "research/native-seed/out/direct-compiler"
    "research/native-seed/out/direct-host-current/host.scm"
    "research/native-seed/out/direct-host-current/host.components.json"]]
  ["research/native-seed/src/native/c-actor-produce.bl"
   ["research/native-seed/out/original-actor-corpus/manifest.json"
    "research/native-seed/out/direct-actors"
    "research/native-seed/out/direct-closure/partition.json"]]
  ["research/native-seed/direct/loader-produce.bl" []]
  ["research/native-seed/direct/scalar.bl" []]])
(doseq [[path args] jobs]
 (BeamLisp.Env/isolated
  (fn [] (BeamLisp/with_argv (to-list args) (fn [] (BeamLisp/run_file path)))))
 (erlang/garbage_collect))
(println "DIRECT_SEED_PREPARED; assembly + four isolated producers; one pinned SDK VM")
