; Compile original BL with the canonical compiler, then direct-emit only the
; transitive canonical runtime globals this smoke reaches. No reduced kernel,
; duplicate scheduler, or source/ANF interpreter is used.
(ns native.direct-smoke
 (:require [compiler :as compiler] [js.build :as build] [native.c :as c]
           [native.scheme :as scalar] [anf] [bl.json :as json]))
(def args (BeamLisp/argv))
(def host-path (or (first args) "research/native-seed/out/compiler-closure/host.scm"))
(def output (or (second args) "research/native-seed/out/direct-smoke"))
(def fixture (or (nth args 2 nil) "research/native-seed/direct/fixtures/control.bl"))
(def namespace "native.kernel")
(defn forms [path] (BeamLisp.Ns.Reader/read (File/read! path) {:file path}))
(def source-definitions
 (vec (concat (build/definition-values (forms "priv/lib/js/actor/runtime.bl"))
              (build/definition-values (forms fixture)))))
(compiler/reset-fresh!)
(def environment (assoc (compiler/new-env namespace) :file fixture))
(def compiled (mapv #(assoc % :ns namespace :node (compiler/compile (:form %) environment)) source-definitions))
(def by-name (into {} (map (fn [d] [(:name d) d]) compiled)))
(defn nodes [node] (cons node (mapcat nodes (filter some? (anf/executable-children node)))))
(def reachable
 (loop [todo ["bl-main" "main"] done #{}]
  (if (empty? todo) done
   (let [name (first todo)]
    (if (contains? done name) (recur (rest todo) done)
     (let [definition (get by-name name)]
      (when-not definition (throw (ex-info "direct smoke: missing reachable runtime definition" {:name name})))
      (let [dependencies (keep (fn [node]
                           (when (and (= :global (:op node)) (= namespace (:ns node))
                                      (contains? by-name (:name node))) (:name node))) (nodes (:node definition)))]
       (recur (concat (rest todo) dependencies) (conj done name)))))))))
(def kept (vec (filter #(contains? reachable (:name %)) compiled)))
(def options
 {:unit-name "native_direct_smoke" :runtime-namespace namespace
  :global-resolver
  (fn [node]
   (or (when (contains? #{"core" "rt"} (:ns node)) (get scalar/core-leaves (:name node)))
       (str "(native-global " (scalar/text (:ns node)) " " (scalar/text (:name node)) ")")))
  :arithmetic-resolver (fn [node]
    (str "(lambda (a b) (bl-arithmetic " (scalar/literal (:fun node)) " a b))"))})
(def emitted (c/emit-definitions kept options))
(File/mkdir_p! output)
(File/write! (str output "/control.c") (:c-source emitted))
(File/write! (str output "/program.scm")
 (str (File/read! host-path) "\n"
      (File/read! "research/native-seed/direct/direct-machine.scm") "\n"
      ; Standalone smoke does not need the dynamic loader/publisher.
      "(define (native-c-publish-loaded! value) value)\n"
      (:wrapper-source emitted) "\n"
      "(bl-invoke (native-global \"native.kernel\" \"bl-main\") (list (native-global \"native.kernel\" \"main\")))\n"
      "(if (not (null? seed-errors)) (error \"direct smoke actor errors\"))\n"
      "(if (not (= 0 (h-map-size (bl-get seed-state (bl-key \"procs\"))))) (error \"direct smoke actor leak\"))\n"))
(File/write! (str output "/manifest.json")
 (json/encode (assoc (:manifest emitted) :status :emitted-not-executed :fixture fixture
               :canonical-runtime-definitions (count kept) :scope :smoke)))
(println (str "DIRECT_SMOKE_EMITTED " (count kept) " definitions")))
