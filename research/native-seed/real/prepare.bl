; Canonical Source compilation only. Run once through the qualified SDK.
; The same frozen core/rt is retained; POSIX declarations stay in its explicitly
; augmented indivisible host so the existing bounded splitter can reject any
; unaccounted C declaration in later units.
(ns native.prepare-real-actors
 (:require [native.proc-link :as linker] [bl.json :as json] [clojure.string :as string]))
(def base "research/native-seed")
(def args (BeamLisp/argv))
(def closure-dir (or (first args) (str base "/out/compiler-closure")))
(def out (or (second args) (str base "/out/real-actors")))
(def app (str base "/fixtures/actor-posix.bl"))
(def runtime "priv/lib/js/actor/runtime.bl")
(def header ";; BL native compiler. Generated from canonical BL source.\n")
(def addons [(str base "/host/native-posix.scm")
             (str base "/host/native-readiness.scm")
             (str base "/host/actor-invariants.scm")
             (str base "/real/witness.scm")])
(def capability-path (str base "/real/capabilities.edn"))
(def capability (BeamLisp.Compiler/read_data (File/read! capability-path)))
(when-not (and (= "bl.native.posix-capabilities" (:schema capability)) (= 1 (:version capability))
                (= :linux (:platform capability)) (= "uint64_t (*)(uint64_t)" (:worker-abi capability))
                (= 64 (:watch-limit capability))
                (= :canonical-rt-pump-input-and-rt-send (:input-delivery capability))
                (= 18 (count (:leaves capability)))
                (= (count (:leaves capability)) (count (distinct (:leaves capability)))))
 (throw (ex-info "real actor prepare: capability declaration is not the finite POSIX ABI" {})))
(File/mkdir_p! out)
(def frozen-host (File/read! (str closure-dir "/host.scm")))
(def frozen-prelude (File/read! (str closure-dir "/prelude.scm")))
(def prefix (str header frozen-host "\n"))
(when-not (String/starts_with? frozen-prelude prefix)
 (throw (ex-info "real actor prepare: frozen compiler prelude/host boundary differs" {})))
(def host (str frozen-host "\n" (string/join "\n" (map File/read! addons))))
(def prelude (str header host "\n"
                  (binary/part frozen-prelude (erlang/byte_size prefix)
                   (- (erlang/byte_size frozen-prelude) (erlang/byte_size prefix)))))
(File/write! (str out "/host.scm") host)
(File/write! (str out "/prelude.scm") prelude)
(def original-leaves (json/decode (File/read! (str closure-dir "/leaves.json"))))
(when (some (set (get original-leaves "registered_leaves")) (:leaves capability))
 (throw (ex-info "real actor prepare: POSIX capability shadows a frozen compiler leaf" {})))
(File/write! (str out "/leaves.json")
 (json/encode {"registered_leaves" (vec (sort (concat (get original-leaves "registered_leaves") (:leaves capability))))
               "frozen_registry" (linker/source-identity (str closure-dir "/leaves.json"))
               "capability" (linker/source-identity capability-path)
               "observation" "explicit finite Source ABI; actual registrations checked by native execution"}))
(def result (linker/build-project
 {:application app :runtime runtime :bridges (str base "/bridges.bl")
  :links (str base "/actor-links.edn") :sdk-pin (str base "/sdk-pin.json")
  :host-link (str base "/host/host-proc-link.scm")
  :prelude (str out "/prelude.scm") :closure-manifest (str closure-dir "/partition.json")
  :leaves (str out "/leaves.json") :host-extensions [] :helper-namespaces []}))
(when-not (= 202 (get-in result [:manifest :runtime-definitions]))
 (throw (ex-info "real actor prepare: complete canonical actor runtime is required" {})))
(File/write! (str out "/program.scm") (str (:program result) "\n(native-real-finish)\n"))
(File/write! (str out "/program.anf.etf")
 (erlang/term_to_binary {:schema "bl.native.anf-unit" :version 1 :definitions (:definitions result)
                       :entry (:entry result) :link-resolutions (:link-resolutions result)
                       :link-manifest (:manifest result)} (list :deterministic)))
(File/write! (str out "/manifest.json")
 (json/encode {:schema "bl.native.real-actor-corpus" :version 1 :status :prepared-not-executed
  :backend :gambit-native :clock :posix-monotonic :worker-abi (:worker-abi capability)
  :application (linker/source-identity app) :runtime (linker/source-identity runtime)
  :link (:manifest result) :capability (linker/source-identity capability-path)
  :declared-leaves (:leaves capability)
  :leaves (linker/source-identity (str out "/leaves.json"))
  :frozen-leaves (linker/source-identity (str closure-dir "/leaves.json"))
  :frozen-host (linker/source-identity (str closure-dir "/host.scm"))
  :frozen-prelude (linker/source-identity (str closure-dir "/prelude.scm"))
  :host-addons (mapv linker/source-identity addons)
  :host (linker/source-identity (str out "/host.scm"))
  :prelude (linker/source-identity (str out "/prelude.scm"))
  :program (linker/source-identity (str out "/program.scm"))
  :anf (linker/source-identity (str out "/program.anf.etf"))
  :foreign-fixture (linker/source-identity (str base "/fixtures/ffi-gated.c"))
  :inputs (mapv linker/source-identity
   [app runtime capability-path (str base "/bridges.bl") (str base "/actor-links.edn")
    (str base "/sdk-pin.json") (str base "/toolchain-pin.json")
    (str base "/src/native/proc-link.bl") (str base "/src/native/proc.bl")
    (str base "/src/native/scheme.bl") (str base "/real/prepare.bl")])}))
(println (str "NATIVE_REAL_ACTORS_PREPARED " (count (:definitions result)) " exact source bodies"))
