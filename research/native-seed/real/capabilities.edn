{:schema "bl.native.posix-capabilities" :version 1
 :platform :linux :worker-abi "uint64_t (*)(uint64_t)"
 :watch-limit 64 :input-delivery :canonical-rt-pump-input-and-rt-send
 :source-owner :explicit-resource-close-and-input-sink-registration
 :leaves ["native.host/clock-real!/0" "native.host/library-open/1" "native.host/library-close/1"
          "native.host/ffi-submit/3" "native.host/ffi-ready?/1" "native.host/ffi-fd/1"
          "native.host/ffi-result/1" "native.host/ffi-close/1" "native.host/wait-fd/2"
          "native.readiness/install!/0" "native.readiness/open-library!/1"
          "native.readiness/submit!/3" "native.readiness/watch!/2"
          "native.readiness/close-job!/1" "native.readiness/close-library!/1"
          "native.readiness/uninstall!/0" "native.readiness/stats/0"
          "native.readiness/fixture-library/0"]
 :unsupported [:scheme-worker-callbacks :scheme-pointer-arguments :variadic-ffi
               :foreign-struct-abi :automatic-process-owned-native-resources
               :arbitrary-input-producers :unbounded-watch-set]}
