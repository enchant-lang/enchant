;; Observation and fixture budget selection only. Load before BL definitions.
(define native-real-budget-name (or (getenv "NATIVE_ACTOR_BUDGET" #f) "default"))
(define native-real-budget
 (cond ((string=? native-real-budget-name "default") #f)
  ((string=? native-real-budget-name "17") 17)
  ((string=? native-real-budget-name "41") 41)
  (else (error "unsupported real-actor budget" native-real-budget-name))))
(define native-real-run-turn h-run-turn)
(set! h-run-turn (native-mark-host-callable! (lambda (frames budget)
 (native-real-run-turn frames (or native-real-budget budget)))))
(bl-register-callable! h-run-turn 2)
(define (native-real-finish)
 (native-sample-boundary)
 (if native-virtual-time? (error "real actor gate used virtual deadlines"))
 (if (not (null? seed-errors)) (error "real actor runtime recorded errors"))
 (for-each (lambda (key)
  (if (not (= 0 (h-map-size (bl-get seed-state (bl-key key)))))
   (error "real actor resource leak" key))) '("procs" "monitors" "tables" "names" "table-names"))
 (if (not (= 0 (h-vec-size (bl-get seed-state (bl-key "runnable")))))
  (error "real actor runnable leak"))
 (if (not (bl-is-nil (bl-get seed-state (bl-key "input-sink"))))
  (error "real actor input sink leak"))
 (if (not (= seed-critical 0)) (error "real actor critical section leak"))
 (if (or native-readiness-reactor native-input-producer (pair? native-input-queue)
         (pair? native-readiness-jobs) (pair? native-readiness-libraries))
  (error "real actor native resource leak"))
 (if (not (and (> native-boundary-samples 0) (>= native-boundary-deaths 2)
               (> native-readiness-timed-waits 0) (> native-readiness-input-waits 0)
               (> native-readiness-ready-wakes 0) (>= native-readiness-queued 3)))
  (error "real actor gate lacks actual lifecycle/readiness observations"))
 (display "NATIVE_REAL_ACTOR_WITNESS {\"budget\":\"") (display native-real-budget-name)
 (display "\",\"samples\":") (display native-boundary-samples)
 (display ",\"deaths\":") (display native-boundary-deaths)
 (display ",\"queued\":") (display native-readiness-queued)
 (display ",\"timed_waits\":") (display native-readiness-timed-waits)
 (display ",\"input_waits\":") (display native-readiness-input-waits)
 (display ",\"ready_wakes\":") (display native-readiness-ready-wakes)
 (display ",\"cleanup\":{\"procs\":0,\"monitors\":0,\"tables\":0,\"names\":0,\"table_names\":0,\"runnable\":0,\"input_sink\":null,\"critical\":0,\"errors\":0,\"native_jobs\":0,\"native_libraries\":0,\"native_watches\":0,\"native_input\":0}}\n"))
