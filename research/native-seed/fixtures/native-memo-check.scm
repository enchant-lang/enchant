;; native-memo.scm: the NIF's native counterpart, call for call.
(define native-memo-checks 0)
(define (native-memo-check label ok)
 (if (not ok) (error (string-append "native memo check failed: " label)))
 (set! native-memo-checks (+ native-memo-checks 1)))
(define (memo-nif name) (cdr (assoc name native-memo-nifs)))
(let* ((new (memo-nif "nif_new")) (read (memo-nif "nif_read")) (rv (memo-nif "nif_read_versioned"))
       (xv (memo-nif "nif_exchange_version")) (peek (memo-nif "nif_peek")) (id (memo-nif "nif_id"))
       (cell (new (bl-make-tuple (bl-key "pending") 1) '() 64)) (other (new (bl-key "x") '() 8)))
 (native-memo-check "a cell is a reference" (native-reference? cell))
 (native-memo-check "identity is per cell" (not (= (id cell) (id other))))
 (native-memo-check "resource id answers a cell" (= (id cell) ((memo-nif "nif_resource_id") cell)))
 (native-memo-check "resource id of a non-cell is nil" (bl-is-nil ((memo-nif "nif_resource_id") 7)))
 (native-memo-check "read" (bl-key-equal? (read cell) (bl-make-tuple (bl-key "pending") 1)))
 (native-memo-check "versioned read starts at 0" (= 0 (bl-nth (rv cell) 0)))
 (native-memo-check "peek is the tag and version"
  (bl-key-equal? (peek cell) (bl-make-tuple (bl-key "pending") 0)))
 (native-memo-check "peek of a bare atom state" (eq? (bl-nth (peek other) 0) (bl-key "x")))
 (native-memo-check "stale version retries" (eq? (bl-key "retry") (xv cell 5 (bl-key "done") (bl-key "keep") 8 '())))
 (native-memo-check "current version commits" (eq? (bl-key "ok") (xv cell 0 (bl-key "done") (bl-key "keep") 8 '())))
 (native-memo-check "commit bumps the version" (= 1 (bl-nth (rv cell) 0)))
 (native-memo-check "committed state" (eq? (bl-key "done") (read cell)))
 (native-memo-check "term CAS compares values"
  (and (eq? (bl-key "retry") ((memo-nif "nif_compare_exchange") cell (bl-key "nope") 1 '() 8 '()))
       (eq? (bl-key "ok") ((memo-nif "nif_compare_exchange") cell (bl-key "done") 2 '() 8 '()))
       (= 2 (read cell))))
 (native-memo-check "put replaces" (and (eq? (bl-key "ok") ((memo-nif "nif_put") cell 3 8)) (= 3 (read cell))))
 (let ((budget (+ ((memo-nif "nif_retained_bytes")) 10)))
  (native-memo-check "admission refuses growth past the budget"
   (eq? (bl-key "over_budget") ((memo-nif "nif_exchange_version_admitted") cell (bl-nth (rv cell) 0) 4 '() 1000 '() budget)))
  (native-memo-check "a refusal leaves the cell" (= 3 (read cell)))
  (native-memo-check "a shrink is always admitted"
   (eq? (bl-key "ok") ((memo-nif "nif_exchange_version_admitted") cell (bl-nth (rv cell) 0) 4 '() 1 '() 0)))))
(let* ((cursor (memo-nif "nif_cursor")) (chunk (memo-nif "nif_cursor_chunk"))
       (xs (let loop ((i 69) (out '())) (if (< i 0) out (loop (- i 1) (cons i out)))))
       (root (cursor xs '() 0)) (c0 (chunk root)) (c1 (chunk (bl-nth c0 1))) (c2 (chunk (bl-nth c1 1))))
 (native-memo-check "chunk 0" (and (= 32 (length (bl-nth c0 0))) (= 0 (car (bl-nth c0 0)))))
 (native-memo-check "chunk 1" (and (= 32 (length (bl-nth c1 0))) (= 32 (car (bl-nth c1 0)))))
 (native-memo-check "last chunk has no tail" (and (equal? '(64 65 66 67 68 69) (bl-nth c2 0)) (bl-is-nil (bl-nth c2 1))))
 (native-memo-check "a pull replays" (bl-key-equal? (chunk root) c0))
 (native-memo-check "empty cursor" (let ((e (chunk (cursor '() '() 0)))) (and (null? (bl-nth e 0)) (bl-is-nil (bl-nth e 1))))))
(let* ((seen ((memo-nif "nif_seen_new"))) (admit (memo-nif "nif_seen_admit")))
 (native-memo-check "seen admits new keys once" (equal? '(#t #t #f) (admit seen (list 1 2 1))))
 (native-memo-check "seen remembers" (equal? '(#f #t) (admit seen (list 2 3)))))
(native-memo-check "loaded" ((memo-nif "nif_loaded?")))
;; load_nif's binding: registering the compiled stub publishes the native procedure.
(native-register! "host.lazy-memo" "nif_peek" (lambda (r) 'stub))
(native-memo-check "stub registration binds the native NIF"
 (eq? (memo-nif "nif_peek") (bl-get native-global-registry "host.lazy-memo/nif_peek" #f)))
(native-register! "other.ns" "nif_peek" 'kept)
(native-memo-check "other namespaces are untouched" (eq? 'kept (bl-get native-global-registry "other.ns/nif_peek" #f)))
(display "native memo checks: ") (display native-memo-checks) (newline)
