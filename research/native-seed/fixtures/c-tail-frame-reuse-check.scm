;; Storage/action ABI ONLY. Fixed Scheme step stand-ins drive the same machine
;; actions; they do not decode, interpret, or replace authored Source bodies.
(define native-tail-frame-checks 0)
(define (tail-frame-check label actual expected)
 (if (not (bl-equal? actual expected))
  (error "C tail frame reuse ABI" label actual expected))
 (set! native-tail-frame-checks (+ native-tail-frame-checks 1)))
(define tail-frame-unit (vector #f '#() '#()))
(define (tail-frame-closure size destinations captures control?)
 (native-c-new-closure tail-frame-unit
  (list 20 size destinations
   (bl-map (bl-key "arity") 2 (bl-key "fn") "tail-frame-probe"
           (bl-key "native-control") control?)) captures))
(define (tail-frame-machine frame)
 (vector tail-frame-unit 0 frame '() bl-nil 0 0 '() #f bl-nil
         '() bl-nil seed-critical #t))

;; Callee, arguments and capture VALUES may all originate in the old frame.
;; Clearing that vector must happen after those references have been retained.
(set! seed-critical 0)
(let* ((arguments (list 7 8)) (first (list "captured" 37))
       (second (bl-vec '(4 5))) (old (make-vector 8 (bl-key "stale")))
       (_ (vector-set! old 0 arguments))
       (_ (vector-set! old 1 first)) (_ (vector-set! old 2 second))
       (captures (native-c-slots old '(1 2)))
       (callee (tail-frame-closure 4 '(1 2) captures #f))
       (_ (vector-set! old 3 callee)) (machine (tail-frame-machine old)))
 (set! seed-critical 3)
 (native-c-enter! machine (vector-ref old 3) (vector-ref old 0) 6 42 #t)
 (tail-frame-check 'tail-reuses-capacity (eq? old (vector-ref machine 2)) #t)
 (tail-frame-check 'arguments-snapshot (eq? arguments (vector-ref old 0)) #t)
 (tail-frame-check 'first-capture-snapshot (eq? first (vector-ref old 1)) #t)
 (tail-frame-check 'second-capture-snapshot (eq? second (vector-ref old 2)) #t)
 (tail-frame-check 'capacity-retained (vector-length old) 8)
 (tail-frame-check 'all-old-unused-roots-cleared
  (let loop ((index 3))
   (or (= index 8) (and (bl-is-nil (vector-ref old index)) (loop (+ index 1))))) #t)
 (tail-frame-check 'callee-pc (vector-ref machine 1) 20)
 (tail-frame-check 'callee-unit (eq? (vector-ref machine 0) tail-frame-unit) #t)
 (tail-frame-check 'source-critical-entry (vector-ref machine 12) 3)
 (tail-frame-check 'source-boundary-owner (vector-ref machine 13) #t)
 (tail-frame-check 'tail-keeps-no-physical-caller (length (vector-ref machine 3)) 0)
 (##gc)
 (tail-frame-check 'capture-spine-survives-collection
  (and (eq? first (car (vector-ref callee 4)))
       (eq? second (cadr (vector-ref callee 4)))) #t)
 (vector-set! old 1 (bl-key "next-activation"))
 (tail-frame-check 'retained-closure-copies-values (eq? first (car (vector-ref callee 4))) #t))

;; Growing cannot reuse, and cannot modify storage still owned by an older
;; activation. Shrinking below uses all prior capacity, not only required size.
(set! seed-critical 0)
(let* ((old (vector '(7 8) 11 12 13)) (before (vector->list old))
       (value (bl-map (bl-key "saved") 9))
       (callee (tail-frame-closure 8 '(7) (list value) #f))
       (machine (tail-frame-machine old)))
 (native-c-enter! machine callee '(1 2) 1 0 #t)
 (tail-frame-check 'growth-allocates (eq? old (vector-ref machine 2)) #f)
 (tail-frame-check 'growth-required-size (vector-length (vector-ref machine 2)) 8)
 (tail-frame-check 'growth-keeps-old-values (vector->list old) before)
 (tail-frame-check 'growth-arguments (vector-ref (vector-ref machine 2) 0) '(1 2))
 (tail-frame-check 'growth-capture (eq? value (vector-ref (vector-ref machine 2) 7)) #t)
 (tail-frame-check 'growth-tail-has-no-caller (length (vector-ref machine 3)) 0))

;; A non-tail call MUST retain the caller frame even if it has ample capacity.
(let* ((old (vector '(7 8) 11 12 13 14 15 16 17))
       (before (vector->list old))
       (callee (tail-frame-closure 4 '() '() #f))
       (machine (tail-frame-machine old)))
 (native-c-enter! machine callee '(1 2) 6 42 #f)
 (tail-frame-check 'nontail-never-reuses (eq? old (vector-ref machine 2)) #f)
 (tail-frame-check 'nontail-saves-exact-caller
  (eq? old (vector-ref (car (vector-ref machine 3)) 2)) #t)
 (tail-frame-check 'nontail-keeps-all-values (vector->list old) before)
 (native-c-return! machine 99)
 (tail-frame-check 'nontail-return-writes-only-result
  (vector->list old) '((7 8) 11 12 13 14 15 99 17))
 (tail-frame-check 'nontail-return-restores-frame (eq? old (vector-ref machine 2)) #t)
 (tail-frame-check 'nontail-return-retires-caller (length (vector-ref machine 3)) 0))

;; Generated control entries preserve their Source owner's independent base.
(set! seed-critical 2)
(let* ((old (make-vector 6 bl-nil)) (machine (tail-frame-machine old))
       (control (tail-frame-closure 3 '() '() #t)))
 (set! seed-critical 5)
 (native-c-enter! machine control '() 1 0 #t)
 (tail-frame-check 'tail-control-reuses (eq? old (vector-ref machine 2)) #t)
 (tail-frame-check 'tail-control-keeps-critical-base (vector-ref machine 12) 2)
 (tail-frame-check 'tail-control-keeps-owner (vector-ref machine 13) #t)
 (native-c-return! machine bl-nil)
 (tail-frame-check 'tail-control-restores-owner seed-critical 2))
(set! seed-critical 0)

;; Reuse before suspension must not change one-shot continuation ownership.
;; A real collection runs while the parked machine is its only active owner.
(define (tail-frame-suspension mode)
 (let* ((old #f) (reused? #f) (result #f) (parks 0) (child #f)
        (captured (list "retained across suspension" 37))
        (arguments (list 7 8))
        (unit
         (vector
          (lambda (machine)
           (case (vector-ref machine 1)
            ((0)
             (set! old (vector-ref machine 2))
             (set! child (native-c-new-closure (vector-ref machine 0)
              (list 10 4 '(2) (bl-map (bl-key "arity") 2
                                     (bl-key "native-control") #f))
              (native-c-slots old '(1))))
             (vector-set! machine 4 child)
             (vector-set! machine 5 1) (vector-set! machine 6 99)
             (vector-set! machine 7 (vector-ref old 0))
             (vector-set! machine 8 #t) (vector-set! machine 11 bl-nil) 2)
            ((10)
             (set! reused? (eq? old (vector-ref machine 2)))
             (vector-set! machine 5 1) (vector-set! machine 6 11)
             (vector-set! machine 7 '()) (vector-set! machine 8 #f)
             (vector-set! machine 11 bl-nil)
             (if (eq? mode 'yield) 5
              (begin (vector-set! machine 4 0) 1)))
            ((11)
             (set! result (list (vector-ref (vector-ref machine 2) 0)
                                (vector-ref (vector-ref machine 2) 2)
                                (vector-ref (vector-ref machine 2) 7)))
             (vector-set! machine 4 bl-nil) 3)
            (else (error "tail frame continuation probe pc"))))
          '#() (vector (lambda () (set! parks (+ parks 1)) (h-park "park")))))
        (owner (native-c-new-closure unit
         (list 0 8 '(1) (bl-map (bl-key "arity") 2
                                (bl-key "native-control") #f)) (list captured)))
        (frame (h-make-frames owner arguments))
        (first-turn (h-run-turn frame 1))
        (stale (vector-ref frame 0)))
  (tail-frame-check (list mode 'reused-before-suspend) reused? #t)
  (tail-frame-check (list mode 'suspends)
   (bl-get first-turn (bl-key "status")) (bl-key (symbol->string mode)))
  (tail-frame-check (list mode 'not-completed) result #f)
  (tail-frame-check (list mode 'critical-clean) seed-critical 0)
  (##gc)
  (let ((second-turn (h-run-turn frame 100)))
   (tail-frame-check (list mode 'resumes)
    (bl-get second-turn (bl-key "status")) (bl-key "done"))
   (tail-frame-check (list mode 'roots-survive)
    result (list arguments captured bl-nil))
   (tail-frame-check (list mode 'park-not-replayed) parks (if (eq? mode 'park) 1 0)))
  (let ((prior result) (stale-turn (h-run-turn (vector stale) 100)))
   (tail-frame-check (list mode 'stale-rejected)
    (bl-get stale-turn (bl-key "status")) (bl-key "error"))
   (tail-frame-check (list mode 'stale-retains-result) (eq? prior result) #t)
   (tail-frame-check (list mode 'stale-critical-clean) seed-critical 0))))
(tail-frame-suspension 'yield)
(tail-frame-suspension 'park)
(if (not (= native-tail-frame-checks 49))
 (error "C tail frame fixture count" native-tail-frame-checks))
(display "NATIVE_C_TAIL_FRAME_REUSE_ABI_PASS 49") (newline)
