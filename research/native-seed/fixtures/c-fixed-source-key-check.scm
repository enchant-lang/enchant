;; Private-key behavior only. Reuses the existing direct-control process.
(define fixed-source-key-checks 0)
(define (fixed-source-key-check label ok)
 (if (not ok) (error "private fixed Source key ABI" label))
 (set! fixed-source-key-checks (+ fixed-source-key-checks 1)))
(let ((saved-tick native-c-noactor-tick-enabled?) (saved-pure native-c-pure-bif-enabled?)
      (stock bl-key))
 (dynamic-wind
  (lambda () (set! native-c-noactor-tick-enabled? #f) (set! native-c-pure-bif-enabled? #f))
  (lambda ()
   (fixed-source-key-check 'default-key-equals-public (eq? (native-c-source-key "arity") (stock "arity")))
   (set! native-c-pure-bif-enabled? #t)
   (for-each
    (lambda (pair)
     (fixed-source-key-check 'stock-value (eq? (native-c-source-key-value (car pair) (cdr pair)) (stock (cdr pair))))
     (fixed-source-key-check 'repeat-stock-value
      (eq? (native-c-source-key-value (car pair) (cdr pair)) (stock (cdr pair)))))
    '((0 . "arity") (1 . "native-control") (2 . "call") (3 . "tail") (4 . "internal")))
   (let ((calls '()) (argument (string-copy "arity")))
    (dynamic-wind
     (lambda () (set! bl-key (lambda (name) (set! calls (cons name calls)) (stock name))))
     (lambda ()
      (native-c-source-key "arity") (native-c-source-key "arity")
      (fixed-source-key-check 'custom-key-called-every-use (= 2 (length calls)))
      (native-c-source-key argument)
      (fixed-source-key-check 'computed-key-preserves-argument-object (eq? argument (car calls)))
      (native-c-source-key "other-key")
      (fixed-source-key-check 'arbitrary-literal-keeps-public-call (= 4 (length calls)))
      (set! native-c-pure-bif-enabled? #f)
      (native-c-source-key "arity")
      (fixed-source-key-check 'feature-off-keeps-effects (= 5 (length calls))))
     (lambda () (set! bl-key stock) (set! native-c-pure-bif-enabled? #t))))
   (for-each
    (lambda (spec)
     (let ((original (car spec)) (install (cadr spec)) (calls 0))
      (dynamic-wind
       (lambda () (install (lambda args (set! calls (+ calls 1)) (apply original args))))
       (lambda ()
        (native-c-source-key "arity") (native-c-source-key "arity")
        (fixed-source-key-check 'mutable-key-helper-effects-preserved (= 2 calls)))
       (lambda () (install original)))))
    (list (list native-key-intern (lambda (f) (set! native-key-intern f)))
          (list native-scalar-keyword-intern (lambda (f) (set! native-scalar-keyword-intern f)))
          (list native-utf16-fragment? (lambda (f) (set! native-utf16-fragment? f)))
          (list bl-tag? (lambda (f) (set! bl-tag? f)))))
   (fixed-source-key-check 'restored-stock-symbol (eq? (native-c-source-key "call") (stock "call"))))
  (lambda () (set! bl-key stock) (set! native-c-noactor-tick-enabled? saved-tick)
             (set! native-c-pure-bif-enabled? saved-pure))))
(display "NATIVE_C_FIXED_SOURCE_KEYS_PASS ") (display fixed-source-key-checks) (newline)
