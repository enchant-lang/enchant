;; Existing pure-host extra process; actual maps/get/3 boundary and the same
;; specialized vector/set/opaque projections as before the plain-map fast path.
(define native-mapget-checks 0)
(define (native-mapget-check label ok)
 (if (not ok) (error (string-append "native raw-map-get check failed: " label)))
 (set! native-mapget-checks (+ native-mapget-checks 1)))
(let* ((get3 (native-leaf "maps/get/3")) (key (bl-key "present"))
       (absent (bl-key "absent")) (default (bl-vec '(99 100)))
       (map (bl-map key bl-nil (bl-key "false") #f (bl-key "zero") 0)))
 (native-mapget-check "present nil does not select default" (bl-is-nil (bl-invoke get3 (list key map default))))
 (native-mapget-check "present false does not select default" (eq? #f (bl-invoke get3 (list (bl-key "false") map default))))
 (native-mapget-check "present zero does not select default" (= 0 (bl-invoke get3 (list (bl-key "zero") map default))))
 (native-mapget-check "missing key returns the exact default value" (eq? default (bl-invoke get3 (list absent map default))))
 (native-mapget-check "missing key accepts nil default" (bl-is-nil (bl-invoke get3 (list absent map bl-nil))))
 (native-mapget-check "missing key accepts false default" (eq? #f (bl-invoke get3 (list absent map #f))))
 (native-mapget-check "lookup preserves original map membership" (and (= 3 (native-map-count map)) (not (native-map-has? map absent))))
 (let ((caught #f))
  (with-exception-catcher (lambda (e) (set! caught e)) (lambda () (bl-invoke get3 (list key 7 default))))
  (native-mapget-check "nonmap number still raises a raw error" (and caught (native-raised? caught) (eq? (native-exception-kind caught) (bl-key "error")))))
 (let ((caught #f))
  (with-exception-catcher (lambda (e) (set! caught e)) (lambda () (bl-invoke get3 (list key '(1 2) default))))
  (native-mapget-check "nonmap list still raises a raw error" (and caught (native-raised? caught) (eq? (native-exception-kind caught) (bl-key "error")))))
 (let* ((module (bl-key "Elixir.RawMapGetStruct")) (value (bl-struct module (bl-map key bl-nil))))
  (native-mapget-check "plain struct tag is preserved" (eq? module (bl-invoke get3 (list (bl-key "__struct__") value default))))
  (native-mapget-check "plain struct nil field remains present" (bl-is-nil (bl-invoke get3 (list key value default))))
  (native-mapget-check "plain struct missing field returns default" (eq? default (bl-invoke get3 (list absent value default)))))
 (let* ((meta (bl-map (bl-key "line") 8)) (value (native-vector-with-meta (bl-vec '(1 2)) meta)))
  (native-mapget-check "special vector retains canonical struct tag"
   (eq? (bl-key "Elixir.BeamLisp.Vector") (bl-invoke get3 (list (bl-key "__struct__") value default))))
  (native-mapget-check "special vector retains metadata projection" (eq? meta (bl-invoke get3 (list (bl-key "meta") value default))))
  (native-mapget-check "special vector missing field returns default" (eq? default (bl-invoke get3 (list absent value default)))))
 (let ((members (bl-invoke get3 (list (bl-key "members") (native-set-from-list '(1 2)) default))))
  (native-mapget-check "special set retains canonical MapSet membership struct" (eq? (bl-key "Elixir.MapSet") (native-struct-module members))))
 (let* ((module (bl-key "Elixir.RawMapGetOpaque")) (value (vector 'native-mapget-test)))
  (native-register-struct! value module (lambda (ignored) (bl-map key bl-nil)))
  (native-mapget-check "opaque struct present nil stays present" (bl-is-nil (bl-invoke get3 (list key value default))))
  (native-mapget-check "opaque struct retains canonical module tag" (eq? module (bl-invoke get3 (list (bl-key "__struct__") value default))))
  (native-mapget-check "opaque struct missing field returns default" (eq? default (bl-invoke get3 (list absent value default))))))
(display "native raw-map-get checks: ") (display native-mapget-checks) (newline)
