;; Host action/continuation ABI ONLY; not an emitted-C or BL Source gate.
;; A tiny Scheme step stand-in supplies fixed driver actions. No ANF is read,
;; interpreted, rewritten or substituted for an authored program.
(define native-critical-continuation-checks 0)
(define (critical-continuation-check label actual expected)
 (if (not (equal? actual expected))
  (error "C critical continuation ABI" label actual expected))
 (set! native-critical-continuation-checks (+ native-critical-continuation-checks 1)))
(define (critical-continuation-action machine kind operation next arguments)
 (vector-set! machine 4 operation)
 (vector-set! machine 5 1)
 (vector-set! machine 6 next)
 (vector-set! machine 7 arguments)
 (vector-set! machine 8 #f)
 (vector-set! machine 11 bl-nil)
 kind)
(define (critical-continuation-probe mode)
 (let* ((observed #f) (parks 0) (child #f)
        (services
         (vector h-critical-enter h-critical-leave
          (lambda () (set! observed seed-critical) bl-nil)
          (lambda () (set! parks (+ parks 1)) (h-park "park"))))
        (unit
         (vector
          (lambda (machine)
           (case (vector-ref machine 1)
            ;; Source owner enters a section, calls a real child, observes its
            ;; restored depth, then closes the section before returning.
            ((0) (critical-continuation-action machine 1 0 1 '()))
            ((1) (critical-continuation-action machine 2 child 2 '()))
            ((2) (critical-continuation-action machine 1 2 3 '()))
            ((3) (critical-continuation-action machine 1 1 4 '()))
            ((4) (vector-set! machine 4 bl-nil) 3)
            ;; Child entry depth is1. It leaves that section before suspension;
            ;; returning AFTER resume must restore1, rather than the live0.
            ((10) (critical-continuation-action machine 1 1 11 '()))
            ((11) (if (eq? mode 'yield)
                   (begin (vector-set! machine 6 12) 5)
                   (critical-continuation-action machine 1 3 12 '())))
            ((12) (vector-set! machine 4 bl-nil) 3)
            (else (error "unexpected continuation probe pc"))))
          '#() services))
        (source (lambda (name)
          (bl-map (bl-key "arity") 0 (bl-key "fn") name (bl-key "native-control") #f)))
        (owner (native-c-new-closure unit (list 0 3 '() (source "critical-owner")) '()))
        (_ (set! child (native-c-new-closure unit (list 10 3 '() (source "critical-child")) '())))
        (frame (h-make-frames owner '()))
        (prior-gc native-c-gc-between-steps?))
  (set! native-c-gc-between-steps? #t)
  (let* ((first-turn (h-run-turn frame 1))
         (suspended (vector-ref frame 0)))
   (critical-continuation-check (list mode 'suspends)
    (bl-get first-turn (bl-key "status")) (bl-key (symbol->string mode)))
   (critical-continuation-check (list mode 'turn-critical-clean) seed-critical 0)
   (critical-continuation-check (list mode 'not-returned) observed #f)
   ;; Both machine ownership slots and physical caller fields must survive.
   (##gc)
   (let ((second-turn (h-run-turn frame 100)))
    (critical-continuation-check (list mode 'resumes-once)
     (bl-get second-turn (bl-key "status")) (bl-key "done"))
    (critical-continuation-check (list mode 'restored-child-entry) observed 1)
    (critical-continuation-check (list mode 'owner-restored) seed-critical 0)
    (critical-continuation-check (list mode 'park-not-replayed) parks (if (eq? mode 'park) 1 0)))
   ;; Retain the OLD suspension thunk explicitly: it must not be reusable even
   ;; after the machine's normal return and after collections during execution.
   (let ((stale (h-run-turn (vector suspended) 100)))
    (critical-continuation-check (list mode 'stale-rejected)
     (bl-get stale (bl-key "status")) (bl-key "error"))
    (critical-continuation-check (list mode 'stale-cannot-change-depth) seed-critical 0)))
  (set! native-c-gc-between-steps? prior-gc)))
(set! seed-critical 0)
(critical-continuation-probe 'yield)
(critical-continuation-probe 'park)
(display "NATIVE_C_CRITICAL_CONTINUATIONS_PASS ")
(display native-critical-continuation-checks) (newline)
