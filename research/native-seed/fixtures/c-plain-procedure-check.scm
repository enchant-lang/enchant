;; Host ABI only. Load after the complete machine/control/raw/remote/make-fun
;; stack. These fixed action records do not interpret BL Source or ANF.
(define c-plain-checks 0)
(define (c-plain-check label ok)
 (if (not ok) (error "C plain-procedure dispatch ABI" label))
 (set! c-plain-checks (+ c-plain-checks 1)))
(define c-plain-guard native-c-direct-procedure?)
(define c-plain-function (bl-register-callable! (lambda (x) (+ x 1)) 1))
(define (c-plain-machine tail?)
 (vector (vector #f '#() '#()) 0 (vector '() bl-nil bl-nil) '() bl-nil 2 77 '()
  tail? bl-nil
  (list (bl-map (bl-key "fn") "caller" (bl-key "call") (bl-key "direct")))
  (bl-map (bl-key "fn") "site" (bl-key "call") (bl-key "direct")) 0 #t))
(define (c-plain-action function arguments slow? tail?)
 (let ((saved native-c-direct-procedure?) (critical seed-critical)
       (machine (c-plain-machine tail?)))
  (dynamic-wind
   (lambda () (if slow? (set! native-c-direct-procedure? (lambda (x) #f))))
   (lambda ()
    (let ((done (native-c-apply-action machine function arguments)))
     (list done (vector-ref machine 1) (vector-ref (vector-ref machine 2) 2)
           (vector-ref machine 9) seed-critical (vector-ref machine 10))))
   (lambda () (set! native-c-direct-procedure? saved) (set! seed-critical critical)))))
(c-plain-check 'ordinary-guard-active (native-c-direct-procedure? c-plain-function))
(c-plain-check 'global-invoke (= 6 (bl-invoke c-plain-function '(5))))
(c-plain-check 'raw-apply-excluded (not (native-c-direct-procedure? native-raw-apply)))
(c-plain-check 'backend-raw-apply-excluded (not (native-c-direct-procedure? native-c-raw-apply2)))
(c-plain-check 'nonfunction-excluded (not (native-c-direct-procedure? (bl-key "nil"))))
(c-plain-check 'c-descriptor-excluded
 (not (native-c-direct-procedure? (vector native-c-closure-marker #f 0 2 '() '() bl-nil))))
(let ((multi (bl-tuple (list (bl-key "$blfn") (bl-map 1 c-plain-function) bl-nil))))
 (c-plain-check 'multi-dispatch-excluded (not (native-c-direct-procedure? multi)))
 (c-plain-check 'multi-dispatch-retains-real-planner (= 7 (bl-invoke multi '(6)))))
(c-plain-check 'raw-apply-retains-strict-adapter
 (= 10 (bl-invoke native-c-raw-apply2 (list c-plain-function '(9)))))
(c-plain-check 'non-tail-state-equal
 (bl-equal? (c-plain-action c-plain-function '(5) #f #f)
            (c-plain-action c-plain-function '(5) #t #f)))
(c-plain-check 'tail-state-equal
 (bl-equal? (c-plain-action c-plain-function '(5) #f #t)
            (c-plain-action c-plain-function '(5) #t #t)))
(let ((original seed-critical) (function (lambda () (h-critical-enter) 71)))
 (dynamic-wind
  (lambda () (set! seed-critical 7))
  (lambda ()
   (let ((fast (c-plain-action function '() #f #t))
         (slow (c-plain-action function '() #t #t)))
    (c-plain-check 'critical-tail-state-equal (bl-equal? fast slow))
    (c-plain-check 'critical-tail-restores-owner (= 0 (list-ref fast 4)))))
  (lambda () (set! seed-critical original))))
(let ((observed #f)
      (callback (lambda () (bl-get (car (native-logical-frames)) (bl-key "fn")))))
 (let* ((machine (c-plain-machine #f))
        (_ (native-c-apply-action machine callback '())))
  (c-plain-check 'source-site-during-callback
   (string=? "site" (vector-ref (vector-ref machine 2) 2)))
  (c-plain-check 'source-entry-restored
   (string=? "caller" (bl-get (car (vector-ref machine 10)) (bl-key "fn"))))))
(let ((fast #f) (slow #f))
 (with-exception-catcher (lambda (e) (set! fast e))
  (lambda () (c-plain-action c-plain-function '(1 2) #f #f)))
 (with-exception-catcher (lambda (e) (set! slow e))
  (lambda () (c-plain-action c-plain-function '(1 2) #t #f)))
 (c-plain-check 'wrong-arity-same-target-and-arguments
  (and (wrong-number-of-arguments-exception? fast) (wrong-number-of-arguments-exception? slow)
   (eq? (wrong-number-of-arguments-exception-procedure fast)
        (wrong-number-of-arguments-exception-procedure slow))
   (equal? (wrong-number-of-arguments-exception-arguments fast)
           (wrong-number-of-arguments-exception-arguments slow)))))
(let ((original native-resolve-call) (calls 0))
 (dynamic-wind
  (lambda () (set! native-resolve-call (lambda (callee args)
   (set! calls (+ calls 1))
   (if (eq? callee c-plain-function) (cons (lambda (x) (+ x 100)) '(9))
    (original callee args)))))
  (lambda ()
   (c-plain-check 'language-planner-disables (not (native-c-direct-procedure? c-plain-function)))
   (c-plain-check 'language-planner-target-arguments (= 109 (bl-invoke c-plain-function '(1))))
   (c-plain-check 'language-planner-double-pass-preserved (= calls 2)))
  (lambda () (set! native-resolve-call original))))
(let ((original native-c-resolve-call))
 (dynamic-wind
  (lambda () (set! native-c-resolve-call (lambda (callee args) (cons (lambda () 301) '()))))
  (lambda ()
   (c-plain-check 'complete-c-planner-disables (not (native-c-direct-procedure? c-plain-function)))
   (c-plain-check 'complete-c-planner-owned-target (= 301 (bl-invoke c-plain-function '(1)))))
  (lambda () (set! native-c-resolve-call original))))
(let ((original native-multi-callable?) (calls 0))
 (dynamic-wind
  (lambda () (set! native-multi-callable? (lambda (value) (set! calls (+ calls 1)) (original value))))
  (lambda ()
   (c-plain-check 'language-predicate-disables (not (native-c-direct-procedure? c-plain-function)))
   (c-plain-check 'language-predicate-result (= 3 (bl-invoke c-plain-function '(2))))
   (c-plain-check 'language-predicate-observed (> calls 0)))
  (lambda () (set! native-multi-callable? original))))
(let ((original native-c-remote?) (calls 0))
 (dynamic-wind
  (lambda () (set! native-c-remote? (lambda (value) (set! calls (+ calls 1)) (original value))))
  (lambda ()
   (c-plain-check 'remote-predicate-disables (not (native-c-direct-procedure? c-plain-function)))
   (c-plain-check 'remote-predicate-result (= 4 (bl-invoke c-plain-function '(3))))
   (c-plain-check 'remote-predicate-observed (> calls 0)))
  (lambda () (set! native-c-remote? original))))
(let ((original native-c-resolve-without-external-funs))
 (dynamic-wind
  (lambda () (set! native-c-resolve-without-external-funs (lambda (callee args) (cons (lambda () 302) '()))))
  (lambda ()
   (c-plain-check 'middle-c-planner-disables (not (native-c-direct-procedure? c-plain-function)))
   (c-plain-check 'middle-c-planner-owned-target (= 302 (bl-invoke c-plain-function '(1)))))
  (lambda () (set! native-c-resolve-without-external-funs original))))
(let ((original native-c-resolve-without-remote))
 (dynamic-wind
  (lambda () (set! native-c-resolve-without-remote (lambda (callee args) (cons (lambda () 303) '()))))
  (lambda ()
   (c-plain-check 'base-c-planner-disables (not (native-c-direct-procedure? c-plain-function)))
   (c-plain-check 'base-c-planner-owned-target (= 303 (bl-invoke c-plain-function '(1)))))
  (lambda () (set! native-c-resolve-without-remote original))))
(let ((original native-c-fallback-invoke) (calls 0))
 (dynamic-wind
  (lambda () (set! native-c-fallback-invoke (lambda (callee args)
   (set! calls (+ calls 1)) (original callee args))))
  (lambda ()
   (c-plain-check 'fallback-invoker-disables (not (native-c-direct-procedure? c-plain-function)))
   (c-plain-check 'fallback-invoker-owned-call (= 8 (bl-invoke c-plain-function '(7))))
   (c-plain-check 'fallback-invoker-observed (= calls 1)))
  (lambda () (set! native-c-fallback-invoke original))))
(let ((original bl-invoke) (calls 0))
 (dynamic-wind
  (lambda () (set! bl-invoke (lambda (callee args) (set! calls (+ calls 1)) (original callee args))))
  (lambda ()
   (c-plain-check 'global-invoker-disables (not (native-c-direct-procedure? c-plain-function)))
   (let ((machine (c-plain-machine #f)))
    (native-c-apply-action machine (lambda (x) (bl-invoke c-plain-function (list x))) '(10))
    (c-plain-check 'nested-callback-invoker-owned-call
     (= 11 (vector-ref (vector-ref machine 2) 2)))
    (c-plain-check 'nested-callback-hook-observed (= calls 1))))
  (lambda () (set! bl-invoke original))))
(let ((external (lambda (x) x)))
 (dynamic-wind
  (lambda () (table-set! native-c-external-funs external (vector (bl-key "unused") (bl-key "unused") 1)))
  (lambda () (c-plain-check 'external-forwarder-never-bypassed (not (native-c-direct-procedure? external))))
  (lambda () (table-set! native-c-external-funs external))))
(c-plain-check 'guard-restored (native-c-direct-procedure? c-plain-function))
(display "NATIVE_C_PLAIN_PROCEDURE_ABI_PASS ") (display c-plain-checks) (newline)
