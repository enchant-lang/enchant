;; Load after the C host. These steps probe host transport, not C emission.
(define native-c-trace-check-count 0)
(define (native-c-trace-check label condition)
 (if (not condition) (error "C raw Source trace ABI" label))
 (set! native-c-trace-check-count (+ native-c-trace-check-count 1)))
(define (native-c-trace-test-closure step)
 (native-c-new-closure (vector step '#() '#())
  (list 0 2 '() (bl-map (bl-key "arity") 0 (bl-key "fn") "raw-c-source-probe"
                       (bl-key "native-control") #f)) '()))
(set! seed-critical 0)
(let* ((function (native-c-trace-test-closure
                  (lambda (machine) (set! seed-critical 2) (error "raw C Source trace probe"))))
       (caught (with-exception-catcher (lambda (exception) exception)
                 (lambda () (native-c-invoke function '())))))
 (native-c-trace-check 'raw-host-normalized (native-raised? caught))
 (native-c-trace-check 'raw-host-error-class
  (eq? (native-exception-kind caught) (bl-key "error")))
 (native-c-trace-check 'child-source-retained
  (let ((frames (native-c-caught-frames (native-exception-trace caught))))
   (and (pair? frames)
        (equal? (bl-get (car frames) (bl-key "fn")) "raw-c-source-probe"))))
 (native-c-trace-check 'raw-error-critical-restored (= seed-critical 0)))
(let* ((trace (bl-tuple (list '() (list (bl-map (bl-key "fn") "original-raw-trace")))))
       (sentinel (vector native-raise-marker (bl-key "throw") (bl-key "reason") trace))
       (function (native-c-trace-test-closure (lambda (machine) (raise sentinel))))
       (caught (with-exception-catcher (lambda (exception) exception)
                 (lambda () (native-c-invoke function '())))))
 (native-c-trace-check 'existing-envelope-identity (eq? caught sentinel))
 (native-c-trace-check 'existing-raw-trace-identity (eq? (native-exception-trace caught) trace)))
(display "NATIVE_C_RAW_SOURCE_TRACE_ABI_PASS ")
(display native-c-trace-check-count) (newline)
