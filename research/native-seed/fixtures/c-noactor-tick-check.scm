;; Host scheduling/action ABI only. Fixed steps below are transport probes,
;; not an authored Source body, evaluator, or scheduler implementation.
(define native-noactor-tick-checks 0)
(define (noactor-tick-check label actual expected)
 (if (not (equal? actual expected))
  (error "optional noactor tick ABI" label actual expected))
 (set! native-noactor-tick-checks (+ native-noactor-tick-checks 1)))
(let ((saved-frame seed-frame) (saved-budget seed-budget)
      (saved-critical seed-critical) (saved-yields seed-yields)
      (saved-tick h-tick) (saved-frames native-logical-frames)
      (saved-after native-c-after-step!)
      (saved-gc native-c-gc-between-steps?) (saved-interval native-c-gc-interval)
      (saved-enabled native-c-noactor-tick-enabled?)
      (saved-count native-c-noactor-ticks-elided)
      (saved-refresh native-c-refresh-pure-bifs!)
      (saved-record native-c-record-pure-bifs!)
      (saved-pure-enabled native-c-pure-bif-enabled?))
 (define (restore)
  (set! seed-frame saved-frame) (set! seed-budget saved-budget)
  (set! seed-critical saved-critical) (set! seed-yields saved-yields)
  (set! h-tick saved-tick) (set! native-logical-frames saved-frames)
  (set! native-c-after-step! saved-after)
  (set! native-c-gc-between-steps? saved-gc) (set! native-c-gc-interval saved-interval)
  (set! native-c-noactor-tick-enabled? saved-enabled)
  (set! native-c-noactor-ticks-elided saved-count)
  (set! native-c-refresh-pure-bifs! saved-refresh)
  (set! native-c-record-pure-bifs! saved-record)
  (set! native-c-pure-bif-enabled? saved-pure-enabled))
 (define (closure step)
  (native-c-new-closure (vector step '#() '#() 0 step)
   (list 0 2 '() (bl-map (bl-key "arity") 0
                        (bl-key "native-control") #f)) '()))
 (define (tick-action machine next)
  (vector-set! machine 4 0) (vector-set! machine 5 0)
  (vector-set! machine 6 next) (vector-set! machine 7 '())
  (vector-set! machine 8 #f) (vector-set! machine 11 bl-nil) 5)
 (define tick-closure
  (closure (lambda (machine)
   (if (= (vector-ref machine 1) 0) (tick-action machine 1)
    (begin (vector-set! machine 4 bl-nil) 3)))))
 (with-exception-catcher (lambda (failure) (restore) (raise failure))
  (lambda ()
   (set! seed-frame #f) (set! seed-budget 77) (set! seed-critical 0)
   (set! native-c-gc-between-steps? #f) (set! native-c-gc-interval 0)
   (set! native-c-refresh-pure-bifs! (lambda (machine) #f))
   (set! native-c-record-pure-bifs! (lambda (machine) #f))
   (set! native-c-pure-bif-enabled? #f)
   (noactor-tick-check 'unverified-addon-default-disabled native-c-noactor-tick-enabled? #f)
   (set! native-c-noactor-tick-enabled? #t)
   (noactor-tick-check 'explicit-stock-opt-in (native-c-noactor-tick-allowed?) #t)
   (set! seed-critical 3)
   (noactor-tick-check 'noactor-critical-is-still-inert (native-c-noactor-tick-allowed?) #t)
   (h-tick)
   (noactor-tick-check 'stock-noactor-keeps-budget seed-budget 77)
   (noactor-tick-check 'stock-noactor-keeps-critical seed-critical 3)
   (set! seed-critical 0) (set! seed-frame (vector #f))
   (noactor-tick-check 'active-frame-refuses-elision (native-c-noactor-tick-allowed?) #f)
   (set! seed-frame #f)
   (let ((calls 0))
    (set! h-tick (lambda () (set! calls (+ calls 1)) (saved-tick)))
    (noactor-tick-check 'custom-tick-refuses-elision (native-c-noactor-tick-allowed?) #f)
    (native-c-invoke tick-closure '())
    (noactor-tick-check 'custom-tick-effects-preserved calls 1)
    (set! h-tick saved-tick))
   (let* ((calls 0)
          (parameter (make-parameter '() (lambda (value) (set! calls (+ calls 1)) value)))
          (before calls))
    (set! native-logical-frames parameter)
    (noactor-tick-check 'custom-frame-parameter-refuses-elision (native-c-noactor-tick-allowed?) #f)
    (native-c-invoke tick-closure '())
    (noactor-tick-check 'frame-converter-effects-preserved (> calls before) #t)
    (set! native-logical-frames saved-frames))
   (let ((calls 0))
    (set! native-c-after-step! (lambda () (set! calls (+ calls 1)) (saved-after)))
    (noactor-tick-check 'custom-step-hook-refuses-elision (native-c-noactor-tick-allowed?) #f)
    (native-c-invoke tick-closure '())
    (noactor-tick-check 'step-hook-observes-both-actions calls 2)
    (set! native-c-after-step! saved-after))
   (set! native-c-gc-between-steps? #t)
   (noactor-tick-check 'every-step-GC-refuses-elision (native-c-noactor-tick-allowed?) #f)
   (set! native-c-gc-between-steps? #f) (set! native-c-gc-interval 997)
   (noactor-tick-check 'interval-GC-refuses-elision (native-c-noactor-tick-allowed?) #f)
   (set! native-c-gc-interval "invalid")
   (noactor-tick-check 'invalid-interval-stays-on-original-error-path (native-c-noactor-tick-allowed?) #f)
   (set! native-c-gc-interval 0)
   (noactor-tick-check 'restored-stock-recovers (native-c-noactor-tick-allowed?) #t)
   (noactor-tick-check 'legacy14-has-no-extension (native-c-tick-extension (make-vector 14 #f)) #f)
   (let ((machine (make-vector 15 #f)) (step (lambda (machine) 3)))
    (vector-set! machine 0 (vector step '#() '#() 0 step))
    (vector-set! machine 14 (vector 1 0))
    (noactor-tick-check 'short-extension-refused (native-c-tick-extension machine) #f)
    (vector-set! machine 14 (vector 2 0 0 '#() 0))
    (noactor-tick-check 'unknown-extension-version-refused (native-c-tick-extension machine) #f)
    (let ((extension (vector 1 0 37 '#(ledger) 13)) (before native-c-noactor-ticks-elided))
     (vector-set! machine 14 extension)
     (native-c-prepare-noactor-tick! machine)
     (noactor-tick-check 'stock-step-arms-state (vector-ref extension 1) 1)
     (noactor-tick-check 'independent-fields-preserved
      (list (vector-ref extension 2) (vector-ref extension 3) (vector-ref extension 4))
      '(37 #(ledger) 13))
     (vector-set! extension 1 2)
     (native-c-record-noactor-tick! machine)
     (noactor-tick-check 'actual-elision-recorded native-c-noactor-ticks-elided (+ before 1))
     (noactor-tick-check 'eligibility-reset-before-Scheme-hooks (vector-ref extension 1) 0)
     (native-c-record-noactor-tick! machine)
     (noactor-tick-check 'record-is-one-shot native-c-noactor-ticks-elided (+ before 1))
     (set! seed-frame (vector #f))
     (native-c-prepare-noactor-tick! machine)
     (noactor-tick-check 'actor-preparation-stays-disabled (vector-ref extension 1) 0)
     (set! seed-frame #f) (set! native-c-gc-interval 997)
     (native-c-prepare-noactor-tick! machine)
     (noactor-tick-check 'stress-preparation-stays-disabled (vector-ref extension 1) 0)
     (set! native-c-gc-interval 0)))
   (let ((machine (make-vector 15 #f)) (step (lambda (machine) 3)))
    (vector-set! machine 0 (vector step '#() '#()))
    (noactor-tick-check 'legacy3-step-has-no-witness (native-c-owned-step? machine) #f)
    (vector-set! machine 0 (vector step '#() '#() 0))
    (noactor-tick-check 'legacy4-step-has-no-witness (native-c-owned-step? machine) #f)
    (vector-set! machine 0 (vector #f '#() '#() 0 #f))
    (noactor-tick-check 'nonprocedure-is-not-owned (native-c-owned-step? machine) #f)
    (vector-set! machine 0 (vector step '#() '#() 0 step))
    (noactor-tick-check 'captured-step-is-owned (native-c-owned-step? machine) #t)
    (vector-set! (vector-ref machine 0) 0 (lambda (machine) (step machine)))
    (noactor-tick-check 'profiling-wrapper-is-not-owned (native-c-owned-step? machine) #f)
    (vector-set! (vector-ref machine 0) 0 step)
    (noactor-tick-check 'original-step-restoration-recovers (native-c-owned-step? machine) #t))
   (let* ((calls 0) (modes '()) (before native-c-noactor-ticks-elided)
          (actor (closure (lambda (machine)
           (if (= (vector-ref machine 1) 0)
            (if (= (vector-ref (vector-ref machine 14) 1) 1)
             (begin (vector-set! (vector-ref machine 14) 1 2)
                    (vector-set! machine 4 bl-nil) 3)
             (tick-action machine 1))
            (begin (vector-set! machine 4 bl-nil) 3)))))
          (unit (vector-ref actor 1)) (original (vector-ref unit 0))
          (tick (lambda () (set! calls (+ calls 1)) (saved-tick))))
    (vector-set! unit 0 (lambda (machine)
     (set! modes (cons (vector-ref (vector-ref machine 14) 1) modes))
     (set! h-tick tick) (original machine)))
    (native-c-invoke actor '())
    (noactor-tick-check 'wrapped-step-never-armed modes '(0 0))
    (noactor-tick-check 'wrapper-installed-tick-runs calls 1)
    (noactor-tick-check 'wrapper-does-not-elide native-c-noactor-ticks-elided before)
    (set! h-tick saved-tick))
   (let ((events '()) (seen #f) (recorded #f) (machine-seen #f)
         (before native-c-noactor-ticks-elided))
    (set! native-c-refresh-pure-bifs! (lambda (machine) (set! events (cons 'refresh events))))
    (set! native-c-record-pure-bifs! (lambda (machine)
     (set! recorded (vector-ref (vector-ref machine 14) 1))
     (set! events (cons 'pure-record events))))
    (native-c-invoke
     (closure (lambda (machine)
      (set! machine-seen machine)
      (set! seen (vector-ref (vector-ref machine 14) 1))
      (set! events (cons 'C-step events))
      ;; Host action probe of the header's2 mark; actual C is checked below in
      ;; the same existing POSIX ELF by c-noactor-tick-header-check.scm.
      (vector-set! (vector-ref machine 14) 1 2)
      (vector-set! machine 4 bl-nil) 3)) '())
    (noactor-tick-check 'extension-hook-order (reverse events) '(refresh C-step pure-record))
    (noactor-tick-check 'tick-prepared-after-pure-refresh seen 1)
    (noactor-tick-check 'tick-reset-before-pure-record recorded 0)
    (noactor-tick-check 'driver-counts-elision native-c-noactor-ticks-elided (+ before 1))
    (noactor-tick-check 'fresh-extension-layout
     (list (vector-length machine-seen) (vector-length (vector-ref machine-seen 14))
           (vector-ref (vector-ref machine-seen 14) 0)) '(15 5 1)))
   (set! native-c-refresh-pure-bifs! (lambda (machine) #f))
   (set! native-c-record-pure-bifs! (lambda (machine) #f))
   (let* ((actor-mode #f)
          (actor (closure (lambda (machine)
           (if (= (vector-ref machine 1) 0)
            (begin (set! actor-mode (vector-ref (vector-ref machine 14) 1))
                   (tick-action machine 1))
            (begin (vector-set! machine 4 bl-nil) 3)))))
          (frame (h-make-frames actor '())) (first (h-run-turn frame 1))
          (stale (vector-ref frame 0)))
    (noactor-tick-check 'actor-yields-at-budget (bl-get first (bl-key "status")) (bl-key "yield"))
    (noactor-tick-check 'actor-C-mode-disabled actor-mode 0)
    (noactor-tick-check 'actor-budget-consumed seed-budget 0)
    (noactor-tick-check 'actor-turn-critical-clean seed-critical 0)
    (noactor-tick-check 'actor-resumes-once
     (bl-get (h-run-turn frame 100) (bl-key "status")) (bl-key "done"))
    (noactor-tick-check 'actor-old-continuation-refused
     (bl-get (h-run-turn (vector stale) 100) (bl-key "status")) (bl-key "error")))
   (let* ((inside-budget #f) (inside-critical #f) (modes '())
          (actor (closure (lambda (machine)
           (case (vector-ref machine 1)
            ((0) (set! modes (cons (vector-ref (vector-ref machine 14) 1) modes))
                 (h-critical-enter) (tick-action machine 1))
            ((1) (set! inside-budget seed-budget) (set! inside-critical seed-critical)
                 (set! modes (cons (vector-ref (vector-ref machine 14) 1) modes))
                 (h-critical-leave) (tick-action machine 2))
            ((2) (vector-set! machine 4 bl-nil) 3)))))
          (frame (h-make-frames actor '())) (first (h-run-turn frame 1))
          (stale (vector-ref frame 0)))
    (noactor-tick-check 'critical-yield-after-leave (bl-get first (bl-key "status")) (bl-key "yield"))
    (noactor-tick-check 'critical-tick-consumes-budget inside-budget 0)
    (noactor-tick-check 'critical-tick-does-not-yield inside-critical 1)
    (noactor-tick-check 'critical-actor-mode-disabled modes '(0 0))
    (noactor-tick-check 'next-tick-observes-overdraw seed-budget -1)
    (noactor-tick-check 'critical-actor-resumes
     (bl-get (h-run-turn frame 100) (bl-key "status")) (bl-key "done"))
    (noactor-tick-check 'critical-owner-restored seed-critical 0)
    (noactor-tick-check 'critical-old-continuation-refused
     (bl-get (h-run-turn (vector stale) 100) (bl-key "status")) (bl-key "error")))))
 (restore))
(if (not (= native-noactor-tick-checks 54))
 (error "optional noactor tick fixture count" native-noactor-tick-checks))
(display "NATIVE_C_NOACTOR_TICK_ABI_PASS 54") (newline)
