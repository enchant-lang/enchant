;; Host identity qualification only; does not reset or imitate actor state.
(define native-runtime-id-check-count 0)
(define (native-runtime-id-check label condition)
 (if (not condition) (error "native runtime identity contract failed" label))
 (set! native-runtime-id-check-count (+ native-runtime-id-check-count 1)))
(let* ((first-id (bl-get seed-state (bl-key "runtime")))
       (before-clock seed-clock)
       (before-reference native-unique-counter)
       (second-id (native-allocate-runtime-id!))
       (third-id (native-allocate-runtime-id!)))
 (native-runtime-id-check 'positive-integer (and (integer? first-id) (exact? first-id) (> first-id 0)))
 (native-runtime-id-check 'first-host-allocation (= first-id 1))
 (native-runtime-id-check 'allocated-next (= second-id (+ first-id 1)))
 (native-runtime-id-check 'allocated-distinct (= third-id (+ second-id 1)))
 (native-runtime-id-check 'retained-instance (= first-id (bl-get seed-state (bl-key "runtime"))))
 (native-runtime-id-check 'clock-independent (= before-clock seed-clock))
 (native-runtime-id-check 'reference-independent (= before-reference native-unique-counter)))
(display "NATIVE_RUNTIME_ID_ABI_PASS ") (display native-runtime-id-check-count) (newline)
