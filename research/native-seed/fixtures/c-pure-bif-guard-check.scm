;; Guard/state ABI only. Existing scalar C/LLVM executions witness actual
;; instruction coverage; these Scheme stand-ins never replace authored bodies.
(define pure-bif-checks 0)
(define (pure-bif-check label ok)
 (if (not ok) (error "optional pure BIF guard ABI" label))
 (set! pure-bif-checks (+ pure-bif-checks 1)))
(let* ((saved-enabled native-c-pure-bif-enabled?) (saved-gc native-c-gc-between-steps?)
       (saved-interval native-c-gc-interval) (saved-seen native-c-pure-bif-seen)
       (saved-steps native-c-pure-bif-steps)
       (step (lambda (m) 3)) (unit (vector step '#() '#() 23 step))
       (machine (vector unit 0 '#() '() bl-nil 0 0 '() #f bl-nil '() bl-nil 0 #f (native-c-new-extension))))
 (define (mask)
  (native-c-refresh-pure-bifs! machine) (vector-ref (vector-ref machine 14) 2))
 (dynamic-wind
  (lambda () (set! native-c-pure-bif-enabled? #t)
             (set! native-c-gc-between-steps? #f) (set! native-c-gc-interval 0))
  (lambda ()
   (pure-bif-check 'owned-default-arms (= 63 (mask)))
   (set! native-c-pure-bif-enabled? #f)
   (pure-bif-check 'opt-off-clears (= 0 (mask)))
   (set! native-c-pure-bif-enabled? #t)
   (vector-set! unit 0 (lambda (m) (step m)))
   (pure-bif-check 'wrapped-step-deopts (= 0 (mask)))
   (vector-set! unit 0 step)
   (pure-bif-check 'owned-step-restores (= 63 (mask)))
   (vector-set! machine 0 (vector step '#() '#()))
   (pure-bif-check 'legacy-three-field-unit (= 0 (mask)))
   (vector-set! machine 0 (vector step '#() '#() 23))
   (pure-bif-check 'legacy-four-field-unit (= 0 (mask)))
   (vector-set! machine 0 unit)
   (set! native-c-gc-between-steps? #t)
   (pure-bif-check 'explicit-gc-deopts (= 0 (mask)))
   (set! native-c-gc-between-steps? #f) (set! native-c-gc-interval 1)
   (pure-bif-check 'gc-interval-deopts (= 0 (mask)))
   (set! native-c-gc-interval 0)
   (for-each
    (lambda (spec)
     (let ((original (car spec)) (install (cadr spec)))
      (dynamic-wind
       (lambda () (install (lambda args (apply original args))))
       (lambda () (pure-bif-check 'live-hook-deopts (= 0 (mask))))
       (lambda () (install original)))))
    (list (list native-c-after-step! (lambda (f) (set! native-c-after-step! f)))
          (list native-logical-frames (lambda (f) (set! native-logical-frames f)))
          (list bl-is-nil (lambda (f) (set! bl-is-nil f)))
          (list bl-get (lambda (f) (set! bl-get f)))
          (list bl-key (lambda (f) (set! bl-key f)))
          (list bl-truthy (lambda (f) (set! bl-truthy f)))
          (list native-key-intern (lambda (f) (set! native-key-intern f)))
          (list native-scalar-keyword-intern (lambda (f) (set! native-scalar-keyword-intern f)))
          (list native-utf16-fragment? (lambda (f) (set! native-utf16-fragment? f)))
          (list bl-tag? (lambda (f) (set! bl-tag? f)))))
   (let ((original bl-key-compare))
    (dynamic-wind
     (lambda () (set! bl-key-compare (lambda (a b) (original a b))))
     (lambda () (pure-bif-check 'strict-helper-only-deopts (= 15 (mask))))
     (lambda () (set! bl-key-compare original))))
   (let ((original native-erlang-number?))
    (dynamic-wind
     (lambda () (set! native-erlang-number? (lambda (x) (original x))))
     (lambda () (pure-bif-check 'loose-numeric-helper-only-deopts (= 55 (mask))))
     (lambda () (set! native-erlang-number? original))))
   (let ((callee (vector-ref (vector-ref (vector-ref machine 14) 3) 0)))
    (dynamic-wind
     (lambda () (table-set! native-c-external-funs callee '#(:external :target 1)))
     (lambda () (pure-bif-check 'external-target-admission-deopts-that-bif (= 62 (mask))))
     (lambda () (table-set! native-c-external-funs callee))))
   (pure-bif-check 'all-restored (= 63 (mask)))
   (let ((extension (vector-ref machine 14)))
    (set! native-c-pure-bif-seen 0) (set! native-c-pure-bif-steps 0)
    (vector-set! extension 4 23) (native-c-record-pure-bifs! machine)
    (pure-bif-check 'counter-mask (= native-c-pure-bif-seen 23))
    (pure-bif-check 'counter-steps (= native-c-pure-bif-steps 1))
    (pure-bif-check 'permissions-not-retained (= (vector-ref extension 2) 0))))
  (lambda () (set! native-c-pure-bif-enabled? saved-enabled)
             (set! native-c-gc-between-steps? saved-gc) (set! native-c-gc-interval saved-interval)
             (set! native-c-pure-bif-seen saved-seen) (set! native-c-pure-bif-steps saved-steps))))
(display "NATIVE_C_PURE_BIF_GUARDS_PASS ") (display pure-bif-checks) (newline)
