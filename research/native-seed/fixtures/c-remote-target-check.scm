;; Host ABI only. Append after the complete direct-machine/raw/remote/make-fun
;; stack and its existing fixtures. No BL/ANF body is decoded or interpreted.
(define c-target-checks 0)
(define (c-target-check label ok)
 (if (not ok) (error "C remote target cache ABI" label))
 (set! c-target-checks (+ c-target-checks 1)))
(define (c-target-refused? thunk)
 (with-exception-catcher (lambda (error) #t) (lambda () (thunk) #f)))
(let ((saved-leaves native-leaf-registry) (saved-modules native-module-names)
      (saved-arities native-export-arities) (saved-globals native-global-registry)
      (saved-excluded native-excluded-host-leaves))
 (dynamic-wind
  (lambda () #f)
  (lambda ()
   (let* ((one "c.target.one") (two "c.target.two")
          (module "Elixir.CRemoteOne") (module2 "Elixir.CRemoteTwo")
          (f (bl-register-callable! (lambda (x) (+ x 10)) 1))
          (g (bl-register-callable! (lambda (x) (+ x 100)) 1))
          (f2 (bl-register-callable! (lambda (x y) (+ x y)) 2))
          (key (string-append module "/pick/1"))
          (descriptor (native-c-parse-remote (string-copy key))))
    (set! native-module-names (bl-assoc native-module-names module one))
    (set! native-module-names (bl-assoc native-module-names module2 two))
    (native-register! one "pick" f)
    (native-register-arities! one "pick" (bl-vec '(1)) bl-nil)
    (native-register! two "pick" g)
    (native-register-arities! two "pick" (bl-vec '(1)) bl-nil)
    (native-register! one "sick" g)
    (native-register-arities! one "sick" (bl-vec '(1)) bl-nil)
    (c-target-check 'initial-source-target (eq? f (native-c-remote-target descriptor)))
    (c-target-check 'successful-publication-stored
     (not (eq? native-missing (table-ref native-c-remote-target-cache descriptor native-missing))))
    (let ((entry (table-ref native-c-remote-target-cache descriptor native-missing)))
     (c-target-check 'same-positive-target (eq? f (native-c-remote-target descriptor)))
     (c-target-check 'same-positive-entry
      (eq? entry (table-ref native-c-remote-target-cache descriptor native-missing))))
    (native-register! one "pick" g)
    (c-target-check 'held-descriptor-sees-redefinition (eq? g (native-c-remote-target descriptor)))
    (native-register! one "pick" bl-nil)
    (c-target-check 'nil-redefinition-refuses
     (c-target-refused? (lambda () (native-c-remote-target descriptor))))
    (c-target-check 'nil-failure-not-stored
     (eq? native-missing (table-ref native-c-remote-target-cache descriptor native-missing)))
    (set! native-global-registry (native-map-remove native-global-registry (string-append one "/pick")))
    (c-target-check 'removed-slot-refuses
     (c-target-refused? (lambda () (native-c-remote-target descriptor))))
    (native-register! one "pick" f)
    (c-target-check 'readded-slot-recovers (eq? f (native-c-remote-target descriptor)))
    (set! native-module-names (bl-assoc native-module-names module two))
    (c-target-check 'module-alias-replacement (eq? g (native-c-remote-target descriptor)))
    (set! native-module-names (native-map-remove native-module-names module))
    (c-target-check 'module-removal-refuses
     (c-target-refused? (lambda () (native-c-remote-target descriptor))))
    (set! native-module-names (bl-assoc native-module-names module one))
    (c-target-check 'module-readmission (eq? f (native-c-remote-target descriptor)))
    (native-register-arities! one "pick" (bl-vec '(2)) bl-nil)
    (c-target-check 'arity-removal-refuses
     (c-target-refused? (lambda () (native-c-remote-target descriptor))))
    (native-register-arities! one "pick" (bl-vec '(1)) bl-nil)
    (c-target-check 'arity-readmission (eq? f (native-c-remote-target descriptor)))
    ;; Even in-place physical arity annotations must be rechecked on a hit.
    (let ((old (table-ref native-callable-arities f #f)))
     (dynamic-wind
      (lambda () (table-set! native-callable-arities f '(2)))
      (lambda () (c-target-check 'physical-arity-rechecked
       (c-target-refused? (lambda () (native-c-remote-target descriptor)))))
      (lambda () (table-set! native-callable-arities f old))))
    (c-target-check 'physical-arity-restoration (eq? f (native-c-remote-target descriptor)))
    ;; Arity metadata is host-visible tuple storage, not a frozen cache fact.
    (let* ((metadata (bl-get native-export-arities (native-row one "pick")))
           (fields (vector-ref metadata 1)) (fixed (vector-ref fields 0)))
     (dynamic-wind
      (lambda () (vector-set! fields 0 (bl-vec '(2))))
      (lambda () (c-target-check 'same-root-metadata-mutation-refuses
       (c-target-refused? (lambda () (native-c-remote-target descriptor)))))
      (lambda () (vector-set! fields 0 fixed))))
    (c-target-check 'same-root-metadata-restoration (eq? f (native-c-remote-target descriptor)))
    (set! native-excluded-host-leaves (cons (string-copy key) native-excluded-host-leaves))
    (c-target-check 'exclusion-refuses-positive-descriptor
     (c-target-refused? (lambda () (native-c-remote-target descriptor))))
    (c-target-check 'exclusion-not-stored
     (eq? native-missing (table-ref native-c-remote-target-cache descriptor native-missing)))
    (set! native-excluded-host-leaves saved-excluded)
    (c-target-check 'exclusion-restoration (eq? f (native-c-remote-target descriptor)))
    ;; A raw leaf takes priority even after a Source result was cached.
    (set! native-leaf-registry (bl-assoc native-leaf-registry key g))
    (c-target-check 'later-leaf-priority (eq? g (native-c-remote-target descriptor)))
    (set! native-leaf-registry (bl-assoc native-leaf-registry key 73))
    (c-target-check 'raw-leaf-keeps-original-no-validation (= 73 (native-c-remote-target descriptor)))
    (set! native-leaf-registry (native-map-remove native-leaf-registry key))
    (c-target-check 'removed-leaf-restores-source (eq? f (native-c-remote-target descriptor)))
    (let ((missing (native-c-parse-remote "Elixir.CRemoteAbsent/later/1")))
     (c-target-check 'missing-refuses (c-target-refused? (lambda () (native-c-remote-target missing))))
     (c-target-check 'missing-not-cached
      (eq? native-missing (table-ref native-c-remote-target-cache missing native-missing)))
     (set! native-leaf-registry (bl-assoc native-leaf-registry "Elixir.CRemoteAbsent/later/1" g))
     (c-target-check 'negative-before-leaf-admission-not-sticky (eq? g (native-c-remote-target missing))))
    ;; All descriptor fields are mutable host data; snapshots own string bytes.
    (string-set! (vector-ref descriptor 1) 14 #\T)
    (string-set! (vector-ref descriptor 1) 15 #\w)
    (string-set! (vector-ref descriptor 1) 16 #\o)
    (c-target-check 'module-string-mutation (eq? g (native-c-remote-target descriptor)))
    (vector-set! descriptor 1 (string-copy module))
    (c-target-check 'module-field-replacement (eq? f (native-c-remote-target descriptor)))
    (string-set! (vector-ref descriptor 2) 0 #\s)
    (c-target-check 'logical-string-mutation (eq? g (native-c-remote-target descriptor)))
    (vector-set! descriptor 2 "pick")
    (c-target-check 'logical-field-restoration (eq? f (native-c-remote-target descriptor)))
    (let* ((key2 (string-append module "/pick/2")) (text (vector-ref descriptor 5)))
     (set! native-leaf-registry (bl-assoc native-leaf-registry key2 g))
     (native-c-remote-target descriptor)
     (string-set! text (- (string-length text) 1) #\2)
     (c-target-check 'key-string-mutation (eq? g (native-c-remote-target descriptor)))
     (string-set! text (- (string-length text) 1) #\1)
     (c-target-check 'key-string-restoration (eq? f (native-c-remote-target descriptor))))
    (let ((marker (vector-ref descriptor 0)))
     (vector-set! descriptor 0 'host-mutated-marker)
     (c-target-check 'noncanonical-marker-keeps-uncached-contract (eq? f (native-c-remote-target descriptor)))
     (vector-set! descriptor 0 marker)
     (c-target-check 'marker-restoration (eq? f (native-c-remote-target descriptor))))
    (let* ((multi (bl-tuple (list (bl-key "$blfn") (bl-map 1 f 2 f2) bl-nil)))
           (fields (vector-ref multi 1)))
     (native-register! one "pick" multi)
     (native-register-arities! one "pick" (bl-vec '(1 2)) bl-nil)
     (c-target-check 'fixed-multi-selection (eq? f (native-c-remote-target descriptor)))
     (vector-set! descriptor 3 2)
     (c-target-check 'descriptor-arity-mutation (eq? f2 (native-c-remote-target descriptor)))
     (vector-set! descriptor 3 1)
     (c-target-check 'descriptor-arity-restoration (eq? f (native-c-remote-target descriptor)))
     (vector-set! fields 1 (bl-map 1 g 2 f2))
     (c-target-check 'same-root-fixed-clause-replacement (eq? g (native-c-remote-target descriptor)))
     (vector-set! fields 1 (bl-empty-map))
     (c-target-check 'same-root-fixed-clause-removal
      (c-target-refused? (lambda () (native-c-remote-target descriptor))))
     (vector-set! fields 1 (bl-map 1 f 2 f2))
     (c-target-check 'same-root-fixed-clause-readmission (eq? f (native-c-remote-target descriptor))))
    (let* ((variadic (bl-tuple (list 0 g)))
           (multi (bl-tuple (list (bl-key "$blfn") (bl-map 1 f) variadic)))
           (packed (native-c-parse-remote (string-append module "/vary__bl_v/1"))))
     (native-register! one "vary" multi)
     (native-register-arities! one "vary" (bl-vec '(1)) 0)
     (c-target-check 'packed-physical-selection (eq? g (native-c-remote-target packed)))
     (vector-set! (vector-ref variadic 1) 1 f)
     (c-target-check 'same-root-packed-clause-replacement (eq? f (native-c-remote-target packed)))
     (vector-set! (vector-ref variadic 1) 1 g)
     (vector-set! packed 4 #f)
     (c-target-check 'packed-flag-mutation (eq? f (native-c-remote-target packed)))
     (vector-set! packed 4 #t)
     (c-target-check 'packed-flag-restoration (eq? g (native-c-remote-target packed)))
     ;; Changed adapters own their effects; no cached lookup may skip them.
     (for-each
      (lambda (spec)
       (let ((original (cadr spec)) (install (caddr spec)) (calls 0))
        (dynamic-wind
         (lambda () (install (lambda args (set! calls (+ calls 1)) (apply original args))))
         (lambda ()
          (c-target-check (list 'hook-disables (car spec)) (not (native-c-remote-target-hooks-current?)))
          (c-target-check (list 'hook-fixed-result (car spec)) (eq? f (native-c-remote-target descriptor)))
          (c-target-check (list 'hook-packed-result (car spec)) (eq? g (native-c-remote-target packed)))
          (c-target-check (list 'hook-effects-observed (car spec)) (> calls 0)))
         (lambda () (install original)))
        (c-target-check (list 'hook-restoration (car spec)) (native-c-remote-target-hooks-current?))))
      (list
       (list 'leaf native-leaf (lambda (f) (set! native-leaf f)))
       (list 'row native-row (lambda (f) (set! native-row f)))
       (list 'get bl-get (lambda (f) (set! bl-get f)))
       (list 'tuple bl-tuple (lambda (f) (set! bl-tuple f)))
       (list 'nth bl-nth (lambda (f) (set! bl-nth f)))
       (list 'items bl-items (lambda (f) (set! bl-items f)))
       (list 'nil bl-is-nil (lambda (f) (set! bl-is-nil f)))
       (list 'multi native-multi-callable? (lambda (f) (set! native-multi-callable? f)))
       (list 'closure native-c-closure? (lambda (f) (set! native-c-closure? f)))
       (list 'accepts native-callable-accepts? (lambda (f) (set! native-callable-accepts? f)))))
     ;; An effectful replacement can change both its result and the raw host
     ;; descriptor. The original resolver captures its fields BEFORE lookup.
     (let ((original native-leaf))
      (dynamic-wind
       (lambda () (set! native-leaf (lambda (key)
        (vector-set! descriptor 3 2) (original key))))
       (lambda () (c-target-check 'effectful-leaf-retains-original-field-evaluation
        (eq? f (native-c-remote-target descriptor))))
       (lambda () (set! native-leaf original) (vector-set! descriptor 3 1)))))
    (native-register! one "/" f)
    (native-register-arities! one "/" (bl-vec '(1)) bl-nil)
    (c-target-check 'slash-function-key
     (eq? f (native-c-remote-target (native-c-parse-remote (string-append module "///1")))))
    ;; A genuine C descriptor is returned intact, including its captures/frame.
    (let* ((c (vector native-c-closure-marker (vector #f '#() '#()) 0 2 '() '(1)
               (bl-map (bl-key "arity") 1)))
           (cd (native-c-parse-remote (string-append module "/actual-c/1"))))
     (native-register! one "actual-c" c)
     (native-register-arities! one "actual-c" (bl-vec '(1)) bl-nil)
     (c-target-check 'c-closure-target-identity (eq? c (native-c-remote-target cd)))
     (c-target-check 'c-closure-target-reused (eq? c (native-c-remote-target cd)))
     (vector-set! c 6 (bl-map (bl-key "arity") 2))
     (c-target-check 'c-closure-physical-arity-mutation
      (c-target-refused? (lambda () (native-c-remote-target cd)))))
    (let ((original native-c-remote-target) (calls 0))
     (dynamic-wind
      (lambda () (set! native-c-remote-target (lambda (d) (set! calls (+ calls 1)) (original d))))
      (lambda ()
       (c-target-check 'generic-planner-target-entry-stays-live
        (eq? f (car (native-c-resolve-call descriptor '(9)))))
       (c-target-check 'generic-planner-target-hook-observed (= calls 1)))
      (lambda () (set! native-c-remote-target original))))
    (let ((original native-c-resolve-without-remote) (calls 0))
     (dynamic-wind
      (lambda () (set! native-c-resolve-without-remote (lambda (callee args)
       (set! calls (+ calls 1))
       (if (eq? callee descriptor) (cons callee '(37)) (original callee args)))))
      (lambda ()
       (let ((plan (native-c-resolve-call descriptor '(9))))
        (c-target-check 'generic-planner-hook-keeps-target (eq? f (car plan)))
        (c-target-check 'generic-planner-hook-keeps-arguments (equal? '(37) (cdr plan)))
        (c-target-check 'generic-planner-hook-both-passes (= calls 2))))
      (lambda () (set! native-c-resolve-without-remote original))))))
  (lambda ()
   (set! native-leaf-registry saved-leaves) (set! native-module-names saved-modules)
   (set! native-export-arities saved-arities) (set! native-global-registry saved-globals)
   (set! native-excluded-host-leaves saved-excluded))))
(display "NATIVE_C_REMOTE_TARGET_ABI_PASS ") (display c-target-checks) (newline)
