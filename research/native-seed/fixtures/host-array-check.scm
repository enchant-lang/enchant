;; Focused primitive ABI qualification; no BL declaration/scheduler replacement.
(define native-array-check-count 0)
(define (native-array-check label value)
 (if (not value) (error "native host array/tuple ABI failed" label))
 (set! native-array-check-count (+ native-array-check-count 1)))
(define (native-array-rejects thunk)
 (let ((rejected #f))
  (with-exception-catcher (lambda (e) (set! rejected #t)) thunk)
  rejected))
(let* ((array (h-list->array (list 1 (bl-key "cont")))) (tuple (h-tup array)))
 (native-array-check 'transport-vector (h-is-vec array))
 (native-array-check 'tuple-kind (h-is-tup tuple))
 (native-array-check 'tuple-count (= 2 (h-tup-size tuple)))
 (native-array-check 'tuple-first (= 1 (h-tup-el tuple 0)))
 (native-array-check 'tuple-second (eq? (bl-key "cont") (h-tup-el tuple 1))))
(let* ((items (let loop ((n 1056) (out '()))
               (if (< n 0) out (loop (- n 1) (cons n out)))))
       (tuple (h-tup (h-list->array items))))
 (native-array-check 'canonical-vector-trie (= 1057 (h-tup-size tuple)))
 (native-array-check 'trie-order-first (= 0 (h-tup-el tuple 0)))
 (native-array-check 'trie-order-last (= 1056 (h-tup-el tuple 1056))))
(native-array-check 'empty (= 0 (h-tup-size (h-tup (h-list->array '())))))
(native-array-check 'internal-raw-list (bl-equal? (h-tup (list 1 2)) (bl-tuple (list 1 2))))
(native-array-check 'reject-nil (native-array-rejects (lambda () (h-list->array bl-nil))))
(native-array-check 'reject-improper (native-array-rejects (lambda () (h-list->array (cons 1 2)))))
(native-array-check 'reject-array-as-list (native-array-rejects (lambda () (h-list->array (bl-vec (list 1))))))
(display "NATIVE_HOST_ARRAY_TUPLE_ABI_PASS ") (display native-array-check-count) (newline)
