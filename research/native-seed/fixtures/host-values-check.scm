;; Append after host.scm, host-values.scm, host-leaves.scm. No BL compiler.
(define native-checks 0)
(define (native-check label value)
 (if (not value) (error (string-append "native value/control check failed: " label)))
 (set! native-checks (+ native-checks 1)))
(let* ((m (bl-map (bl-key "a") 1 (bl-key "nil") bl-nil))
       (m2 (bl-assoc m (bl-key "a") 2)))
 (native-check "persistent map old root" (= (bl-get m (bl-key "a")) 1))
 (native-check "persistent map new root" (= (bl-get m2 (bl-key "a")) 2))
 (native-check "nil map entry is present" (native-map-has? m (bl-key "nil")))
 (native-check "delete map entry" (= (native-map-count (native-map-remove m (bl-key "nil"))) 1)))
(let loop ((i 0) (m (bl-empty-map)))
 (if (= i 1024)
  (begin
   (native-check "map insert/lookup" (= (bl-get m 999) 2997))
   (let remove ((i 0) (n m))
    (if (= i 1024) (native-check "map balanced removal" (= (native-map-count n) 0))
     (remove (+ i 1) (native-map-remove n i)))))
  (loop (+ i 1) (bl-assoc m i (* i 3)))))
(let loop ((i 0) (v (bl-vec '())))
 (if (= i 257)
  (let ((w (native-vector-assoc v 128 -1)))
   (native-check "vector old root" (= (bl-nth v 128) 128))
   (native-check "vector path copy" (= (bl-nth w 128) -1))
   (native-check "vector capacity crossing" (= (bl-nth v 256) 256)))
  (loop (+ i 1) (bl-conj v i))))
(native-check "numeric exact equality" (bl-equal? 10 (bl-decimal 100 1)))
(native-check "dyadic float exactness" (not (bl-equal? (bl-float 0.1) (bl-decimal 1 1))))
(native-check "decimal exact add" (bl-equal? (bl-arithmetic 'add (bl-decimal 1 1) (bl-decimal 2 1)) (bl-decimal 3 1)))
(native-check "strict raw numeric keys" (not (bl-key-equal? 1 (bl-float 1.0))))
(let* ((fields (bl-map (bl-key "x") 4)) (s (bl-struct (bl-key "Elixir.Test") fields)))
 (native-check "generic struct tag" (eq? (native-struct-module s) (bl-key "Elixir.Test")))
 (native-check "generic struct field pattern"
  (bl-match (list 'struct (bl-key "Elixir.Test") (list (list (bl-key "x") (list 'lit 4)))) s '())))
(let ((f (bl-tuple (list (bl-key "$blfn")
            (bl-map 1 (lambda (x) (+ x 1)))
            (bl-tuple (list 2 (lambda (a b rest) (+ a b (length rest)))))))))
 (native-check "fixed callable clause" (= (bl-invoke f '(4)) 5))
 (native-check "variadic callable clause" (= (bl-invoke f '(1 2 3 4)) 5)))
(let ((cleanup 0) (after-body #f))
 (let ((frame (h-make-frames (lambda ()
   (bl-try (lambda () (h-park "park") (set! after-body #t))
           (lambda (kind reason trace) (bl-reraise kind reason trace))
           (lambda () (set! cleanup (+ cleanup 1))))) '())))
  (native-check "try suspends" (eq? (bl-get (h-run-turn frame 100) (bl-key "status")) (bl-key "park")))
  (native-check "finally not on suspension" (= cleanup 0))
  (native-check "try resumes" (eq? (bl-get (h-run-turn frame 100) (bl-key "status")) (bl-key "done")))
  (native-check "finally exactly once" (and after-body (= cleanup 1)))))
(let ((cleanup 0) (caught #f))
 (with-exception-catcher
  (lambda (e) (set! caught (and (eq? (native-exception-kind e) (bl-key "exit"))
                              (eq? (native-exception-reason e) (bl-key "handler")))))
  (lambda () (bl-try (lambda () (native-throw (bl-key "body")))
    (lambda (kind reason trace) (h-exit (bl-key "handler")))
    (lambda () (set! cleanup (+ cleanup 1))))))
 (native-check "handler escape preserves class/reason" caught)
 (native-check "handler escape finally once" (= cleanup 1)))
;; Release emission keeps no logical stack; host-source-frames-check.scm checks
;; the debug stack across park and resume.
(let ((f (h-make-frames (lambda () (h-park "park") (native-throw (bl-key "trace"))) '())))
 (h-run-turn f 100)
 (native-check "release frames leave scheduler empty" (null? (h-logical-stack)))
 (let ((answer (h-run-turn f 100)))
  (native-check "release trace stays empty on resume" (null? (bl-get answer (bl-key "frames"))))))
(native-check "UTF8 binary indices" (equal? (native-utf8-bytes "Aλ😀") '(65 206 187 240 159 152 128)))
(native-check "UTF8 round trip" (string=? (native-utf8-string (native-utf8-bytes "Aλ😀")) "Aλ😀"))
(display "native value/control checks: ") (display native-checks) (newline)
