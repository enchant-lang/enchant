;; Publication selection only. The existing 105 checks remain unchanged.
(define c-mono-checks 0)
(define (c-mono-check label ok)
 (if (not ok) (error "C monomorphic publication ABI" label))
 (set! c-mono-checks (+ c-mono-checks 1)))
(define (c-mono-refused? thunk)
 (with-exception-catcher (lambda (error) #t) (lambda () (thunk) #f)))
(let* ((saved-tick native-c-noactor-tick-enabled?) (saved-pure native-c-pure-bif-enabled?)
       (saved-modules native-module-names) (saved-arities native-export-arities)
       (saved-globals native-global-registry)
       (c (vector native-c-closure-marker '#(#f #() #()) 0 2 '() '(1)
            (bl-map (bl-key "arity") 1)))
       (c2 (vector native-c-closure-marker '#(#f #() #()) 0 2 '() '(1)
             (bl-map (bl-key "arity") 1)))
       (fixed (bl-vec '(1))) (metadata (bl-tuple (list fixed bl-nil)))
       (fields (vector-ref metadata 1)) (store (vector-ref fixed 1))
       (key "Elixir.CMonomorphic/pick/1"))
 (define (select) (native-c-select-published-target 1 #f key metadata c))
 (define (restore)
  (set! native-c-noactor-tick-enabled? saved-tick)
  (set! native-c-pure-bif-enabled? saved-pure)
  (set! native-module-names saved-modules) (set! native-export-arities saved-arities)
  (set! native-global-registry saved-globals))
 (with-exception-catcher (lambda (error) (restore) (raise error))
  (lambda ()
   (set! native-c-noactor-tick-enabled? #f) (set! native-c-pure-bif-enabled? #f)
   (c-mono-check 'unqualified-host-fallback
    (not (native-c-single-fixed-published? 1 #f metadata c)))
   (set! native-c-noactor-tick-enabled? #t)
   (c-mono-check 'stock-positive (native-c-single-fixed-published? 1 #f metadata c))
   (let ((before native-c-single-fixed-target-hits))
    (c-mono-check 'target-identity (eq? c (select)))
    (c-mono-check 'positive-count (= native-c-single-fixed-target-hits (+ before 1))))
   ;; Every live vector field participates. Malformed/other storage shapes
   ;; use the original selector, rather than an identity-only cached recipe.
   (vector-set! fields 0 (bl-vec '(1 2)))
   (let ((before native-c-single-fixed-target-hits))
    (c-mono-check 'multi-arity-metadata-fallback (eq? c (select)))
    (c-mono-check 'multi-arity-not-counted (= before native-c-single-fixed-target-hits)))
   (vector-set! fields 0 (bl-vec '(2)))
   (c-mono-check 'fixed-field-mutation-refuses (c-mono-refused? select))
   (vector-set! fields 0 fixed)
   (vector-set! store 1 0)
   (c-mono-check 'raw-count-mutation-refuses (c-mono-refused? select))
   (vector-set! store 1 1)
   (vector-set! store 2 2) (vector-set! store 3 (vector 1 #f))
   (let ((before native-c-single-fixed-target-hits))
    (c-mono-check 'raw-capacity-fallback
     (and (eq? c (select)) (= before native-c-single-fixed-target-hits))))
   (vector-set! store 2 1) (vector-set! store 3 2)
   (c-mono-check 'raw-element-mutation-refuses (c-mono-refused? select))
   (vector-set! store 3 1)
   (vector-set! fields 0 (vector 'vec (vector 1)))
   (let ((before native-c-single-fixed-target-hits))
    (c-mono-check 'legacy-flat-storage-fallback
     (and (eq? c (select)) (= before native-c-single-fixed-target-hits))))
   (vector-set! fields 0 (native-vector-with-meta fixed (bl-key "metadata")))
   (c-mono-check 'optional-metadata-storage-positive
    (and (native-c-single-fixed-published? 1 #f metadata c) (eq? c (select))))
   (vector-set! fields 0 fixed)
   (vector-set! c 6 (bl-map (bl-key "arity") 2))
   (c-mono-check 'live-physical-arity-refuses (c-mono-refused? select))
   (vector-set! c 6 (bl-map (bl-key "arity") 1))
   (c-mono-check 'physical-arity-restores (eq? c (select)))
   (vector-set! c 0 'mutated-c-marker)
   (c-mono-check 'live-C-classification-refuses (c-mono-refused? select))
   (vector-set! c 0 native-c-closure-marker)
   (c-mono-check 'classification-restores (eq? c (select)))
   ;; Multi fixed maps and variadic inner clauses retain their original full
   ;; selector. In-place replacements must change the returned physical body.
   (let* ((multi (bl-tuple (list (bl-key "$blfn") (bl-map 1 c) bl-nil)))
          (variadic (bl-tuple (list 0 c)))
          (v (bl-tuple (list (bl-key "$blfn") (bl-empty-map) variadic)))
          (vm (bl-tuple (list (bl-vec '()) 0))))
    (native-c-select-published-target 1 #f key metadata multi)
    (vector-set! (vector-ref multi 1) 1 (bl-map 1 c2))
    (c-mono-check 'multi-fixed-map-reselection
     (eq? c2 (native-c-select-published-target 1 #f key metadata multi)))
    (native-c-select-published-target 1 #t key vm v)
    (vector-set! (vector-ref variadic 1) 1 c2)
    (c-mono-check 'variadic-inner-reselection
     (eq? c2 (native-c-select-published-target 1 #t key vm v))))
   ;; Nine skipped helper bindings remain observable and force the full path.
   (for-each
    (lambda (spec)
     (let ((original (cadr spec)) (install (caddr spec)) (calls 0))
      (dynamic-wind
       (lambda () (install (lambda args (set! calls (+ calls 1)) (apply original args))))
       (lambda ()
        (c-mono-check (list 'hook-fallback (car spec))
         (not (native-c-single-fixed-published? 1 #f metadata c)))
        (c-mono-check (list 'hook-target (car spec)) (eq? c (select)))
        (c-mono-check (list 'hook-effects (car spec)) (> calls 0)))
       (lambda () (install original)))))
    (list
     (list 'tag bl-tag? (lambda (f) (set! bl-tag? f)))
     (list 'nth bl-nth (lambda (f) (set! bl-nth f)))
     (list 'items bl-items (lambda (f) (set! bl-items f)))
     (list 'multi native-multi-callable? (lambda (f) (set! native-multi-callable? f)))
     (list 'closure native-c-closure? (lambda (f) (set! native-c-closure? f)))
     (list 'count native-vector-count (lambda (f) (set! native-vector-count f)))
     (list 'ref native-vector-ref (lambda (f) (set! native-vector-ref f)))
     (list 'storage native-vector-storage? (lambda (f) (set! native-vector-storage? f)))
     (list 'at native-vector-at (lambda (f) (set! native-vector-at f)))))
   ;; The physical arity hook is deliberately NEVER skipped or memoized.
   (let ((original native-callable-accepts?) (calls 0) (sentinel (list 'accepts-error)))
    (dynamic-wind
     (lambda () (set! native-callable-accepts? (lambda (f n)
      (set! calls (+ calls 1)) (original f n))))
     (lambda ()
      (c-mono-check 'live-accepts-result (eq? c (select)))
      (c-mono-check 'live-accepts-exactly-once (= calls 1))
      (set! native-callable-accepts? (lambda (f n) (raise sentinel)))
      (c-mono-check 'live-accepts-exception-identity
       (eq? sentinel (with-exception-catcher (lambda (error) error) select)))
      (set! calls 0)
      (set! native-callable-accepts? (lambda (f n) (set! calls (+ calls 1)) #t))
      (vector-set! fields 0 (bl-vec '(2)))
      (c-mono-check 'export-error-before-physical-hook
       (and (c-mono-refused? select) (= calls 0)))
      (vector-set! fields 0 fixed))
     (lambda () (set! native-callable-accepts? original))))
   ;; Exercise the real positive publication cache without altering its key,
   ;; registry-root invalidation or absence/error behavior.
   (set! native-module-names (bl-assoc native-module-names "Elixir.CMonomorphic" "c.monomorphic"))
   (native-register! "c.monomorphic" "pick" c)
   (native-register-arities! "c.monomorphic" "pick" fixed bl-nil)
   (let ((descriptor (native-c-parse-remote key)))
    (c-mono-check 'public-first-selection (eq? c (native-c-remote-target descriptor)))
    (let ((before native-c-single-fixed-target-hits))
     (c-mono-check 'public-positive-cache-hit
      (and (eq? c (native-c-remote-target descriptor))
           (= native-c-single-fixed-target-hits (+ before 1)))))
    (vector-set! store 3 2)
    (c-mono-check 'public-cache-raw-storage-mutation
     (c-mono-refused? (lambda () (native-c-remote-target descriptor))))
    (vector-set! store 3 1))))
 (restore))
(if (not (= c-mono-checks 52)) (error "C monomorphic fixture count" c-mono-checks))
(display "NATIVE_C_MONOMORPHIC_TARGET_ABI_PASS 52") (newline)
