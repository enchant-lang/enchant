;; Append after pure host, compiler adapter, then the source-frame host.
;; Hand-written debug emission: the site statements native.scheme emits.
(define (native-frame-check label ok)
 (if (not ok) (error (string-append "native source-frame check failed: " label))))
(define (native-test-site name line mode)
 (vector #f (bl-key "arity") 0 (bl-key "call") (bl-key mode) (bl-key "col") 1
         (bl-key "file") "source-fixture.bl" (bl-key "fn") name (bl-key "line") line))
;; A top-level caller site, as module initialization code emits it.
(define (native-test-call line thunk)
 (let ((entry (bl-source-call (native-test-site "top" line "direct")))) (bl-source-return entry (thunk))))
(define native-test-countdown #f)
(set! native-test-countdown (lambda (n)
 (bl-source-enter (native-test-site "countdown" 1 "direct")) (h-tick)
 (if (> n 0)
  (begin (bl-source-tail (native-test-site "countdown" 4 "tail"))
         (bl-invoke native-test-countdown (list (- n 1))))
  (h-logical-stack))))
(let* ((before native-max-frames)
       (frames (native-test-call 0 (lambda () (bl-invoke native-test-countdown '(5000))))))
 (native-frame-check "tail source stack constant depth" (= 1 (length frames)))
 (native-frame-check "tail logical stack max bounded" (<= native-max-frames (max before 1)))
 (native-frame-check "caller stack restored after return" (null? native-source-frames)))
;; A host leaf's callbacks each push one frame onto the leaf caller's stack,
;; never onto a previous callback's frame, and never take its tail jump.
(let ((depths '()) (result #f) (continued? #f))
 (native-test-call 9 (lambda ()
  (bl-source-enter (native-test-site "host-caller" 10 "direct"))
  (set! result
   (begin (bl-source-tail (native-test-site "host-caller" 12 "tail"))
    (bl-invoke (native-leaf "Elixir.Enum/map/2")
     (list '(1 2 3) (lambda (x)
      (bl-source-enter (native-test-site bl-nil 14 "direct"))
      (set! depths (cons (length (h-logical-stack)) depths)) (+ x 1))))))
  (set! continued? #t)))
 (native-frame-check "host callbacks do not inherit outer tail jump" (and continued? (equal? result '(2 3 4))))
 (native-frame-check "host callbacks share the leaf caller stack" (equal? depths '(2 2 2))))
(let ((captured #f) (cleanup 0) (live #f))
 (native-test-call 19 (lambda ()
  (bl-source-enter (native-test-site "protected" 20 "direct"))
  (bl-try (lambda ()
    (let ((entry (bl-source-call (native-test-site "protected" 22 "direct"))))
     (bl-source-return entry (bl-invoke (native-leaf "erlang/throw/1") '(7)))))
   (lambda (kind reason raw)
    (set! live (h-logical-stack))
    (set! captured (and (eq? kind (bl-key "throw")) (= reason 7)
      (bl-tag? raw 'tuple) (pair? (bl-trace-frames raw)))))
   (lambda () (set! cleanup (+ 1 cleanup))))))
 (native-frame-check "raw and frame traces remain distinct" captured)
 (native-frame-check "a raise leaves its call site live for the catch"
  (and (pair? live) (= 22 (bl-get (car live) (bl-key "line")))))
 (native-frame-check "protected cleanup once" (= cleanup 1)))
;; The raw BIF forwards to its target, never through a native callback fence.
(define native-test-raw-countdown #f)
(set! native-test-raw-countdown
 (bl-register-callable! (lambda (n)
  (bl-source-enter (native-test-site "raw-countdown" 30 "direct"))
  (if (> n 0)
   (begin (bl-source-tail (native-test-site "raw-countdown" 31 "tail"))
          (native-raw-apply native-test-raw-countdown (list (- n 1))))
   (h-logical-stack))) 1))
(let ((frames (native-test-call 39 (lambda ()
  (bl-source-enter (native-test-site "raw-caller" 40 "direct"))
  (bl-source-tail (native-test-site "raw-caller" 41 "tail"))
  (bl-invoke (native-leaf "erlang/apply/2") (list native-test-raw-countdown '(100)))))))
 (native-frame-check "raw apply target tail frame remains bounded" (= 1 (length frames)))
 (native-frame-check "raw apply preserves actual target call site"
  (and (string=? (bl-get (car frames) (bl-key "fn")) "raw-countdown")
       (= (bl-get (car frames) (bl-key "line")) 31))))
;; A parked actor keeps its own stack; the scheduler's comes back between turns.
(let* ((site (native-test-site "parked" 50 "direct"))
       (f (h-make-frames (lambda () (bl-source-enter site) (h-park "park") (native-throw (bl-key "trace"))) '())))
 (h-run-turn f 100)
 (native-frame-check "source frames leave scheduler" (null? (h-logical-stack)))
 (let ((answer (h-run-turn f 100)))
  (native-frame-check "source frames restore on resume"
   (bl-equal? (bl-get answer (bl-key "frames")) (list (bl-source-site-frame site))))))
;; A frame restores its entry critical depth when it completes or unwinds.
(let ((enter (lambda () (bl-source-enter (native-test-site "enter" 60 "direct")) (h-critical-enter)))
      (before seed-critical))
 (native-test-call 61 (lambda () (bl-invoke enter '())))
 (native-frame-check "completed frame restores critical depth" (= seed-critical before))
 (native-test-call 62 (lambda ()
  (bl-source-enter (native-test-site "catcher" 63 "direct"))
  (bl-try (lambda ()
    (let ((entry (bl-source-call (native-test-site "catcher" 64 "direct"))))
     (bl-source-return entry (bl-invoke (lambda () (bl-source-enter (native-test-site "raiser" 65 "direct"))
                                         (h-critical-enter) (native-throw 1)) '()))))
   (lambda (kind reason raw) #f) #f)))
 (native-frame-check "unwound frame restores critical depth" (= seed-critical before)))
;; A guard's BL call is not a callee of the pending site; its stack unwinds.
(let ((guarded (lambda () (bl-source-enter (native-test-site "guarded" 70 "direct")) (native-throw 2))))
 (native-test-call 71 (lambda ()
  (bl-source-enter (native-test-site "guard-owner" 72 "direct"))
  (bl-guard (lambda () (bl-invoke guarded '())))
  (native-frame-check "guard restores the stack" (= 1 (length (h-logical-stack)))))))
;; Sites whose map has no Scheme datum keep a builder.
(native-frame-check "builder site"
 (bl-equal? (bl-source-site-frame (vector #f (lambda () (bl-map (bl-key "x") (bl-float 1.5)))))
            (bl-map (bl-key "x") (bl-float 1.5))))
(native-frame-check "datum site nil" (eq? bl-nil (bl-get (bl-source-site-frame (vector #f (bl-key "fn") (void))) (bl-key "fn"))))
(native-frame-check "prelude call clears a pending tail site"
 (native-test-call 80 (lambda ()
   (bl-source-tail (native-test-site "tail-prelude" 81 "tail"))
   (native-linked-external-call (lambda () (not native-source-pending)) '()))))
(native-frame-check "prelude call keeps a pending non-tail site"
 (native-test-call 82 (lambda ()
   (let ((entry native-source-pending))
    (native-linked-external-call (lambda () (eq? native-source-pending entry)) '())))))
(let ((variadic (bl-tuple (list (bl-key "$blfn") (bl-empty-map)
                  (bl-tuple (list 0 (lambda (rest) (and (not native-source-pending) (equal? rest '(7 8))))))))))
 (native-frame-check "packed prelude call clears a pending tail site and keeps its arguments"
  (native-test-call 83 (lambda ()
    (bl-source-tail (native-test-site "tail-packed-prelude" 84 "tail"))
    (native-linked-external-packed-call variadic '((7 8)))))))
(display "native source-frame checks passed") (newline)
