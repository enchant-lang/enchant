;; Host boundary contract: enabling optional input cannot cancel a finite
;; timeout. The fake producer/waiter below observes arguments; no event is
;; fabricated. Load only in a fresh host qualification process.
(define native-input-wait-check-count 0)
(define (native-input-wait-check label actual expected)
 (if (not (bl-equal? actual expected))
  (error "optional input deadline ABI" label actual expected))
 (set! native-input-wait-check-count (+ native-input-wait-check-count 1)))
(let ((prior-clock seed-clock)
      (prior-mode native-virtual-time?)
      (prior-producer native-input-producer)
      (prior-waiter native-readiness-waiter))
 (if (pair? native-input-queue) (error "input wait fixture requires an empty initial queue"))
 (set! native-virtual-time? #t)
 (set! native-input-producer #f)
 (set! seed-clock 0)
 (h-wait-until 17 #t)
 (native-input-wait-check 'optional-input-keeps-deadline seed-clock 17)
 (native-input-wait-check 'deadline-creates-no-input (h-input-size) 0)
 (native-input-wait-check 'deadline-empty-drain (h-take-input) (bl-vec '()))
 (native-input! (bl-key "fixture-input"))
 (h-wait-until 7 #f)
 (native-input-wait-check 'disabled-input-keeps-timer seed-clock 24)
 (native-input-wait-check 'disabled-input-keeps-queue (h-input-size) 1)
 (h-wait-until 11 #t)
 (native-input-wait-check 'queued-input-wakes-immediately seed-clock 24)
 (native-input-wait-check 'wait-does-not-drain (h-input-size) 1)
 (h-wait-input)
 (native-input-wait-check 'queued-indefinite-wakes-immediately seed-clock 24)
 (native-input-wait-check 'actual-input-preserved
  (h-take-input) (bl-vec (list (bl-key "fixture-input"))))
 (let ((caught (with-exception-catcher (lambda (exception) exception)
                (lambda () (h-wait-input)))))
  (native-input-wait-check 'indefinite-empty-refuses
   (and (native-raised? caught)
        (string=? (native-exception-reason caught) "no native input producer is registered")) #t))
 (native-input-wait-check 'indefinite-refusal-keeps-clock seed-clock 24)
 (let ((calls '()))
  (set! native-input-producer (lambda (deadline) (set! calls (cons deadline calls)) bl-nil))
  (h-wait-until 23 #t)
  (native-input-wait-check 'producer-receives-deadline calls '(23))
  (h-wait-input)
  (native-input-wait-check 'producer-receives-indefinite calls '(#f 23))
  (h-wait-until 3 #f)
  (native-input-wait-check 'disabled-input-bypasses-producer calls '(#f 23))
  (native-input-wait-check 'disabled-input-advances-clock seed-clock 27))
 (set! native-input-producer #f)
 (set! native-virtual-time? #f)
 (let ((waited #f))
  (set! native-readiness-waiter (lambda (ms) (set! waited ms) bl-nil))
  (h-wait-until 19 #t)
  (native-input-wait-check 'real-readiness-keeps-deadline waited 19)
  (native-input-wait-check 'real-wait-does-not-fake-virtual-time seed-clock 27))
 (native-input-wait-check 'all-waits-create-no-input (h-input-size) 0)
 (set! seed-clock prior-clock)
 (set! native-virtual-time? prior-mode)
 (set! native-input-producer prior-producer)
 (set! native-readiness-waiter prior-waiter))
(display "NATIVE_OPTIONAL_INPUT_DEADLINE_ABI_PASS ")
(display native-input-wait-check-count) (newline)
