(define (native-lazy-check label ok) (if (not ok) (error (string-append "lazy memo check failed: " label))))
(let ((runs 0))
 (let ((x (native-lazy-new (lambda () (set! runs (+ runs 1)) '(1 2 3)))))
  (native-lazy-check "realize" (equal? (native-lazy-list x) '(1 2 3)))
  (native-lazy-list x)
  (native-lazy-check "memo exactly once" (= runs 1))))
(let ((runs 0))
 (let ((x (native-lazy-new (lambda () (set! runs (+ runs 1)) (if (= runs 1) (native-throw 7) '(8))))))
  (with-exception-catcher (lambda (e) #f) (lambda () (native-lazy-force x)))
  (native-lazy-check "failed thunk retries" (and (equal? (native-lazy-list x) '(8)) (= runs 2)))))
(let ((x #f))
 (set! x (native-lazy-new (lambda () (cons 1 x))))
 (with-exception-catcher (lambda (e) #f) (lambda () (native-lazy-force x)))
 (native-lazy-check "direct memo cycle terminal" (eq? (car (native-lazy-state x)) 'terminal)))
(let* ((x (native-lazy-new (lambda () '(1 2)) (lambda args 9)))
       (claim (native-lazy-claim x)) (attempt (bl-nth claim 1)) (pending (bl-nth claim 2)))
 (native-lazy-check "recipe claimed" (eq? (bl-nth claim 0) (bl-key "claimed")))
 (native-lazy-release x attempt pending)
 (native-lazy-check "halt releases pending" (eq? (car (native-lazy-state x)) 'pending))
 (let* ((claim2 (native-lazy-claim x)) (attempt2 (bl-nth claim2 1)))
  (native-lazy-complete x attempt2 '(4 5))
  (native-lazy-check "recipe publishes memo" (equal? (native-lazy-list x) '(4 5)))))
(display "native lazy memo checks passed") (newline)
