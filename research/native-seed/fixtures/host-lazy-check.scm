(define (native-lazy-check label ok) (if (not ok) (error (string-append "lazy memo check failed: " label))))
(let ((runs 0))
 (let ((x (native-lazy-new (lambda () (set! runs (+ runs 1)) '(1 2 3)))))
  (native-lazy-check "realize" (equal? (native-lazy-list x) '(1 2 3)))
  (native-lazy-list x)
  (native-lazy-check "memo exactly once" (= runs 1))))
(let ((runs 0))
 (let ((x (native-lazy-new (lambda () (set! runs (+ runs 1)) (if (= runs 1) (native-throw 7) '(8))))))
  (with-exception-catcher (lambda (e) #f) (lambda () (native-lazy-force x)))
  (native-lazy-check "failed thunk retries" (and (equal? (native-lazy-list x) '(8)) (= runs 2)))))
(let ((x #f))
 (set! x (native-lazy-new (lambda () (cons 1 x))))
 (with-exception-catcher (lambda (e) #f) (lambda () (native-lazy-force x)))
 (native-lazy-check "direct memo cycle terminal" (eq? (car (native-lazy-state x)) 'terminal)))
(let* ((x (native-lazy-new (lambda () '(1 2)) (lambda args 9)))
       (claim (native-lazy-claim x)) (attempt (bl-nth claim 1)) (pending (bl-nth claim 2)))
 (native-lazy-check "recipe claimed" (eq? (bl-nth claim 0) (bl-key "claimed")))
 (native-lazy-release x attempt pending)
 (native-lazy-check "halt releases pending" (eq? (car (native-lazy-state x)) 'pending))
 (let* ((claim2 (native-lazy-claim x)) (attempt2 (bl-nth claim2 1)))
  (native-lazy-complete x attempt2 '(4 5))
  (native-lazy-check "recipe publishes memo" (equal? (native-lazy-list x) '(4 5)))))
(let* ((pid (bl-vec (list (bl-key "pid") "fixture-runtime" 1)))
       (x (native-lazy-new (lambda () (h-park "park") '(99))))
       (owner (h-make-frames (lambda () (native-lazy-force x)) '()))
       (waiter (h-make-frames (lambda () (native-lazy-force x)) '()))
       (saved-state seed-state) (saved-self seed-self))
 (h-set-state (bl-map (bl-key "procs") (bl-map pid (bl-map (bl-key "frames") owner))))
 (set! seed-self pid)
 (h-run-turn owner 100)
 (set! seed-self bl-nil)
 (native-lazy-check "other actor waits for owner" (eq? (bl-get (h-run-turn waiter 100) (bl-key "status")) (bl-key "yield")))
 (h-set-state (bl-map (bl-key "procs") (bl-empty-map)))
 (native-lazy-check "owner removal terminalizes memo" (eq? (car (native-lazy-state x)) 'terminal))
 (let* ((answer (h-run-turn waiter 100)) (error (bl-get answer (bl-key "reason")))
        (reason (bl-get error (bl-key "reason"))))
  (native-lazy-check "waiter receives owner lost" (eq? (bl-nth reason 0) (bl-key "force_owner_lost")))
  (native-lazy-check "owner lost identity preserved" (bl-key-equal? (bl-nth reason 1) pid))
  (native-lazy-check "owner lost attempt is a reference" (native-reference? (bl-nth reason 2))))
 (h-set-state saved-state) (set! seed-self saved-self))
;; Sharing and raw cons cycles are identity relationships, not equality.
(let* ((leaf (native-lazy-new (lambda () '(9))))
       (resource (native-lazy-resource leaf))
       (shared (list leaf 1 2 3))
       (dag (bl-map (bl-key "left") shared (bl-key "right") shared))
       (edges (native-lazy-edges dag)))
 (native-lazy-check "shared value visited once" (and (= (length edges) 1) (eq? (car edges) resource)))
 (let* ((tail (cons leaf '())) (head (cons shared tail)))
  (set-cdr! tail head)
  (let ((edges (native-lazy-edges head)))
   (native-lazy-check "cyclic cons graph terminates with exact resource"
    (and (= (length edges) 1) (eq? (car edges) resource)))))
 (let ((edges (native-lazy-edges (cons (bl-key "placeholder") leaf))))
  (native-lazy-check "improper tail still examined" (and (= (length edges) 1) (eq? (car edges) resource))))
 (let* ((large (let loop ((n 1024) (xs (list leaf)))
                 (if (= n 0) xs (loop (- n 1) (cons n xs)))))
        (holder (native-lazy-new (lambda () (list large large)))))
  (native-lazy-force holder)
  (native-lazy-check "large shared published graph retains exact edge"
   (let ((edges (vector-ref (native-lazy-resource holder) 2)))
    (and (= (length edges) 1) (eq? (car edges) resource))))))
(let ((a #f) (b #f))
 (set! a (native-lazy-new (lambda () (list b))))
 (set! b (native-lazy-new (lambda () (list a))))
 (native-lazy-force a)
 (let ((refused #f))
  (with-exception-catcher (lambda (e) (set! refused #t)) (lambda () (native-lazy-force b)))
  (native-lazy-check "indirect resource cycle still refused" refused)
  (native-lazy-check "indirect cycle terminalizes publishing cell" (eq? (car (native-lazy-state b)) 'terminal))
  (native-lazy-check "completed predecessor remains completed" (eq? (car (native-lazy-state a)) 'completed))))
(display "native lazy memo checks passed") (newline)
