;; Host ABI only: fixed service actions, no C loader/compiler or BL evaluator.
;; Capture services while handlers exist, then replace the control-plane hooks.
(define c-host-service-checks 0)
(define (c-host-service-check label ok)
 (if (not ok) (error "C late host service ABI" label))
 (set! c-host-service-checks (+ c-host-service-checks 1)))
(define (c-host-service-refused? thunk)
 (with-exception-catcher (lambda (failure) #t) (lambda () (thunk) #f)))
(define (c-host-service-install! key function)
 (let ((old (native-leaf key)))
  (if (eq? old native-missing) (native-add-leaf! key function)
   (native-c-replace-leaf! key old function 1))))
(define (c-host-service-action service arguments)
 ;; The same rooted action ABI that the C unit returns. No Source decisions
 ;; or C instruction stream are supplied by this stand-in.
 (let ((machine (vector (vector #f '#() '#()) 0 (vector '() bl-nil bl-nil)
                 '() bl-nil 2 77 '() #f bl-nil '() bl-nil seed-critical #f)))
  (native-c-apply-action machine service arguments)
  (vector-ref (vector-ref machine 2) 2)))
(let ((saved-leaves native-leaf-registry))
 (dynamic-wind (lambda () #f)
  (lambda ()
   (let* ((key "host/service-control-plane-probe/1") (old-calls 0) (new-calls 0)
          (old (lambda (x) (set! old-calls (+ old-calls 1)) (+ x 1)))
          (new (lambda (x) (set! new-calls (+ new-calls 1)) (+ x 10))))
    (c-host-service-install! key old)
    (let ((captured (native-c-remote key)))
     (c-host-service-check 'existing-host-leaf-is-live-descriptor (native-c-remote? captured))
     (c-host-service-check 'initial-service-action (= 8 (c-host-service-action captured '(7))))
     (c-host-service-check 'initial-handler-exactly-once (= old-calls 1))
     (native-c-replace-leaf! key old new 1)
     (c-host-service-check 'captured-service-observes-replacement (= 17 (c-host-service-action captured '(7))))
     (c-host-service-check 'replaced-handler-not-called (= old-calls 1))
     (c-host-service-check 'replacement-exactly-once (= new-calls 1))
     (c-host-service-check 'raw-function-value-keeps-own-identity (= 8 (old 7)))
     (set! native-leaf-registry (native-map-remove native-leaf-registry key))
     (c-host-service-check 'removed-host-service-refuses
      (c-host-service-refused? (lambda () (c-host-service-action captured '(7)))))
     (native-add-leaf! key (lambda (x) (+ x 20)))
     (c-host-service-check 'host-readmission-retires-missing-result (= 27 (c-host-service-action captured '(7))))
     (c-host-service-check 'descriptor-keeps-static-mfa-arity
      (c-host-service-refused? (lambda () (c-host-service-action captured '()))))))
   (let* ((key "host/late-control-plane-probe/1") (captured (native-c-remote key)))
    (c-host-service-check 'host-before-publication-is-descriptor (native-c-remote? captured))
    (c-host-service-install! key (lambda (x) (+ x 3)))
    (c-host-service-check 'late-host-publication-observed (= 10 (c-host-service-action captured '(7)))))
   (let ((key "host/io/slash-service-probe/1"))
    (c-host-service-install! key (lambda (x) (bl-key "first")))
    (let ((captured (native-c-remote key)))
     (c-host-service-check 'entire-host-namespace-includes-slash-function (native-c-remote? captured))
     (c-host-service-install! key (lambda (x) (bl-key "second")))
     (c-host-service-check 'slash-function-observes-host-replacement
      (eq? (c-host-service-action captured '(7)) (bl-key "second")))))
   (c-host-service-check 'raw-apply-leaf-retains-early-identity
    (eq? (native-c-remote "erlang/apply/2") native-c-raw-apply2))
   (c-host-service-check 'raw-apply-adapter-contract-preserved
    (= 5 (bl-invoke (native-c-remote "erlang/apply/2")
           (list (bl-register-callable! (lambda (x) (+ x 1)) 1) '(4)))))
   (let* ((key "Elixir.CHostControlProbe/snapshot/1")
          (old (lambda (x) (+ x 1))) (new (lambda (x) (+ x 10))))
    (c-host-service-install! key old)
    (let ((captured (native-c-remote key)))
     (c-host-service-check 'existing-nonhost-leaf-binding-unchanged (eq? captured old))
     (native-c-replace-leaf! key old new 1)
     (c-host-service-check 'nonhost-raw-function-snapshot-unchanged (= 8 (bl-invoke captured '(7))))))
   ;; These are controlled stand-ins at the REAL API keys. Capturing a raw
   ;; procedure before replacement reproduces the failed witness/deny wiring.
   ;; No stand-in executes the real Scheme evaluator or native unit loader.
   (let ((key "host/eval-scheme/1") (old-calls 0) (denied 0))
    (c-host-service-install! key (lambda (text) (set! old-calls (+ old-calls 1)) (bl-key "old")))
    (let ((captured (native-c-remote key)))
     (c-host-service-check 'scheme-evaluator-service-is-descriptor (native-c-remote? captured))
     (c-host-service-check 'initial-evaluator-standin
      (eq? (c-host-service-action captured '("owned data")) (bl-key "old")))
     (c-host-service-install! key (lambda (text) (set! denied (+ denied 1)) (error "fixture Scheme deny hook")))
     (c-host-service-check 'already-captured-service-honors-scheme-deny
      (c-host-service-refused? (lambda () (c-host-service-action captured '("forbidden Source body")))))
     (c-host-service-check 'scheme-deny-ran-exactly-once (= denied 1))
     (c-host-service-check 'scheme-original-not-reentered (= old-calls 1))))
   (let ((key "host/set-native-backend/1") (old-calls 0) (guard-calls 0))
    (c-host-service-install! key (lambda (backend) (set! old-calls (+ old-calls 1)) backend))
    (let ((captured (native-c-remote key)))
     (c-host-service-check 'backend-service-is-descriptor (native-c-remote? captured))
     (c-host-service-install! key (lambda (backend)
      (set! guard-calls (+ guard-calls 1))
      (if (not (eq? backend (bl-key "c"))) (error "fixture C backend guard")) backend))
     (c-host-service-check 'already-captured-backend-service-honors-c
      (eq? (c-host-service-action captured (list (bl-key "c"))) (bl-key "c")))
     (c-host-service-check 'already-captured-backend-service-denies-scheme
      (c-host-service-refused? (lambda () (c-host-service-action captured (list (bl-key "scheme"))))))
     (c-host-service-check 'backend-guard-observes-both-calls (= guard-calls 2))
     (c-host-service-check 'backend-original-not-reentered (= old-calls 0))))
   (let ((key "host/eval-c-unit/1") (old-calls 0) (witness-calls 0))
    (c-host-service-install! key (lambda (unit) (set! old-calls (+ old-calls 1)) (bl-key "old")))
    (let ((captured (native-c-remote key)) (unit (bl-map (bl-key "unit") 42)))
     (c-host-service-check 'c-unit-evaluator-service-is-descriptor (native-c-remote? captured))
     (c-host-service-install! key (lambda (value) (set! witness-calls (+ witness-calls 1)) value))
     (c-host-service-check 'already-captured-c-unit-service-observes-witness
      (eq? (c-host-service-action captured (list unit)) unit))
     (c-host-service-check 'c-unit-witness-exactly-once (= witness-calls 1))
     (c-host-service-check 'c-unit-original-not-reentered (= old-calls 0)))))
  (lambda () (set! native-leaf-registry saved-leaves) (native-c-refresh-target-cache!))))
(display "NATIVE_C_LATE_HOST_SERVICE_ABI_PASS ") (display c-host-service-checks) (newline)
