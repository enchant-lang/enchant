;; Host observation only; all authored functions come from actual .o1 modules.
(define scheme-module-proof-checks 0)
(define (scheme-module-proof-check label value)
 (if (not value) (error "native Scheme module probe failed" label))
 (set! scheme-module-proof-checks (+ scheme-module-proof-checks 1)))
(define (scheme-module-proof-native? value)
 (and (procedure? value) (not (##interp-procedure? value))))
(define (scheme-module-proof-parent value)
 (if (not (scheme-module-proof-native? value)) (error "module procedure is interpreted or absent"))
 (let ((parent (##subprocedure-parent (if (##closure? value) (##closure-code value) value))))
  (if (not (scheme-module-proof-native? parent)) (error "module procedure lacks a native owner"))
  parent))
(define (scheme-module-proof-binding name)
 ;; One metadata-selected SYMBOL read, never an authored Scheme body.
 (eval (string->symbol name) (interaction-environment)))
(define scheme-module-proof-existing-parents '())
(define (scheme-module-proof-observe-existing value)
 (cond
  ((scheme-module-proof-native? value)
   (let ((parent (with-exception-catcher (lambda (failure) #f)
                  (lambda () (scheme-module-proof-parent value)))))
    (if (and parent (not (memq parent scheme-module-proof-existing-parents)))
     (set! scheme-module-proof-existing-parents (cons parent scheme-module-proof-existing-parents)))))
  ((native-multi-callable? value)
   (for-each (lambda (row) (scheme-module-proof-observe-existing (bl-nth row 1)))
             (native-map-pairs (bl-nth value 1)))
   (if (not (bl-is-nil (bl-nth value 2)))
    (scheme-module-proof-observe-existing (bl-nth (bl-nth value 2) 1))))))
(for-each (lambda (registry)
 (for-each (lambda (row) (scheme-module-proof-observe-existing (bl-nth row 1)))
           (native-map-pairs registry)))
 (list native-global-registry native-leaf-registry))
(define (scheme-module-proof-parents names forbidden)
 (if (null? names) (error "module physical inventory is empty"))
 (map (lambda (name)
        (let ((parent (scheme-module-proof-parent (scheme-module-proof-binding name))))
         (if (memq parent forbidden) (error "module aliases an existing compiled owner" name))
         parent)) names))
(define scheme-module-proof-namespace @NAMESPACE@)
(define scheme-module-proof-refuse-eval
 (lambda arguments (error "authored Scheme evaluation is forbidden in native module probe")))
(define scheme-module-proof-first-answer-parents '())
(define scheme-module-proof-first-adder-parents '())
(define scheme-module-proof-second-answer-parents '())
(define scheme-module-proof-second-adder-parents '())
(define (scheme-module-proof-run)
 ;; The outer --eval has already entered this observer. Subsequent authored
 ;; function execution must not return to the finite Scheme evaluator.
 (let ((original (native-leaf "host/eval-scheme/1")))
  (if (not (eq? original native-eval-string)) (error "unexpected native eval boundary"))
  (native-mark-host-callable! scheme-module-proof-refuse-eval)
  (bl-register-callable! scheme-module-proof-refuse-eval 1)
  (set! native-leaf-registry
   (bl-assoc native-leaf-registry "host/eval-scheme/1" scheme-module-proof-refuse-eval))
  (set! native-eval-string scheme-module-proof-refuse-eval))
 (load @FIRST_MODULE@)
 (scheme-module-proof-check 'first-initializer-native
  (not (memq (scheme-module-proof-parent (scheme-module-proof-binding @FIRST_INITIALIZER@))
             scheme-module-proof-existing-parents)))
 (set! scheme-module-proof-first-answer-parents (scheme-module-proof-parents '@FIRST_ANSWER_PHYSICAL@ scheme-module-proof-existing-parents))
 (set! scheme-module-proof-first-adder-parents (scheme-module-proof-parents '@FIRST_ADDER_PHYSICAL@ scheme-module-proof-existing-parents))
 (scheme-module-proof-check 'first-answer-physical (pair? scheme-module-proof-first-answer-parents))
 (scheme-module-proof-check 'first-adder-physical (pair? scheme-module-proof-first-adder-parents))
 (bl-invoke (scheme-module-proof-binding @FIRST_INITIALIZER@) '())
 (let* ((answer-first (native-global-exact scheme-module-proof-namespace "answer"))
        (adder-first (native-global-exact scheme-module-proof-namespace "adder"))
        (held (bl-invoke adder-first (list 7)))
        (held-parent (scheme-module-proof-parent held)))
  (scheme-module-proof-check 'first-answer (= (bl-invoke answer-first '()) 42))
  (scheme-module-proof-check 'first-captured-native (memq held-parent scheme-module-proof-first-adder-parents))
  (scheme-module-proof-check 'first-capture (= (bl-invoke held (list 9)) 16))
  (load @SECOND_MODULE@)
  (scheme-module-proof-check 'second-initializer-native
   (not (memq (scheme-module-proof-parent (scheme-module-proof-binding @SECOND_INITIALIZER@))
              (append scheme-module-proof-existing-parents scheme-module-proof-first-answer-parents scheme-module-proof-first-adder-parents))))
  (set! scheme-module-proof-second-answer-parents (scheme-module-proof-parents '@SECOND_ANSWER_PHYSICAL@
    (append scheme-module-proof-existing-parents scheme-module-proof-first-answer-parents scheme-module-proof-first-adder-parents)))
  (set! scheme-module-proof-second-adder-parents (scheme-module-proof-parents '@SECOND_ADDER_PHYSICAL@
    (append scheme-module-proof-existing-parents scheme-module-proof-first-answer-parents scheme-module-proof-first-adder-parents)))
  (scheme-module-proof-check 'second-answer-physical (pair? scheme-module-proof-second-answer-parents))
  (scheme-module-proof-check 'second-adder-physical (pair? scheme-module-proof-second-adder-parents))
  (bl-invoke (scheme-module-proof-binding @SECOND_INITIALIZER@) '())
  (let* ((answer-second (native-global-exact scheme-module-proof-namespace "answer"))
         (adder-second (native-global-exact scheme-module-proof-namespace "adder"))
         (fresh (bl-invoke adder-second (list 7)))
         (fresh-parent (scheme-module-proof-parent fresh)))
   (scheme-module-proof-check 'second-answer (= (bl-invoke answer-second '()) 99))
   (scheme-module-proof-check 'second-captured-native (memq fresh-parent scheme-module-proof-second-adder-parents))
   (scheme-module-proof-check 'second-capture (= (bl-invoke fresh (list 9)) 116))
   (scheme-module-proof-check 'first-capture-retained (= (bl-invoke held (list 9)) 16))
   (scheme-module-proof-check 'distinct-revision-functions (not (eq? answer-first answer-second)))
   (##gc)
   (scheme-module-proof-check 'first-capture-after-gc
    (and (eq? held-parent (scheme-module-proof-parent held)) (= (bl-invoke held (list 9)) 16)))
   (scheme-module-proof-check 'second-capture-after-gc
    (and (eq? fresh-parent (scheme-module-proof-parent fresh)) (= (bl-invoke fresh (list 9)) 116)))
   (scheme-module-proof-check 'first-answer-after-gc (= (bl-invoke answer-first '()) 42))
   (scheme-module-proof-check 'second-answer-after-gc (= (bl-invoke answer-second '()) 99))))
 (if (not (= scheme-module-proof-checks 18)) (error "native module probe count differs"))
 (display "NATIVE_SCHEME_MODULE_PROOF_PASS 18\n") (force-output)
 (exit 0))
(with-exception-catcher
 (lambda (failure) (display-exception failure) (newline) (exit 1))
 scheme-module-proof-run)
;; The ORIGINAL owned bundle DATA follows; exit above prevents macro boot.
