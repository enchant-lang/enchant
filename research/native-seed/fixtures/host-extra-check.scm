(define (native-extra-check label ok) (if (not ok) (error (string-append "native extra check failed: " label))))
(native-extra-check "ETF small integer size" (= 3 (native-external-number-size 255)))
(native-extra-check "ETF signed integer size" (= 6 (native-external-number-size -1)))
(native-extra-check "ETF big integer size" (= 13 (native-external-number-size (expt 2 64))))
(native-extra-check "ETF float size" (= 10 (native-external-number-size (bl-float 1.0))))
(native-extra-check "raw numeric excludes decimal" (not (bl-invoke (native-leaf "erlang/is_number/1") (list (bl-decimal 1 0)))))
(native-extra-check "UTF16 actor length" (= 4 (h-str-size "a😀b")))
(native-extra-check "UTF16 actor slice" (string=? "😀" (h-str-slice "a😀b" 1 3)))
(native-extra-check "UTF16 surrogate slicing" (equal? (h-str-codepoints (h-str-slice "😀" 0 1)) '(55357)))
(native-extra-check "actor key codec string" (= 9 (native-actor-key-length "😀😀😀")))
(native-extra-check "actor key codec tuple" (= 10 (native-actor-key-length (bl-tuple '("x")))))
(native-extra-check "JS float display boundary" (string=? "1e+21" (native-js-float-text 1e21)))
(let ((table (h-table-new)))
 (h-table-insert table (make-string 65529 #\x) 1)
 (native-extra-check "exact table key bound" (= 1 (h-table-size table)))
 (let ((refused #f))
  (with-exception-catcher (lambda (e) (set! refused #t))
   (lambda () (h-table-insert table (make-string 65530 #\x) 2)))
  (native-extra-check "oversized table key refuses before mutation" (and refused (= 1 (h-table-size table)))))
 (h-table-destroy table))
(let ((set-fields (native-struct-fields (native-set-from-list '(1 2)))))
 (let* ((members (bl-get set-fields (bl-key "members"))) (entries (bl-get members (bl-key "map"))))
  (native-extra-check "canonical MapSet struct projection" (eq? (native-struct-module members) (bl-key "Elixir.MapSet")))
  (native-extra-check "canonical empty list membership marker" (null? (bl-get entries 1)))))
(native-extra-check "arity annotation" (native-callable-accepts? (bl-register-callable! (lambda (x) x) 1) 1))
(let* ((high (h-str-slice "😀" 0 1)) (low (h-str-slice "😀" 1 2)))
 (native-extra-check "surrogate fragment is actor string" (h-is-str high))
 (native-extra-check "surrogate fragment size" (= 1 (h-str-size high)))
 (native-extra-check "surrogate pair concat restores scalar" (string=? "😀" (h-str-cat high low)))
 (native-extra-check "surrogate key codec length" (= 4 (native-actor-key-length high)))
 (native-extra-check "surrogate keyword name round trip" (bl-equal? high (h-kw-name (h-kw high))))
 (let ((refused #f))
  (with-exception-catcher (lambda (e) (set! refused #t)) (lambda () (native-utf8-bytes high)))
  (native-extra-check "invalid scalar binary boundary explicit" refused)))
(let ((atom (native-ref-new 'atom 3)))
 (native-extra-check "atom raw map predicate" (bl-invoke (native-leaf "erlang/is_map/1") (list atom)))
 (native-extra-check "atom raw struct module" (eq? (native-map-fetch (bl-key "__struct__") atom) (bl-key "Elixir.BeamLisp.Atom")))
 (native-extra-check "atom cell is reference" (native-reference? (native-map-fetch (bl-key "cell") atom))))
(let ((atom (native-ref-new 'atom 1)) (notices '()))
 (native-ref-add-watch atom (bl-key "watch")
  (lambda (key ref old new) (set! notices (cons (bl-tuple (list old new)) notices))))
 (native-ref-commit atom 1)
 (native-extra-check "watch observes committed no-op" (= 1 (length notices)))
 (native-extra-check "CAS numeric equality" (native-ref-cas atom (bl-float 1.0) 2))
 (native-extra-check "CAS mismatch" (not (native-ref-cas atom 1 3)))
 (native-extra-check "CAS commits before watch" (= 2 (native-ref-deref atom))))
(let ((promise (native-promise-new)))
 (native-extra-check "promise zero-timeout" (eq? (native-ref-deref promise 0 (bl-key "timeout")) (bl-key "timeout")))
 (native-extra-check "first deliver returns promise" (eq? (native-promise-deliver promise bl-nil) promise))
 (native-extra-check "present nil promise value" (bl-is-nil (native-ref-deref promise)))
 (native-extra-check "second deliver returns nil" (bl-is-nil (native-promise-deliver promise 3))))
(let ((transient (native-transient (bl-vec '(1)))))
 (native-transient-conj transient 2)
 (native-extra-check "transient vector persistent snapshot" (bl-equal? (native-transient-persistent transient) (bl-vec '(1 2))))
 (let ((refused #f))
  (with-exception-catcher (lambda (e) (set! refused #t)) (lambda () (native-transient-state transient)))
  (native-extra-check "transient consumed once" refused)))
;; Validate actual canonical passive projection at both radix growth edges.
(let sizes ((counts '(0 5 32 33 257 1025 1056 1057)))
 (if (pair? counts)
  (let* ((count (car counts))
         (value (bl-vec (let loop ((i (- count 1)) (xs '())) (if (< i 0) xs (loop (- i 1) (cons i xs))))))
         (meta (bl-map (bl-key "line") 17))
         (value (native-vector-with-meta value meta))
         (items (native-map-fetch (bl-key "items") value))
         (fields (native-struct-fields value))
         (restored (bl-struct (bl-key "Elixir.BeamLisp.Vector") fields)))
   (native-extra-check "canonical vector count snapshot" (= count (native-vector-count restored)))
   (native-extra-check "canonical vector snapshot preserves elements" (bl-equal? value restored))
   (native-extra-check "canonical vector metadata preserved" (bl-equal? meta (native-vector-meta restored)))
   (native-extra-check "canonical vector exact field count" (= 3 (native-raw-map-size value)))
   (if (> count 32)
    (begin
     (native-extra-check "canonical vector has trie tag" (eq? (bl-nth items 0) (bl-key "bl_vec")))
     (native-extra-check "canonical vector root32" (= 32 (bl-count (bl-nth items 3)))))
    (native-extra-check "canonical small vector dense bound" (<= (bl-count items) 32)))
   (sizes (cdr counts)))))
(native-extra-check "raw binary order uses codepoints"
 (< (native-term-compare "" "😀") 0))
(native-extra-check "actor string order uses UTF16"
 (> (h-str-cmp "" "😀") 0))
(native-extra-check "Num nondecimal term comparison retained"
 (native-num 'lt (bl-key "a") (bl-key "b")))
(let ((refused #f))
 (with-exception-catcher (lambda (e) (set! refused #t))
  (lambda () (native-num 'lt (bl-decimal 1 1) (bl-float 0.1))))
 (native-extra-check "Num decimal float promotion refuses" refused))
(native-extra-check "mandatory float decimal point" (string=? "1.0" (native-shortest-float-text (bl-float 1.0))))
(native-extra-check "negative float zero spelling" (string=? "-0.0" (native-shortest-float-text (bl-float -0.0))))
(native-extra-check "short float scientific policy" (string=? "1.0e-6" (native-shortest-float-text (bl-float 0.000001))))
(let* ((nth (native-leaf "Elixir.BeamLisp.Vector/nth/2"))
       (value (bl-vec '(10 20 30))))
 (native-extra-check "Vector nth present element" (= 20 (bl-invoke nth (list value 1))))
 (native-extra-check "Vector nth optional missing field" (bl-is-nil (bl-invoke nth (list value 3))))
 (native-extra-check "Vector nth negative index" (bl-is-nil (bl-invoke nth (list value -1))))
 (native-extra-check "Vector nth noninteger index" (bl-is-nil (bl-invoke nth (list value (bl-float 1.0)))))
 (let ((caught #f))
  (with-exception-catcher
   (lambda (e) (set! caught
    (and (native-raised? e)
     (eq? (native-struct-module (native-exception-reason e)) (bl-key "Elixir.FunctionClauseError"))
     (eq? (bl-get (native-exception-reason e) (bl-key "function")) (bl-key "nth"))
     (= (bl-get (native-exception-reason e) (bl-key "arity")) 2))))
   (lambda () (bl-invoke nth (list '(10 20 30) 1))))
  (native-extra-check "Vector nth nonvector function clause" caught)))
;; Raw is_list must stay O(1), including improper conses. The actor host's
;; proper-list match-spec gate is a distinct ABI and must keep rejecting them.
(let ((raw (native-leaf "erlang/is_list/1")) (improper (cons 1 2)))
 (native-extra-check "raw is_list empty" (bl-invoke raw (list '())))
 (native-extra-check "raw is_list proper cons" (bl-invoke raw (list '(1 2))))
 (native-extra-check "raw is_list improper cons tag" (bl-invoke raw (list improper)))
 (native-extra-check "raw is_list rejects nil atom" (not (bl-invoke raw (list bl-nil))))
 (native-extra-check "proper argument validation rejects improper cons" (not (native-list? improper)))
 (native-extra-check "actor match spec list gate stays proper" (not (h-is-list improper))))
;; Scalar fast path preserves JavaScript UTF16 order at the BMP boundary.
(native-extra-check "UTF16 ASCII equal and prefix"
 (and (= 0 (h-str-cmp "ascii" (string-append "as" "cii")))
      (< (h-str-cmp "ascii" "ascii-more") 0) (> (h-str-cmp "b" "a") 0)
      (< (h-str-cmp "" "a") 0) (> (h-str-cmp "a" "") 0)))
(native-extra-check "UTF16 astral versus private BMP order"
 (and (< (h-str-cmp "😀" "") 0) (> (h-str-cmp "" "😀") 0)
      (> (h-str-cmp "😀" "퟿") 0)))
(native-extra-check "UTF16 supplementary pair order"
 (and (< (h-str-cmp "𐀀" "𠀀") 0) (< (h-str-cmp "😀" "😁") 0)))
(let ((high (h-str-slice "😀" 0 1)) (low (h-str-slice "😀" 1 2)))
 (native-extra-check "UTF16 lone-surrogate fallback preserved"
  (and (< (h-str-cmp high "😀") 0) (> (h-str-cmp low "😀") 0)
       (< (h-str-cmp high "") 0) (= 0 (h-str-cmp high (h-str-slice "😀" 0 1))))))
;; Raw BIF contract is distinct from the language callable ABI.
(let* ((raw (native-leaf "erlang/apply/2")) (entered #f)
       (function (bl-register-callable! (lambda args (set! entered #t) (+ 1 (car args))) 1))
       (arguments '(9 10))
       (multi (bl-tuple (list (bl-key "$blfn") (bl-map 1 function) bl-nil))))
 (define (capture-error thunk)
  (with-exception-catcher (lambda (e) (if (native-raised? e) (native-exception-reason e) (raise e))) thunk))
 (native-extra-check "raw apply valid fun" (= 10 (bl-invoke raw (list function '(9)))))
 (set! entered #f)
 (let* ((reason (capture-error (lambda () (bl-invoke raw (list function arguments)))))
        (details (bl-nth reason 1)))
  (native-extra-check "raw apply badarity original function and arguments"
   (and (eq? (bl-nth reason 0) (bl-key "badarity")) (eq? (bl-nth details 0) function)
        (eq? (bl-nth details 1) arguments) (not entered))))
 (native-extra-check "raw apply improper args badarg"
  (eq? (capture-error (lambda () (bl-invoke raw (list function (cons 1 2))))) (bl-key "badarg")))
 (native-extra-check "raw apply nonlist before badfun"
  (eq? (capture-error (lambda () (bl-invoke raw (list (bl-key "x") (bl-vec '(1)))))) (bl-key "badarg")))
 (for-each (lambda (value)
  (let ((reason (capture-error (lambda () (bl-invoke raw (list value '(9)))))))
   (native-extra-check "raw apply rejects nonfun callable"
    (and (eq? (bl-nth reason 0) (bl-key "badfun")) (eq? (bl-nth reason 1) value)))))
  (list (bl-key "x") (bl-map 9 10) (bl-vec '(10)) multi))
 (native-extra-check "raw function predicate rejects dispatcher"
  (not (bl-invoke (native-leaf "erlang/is_function/1") (list multi))))
 (native-extra-check "language callable dispatch preserved"
  (and (= 10 (bl-invoke multi '(9))) (= 10 (bl-invoke (bl-map 9 10) '(9)))
       (= 10 (bl-invoke (bl-key "x") (list (bl-map (bl-key "x") 10)))))))
(let* ((items '(10 20 30)) (drop (native-leaf "lists/nthtail/2")))
 (native-extra-check "nthtail takes index before list"
  (and (eq? items (bl-invoke drop (list 0 items)))
       (equal? '(30) (bl-invoke drop (list 2 items)))
       (null? (bl-invoke drop (list 3 items))))))
(display "native extra checks passed") (newline)
