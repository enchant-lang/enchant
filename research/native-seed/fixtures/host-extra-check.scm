(define (native-extra-check label ok) (if (not ok) (error (string-append "native extra check failed: " label))))
(native-extra-check "ETF small integer size" (= 3 (native-external-number-size 255)))
(native-extra-check "ETF signed integer size" (= 6 (native-external-number-size -1)))
(native-extra-check "ETF big integer size" (= 13 (native-external-number-size (expt 2 64))))
(native-extra-check "ETF float size" (= 10 (native-external-number-size (bl-float 1.0))))
(native-extra-check "raw numeric excludes decimal" (not (bl-invoke (native-leaf "erlang/is_number/1") (list (bl-decimal 1 0)))))
(native-extra-check "UTF16 actor length" (= 4 (h-str-size "a😀b")))
(native-extra-check "UTF16 actor slice" (string=? "😀" (h-str-slice "a😀b" 1 3)))
(native-extra-check "UTF16 surrogate slicing" (equal? (h-str-codepoints (h-str-slice "😀" 0 1)) '(55357)))
(native-extra-check "actor key codec string" (= 9 (native-actor-key-length "😀😀😀")))
(native-extra-check "actor key codec tuple" (= 10 (native-actor-key-length (bl-tuple '("x")))))
(native-extra-check "JS float display boundary" (string=? "1e+21" (native-js-float-text 1e21)))
(let ((table (h-table-new)))
 (h-table-insert table (make-string 65529 #\x) 1)
 (native-extra-check "exact table key bound" (= 1 (h-table-size table)))
 (let ((refused #f))
  (with-exception-catcher (lambda (e) (set! refused #t))
   (lambda () (h-table-insert table (make-string 65530 #\x) 2)))
  (native-extra-check "oversized table key refuses before mutation" (and refused (= 1 (h-table-size table)))))
 (h-table-destroy table))
(let ((set-fields (native-struct-fields (native-set-from-list '(1 2)))))
 (let* ((members (bl-get set-fields (bl-key "members"))) (entries (bl-get members (bl-key "map"))))
  (native-extra-check "canonical MapSet struct projection" (eq? (native-struct-module members) (bl-key "Elixir.MapSet")))
  (native-extra-check "canonical empty list membership marker" (null? (bl-get entries 1)))))
(native-extra-check "arity annotation" (native-callable-accepts? (bl-register-callable! (lambda (x) x) 1) 1))
(display "native extra checks passed") (newline)
