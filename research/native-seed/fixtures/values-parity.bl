; One exact Source program for BEAM, the production JS actor backend, and the
; native canonical core/rt backend. Inputs/boundaries come from the existing
; numeric_equality_test.bl and numeric-values.bl; no host arithmetic oracle.
(ns native.values-parity)
(def finite-numbers
 [0 -0.0 0M 0.00M 1 1.0 1M 1.00M 1.5 1.5M 1.50M
  0.1 0.1M 0.5 0.50M 9007199254740992 9007199254740992.0
  9007199254740993 -9007199254740993])
(defn tail-sum [n total]
 (if (= n 0) total (recur (dec n) (+ total n))))
(defn multiple ([x] x) ([x y] (+ x y)) ([x y & more] (reduce + (+ x y) more)))
(defn pair-line [i j]
 (let [a (nth finite-numbers i) b (nth finite-numbers j)]
  (str "pair " i " " j " " (= a b) " " (compare a b)
       " " (= (list a) [b]) " " (= {:value a} {:value b})
       " " (= (tuple :meta a {:origin :ignored}) b)
       " " (count (set [a b])))))
(defn boundary-lines []
 (let [m {4 "integer" 4.0 "float"} d {1.5M "tenths" 1.50M "hundredths"}
       old {:answer 1} fresh (assoc old :answer 2)
       v (vec (range 1057)) changed (assoc v 1024 :changed)
       self (fn self-value [] self-value)]
  [(str "case raw-float-keys " (and (= "integer" (get m 4)) (= "float" (get m 4.0)) (= 2 (count m))))
   (str "case raw-decimal-keys " (and (= "tenths" (get d 1.5M)) (= "hundredths" (get d 1.50M)) (= 2 (count d))))
   (str "case persistent-map " (and (= 1 (:answer old)) (= 2 (:answer fresh))))
   (str "case persistent-vector " (and (= 1057 (count v)) (= 1024 (nth v 1024)) (= :changed (nth changed 1024)) (= 1056 (nth changed 1056))))
   (str "case metadata-equality " (= (tuple :meta 1.50M {:origin :ignored}) 1.5))
   (str "case exact-integer " (= 9007199254740994 (+ 9007199254740993 1)))
   (str "case quotient " (= -3 (quot -10 3)))
   (str "case remainder " (= -1 (rem -10 3)))
   (str "case modulo " (= 2 (mod -10 3)))
   (str "case division-float " (and (float? (/ 8 2)) (not (identical? (/ 8 2) 4)) (= (/ 8 2) 4)))
   (str "case decimal-add " (= 2.5M (+ 1.5M 1)))
   (str "case decimal-scale " (= "1.50" (str 1.50M)))
   (str "case unicode " (= ["λ" "😀" "\uff5e" "()[]{}\"\\"] (mapv identity ["λ" "😀" "\uff5e" "()[]{}\"\\"])))
   (str "case tail-call " (= 8256 (tail-sum 128 0)))
   (str "case multi-callable " (= [1 3 10] [(multiple 1) (multiple 1 2) (multiple 1 2 3 4)]))
   (str "case self-identity " (identical? self (self)))]))
(defn parity-lines []
 (into (vec (for [i (range (count finite-numbers)) j (range (count finite-numbers))] (pair-line i j)))
       (boundary-lines)))
(defn main []
 (doseq [line (parity-lines)] (println (str "VALUES " line)))
 (println "VALUES-DONE"))
