; Run as ORIGINAL source by each native compiler stage. These checks must
; traverse the native canonical reader, macro expander, compiler and emitter.
(ns native.compiler-source-corpus)
(defn factorial [n] (loop [n n out 1] (if (= n 0) out (recur (dec n) (* out n)))))
(assert (= 3628800 (factorial 10)))
(defn multiple ([x] x) ([x y] (+ x y)) ([x y & more] (reduce + (+ x y) more)))
(assert (= [1 3 10] [(multiple 1) (multiple 1 2) (multiple 1 2 3 4)]))
(defmacro twice [x] (list 'let ['value__native x] (list '+ 'value__native 'value__native)))
(assert (= 14 (twice 7)))
(assert (= "λ" (first ["λ" "actor"])))
(assert (= {:answer 42} (assoc {} :answer (+ 40 2))))
(assert (= [2 4 6] (mapv (fn [x] (* x 2)) [1 2 3])))
(assert (= 2 (try (throw {:native-error true}) (catch e (if (:native-error (ex-data e)) 2 3)))))
(assert (= 13 (let [f (fn [x] (fn [y] (+ x y)))] ((f 5) 8))))
(defmacro literal-members [] #{:alpha :beta})
(assert (= #{:alpha :beta} (literal-members)))
(ns native.compiler-hygiene)
(defn add-one [x] (+ x 1))
(defmacro add-original [x] `(add-one ~x))
(ns native.compiler-source-corpus)
(defn add-one [x] (+ x 100))
(assert (= 6 (native.compiler-hygiene/add-original 5)))
(assert (= {:raw true} (try (erlang/throw {:raw true}) (catch e e))))
; Append to the original-source compiler corpus: no precompiled fixture AST.
(ns native.multi-self-source)
(defn cross-defn
 ([x] (cross-defn x 7))
 ([x y] (+ x y)))
(assert (= 12 (cross-defn 5)))
(let [f (fn local-cross ([x] (local-cross x 9)) ([x y] (+ x y)))]
 (assert (= 14 (f 5))))
(defn cross-fixed-variadic
 ([x] (cross-fixed-variadic x 2 3))
 ([x y & more] (+ x y (reduce + 0 more))))
(assert (= 10 (cross-fixed-variadic 5)))
(let [f (fn self-value ([] self-value) ([x] (+ x 1)))]
 (assert (identical? f (f)))
 (assert (= 9 ((f) 8))))
(let [outer (fn outer-cross
              ([] (outer-cross 3))
              ([x] (let [inner (fn inner-cross ([] (outer-cross 7 8)) ([v] v))] (inner)))
              ([x y] (+ x y)))]
 (assert (= 15 (outer))))
(println "NATIVE_MULTI_SELF_DISPATCH_OK")

; Single-arity fixed points must preserve identity even without source frames.
(ns native.single-self-source)
(let [f (fn single-self [] single-self)]
 (assert (identical? f (f)))
 (assert (identical? f ((f)))))
(let [outer (fn outer-self [x]
              (fn inner-self [y]
               (cond (= y :self) inner-self
                     (= y :outer) outer-self
                     :else (+ x y))))
      inner (outer 7)]
 (assert (identical? inner (inner :self)))
 (assert (identical? outer (inner :outer)))
 (assert (= 12 (inner 5)))
 (assert (= 14 (((inner :outer) 9) 5))))
(println "NATIVE_SINGLE_SELF_IDENTITY_OK")

; Enum's native collection boundary must consume canonical sequence cells,
; never LazySeq or SeqCursor storage fields. Delimiters remain ordinary strings.
(ns native.lazy-enum-source)
(assert (= "λ|()|[]|{}|\"|\\"
 (clojure.string/join "|" (map identity ["λ" "()" "[]" "{}" "\"" "\\"]))))
(let [effects (atom 0)
      values (map (fn [value] (swap! effects inc) (str "<" value ">")) ["λ" "[]" "{}"])]
 (assert (= "<λ>|<[]>|<{}>" (clojure.string/join "|" values)))
 (assert (= 3 (deref effects)))
 (assert (= "<λ>|<[]>|<{}>" (clojure.string/join "|" values)))
 (assert (= 3 (deref effects))))
(assert (= "cursor|λ" (Enum/join (BeamLisp.SeqCursor/new (list "cursor" "λ")) "|")))
(println "NATIVE_LAZY_ENUM_BOUNDARY_OK")

; Both pattern and guard failures must share a bounded emitted suffix.
; Twenty-four rejected guards used to duplicate that suffix exponentially.
(ns native.guarded-clause-source)
(defn guarded-chain
 ([x] :when (and (int? x) (< x 0)) :negative)
 ([x] :when (= x 0) 0)
 ([x] :when (= x 1) 1)
 ([x] :when (= x 2) 2)
 ([x] :when (= x 3) 3)
 ([x] :when (= x 4) 4)
 ([x] :when (= x 5) 5)
 ([x] :when (= x 6) 6)
 ([x] :when (= x 7) 7)
 ([x] :when (= x 8) 8)
 ([x] :when (= x 9) 9)
 ([x] :when (= x 10) 10)
 ([x] :when (= x 11) 11)
 ([x] :when (= x 12) 12)
 ([x] :when (= x 13) 13)
 ([x] :when (= x 14) 14)
 ([x] :when (= x 15) 15)
 ([x] :when (= x 16) 16)
 ([x] :when (= x 17) 17)
 ([x] :when (= x 18) 18)
 ([x] :when (= x 19) 19)
 ([x] :when (= x 20) 20)
 ([x] :when (= x 21) 21)
 ([x] :when (= x 22) 22)
 ([x] :when (= x 23) 23)
 ([x] :fallback))
(assert (= [:negative 0 11 23 :fallback :fallback]
 [(guarded-chain -1) (guarded-chain 0) (guarded-chain 11)
  (guarded-chain 23) (guarded-chain 24) (guarded-chain :other)]))
(let [f (fn ([clause-next] :when (= clause-next 1) clause-next)
            ([clause-next] clause-next))]
 (assert (= [1 2] [(f 1) (f 2)])))
(println "NATIVE_GUARDED_CLAUSE_CHAIN_OK")

(println "NATIVE_COMPILER_SOURCE_CORPUS_OK")
