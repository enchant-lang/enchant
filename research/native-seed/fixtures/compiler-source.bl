; Run as ORIGINAL source by each native compiler stage. These checks must
; traverse the native canonical reader, macro expander, compiler and emitter.
(ns native.compiler-source-corpus)
(defn factorial [n] (loop [n n out 1] (if (= n 0) out (recur (dec n) (* out n)))))
(assert (= 3628800 (factorial 10)))
(defn multiple ([x] x) ([x y] (+ x y)) ([x y & more] (reduce + (+ x y) more)))
(assert (= [1 3 10] [(multiple 1) (multiple 1 2) (multiple 1 2 3 4)]))
(defmacro twice [x] (list 'let ['value__native x] (list '+ 'value__native 'value__native)))
(assert (= 14 (twice 7)))
(assert (= "λ" (first ["λ" "actor"])))
(assert (= {:answer 42} (assoc {} :answer (+ 40 2))))
(assert (= [2 4 6] (mapv (fn [x] (* x 2)) [1 2 3])))
(assert (= 2 (try (throw {:native-error true}) (catch e (if (:native-error e) 2 3)))))
(assert (= 13 (let [f (fn [x] (fn [y] (+ x y)))] ((f 5) 8))))
(println "NATIVE_COMPILER_SOURCE_CORPUS_OK")
