;; Host dispatch ABI only. Existing legacy105 checks remain unchanged.
(define c-symbol-checks 0)
(define (c-symbol-check label ok)
 (if (not ok) (error "private symbolic MFA ABI" label))
 (set! c-symbol-checks (+ c-symbol-checks 1)))
(define (c-symbol-refused? thunk)
 (with-exception-catcher (lambda (failure) #t) (lambda () (thunk) #f)))
(let ((saved-leaves native-leaf-registry) (saved-modules native-module-names)
      (saved-arities native-export-arities) (saved-globals native-global-registry)
      (saved-excluded native-excluded-host-leaves) (saved-leaf native-leaf)
      (saved-parse native-c-parse-remote) (saved-enabled native-c-symbol-remotes-enabled?)
      (saved-predicate native-c-remote?) (saved-base native-c-resolve-without-remote)
      (saved-planner native-c-resolve-call))
 (dynamic-wind
  (lambda () #f)
  (lambda ()
   (c-symbol-check 'arbitrary-host-default-off (not native-c-symbol-remotes-enabled?))
   (set! native-c-symbol-remotes-enabled? #t)
   (let* ((module "Elixir.CSymbolOne") (one "c.symbol.one") (two "c.symbol.two")
          (key (string-append module "/pick/1"))
          (f (bl-register-callable! (lambda (x) (+ x 10)) 1))
          (g (bl-register-callable! (lambda (x) (+ x 100)) 1))
          (f2 (bl-register-callable! (lambda (x y) (+ x y)) 2)))
    (set! native-module-names (bl-assoc native-module-names module one))
    (native-register! one "pick" f)
    (native-register-arities! one "pick" (bl-vec '(1)) bl-nil)
    (native-register! two "pick" g)
    (native-register-arities! two "pick" (bl-vec '(1)) bl-nil)
    (native-register! one "sick" f2)
    (native-register-arities! one "sick" (bl-vec '(2)) bl-nil)
    (let* ((d (native-c-remote key)) (legacy (native-c-symbol-original d)))
     (c-symbol-check 'factory-private7 (= (vector-length d) 7))
     (c-symbol-check 'legacy-parser-still6 (= (vector-length (native-c-parse-remote key)) 6))
     (c-symbol-check 'both-recognized (and (native-c-remote? d) (native-c-remote? legacy)))
     (c-symbol-check 'immutable-symbol-fields
      (and (symbol? (vector-ref d 1)) (symbol? (vector-ref d 2)) (symbol? (vector-ref d 5))))
     (c-symbol-check 'original-key-identity (eq? key (vector-ref legacy 5)))
     (c-symbol-check 'first-target (eq? f (native-c-remote-target d)))
     (let ((entry (table-ref native-c-remote-target-cache d native-missing)))
      (c-symbol-check 'new-shape-cached (not (eq? entry native-missing)))
      (c-symbol-check 'positive-hit (eq? f (native-c-remote-target d)))
      (c-symbol-check 'positive-entry-reused
       (eq? entry (table-ref native-c-remote-target-cache d native-missing))))
     (native-register! one "pick" g)
     (c-symbol-check 'live-source-redefinition (eq? g (native-c-remote-target d)))
     (native-register! one "pick" f)
     (set! native-module-names (bl-assoc native-module-names module two))
     (c-symbol-check 'live-module-alias (eq? g (native-c-remote-target d)))
     (set! native-module-names (bl-assoc native-module-names module one))
     (c-symbol-check 'module-readmission (eq? f (native-c-remote-target d)))
     (native-register-arities! one "pick" (bl-vec '(2)) bl-nil)
     (c-symbol-check 'live-published-arity (c-symbol-refused? (lambda () (native-c-remote-target d))))
     (native-register-arities! one "pick" (bl-vec '(1)) bl-nil)
     (c-symbol-check 'arity-readmission (eq? f (native-c-remote-target d)))
     (set! native-leaf-registry (bl-assoc native-leaf-registry key g))
     (c-symbol-check 'live-leaf-priority (eq? g (native-c-remote-target d)))
     (set! native-leaf-registry (native-map-remove native-leaf-registry key))
     (c-symbol-check 'leaf-removal (eq? f (native-c-remote-target d)))
     (set! native-excluded-host-leaves (cons key saved-excluded))
     (c-symbol-check 'live-exclusion (c-symbol-refused? (lambda () (native-c-remote-target d))))
     (set! native-excluded-host-leaves saved-excluded)
     (c-symbol-check 'exclusion-readmission (eq? f (native-c-remote-target d)))
     (let* ((metadata (bl-get native-export-arities (native-row one "pick")))
            (fields (vector-ref metadata 1)) (fixed (vector-ref fields 0)))
      (vector-set! fields 0 (bl-vec '(2)))
      (c-symbol-check 'same-root-metadata-mutation
       (c-symbol-refused? (lambda () (native-c-remote-target d))))
      (vector-set! fields 0 fixed))
     (c-symbol-check 'same-root-metadata-restoration (eq? f (native-c-remote-target d)))
     ;; Field mutation violates the PRIVATE immutable protocol; legacy6 below
     ;; still supports raw host mutation. Never interpret a forged alias.
     (let ((original (vector-ref d 1)))
      (vector-set! d 1 (string->symbol "Elixir.ForgedAlias"))
      (c-symbol-check 'private-field-mutation-refused
       (c-symbol-refused? (lambda () (native-c-remote-target d))))
      (vector-set! d 1 original))
     (c-symbol-check 'private-field-restoration (eq? f (native-c-remote-target d)))
     ;; Any effectful lookup sees the EXACT original key. Its mutation of the
     ;; retained legacy object survives restoration and changes planner arity.
     (let ((seen #f) (calls 0))
      (set! native-leaf (lambda (input)
       (set! calls (+ calls 1)) (set! seen (eq? input key))
       (vector-set! legacy 2 "sick") (vector-set! legacy 3 2)
       (saved-leaf input)))
      (c-symbol-check 'effectful-lookup-captures-original-fields
       (eq? f (native-c-remote-target d)))
      (c-symbol-check 'effectful-key-object-preserved seen)
      (c-symbol-check 'effectful-lookup-once (= calls 1))
      (set! native-leaf saved-leaf))
     (c-symbol-check 'permanent-demotion (vector-ref (vector-ref d 6) 1))
     (c-symbol-check 'retained-legacy-mutation-survives (eq? f2 (native-c-remote-target d)))
     (let ((plan (native-c-resolve-call d '(3 4))))
      (c-symbol-check 'demoted-planner-live-arity (eq? f2 (car plan)))
      (c-symbol-check 'demoted-planner-keeps-args (equal? '(3 4) (cdr plan))))
     (vector-set! legacy 2 "pick") (vector-set! legacy 3 1)
     (c-symbol-check 'legacy-restoration-keeps-demotion
      (and (eq? f (native-c-remote-target d)) (vector-ref (vector-ref d 6) 1))))
    (let ((returned #f) (calls 0))
     (set! native-c-parse-remote (lambda (input)
      (set! calls (+ calls 1)) (set! returned (saved-parse input)) returned))
     (let ((value (native-c-remote key)))
      (c-symbol-check 'custom-parser-result-identity (eq? value returned))
      (c-symbol-check 'custom-parser-legacy-shape (= (vector-length value) 6))
      (c-symbol-check 'custom-parser-called-once (= calls 1)))
     (set! native-c-parse-remote saved-parse))
    (c-symbol-check 'new-reference-after-hook-restoration (native-c-symbol-remote? (native-c-remote key)))
    (set! native-c-symbol-remotes-enabled? #f)
    (c-symbol-check 'runtime-off-factory-is-legacy (= (vector-length (native-c-remote key)) 6))
    (set! native-c-symbol-remotes-enabled? #t)
    (c-symbol-check 'runtime-on-factory-is-private7 (native-c-symbol-remote? (native-c-remote key)))
    (let* ((d (native-c-remote key)) (legacy (native-c-symbol-original d)) (seen #f))
     (set! native-c-remote? (lambda (value)
      (if (eq? value legacy) (set! seen #t)) (saved-predicate value)))
     (c-symbol-check 'custom-classifier-result (eq? f (car (native-c-resolve-call d '(1)))))
     (c-symbol-check 'custom-classifier-sees-original-legacy seen)
     (set! native-c-remote? saved-predicate)
     (c-symbol-check 'custom-classifier-demotion-persists (eq? legacy (native-c-dispatch-view d))))
    (let* ((d (native-c-remote key)) (legacy (native-c-symbol-original d)) (seen #f))
     (set! native-c-resolve-without-remote (lambda (callee args)
      (if (eq? callee legacy) (set! seen #t)) (saved-base callee args)))
     (c-symbol-check 'custom-base-planner-result (eq? f (car (native-c-resolve-call d '(1)))))
     (c-symbol-check 'custom-base-planner-sees-original-legacy seen)
     (set! native-c-resolve-without-remote saved-base)
     (c-symbol-check 'custom-base-planner-demotion-persists (eq? legacy (native-c-dispatch-view d))))
    (let* ((d (native-c-remote key)) (legacy (native-c-symbol-original d)) (seen #f))
     ;; Enter through the real host invocation boundary, so a replaced complete
     ;; planner observes original6 BEFORE its own first instruction.
     (set! native-c-resolve-call (lambda (callee args)
      (if (eq? callee legacy) (set! seen #t)) (saved-planner callee args)))
     (c-symbol-check 'custom-complete-planner-result (= 11 (bl-invoke d '(1))))
     (c-symbol-check 'custom-complete-planner-sees-original-legacy seen)
     (set! native-c-resolve-call saved-planner)
     (c-symbol-check 'custom-complete-planner-demotion-persists (eq? legacy (native-c-dispatch-view d))))
    (let* ((absent-key "Elixir.CSymbolAbsent/later/1") (d (native-c-remote absent-key)))
     (c-symbol-check 'absent-is-inert-private-reference (native-c-symbol-remote? d))
     (c-symbol-check 'absent-refuses-on-invocation (c-symbol-refused? (lambda () (native-c-remote-target d))))
     (c-symbol-check 'absence-not-cached
      (eq? native-missing (table-ref native-c-remote-target-cache d native-missing)))
     (let ((same-key #f))
      (with-exception-catcher
       (lambda (failure)
        (if (error-exception? failure)
         (set! same-key (memq absent-key (error-exception-parameters failure)))))
       (lambda () (native-c-remote-target d)))
      (c-symbol-check 'failure-keeps-original-key-object (and same-key #t)))

     (set! native-leaf-registry (bl-assoc native-leaf-registry absent-key g))
     (c-symbol-check 'later-leaf-admission (eq? g (native-c-remote-target d))))
    (native-register! one "/" f)
    (native-register-arities! one "/" (bl-vec '(1)) bl-nil)
    (c-symbol-check 'slash-logical-name
     (eq? f (native-c-remote-target (native-c-remote (string-append module "///1")))))))
  (lambda ()
   (set! native-leaf saved-leaf) (set! native-c-parse-remote saved-parse)
   (set! native-c-symbol-remotes-enabled? saved-enabled)
   (set! native-c-remote? saved-predicate) (set! native-c-resolve-without-remote saved-base)
   (set! native-c-resolve-call saved-planner)
   (set! native-leaf-registry saved-leaves) (set! native-module-names saved-modules)
   (set! native-export-arities saved-arities) (set! native-global-registry saved-globals)
   (set! native-excluded-host-leaves saved-excluded))))
(if (not (= c-symbol-checks 52)) (error "private symbolic MFA fixture count" c-symbol-checks))
(display "NATIVE_C_SYMBOL_REMOTE_ABI_PASS 52") (newline)
