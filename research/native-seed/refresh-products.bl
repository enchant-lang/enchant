; One bounded seed VM for independent products of the same source snapshot.
; Run without arguments: both existing drivers retain their explicit defaults.
(ns native.refresh-products)
(assert (empty? (BeamLisp/argv)))
(BeamLisp/run_file "research/native-seed/direct/scalar.bl")
(BeamLisp/run_file "research/native-seed/src/native/update-closure.bl")
