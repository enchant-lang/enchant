; Card N2b: source → staged unit → descriptors → Core, on Chez, through the
; real priv/host/aot.bl staging and description code (stage-sdk-unit!,
; describe_module). Evaluated after host/aot.bl, so these forms are in
; host.aot and reach its private functions. The eval file is
;   lower-core.bl lower.bl front-end/hook.bl aot.bl(hooked) THIS jobs.bl
; jobs.bl is one (nf-run "CUSTODY.etf" "OUT") form.
;
; Per unit the BEAM supplies only custody data (front-end/custody.bl): the
; source path, its closure hash, its compiler-key stamp and its sha256.
; Everything else (read, expand, compile, stage, describe, optimise, lower)
; runs here. Writes OUT/u/NAMESPACE/I.desc.etf and I.core.etf for every plan
; descriptor and G-I.desc.etf/G-I.core.etf for each plan-compiled one.

(defn- nf-write [path term] (host/write-bytes path (erlang/term_to_binary term)))

(defn- nf-compiler-key [] (host/nf-world-key))

;; ── The constructor kernel, from custody ──────────────────────────────────
;; AOT/prepare_unit stages every SDK unit inside a private constructor
;; context whose kernel it installs from seed beams: the boot manifest, Core's
;; seed rows and the core and sugar phase libraries (front-end/kernel.bl
;; records them on the BEAM, as data). This image already holds Core itself,
;; so the kernel values are its own Core bindings. These three definitions
;; replace the seed-reading ones; everything else in the context is aot.bl's.
(defn- nf-kernel [] (erlang/get :nf_kernel))

(defn- constructor_kernel_manifest! [] (:kernel-manifest (nf-kernel)))

(defn- constructor_install_kernel! []
 (let [kernel (nf-kernel)]
  (constructor_context_put! :kernel-manifest (:kernel-manifest kernel))
  (constructor_context_put! :core-rows (:core-rows kernel))
  (constructor_context_put! :kernel-core-forwarder true)
  (when (:cpp-rows kernel) (constructor_context_put! :cpp-rows (:cpp-rows kernel)))
  ;; :kernel-values only masks Core rows when constructor_unit! stages Core's
  ;; own source: names outside it become nil in the view. BEAM host code calls
  ;; Core directly and never reads those rows; the evaluated aot.bl here reads
  ;; them through the Env, so every Core declaration keeps its native value.
  (constructor_context_put! :kernel-values
   (reduce (fn [m name]
            (let [found (BeamLisp.Env/lookup (tuple "core" name))]
             (if (and (erlang/is_tuple found) (= :ok (elem found 0))) (assoc m name (elem found 1)) m)))
           {} (distinct (concat (:kernel-values kernel) (keys (or (nf-source-decls "core") {}))))))))

(defn- constructor_kernel_phase_state! []
 (let [context (constructor_context!)]
  (or (:kernel-phase-state context)
   (let [kernel (nf-kernel)]
    (constructor_context_put! :kernel-phase-identity (:kernel-phase-identity kernel))
    (constructor_context_put! :kernel-phase-providers (:kernel-phase-providers kernel))
    (constructor_context_put! :kernel-phase-state (:kernel-phase-state kernel))
    (:kernel-phase-state kernel)))))

;; The kernel is this image's own sealed Core, so its primitive identity is
;; not re-attested against BEAM captures (erlang:make_fun of a seed module):
;; a name is a primitive when the pure-core policy and the seed rows say so.
(defn- constructor_core_primitive! [name]
 (let [row (Enum/find (constructor_core_seed_rows!) (fn [row] (and (= name (first row)) (not= :link (nth row 4)))))]
  (and (some? row) (contains? (constructor_pure_core_names) name))))
(defn- constructor_compat_reduced! [] nil)
;; Kernel modules are this image's own sealed modules: record the lease
;; bookkeeping, refuse a module the image does not carry.
(defn- constructor_kernel_module! [module]
 (when-not (Code/ensure_loaded? module) (stage-refuse :unattested-compiler-kernel))
 (constructor_context_put! :kernel-modules (conj (:kernel-modules (constructor_context!)) module)))

;; Declaration-query certificates guard against concurrent publication; the
;; native image publishes nothing while it stages, so one constant answers.
(defn- sdk_declaration_query_certificate [ns pass context] (tuple pass context :native-front))
(defn sdk_declaration_kind [ns binding]
 (let [descriptor (sdk_checked_declaration_table ns)]
  (cond (= :unavailable descriptor) :unavailable
        descriptor (Map/get (elem descriptor 2) binding)
        :else nil)))

;; Custody resolved the priv root physically (no symlink inside the SDK
;; image); prim_file's lstat has no native counterpart.
(defn- physical_sdk_path [path]
 (when (and (erlang/is_binary path) (File/exists? path)) (Path/expand path)))

;; cerl_trees:free_variables/1 over the native host's cerl records (the
;; tuples core_parse.hrl declares): an ordset of the variable names a Core
;; tree uses without binding. Pattern variables bind; everything else uses.
(defn- nf-pattern-vars [p]
 (if-not (erlang/is_tuple p) (list)
  (case (elem p 0)
   :c_var (list (elem p 2))
   :c_alias (cons (elem (elem p 2) 2) (nf-pattern-vars (elem p 3)))
   :c_cons (concat (nf-pattern-vars (elem p 2)) (nf-pattern-vars (elem p 3)))
   :c_tuple (mapcat nf-pattern-vars (elem p 2))
   :c_values (mapcat nf-pattern-vars (elem p 2))
   :c_map (mapcat (fn [pair] (nf-pattern-vars (elem pair 4))) (elem p 3))
   :c_binary (mapcat (fn [seg] (nf-pattern-vars (elem seg 2))) (elem p 2))
   (list))))
(defn- nf-pattern-uses [p]
 (if-not (erlang/is_tuple p) (list)
  (case (elem p 0)
   :c_alias (nf-pattern-uses (elem p 3))
   :c_cons (concat (nf-pattern-uses (elem p 2)) (nf-pattern-uses (elem p 3)))
   :c_tuple (mapcat nf-pattern-uses (elem p 2))
   :c_values (mapcat nf-pattern-uses (elem p 2))
   :c_map (mapcat (fn [pair] (concat (nf-core-free (elem pair 3)) (nf-pattern-uses (elem pair 4)))) (elem p 3))
   :c_binary (mapcat (fn [seg] (concat (nf-pattern-uses (elem seg 2)) (nf-core-free (elem seg 3)))) (elem p 2))
   (list))))
(defn- nf-without [names bound] (let [b (set bound)] (remove #(contains? b %) names)))
(defn- nf-core-free [t]
 (cond
  (erlang/is_list t) (mapcat nf-core-free t)
  (not (erlang/is_tuple t)) (list)
  :else
  (case (elem t 0)
   :c_var (list (elem t 2))
   :c_literal (list)
   :c_fun (nf-without (nf-core-free (elem t 3)) (map #(elem % 2) (elem t 2)))
   :c_let (concat (nf-core-free (elem t 3)) (nf-without (nf-core-free (elem t 4)) (map #(elem % 2) (elem t 2))))
   :c_letrec (let [names (map #(elem (elem % 0) 2) (elem t 2))]
              (nf-without (concat (mapcat #(nf-core-free (elem % 1)) (elem t 2)) (nf-core-free (elem t 3))) names))
   :c_clause (let [bound (mapcat nf-pattern-vars (elem t 2))]
              (concat (mapcat nf-pattern-uses (elem t 2))
                      (nf-without (concat (nf-core-free (elem t 3)) (nf-core-free (elem t 4))) bound)))
   :c_case (concat (nf-core-free (elem t 2)) (nf-core-free (elem t 3)))
   :c_receive (concat (nf-core-free (elem t 2)) (nf-core-free (elem t 3)) (nf-core-free (elem t 4)))
   :c_try (concat (nf-core-free (elem t 2))
                  (nf-without (nf-core-free (elem t 4)) (map #(elem % 2) (elem t 3)))
                  (nf-without (nf-core-free (elem t 6)) (map #(elem % 2) (elem t 5))))
   :c_map_pair (concat (nf-core-free (elem t 3)) (nf-core-free (elem t 4)))
   :c_map (concat (nf-core-free (elem t 2)) (nf-core-free (elem t 3)))
   :c_bitstr (concat (nf-core-free (elem t 2)) (nf-core-free (elem t 3)))
   (mapcat nf-core-free (drop 2 (Tuple/to_list t))))))
(defn- nf-free-variables [tree] (sort (distinct (nf-core-free tree))))

;; Diagnosis for a refused class scaffold: which part of the descriptor the
;; record producer does not recognise.
(defn- nf-traced-declaration-kind [descriptor ns name]
 (let [answer (host.record/declaration_kind descriptor ns name)]
  (when-not answer
   (let [metadata (some (fn [entry] (let [parts (if (erlang/is_tuple entry) (Tuple/to_list entry) (vec entry))]
                                     (when (= :bl_generated_class (first parts)) (second parts))))
                        (Map/get descriptor :attrs (list)))
         canonical (when (erlang/is_tuple metadata)
                    (host.record/declaration_descriptor ns name (elem metadata 3) (elem metadata 4) (Map/get descriptor :name)))]
    (println (str "NF-CLASS " ns "/" name " metadata " (pr-str (when metadata (elem metadata 0)))
                  " same-body " (= (Map/drop descriptor (list :attrs :ann)) (Map/drop (or canonical {}) (list :attrs :ann)))
                  " attrs " (count (Map/get descriptor :attrs)) "/" (count (Map/get (or canonical {}) :attrs))))
    (when canonical
     (doseq [k (sort (keys (Map/drop descriptor (list :attrs :ann))))]
      (when-not (= (Map/get descriptor k) (Map/get canonical k))
       (println (str "NF-CLASS-KEY " k " " (subs (pr-str (Map/get descriptor k)) 0 (min 400 (count (pr-str (Map/get descriptor k)))))))
       (println (str "NF-CLASS-KEY " k " " (subs (pr-str (Map/get canonical k)) 0 (min 400 (count (pr-str (Map/get canonical k)))))))
       (when (and (sequential? (Map/get descriptor k)) (sequential? (Map/get canonical k)))
        (doseq [[x y] (map vector (Map/get descriptor k) (Map/get canonical k))]
         (when-not (= x y)
          (println (str "NF-CLASS-ITEM " (subs (pr-str x) 0 (min 600 (count (pr-str x))))))
          (println (str "NF-CLASS-ITEM " (subs (pr-str y) 0 (min 600 (count (pr-str y)))))))))))
     (doseq [[a b] (map vector (Map/get descriptor :attrs) (Map/get canonical :attrs))]
      (when-not (= a b) (println (str "NF-CLASS-ATTR " (subs (pr-str a) 0 (min 300 (count (pr-str a)))) " vs " (subs (pr-str b) 0 (min 300 (count (pr-str b)))))))))))
  answer))

;; The compiler reaches these through BeamLisp.AOT; here they are host.aot's.
(defn- nf-route-aot! []
 (doseq [[name arity f] [["sdk_constructor_binding_reference" 2 sdk_constructor_binding_reference]
                         ["staged_macro_kind" 2 staged_macro_kind]
                         ["staged_macro_lookup" 2 (if (= true (erlang/get :nf_trace))
                                                   (fn [ns name] (let [r (staged_macro_lookup ns name)]
                                                                  (when (= true (erlang/get :nf_trace_macros)) (println (str "NF-MACRO " ns " " name " " (pr-str (if (erlang/is_tuple r) [(elem r 0) (some? (elem r 1))] r)))))
                                                                  r))
                                                   staged_macro_lookup)]
                         ["sdk_constructor_declaration_kind" 2 sdk_constructor_declaration_kind]
                         ["sdk_declaration_kind" 2 sdk_declaration_kind]
                         ["constructor_call!" 5 constructor_call!]
                         ["constructor_call!" 6 constructor_call!]
                         ["constructor_metadata_compiling?" 0 constructor_metadata_compiling?]]]
  (host/nf-route! (str "Elixir.BeamLisp.AOT/" name "/" arity) f))
 (host/nf-route! "cerl_trees/free_variables/1" nf-free-variables)
 ;; host.record is evaluated before host.aot (the native image lacks it).
 (host/nf-route! "Elixir.BeamLisp.Record/declaration_descriptor/4" host.record/declaration_descriptor)
 (host/nf-route! "Elixir.BeamLisp.Record/declaration_metadata/1" host.record/declaration_metadata)
 (host/nf-route! "Elixir.BeamLisp.Record/declaration_descriptor/5" host.record/declaration_descriptor)
 (host/nf-route! "Elixir.BeamLisp.Record/declaration_kind/3"
  (if (= true (erlang/get :nf_trace)) nf-traced-declaration-kind host.record/declaration_kind))
 (host/nf-route! "Elixir.BeamLisp.Loader/source_decls_from/3" nfl-source_decls_from)
 (host/nf-route! "Elixir.BeamLisp.Loader/read_source/1" nfl-read_source)
 (host/nf-route! "Elixir.BeamLisp.Loader/declared_ns/1" nfl-declared_ns)
 (host/nf-route! "Elixir.BeamLisp.Loader/source_decls/1" nf-source-decls))

;; Loader/source_decls: the selected file's declarations (the BEAM memoizes
;; the same scan per path and digest).
(defn- nf-source-decls [ns]
 (when-let [path (BeamLisp.Loader/source_path ns)]
  (nfl-source_decls_from ns (nfl-read_source path) path)))

(defn- nf-step [namespace step] (when (= true (erlang/get :nf_trace)) (println (str "STEP " namespace " " step))))

(defn- nf-unit [row out]
 (let [namespace (:namespace row) file (:file row)
       dir (str out "/u/" namespace)
       source (nfl-read_source file)
       key (nf-compiler-key)
       input {:namespace namespace :file file :source source :selection :explicit
              :digest (:input-digest row) :compiler-key key}
       previous (BeamLisp.Env/capture)
       view (BeamLisp.Env/fork :global)
       machine (tuple :constructor-machine-frame (erlang/make_ref))]
  (native-front.hook/take-generated!)
  (try
   (erlang/put :bl_loader_initialization_blocked true)
   (erlang/put machine (constructor_counters))
   (erlang/put :bl_sdk_constructor_context
    {:input input :compiler-env view :artifact-inputs {namespace input}
     :phase-imports (list "core" "sugar") :phase-aware true :host-spec nil
     :artifact-workspace (erlang/make_ref) :machine-frame machine :units {} :compiled {} :compiling #{}
     :maximum 256 :source-limit 1048576 :total-limit 16777216
     :clauses {} :seen-macros #{} :kernel-modules #{} :kernel-leases (list)
     :macro-steps 16384 :new-atoms 128 :expanded 0})
   (BeamLisp.Env/with_env view
    (fn []
     (BeamLisp.Env/add_search_path (:priv-root (erlang/get :nf_doc)))
     (constructor_install_kernel!)
     (constructor_kernel_phase_state!)
     (constructor_unit! namespace)
     (let [_ (nf-step namespace "stage")
           unit (stage-sdk-unit! source (list (tuple :file file)))
           _ (nf-step namespace "describe")
           defined (elem unit 0) values (elem unit 1) touched (elem unit 2)
           metadata (elem unit 3) declarations (elem unit 5)
           plans (mapv (fn [ns]
                        (describe_module ns (unit_defs ns (Map/get defined ns)) (Map/get values ns (list))
                         (Map/put_new (Map/get metadata ns {}) :native-declaration nil)
                         file (:input-digest row) declarations (:source-hash row) (:stamp-key row)))
                       (sort (MapSet/to_list touched)))
           descriptors (vec (mapcat :descriptors plans))
           generated (vec (native-front.hook/take-generated!))]
      [descriptors generated])))
   (finally
    (erlang/put :bl_sdk_constructor_context nil)
    (erlang/put machine nil)
    (erlang/put :bl_loader_initialization_blocked nil)
    (BeamLisp.Env/destroy view)
    (BeamLisp.Env/bind previous)))))

;; Lowering runs outside the unit's private view: a unit that stages `lower`
;; itself (compile.world) masks lower's bindings inside it.
(defn- nf-unit-core [row out]
 (let [[descriptors generated] (nf-unit row out)
       dir (str out "/u/" (:namespace row))]
  (nf-step (:namespace row) "lower")
  (doseq [[i d] (map-indexed vector descriptors)]
   (nf-write (str dir "/" i ".desc.etf") d)
   (nf-write (str dir "/" i ".core.etf") (lower/module->core d)))
  (doseq [[i d] (map-indexed vector generated)]
   (nf-write (str dir "/G-" i ".desc.etf") d)
   (nf-write (str dir "/G-" i ".core.etf") (lower/module->core d)))
  [(count descriptors) (count generated)]))

(defn- nf-install-world! [doc]
 (let [rows (:units doc)
       namespaces (reduce (fn [m [n f]] (assoc m n {:file f})) {} (or (:all doc) (map (fn [r] [(:namespace r) (:file r)]) rows)))
       keys (reduce (fn [m r] (assoc m (:namespace r) (:stamp-key r))) {} rows)
       hashes (reduce (fn [m r] (assoc m (:namespace r) (:source-hash r))) {} rows)]
  (host/nf-install-world
   {:priv-root (:priv-root doc) :compiler-key (:compiler-key doc)
    :namespaces namespaces :keys keys :source-hashes hashes
    :library-names (list) :build-namespaces (list)
    :declaration-tables (or (:declaration-tables doc) {})
    :beam-md5s (or (:beam-md5s doc) {})})))

(defn nf-run
 ([custody out] (nf-run custody out nil))
 ([custody out only]
 (let [doc (erlang/binary_to_term (host/read-bytes custody))
       rows (if only (filter #(contains? (set only) (:namespace %)) (:units doc)) (:units doc))]
  (when only (erlang/put :nf_trace true) (host/nf-trace! 12))
  (nf-install-world! doc)
  (erlang/put :nf_doc doc)
  ;; The BEAM stages inside the SDK's own VM, where every SDK namespace exists:
  ;; `alias/name` then reads as a namespace var, never a Module/fun remote.
  (doseq [n (keys (or (:all doc) {}))] (BeamLisp.Env/declare_ns n))
  (erlang/put :nf_kernel (erlang/binary_to_term (host/read-bytes (str out "/kernel.etf"))))
  (nf-route-aot!)
  (doseq [row rows]
   (println (str "UNIT start " (:namespace row)))
   (host/nf-memo-recount!)
   (try
    (let [[n g] (nf-unit-core row out)]
     (println (str "UNIT ok " (:namespace row) " descriptors " n " generated " g)))
    (catch e
     (println (str "UNIT fail " (:namespace row) " " (pr-str e)))
     (println (str "UNIT-STACK " (:namespace row) " " (pr-str (take 14 __STACKTRACE__)))))))
  (println (str "UNITS-DONE " (count rows))))))
