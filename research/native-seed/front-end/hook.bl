; Card N2b: the one seam the native front end puts into priv/host/aot.bl.
; The evaluated copy of aot.bl calls native-front.hook/compile-descriptor
; where the BEAM calls BeamLisp.Emit/compile_descriptor (see run.sh's sed):
; the descriptor is kept, and the plan gets its module name with no bytes.
; The driver lowers the kept descriptors with the others, so the beams a plan
; compiles itself go through the same Chez → Core → BEAM route.
(ns native-front.hook)

(defn compile-descriptor [descriptor]
 (erlang/put :nf_generated (cons descriptor (or (erlang/get :nf_generated) (list))))
 (tuple (:name descriptor) ""))

(defn take-generated! []
 (let [kept (erlang/get :nf_generated)]
  (erlang/put :nf_generated (list))
  (if (= :undefined kept) (list) (reverse kept))))
