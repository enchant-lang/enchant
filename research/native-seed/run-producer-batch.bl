; SDK-only sequential orchestration. Each canonical producer owns admission.
(ns native.producer-batch (:require [bl.json :as json]))
(def jobs (json/decode (File/read! (first (BeamLisp/argv)))))
(assert (and (vector? jobs) (<= 1 (count jobs) 8)))
(doseq [[path arguments] jobs]
 (assert (and (string? path) (vector? arguments)))
 (println (str "NATIVE_PRODUCER_BEGIN " path))
 (BeamLisp.Env/isolated
  (fn [] (BeamLisp/with_argv (to-list arguments) (fn [] (BeamLisp/run_file path)))))
 (println (str "NATIVE_PRODUCER_END " path)))
