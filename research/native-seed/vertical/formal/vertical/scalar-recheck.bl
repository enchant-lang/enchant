; Zero-search verification of a retained scalar artifact. Models can change
; without re-elaborating or re-producing the unrelated scalar theorem.
(ns vertical.scalar-recheck (:require [vertical.support :as s] [formal.api :as formal]))
(defn check! [lock scalar]
 (assert (= "bl.native.vertical-ignored-char-proof" (:schema scalar)))
 (assert (= (get lock "formal_sdk_pin") (:formal-sdk-pin scalar)))
 (assert (= (get lock "native_sdk_pin") (get-in scalar [:captured :native-sdk-pin])))
 (assert (= (get lock "native_manifest_sha256") (get-in scalar [:captured :native-manifest-sha256])))
 (assert (= "ignored-char?" (get-in scalar [:captured :helper-name])))
 (assert (= (get-in scalar [:captured :anf-sha256])
            (s/term-sha (get-in scalar [:captured :helper :node]))))
 (assert (= (get lock "candidate_source_sha256") (:candidate-source-sha256 scalar)))
 (assert (= (get lock "candidate_source_sha256") (s/sha (File/read! (get lock "candidate_source")))))
 (assert (= (get-in scalar [:captured :source-sha256])
            (s/sha (File/read! (str (get-in lock ["native_sdk_pin" "source"]) "/priv/boot/reader.bl")))))
 (let [a (formal/check-elaboration (get-in scalar [:original :object]))
       b (formal/check-elaboration (get-in scalar [:candidate :object]))
       c (formal/check-translation-proof (:translation scalar) (:proof scalar))
       d (formal/check-core-translation-data (:translation scalar) (:proof scalar) (:core-translation scalar))]
  (assert (= :checked (:status a))) (assert (= :checked (:status b)))
  (assert (= :checked (:status c))) (assert (= :checked-data-connection (:status d)))
  {:original a :candidate b :translation c :packet d :proof-search-called false}))
