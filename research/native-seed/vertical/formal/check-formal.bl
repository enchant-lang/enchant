; Qualified narrow formal SDK only. Independent relations and portable proof
; search; no native backend, selected function execution or native build.
(ns vertical.check-formal
 (:require [vertical.support :as s]
           [formal.api :as formal] [formal.elaborate :as elaborate]
           [formal.core :as core] [formal.term :as t] [formal.identity :as identity]))
(def args (BeamLisp/argv))
(def lock (s/lock! (nth args 0)))
(def input-dir (Path/expand (nth args 1)))
(def output (Path/expand (nth args 2)))
(assert (not (File/exists? output)))
(File/mkdir_p! output)
(def captured (s/read-data! (str input-dir "/helper.etf") (str input-dir "/helper.json")))
(assert (= "bl.native.vertical-ignored-char-input" (:schema captured)))
(assert (= 1 (:version captured)))
(assert (= "ignored-char?" (:helper-name captured)))
(assert (= (get lock "native_sdk_pin") (:native-sdk-pin captured)))
(assert (= (get lock "native_manifest_sha256") (:native-manifest-sha256 captured)))
(assert (= (str (get-in lock ["native_sdk_pin" "source"]) "/priv/boot/reader.bl")
           (:qualified-source-path captured)))
(assert (= (:source-sha256 captured) (s/sha (File/read! (:qualified-source-path captured)))))
(assert (= (:anf-sha256 captured) (s/term-sha (get-in captured [:helper :node]))))
(def parameters [["character" t/Int]])
(def declarations (into {} parameters))
(def candidate-path (get lock "candidate_source"))
(def candidate-source (File/read! candidate-path))
(assert (= (get lock "candidate_source_sha256") (s/sha candidate-source)))
(def original (elaborate/prepare-function-anf (get-in captured [:helper :node]) parameters))
(def candidate (formal/source-function candidate-source parameters))
(defn checked-elaboration [prepared]
 (assert (= :elaborated (:status prepared)) (pr-str prepared))
 (let [object (get-in prepared [:elaboration :object]) checked (formal/check-elaboration object)]
  (assert (= :checked (:status checked)) (pr-str checked))
  (assert (= false (:elaborator-called checked)))
  (assert (= false (:solver-called checked)))
  {:object object :checking checked}))
(def original-elaboration (checked-elaboration original))
(def candidate-elaboration (checked-elaboration candidate))
(def change (formal/translation
 {:name "vertical-ignored-char-integer" :parameters declarations
  :before (:core original) :after (:core candidate)}))
(def answer (formal/verify-translation change))
(assert (= :checked (:status answer)) (pr-str answer))
(def proof (get-in answer [:proof :object]))
(def proof-check (formal/check-translation-proof change proof))
(assert (= :checked (:status proof-check)))
(def export (formal/core-translation-data change proof))
(assert (= :ready (:status export)) (pr-str export))
(def export-check (formal/check-core-translation-data change proof (:packet export)))
(assert (= :checked-data-connection (:status export-check)))
; Four small controls use existing checkers and concrete Core replay. No oracle.
(def false-change (formal/translation
 {:name "vertical-ignored-char-false" :parameters declarations
  :before (:core original) :after (core/literal false)}))
(def borrowed (formal/check-translation-proof false-change proof))
(def tampered (formal/check-translation-proof change (assoc proof :definition "wrong-subject")))
(assert (= :rejected (:status borrowed)))
(assert (= :rejected (:status tampered)))
(def at-space (core/evaluate (:core original) declarations {"character" 32}))
(def false-at-space (core/evaluate (core/literal false) declarations {"character" 32}))
(assert (= :returned (:status at-space)))
(assert (= true (:value at-space)))
(assert (= false (:value false-at-space)))
(def changed-elaboration
 (formal/check-elaboration
  (identity/seal (assoc (:object original-elaboration) :core (core/literal false)))))
(assert (= :rejected (:status changed-elaboration)))
(def vacuous-change (formal/translation
 {:name "vertical-ignored-char-vacuous" :parameters declarations
  :before (:core original) :after (core/literal false) :requires (t/bool false)}))
(def vacuous (formal/verify-translation vacuous-change))
(assert (= :vacuous (:status vacuous)))
(def scalar
 {:schema "bl.native.vertical-ignored-char-proof" :version 1
  :captured captured :formal-sdk-pin (get lock "formal_sdk_pin")
  :candidate-source candidate-source :candidate-source-sha256 (s/sha candidate-source)
  :parameters parameters :original original-elaboration :candidate candidate-elaboration
  :translation change :answer answer :proof proof :proof-check proof-check
  :core-translation (:packet export) :core-translation-check export-check
  :controls {:borrowed-proof borrowed :tampered-proof tampered
             :altered-elaboration changed-elaboration :vacuous (:status vacuous)
             :false-candidate-witness {:input {"character" 32} :original at-space :candidate false-at-space}}
  :assumptions ["RT.eqv on Int inputs has its reviewed formal intrinsic meaning; full rt implementation is not derived here."
                "The retained ANF-to-Source provenance is the original native capture receipt."
                "Caller Int eligibility, exact kernel binding, native BIF semantics and lowering require the native gate."]
  :native-runtime-executed false :native-lowering-proof false :compiler-proof-authority false})
(def scalar-artifact (s/save-data! (str output "/scalar.etf") scalar))
(s/json! (str output "/core-translation.json") (:packet export))
(s/json! (str output "/scalar-receipt.json")
 {:schema (:schema scalar) :status :checked :artifact scalar-artifact
  :original-native-sdk (get lock "native_sdk_pin") :formal-sdk (get lock "formal_sdk_pin")
  :helper (:helper-name captured) :source-sha256 (:source-sha256 captured) :position (:position captured)
  :original-anf-sha256 (:anf-sha256 captured) :candidate-source-sha256 (s/sha candidate-source)
  :translation (:identity change) :original-elaboration (:identity (:object original-elaboration))
  :candidate-elaboration (:identity (:object candidate-elaboration))
  :domain :integer-only :controls-passed 5 :proof-native-backend-requested false
  :native-lowering-proof false :compiler-proof-authority false})
(println "VERTICAL_SCALAR_FORMAL_CHECKED")

