; Original native SDK only. Read one retained passive reader partition; never
; recompile its Source or invoke the selected function.
(ns vertical.extract-helper
 (:require [native.artifact :as artifact] [codebase] [reader-node :as rn] [bl.json :as json]))
(def args (BeamLisp/argv))
(def lock-path (Path/expand (nth args 0)))
(def output (Path/expand (nth args 1)))
(def lock (json/decode (File/read! lock-path)))
(def pin (get lock "native_sdk_pin"))
(def manifest-path (get lock "native_manifest"))
(defn sha [bytes] (artifact/sha bytes))
(defn term-sha [value] (sha (erlang/term_to_binary value (list :deterministic))))
(assert (= (get pin "sdk") (System/get_env "BL_SDK_PRODUCT")))
(assert (= (get pin "descriptor_sha256")
           (sha (File/read! (str (System/get_env "BL_SDK_PRODUCT") "/artifact.json")))))
(doseq [row (concat (get lock "staged_sources") (get lock "native_artifact_owner_sources"))]
 (assert (= (get row "sha256") (sha (File/read! (get row "path"))))))
(assert (not (File/exists? output)))
(def manifest-bytes (File/read! manifest-path))
(assert (= (get lock "native_manifest_sha256") (sha manifest-bytes)))
(def manifest (json/decode manifest-bytes))
(assert (= "bl.native.partitioned-closure" (get manifest "schema")))
(assert (= 1 (get manifest "version")))
(def rows (vec (filter #(= "reader" (get % "namespace")) (get manifest "units"))))
(assert (= 1 (count rows)))
(def row (first rows))
(def original-part (artifact/part-path manifest-path (get row "path")))
(def bytes (File/read! original-part))
(assert (<= (erlang/byte_size bytes) (:max-bytes artifact/limits)))
(assert (= (get row "sha256") (sha bytes)))
(File/mkdir_p! output)
(def copied-part (str output "/reader.etf"))
(File/write! copied-part bytes)
(when (File/regular? (str original-part ".validated.json"))
 (File/write! (str copied-part ".validated.json") (File/read! (str original-part ".validated.json"))))
(def unit (artifact/read-part (str output "/owned-manifest.json")
             {"path" "reader.etf" "sha256" (get row "sha256")}))
(assert (= "reader" (:ns unit)))
(assert (= (:source-sha256 unit) (sha (:source unit))))
(def source-path (str (get pin "source") "/priv/boot/reader.bl"))
(assert (= (:source-sha256 unit) (sha (File/read! source-path))))
(def matches (vec (filter #(= "ignored-char?" (:name %)) (:defs unit))))
(assert (= 1 (count matches)))
(def helper (first matches))
(assert (= :fn (:kind helper)))
; Source positions/names use the existing Codebase/Reader owners. This parses
; the retained Source once for attribution; the selected ANF is not regenerated.
(def forms (BeamLisp.Reader/read_string (:source unit) (:path unit)))
(def source-matches (vec (filter #(= "ignored-char?" (codebase/defn-form %)) forms)))
(assert (= 1 (count source-matches)))
(def form (first source-matches))
(def name-node (second (rn/node-items (rn/node-form form))))
(def payload
 {:schema "bl.native.vertical-ignored-char-input" :version 1
  :native-sdk-pin pin :artifact-owner-sources (get lock "native_artifact_owner_sources") :native-manifest manifest-path :native-manifest-sha256 (sha manifest-bytes)
  :partition original-part :partition-sha256 (sha bytes)
  :source-path (:path unit) :qualified-source-path source-path :source-sha256 (:source-sha256 unit)
  :helper-name "ignored-char?" :position (rn/node-pos form)
  :name-annotation (codebase/name-annotation name-node)
  :source-form-data (codebase/node-data form) :source-form-sha256 (term-sha form)
  :helper helper :helper-sha256 (term-sha helper) :anf-sha256 (term-sha (:node helper))
  :input-source-recompiled false :input-helper-executed false})
(BeamLisp.CompilerData/check_compiler_data! payload artifact/limits)
(def encoded (erlang/term_to_binary payload (list :deterministic)))
(assert (<= (erlang/byte_size encoded) 4194304))
(File/write! (str output "/helper.etf") encoded)
(File/write! (str output "/helper.json") (json/encode
 {:schema (:schema payload) :version 1 :sha256 (sha encoded)
  :anf-sha256 (:anf-sha256 payload) :helper-sha256 (:helper-sha256 payload)
  :source-sha256 (:source-sha256 payload) :position (:position payload)
  :native-sdk-pin pin :source-recompiled false :helper-executed false}))
(assert (= (get row "sha256") (sha (File/read! original-part))))
(assert (= (sha manifest-bytes) (sha (File/read! manifest-path))))
(println (str "VERTICAL_FORMAL_HELPER_EXTRACTED " (str output "/helper.json")))
