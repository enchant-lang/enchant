; Stage zero only. Run once on the qualified SDK, retain closure.etf, and do
; target-emitter/host work from that immutable artifact instead of recompiling.
(ns native.probe
 (:require [js.build :as build] [anf] [native.scheme :as scheme]
           [native.bootstrap]
           [bl.json :as json] [clojure.string :as string]))

(def roots ["research/native-seed/src"
            "priv/boot" "priv/lib" "priv/std" "priv/compat"])
(def entries ["core" "rt" "sugar" "clojure.core-ext" "clojure.re"
              "host.compiler-data" "host.form-meta" "host.meta"
              "reader-node" "diag" "server-clause" "anf" "reader" "compiler"
              "native.scheme" "native.eval" "native.bootstrap"])
(def stubs #{"lower"})
(def options {:target :scheme :contextual-bindings :absent
              :stub ["lower"] :staging :canonical-js.build
              :namespace-qualified? true})
(def out (or (first (BeamLisp/argv)) "research/native-seed/out/compiler-closure"))
(defn sha [s] (Base/encode16 (crypto/hash :sha256 s) (list (tuple :case :lower))))
(defn nodes [root]
 (loop [todo (list root) out (list)]
  (if (erlang/== (list) todo) (lists/reverse out)
   (let [node (erlang/hd todo)]
    (recur (erlang/++ (anf/executable-children node) (erlang/tl todo)) (cons node out))))))
(defn atom-text [a] (if (string? a) a (erlang/atom_to_binary a)))
(defn source-path [ns]
 (or (get {"host.compiler-data" "priv/host/compiler_data.bl"
           "host.form-meta" "priv/host/form_meta.bl" "host.meta" "priv/host/meta.bl"} ns)
     (build/ns-path roots ns)))
(defn header [path]
 (let [h (BeamLisp.AOT/namespace_header (first (build/read-forms path)))
       ns (first (Map/keys h))]
  (when-not (= 1 (count h)) (throw (ex-info "native closure: missing namespace header" {:path path})))
  {:ns ns :requires (mapv (fn [r] [(elem r 0) (or (elem r 1) (elem r 0))]) (:require_specs (get h ns)))}))
(defn module-ns [m]
 (let [s (atom-text m) prefix "Elixir.BeamLisp.Ns."]
  (when (starts-with? s prefix)
   (let [candidate (lower-case (subs s (count prefix)))]
    (when (= m (BeamLisp.Link/module_for candidate)) candidate)))))
(defn core-links []
 (vec (sort-by first
  (BeamLisp.Env/match
   (tuple (tuple :link "core" :$1) :$2)))))
(defn provider-sources []
 ; Bind ALL candidate macro providers in the source roots, including providers
 ; loaded by a macro through a module edge rather than a :require declaration.
 (vec (map (fn [p] (let [source (File/read! p)]
         {:path p :sha256 (sha source)
          ; Conservative prefilter, followed by canonical AST declaration
          ; recognition. A comment/string cannot become a macro provider.
          :macro-provider? (and (String/contains? source "defmacro")
                             (boolean (some build/defmacro? (build/read-forms p))))}))
       (sort (distinct (concat ["priv/host/compiler_data.bl" "priv/host/form_meta.bl" "priv/host/meta.bl"]
                    (mapcat (fn [r] (Path/wildcard (str r "/**/*.bl"))) roots)))))))
(declare providers observed-sdk-descriptor)
(defn compile-closure []
 (loop [todo entries active #{} done #{} order [] units {}]
  (if (empty? todo)
   {:order order :units units}
   (let [ns (first todo)]
    (cond
     (contains? done ns) (recur (rest todo) active done order units)
     (contains? stubs ns) (recur (rest todo) active (conj done ns) order units)
     :else
     (let [path (source-path ns)]
      (when (nil? path) (throw (ex-info "native closure: source dependency absent" {:namespace ns})))
      (let [head (header path)
            deps (vec (remove #(contains? done %)
                        (concat (when (= ns "core") ["rt"]) (map first (:requires head)))))]
       (if (and (seq deps) (not (contains? active ns)))
        (recur (concat deps todo) (conj active ns) done order units)
        (let [_ (println (str "NATIVE_CLOSURE_PREPARE " ns))
              prepared (build/prepare-ns path)
              unit-key (sha (erlang/term_to_binary
                         {:sdk observed-sdk-descriptor :options options :source (:source-sha256 prepared)
                          :macro-providers (vec (filter :macro-provider? providers))} (list :deterministic)))
              checkpoint (str out "/units/" ns ".etf")
              cached (when (and (File/regular? checkpoint) (File/regular? (str checkpoint ".sha256")))
                       (let [bytes (File/read! checkpoint)]
                        (assert (< (erlang/byte_size bytes) 33554432))
                        (assert (= (sha bytes) (File/read! (str checkpoint ".sha256"))))
                        (BeamLisp.CompilerData/check_closed_etf! bytes {:max-nodes 1000000 :max-bytes 33554432 :max-depth 128})
                        (erlang/binary_to_term bytes)))
              compiled (if (= unit-key (:identity cached)) (:unit cached)
                          (dissoc (build/compile-prepared prepared {:check-node identity}) :cache-status :cache-key))
              refs (keep (fn [n] (when (= :remote (:op n)) (module-ns (:mod n))))
                         (mapcat #(nodes (:node %)) (:defs compiled)))
              extra (vec (distinct (filter #(and (not (contains? done %))
                                                   (not= ns %) (not (contains? stubs %))
                                                   (build/ns-path roots %)) refs)))
              unit (assoc compiled :source (:source prepared)
                     :module (BeamLisp.Link/module_for ns)
                     :base-module (BeamLisp.Emit/base_module_for ns))
              _ (File/write! checkpoint (erlang/term_to_binary {:identity unit-key :unit unit} (list :deterministic)))
              _ (File/write! (str checkpoint ".sha256") (sha (File/read! checkpoint)))
              _ (println (str "NATIVE_CLOSURE_UNIT " ns " " (count (:defs unit))
                              (if (= unit-key (:identity cached)) " checkpoint" " compiled")))]
         ; Every unit is compiled ONCE. Additional module dependencies enqueue
         ; after it; Scheme definitions are emitted before initialization.
         (recur (concat (rest todo) extra) (disj active ns) (conj done ns)
                (conj order ns) (assoc units ns unit)))))))))))
(defn inventory [closure]
 (let [facts
  (loop [todo (BeamLisp.CompilerData/eager_mapcat
               (fn [ns] (BeamLisp.CompilerData/eager_map :node (:defs (get (:units closure) ns)))) (:order closure))
         operations {} remotes #{} globals #{} bindings #{}]
   (if (erlang/== (list) todo)
    {:operations (vec (sort-by str operations)) :remotes (vec (sort-by str remotes))
     :globals (vec (sort-by str globals)) :bindings (vec (sort-by str bindings))}
    (let [n (erlang/hd todo) op (:op n)]
     (recur (erlang/++ (anf/executable-children n) (erlang/tl todo))
      (assoc operations op (inc (get operations op 0)))
      (if (= op :remote) (conj remotes [(atom-text (:mod n)) (atom-text (:fun n)) (count (:args n))]) remotes)
      (if (= op :global) (conj globals [(:ns n) (:name n)]) globals)
      (if (= op :binding) (conj bindings (:reference n)) bindings)))))]
  (assoc facts :units
   (mapv (fn [ns] (let [u (get (:units closure) ns)]
    {:namespace ns :path (:path u) :sha256 (:source-sha256 u)
     :definitions (count (:defs u)) :requires (:requires u)})) (:order closure)))))
(File/mkdir_p! out)
(File/mkdir_p! (str out "/units"))
(def providers (provider-sources))
(def pin (File/read! "research/native-seed/sdk-pin.json"))
(def pin-data (json/decode pin))
(def observed-sdk-descriptor (File/read! ".bl/sdks/current-sdk/artifact.json"))
(assert (= (get pin-data "descriptor_sha256") (sha observed-sdk-descriptor)))
(assert (= (get pin-data "source") (get (json/decode observed-sdk-descriptor) "source")))
(assert (= observed-sdk-descriptor (File/read! (str (get pin-data "sdk") "/artifact.json"))))
(def closure
 (BeamLisp.Env/isolated
  (fn []
   (assoc (compile-closure) :schema "bl.native.compiler-closure" :version 1
    :options options :roots roots :entries entries :stubs (vec (sort stubs))
    :core-links (core-links) :return-constructor-shapes (BeamLisp.Server/return_constructor_shapes)
    :provider-sources providers :sdk-pin pin))))
(def final-providers (provider-sources))
(doseq [[ns unit] (:units closure)]
 (when-not (and (= (:source-sha256 unit) (sha (:source unit)))
                (= (:source-sha256 unit) (sha (File/read! (:path unit)))))
  (throw (ex-info "native closure: source changed during capture; rerun uses exact unit checkpoints"
                  {:namespace ns :path (:path unit)}))))
(when-not (= (filter :macro-provider? providers) (filter :macro-provider? final-providers))
 (throw (ex-info "native closure: macro providers changed during capture; rerun required" {})))
(def final-closure (assoc closure :provider-sources final-providers))
(def artifact (erlang/term_to_binary final-closure (list :deterministic)))
(File/write! (str out "/closure.etf") artifact)
(File/write! (str out "/identity.json")
 (json/encode {:schema "bl.native.compiler-closure-identity" :version 1
               :artifact-sha256 (sha artifact) :sdk-pin-sha256 (sha pin)
               :options options :providers final-providers}))
(when (= "--inventory" (second (BeamLisp/argv)))
 (File/write! (str out "/inventory.json") (json/encode (inventory final-closure))))
(println (str "NATIVE_CLOSURE " (count (:order closure)) " namespaces " (sha artifact)))
