; Actual source modules -> checked native actor units. Pure proc planners and
; canonical namespace staging own declarations; this linker selects immutable
; bodies and primitive contracts, never actor/bus/flow policy.
(ns native.proc-link
 (:require [js.build :as build] [js.actor :as actor] [reader-node :as rn]
           [native.proc :as proc] [native.scheme :as scheme] [native.eval :as ev]
           [native.artifact :as artifact] [system.ir :as ir] [anf]
           [native.proc-planner-capsules :as capsules] [clojure.string :as string] [bl.json :as json]))

(def kernel "native.kernel")
(def original-actor-corpus
 {:path "research/js-actors/test.bl"
  :sha256 "5f2ad8223fd9f053157b65266d3ee14e7fe8567b6196a78ed7ac955132b9a5c5"})
(def helpers
 {"proc.bus" {:path "priv/std/proc/bus.bl"
               :sha256 "0f661669d8e1516a3e19f77e77d0cf75dd6b8af40495a18043f5a8747e79c62a"}
  "proc.flow" {:path "priv/std/proc/flow.bl"
                :sha256 "400f70bac9c937bd63d0e133808603fc6960e3b023c8f0e69c6011b0e97f2d12"}
  "proc.reg" {:path "priv/std/proc/reg.bl"
               :sha256 "2c72188b1e420d1c06edf43c0287c2d966039fb9418b38c60595ab4c2e26a5f1"}})
(defn digest [bytes] (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower))))
(defn source-identity [path] {:path path :sha256 (digest (File/read! path))})
(defn qname [ns name] (str ns "/" name))
(defn qualified-parts [text]
 (let [found (binary/match text "/")]
  (when (and (erlang/is_tuple found) (> (elem found 0) 0))
   (let [offset (elem found 0) size (erlang/byte_size text)]
    [(binary/part text 0 offset) (binary/part text (inc offset) (- size offset 1))]))))
(defn walk [root]
 (loop [todo (list root) out (list)]
  (if (erlang/== (list) todo) (lists/reverse out)
   (let [node (erlang/hd todo)]
    (recur (erlang/++ (anf/executable-children node) (erlang/tl todo)) (cons node out))))))
(defn logical-name [name]
 (if (String/ends_with? name "__bl_v") (subs name 0 (- (count name) 6)) name))
(defn registration? [form ns]
 ; The exact hash-qualified canonical registration belongs to compilation's
 ; explicit vocabulary. Nothing else at top level is silently discarded.
 (or (and (= ns "proc.bus") (= '(extend-clause! :bus bus-clause) (proc/source-data form)))
     (and (= ns "proc.reg") (= '(extend-clause! :registry registry-clause) (proc/source-data form)))))
(defn capture-compiler-vocabulary [helper-namespaces]
 ; Capture actual pure values before the build fork. Bus/registry transforms
 ; use lexical anonymous capsules, never runtime namespace initialization.
 (doseq [ns helper-namespaces :let [spec (get helpers ns)]]
  (when-not (= (:sha256 spec) (digest (File/read! (:path spec))))
   (throw (ex-info "native proc link: admitted helper source changed" {:namespace ns :path (:path spec)}))))
 (let [providers ["proc.server" "proc.super"]
       _ (doseq [namespace providers] (BeamLisp.Loader/load_provider namespace))
       bus (when (some #(= "proc.bus" %) helper-namespaces) (capsules/activate "proc.bus"))
       registry (when (some #(= "proc.reg" %) helper-namespaces) (capsules/activate "proc.reg"))]
  {:renderer proc/runtime-forms
   :vocabulary (cond-> {} bus (assoc :bus (:value bus)) registry (assoc :registry (:value registry)))
   :planners {:clause-plan (BeamLisp.Env/fetch_exact! "proc.server" "clause-plan")
              :supervisor-plan (BeamLisp.Env/fetch_exact! "proc.super" "supervisor-plan")
              :unknown-supervisor-error (BeamLisp.Env/fetch_exact! "proc.super" "unknown-supervisor-clause-error")
              :invalid-supervisor-error (BeamLisp.Env/fetch_exact! "proc.super" "invalid-supervisor-error")
              :data-tail (BeamLisp.Env/fetch_exact! "server-clause" "data-tail")}
   :providers (vec (concat
                (mapv (fn [namespace]
                  (assoc (source-identity (BeamLisp.Loader/source_path namespace)) :namespace namespace)) providers)
                (keep :record [bus registry])))}))
(defn expansion [captured forms ns path]
 ((:renderer captured) (vec (remove #(registration? % ns) forms)) ns path
  {:vocabulary (:vocabulary captured) :planners (:planners captured)}))
(defn prepare [path fallback captured]
 (println (str "NATIVE_PROC_PREPARE_BEGIN " path))
 (let [expand (fn [forms ns source-path] (expansion captured forms ns source-path))
       prepared (build/prepare-ns path
                  {:fallback-ns fallback :expand-top expand
                   :after-staging (fn [unit]
                    ; Compile-time helpers stay available for expansion, while
                    ; runtime references select this source unit's BL bodies.
                    (doseq [definition (:defs unit) :when (:name definition)]
                     (BeamLisp.Env/put_link (:ns unit) (:name definition) (tuple :erlang {} nil))))})
       compiled (build/compile-prepared prepared {:check-node identity})]
  (println (str "NATIVE_PROC_PREPARE_END " path " " (count (:defs compiled))))
  (assoc compiled :source (:source prepared)
   :module (BeamLisp.Link/module_for (:ns prepared))
   :base-module (BeamLisp.Emit/base_module_for (:ns prepared)))))
(defn wire-pattern [pattern admitted?]
 (let [vector? (and (= :pstruct (:pop pattern)) (= :Elixir.BeamLisp.Vector (:mod pattern)))
       tuple (if vector? (second (first (:fields pattern))) pattern)
       elements (:elems tuple) first-pattern (first elements)
       tag (when (= :plit (:pop first-pattern)) (:val first-pattern))
       shape (get {:DOWN [:down 5] :EXIT [:exit 3]} tag)]
  (if (and (= :ptuple (:pop tuple)) shape)
   (do
    (when-not (and admitted? (= (second shape) (count elements)))
     (throw (ex-info "native proc link: raw process envelope needs an admitted protocol projection"
                     {:tag tag :elements (count elements) :admitted admitted?})))
    (let [tuple (assoc tuple :elems (assoc (vec elements) 0 (assoc first-pattern :val (first shape))))]
     (if vector? (assoc pattern :fields [[(first (first (:fields pattern))) tuple]])
      {:pop :pstruct :mod :Elixir.BeamLisp.Vector :fields [[:items tuple]]}))) pattern)))
(defn wire-pattern? [pattern]
 (let [vector? (and (= :pstruct (:pop pattern)) (= :Elixir.BeamLisp.Vector (:mod pattern)))
       tuple (if vector? (second (first (:fields pattern))) pattern)
       first-pattern (first (:elems tuple))]
  (and (= :ptuple (:pop tuple)) (= :plit (:pop first-pattern))
       (contains? #{:DOWN :EXIT} (:val first-pattern)))))
(defn needs-protocol-projection? [definition]
 (some (fn [node]
         (and (= :recv (:op node))
              (some (fn [clause] (some wire-pattern? (:pats clause))) (:clauses node))))
       (walk (:node definition))))
(defn project-protocol [unit]
 (let [admitted? (or (contains? helpers (:ns unit))
                    (some (fn [node]
                      (and (= :remote (:op node))
                       (or (and (= :erlang (:mod node)) (contains? #{:monitor :process_flag} (:fun node)))
                           (and (= :Elixir.Process (:mod node)) (= :flag (:fun node))))))
                     (BeamLisp.CompilerData/eager_mapcat (fn [definition] (walk (:node definition))) (:defs unit))))
       rewrite (fn [node]
        (if (= :recv (:op node))
         (assoc node :clauses (mapv (fn [clause]
            (update clause :pats (fn [patterns] (mapv #(wire-pattern % admitted?) patterns)))) (:clauses node))) node))]
  (assoc unit :defs (mapv (fn [definition]
    ; Canonical actor-only clauses need no rebuilt IR. In particular preserve
    ; every original runtime/app body and avoid a lazy map per collection.
    (if (needs-protocol-projection? definition)
     (update definition :node (fn [node] (ir/rewrite rewrite node))) definition)) (:defs unit))
   :wire-protocol (if admitted? :erlang-process-envelope-to-actor-vector :canonical-actor-only))))
(defn named-definitions [units]
 (vec (BeamLisp.CompilerData/eager_mapcat (fn [unit]
  (BeamLisp.CompilerData/eager_map (fn [definition]
    (assoc definition :ns (:ns unit) :path (:path unit) :requires (:requires unit)
     :external? (boolean (:native-external? unit)) :source-sha256 (:source-sha256 unit)
     :prototype-actor-abi? (boolean (:prototype-actor-abi? unit))
     :shape (ir/function-shape (:node definition)))) (:defs unit))) units)))
(defn body-table [definitions]
 (reduce (fn [table definition]
  (if-let [name (:name definition)]
   (let [key (qname (:ns definition) name)]
    (when (contains? table key)
     (throw (ex-info "native proc link: duplicate body identity" {:binding key})))
    (assoc table key definition)) table)) {} definitions))
(defn target-parts [target]
 (let [parts (qualified-parts target)]
  (when-not (and parts (not (empty? (second parts))))
   (throw (ex-info "native proc link: malformed qualified target" {:target target}))) parts))
(defn referred-ns [namespace name bodies]
 (loop [ns namespace seen #{}]
  (if (or (contains? seen ns) (contains? bodies (qname ns name))) ns
   (if-let [owner (BeamLisp.Env/refer_source ns name)]
    (recur owner (conj seen ns)) ns))))
(defn selected-global [definition node bodies aliases]
 (let [requires (into {} (map (fn [[ns alias]] [alias ns]) (:requires definition)))
       qualified (qualified-parts (:name node))
       [raw-ns name] (or qualified [(:ns node) (:name node)])
       exact? (= :exact (:lookup node))
       ns (referred-ns (if exact? raw-ns (get requires raw-ns raw-ns)) name bodies)
       key (qname ns name) core-key (qname "core" name)
       own (get bodies key)
       _ (when (and (or (= ns "proc") (String/starts_with? ns "proc."))
                    (not (contains? helpers ns)) (nil? own) (nil? (get aliases key)))
           (throw (ex-info "native proc link: this proc runtime bundle is not admitted"
                           {:namespace ns :name name :caller (:path definition)})))
       target (cond
                (get aliases key) (get aliases key)
                own key
                (and (not exact?) (contains? bodies (qname kernel name))) (qname kernel name)
                (and (not exact?) (get aliases core-key)) (get aliases core-key)
                (and (not exact?) (contains? bodies core-key)) core-key
                :else nil)]
  (if target
   (let [body (get bodies target)]
    (when-not body (throw (ex-info "native proc link: alias target has no admitted body" {:target target})))
    (when (and (:private? body) (not= (:ns definition) (:ns body)))
     (throw (ex-info "native proc link: private source body crossed a namespace boundary" {:target target :caller (:ns definition)})))
    {:kind :body :target target :body body :external? (:external? body)
     :body-source {:path (:path body) :sha256 (:source-sha256 body)}})
   (let [seed-ns (cond
                  (and (contains? #{"core" "cpp"} ns) (BeamLisp.Env/bound? ns name)) ns
                  (and (not exact?) (BeamLisp.Env/bound? "core" name)) "core"
                  :else nil)]
    (if seed-ns {:kind :sdk-seed :target (qname seed-ns name) :namespace seed-ns :name name}
     (throw (ex-info "native proc link: unresolved source global" {:namespace ns :name name :caller (:path definition) :ann (:ann node)})))))))
(defn check-arity! [selection arity packed?]
 (when (some? arity)
  (let [shape (get-in selection [:body :shape])
        valid (case (:kind selection)
                :sdk-seed (BeamLisp.Ns.Rt/invocable? (BeamLisp.Env/fetch_exact! (:namespace selection) (:name selection)) arity)
                :body (if packed? (= arity (when (:variadic-min shape) (inc (:variadic-min shape))))
                        (ir/accepts-arity? shape arity))
                false)]
   (when-not valid
    (throw (ex-info "native proc link: actual callable arity contract refused"
                    {:target (:target selection) :arity arity :packed-rest packed? :shape shape}))))))
(defn derived-core-remotes [aliases]
 (reduce (fn [out [key target]]
  (let [[ns name] (target-parts key) found (when (= ns "core") (BeamLisp.Env/link "core" name))]
   (if (and (erlang/is_tuple found) (= :ok (elem found 0)))
    (let [link (elem found 1) module (elem link 0) fixed (elem link 1) variadic (elem link 2)
          out (reduce (fn [out [arity function]] (assoc out [module function arity] target)) out fixed)]
     (if (and variadic (erlang/is_tuple variadic))
      (assoc out [module (elem variadic 1) (inc (elem variadic 0))] target) out)) out))) {} aliases))
(defn selected-remote [definition node bodies by-module remote-aliases leaves]
 (let [module (:mod node) function (erlang/atom_to_binary (:fun node)) arity (count (:args node))
       key (str (erlang/atom_to_binary module) "/" function "/" arity)
       alias (or (when (and (:prototype-actor-abi? definition) (= module :erlang)
                            (= function "raise") (contains? #{2 3} arity))
                   (qname kernel "native-prototype-raise!"))
                 (get remote-aliases [module (:fun node) arity]))
       namespace (get by-module module) logical (logical-name function)]
  (when (or (= module :ets)
            (contains? #{"erlang/send_after/3" "erlang/send_after/4" "erlang/start_timer/3"
                         "erlang/cancel_timer/1" "erlang/cancel_timer/2"
                         "Elixir.Process/send_after/3" "Elixir.Process/cancel_timer/1"} key))
   (throw (ex-info "native proc link: process timer/table policy has no admitted adapter"
                   {:target key :caller (:path definition)})))
  (when (and (= alias (qname kernel "native-send!"))
             (= :lit (:op (first (:args node))))
             (or (keyword? (:val (first (:args node)))) (string? (:val (first (:args node))))))
   (throw (ex-info "native proc link: raw Erlang name-address sends are not admitted"
                   {:target key :address (:val (first (:args node))) :caller (:path definition)})))
  (cond
   (= module :host)
    (if (contains? actor/host-names function) {:kind :actor-host :target key :source (str "h-" function)}
     (throw (ex-info "native proc link: unknown actor host leaf" {:target key})))
   alias (let [body (get bodies alias) selection {:kind :body :target alias :body body}]
          (when-not body (throw (ex-info "native proc link: remote alias body absent" {:target alias})))
          (check-arity! selection arity false)
          (assoc selection :external? (:external? body) :body-source {:path (:path body) :sha256 (:source-sha256 body)}))
   (and namespace (contains? bodies (qname namespace logical)))
    (let [body (get bodies (qname namespace logical))
          selection {:kind :body :target (qname namespace logical) :body body
                     :packed? (not= function logical) :remote-key key}]
     (when (and (:private? body) (not= (:ns definition) namespace))
      (throw (ex-info "native proc link: private remote body refused" {:target (:target selection)})))
     (check-arity! selection arity (:packed? selection))
     (assoc selection :external? (:external? body) :body-source {:path (:path body) :sha256 (:source-sha256 body)}))
   (contains? leaves key) {:kind :leaf :target key :source (str "(native-remote " (scheme/text key) ")")}
   :else (throw (ex-info "native proc link: unsupported source host dependency"
                  {:target key :caller (:path definition) :ann (:ann node)})))))
(defn inspect [definition context]
 (let [{:keys [bodies aliases by-module remote-aliases leaves]} context]
  (loop [todo (walk (:node definition)) out []]
   (if (erlang/== (list) todo) out
    (let [node (erlang/hd todo) selection (case (:op node)
                     :global (selected-global definition node bodies aliases)
                     :remote (selected-remote definition node bodies by-module remote-aliases leaves)
                     :binding (throw (ex-info "native proc link: Source custody is absent" {:reference (:reference node)}))
                     nil)
         call (ir/call-site node)
         callee (:callee call)]
    (when (and callee (= :global (:op callee)))
     (check-arity! (selected-global definition callee bodies aliases) (:arity call) false))
     (recur (erlang/tl todo) (if selection (conj out (dissoc selection :body :source)) out)))))))
(defn reachable [roots context]
 (loop [todo (BeamLisp.CompilerData/eager_to_list roots) seen #{} out [] edges []]
  (if (erlang/== (list) todo) {:definitions out :edges edges}
   (let [definition (erlang/hd todo) key (qname (:ns definition) (:name definition))]
    (if (contains? seen key) (recur (erlang/tl todo) seen out edges)
     (let [references (inspect definition context)
           dependencies (BeamLisp.CompilerData/eager_map
                         (fn [reference] (get (:bodies context) (:target reference)))
                         (BeamLisp.CompilerData/eager_filter
                          (fn [reference] (and (= :body (:kind reference)) (not (:external? reference)))) references))]
      (recur (erlang/++ (erlang/tl todo) dependencies) (conj seen key) (conj out definition)
       (into edges (map #(assoc % :caller key) references)))))))))
(defn resolver-query [node]
 (case (:op node)
  :global [:global (:ns node) (:name node) (:lookup node)]
  :remote [:remote (:mod node) (:fun node) (count (:args node))]
  nil))
(defn capture-resolvers [definitions context]
 ; Query keys describe original executable ANF, not Source spelling guesses.
 ; Capture the SAME checked selection while this private staging Env exists.
 {:schema "bl.native.proc-resolvers" :version 1 :runtime-namespace kernel
  :definitions
  (into {} (BeamLisp.CompilerData/eager_map (fn [definition]
   [(qname (:ns definition) (:name definition))
    (reduce (fn [out node]
     (if-let [query (resolver-query node)]
      (let [selection (case (:op node)
                       :global (selected-global definition node (:bodies context) (:aliases context))
                       :remote (selected-remote definition node (:bodies context) (:by-module context)
                                 (:remote-aliases context) (:leaves context)))
            record (cond-> (dissoc selection :body :source)
                     (= :actor-host (:kind selection)) (assoc :host-name (erlang/atom_to_binary (:fun node))))]
       (when (and (contains? out query) (not= (get out query) record))
        (throw (ex-info "native proc link: one ANF query has conflicting checked targets" {:query query})))
       (assoc out query record)) out)) {} (walk (:node definition)))]) definitions))})
(defn value-source [selection]
 (let [[ns name] (target-parts (:target selection))]
  (str "(native-global-exact " (scheme/text ns) " " (scheme/text name) ")")))
(defn resolver-sources [definition context]
 ; Eager selection stays inside the staging Env. The result contains only
 ; finite query keys and emitted strings: never ANF bodies or Env functions.
 (reduce (fn [out node]
  (if-let [query (resolver-query node)]
   (let [source (case (:op node)
                  :global (value-source (selected-global definition node (:bodies context) (:aliases context)))
                  :remote
                   (let [selection (selected-remote definition node (:bodies context) (:by-module context)
                                    (:remote-aliases context) (:leaves context))]
                    (cond
                     (:source selection) (:source selection)
                     (:packed? selection)
                      (str "(lambda arguments (native-linked-packed-call " (value-source selection) " arguments))")
                     :else (str "(lambda arguments (bl-invoke " (value-source selection) " arguments))"))))]
    (assoc out query source)) out)) {} (walk (:node definition))))
(defn resolver-source! [sources caller node]
 (let [query (resolver-query node)]
  (if (contains? sources query) (get sources query)
   (throw (ex-info "native proc link: emitter requested an uncaptured ANF query"
                   {:caller caller :query query :ann (:ann node)})))))
(defn options-for [definition context]
 (let [base (ev/context (:ns definition))
       sources (resolver-sources definition context)
       caller (qname (:ns definition) (:name definition))]
  ; Emission's lazy combinators may copy callback environments into memo
  ; resources. Capture ONLY this tiny per-definition string table, never the
  ; complete linked body graph or the definition's recursive ANF tree.
  (assoc base :runtime-namespace kernel :namespace-qualified? (not= kernel (:ns definition))
   :source-frames? (boolean (:source-frames? context))
   :receive-source (value-source {:target (qname kernel "rt-receive")})
   :global-resolver (fn [node] (resolver-source! sources caller node))
   :remote-resolver (fn [node] (resolver-source! sources caller node)))))
(defn render-definition [definition options]
 ; Shared pure wrapper for both live linking and exact captured-ANF replay.
 (let [ns (:ns definition) name (:name definition)
       binding (scheme/ident (if (= ns kernel) name (qname ns name))) shape (:shape definition)]
  (str (scheme/emit-definition definition options)
   "(native-register! " (scheme/text ns) " " (scheme/text name) " " binding ")\n"
   "(native-intern " (scheme/text ns) " " (scheme/text name) " " binding ")\n"
   (when shape
    (str "(native-register-arities! " (scheme/text ns) " " (scheme/text name) " "
      (scheme/literal (vec (sort (:arities shape)))) " " (scheme/literal (:variadic-min shape)) ")\n")))))
(defn emit-definition [definition context]
 (println (str "NATIVE_PROC_EMIT_BEGIN " (qname (:ns definition) (:name definition))))
 (let [options (options-for definition context)
       _ (when (and (= (:ns definition) kernel) (= (:name definition) "rt-empty-state"))
           (File/write! "research/native-seed/out/first-actor-definition.etf"
            (erlang/term_to_binary {:definition definition
                                   :resolutions (capture-resolvers [definition] context)} (list :deterministic))))
       source (render-definition definition options)]
  (println (str "NATIVE_PROC_EMIT_END " (qname (:ns definition) (:name definition)) " " (erlang/byte_size source)))
  source))
(defn module-source [unit]
 (str "(native-declare-ns " (scheme/text (:ns unit)) ")\n"
  (string/join "" (map (fn [module]
   (str "(set! native-module-names (bl-assoc native-module-names "
     (scheme/text (erlang/atom_to_binary module)) " " (scheme/text (:ns unit)) "))\n"))
   [(:module unit) (:base-module unit)]))))
(defn build-project [request]
 (let [helper-namespaces (if (contains? request :helper-namespaces) (:helper-namespaces request)
                          ["proc.bus" "proc.flow" "proc.reg"])
       _ (when-not (and (vector? helper-namespaces)
                        (= (count helper-namespaces) (count (distinct helper-namespaces)))
                        (every? #(contains? helpers %) helper-namespaces))
           (throw (ex-info "native proc link: helper list is not an exact admitted namespace vector" {})))
       captured (capture-compiler-vocabulary helper-namespaces)]
 (println "NATIVE_PROC_STAGE planners-captured")
 (BeamLisp.Env/isolated (fn []
  (let [closure (artifact/read-closure (:closure-manifest request))
        _ (println "NATIVE_PROC_STAGE closure-read")
        pin (json/decode (File/read! (:sdk-pin request)))
        captured-pin (if (string? (:sdk-pin closure)) (json/decode (:sdk-pin closure)) (:sdk-pin closure))
        _ (when-not (= captured-pin pin)
            (throw (ex-info "native proc link: compiler closure SDK pin mismatch" {})))
        sdk-descriptor (File/read! (str (get pin "sdk") "/artifact.json"))
        _ (when-not (= (digest sdk-descriptor) (get pin "descriptor_sha256"))
            (throw (ex-info "native proc link: qualified SDK descriptor changed" {})))
        _ (doseq [ns helper-namespaces :let [spec (get helpers ns)]]
            (when-not (= (:sha256 spec) (digest (File/read! (:path spec))))
             (throw (ex-info "native proc link: admitted helper source changed" {:namespace ns :path (:path spec)}))))
        helper-units (mapv (fn [ns] (project-protocol (prepare (:path (get helpers ns)) ns captured))) helper-namespaces)
        runtime-unit (project-protocol (prepare (:runtime request) kernel captured))
        bridge-unit (project-protocol (prepare (:bridges request) kernel captured))
        app-unit (project-protocol (prepare (:application request) kernel captured))
        _ (when (and (:original-actor-corpus? request)
                     (not= original-actor-corpus (source-identity (:application request))))
            (throw (ex-info "native proc link: original actor compatibility requires its exact source identity" {})))
        app-unit (assoc app-unit :prototype-actor-abi? (boolean (:original-actor-corpus? request)))
        own-units (vec (concat [runtime-unit bridge-unit] helper-units [app-unit]))
        own-namespaces (set (map :ns own-units))
        prelude-units (vec (BeamLisp.CompilerData/eager_map #(assoc % :native-external? true)
                             (BeamLisp.CompilerData/eager_filter #(not (contains? own-namespaces (:ns %)))
                              (BeamLisp.CompilerData/eager_map #(get (:units closure) %) (:order closure)))))
        _ (println "NATIVE_PROC_STAGE units-prepared")
        all (named-definitions (into prelude-units own-units))
        _ (println (str "NATIVE_PROC_STAGE bodies-indexed " (count all)))
        _ (doseq [definition (named-definitions own-units) :when (nil? (:name definition))]
            (throw (ex-info "native proc link: executable top-level actor initializer has no owner"
                            {:path (:path definition) :namespace (:ns definition)})))
        bodies (body-table all)
        links (BeamLisp.Compiler/read_data (File/read! (:links request)))
        aliases (:global-bindings links)
        remote-aliases (merge (derived-core-remotes aliases) (:remote-bindings links))
        by-module (assoc (into {} (mapcat (fn [unit] [[(:module unit) (:ns unit)] [(:base-module unit) (:ns unit)]])
                             (concat prelude-units own-units)))
                    :Elixir.BeamLisp.CompilerData "host.compiler-data"
                    :Elixir.BeamLisp.FormMeta "host.form-meta" :Elixir.BeamLisp.Meta "host.meta")
        leaves (set (get (json/decode (File/read! (:leaves request))) "registered_leaves"))
        context {:bodies bodies :aliases aliases :remote-aliases remote-aliases :by-module by-module :leaves leaves
                 :source-frames? (boolean (:source-frames? request))}
        own-paths (set (map :path own-units))
        roots (named-definitions [runtime-unit bridge-unit app-unit])
        _ (println "NATIVE_PROC_STAGE inspect-references")
        graph (reachable roots context)
        emitted (vec (filter #(contains? own-paths (:path %)) (:definitions graph)))
        emitted (vec (concat (filter #(= :fn (:kind %)) emitted) (remove #(= :fn (:kind %)) emitted)))
        _ (when-not (contains? bodies (qname (:ns app-unit) "main"))
            (throw (ex-info "native proc link: application has no main" {:path (:application request)})))
        _ (println (str "NATIVE_PROC_STAGE emit-definitions " (count emitted)))
        output (str (File/read! (:prelude request)) "\n"
                  (File/read! (:host-link request)) "\n"
                  (string/join "\n" (map (fn [path] (File/read! path)) (:host-extensions request))) "\n"
                  (string/join "" (BeamLisp.CompilerData/eager_map module-source own-units))
                  (string/join "" (BeamLisp.CompilerData/eager_map #(emit-definition % context) emitted))
                  "\n(bl-invoke " (value-source {:target (qname kernel "bl-main")})
                  " (list " (value-source {:target (qname (:ns app-unit) "main")}) "))\n"
                  "(if (not (null? seed-errors)) (error \"native actor errors\"))\n")]
   {:program output :definitions emitted :link-resolutions (capture-resolvers emitted context) :entry {:namespace (:ns app-unit) :name "main" :actor-runtime true}
    :manifest {:schema "bl.native.proc-link" :version 1 :sdk-pin pin
               :closure-manifest (source-identity (:closure-manifest request))
               :prelude (source-identity (:prelude request)) :links (source-identity (:links request))
               :host-link (source-identity (:host-link request))
               :host-extensions (mapv source-identity (:host-extensions request))
               :source-frames? (boolean (:source-frames? request))
               :compatibility (if (:original-actor-corpus? request)
                [{:source original-actor-corpus :projection :legacy-js-actor-raise-envelope
                  :targets [[:erlang :raise 2] [:erlang :raise 3]]
                  :authority "priv/lib/js/actor/host.mjs:BLRaise and ERLANG.raise"}] [])
               :units (mapv #(select-keys % [:ns :path :source-sha256 :module :base-module :wire-protocol]) own-units)
               :compile-time-registrations [{:namespace "proc.bus" :form '(extend-clause! :bus bus-clause)
                                             :owner :explicit-target-vocabulary}
                                            {:namespace "proc.reg" :form '(extend-clause! :registry registry-clause)
                                             :owner :explicit-target-vocabulary}]
               :compile-time-providers (:providers captured) :helper-namespaces helper-namespaces
               :runtime-definitions (count (:defs runtime-unit))
               :emitted-bindings (mapv #(qname (:ns %) (:name %)) emitted)
               :references (:edges graph) :source-interpreter false}})))))
