; Task-owned canonical ANF artifacts only. Partitioning preserves raw ETF
; source spans and the public CompilerData limits; it does not execute ANF.
(ns native.artifact (:require [bl.json :as json]))
(def limits {:max-nodes 1000000 :max-bytes 33554432 :max-depth 128})
(defn sha [bytes] (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower))))
(def validation-context
 (let [pin (json/decode (File/read! "research/native-seed/sdk-pin.json"))
       descriptor (File/read! (str (System/get_env "BL_SDK_PRODUCT") "/artifact.json"))]
  (assert (= (get pin "descriptor_sha256") (sha descriptor)))
  (assert (= (get pin "source") (get (json/decode descriptor) "source")))
  (assert (= descriptor (File/read! (str (get pin "sdk") "/artifact.json"))))
  {:policy "canonical-closed-etf-and-compiler-data-v1"
   :sdk-descriptor-sha256 (sha descriptor) :limits limits}))
(defn part-path [manifest-path path]
 (if (= :absolute (Path/type path)) path (Path/expand path (Path/dirname manifest-path))))
(defn read-part [manifest-path record]
 (let [path (part-path manifest-path (get record "path")) bytes (File/read! path)]
  (when (> (erlang/byte_size bytes) (:max-bytes limits))
   (throw (ex-info "native artifact: partition exceeds canonical byte bound" {:path path})))
  (when-not (= (sha bytes) (get record "sha256"))
   (throw (ex-info "native artifact: partition SHA mismatch" {:path path})))
  (let [proof-key (sha (erlang/term_to_binary
                        (assoc validation-context :partition-sha256 (sha bytes)) (list :deterministic)))
        proof-path (str path ".validated.json")
        proof (when (File/regular? proof-path)
                (try (json/decode (File/read! proof-path)) (catch _ nil)))
        proven? (and (= "bl.native.partition-shape-proof" (get proof "schema"))
                     (= 1 (get proof "version")) (= proof-key (get proof "key")))]
   ; A task-owned proof is written ONLY after BOTH canonical validators pass.
   ; Same byte SHA + exact immutable SDK + validator policy can reuse it.
   ; This grants passive shape only: no Source or execution authority.
   (when-not proven? (BeamLisp.CompilerData/check_closed_etf! bytes limits))
   (let [value (erlang/binary_to_term bytes)]
    (when-not proven?
     (BeamLisp.CompilerData/check_compiler_data! value limits)
     (File/write! proof-path
      (json/encode {"schema" "bl.native.partition-shape-proof" "version" 1 "key" proof-key
                    "partition_sha256" (sha bytes) "policy" (:policy validation-context)
                    "sdk_descriptor_sha256" (:sdk-descriptor-sha256 validation-context)})))
   value))))
(defn read-closure [manifest-path]
 (let [manifest (json/decode (File/read! manifest-path)) rows (get manifest "units")]
  (when-not (and (= "bl.native.partitioned-closure" (get manifest "schema"))
                (= 1 (get manifest "version")) (vector? rows) (<= (count rows) 256))
   (throw (ex-info "native artifact: invalid partition manifest" {:path manifest-path})))
  (let [original (File/read! (part-path manifest-path (get manifest "artifact_path")))]
   (when-not (and (<= (erlang/byte_size original) (:max-bytes limits))
                  (= (sha original) (get manifest "artifact_sha256")))
    (throw (ex-info "native artifact: original closure identity mismatch" {:path manifest-path}))))
  (let [metadata (read-part manifest-path (get manifest "metadata"))
        _ (when-not (and (map? metadata) (<= (count metadata) 32)
                         (= "bl.native.compiler-closure" (:schema metadata)) (= 1 (:version metadata)))
             (throw (ex-info "native artifact: invalid closure metadata" {:path manifest-path})))
        units
        (reduce (fn [units row]
          (let [ns (get row "namespace") unit (read-part manifest-path row)]
           (when-not (and (string? ns) (not (contains? units ns)) (= ns (:ns unit))
                          (string? (:source unit)) (string? (:path unit))
                          (= (sha (:source unit)) (:source-sha256 unit))
                          (vector? (:defs unit)) (<= (count (:defs unit)) 65536)
                          (vector? (:requires unit)) (keyword? (:module unit)) (keyword? (:base-module unit)))
            (throw (ex-info "native artifact: invalid compiled unit" {:namespace ns})))
           (assoc units ns unit))) {} rows)]
   (when-not (and (= (count units) (count (:order metadata)))
                 (= (set (keys units)) (set (:order metadata))))
    (throw (ex-info "native artifact: partition namespace order mismatch" {})))
   (assoc metadata :units units))))
