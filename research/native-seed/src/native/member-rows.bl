; The link rows of every closure member, from a compiled closure's SOURCE
; declarations (native.resolution-ledger/member-links): the rows the native
; image installs before it compiles anything. update-closure installs the same
; rows (NATIVE_LINK_ROWS) so BEAM compiles each member against them too.
;
; Usage (pinned SDK, repository root as cwd):
;   bl run research/native-seed/src/native/member-rows.bl -- DIR/closure.etf OUT.etf
; DIR/closure.etf is update-closure's output (before partition-closure.py).
(ns native.member-rows
 (:require [native.resolution-ledger :as ledger]))
(def argv (vec (BeamLisp/argv)))
(def closure (erlang/binary_to_term (File/read! (first argv))))
(def rows (ledger/member-links closure))
(File/write! (second argv) (erlang/term_to_binary rows (list :deterministic)))
(println (str "NATIVE_MEMBER_ROWS " (count rows) " " (second argv)))
