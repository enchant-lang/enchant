; Durable, host-side cache of emitted definition text. The immutable input is
; supplied by the AOT linker. Datom owns blob addressing and atomic publication.
(ns native.fragments
 (:require [anf] [native.bootstrap :as bootstrap] [datom.blob :as blob] [datom.blob-fs :as fs] [datom.file :as file]))

(defn digest [data]
 (file/sha-hex (file/sha256 (erlang/term_to_binary data (list :deterministic)))))

(defn- decisions-for [plan ns definition]
 ; A finite syntax walk, not an evaluator. Use only raw proper-list append;
 ; no LazySeq/mapcat chains enter the cache identity or traversal worklist.
 ; A call site's emitted shape depends on its TARGET's kind and declared
 ; arities, so each compiled decision carries that shape.
 (loop [todo (list (:node definition)) decisions #{}]
  (if (erlang/== todo (list)) (vec (sort-by str decisions))
   (let [node (erlang/hd todo)
         decision (case (:op node)
                   :remote (bootstrap/remote-decision plan node ns)
                   :global (let [selected (bootstrap/global-decision plan node)
                                  target [(nth selected 5) (nth selected 6)]
                                  arities (get (:arities plan) target)]
                              [selected (:fixed arities) (:variadic arities)])
                   nil)]
    (recur (lists/append (anf/executable-children node) (erlang/tl todo))
           (if decision (conj decisions decision) decisions))))))
(defn definition-key [contract plan ns definition]
 (digest [contract ns definition (decisions-for plan ns definition)]))

(defn open [directory]
 (File/mkdir_p! (str directory "/recipes"))
 {:root directory :store (fs/open (str directory "/bytes"))})

(defn- read-text [store path key]
 (try
  (when (File/regular? path)
   (let [receipt (File/read! path)]
    (when (and (= 194 (erlang/byte_size receipt))
               (= (str key " ") (erlang/binary_part receipt 0 65))
               (= (digest [key (erlang/binary_part receipt 65 64)]) (erlang/binary_part receipt 130 64)))
     (let [sha (Base/decode16! (erlang/binary_part receipt 65 64) (list (tuple :case :mixed)))
           bytes (blob/-blob-get store sha)]
      (when (and bytes (= sha (file/sha256 bytes))) bytes)))))
  (catch _ nil)))

(defn lookup [cache key]
 (read-text (:store cache) (str (:root cache) "/recipes/" key) key))

(defn emit [cache key render]
 (let [path (str (:root cache) "/recipes/" key) store (:store cache)]
  (or (read-text store path key)
   (let [bytes (render) sha (file/sha256 bytes) hex (file/sha-hex sha)
         tmp (str path "." (erlang/list_to_binary (os/getpid)) "." (erlang/unique_integer (list :positive)))]
    ;; This build directory owns its blobs. Replace damaged bytes only after
    ;; a fresh emission independently reproduces their content address.
    (when-let [present (blob/-blob-get store sha)]
     (when (not= sha (file/sha256 present)) (blob/-blob-delete store sha)))
    (blob/-blob-put store sha bytes)
    (try
     (File/write! tmp (str key " " hex " " (digest [key hex])))
     (File/rename! tmp path)
     (finally (File/rm tmp)))
    bytes))))
