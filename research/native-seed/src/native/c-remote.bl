; Direct compiler context extension only. Actor link manifests must provide
; their OWN checked resolver; this helper does not admit aliases/source bodies.
(ns native.c-remote (:require [native.scheme :as scalar]))
(defn source [node]
 (str "(native-c-remote "
  (scalar/text (str (erlang/atom_to_binary (:mod node)) "/"
                    (erlang/atom_to_binary (:fun node)) "/" (count (:args node)))) ")"))
(defn options [context] (assoc context :remote-resolver source))
