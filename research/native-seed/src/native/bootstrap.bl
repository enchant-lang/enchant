; This file is part of its own compiler input. The native executable reads
; ORIGINAL BL source, expands its ORIGINAL macros, invokes compiler/compile,
; then native.scheme/emit. The next executable repeats that pipeline.
(ns native.bootstrap
 (:require [compiler :as c] [reader :as rd] [reader-node :as rn]
           [native.scheme :as scheme] [native.eval :as ev]
           [native.resolution :as resolution] [native.intrinsics :as intrinsics]
           [clojure.string :as string]))

(defn data [v]
 (cond
  (nil? v) "bl-nil" (= v true) "#t" (= v false) "#f"
  (string? v) (scheme/text v) (number? v) (str v)
  (keyword? v) (str "(bl-key " (scheme/text (erlang/atom_to_binary v)) ")")
  (vector? v) (str "(bl-vec (list " (string/join " " (map data (to-list v))) "))")
  (map? v) (str "(bl-map " (string/join " " (mapcat (fn [[k x]] [(data k) (data x)]) (sort-by (comp str first) v))) ")")
  (erlang/is_tuple v) (str "(bl-tuple (list " (string/join " " (map data (Tuple/to_list v))) "))")
  (set? v) (str "(bl-set (list " (string/join " " (map data (sort-by str v))) "))")
  (list? v) (str "(list " (string/join " " (map data v)) ")")
  :else (throw (ex-info "native bootstrap: nonportable bundle value" {:value v}))))

(defn definition-values [forms ns path]
 (let [defs
  (keep (fn [form]
   (let [head (ev/head-symbol form)]
    (cond
     (contains? #{"defn" "defn-" "def"} head)
      (let [decl (c/declaration-source form (assoc (c/new-env ns) :file path))]
       {:name (rn/node-name (rn/node-form (:name decl)))
        :kind (if (= head "def") :val :fn)
        :private? (= :private (:visibility decl))
        :form (let [value (:value-form decl) pos (rn/node-pos form)]
                (if pos (rn/meta-node value pos) value))})
     (contains? #{"ns" "defmacro" "comment" "declare"} head) nil
     :else {:name nil :kind :expr :form form}))) forms)
       last-at (reduce (fn [m [i d]] (if (:name d) (assoc m (:name d) i) m)) {} (map-indexed (fn [index definition] [index definition]) defs))]
  (vec (keep (fn [[i d]] (when (or (nil? (:name d)) (= i (get last-at (:name d)))) d)) (map-indexed (fn [index definition] [index definition]) defs)))))

(defn prepare [unit]
 (let [ns (:ns unit) path (:path unit) forms (rd/read-string (:source unit) path)
       _ (BeamLisp.Env/mark_loaded ns)
       _ (ev/eval-form (first forms))
       defs (definition-values (rest forms) ns path)]
  (doseq [d defs :when (and (:name d) (not (BeamLisp.Env/bound? ns (:name d))))]
   (BeamLisp.Env/intern ns (:name d) nil))
  ; All source helpers are already compiled members of this exact closed
  ; bundle. Macro definitions themselves are compiled anew from BL source.
  (doseq [form (rest forms) :when (= "defmacro" (ev/head-symbol form))]
   (ev/eval-form form))
  (assoc unit :defs
   (mapv (fn [d]
    (c/reset-fresh!)
    (assoc d :node (c/compile (:form d) (assoc (c/new-env ns) :file path :target :js)))) defs))))

(defn binding-name [ns name] (scheme/ident (str ns "/" name)))
; AOT link cells (host: native-link!, native-leaf-binding-name). The names
; are disjoint from every binding-name: ident never emits "$" or a leading l.
(defn global-binding-name [ns name] (str (binding-name ns name) "$g"))
(defn arity-binding-name [ns name arity] (str (binding-name ns name) "$" arity))
(defn variadic-binding-name [ns name] (str (binding-name ns name) "$v"))
(defn leaf-binding-name [key] (str "l" (scheme/ident key)))
(defn declaration-arities
 "Project arity data from the canonical declaration's ALREADY VALIDATED fn
  value. This is only export metadata; the compiler owns parsing and code."
 [form]
 (let [tail (rest (rn/node-items (rn/node-form form)))
       tail (if (= :symbol (rn/node-tag (rn/node-form (first tail)))) (rest tail) tail)
       params (if (= :vector (rn/node-tag (rn/node-form (first tail)))) [(first tail)]
                  (map #(first (rn/node-items (rn/node-form %))) tail))
       shapes (map (fn [p]
                  (let [items (rn/node-items (rn/node-form p))
                        fixed (take-while (fn [item]
                          (let [n (rn/node-form item)]
                           (not (and (= :symbol (rn/node-tag n)) (= "&" (rn/node-name n)))))) items)]
                   [(if (= (count fixed) (count items)) :fixed :variadic) (count fixed)])) params)]
  {:fixed (vec (sort (distinct (map second (filter #(= :fixed (first %)) shapes)))))
   :variadic (some (fn [[kind n]] (when (= :variadic kind) n)) shapes)}))
(defn install-source-macros! [bundle]
 ; Same boot order as js/boot.mjs. The compiled definitions are present;
 ; macros remain SOURCE and are compiled in the native realm before any
 ; namespace's source is compiled. This also exercises Scheme eval directly.
 (doseq [name ["core" "sugar"]
         unit (:units bundle) :when (= name (:ns unit))]
  (BeamLisp.Env/in_ns name)
  (doseq [form (rd/read-string (:source unit) (:path unit))
          :when (= "defmacro" (ev/head-symbol form))]
   (ev/eval-form form)))
 (BeamLisp.Env/in_ns "user"))
; ---------------------------------------------------------------------------
; AOT link plan: the ONE linking context. The BEAM driver (native.chunks) and
; the native self-emission (compile-bundle, run by stage1 and stage2) both
; build it from the bundle metadata (native.resolution-ledger/bundle-metadata,
; carried in bundle.scm) and the units' definitions, and emit through
; emit-definition below. Cells: research/native-seed/speed/link/RESULT.md;
; plan and host modules: research/native-seed/speed/closure/RESULT.md.
(defn link-plan [metadata units]
 (let [named (fn [u] (filter :name (:defs u)))]
  {:leaves (set (:leaves metadata))
   :table (into {} (map (fn [u] [(:ns u) (set (map :name (named u)))]) units))
   :defined (set (mapcat (fn [u] (map (fn [d] [(:ns u) (:name d)]) (named u))) units))
   :arities (into {} (mapcat (fn [u] (keep (fn [d] (when (= :fn (:kind d))
                                                    [[(:ns u) (:name d)] (declaration-arities (:form d))]))
                                          (named u))) units))
   ; A pinned BL host module (`Elixir.BeamLisp.X`, metadata :host-modules) IS
   ; the definitions of its closure namespace, so a :remote to it links there.
   :by-module (into {} (concat (mapcat (fn [[ns module base]] [[module ns] [base ns]]) (:namespace-modules metadata))
                               (map (fn [[ns module]] [module ns]) (:host-modules metadata))))
   :module-of (into {} (map (fn [[ns module]] [ns module]) (:host-modules metadata)))
   :stub-modules (set (mapcat (fn [[_ module base]] [module base]) (:stub-modules metadata)))
   ; N3: the build declares the image sealed (bundle-metadata: the native
   ; closure always is). Absent, linking is the dev form, byte for byte.
   :sealed? (= true (:sealed metadata))
   :ledger (:resolution metadata)}))
(defn remote-key [n]
 (str (erlang/atom_to_binary (:mod n)) "/" (erlang/atom_to_binary (:fun n)) "/" (count (:args n))))
(defn- logical-name [f] (if (string/ends-with? f "__bl_v") (subs f 0 (- (count f) 6)) f))
(defn- remote-link-shape [plan ns logical mode arity]
 (let [arities (get (:arities plan) [ns logical])]
  (cond
   (= mode "rest-list-clause") (if (some? (:variadic arities)) "variadic" "dynamic")
   (contains? (set (:fixed arities)) arity) "arity"
   (contains? (:defined plan) [ns logical]) "generic"
   :else "dynamic")))
(defn compiled-target
 "The closure namespace whose definition is module/f, or nil."
 [plan module f]
 (let [ns (get (:by-module plan) module)]
  (when (and ns (contains? (get (:table plan) ns) (logical-name f))) ns)))
(declare self-module)
(defn remote-decision
 ; A compiled target wins over a host leaf with the same key; that leaf is
 ; dead (native.chunks reports it for its owner to delete). With the linked
 ; namespace, a host module's fun_info self-name is a link-time constant.
 ([plan n ns]
  (if-let [module (self-module plan ns n)]
   ["self-module" (remote-key n) (erlang/atom_to_binary module)]
   (remote-decision plan n)))
 ([plan n]
 (let [m (:mod n) f (erlang/atom_to_binary (:fun n)) key (remote-key n) ns (compiled-target plan m f)]
  (cond
   ns (let [logical (logical-name f) mode (if (string/ends-with? f "__bl_v") "rest-list-clause" "fixed-dispatch")]
       ["compiled" key ns logical mode (remote-link-shape plan ns logical mode (count (:args n)))])
   (contains? (:leaves plan) key) ["leaf" key]
   (contains? (:stub-modules plan) m) ["excluded-namespace" key]
   :else (throw (ex-info (str "native link: unresolved remote signature " key) {:remote key :ann (:ann n)}))))))
(defn global-decision [plan n] (resolution/global-decision (:ledger plan) (:table plan) n))
(defn- direct-call [target]
 {:inline? true :call (fn [operands] (str "(" target (string/join "" (map #(str " " %) operands)) ")"))})
(defn- variadic-call
 "The variadic arm `target` called as native-resolve-call would: the first
  `minimum` operands, then the rest as one list."
 [target minimum]
 {:inline? true
  :call (fn [operands]
         (let [ops (vec operands)]
          (str "(" target (string/join "" (map #(str " " %) (subvec ops 0 minimum)))
               " (list" (string/join "" (map #(str " " %) (subvec ops minimum))) "))")))})
(defn- generic-call [target]
 ; A non-:fn definition or an undeclared arity: the live slot value decides.
 {:inline? true
  :call (fn [operands]
         (let [spread (string/join "" (map #(str " " %) operands))]
          (str "(let ((linked " target ")) (if (procedure? linked) (linked" spread
               ") (bl-invoke linked (list" spread "))))")))})
(defn- self-module
 "A pinned host module names itself with `(erlang/fun_info (fn …) :module)`.
  On BEAM a fun literal written in that module belongs to it, so the answer
  is a link-time constant: {:module M} for the namespace being linked. Any
  other fun_info stays unresolved and fails loudly."
 [plan ns n]
 (let [[f k] (:args n) module (get (:module-of plan) ns)]
  (when (and module (= :erlang (:mod n)) (= :fun_info (:fun n)) (= 2 (count (:args n)))
             (or (= :fn (:op f)) (some? (BeamLisp.CompilerData/self_application_parts f)))
             (= :lit (:op k)) (= :module (:val k)))
   module)))
(defn remote-link
 ; nil keeps the dynamic (native-remote KEY) path: excluded namespaces and
 ; rest-list calls to a definition without a variadic arm raise there.
 ; :kind says what the remote reaches (:self-module, :template, :leaf or
 ; :compiled), for the emitter's analyses: a leaf or template is a host
 ; primitive, a compiled target is a BL call. It never changes the text.
 ([plan n] (remote-link plan nil n))
 ([plan ns n]
 (if-let [module (self-module plan ns n)]
  {:inline? true :kind :self-module
   :call (fn [_] (str "(bl-make-tuple " (scheme/literal :module) " " (scheme/literal module) ")"))}
 (if-let [template (intrinsics/remote-template n)]
  {:inline? false :kind :template :call template}
  (let [decision (remote-decision plan n)]
   (case (first decision)
    "leaf" (assoc (direct-call (leaf-binding-name (second decision))) :kind :leaf)
    "compiled"
     (let [[_ _ ns logical _ shape] decision
           link (case shape
                 "arity" (direct-call (arity-binding-name ns logical (count (:args n))))
                 "variadic" (direct-call (variadic-binding-name ns logical))
                 "generic" (generic-call (binding-name ns logical))
                 nil)]
      (when link (assoc link :kind :compiled)))
     nil))))))
(defn sealed-function?
 "Under a sealed plan, the selected compiled :fn definition ns/name: its
  binding never changes after link, so references read it directly."
 [plan sel-kind sel-ns sel-name]
 (and (:sealed? plan) (= "compiled" sel-kind) (contains? (:arities plan) [sel-ns sel-name])))
(defn global-link
 "Sealed images only: a :global CALL with `arity` static arguments whose
  selected target is a compiled :fn declaring that arity links straight to
  the immutable arity cell, as a :remote to it does. nil keeps the value read
  (emitter interface for :invoke of a :global callee; see link3/RESULT.md)."
 [plan n arity]
 (let [[_ _ _ _ sel-kind sel-ns sel-name] (global-decision plan n)]
  (when (sealed-function? plan sel-kind sel-ns sel-name)
   (let [arities (get (:arities plan) [sel-ns sel-name])]
    (cond
     (contains? (set (:fixed arities)) arity)
      (assoc (direct-call (arity-binding-name sel-ns sel-name arity)) :kind :compiled)
     ; No fixed arm of that arity: the variadic arm, as native-resolve-call picks it.
     (and (some? (:variadic arities)) (>= arity (:variadic arities)))
      (assoc (variadic-call (variadic-binding-name sel-ns sel-name) (:variadic arities)) :kind :compiled)
     :else nil)))))
(defn link-context [plan ns]
 ; native.eval/context plus :aot-link. Every remote must have an exact
 ; capability (remote-decision raises otherwise); the dynamic resolver stays
 ; for the shapes remote-link leaves unlinked.
 (let [base (ev/context ns)]
  (assoc base
   :aot-link (if (:sealed? plan)
              {:remote (fn [n] (remote-link plan ns n)) :global (fn [n arity] (global-link plan n arity))}
              {:remote (fn [n] (remote-link plan ns n))})
   :remote-resolver (fn [n] (remote-decision plan n ns) ((:remote-resolver base) n))
   :global-resolver
   (fn [n]
    (let [[_ _ _ _ sel-kind sel-ns sel-name] (global-decision plan n)]
     (if (sealed-function? plan sel-kind sel-ns sel-name)
      (binding-name sel-ns sel-name)
      (global-binding-name sel-ns sel-name)))))))
(defn- sealed-link-definition
 ; N3: every cell is defined once from the compiled value and never set!, so
 ; Gambit sees constant top-level bindings. A compiled :fn has no global-view
 ; cell (references read its binding); a :val keeps one. native-seal-image!
 ; (emitted after the initializers) makes any later redefinition raise.
 ; `raw` is {arity lambda-text} (scheme/emit-sealed-function): that arity
 ; cell is the literal lambda itself, which Gambit can inline.
 [ns name kind arities raw]
 (let [binding (binding-name ns name)]
  (if (= :fn kind)
   (str (string/join "" (map #(str "(define " (arity-binding-name ns name %) " "
                                   (or (get raw %) (str "(native-arity-entry " binding " " % ")")) ")\n")
                             (:fixed arities)))
        (if (some? (:variadic arities))
         (str "(define " (variadic-binding-name ns name) " (native-variadic-entry " binding " "
              (scheme/text (str ns "/" name)) "))\n") ""))
   (str "(define " (global-binding-name ns name) " (native-unmacro " binding "))\n"))))
(defn link-definition
 ([ns name kind arities] (link-definition false ns name kind arities {}))
 ([sealed? ns name kind arities] (link-definition sealed? ns name kind arities {}))
 ([sealed? ns name kind arities raw]
 ; One setter per linked slot (compiled view, including arity entries) and
 ; one for its global view; native-link! initializes both immediately.
 (if sealed? (sealed-link-definition ns name kind arities raw)
 (let [binding (binding-name ns name) global (global-binding-name ns name)
       fixed (if (= :fn kind) (:fixed arities) [])
       variadic? (and (= :fn kind) (some? (:variadic arities)))
       cells (concat (map #(arity-binding-name ns name %) fixed)
                     (when variadic? [(variadic-binding-name ns name)]) [global])]
  (str (string/join "" (map #(str "(define " % " #f)\n") cells))
       "(native-link! " (scheme/text ns) " " (scheme/text name) " (lambda (value) (set! " binding " value)"
       (string/join "" (map #(str " (set! " (arity-binding-name ns name %) " (native-arity-entry value " % "))") fixed))
       (if variadic? (str " (set! " (variadic-binding-name ns name) " (native-variadic-entry value "
                          (scheme/text (str ns "/" name)) "))") "")
       ") (lambda (value) (set! " global " value)))\n")))))
(defn seal-source
 "The bundle's last form before its entry point: sealed images only."
 [plan]
 (if (:sealed? plan) "(native-seal-image!)\n" ""))
(defn seed-links [plan]
 ; Seeds are interned by rt/seed-core; only their global view is linked.
 (string/join ""
  (for [[ns names] (sort-by first (:seed-names (:ledger plan))) name (sort names)
        :when (not (contains? (get (:table plan) ns #{}) name))]
   (let [global (global-binding-name ns name)]
    (str "(define " global " (native-unlinked " (scheme/text ns) " " (scheme/text name) "))\n"
         "(native-link-global! " (scheme/text ns) " " (scheme/text name) " (lambda (value) (set! " global " value)))\n")))))
(defn- sealed-raw
 "A sealed single-fixed-arity :fn: scheme/emit-sealed-function's {:arity
  :lambda :value} for its arity cell, or nil (the ordinary emission)."
 [plan ns d arities context]
 (when (and (:sealed? plan) (= :fn (:kind d)) (nil? (:variadic arities)) (= 1 (count (:fixed arities))))
  (let [arity (first (:fixed arities))
        r (scheme/emit-sealed-function (:node d) context (arity-binding-name ns (:name d) arity)
                                       (binding-name ns (:name d)))]
   (when (and r (= arity (:arity r))) r))))
(defn- constant-defines
 "The definition's hoisted constant literals (scheme/hoisted), in order."
 [sink]
 (string/join "" (map (fn [[name text]] (str "(define " name " " text ")\n")) (:rows @sink))))
(defn emit-definition [plan unit d]
 (let [ns (:ns unit) sink (atom {:index {} :rows []})
       context (if (:name d) (assoc (link-context plan ns) :constants sink :constant-prefix (binding-name ns (:name d)))
                 (link-context plan ns))
       arities (when (and (:name d) (= :fn (:kind d))) (declaration-arities (:form d)))
       raw (when (:name d) (sealed-raw plan ns d arities context))
       value (if raw (:value raw) (scheme/emit (:node d) context))]
  (if (:name d)
   (let [binding (binding-name ns (:name d))
         constants (constant-defines sink)
         cells (link-definition (:sealed? plan) ns (:name d) (:kind d) arities
                                (if raw {(:arity raw) (:lambda raw)} {}))]
    ; A function's value is a closure, so its constants follow its head (and
    ; stay in its unit); any other value is evaluated now, after them.
    (str (if (= :fn (:kind d)) "" constants)
        "(define " binding " " value ")\n"
        (if (= :fn (:kind d)) constants "")
        ; Sealed: the cells exist before registration, so a native counterpart
        ; installed at native-register! (a NIF, as erlang:load_nif replaces the
        ; module's own functions on BEAM) reaches local calls too. Dev images
        ; register first: native-link! initializes its cells from the registry.
        (if (:sealed? plan) cells "")
        "(native-register! " (scheme/text ns) " " (scheme/text (:name d)) " " binding ")\n"
        "(native-put-meta " (scheme/text ns) " " (scheme/text (:name d))
        " (bl-map (bl-key \"private\") " (if (:private? d) "#t" "#f") "))\n"
        (when arities
         (str "(native-register-arities! " (scheme/text ns) " " (scheme/text (:name d)) " "
              (data (:fixed arities)) " " (data (:variadic arities)) ")\n"))
        (if (:sealed? plan) "" cells)))
   (str value "\n"))))
(defn emit-functions
 "The :fn definitions of `defs` (a window of `unit`), in order."
 [plan unit defs]
 (string/join "" (map #(emit-definition plan unit %) (filter #(= :fn (:kind %)) defs))))
(defn emit-initializers
 "The other definitions of `defs`, in order. The window that starts core
  first links the seeds and runs rt/seed-core."
 [plan unit defs first-window?]
 (str (when (and first-window? (= "core" (:ns unit)))
       (str (seed-links plan) "(bl-invoke (native-global \"rt\" \"seed-core\") '())\n"))
      (string/join "" (map #(emit-definition plan unit %) (remove #(= :fn (:kind %)) defs)))))
(defn bundle-install-source
 "The prelude's bundle install: the metadata without its link rows, then the
  rows in bounded batches as separate top-level forms. One form holding all
  ~1,700 rows is ~440 KB of constructor calls, which gsc cannot compile within
  its deadline; the unit splitter can only split between top-level forms."
 [metadata]
 (let [links (vec (:namespace-links metadata)) n (count links) size 128]
  (str "(native-install-bundle! " (data (dissoc metadata :namespace-links)) ")\n"
       (string/join "" (map (fn [i] (str "(native-install-namespace-links! "
                                         (data (subvec links i (min n (+ i size)))) ")\n"))
                            (filter #(= 0 (erlang/rem % size)) (range n)))))))
(defn emit-compiled-bundle
 ([units bundle host-source]
  (emit-compiled-bundle units bundle host-source "(native-main (native-command-line))\n"))
 ([units bundle host-source entry-source]
 ; The same bytes, in the same order, as native.chunks assemble! joining its
 ; rows: every unit's functions, then every unit's initializers.
 (let [metadata (dissoc bundle :units) plan (link-plan metadata units)]
  (str ";; BL native compiler. Generated from canonical BL source.\n"
       host-source "\n"
       (bundle-install-source metadata)
       (string/join "" (map #(emit-functions plan % (:defs %)) units))
       (string/join "" (map #(emit-initializers plan % (:defs %) true) units))
       (seal-source plan)
       entry-source))))

(defn compile-bundle [bundle host-source]
 (install-source-macros! bundle)
 (emit-compiled-bundle (mapv prepare (:units bundle)) bundle host-source))

(defn main [args]
 (cond
  (and (= 4 (count args)) (= "--compile" (first args)))
   (let [bundle (host/eval-scheme (host/read-file (nth args 1)))
         host-source (host/read-file (nth args 2))
         output (compile-bundle bundle host-source)]
    (host/write-file (nth args 3) output)
    (println (str "NATIVE_SELF_COMPILE " (count (:units bundle)) " namespaces")))
  (and (= 3 (count args)) (= "--eval" (first args)))
   (let [bundle (host/eval-scheme (host/read-file (nth args 1)))]
    (install-source-macros! bundle)
    (ev/eval-string (host/read-file (nth args 2)) (nth args 2)))
  :else
   (throw (ex-info "usage: native-compiler --compile bundle.scm host.scm output.scm | --eval bundle.scm source.bl" {:args args}))))
