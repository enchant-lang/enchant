; Canonical reader -> compiler -> Scheme emitter -> Scheme evaluation.
; There is deliberately no source parser or ANF interpreter in this adapter.
(ns native.eval
 (:require [compiler :as c] [reader :as rd] [reader-node :as rn]
           [native.scheme :as scheme]))

(def arithmetic-procedures
 {:add "native-arith-add" :sub "native-arith-sub" :mul "native-arith-mul" :div "native-arith-div"
  :lt "native-arith-lt" :gt "native-arith-gt" :le "native-arith-le" :ge "native-arith-ge"
  :num_eq "native-arith-num-eq"})

(defn- name-encoder [encode]
 ; Only immutable spellings enter this table. The context owns its lifetime.
 (let [names (atom {})]
  (fn [s]
   (or (get @names s)
       (let [printed (encode s)]
        (when (and (< (count @names) 512) (<= (erlang/byte_size s) 128))
         (swap! names assoc s printed))
        printed)))))

(defn context [ns]
 (let [quoted (name-encoder scheme/text)]
 {:ns ns :namespace ns :namespace-qualified? true :callable-arities? true
  :local-ident (name-encoder scheme/ident)
  :global-resolver
   (fn [n] (str "(" (if (= :exact (:lookup n)) "native-global-exact" "native-global")
                 " " (quoted (:ns n)) " " (quoted (:name n)) ")"))
  :remote-resolver
   (fn [n] (str "(native-remote "
    (quoted (str (erlang/atom_to_binary (:mod n)) "/"
                 (erlang/atom_to_binary (:fun n)) "/" (count (:args n)))) ")"))
  ; Named two-operand host procedures (host-compiler.scm); no closure is
  ; allocated per operation. Any other operator keeps the generic dispatcher.
  :arithmetic-resolver
   (fn [n] (or (get arithmetic-procedures (:fun n))
               (str "(lambda (a b) (bl-arithmetic " (scheme/literal (:fun n)) " a b))")))
  :binding-resolver (fn [n] (throw (ex-info "native eval: contextual Source binding requires native custody" {:reference (:reference n)})))}))

(defn head-symbol [form]
 (let [node (rn/node-form form)]
  (when (= :list (rn/node-tag node))
   (let [head (rn/node-form (first (rn/node-items node)))]
    (when (= :symbol (rn/node-tag head)) (rn/node-name head))))))

(defn- evaluation-env [ns] (assoc (c/new-env ns) :target :js))

(defn emit-macro [form]
 (let [ns (BeamLisp.Env/current_ns) env (evaluation-env ns)]
  (c/reset-fresh!)
  (scheme/emit (c/compile form env) (context ns))))

(defn eval-form [form]
 (let [ns (BeamLisp.Env/current_ns) head (head-symbol form)
       env (evaluation-env ns)]
  (c/reset-fresh!)
  (if (contains? #{"defn" "defn-" "def"} head)
   (let [decl (c/declaration-source form env)
         name (rn/node-name (rn/node-form (:name decl)))
         _ (when-not (BeamLisp.Env/bound? ns name) (BeamLisp.Env/intern ns name nil))
         node (c/compile (:value-form decl) env)
         value (host/eval-node node (context ns))]
    (BeamLisp.Env/intern ns name value)
    (BeamLisp.Env/put_meta ns name {:private (= :private (:visibility decl))})
    value)
   (host/eval-node (c/compile form env) (context ns)))))

(defn eval-string
 ([source] (eval-string source "native-eval"))
 ([source path]
  (reduce (fn [_ form] (eval-form form)) nil (rd/read-string source path))))
