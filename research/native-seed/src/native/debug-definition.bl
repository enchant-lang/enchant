; Focus one failed export slice without rebuilding or changing its cache key.
(ns native.debug-definition
 (:require [native.artifact :as artifact] [native.bootstrap :as bootstrap]
           [native.resolution-ledger :as ledger] [bl.json :as json]))
(def args (BeamLisp/argv))
(def namespace (or (first args) "rt"))
(def offset (String/to_integer (or (second args) "448")))
(def closure (artifact/read-closure "research/native-seed/out/compiler-closure/partition.json"))
(def leaves (get (json/decode (File/read! "research/native-seed/out/compiler-closure/leaves.json")) "registered_leaves"))
(def plan (bootstrap/link-plan (ledger/bundle-metadata closure leaves) (mapv #(get (:units closure) %) (:order closure))))
(def unit (get (:units closure) namespace))
(doseq [d (subvec (:defs unit) offset)]
 (println (str "NATIVE_DEBUG_DEFINITION " namespace "/" (:name d) " " (:kind d)))
 (try
  (let [source (bootstrap/emit-definition plan unit d)]
   (println (str "NATIVE_DEBUG_EMITTED " (count source))))
  (catch e
   (println (str "NATIVE_DEBUG_ERROR " (ex-message e) " " (pr-str (ex-data e))))
   (throw e))))
