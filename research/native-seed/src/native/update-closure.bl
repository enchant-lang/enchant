; Recompile ONLY source-changed members of the already qualified closure, and
; add the namespaces that workstreams declare explicitly.
; Reuse private partition shape proofs; never perform a full ANF inventory.
;
; Usage (pinned SDK, repository root as cwd):
;   research/native-seed/run run research/native-seed/src/native/update-closure.bl -- \
;     DIR/partition.json [ADDITIONS.edn ...]
; Without ADDITIONS the declared set is every
; research/native-seed/speed/*/closure-additions.edn. Each file is a vector of
; {:ns "host.vector" :path "priv/host/vector.bl" :module :Elixir.BeamLisp.Vector}
; in dependency order; :module is given only for a pinned BL host module.
; Writes DIR/closure.etf, identity.json and update.json; then run
; partition-closure.py --out DIR. See research/native-seed/speed/closure/RESULT.md.
(ns native.update-closure
 (:require [native.artifact :as artifact] [js.build :as build] [bl.json :as json] [clojure.edn :as edn]))
(def argv (vec (BeamLisp/argv)))
(def path (or (first argv) "research/native-seed/out/compiler-closure/partition.json"))
(def out (Path/dirname path))
(def additions-files
 (if (> (count argv) 1) (subvec argv 1)
  (vec (sort (Path/wildcard "research/native-seed/speed/*/closure-additions.edn")))))
(def original (artifact/read-closure path))
(def expected-options {:target :scheme :contextual-bindings :absent
                       :stub ["lower"] :staging :canonical-js.build
                       :namespace-qualified? true})
(assert (= expected-options (:options original)))
; A closure is bound to the SDK whose compiler produced it. Under a new pin
; (RE-PIN) no unit may be reused: every member recompiles with the pinned
; compiler, the old macro-provider identity is not compared (nothing that
; expanded under it survives), and the closure is re-bound to the new pin.
(def pin (File/read! "research/native-seed/sdk-pin.json"))
(def repin? (not= (:sdk-pin original) pin))
(when repin? (println "NATIVE_UPDATE_REPIN every member recompiles under the new SDK pin"))
(def sdk-source (get (json/decode pin) "source"))

; --- declared additions -----------------------------------------------------
(defn read-additions [file]
 (let [rows (edn/read-string (File/read! file))]
  (when-not (vector? rows)
   (throw (ex-info "native update: closure additions must be a vector" {:file file})))
  (mapv (fn [row]
   (when-not (and (map? row) (string? (:ns row)) (string? (:path row))
                  (or (nil? (:module row)) (keyword? (:module row)))
                  (empty? (dissoc row :ns :path :module)) (File/regular? (:path row)))
    (throw (ex-info "native update: invalid closure addition" {:file file :row row})))
   (assoc row :file file)) rows)))
(def additions
 (let [rows (vec (mapcat read-additions additions-files))
       names (map :ns rows)]
  (when-not (= (count names) (count (distinct names)))
   (throw (ex-info "native update: a namespace is declared by two closure additions" {:namespaces names})))
  rows))
(def declared (set (map :ns additions)))
(def stubs (set (:stubs original)))
; A pinned BL host module `Elixir.BeamLisp.X` is compiled as the closure
; namespace host.x, and every :remote to it links to that namespace.
(def base-host-modules
 [["host.compiler-data" :Elixir.BeamLisp.CompilerData] ["host.form-meta" :Elixir.BeamLisp.FormMeta]
  ["host.meta" :Elixir.BeamLisp.Meta]])
(def host-modules
 (let [rows (vec (sort-by first (distinct (concat base-host-modules (:host-modules original)
                 (keep (fn [a] (when (:module a) [(:ns a) (:module a)])) additions)))))]
  (when-not (and (= (count rows) (count (distinct (map first rows))))
                 (= (count rows) (count (distinct (map second rows)))))
   (throw (ex-info "native update: a host module or namespace is declared twice" {:host-modules rows})))
  rows))
(defn check-host-module! [ns source module]
 ; The file must say what it is: its leading comment block declares a pinned
 ; host module and names this exact module in backticks (comments wrap).
 (let [header (String/replace (first (String/split source "\n(" (list (erlang/list_to_tuple (list :parts 2))))) "\n; " " ")]
 (when-not (and (String/contains? header "the pinned HOST MODULE for")
                (String/contains? header (str "`" (erlang/atom_to_binary module) "`")))
  (throw (ex-info (str "native update: host module declaration does not match its source header: " ns)
                  {:namespace ns :module module})))))

; --- compile ------------------------------------------------------------------
(def relink-profile
 (when (and (System/get_env "NATIVE_LINK_ROWS") (= "1" (System/get_env "NATIVE_RELINK_PROFILE")))
  (volatile! [])))
(defn profile-mark
 ([]
  [(erlang/monotonic_time :microsecond) (elem (erlang/process_info (erlang/self) :reductions) 1)])
 ([phase ns [start-us start-reductions]]
  (let [[now-us now-reductions :as next] (profile-mark)]
   (vswap! relink-profile conj
    {:phase phase :namespace ns :wall-us (- now-us start-us)
     :caller-reductions (- now-reductions start-reductions)})
   next)))
(defn compile-unit [ns source-path allowed]
 (BeamLisp.Compiler/with_fresh_names
  (fn []
   (let [start (when relink-profile (profile-mark))
         prepared (build/prepare-ns source-path)
         _ (when-not (= ns (:ns prepared))
             (throw (ex-info "native update: namespace header mismatch" {:namespace ns :path source-path :header (:ns prepared)})))
         _ (doseq [[dependency _] (:requires prepared)]
             (when-not (or (contains? allowed dependency) (contains? stubs dependency))
              (throw (ex-info "native update: added dependency requires explicit closure extension"
                              {:namespace ns :dependency dependency}))))
         staged (when start (profile-mark :member-stage ns start))
         ; The native checker is identity. Share declaration resolution for
         ; this lowering pass, then give the next member a fresh snapshot.
         compiled (BeamLisp.Loader/with_declaration_snapshot
                    (fn [] (dissoc (build/compile-prepared prepared {:check-node identity}) :cache-status :cache-key)))
         _ (when staged (profile-mark :member-lowering ns staged))
         unit (assoc compiled :source (:source prepared)
                     :module (BeamLisp.Link/module_for ns) :base-module (BeamLisp.Emit/base_module_for ns))]
    (BeamLisp.CompilerData/check_compiler_data! unit artifact/limits)
    unit))))
(defn insert-after-dependencies [order ns requires]
 ; Right after its last closure dependency (and never before rt/core/sugar).
 (let [anchors (set (concat ["rt" "core" "sugar"] requires))
       last-at (reduce (fn [at [i x]] (if (contains? anchors x) i at)) -1 (map-indexed vector order))]
  (vec (concat (take (inc last-at) order) [ns] (drop (inc last-at) order)))))
; --- providers ----------------------------------------------------------------
; A provider is read from where the pinned compile LOADS it: closure members
; and research/native-seed/src (on the -p path) from this checkout; every
; other priv/ source from the pinned SDK's immutable Source (sdk-pin.json).
(def members (set (concat (map :path (vals (:units original))) (map :path additions))))
(def sdk-prefix (str sdk-source "/"))
(defn checkout-origin? [p] (or (contains? members p) (String/starts_with? p "research/native-seed/src/")))
(def provider-paths
 (sort (distinct (concat members (Path/wildcard "research/native-seed/src/**/*.bl")
  (map #(subs % (count sdk-prefix))
       (mapcat #(Path/wildcard (str sdk-prefix % "/**/*.bl")) ["priv/boot" "priv/lib" "priv/std" "priv/compat"]))))))
(defn providers [prior]
 (let [previous (into {} (map (fn [p] [(:path p) p]) prior))]
  (mapv (fn [p]
   (let [origin (if (checkout-origin? p) "checkout" "sdk")
         location (if (= origin "checkout") p (str sdk-prefix p))
         source (File/read! location) sha (artifact/sha source) old (get previous p)]
    (if (= sha (:sha256 old)) (assoc old :origin origin)
     {:path p :sha256 sha :origin origin
      :macro-provider? (and (String/contains? source "defmacro")
                           (boolean (some build/defmacro? (build/read-forms location))))})))
   provider-paths)))
(def admitted (set (map :path additions)))
(defn macro-identity [ps]
 (vec (keep (fn [p] (when (and (:macro-provider? p) (not (contains? admitted (:path p)))) [(:path p) (:sha256 p)])) ps)))
(def current-providers (providers (:provider-sources original)))
(def macros (macro-identity current-providers))
(when-not (or repin? (= macros (macro-identity (:provider-sources original))))
 (throw (ex-info "native update: macro providers changed; capture a fresh closure"
                 {:now macros :captured (macro-identity (:provider-sources original))})))

; Link rows (LINK P3/N3): the native image installs the link row of every
; closure member before compiling anything. BEAM must compile against the SAME
; rows, or a member's calls to itself and to unloaded members link differently.
; The rows come from member-rows.bl over a previous pass's closure (a separate
; process: computing them needs native.bootstrap loaded, and recompiling the
; native.bootstrap member here replaces that module). An existing linked
; generation is reusable when the entire compilation context matches.
(def link-rows-path (System/get_env "NATIVE_LINK_ROWS"))
(def prior-link-rows-path (System/get_env "NATIVE_PRIOR_LINK_ROWS"))
(def relink-request (System/get_env "NATIVE_CHECKED_RELINK_REQUEST"))
(defn read-link-rows [path]
 (let [bytes (File/read! path)]
  (BeamLisp.CompilerData/check_closed_etf! bytes artifact/limits)
  {:sha256 (artifact/sha bytes) :rows (erlang/binary_to_term bytes)}))
(defn prior-link-rows []
 ; A retained sidecar is a candidate only. The exact linked-context digest
 ; from the checked closure must authenticate its decoded rows before use.
 (when (and prior-link-rows-path (:linked-context-sha256 original))
  (try (:rows (read-link-rows prior-link-rows-path)) (catch _ nil))))
(def linked-rows-input (when link-rows-path (read-link-rows link-rows-path)))
(def candidate-link-rows
 (if linked-rows-input (:rows linked-rows-input) (prior-link-rows)))
(def candidate-linked-context
 (when candidate-link-rows
  (artifact/sha (erlang/term_to_binary
   ["native-linked-closure-v2" pin expected-options current-providers additions
    (:order original) host-modules (:stubs original) (:core-links original) candidate-link-rows]
   (list :deterministic)))))
(def linked-reuse? (and candidate-linked-context (= candidate-linked-context (:linked-context-sha256 original))))
(def link-rows (when (or link-rows-path linked-reuse?) candidate-link-rows))
(def linked-context (when link-rows candidate-linked-context))
(when link-rows
 (println (str "NATIVE_UPDATE_LINK_ROWS " (count link-rows) " from " (or link-rows-path prior-link-rows-path))))
(def install-linked-rows? (and link-rows (not linked-reuse?)))
(def recompile-all? (or repin? install-linked-rows?))
(defn compile-closure []
 (BeamLisp.Env/isolated
  (fn []
   (when install-linked-rows?
    (doseq [[ns name info _] link-rows] (BeamLisp.Env/put_link ns name info)))
   ; With them, core's own rows exactly as native-install-bundle! installs
   ; :core-links (seeds included), so core calls link as they do natively.
   (when install-linked-rows?
    (doseq [[name info] (:core-links original)] (BeamLisp.Env/put_link "core" name info)))
   (let [existing
         (reduce (fn [result ns]
          (let [old (dissoc (get (:units original) ns) :cache-status :cache-key)
                source (File/read! (:path old)) sha (artifact/sha source)]
           (if (and (not recompile-all?) (= sha (:source-sha256 old)))
            (do (println (str "NATIVE_UPDATE_REUSED " ns)) (assoc-in result [:units ns] old))
            (let [_ (println (str "NATIVE_UPDATE_COMPILE " ns))
                  unit (compile-unit ns (:path old) (into (set (:order original)) declared))]
             (when-not (and (= (:module old) (:module unit)) (= (:base-module old) (:base-module unit)))
              (throw (ex-info "native update: physical namespace identity changed; explicit aliases required"
                              {:namespace ns :old [(:module old) (:base-module old)] :new [(:module unit) (:base-module unit)]})))
             (-> result (assoc-in [:units ns] unit) (update :changed conj ns))))))
          {:units {} :changed [] :added [] :order (:order original)} (:order original))]
    ; Additions in declared order; each may require only closure members,
    ; stubs and EARLIER additions. One already in the closure is a member.
    (reduce (fn [result a]
     (let [ns (:ns a)]
      (if (contains? (:units result) ns)
       (do (when-not (= (:path a) (get-in result [:units ns :path]))
            (throw (ex-info "native update: addition path differs from the closure member" {:namespace ns})))
           result)
       (let [_ (println (str "NATIVE_UPDATE_ADD " ns " " (:path a)))
             unit (compile-unit ns (:path a) (set (keys (:units result))))
             requires (map first (:requires unit))]
        (-> result (assoc-in [:units ns] unit) (update :added conj ns)
            (update :order insert-after-dependencies ns requires))))))
     existing additions)))))

(def checked-relink?
 (and relink-request link-rows-path install-linked-rows? (not repin?)
      (= host-modules (:host-modules original))
      (every? #(= (:path %) (get-in original [:units (:ns %) :path])) additions)))
(defn checked-closure []
 (let [observer "native.observe-links"
       request (json/decode (File/read! relink-request))
       start (when relink-profile (profile-mark))]
  (BeamLisp.Loader/with_load_path "research/native-seed/speed/front"
   (fn [] (BeamLisp.Loader/load_provider observer)))
  (when start (profile-mark :observer-load nil start))
  (let [result ((BeamLisp.Env/fetch_exact! observer "checked-update") original linked-rows-input request
                (when relink-profile profile-mark))
        allowed (into (set (:order original)) stubs)
        recompiled (set (:changed result))]
   (doseq [ns (:order original)]
    (let [unit (get-in result [:units ns])
          prior (get-in original [:units ns])]
     (when-not (= [ns (:path prior) (:module prior) (:base-module prior)]
                  [(:ns unit) (:path unit) (:module unit) (:base-module unit)])
      (throw (ex-info "native update: checked relink changed member identity" {:namespace ns})))
     (doseq [[dependency _] (:requires unit)]
      (when-not (contains? allowed dependency)
       (throw (ex-info "native update: added dependency requires explicit closure extension"
                       {:namespace ns :dependency dependency}))))
     (when (contains? recompiled ns)
      (BeamLisp.CompilerData/check_compiler_data! unit artifact/limits))))
   result)))

(def result (if checked-relink? (checked-closure) (compile-closure)))
(def order (:order result))
; Order check: every closure dependency of a unit precedes it.
(let [at (into {} (map-indexed (fn [i ns] [ns i]) order))]
 (doseq [ns order [dependency _] (:requires (get (:units result) ns))
         :when (and (contains? declared dependency) (contains? at dependency))]
  (when-not (< (get at dependency) (get at ns))
   (throw (ex-info "native update: a closure member requires an addition placed after it"
                   {:namespace ns :dependency dependency})))))
(doseq [[ns module] host-modules]
 (let [u (or (get (:units result) ns)
             (throw (ex-info "native update: declared host module namespace is not a closure member" {:namespace ns})))]
  (check-host-module! ns (:source u) module)))

(def final-providers (providers current-providers))
(assert (= current-providers final-providers))
(doseq [[ns u] (:units result)]
 (assert (= (:source-sha256 u) (artifact/sha (:source u))))
 (assert (= (:source-sha256 u) (artifact/sha (File/read! (:path u))))))
(def closure
 (let [next (assoc original :units (:units result) :order order :provider-sources final-providers
                            :host-modules host-modules :sdk-pin pin)]
  (cond
   (and linked-context (empty? (:added result))) (assoc next :linked-context-sha256 linked-context)
   (and (empty? (:changed result)) (empty? (:added result))
        (= current-providers (:provider-sources original))) next
   :else (dissoc next :linked-context-sha256))))
(def bytes (erlang/term_to_binary closure (list :deterministic)))
(File/write! (str out "/closure.etf") bytes)
(File/write! (str out "/identity.json")
 (json/encode {:schema "bl.native.compiler-closure-identity" :version 1
               :artifact-sha256 (artifact/sha bytes) :sdk-pin-sha256 (artifact/sha (:sdk-pin closure))
               :options (:options closure) :providers final-providers}))
(File/write! (str out "/update.json")
 (json/encode (cond-> {:schema "bl.native.closure-update" :version 2 :changed (:changed result) :added (:added result)
               :linked-context-reused (boolean linked-reuse?)
               :additions-files additions-files
               :host-modules (mapv (fn [[ns module]] [ns (erlang/atom_to_binary module)]) host-modules)
               :artifact-sha256 (artifact/sha bytes)
               :units (mapv (fn [ns] (let [u (get (:units closure) ns)]
                       {:namespace ns :source-sha256 (:source-sha256 u) :definitions (count (:defs u))})) order)}
               relink-profile (assoc :phase-profile @relink-profile)
               checked-relink? (assoc :checked-relink
                                {:receipt-sha256 (:receipt-sha256 result)
                                 :candidate-link-rows-sha256 (:candidate-link-rows-sha256 result)
                                 :preparation-us (:preparation-us result)
                                 :interpreted-expansions (:interpreted-expansions result)
                                 :members (mapv #(select-keys % [:namespace :reused :reason]) (:members result))}))))
(println (str "NATIVE_UPDATED " (count (:changed result)) " changed, " (count (:added result)) " added, "
              (count order) " units; no full ANF walk"))
