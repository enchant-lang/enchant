; Closed compiler self-emission. The ORIGINAL bootstrap.prepare algorithm owns
; reading, macro expansion and compilation; this module only selects C units.
; native.bootstrap never requires this module: the host routes --compile-c.
(ns native.c-bootstrap
 (:require [native.bootstrap :as bootstrap] [native.c-units :as units]))
(defn compile-bundle [bundle host-source host-ledger output]
 (bootstrap/install-source-macros! bundle)
 (let [prepared (mapv bootstrap/prepare (:units bundle))]
  (units/write-plan! prepared (bootstrap/data (dissoc bundle :units)) host-source host-ledger
   {:write (fn [path text] (host/write-file path text))
    :mkdir (fn [path] (host/native-c-mkdir path))
    :digest (fn [text] (host/native-c-sha256 text))}
   output "(native-main (native-command-line))\n")))
(defn main [args]
 (if (and (= 5 (count args)) (= "--compile-c" (first args)))
  (let [bundle (host/eval-scheme (host/read-file (nth args 1)))
        host-source (host/read-file (nth args 2))
        host-ledger (host/eval-scheme (host/read-file (nth args 3)))
        plan (compile-bundle bundle host-source host-ledger (nth args 4))]
   (println (str "NATIVE_DIRECT_SELF_EMISSION " (count (:units plan)) " bounded units")))
  (throw (ex-info "usage: native-compiler --compile-c bundle.scm host.scm host.components.scm output-directory" {:args args}))))
