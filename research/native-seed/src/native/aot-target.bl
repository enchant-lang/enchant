; A late target for the existing AOT constructor and unit-store. Compilation,
; Source freshness, phase identity and reuse stay with those existing owners.
(ns native.aot-target
 (:require [unit-store :as store] [artifact-process :as process]
           [native.aot-scheme :as emitter] [native.specialization :as specialization] [bl.json :as json]))

(defn sha [bytes]
 (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower))))
(defn selection-key [selection]
 (sha (erlang/term_to_binary selection (list :deterministic))))
(defn- identity-row [role path] {"role" role "path" (Path/expand path)})

(defn code-inputs [prototype sdk]
 ; Bind the complete small prototype Source inventory conservatively. The
 ; immutable SDK descriptor selects its dependency/Source closure as a whole.
 (vec (concat
  [(identity-row "clang-driver" "/nix/store/jmgw1yz3xm3bpgrk9r84jkcynskdbd40-clang-21.1.8/bin/clang-21")
   (identity-row "clang-cpp" "/nix/store/adr7l6vazpqqjy2wab0v27pzp17c4sq6-clang-21.1.8-lib/lib/libclang-cpp.so.21.1")
   (identity-row "clang-core" "/nix/store/kwbs82a1v1hy20plq2pjchaa0z85zy8w-llvm-21.1.8-lib/lib/libLLVM.so.21.1")
   (identity-row "emitter/sdk-selection" (Path/join sdk "artifact.json"))
   (identity-row "host-abi/qualified-host" (Path/join prototype "out/compiler-native-owner/host.scm"))
   (identity-row "host-abi/qualified-leaves" (Path/join prototype "out/compiler-native-owner/leaves.json"))
   (identity-row "host-abi/host.scm" (Path/join prototype "host.scm"))]
  (map (fn [path] (identity-row (str "emitter/" (Path/relative_to path prototype)) path))
       (sort (Path/wildcard (Path/join prototype "src/native/*.bl"))))
  (map (fn [path] (identity-row (str "host-abi/" (Path/relative_to path prototype)) path))
       (sort (Path/wildcard (Path/join prototype "host/*")))))))

(defn- invoke-tool! [options method request]
 (let [job (str method "-" (System/unique_integer (list :positive)))
       input (Path/join (:observations options) (str job "-request.json"))
       output (Path/join (:observations options) (str job "-result.json"))]
  (File/mkdir_p! (:observations options))
  (File/write! input (json/encode request))
  (let [result (process/run (:python options)
                [(Path/join (:prototype options) "native_module.py") method input output]
                {:timeout-ms 250000 :limit 16384})]
   (when-not (process/ok? result)
    (throw (ex-info "Scheme target tool failed" {:method method :result result :observation output})))
   (when (> (:size (File/stat! output)) 1048576)
    (throw (ex-info "Scheme target observation exceeds its bound" {})))
   ; Target identity is plain first-order compiler DATA. Keep JSON arrays as
   ; proper host lists here; language Vector structs are not identity tokens.
   (let [data (Jason/decode! (File/read! output))]
    (when (= "failed" (get data "status"))
     (throw (ex-info "Scheme target tool refused" {:method method :observation output})))
    data))))

(defn adapter
 "Fixed Scheme emitter + object transport. The caller runs under its existing
  bounded artifact service. This creates no workspace, cache or session owner."
 [options]
 (let [mode (get options :emission-mode :reference)
       _ (when-not (contains? specialization/modes mode)
           (throw (ex-info "Unsupported native emission mode" {:mode mode})))
       prototype (Path/expand (:prototype options))
       sdk (System/fetch_env! "BL_SDK_PRODUCT")
       options (assoc options :prototype prototype)
       request {"schema" "bl.native.scheme-tool-request" "version" 1
                "toolchain" (Path/join prototype "toolchain-pin.json")
                "standard_bindings" false "code_inputs" (code-inputs prototype sdk)}
       identity (get (invoke-tool! options "identity" request) "identity")
       abi-ledger (json/decode (File/read! (Path/join prototype "out/compiler-native-owner/leaves.json")))
       host-external (set (get abi-ledger "registered_leaves"))
       dependency-inputs (or (:dependencies options) [])
       _ (when-not (and (vector? dependency-inputs) (<= (count dependency-inputs) 16))
           (throw (ex-info "Scheme dependencies require bounded original artifact selections"
                           {:kind :invalid-native-dependencies})))
       ; Dependency bytes use this SAME fixed target verifier with its host-only
       ; identity. It reads actual receipt/Source/exports membership, not caller
       ; nominated MFAs. This first linkage slice accepts leaf dependencies only.
       dependency-target (when (seq dependency-inputs) (adapter (dissoc options :dependencies)))
       capture-dependencies
       (fn []
        (mapv
         (fn [row]
          (let [selection (:selection row) directory (:directory row)
                _ (when-not (and (= #{:selection :directory} (set (keys row)))
                                 (string? directory)
                                 (= (:identity dependency-target) (:target selection)))
                    (throw (ex-info "Scheme dependency target selection changed"
                                    {:kind :invalid-native-dependency-selection})))
                verified ((:verify! dependency-target) directory selection)
                provided (get (:exports verified) "provided-mfas")]
           (when-not (and (sequential? provided) (seq provided) (<= (count provided) 65536)
                         (every? #(and (string? %) (<= (count %) 1024)) provided))
            (throw (ex-info "Scheme dependency lacks exact emitted MFA metadata"
                            {:kind :native-dependency-exports-required})))
           {"selection_key" (selection-key selection)
            "exports_sha256" (sha (File/read! (Path/join directory "exports.json")))
            "provided_mfas" (to-list (sort provided))})) dependency-inputs))
       dependencies (capture-dependencies)
       external (into host-external (mapcat #(get % "provided_mfas") dependencies))
       check-dependencies! (fn []
                            (when-not (= dependencies (capture-dependencies))
                             (throw (ex-info "Scheme dependency artifact changed"
                                             {:kind :native-dependency-changed}))))
       _ (when-not (and (seq host-external) (every? string? host-external))
           (throw (ex-info "Scheme target requires the exact retained host ABI ledger" {})))
       ; This exact qualified compiler host predates the optional Source-frame
       ; addon. Keep original ANF attribution without emitting unavailable ABI.
       emit-options {:source-frames? false :external-mfas external :emission-mode mode}
       target-identity {"kind" "bl-aot-gambit-c" "version" 1 "tools" identity
                        "source_frames" false "emission_mode" (name mode) "external_mfas" (to-list (sort external))}
       target-identity (if (seq dependencies) (assoc target-identity "dependencies" (to-list dependencies)) target-identity)]
  {:identity target-identity
   :emit! (fn [prepared directory selection]
    (check-dependencies!)
    (let [key (selection-key selection)
          emitted (emitter/emit-prepared prepared (assoc emit-options :unit-id key))
          source (Path/join directory "unit.scm")
          exports (json/encode {:exports (:exports emitted) :initializer (:initializer emitted)
                                 :namespaces (:namespaces emitted) :unit-id (:unit-id emitted)
                                 :provided-mfas (:provided-mfas emitted)
                                 :emission-mode (:emission-mode emitted) :emission-counts (:emission-counts emitted)
                                 :primitive-check (:primitive-check emitted) :primitive-mfas (:primitive-mfas emitted)})]
     (File/write! source (:scheme emitted))
     (File/write! (Path/join directory "exports.json") exports)
     (invoke-tool! options "build"
      (merge request {"expected_identity" identity "selection_key" key
       "source" {"path" source "sha256" (sha (:scheme emitted))}
       "out" directory "cache" (:object-cache options)}))
     (File/write! (Path/join directory "scheme-unit.term")
      (erlang/term_to_binary {:selection selection :scheme-sha256 (sha (:scheme emitted))
                             :exports-sha256 (sha exports)} (list :deterministic)))))
   :verify! (fn [directory selection]
    (check-dependencies!)
    (let [key (selection-key selection)
          source (File/read! (Path/join directory "unit.scm"))
          exports (File/read! (Path/join directory "exports.json"))
          expected (erlang/term_to_binary
                    {:selection selection :scheme-sha256 (sha source) :exports-sha256 (sha exports)}
                    (list :deterministic))
          _ (when-not (= expected (File/read! (Path/join directory "scheme-unit.term")))
              (throw (ex-info "Scheme target Source/export selection changed" {:kind :scheme-artifact-changed})))
          result (invoke-tool! options "verify"
                   (merge request {"expected_identity" identity "selection_key" key
                    "receipt" (Path/join directory "native-module.json")}))
          receipt (json/decode (File/read! (Path/join directory "native-module.json")))
          members (into #{"unit.scm" "exports.json" "scheme-unit.term" "native-module.json"}
                     (map #(get % "file") (vals (get receipt "artifacts"))))
          observed (set (File/ls! directory))]
     (when-not (and (= (sha source) (get receipt "source_sha256"))
                    (or (= members observed) (= (conj members "target-artifact.term") observed)))
      (throw (ex-info "Scheme target product membership changed" {:kind :scheme-artifact-changed})))
     {:manifest {:selection selection :members members}
      :native-admission false :directory directory :transport result
      :exports (json/decode exports)}))}))

(defn artifact! [prepared directory previous options]
 (store/artifact-target! prepared directory previous (adapter options)))
