; One versioned, opt-in emission policy. These are existing pinned host leaves,
; never new BL implementations. Source providers remain live remote calls.
(ns native.specialization)
(def modes #{:reference :specialize-v1})
(def primitives
 #{"erlang/is_integer/1" "erlang/is_atom/1" "erlang/is_binary/1"
   "erlang/is_float/1" "erlang/is_number/1" "erlang/is_boolean/1"
   "erlang/is_tuple/1" "erlang/is_list/1" "erlang/is_map/1"
   "erlang/=:=/2" "erlang/=/=/2" "erlang/==/2" "erlang//=/2"
   "erlang/</2" "erlang/=</2" "erlang/>/2" "erlang/>=/2"
   "erlang/+/2" "erlang/-/2" "erlang/*/2" "erlang/div/2" "erlang/rem/2"
   "erlang/element/2" "erlang/tuple_size/1" "erlang/tuple_to_list/1"
   "erlang/list_to_tuple/1" "erlang/hd/1" "erlang/tl/1" "erlang/length/1"
   "erlang/map_get/2" "erlang/map_size/1" "erlang/is_map_key/2"
   "erlang/byte_size/1" "erlang/binary_part/3"
   "maps/get/2" "maps/get/3" "maps/find/2" "maps/is_key/2" "maps/put/3"
   "maps/remove/2" "maps/size/1" "maps/to_list/1" "maps/from_list/1"
   "lists/reverse/1" "lists/reverse/2" "lists/nth/2" "lists/nthtail/2"})
