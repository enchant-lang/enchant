; Bounded direct-C packaging. Only the actual emitter owns program control.
; IO/hash callbacks let SDK replay and a native compiler share this formatter.
(ns native.c-units
 (:require [native.c :as c] [native.c-remote :as remote] [native.eval :as ev]
           [native.bootstrap :as bootstrap] [native.scheme :as scalar]
           [clojure.string :as string]))
(def group-size 32)
(defn unit-name [index]
 (when (>= index 10000) (throw (ex-info "direct C unit index exceeds fixed ASCII naming bound" {})))
 (loop [digits (str index)]
  (if (< (count digits) 4) (recur (str "0" digits)) (str "u" digits))))
(defn unit-definitions [unit]
 (BeamLisp.CompilerData/eager_map
  (fn [definition] (assoc definition :ns (:ns unit) :path (:path unit))) (:defs unit)))
(defn phases [units]
 (list
  {:phase "functions"
   :definitions (BeamLisp.CompilerData/eager_mapcat
    (fn [unit] (BeamLisp.CompilerData/eager_filter #(= :fn (:kind %)) (unit-definitions unit))) units)}
  {:phase "initializers"
   :definitions (BeamLisp.CompilerData/eager_mapcat
    (fn [unit]
     (erlang/++
      (if (= "core" (:ns unit))
       (list {:ns "core" :path (:path unit) :name nil :kind :expr
              :node (c/internal "(lambda () (bl-invoke (native-global \"rt\" \"seed-core\") '()))" [])})
       (list))
      (BeamLisp.CompilerData/eager_filter #(not= :fn (:kind %)) (unit-definitions unit)))) units)}))
(defn next-group [definitions]
 (loop [left group-size todo definitions out (list)]
  (if (or (= left 0) (erlang/== todo (list))) [(lists/reverse out) todo]
   (recur (dec left) (erlang/tl todo) (cons (erlang/hd todo) out)))))
(defn tab-row [fields] (str (string/join "\t" fields) "\n"))
(defn definition-record [definition digest]
 (let [binding [(:ns definition) (:name definition) (:kind definition) (boolean (:private? definition))]]
  {:namespace (:ns definition) :name (:name definition) :kind (:kind definition)
   :private? (boolean (:private? definition))
   :binding-sha256 (digest (bootstrap/data binding))
   :body-sha256 (digest (bootstrap/data (:node definition)))}))
(defn emit-named-group! [name definitions phase io out options]
 (let [write (:write io) digest (:digest io)
       emitted (c/emit-definitions definitions (assoc options :unit-name (str "direct_" name)))
       _ (when-not (= 2 (:action-abi (:manifest emitted)))
           (throw (ex-info "direct C emitted unit requires action ABI2" {})))
       c-file (str name ".c") ffi-file (str name ".scm")
       c-sha (digest (:c-source emitted)) ffi-sha (digest (:wrapper-source emitted))
       records (mapv #(definition-record % digest) definitions)
       count (count records) records-sha (digest (bootstrap/data records))]
  (write (str out "/" c-file) (:c-source emitted))
  ; c-declare and c-lambda stay in ONE translation unit. No authored body is
  ; handed to native.scheme; this file is only C FFI and managed literal roots.
  (write (str out "/" ffi-file) (:wrapper-source emitted))
  {:record {:name name :phase phase :definition-count count :definitions records
            :definitions-sha256 records-sha
            :c {:path c-file :sha256 c-sha} :ffi {:path ffi-file :sha256 ffi-sha}
            :emission (select-keys (:manifest emitted)
              [:unit-name :action-abi :pure-bif-abi :pure-bif-mask :slot-calls :generic-calls
               :blocks :functions :root-slots :literals :program-control :value-services])}
   :index (str (tab-row ["U" phase name c-file c-sha ffi-file ffi-sha (str count) records-sha])
             (string/join "" (map-indexed (fn [ordinal record]
              (tab-row ["D" name (str ordinal) (:body-sha256 record) (:binding-sha256 record)])) records)))}))
(defn emit-group! [definitions phase index io out]
 (emit-named-group! (unit-name index) definitions phase io out (remote/options (ev/context "user"))))
(defn emit-groups! [units io out]
 (loop [phases (phases units) todo (list) phase nil index 0 records [] rows []]
  (cond
   (not (erlang/== todo (list)))
    (let [[group more] (next-group todo) emitted (emit-group! group phase index io out)]
     (recur phases more phase (inc index) (conj records (:record emitted)) (conj rows (:index emitted))))
   (not (erlang/== phases (list)))
    (let [next (erlang/hd phases)]
     (recur (erlang/tl phases) (:definitions next) (:phase next) index records rows))
   :else {:units records :rows rows})))
(defn assembly-source [metadata-source units entry-source]
 (str ";; Direct C compiler: relative link entries; unit root is explicit.\n"
  "(define native-direct-unit-root (getenv \"BL_NATIVE_C_UNIT_ROOT\" #f))\n"
  "(if (not native-direct-unit-root) (error \"BL_NATIVE_C_UNIT_ROOT is required\"))\n"
  "(load (string-append native-direct-unit-root \"/host.o1\"))\n"
  "(native-c-require-action-abi! 2)\n"
  "(native-install-bundle! " metadata-source ")\n"
  "(set! native-c-backend (bl-key \"c\"))\n"
  (string/join "" (map (fn [unit]
   (str "(load (string-append native-direct-unit-root " (scalar/text (str "/" (:name unit) ".o1")) "))\n")) units))
  entry-source))
(defn write-plan!
 "Stream <=32-definition C/FFI units; retain only names, body hashes and stats.
  metadata-source is existing bootstrap/data-owned data, never source parsing.
  host-ledger is also owned DATA. No absolute output path enters any artifact."
 [units metadata-source host-source host-ledger io out entry-source]
 (let [write (:write io) digest (:digest io)
       _ (when-not (and (= "bl.native.direct-host" (:schema host-ledger)) (= 1 (:version host-ledger))
                       (= 2 (:action-abi host-ledger))
                       (= ["frozen-host" "direct-machine" "source-control-frames" "shared-raw-function" "deferred-static-mfa"
                           "external-function-peeling" "dynamic-loader" "clang-loader" "unit-host-services" "late-compiler-router"
                           "pinned-compiler-configuration"] (mapv :role (:components host-ledger))))
           (throw (ex-info "direct C host component order is not the admitted stack" {})))
       _ (when-not (= entry-source "(native-main (native-command-line))\n")
           (throw (ex-info "direct C closed compiler requires its exact command-line entry" {})))
       _ (when-not (= (:source-sha256 host-ledger) (digest host-source))
           (throw (ex-info "direct C host ledger/source identity mismatch" {})))
       _ ((:mkdir io) out)
       _ (write (str out "/host.scm") host-source)
       _ (write (str out "/metadata.scm") metadata-source)
       _ (write (str out "/entry.scm") entry-source)
       emitted (emit-groups! units io out)
       assembly (assembly-source metadata-source (:units emitted) entry-source)
       _ (write (str out "/assembly.scm") assembly)
       source-records (mapv (fn [unit]
        {:namespace (:ns unit) :path (:path unit) :sha256 (digest (:source unit))}) units)
       index-core
        (str "BL_NATIVE_DIRECT_UNITS\t1\t32\nB\t2\n"
         (tab-row ["H" "host.scm" (digest host-source) (digest (bootstrap/data host-ledger))])
         (tab-row ["M" "metadata.scm" (digest metadata-source)])
         (tab-row ["E" "entry.scm" (digest entry-source)])
         (tab-row ["A" "assembly.scm" (digest assembly)])
         (string/join "" (map-indexed (fn [index record]
          (tab-row ["S" (str index) (:sha256 record) (digest (bootstrap/data [(:namespace record) (:path record)]))])) source-records))
         (string/join "" (:rows emitted)))
       manifest {:schema "bl.native.direct-compiler-units" :version 1 :action-abi 2 :status :emitted-not-executed
                 :group-size group-size :host host-ledger :sources source-records
                 :metadata-sha256 (digest metadata-source) :entry-source entry-source
                 :index-core-sha256 (digest index-core) :assembly-sha256 (digest assembly)
                 :load-order (vec (concat ["host.o1" "bundle-metadata-once"]
                                  (map #(str (:name %) ".o1") (:units emitted)) ["entry"]))
                 :units (:units emitted) :source-interpreter false :authored-scheme-bodies false
                 :actor-resolver :deferred :independent-runtime false}
       manifest-source (bootstrap/data manifest)]
  (write (str out "/plan.manifest.scm") manifest-source)
  (write (str out "/index.tsv")
   (str index-core (tab-row ["P" "plan.manifest.scm" (digest manifest-source)])))
  manifest))
