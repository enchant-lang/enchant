; Bounded replay jobs. Use the SAME warm VM for plan, emit N, and assemble.
; Each job emits canonical ANF; this utility never compiles BL source.
; Linking is NOT implemented here: native.bootstrap's link plan and
; emit-definition are the one implementation, shared with the native
; self-emission (bootstrap --compile). See speed/closure/RESULT.md.
(ns native.chunks
 (:require [native.artifact :as artifact] [native.fragments :as fragments] [native.bootstrap :as bootstrap]
           [bl.json :as json] [clojure.string :as string] [anf]
           [native.resolution-ledger :as ledger]))
(def args (BeamLisp/argv))
(def mode (or (nth args 0 nil) "plan"))
(def artifact-path (or (nth args 1 nil) "research/native-seed/out/compiler-closure/partition.json"))
(def host-path (or (nth args 2 nil) "research/native-seed/out/compiler-closure/host.scm"))
(def out (or (nth args 3 nil) "research/native-seed/out/compiler-closure"))
(def leaves-path (or (nth args 4 nil) (str out "/leaves.json")))
(def host-source (File/read! host-path))
(def closure (artifact/read-closure artifact-path))
(def manifest (json/decode (File/read! artifact-path)))
(def units (mapv #(get (:units closure) %) (:order closure)))
(doseq [u units] (assert (= (:source-sha256 u) (artifact/sha (File/read! (:path u))))))
(def leaves (set (get (json/decode (File/read! leaves-path)) "registered_leaves")))
; The bundle metadata (written into bundle.scm) and the link plan built from
; it: exactly what bootstrap --compile rebuilds from bundle.scm natively.
(def metadata (ledger/bundle-metadata closure leaves))
(def link-plan (bootstrap/link-plan metadata units))
(def key-input
 {"artifact_sha256" (get manifest "artifact_sha256")
  "sdk_descriptor_sha256" (:sdk-descriptor-sha256 artifact/validation-context)
  "abi_sha256" (artifact/sha (File/read! leaves-path))
  "host_sha256" (artifact/sha host-source)
  "emitter_sha256" (artifact/sha (File/read! "research/native-seed/src/native/scheme.bl"))
  "eval_sha256" (artifact/sha (File/read! "research/native-seed/src/native/eval.bl"))
  "bootstrap_sha256" (artifact/sha (File/read! "research/native-seed/src/native/bootstrap.bl"))
  "fragments_sha256" (artifact/sha (File/read! "research/native-seed/src/native/fragments.bl"))
  "driver_sha256" (artifact/sha (File/read! "research/native-seed/src/native/chunks.bl"))
  "resolution_sha256" (artifact/sha (File/read! "research/native-seed/src/native/resolution.bl"))
  "resolution_ledger_sha256" (artifact/sha (File/read! "research/native-seed/src/native/resolution-ledger.bl"))
  "intrinsics_sha256" (artifact/sha (File/read! "research/native-seed/src/native/intrinsics.bl"))
  "options_sha256" (artifact/sha (erlang/term_to_binary (:options closure) (list :deterministic)))})
(def emission-input
 (assoc (select-keys key-input ["sdk_descriptor_sha256" "emitter_sha256" "eval_sha256" "fragments_sha256"
                              "bootstrap_sha256" "options_sha256" "driver_sha256" "resolution_sha256"
                              "resolution_ledger_sha256" "intrinsics_sha256"])
        ; v2: a compiled target wins over a leaf of the same key, and pinned
        ; host modules (metadata :host-modules) link to their namespace.
        "sealed" (:sealed? link-plan)
        "resolver_policy" "native-aot-link-v2"))
(defn decisions-for [ns definition]
 ; A finite syntax walk, not an evaluator. Use only raw proper-list append;
 ; no LazySeq/mapcat chains enter the cache identity or traversal worklist.
 ; A call site's emitted shape depends on its TARGET's kind and declared
 ; arities, so each compiled decision carries that shape.
 (loop [todo (list (:node definition)) decisions #{}]
  (if (erlang/== todo (list)) (vec (sort-by str decisions))
   (let [node (erlang/hd todo)
         decision (case (:op node)
                   :remote (bootstrap/remote-decision link-plan node ns)
                   :global (let [selected (bootstrap/global-decision link-plan node)
                                  target [(nth selected 5) (nth selected 6)]
                                  arities (get (:arities link-plan) target)]
                              [selected (:fixed arities) (:variadic arities)])
                   nil)]
    (recur (lists/append (anf/executable-children node) (erlang/tl todo))
           (if decision (conj decisions decision) decisions))))))
(defn dead-leaves
 "Registered host leaves whose key now links to a compiled closure definition
  (compiled wins). Their owning workstream deletes them."
 []
 (vec (sort (filter (fn [key]
   (let [i (string/index-of key "/") j (string/last-index-of key "/")]
    (and (some? i) (< i j)
         (some? (bootstrap/compiled-target link-plan (erlang/binary_to_atom (subs key 0 i)) (subs key (inc i) j))))))
  leaves))))
(defn report-dead-leaves! []
 (let [dead (dead-leaves)]
  (File/mkdir_p! out)
  (File/write! (str out "/dead-leaves.json")
   (json/encode {"schema" "bl.native.dead-leaves" "version" 1 "leaves" dead
                 "host_modules" (mapv (fn [[ns module]] [ns (erlang/atom_to_binary module)]) (:host-modules metadata))}))
  (doseq [key dead] (println (str "NATIVE_DEAD_LEAF " key)))
  (println (str "NATIVE_DEAD_LEAVES " (count dead)))))
(def fragment-contract (fragments/digest emission-input))
(def core-prefix (delay (bootstrap/emit-initializers link-plan {:ns "core"} [] true)))
(defn emission-record [row]
 (let [u (get (:units closure) (get row "namespace")) offset (get row "offset")
       defs (subvec (:defs u) offset (+ offset (get row "count")))]
  {"row" (select-keys row ["namespace" "offset" "count"])
   "definition_keys" (mapv #(fragments/digest [fragment-contract (:ns u) % (decisions-for (:ns u) %)]) defs)
   "seed_sha256" (when (and (= 0 offset) (= "core" (:ns u))) (artifact/sha @core-prefix))
   "source_unit_sha256" (when (= offset 0)
     (artifact/sha (erlang/term_to_binary (select-keys u [:ns :path :source :requires :module :base-module]) (list :deterministic))))}))
(defn key-from-record [record]
 (artifact/sha (erlang/term_to_binary [emission-input record] (list :deterministic))))
(defn chunk-path [key extension] (str out "/chunks/" key "." extension))
(defn row-layout [size]
 (vec (mapcat (fn [u]
   (map (fn [offset] {"namespace" (:ns u) "offset" offset "count" (min size (- (count (:defs u)) offset))})
        (map #(* size %) (range (erlang/div (+ (count (:defs u)) (- size 1)) size))))) units)))
(defn make-plan [size]
 {"schema" "bl.native.chunk-plan" "version" 2 "inputs" emission-input "assembly_inputs" key-input "size" size
  "chunks" (mapv (fn [row]
              (let [record (emission-record row)]
               (assoc row "key" (key-from-record record) "emission_record" record))) (row-layout size))})
(defn read-plan []
 (let [plan (json/decode (File/read! (str out "/chunks.json")))]
  (assert (= "bl.native.chunk-plan" (get plan "schema")))
  (assert (= 2 (get plan "version")))
  (assert (= emission-input (get plan "inputs")))
  (assert (= (mapv #(select-keys % ["namespace" "offset" "count"]) (get plan "chunks"))
             (row-layout (get plan "size"))))
  ; Exactly one current IR/signature record per row. Never rebuild an entire
  ; plan merely to compare it, and never walk a row again for its key.
  (doseq [row (get plan "chunks")]
   (let [record (emission-record row)]
    (assert (= record (get row "emission_record")))
    (assert (= (key-from-record record) (get row "key")))))
  plan))
(defn checked-chunk-text [path digest]
 (let [text (File/read! path)]
  (assert (= (artifact/sha text) digest))
  text))
(defn checked-chunk [row]
 (let [key (get row "key") report (json/decode (File/read! (chunk-path key "json")))]
  (assert (= key (get report "key")))
  (assert (= emission-input (get report "emission_inputs")))
  (assert (= (get row "emission_record") (get report "emission_record")))
  {:functions (checked-chunk-text (chunk-path key "functions.scm") (get report "functions_sha256"))
   :initializers (checked-chunk-text (chunk-path key "initializers.scm") (get report "initializers_sha256"))
   :source (when (= 0 (get row "offset"))
             (checked-chunk-text (chunk-path key "source-unit.scm") (get report "source_unit_sha256")))}))
(defn ready-chunk [row]
 (try (checked-chunk row) (catch _ nil)))
(defn- emission-record-to-write [row]
 (let [saved (get row "emission_record") key (get row "key")]
  (if (= key (key-from-record saved)) saved
   ;; Public JSON preserves decision values but can change their ETF
   ;; representations. Reconstruct only the missing row before emitting it.
   (let [current (emission-record row)]
    (assert (= saved current))
    (assert (= key (key-from-record current)))
    current))))
(def fragment-store (delay (fragments/open (str out "/definitions"))))
(defn- definition-text [u pair]
 (let [[d key] pair]
  (fragments/emit @fragment-store key
                 (fn [] (bootstrap/emit-definition link-plan u d)))))
(defn emit-chunk! [row]
 (let [key (get row "key") u (get (:units closure) (get row "namespace"))
       offset (get row "offset") count* (get row "count")
       record (emission-record-to-write row)
       defs (subvec (:defs u) offset (+ offset count*))
       members (mapv vector defs (get record "definition_keys"))
       function? (fn [pair] (= :fn (:kind (first pair))))
       functions (string/join "" (map #(definition-text u %) (filter function? members)))
       initializers (str (when (and (= 0 offset) (= "core" (:ns u))) @core-prefix)
                        (string/join "" (map #(definition-text u %) (remove function? members))))
       source-unit (when (= offset 0) (bootstrap/data (select-keys u [:ns :path :source :requires :module :base-module])))
       report {"key" key "emission_inputs" emission-input "emission_record" record
               "functions_sha256" (artifact/sha functions) "initializers_sha256" (artifact/sha initializers)
               "source_unit_sha256" (when source-unit (artifact/sha source-unit))}]
  (File/write! (chunk-path key "functions.scm") functions)
  (File/write! (chunk-path key "initializers.scm") initializers)
  ; Keep the source fragment with the content key that covers it so an edit
  ; and its reversal can each reuse their complete chunk.
  (when source-unit (File/write! (chunk-path key "source-unit.scm") source-unit))
  (File/write! (chunk-path key "json") (json/encode report))
  (println (str "NATIVE_CHUNK " (:ns u) " " offset " " count* " " key))))
(defn ensure-plan! []
 (let [path (str out "/chunks.json")
       previous-text (when (File/regular? path) (try (File/read! path) (catch _ nil)))
       previous (when previous-text (try (json/decode previous-text) (catch _ nil)))
       requested (not-empty (nth args 5 nil))
       size (if requested (String/to_integer requested)
               (let [prior-size (get previous "size")]
                (if (and (integer? prior-size) (<= 1 prior-size 128)) prior-size 32)))
       _ (assert (<= 1 size 128))
       ; Construct and validate every current IR/signature record exactly
       ; once. Existing files are reused only after this current plan proves
       ; complete coverage and all referenced capabilities again.
       current (make-plan size)
       same? (= previous current)
       text (if same? previous-text (json/encode current))]
  (File/mkdir_p! (str out "/chunks"))
  (when-not same?
   (when (File/regular? (str out "/chunk-export.json")) (File/rm! (str out "/chunk-export.json")))
   (File/write! path text)
   (println (str "NATIVE_CHUNK_PLAN " (count (get current "chunks")) " jobs"))
   (report-dead-leaves!))
  [current (artifact/sha text)]))

(defn resume-plan [expected]
 ; The driver obtains this digest from a successful earlier window of the
 ; same request. A plan on disk alone never grants reuse. Each new process
 ; still checks current assembly inputs and the persisted chunk bytes.
 (when (seq expected)
  (try
   (let [text (File/read! (str out "/chunks.json"))]
    (when (= expected (artifact/sha text))
     (let [plan (json/decode text)
           size (get plan "size")
           requested (not-empty (nth args 5 nil))]
      (when (and (= "bl.native.chunk-plan" (get plan "schema"))
                 (= 2 (get plan "version"))
                 (integer? size) (<= 1 size 128)
                 (or (nil? requested) (= size (String/to_integer requested)))
                 (= key-input (get plan "assembly_inputs"))
                 (= emission-input (get plan "inputs"))
                 (= (row-layout size)
                    (mapv #(select-keys % ["namespace" "offset" "count"]) (get plan "chunks"))))
       (println (str "NATIVE_CHUNK_PLAN_RESUMED " (count (get plan "chunks")) " jobs"))
       [plan expected]))))
   (catch _ nil))))

(defn emit-window! [plan max-built]
 (let [start (erlang/monotonic_time :millisecond)]
  (loop [rows (get plan "chunks") checked [] built 0 reused 0]
   (if (empty? rows) {:chunks checked :built built :reused reused}
    (let [row (first rows)]
     (if-let [chunk (ready-chunk row)]
      (recur (rest rows) (conj checked chunk) built (inc reused))
      (if (or (= built max-built) (>= (- (erlang/monotonic_time :millisecond) start) 110000))
       {:next (count checked) :built built :reused reused}
       (do (emit-chunk! row)
           (recur (rest rows) (conj checked (checked-chunk row)) (inc built) reused)))))))))
(defn assemble! [chunks]
 ; Assembly uses the verified bytes in plan order, with one source fragment
 ; from the first row of each namespace.
 (let [metadata-source (bootstrap/data metadata)
        functions (string/join "" (map :functions chunks))
        initializers (string/join "" (map :initializers chunks))
        sources (vec (keep :source chunks))
        _ (assert (= (count units) (count sources)))
        bundle (str "(bl-assoc " metadata-source " (bl-key \"units\") (bl-vec (list " (string/join "\n" sources) ")))")
        macro-names (set bootstrap/source-macro-names)
        macro-sources (keep-indexed (fn [i source]
                        (when (contains? macro-names (:ns (nth units i))) source)) sources)
        eval-bundle (str "(bl-map (bl-key \"units\") (bl-vec (list " (string/join "\n" macro-sources) ")))")
        prelude (str ";; BL native compiler. Generated from canonical BL source.\n" host-source "\n"
                     (bootstrap/bundle-install-source metadata) functions initializers
                     (bootstrap/seal-source link-plan))]
   (File/write! (str out "/bundle.scm") bundle)
   (File/write! (str out "/eval-bundle.scm") eval-bundle)
   (File/write! (str out "/prelude.scm") prelude)
   (File/write! (str out "/stage1.scm") (str prelude "(native-main (native-command-line))\n"))
   (File/write! (str out "/chunk-export.json")
    (json/encode {"schema" "bl.native.chunk-export" "version" 2 "inputs" key-input "emission_inputs" emission-input
                  "jobs" (count chunks) "prelude_sha256" (artifact/sha prelude)
                  "bundle_sha256" (artifact/sha bundle) "eval_bundle_sha256" (artifact/sha eval-bundle)}))
   (println (str "NATIVE_CHUNKS_ASSEMBLED " (count chunks) " checked jobs"))))
(cond
 (= mode "plan")
  (let [size (String/to_integer (or (nth args 5 nil) "32"))]
   (assert (<= 1 size 128))
   (File/mkdir_p! (str out "/chunks"))
   (let [plan (make-plan size)]
    (File/write! (str out "/chunks.json") (json/encode plan))
    (println (str "NATIVE_CHUNK_PLAN " (count (get plan "chunks")) " jobs"))
    (report-dead-leaves!)))
 (= mode "emit")
  (let [plan (read-plan) index (String/to_integer (nth args 5))]
   (let [row (nth (get plan "chunks") index)]
    (if (ready-chunk row) (println (str "NATIVE_CHUNK_REUSED " (get row "key"))) (emit-chunk! row))))
 (= mode "emit-next")
  (let [plan (read-plan) start (erlang/monotonic_time :millisecond)]
   (loop [rows (get plan "chunks") index 0 built 0 reused 0]
    (cond
     (empty? rows) (println (str "NATIVE_CHUNKS_COMPLETE built=" built " reused=" reused))
     (ready-chunk (first rows)) (recur (rest rows) (inc index) built (inc reused))
     (>= (- (erlang/monotonic_time :millisecond) start) 110000)
      (println (str "NATIVE_CHUNKS_YIELD next=" index " built=" built " reused=" reused))
     :else (do (emit-chunk! (first rows)) (recur (rest rows) (inc index) (inc built) reused)))))
 (= mode "assemble") (assemble! (mapv checked-chunk (get (read-plan) "chunks")))
 ; Focused inspection: emit only the named definitions ("ns/name,...") and
 ; the seed links to OUT/inspect.scm. No plan, chunk or bundle is written.
 (= mode "inspect")
  (let [wanted (string/split (nth args 5) #",")
        text (string/join ""
              (for [slot wanted]
               (let [at (string/index-of slot "/") ns (subs slot 0 at) name (subs slot (inc at))
                     unit (get (:units closure) ns)
                     d (or (last (filter #(= name (:name %)) (:defs unit)))
                           (throw (ex-info "native chunks: inspect target absent" {:slot slot})))]
                (bootstrap/emit-definition link-plan unit d))))]
   (File/mkdir_p! out)
   (File/write! (str out "/inspect.scm") text)
   (File/write! (str out "/seed-links.scm") (bootstrap/seed-links link-plan))
   (println (str "NATIVE_CHUNKS_INSPECT " (count wanted))))
 (= mode "build-next")
  (let [max-built (when-let [limit (not-empty (nth args 7 nil))]
                    (let [limit (String/to_integer limit)] (assert (pos? limit)) limit))
        [plan digest] (or (resume-plan (nth args 6 nil)) (ensure-plan!))
        progress (emit-window! plan max-built)]
   (if-let [chunks (:chunks progress)]
    (do
     (assemble! chunks)
     (println (str "NATIVE_BUILD_COMPLETE built=" (:built progress) " reused=" (:reused progress))))
    (println (str "NATIVE_BUILD_YIELD next=" (:next progress) " built=" (:built progress)
                  " reused=" (:reused progress) " plan_sha=" digest))))
 (= mode "dead-leaves") (report-dead-leaves!)
 ; Focused unit build: emit every chunk row of the named namespaces (args 5 =
 ; "ns,ns,...", 6 = optional size) into OUT/chunks with the same keys and
 ; reports a full plan would give those rows. No chunks.json, other row or
 ; bundle is written.
 (= mode "emit-unit")
  (let [wanted (string/split (nth args 5) #",") size (String/to_integer (or (nth args 6 nil) "32"))
        layout (row-layout size)]
   (File/mkdir_p! (str out "/chunks"))
   (report-dead-leaves!)
   (doseq [ns wanted]
    (let [rows (filter #(= ns (get % "namespace")) layout)]
     (when (empty? rows) (throw (ex-info "native chunks: emit-unit namespace absent" {:namespace ns})))
     (doseq [row rows]
      (let [record (emission-record row)]
       (emit-chunk! (assoc row "key" (key-from-record record) "emission_record" record))))
     (println (str "NATIVE_CHUNKS_UNIT " ns " " (count rows))))))
 :else (throw (ex-info "native chunks: expected plan, emit, emit-next, emit-unit, assemble, inspect, dead-leaves or build-next" {:mode mode})))
