; Bounded replay jobs. Use the SAME warm VM for plan, emit N, and assemble.
; Each job emits canonical ANF; this utility never compiles BL source.
(ns native.chunks
 (:require [native.artifact :as artifact] [native.bootstrap :as bootstrap]
           [native.eval :as ev] [native.scheme :as scheme]
           [bl.json :as json] [clojure.string :as string] [anf] [native.resolution :as resolution]))
(def args (BeamLisp/argv))
(def mode (or (nth args 0 nil) "plan"))
(def artifact-path (or (nth args 1 nil) "research/native-seed/out/compiler-closure/partition.json"))
(def host-path (or (nth args 2 nil) "research/native-seed/out/compiler-closure/host.scm"))
(def out (or (nth args 3 nil) "research/native-seed/out/compiler-closure"))
(def leaves-path (or (nth args 4 nil) (str out "/leaves.json")))
(def closure (artifact/read-closure artifact-path))
(def manifest (json/decode (File/read! artifact-path)))
(def units (mapv #(get (:units closure) %) (:order closure)))
(doseq [u units] (assert (= (:source-sha256 u) (artifact/sha (File/read! (:path u))))))
(def leaves (set (get (json/decode (File/read! leaves-path)) "registered_leaves")))
(def table (into {} (map (fn [u] [(:ns u) (set (keep :name (:defs u)))]) units)))
(def resolution-ledger (resolution/build closure))
(def by-module (assoc (into {} (mapcat (fn [u] [[(:module u) (:ns u)] [(:base-module u) (:ns u)]]) units))
                      :Elixir.BeamLisp.CompilerData "host.compiler-data"
                      :Elixir.BeamLisp.FormMeta "host.form-meta" :Elixir.BeamLisp.Meta "host.meta"))
(def stub-modules (set (mapcat (fn [ns] [(BeamLisp.Link/module_for ns) (BeamLisp.Emit/base_module_for ns)]) (:stubs closure))))
(def key-input
 {"artifact_sha256" (get manifest "artifact_sha256")
  "sdk_descriptor_sha256" (:sdk-descriptor-sha256 artifact/validation-context)
  "abi_sha256" (artifact/sha (File/read! leaves-path))
  "host_sha256" (artifact/sha (File/read! host-path))
  "emitter_sha256" (artifact/sha (File/read! "research/native-seed/src/native/scheme.bl"))
  "eval_sha256" (artifact/sha (File/read! "research/native-seed/src/native/eval.bl"))
  "bootstrap_sha256" (artifact/sha (File/read! "research/native-seed/src/native/bootstrap.bl"))
  "driver_sha256" (artifact/sha (File/read! "research/native-seed/src/native/chunks.bl"))
  "resolution_sha256" (artifact/sha (File/read! "research/native-seed/src/native/resolution.bl"))
  "options_sha256" (artifact/sha (erlang/term_to_binary (:options closure) (list :deterministic)))})
(def emission-input
 (assoc (select-keys key-input ["sdk_descriptor_sha256" "emitter_sha256" "eval_sha256"
                              "bootstrap_sha256" "options_sha256" "driver_sha256" "resolution_sha256"])
        "resolver_policy" "native-exact-late-lookup-v2"))
(defn remote-decision [n]
 (let [m (:mod n) f (erlang/atom_to_binary (:fun n)) a (count (:args n))
       logical (if (ends-with? f "__bl_v") (subs f 0 (- (count f) 6)) f)
       key (str (erlang/atom_to_binary m) "/" f "/" a)]
  (cond
   (contains? leaves key) ["leaf" key]
   (and (contains? by-module m) (contains? (get table (get by-module m)) logical))
    ["compiled" key (get by-module m) logical (if (ends-with? f "__bl_v") "rest-list-clause" "fixed-dispatch")]
   (contains? stub-modules m) ["excluded-namespace" key]
   :else (throw (ex-info (str "native V2 cache: unresolved remote signature " key) {:remote key})))))
(defn global-decision [n] (resolution/global-decision resolution-ledger table n))
(defn decisions-for [defs]
 ; A finite syntax walk, not an evaluator. Use only raw proper-list append;
 ; no LazySeq/mapcat chains enter the cache identity or traversal worklist.
 (loop [todo (BeamLisp.CompilerData/eager_map :node defs) decisions #{}]
  (if (erlang/== todo (list)) (vec (sort-by str decisions))
   (let [node (erlang/hd todo)
         decision (case (:op node) :remote (remote-decision node) :global (global-decision node) nil)]
    (recur (lists/append (anf/executable-children node) (erlang/tl todo))
           (if decision (conj decisions decision) decisions))))))
(defn emission-record [row]
 (let [u (get (:units closure) (get row "namespace")) offset (get row "offset")
       defs (subvec (:defs u) offset (+ offset (get row "count")))]
  {"row" (select-keys row ["namespace" "offset" "count"])
   "ir_sha256" (artifact/sha (erlang/term_to_binary defs (list :deterministic)))
   "source_unit_sha256" (when (= offset 0)
     (artifact/sha (erlang/term_to_binary (select-keys u [:ns :path :source :requires :module :base-module]) (list :deterministic))))
   "decisions" (decisions-for defs)}))
(defn key-from-record [record]
 (artifact/sha (erlang/term_to_binary [emission-input record] (list :deterministic))))
(defn checked-context [ns]
 (let [base (ev/context ns)]
  (assoc base
   :remote-resolver
   (fn [n]
    (let [m (:mod n) f (erlang/atom_to_binary (:fun n))
          logical (if (ends-with? f "__bl_v") (subs f 0 (- (count f) 6)) f)
          key (str (erlang/atom_to_binary m) "/" f "/" (count (:args n)))]
     (when-not (or (contains? leaves key) (contains? stub-modules m)
                    (and (contains? by-module m) (contains? (get table (get by-module m)) logical)))
      (throw (ex-info "native chunks: missing exact remote capability" {:namespace ns :remote key :ann (:ann n)})))
     ((:remote-resolver base) n)))
   :global-resolver
   (fn [n]
    (global-decision n)
    ((:global-resolver base) n)))))
(defn emit-definition [u d]
 (let [ns (:ns u) value (scheme/emit (:node d) (checked-context ns))]
  (if (:name d)
   (str "(define " (bootstrap/binding-name ns (:name d)) " " value ")\n"
        "(native-register! " (scheme/text ns) " " (scheme/text (:name d)) " " (bootstrap/binding-name ns (:name d)) ")\n"
        "(native-put-meta " (scheme/text ns) " " (scheme/text (:name d))
        " (bl-map (bl-key \"private\") " (if (:private? d) "#t" "#f") "))\n"
        (when (= :fn (:kind d))
         (let [arities (bootstrap/declaration-arities (:form d))]
          (str "(native-register-arities! " (scheme/text ns) " " (scheme/text (:name d)) " "
               (bootstrap/data (:fixed arities)) " " (bootstrap/data (:variadic arities)) ")\n"))))
   (str value "\n"))))
(defn bundle-metadata []
 {:schema "bl.native.source-bundle" :version 1 :sdk-pin (:sdk-pin closure) :resolution resolution-ledger
  :provider-sources (:provider-sources closure) :options (:options closure) :stubs (:stubs closure)
  :core-links (:core-links closure) :return-constructor-shapes (:return-constructor-shapes closure)
  :namespace-modules (mapv (fn [u] [(:ns u) (:module u) (:base-module u)]) units)
  :stub-modules (mapv (fn [ns] [ns (BeamLisp.Link/module_for ns) (BeamLisp.Emit/base_module_for ns)]) (:stubs closure))})
(defn chunk-path [key extension] (str out "/chunks/" key "." extension))
(defn row-layout [size]
 (vec (mapcat (fn [u]
   (map (fn [offset] {"namespace" (:ns u) "offset" offset "count" (min size (- (count (:defs u)) offset))})
        (map #(* size %) (range (erlang/div (+ (count (:defs u)) (- size 1)) size))))) units)))
(defn make-plan [size]
 {"schema" "bl.native.chunk-plan" "version" 2 "inputs" emission-input "assembly_inputs" key-input "size" size
  "chunks" (mapv (fn [row]
              (let [record (emission-record row)]
               (assoc row "key" (key-from-record record) "emission_record" record))) (row-layout size))})
(defn read-plan []
 (let [plan (json/decode (File/read! (str out "/chunks.json")))]
  (assert (= "bl.native.chunk-plan" (get plan "schema")))
  (assert (= 2 (get plan "version")))
  (assert (= emission-input (get plan "inputs")))
  (assert (= (mapv #(select-keys % ["namespace" "offset" "count"]) (get plan "chunks"))
             (row-layout (get plan "size"))))
  ; Exactly one current IR/signature record per row. Never rebuild an entire
  ; plan merely to compare it, and never walk a row again for its key.
  (doseq [row (get plan "chunks")]
   (let [record (emission-record row)]
    (assert (= record (get row "emission_record")))
    (assert (= (key-from-record record) (get row "key")))))
  plan))
(defn chunk-ready? [row]
 (try
  (let [key (get row "key") report (json/decode (File/read! (chunk-path key "json")))]
   (and (= key (get report "key"))
        (= emission-input (get report "emission_inputs"))
        (= (get row "emission_record") (get report "emission_record"))
        (= (artifact/sha (File/read! (chunk-path key "functions.scm"))) (get report "functions_sha256"))
        (= (artifact/sha (File/read! (chunk-path key "initializers.scm"))) (get report "initializers_sha256"))
        (or (not= 0 (get row "offset"))
            (= (artifact/sha (File/read! (str out "/chunks/" (get row "namespace") ".source-unit.scm")))
               (get report "source_unit_sha256")))))
  (catch _ false)))
(defn emit-chunk! [row]
 (let [key (get row "key") u (get (:units closure) (get row "namespace"))
       offset (get row "offset") count* (get row "count")
       _ (assert (= key (key-from-record (get row "emission_record"))))
       defs (subvec (:defs u) offset (+ offset count*))
       functions (string/join "" (map #(emit-definition u %) (filter #(= :fn (:kind %)) defs)))
       initializers (str (when (and (= "core" (:ns u)) (= offset 0)) "(bl-invoke (native-global \"rt\" \"seed-core\") '())\n")
                         (string/join "" (map #(emit-definition u %) (remove #(= :fn (:kind %)) defs))))
       source-unit (when (= offset 0) (bootstrap/data (select-keys u [:ns :path :source :requires :module :base-module])))
       report {"key" key "emission_inputs" emission-input "emission_record" (get row "emission_record")
               "functions_sha256" (artifact/sha functions) "initializers_sha256" (artifact/sha initializers)
               "source_unit_sha256" (when source-unit (artifact/sha source-unit))}]
  (File/write! (chunk-path key "functions.scm") functions)
  (File/write! (chunk-path key "initializers.scm") initializers)
  (when source-unit (File/write! (str out "/chunks/" (:ns u) ".source-unit.scm") source-unit))
  (File/write! (chunk-path key "json") (json/encode report))
  (println (str "NATIVE_CHUNK " (:ns u) " " offset " " count* " " key))))
(defn checked-chunk-text [row extension hash-key]
 (let [key (get row "key") report (json/decode (File/read! (chunk-path key "json")))
       text (File/read! (chunk-path key extension))]
  (assert (= key (get report "key")))
  (assert (= emission-input (get report "emission_inputs")))
  (assert (= (get row "emission_record") (get report "emission_record")))
  (assert (= (artifact/sha text) (get report hash-key))) text))
(cond
 (= mode "plan")
  (let [size (String/to_integer (or (nth args 5 nil) "32"))]
   (assert (<= 1 size 128))
   (File/mkdir_p! (str out "/chunks"))
   (let [plan (make-plan size)]
    (File/write! (str out "/chunks.json") (json/encode plan))
    (println (str "NATIVE_CHUNK_PLAN " (count (get plan "chunks")) " jobs"))))
 (= mode "emit")
  (let [plan (read-plan) index (String/to_integer (nth args 5))]
   (let [row (nth (get plan "chunks") index)]
    (if (chunk-ready? row) (println (str "NATIVE_CHUNK_REUSED " (get row "key"))) (emit-chunk! row))))
 (= mode "emit-next")
  (let [plan (read-plan) start (erlang/monotonic_time :millisecond)]
   (loop [rows (get plan "chunks") index 0 built 0 reused 0]
    (cond
     (empty? rows) (println (str "NATIVE_CHUNKS_COMPLETE built=" built " reused=" reused))
     (chunk-ready? (first rows)) (recur (rest rows) (inc index) built (inc reused))
     (>= (- (erlang/monotonic_time :millisecond) start) 110000)
      (println (str "NATIVE_CHUNKS_YIELD next=" index " built=" built " reused=" reused))
     :else (do (emit-chunk! (first rows)) (recur (rest rows) (inc index) (inc built) reused)))))
 (= mode "assemble")
  (let [plan (read-plan) rows (get plan "chunks") metadata (bundle-metadata)
        metadata-source (bootstrap/data metadata)
        functions (string/join "" (map #(checked-chunk-text % "functions.scm" "functions_sha256") rows))
        initializers (string/join "" (map #(checked-chunk-text % "initializers.scm" "initializers_sha256") rows))
        sources (mapv (fn [u]
         (let [row (first (filter #(and (= (:ns u) (get % "namespace")) (= 0 (get % "offset"))) rows))
               report (json/decode (File/read! (chunk-path (get row "key") "json")))
               text (File/read! (str out "/chunks/" (:ns u) ".source-unit.scm"))]
          (assert (= (artifact/sha text) (get report "source_unit_sha256"))) text)) units)
        prelude (str ";; BL native compiler. Generated from canonical BL source.\n" (File/read! host-path) "\n"
                     "(native-install-bundle! " metadata-source ")\n" functions initializers)]
   (File/write! (str out "/bundle.scm") (str "(bl-assoc " metadata-source " (bl-key \"units\") (bl-vec (list " (string/join "\n" sources) ")))"))
   (File/write! (str out "/prelude.scm") prelude)
   (File/write! (str out "/stage1.scm") (str prelude "(native-main (native-command-line))\n"))
   (File/write! (str out "/chunk-export.json")
    (json/encode {"schema" "bl.native.chunk-export" "version" 2 "inputs" key-input "emission_inputs" emission-input
                  "jobs" (count rows) "prelude_sha256" (artifact/sha prelude)}))
   (println (str "NATIVE_CHUNKS_ASSEMBLED " (count rows) " checked jobs")))
 :else (throw (ex-info "native chunks: expected plan, emit, emit-next or assemble" {:mode mode})))
