; Direct bl-ANF -> C control flow. Scheme text below initializes literal roots
; and checked primitive tables only; no authored function/body is Scheme-emitted.
; The pc graph and closure entries are C. See direct-machine.scm for the root ABI.
(ns native.c
 (:require [clojure.string :as string] [native.scheme :as scalar] [anf]))

(defn fail [node]
 (throw (ex-info "direct C: unsupported ANF or unresolved native capability"
  (select-keys node [:op :pop :mod :fun :ns :name :ann :reference]))))
(defn- quote-generated-code [source]
 ; Only emit-unit's owned C alphabet reaches here: printable ASCII + LF.
 ; Source strings, names, metadata and literals remain Scheme-pooled and use
 ; scalar/text unchanged. Escape original backslashes BEFORE adding escapes.
 (str "\"" (String/replace
              (String/replace (String/replace source "\\" "\\\\") "\"" "\\\"")
              "\n" "\\n") "\""))
(defn state []
 {:next 0 :slot 2 :blocks [] :constants ["bl-nil"] :constant-index {"bl-nil" 0}
  :services [] :service-index {} :functions [] :slot-calls 0 :generic-calls 0 :pure-bifs {}})
(defn reg [s] [(update s :slot inc) (:slot s)])
(defn pool [s source]
 (if-let [i (get (:constant-index s) source)] [s i]
  (let [i (count (:constants s))]
   [(-> s (update :constants conj source) (assoc-in [:constant-index source] i)) i])))
(defn service [s source]
 (if-let [i (get (:service-index s) source)] [s i]
  (let [i (count (:services s))]
   [(-> s (update :services conj source) (assoc-in [:service-index source] i)) i])))
(defn block [s code]
 (let [i (:next s)] [(-> s (update :next inc) (update :blocks conj {:id i :code code})) i]))
(defn r [i] (str "BLC_REG(m," i ")"))
(defn k [i] (str "BLC_CONST(m," i ")"))
(defn jump [next] (str " BLC_PC(m," next "); continue;"))
(defn action [kind a destination next args tail?]
 (str " blc_set(m,11,BLC_CONST(m,0)); BLC_ACTION(m," a "," destination "," next "," args "," (if tail? 1 0) ");"
  (if (= kind "BLC_TICK")
   (str " if (BLC_SKIP_NOACTOR_TICK(m)) { BLC_PC(m," next "); continue; }") "")
  " BLC_YIELD(m," kind ");"))
(defn action-at [kind a destination next args tail? site]
 (str " blc_set(m,11," site "); BLC_ACTION(m," a "," destination "," next "," args "," (if tail? 1 0) "); BLC_YIELD(m," kind ");"))
(defn call-site [options tail?]
 (when-let [ann (:direct-callsite options)]
  (assoc (select-keys ann [:file :line :col :end-line :end-col])
    :fn (:source-fn options) :arity (:source-arity options)
    :call (if (and tail? (not= false (:source-tail-allowed? options))) :tail :direct)
    :internal (and (:file ann) (String/ends_with? (:file ann) "/actor/runtime.bl")))))
(defn internal [source args] {:op :direct-service :service source :args (vec args) :ann {}})
(defn value-source [source] {:op :direct-value :source source :ann {}})
(defn lit [v] {:op :lit :val v :ann {}})
(defn list-node [nodes] (internal "list" nodes))
(defn thunk [body]
 {:op :fn :clauses [{:pats [] :guard nil :body body}] :ann (:ann body)
  :direct-control? true :direct-control-tail? false :direct-control-tick? false})
(defn vector-node [nodes] (internal "bl-make-vec" nodes))
(defn variable [name] {:op :var :name name :ann {}})
(defn slot-node [i] {:op :direct-register :register i :ann {}})
(defn names-in [node]
 (let [own (if (and (contains? #{:let :var} (:op node)) (:name node)) #{(:name node)} #{})
       clauses (concat (:clauses node) (:catch node))
       bound (mapcat (fn [clause] (mapcat anf/pattern-vars (:pats clause))) clauses)]
  (reduce (fn [out child] (into out (names-in child))) (into own bound)
   (filter some? (anf/executable-children node)))))
(defn fresh-name-used [prefix node additional]
 (let [used (into (names-in node) additional)]
  (loop [i 0]
   (let [candidate (str prefix i)]
    (if (contains? used candidate) (recur (inc i)) candidate)))))
(defn fresh-name [prefix node] (fresh-name-used prefix node #{}))
(declare lower)

(defn lower-arguments [s arguments slots env continuation options]
 ; Build the graph backward. The resulting entry evaluates operands left to
 ; right and exactly once, independently of C argument evaluation rules.
 (reduce (fn [[s next] pair]
           (lower s (first pair) env (second pair) next false options))
  [s continuation] (reverse (map (fn [argument slot] [argument slot]) arguments slots))))

(def pure-bif-specs
 {"is_list" {:id 0 :arity 1 :request 1}
  "is_integer" {:id 1 :arity 1 :request 2}
  "==" {:id 2 :arity 2 :request 4}
  "=:=" {:id 3 :arity 2 :request 16}})
(defn pure-bif-spec [node tail?]
 (when (and (not tail?) (= :erlang (:mod node)))
  (let [spec (get pure-bif-specs (erlang/atom_to_binary (:fun node)))]
   (when (and spec (= (:arity spec) (count (:args node)))) spec))))
(defn lower-service [s source arguments env destination next tail? options]
 (let [[s index] (service s source)
       [s slots] (reduce (fn [[s out] _] (let [[s i] (reg s)] [s (conj out i)])) [s []] arguments)
       [s plan] (pool s (str "'(" (string/join " " slots) ")"))
       [s site] (pool s (scalar/literal (call-site options tail?)))
       spec (when (not tail?) (:direct-pure-bif options))
       s (if spec (assoc-in s [:pure-bifs (:id spec)] (:request spec)) s)
       fast (if spec
        (str " ___SCMOBJ blc_pure_result; if (blc_try_pure_bif(m," index "," (:id spec) "," (count slots) ","
             (r (first slots)) "," (if (= 2 (count slots)) (r (second slots)) "___FAL") ",&blc_pure_result)) {"
             " BLC_PUT(m," destination ",blc_pure_result);" (jump next) " }\n") "")
       [s call] (block s (str fast (action-at "BLC_SERVICE" (str "___FIX(" index ")") destination next (k plan) tail? (k site))))]
  (lower-arguments s arguments slots env call (dissoc (dissoc options :direct-callsite) :direct-pure-bif))))

(defn pattern-node [p]
 (case (:pop p)
  :pvar (list-node [(value-source "'var") (lit (:name p))])
  :plit (list-node [(value-source "'lit") (lit (:val p))])
  :pnil (list-node [(value-source "'nil")])
  :ptuple (list-node [(value-source "'tuple") (list-node (map pattern-node (:elems p)))])
  :pcons (list-node [(value-source "'cons") (pattern-node (:head p)) (pattern-node (:tail p))])
  :palias (list-node [(value-source "'alias") (pattern-node (:a p)) (pattern-node (:b p))])
  :pmap (list-node [(value-source "'map")
          (list-node (map (fn [[key p]] (list-node [key (pattern-node p)])) (:pairs p)))])
  :pstruct (if (= :Elixir.BeamLisp.Vector (:mod p))
    (list-node [(value-source "'vector") (pattern-node (second (first (:fields p))))])
    (list-node [(value-source "'struct") (lit (:mod p))
      (list-node (map (fn [[key p]] (list-node [(lit key) (pattern-node p)])) (:fields p)))]))
  (fail p)))

(defn lower-binders [s names binding-slot env continuation options]
 (let [[s bindings]
       (reduce (fn [[s bindings] name]
         (let [[s slot] (reg s)] [s (conj bindings [name slot])])) [s []] names)
       extended (reduce (fn [env [name slot]] (assoc env name slot)) env bindings)
       [s next] (continuation s extended)]
  (reduce (fn [[s next] [name slot]]
    (lower-service s "native-c-binding" [(slot-node binding-slot) (lit name)]
      env slot next false options))
   [s next] (reverse bindings))))

(defn lower-clauses [s clauses argv env destination next tail? fallback options]
 (if (empty? clauses) (lower s fallback env destination next tail? options)
  (let [clause (first clauses)
        [s more] (lower-clauses s (rest clauses) argv env destination next tail? fallback options)
        [s bindings] (reg s)
        [s body]
        (lower-binders s (distinct (mapcat anf/pattern-vars (:pats clause))) bindings env
         (fn [s extended]
          (let [[s body] (lower s (:body clause) extended destination next tail? options)]
           (if (:guard clause)
            (let [[s guard-result] (reg s)
                  [s choose] (block s (str " BLC_PC(m,BLC_TRUTHY(m," (r guard-result) ")?" body ":" more "); continue;"))]
             (lower-service s "native-c-guard" [(thunk (:guard clause))] extended guard-result choose false options))
            [s body]))) options)
        [s choose] (block s (str " BLC_PC(m,___FALSEP(" (r bindings) ")?" more ":" body "); continue;"))]
   (lower-service s "bl-match-args" [(list-node (map pattern-node (:pats clause)))
                       (slot-node argv) (value-source "'()")]
     env bindings choose false options))))

(defn lower-simple-clause [s clause env destination next options]
 ; CompilerData proves one unguarded all-variable clause; the caller also
 ; checks DISTINCT names, exactly like native.scheme/function-expression.
 ; Argv and every bound object stay in the rooted heap frame. This C prologue
 ; allocates nothing and invokes no Scheme/C callback, so no C local survives
 ; a park, exception, callback or GC boundary.
 (let [names (mapv :name (:pats clause))
       [s bindings] (reduce (fn [[s out] name]
                        (let [[s slot] (reg s)] [s (conj out [name slot])])) [s []] names)
       extended (reduce (fn [env [name slot]] (assoc env name slot)) env bindings)
       [s body] (lower s (:body clause) extended destination next true options)
       [s fallback] (lower s (internal "native-c-clause-error" []) env destination next true options)
       count (count names)
       check (if (= count 0)
               (str " if (!___NULLP(blc_arguments)) { BLC_PC(m," fallback "); continue; }\n")
               (str " int blc_argcount=0;\n"
                    " while (___PAIRP(blc_arguments) && blc_argcount<" count ") { blc_arguments=___CDR(blc_arguments); ++blc_argcount; }\n"
                    " if (blc_argcount!=" count " || !___NULLP(blc_arguments)) { BLC_PC(m," fallback "); continue; }\n"
                    " blc_arguments=BLC_REG(m,0);\n"))
       bind (string/join "" (map (fn [[_ slot]]
                      (str " BLC_PUT(m," slot ",___CAR(blc_arguments)); blc_arguments=___CDR(blc_arguments);\n")) bindings))]
  (block s (str " /* canonical fixed entry: exact arity, rooted arguments */\n"
                " ___SCMOBJ blc_arguments=BLC_REG(m,0);\n" check bind (jump body)))))

(defn lower-function [s node env destination next options]
 (let [parent-slot (:slot s) captured (vec (sort (keys env)))
       captures (mapv env captured) capture-slots (vec (range 1 (inc (count captured))))
       inner-env (into {} (map (fn [name slot] [name slot]) captured capture-slots))
       s (assoc s :slot (+ 2 (count captured))) return-slot (inc (count captured))
       [s finish] (block s (str " blc_set(m,4," (r return-slot) "); BLC_YIELD(m,BLC_RETURN);"))
       arity (count (:pats (first (:clauses node))))
       control? (:direct-control? node)
       body-options (if control?
                      (assoc (dissoc options :direct-callsite) :source-tail-allowed? (boolean (:direct-control-tail? node)))
                      (assoc (dissoc options :direct-callsite) :source-fn (:direct-source-fn node)
                             :source-arity arity :source-tail-allowed? true))
       clause (BeamLisp.CompilerData/simple_function_clause node)
       names (when clause (mapv :name (:pats clause)))
       [s entry] (if (and clause (= (count names) (count (distinct names))))
                   (lower-simple-clause s clause inner-env return-slot finish body-options)
                   (lower-clauses s (:clauses node) 0 inner-env return-slot finish true
                    (internal "native-c-clause-error" []) body-options))
       [s tick] (if (or (not control?) (:direct-control-tick? node))
                  (block s (action "BLC_TICK" "___FIX(0)" 0 entry "___NUL" false)) [s entry])
       size (:slot s)
       source-frame (assoc (select-keys (:ann node) [:file :line :col :end-line :end-col])
                       :fn (if control? (:source-fn options) (:direct-source-fn node)) :arity arity
                      :ns (:definition-ns options) :native-control (boolean control?))
       [s metadata] (pool s (str "(list " tick " " size " '(" (string/join " " capture-slots)
                             ") " (scalar/literal source-frame) ")"))
       [s capture-plan] (pool s (str "'(" (string/join " " captures) ")"))
       s (-> s (assoc :slot parent-slot) (update :functions conj {:entry tick :frame-size size :source source-frame}))]
  (block s (action "BLC_CLOSURE" (k metadata) destination next (k capture-plan) false))))

(defn receive-node [n options id logical-tail?]
 (let [message (fresh-name "__native_c_receive_" n) selected (fresh-name "__native_c_selected_" n)
       selector {:op :fn :ann (:ann n) :direct-control? true :direct-control-tail? false :direct-control-tick? false
                 :clauses [{:pats [{:pop :pvar :name message}] :guard nil
                  :body {:op :case :subj (variable message) :ann (:ann n)
                   :clauses (vec (concat
                    (map #(assoc % :body (vector-node [(lit :match) (assoc (thunk (:body %)) :direct-control-tail? logical-tail?)])) (:clauses n))
                    [{:pats [{:pop :pvar :name (fresh-name "__native_c_unmatched_" n)}]
                      :guard nil :body (lit :nomatch)}]))}}]}
       receive-call {:op :apply :fn (if-let [source (:receive-source options)] (value-source source)
                                  {:op :global :ns (or (:runtime-namespace options) "native.kernel") :name "rt-receive"})
                     :args [selector (assoc (thunk (or (:after n) (lit nil))) :direct-control-tail? logical-tail?) (or (:timeout n) (lit nil))] :ann (:ann n)}]
  {:op :let :name selected :init receive-call :ann (:ann n)
   :body {:op :apply :fn (internal "bl-nth" [(variable selected) (lit 1)]) :args [] :ann (:ann n)}}))

(defn try-node [n id]
 (let [stack (BeamLisp.CompilerData/catch_stack_bindings)
       trace (fresh-name "__native_c_trace_" n) kind (fresh-name "__native_c_kind_" n) reason (fresh-name "__native_c_reason_" n)
       with-trace (fn [body]
         {:op :let :name (:frames stack) :init (internal "native-c-caught-frames" [(variable trace)]) :ann (:ann n)
          :body {:op :let :name (:raw stack) :init (variable trace) :body body :ann (:ann n)}})
       catches (map (fn [clause]
         (assoc clause :pats (conj (vec (:pats clause)) {:pop :pvar :name trace})
          :guard (when (:guard clause) (with-trace (:guard clause)))
          :body (with-trace (:body clause)))) (:catch n))
       fallback {:pats [{:pop :pvar :name kind} {:pop :pvar :name reason} {:pop :pvar :name trace}]
                 :guard nil :body (internal "bl-reraise" [(variable kind) (variable reason) (variable trace)])}
       handler {:op :fn :direct-control? true :direct-control-tail? false :direct-control-tick? false :clauses (vec (concat catches [fallback])) :ann (:ann n)}]
  (internal "native-c-try" [(thunk (:body n)) handler (if (:after n) (thunk (:after n)) (lit false))])))

(defn finite-call-arguments [arguments]
 ; Only constructor cells ending EXACTLY in :enil are transport. A variable,
 ; computed tail, dotted list or any other expression keeps generic lowering.
 (loop [node arguments out []]
  (case (:op node)
   :enil out
   :cons (recur (:tail node) (conj out (:head node)))
   nil)))
(defn lower-call-slots [s callee arguments env destination next tail? options]
 ; Root the callee FIRST, then each head left-to-right exactly once. C returns
 ; before one native-c-slots allocation; the original planner owns the call.
 (let [s (update s :slot-calls inc)
       [s f] (reg s)
       [s slots] (reduce (fn [[s out] _] (let [[s i] (reg s)] [s (conj out i)])) [s []] arguments)
       [s plan] (pool s (str "'(" (string/join " " slots) ")"))
       [s site] (pool s (scalar/literal (call-site options tail?)))
       [s invoke] (block s (action-at "BLC_CALL_SLOTS" (r f) destination next (k plan) tail? (k site)))
       inner-options (dissoc options :direct-callsite)
       [s heads] (lower-arguments s arguments slots env invoke inner-options)]
  (lower s callee env f heads false inner-options)))
(defn lower-call [s callee arguments env destination next tail? options]
 (if-let [heads (finite-call-arguments arguments)]
  (lower-call-slots s callee heads env destination next tail? options)
  (let [s (update s :generic-calls inc) [s f] (reg s) [s args] (reg s)
       [s site] (pool s (scalar/literal (call-site options tail?)))
       [s invoke] (block s (action-at "BLC_CALL" (r f) destination next (r args) tail? (k site)))
       inner-options (dissoc options :direct-callsite)
       [s arguments] (lower s arguments env args invoke false inner-options)]
  (lower s callee env f arguments false inner-options))))

(defn self-constructor-target [node options]
 ; Only the canonical inert (self self) constructor is elided. Authored calls
 ; still pass through normal C invocation and the shared callable dispatcher.
 (when (and (= :apply (:op node)) (= :var (:op (:fn node)))
            (= 1 (count (:args node))) (= :var (:op (first (:args node))))
            (= (:name (:fn node)) (:name (first (:args node)))))
  (get (:direct-selves options) (:name (:fn node)))))

(defn dispatch-count? [node]
 (and (= :lit (:op node)) (erlang/is_integer (:val node)) (>= (:val node) 0)))
(defn dispatch-value? [node]
 ; Exact finite container shape from system.ir/dispatch-layout. Keep the small
 ; recognition here rather than import the system graph into the seed compiler.
 (when (and (= :tuple (:op node)) (= 3 (count (:elems node))))
  (let [[head fixed variadic] (:elems node) pairs (:pairs fixed)]
   (and (= :lit (:op head)) (erlang/=:= :"$blfn" (:val head))
        (= :map (:op fixed)) (erlang/is_list pairs)
        (every? (fn [pair] (and (or (erlang/is_list pair) (vector? pair)) (= 2 (count pair))
                                  (dispatch-count? (first pair)))) pairs)
        (= (count pairs) (count (distinct (map (fn [pair] (:val (first pair))) pairs))))
        (or (and (= :lit (:op variadic)) (nil? (:val variadic)))
            (and (= :tuple (:op variadic)) (= 2 (count (:elems variadic)))
                 (dispatch-count? (first (:elems variadic)))))))))
(defn dispatch-arm [value arity target label]
 (let [parts (BeamLisp.CompilerData/self_application_parts value)
       function (if parts (:inner parts) value)]
  (when-not (and (= :fn (:op function)) (erlang/is_list (:clauses function))
                (seq (:clauses function))
                (every? #(and (erlang/is_list (:pats %)) (= arity (count (:pats %)))) (:clauses function)))
   (fail value))
  {:op :direct-dispatch-arm :function value :target target :direct-source-fn label :ann (:ann value)}))

(defn dispatch-node [node env]
 ; The private cell is captured by every arm, then filled with the completed
 ; tuple. No user body executes while these inert function values are built.
 (let [target (fresh-name-used "__native_c_dispatch_self_" node (keys env))
       result (fresh-name-used "__native_c_dispatch_value_" node (conj (set (keys env)) target))
       [head fixed variadic] (:elems node)
       label (:direct-source-fn node)
       fixed (assoc fixed :pairs (mapv (fn [[arity value]]
          [arity (dispatch-arm value (:val arity) target label)]) (:pairs fixed)))
       variadic (if (= :tuple (:op variadic))
                  (assoc variadic :elems [(first (:elems variadic))
                    (dispatch-arm (second (:elems variadic)) (inc (:val (first (:elems variadic)))) target label)]) variadic)
       container (assoc node :op :direct-dispatch-container :elems [head fixed variadic])]
  {:op :let :name target :init (internal "native-c-new-recursion-cell" []) :ann (:ann node)
   :body {:op :let :name result :init container :ann (:ann node)
          :body (internal "native-c-fill-recursion!" [(variable target) (variable result)])}}))

(defn fixed-function-node [node env]
 ; CompilerData proved this let/apply is the inert canonical constructor. Build
 ; its inner C function ONCE; all proven self references read that same value.
 ; A plain (S S) execution would otherwise manufacture a new inner closure.
 (let [target (fresh-name-used "__native_c_fixed_self_" node (keys env))
       result (fresh-name-used "__native_c_fixed_value_" node (conj (set (keys env)) target))
       function {:op :direct-dispatch-arm :function node :target target
                 :direct-source-fn (:direct-source-fn node) :ann (:ann node)}]
  {:op :let :name target :init (internal "native-c-new-recursion-cell" []) :ann (:ann node)
   :body {:op :let :name result :init function :ann (:ann node)
          :body (internal "native-c-fill-recursion!" [(variable target) (variable result)])}}))

(defn lower-dispatch-arm [s node env destination next options]
 (let [function (:function node) parts (BeamLisp.CompilerData/self_application_parts function)]
  (cond
   parts
    (lower-function s (assoc (:inner parts) :direct-source-fn (:direct-source-fn node))
     env destination next
     (assoc options :direct-selves (assoc (or (:direct-selves options) {}) (:name function) (:target node))))
   (= :fn (:op function))
    (lower-function s (assoc function :direct-source-fn (:direct-source-fn node)) env destination next options)
   :else (fail function))))

(defn loop-application-parts [node]
 ; The compiler uses raw :apply(SCAFFOLD,inits) for a loop. Authored callable
 ; invocation has its own :invoke ABI. Keep original captures/self cells and
 ; C tail control; only make this generated function logically transparent.
 (when (and (= :apply (:op node)) (not (:direct-loop-rendered? node)))
  (BeamLisp.CompilerData/self_application_parts (:fn node))))
(defn source-loop-node [node parts options tail?]
 (let [logical-tail? (and tail? (not= false (:source-tail-allowed? options)))
       inner (assoc (:inner parts) :direct-control? true :direct-control-tail? logical-tail? :direct-control-tick? true)
       outer (assoc (:outer parts) :clauses [(assoc (:clause parts) :body inner)])
       scaffold (assoc (:fn node) :init outer :direct-source-fn (:source-fn options))]
  (assoc node :fn scaffold :direct-loop-rendered? true)))
(defn lower [s node env destination next tail? options]
 (if-let [definition (:direct-definition node)]
  (let [base (assoc options :definition-ns (:ns definition) :fn-label (:name definition))
        scoped (if-let [resolve (:definition-options options)] (resolve definition base) base)]
   (lower s (dissoc node :direct-definition) env destination next tail? scoped))
 (if-let [parts (loop-application-parts node)]
  (lower s (source-loop-node node parts options tail?) env destination next tail? options)
 (if-let [target (self-constructor-target node options)]
  (lower-service s "native-c-recursion-ref" [(variable target)] env destination next tail? options)
 (if (and (= :let (:op node)) (BeamLisp.CompilerData/self_application_parts node))
  (lower s (fixed-function-node node env) env destination next tail? options)
 (case (:op node)
  :lit (let [[s constant] (pool s (scalar/literal (:val node)))]
         (block s (str " BLC_PUT(m," destination "," (k constant) ");" (jump next))))
  :direct-value (let [[s constant] (pool s (:source node))]
                  (block s (str " BLC_PUT(m," destination "," (k constant) ");" (jump next))))
  :direct-register (block s (str " BLC_PUT(m," destination "," (r (:register node)) ");" (jump next)))
  :enil (lower s (value-source "'()") env destination next tail? options)
  :var (if-let [slot (get env (:name node))]
         (block s (str " BLC_PUT(m," destination "," (r slot) ");" (jump next))) (fail node))
  :global (let [value (if-let [resolver (:global-resolver options)] (resolver node)
                       (str "(" (if (= :exact (:lookup node)) "native-global-exact" "native-global") " "
                            (scalar/text (:ns node)) " " (scalar/text (:name node)) ")"))]
            (when-not value (fail node))
            (lower-service s (str "(lambda () " value ")") [] env destination next tail? options))
  :binding (if-let [resolver (:binding-resolver options)]
             (let [value (resolver node)]
              (when-not value (fail node))
              (lower-service s (str "(lambda () " value ")") [] env destination next tail? options)) (fail node))
  :remote (lower-service s (scalar/remote node options) (:args node) env destination next tail?
             (assoc options :direct-callsite (:ann node) :direct-pure-bif (pure-bif-spec node tail?)))
  :arith (let [source (or (when-let [resolver (:arithmetic-resolver options)] (resolver node))
                       (get scalar/arithmetic (:fun node)))]
           (when-not source (fail node))
           (lower-service s source (:args node) env destination next tail? (assoc options :direct-callsite (:ann node))))
  :direct-service (lower-service s (:service node) (:args node) env destination next tail? options)
  :apply (lower-call-slots s (:fn node) (:args node) env destination next tail? (assoc options :direct-callsite (:ann node)))
  :invoke (lower-call s (:callee node) (:arguments node) env destination next tail? (assoc options :direct-callsite (:ann node)))
  :let (let [[s slot] (reg s)
             [s body] (lower s (:body node) (assoc env (:name node) slot) destination next tail? options)]
         (lower s (:init node) env slot body false options))
  :if (let [[s test] (reg s)
            [s yes] (lower s (:then node) env destination next tail? options)
            [s no] (lower s (:else node) env destination next tail? options)
            [s choose] (block s (str " BLC_PC(m,BLC_TRUTHY(m," (r test) ")?" yes ":" no "); continue;"))]
        (lower s (:test node) env test choose false options))
  :do (let [statements (:stmts node)]
        (if (empty? statements) (lower s (lit nil) env destination next tail? options)
         (let [[s last] (lower s (last statements) env destination next tail? options)]
          (reduce (fn [[s next] statement]
            (let [[s ignored] (reg s)] (lower s statement env ignored next false options)))
           [s last] (reverse (butlast statements))))))
  :fn (lower-function s node env destination next options)
  :case (let [[s argv] (reg s)
              [s subject] (reg s)
              [s clauses] (lower-clauses s (:clauses node) argv env destination next tail?
                             (internal "native-c-clause-error" []) options)
              [s pack] (lower-service s "list" [(slot-node subject)] env argv clauses false options)]
          (lower s (:subj node) env subject pack false options))
  :recv (lower s (receive-node node options (:next s) (and tail? (not= false (:source-tail-allowed? options)))) env destination next tail? options)
  :try (lower s (try-node node (:next s)) env destination next tail? options)
  :tuple (if (dispatch-value? node)
           (lower s (dispatch-node node env) env destination next tail? options)
           (lower-service s "bl-make-tuple" (:elems node) env destination next tail? options))
  :direct-dispatch-container (lower-service s "bl-make-tuple" (:elems node) env destination next tail? options)
  :direct-dispatch-arm (lower-dispatch-arm s node env destination next options)
  :map (lower-service s "bl-map" (mapcat identity (:pairs node)) env destination next tail? options)
  :cons (lower-service s "cons" [(:head node) (:tail node)] env destination next tail? options)
  :struct (if (= :Elixir.BeamLisp.Vector (:mod node))
            (if (= :tuple (:op (second (first (:fields node)))))
             (lower-service s "bl-make-vec" (:elems (second (first (:fields node)))) env destination next tail? options)
             (fail node))
            (lower-service s "bl-struct" [(lit (:mod node)) {:op :map :pairs (:fields node) :ann (:ann node)}]
              env destination next tail? options))
  (fail node)))))))

(defn emit-unit
 "Return direct C and a literal/FFI wrapper. Options use the SAME checked
  leaf/global/binding resolvers as native.scheme. The wrapper contains no BL
  executable body emitted as Scheme. host/eval-c-unit must bind/load exactly
  this unit under the qualified native toolchain; annotations grant no rights."
 [node options]
 (let [unit (scalar/ident (or (:unit-name options) "native_direct_unit"))
       [s finish] (block (state) " blc_set(m,4,BLC_REG(m,1)); BLC_YIELD(m,BLC_RETURN);")
       [s entry] (lower s node {} 1 finish true options)
       pure-bif-mask (reduce (fn [mask pair] (+ mask (second pair))) 0 (:pure-bifs s))
       c-source (str "#include \"native-direct.h\"\n#if !defined(BL_NATIVE_DIRECT_ABI) || BL_NATIVE_DIRECT_ABI != 2\n#error direct_C_action_ABI_mismatch\n#endif\n#ifndef BLC_YIELD\n#error direct_C_local_PC_contract_mismatch\n#endif\n#ifndef BLC_SKIP_NOACTOR_TICK\n#error direct_C_optional_tick_contract_mismatch\n#endif\n#ifndef BLC_PURE_BIF_V1\n#error direct_C_pure_BIF_contract_mismatch\n#endif\nstatic int " unit "(___SCMOBJ m) { ___WORD blc_pc=___INT(blc_ref(m,1)); for (;;) { switch ((int)blc_pc) {\n"
                  (string/join "\n" (map #(str "case " (:id %) ": {" (:code %) "}\n") (sort-by :id (:blocks s))))
                  "default: BLC_YIELD(m,-1); } } }\n")
       preamble (str "(native-c-require-action-abi! 2)\n(c-declare " (quote-generated-code c-source) ")\n")
       expression (str "(begin (native-c-require-pure-bif-abi! 1)\n(let ((step (c-lambda (scheme-object) int " (scalar/text unit) ")))\n(let ((unit (vector step\n"
                " (vector " (string/join " " (:constants s)) ")\n"
                " (vector " (string/join " " (:services s)) ") " pure-bif-mask " step)))\n"
                " (native-c-invoke (native-c-new-closure unit (list " entry " " (:slot s) " '() bl-nil) '()) '()))))\n")]
  {:c-source c-source :preamble-source preamble :expression-source expression
   :wrapper-source (str preamble "(native-c-publish-loaded! " expression ")\n")
   :manifest {:schema "bl.native.direct-c-unit" :version 1 :action-abi 2 :pure-bif-abi 1 :pure-bif-mask pure-bif-mask :unit-name unit
              :blocks (count (:blocks s)) :functions (count (:functions s))
              :root-slots (:slot s) :literals (count (:constants s))
              :slot-calls (:slot-calls s) :generic-calls (:generic-calls s)
              :primitive-services (:services s) :source-interpreter false :anf-interpreter false
              :program-control :emitted-c :value-services :shared-native-host}}))

(defn export-shape [node]
 ; Metadata comes from the compiler's actual finite function value, never from
 ; parsing authored parameter syntax or guessing an emitted C entry's arity.
 (let [parts (BeamLisp.CompilerData/self_application_parts node)]
  (cond
   parts (export-shape (:inner parts))
   (dispatch-value? node)
    (let [[_ fixed variadic] (:elems node)]
     {:fixed (vec (sort (map (fn [[arity _]] (:val arity)) (:pairs fixed))))
      :variadic (when (= :tuple (:op variadic)) (:val (first (:elems variadic))))})
   (and (= :fn (:op node)) (seq (:clauses node)))
    (let [arities (vec (distinct (map #(count (:pats %)) (:clauses node))))]
     (when (= 1 (count arities)) {:fixed arities :variadic nil}))
   :else nil)))
(defn definitions-node [definitions]
 {:op :do :ann {}
  :stmts (mapv (fn [d]
   (if (:name d)
    (let [shape (export-shape (:node d))]
     (when (and (= :fn (:kind d)) (nil? shape)) (fail (:node d)))
     (internal "(lambda (ns name value fixed variadic private) (native-register! ns name value) (native-intern ns name value) (native-put-meta ns name (bl-map (bl-key \"private\") private)) (if (not (bl-is-nil fixed)) (native-register-arities! ns name fixed variadic)) value)"
      [(lit (:ns d)) (lit (:name d)) (assoc (:node d) :direct-source-fn (:name d)
                           :direct-definition (select-keys d [:ns :name :path]))
       (lit (:fixed shape)) (lit (:variadic shape)) (lit (boolean (:private? d)))])) (:node d))) definitions)})
(defn emit-definitions [definitions options]
 (emit-unit (definitions-node definitions) options))
