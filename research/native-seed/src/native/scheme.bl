; A deliberately closed seed backend. Input is the compiler's actual bl-ANF.
; No source parser, ANF interpreter, or Jolt/Clojure compatibility layer.
(ns native.scheme (:require [clojure.string :as string]))

; Emission is linear and allocation-light on both backends:
; - text is assembled by `cat` (one Enum.join over STRINGS; `str` dispatches on
;   every argument's kind and re-enters the runtime per piece);
; - every sequence is an eager Erlang list built with Enum or a loop. No lazy
;   sequence is created, so nothing captures an ANF subtree or the options.
; Every caller-visible result, and the order in which subtrees are emitted (it
; decides which refusal is reported first), is the previous emitter's.
(defn- glue [& parts] (Enum/join parts ""))
(defn- spaced [parts] (Enum/join parts " "))
(defn- items
 "A finite ANF collection (Erlang list, vector, set, nil) as an Erlang list."
 [xs]
 (cond (erlang/is_list xs) xs
       (nil? xs) (list)
       (vector? xs) (BeamLisp.Vector/to_list xs)
       :else (BeamLisp.Vector/to_list (vec xs))))
(defn- indexed
 "Each item with its position, as Erlang tuples {x, i} (Enum.with_index)."
 [xs] (Enum/with_index (items xs)))
(defn- any-of? [xs pred] (not (Enum/all? xs (fn [x] (not (pred x))))))

(def ^:private ascii-codes
 (erlang/list_to_tuple (Enum/map (lists/seq 0 127) (fn [c] (str "_" c)))))
(defn- code-text [c] (if (< c 128) (erlang/element (inc c) ascii-codes) (glue "_" (erlang/integer_to_binary c))))
(defn ident [s]
 (Enum/join (cons "v" (Enum/map (unicode/characters_to_list s) (fn [c] (code-text c)))) ""))
(defn- plain-text-code? [c] (and (>= c 32) (not= c 127) (not= c 34) (not= c 92)))
(defn- text-code [c]
 (cond (= c 34) "\\\"" (= c 92) "\\\\" (= c 10) "\\n" (= c 13) "\\r" (= c 9) "\\t"
       (or (< c 32) (= c 127)) (glue "\\x" (Integer/to_string c 16) ";")
       :else (unicode/characters_to_binary (list c))))
(defn text [s]
 (let [cs (unicode/characters_to_list s)]
  ; A text with nothing to escape is its own escape (same UTF-8 bytes).
  (if (Enum/all? cs (fn [c] (plain-text-code? c))) (glue "\"" s "\"")
   (glue "\"" (Enum/join (Enum/map cs (fn [c] (text-code c))) "") "\""))))
; A keyword whose name is plain ASCII symbol text is a quoted symbol constant,
; free in compiled and interpreted Gambit alike; any other name keeps the
; run-time interning of its escaped text.
(def ^:private symbol-safe-codes
 (erlang/list_to_tuple (Enum/map (lists/seq 0 127) (fn [c]
  (or (and (>= c 48) (<= c 57)) (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))
      (lists/member c (unicode/characters_to_list "-_?!*+<>=/.$%&~^@:")))))))
(defn- keyword-datum
 "The quoted-symbol datum of keyword name `name`, or nil when it is not plain symbol text."
 [name]
 (when (Enum/all? (unicode/characters_to_list name)
        (fn [c] (and (< c 128) (erlang/element (inc c) symbol-safe-codes))))
  (glue "|:" name "|")))
(defn- keyword-literal [name]
 (if-let [datum (keyword-datum name)] (glue "'" datum)
  (glue "(string->symbol " (text (glue ":" name)) ")")))
(declare literal)
(defn- literal-items [xs] (spaced (Enum/map (items xs) (fn [x] (literal x)))))
(defn literal [v]
 (cond (nil? v) "bl-nil" (= v true) "#t" (= v false) "#f"
       (integer? v) (erlang/integer_to_binary v) (string? v) (text v)
       (erlang/is_float v) (glue "(bl-float " (erlang/float_to_binary v (list :short)) ")")
       (= (type v) :Elixir.BeamLisp.Decimal)
        (str "(bl-decimal " (BeamLisp.Decimal/unscaled v) " " (BeamLisp.Decimal/scale v) ")")
       (keyword? v) (keyword-literal (erlang/atom_to_binary v))
       (vector? v) (glue "(bl-make-vec " (literal-items v) ")")
       (erlang/is_list v) (glue "(list " (literal-items v) ")")
       (set? v) (glue "(bl-set-from-list (list " (literal-items v) "))")
       (erlang/is_map v)
        (let [module (get v :__struct__)
              entries (if module (dissoc v :__struct__) v)
              fields (glue "(bl-map " (literal-items (BeamLisp.CompilerData/eager_mapcat
                (fn [entry] (list (erlang/element 1 entry) (erlang/element 2 entry)))
                (maps/to_list entries))) ")")]
         (if module (glue "(bl-struct " (literal module) " " fields ")") fields))
       (erlang/is_tuple v) (glue "(bl-make-tuple " (literal-items (erlang/tuple_to_list v)) ")")
       :else (throw (ex-info "native seed: unsupported literal" {:value v}))))
; Constant hoisting. Under a definition's sink (:constants, an atom of
; {:index {text name} :rows [[name text]…]}, with :constant-prefix), a literal
; whose Scheme text builds a value (a set, map, vector, list, tuple, struct,
; float, decimal or interned keyword: text that starts with "(") is emitted
; once as a top-level constant `<prefix>$q<i>` and referenced by name, so it
; is built at load, not at every evaluation (native.bootstrap/emit-definition
; writes the defines). Without a sink, literals are emitted in place.
(defn- hoisted [text options]
 (let [sink (:constants options)]
  (if (and sink (string/starts-with? text "("))
   (let [state @sink found (get (:index state) text)]
    (or found
     (let [name (glue (:constant-prefix options) "$q" (erlang/integer_to_binary (count (:rows state))))]
      (reset! sink {:index (assoc (:index state) text name) :rows (conj (:rows state) [name text])})
      name)))
   text)))
(defn refuse [n]
 (throw (ex-info (str "native seed: unsupported ANF or host capability "
                      (pr-str (select-keys n [:op :mod :fun :ns :name :val :pop])))
                {:op (:op n) :module (:mod n) :function (:fun n) :ann (:ann n)})))

(declare emit)
(defn- operand-options [options] (assoc options :tail? false))
(def ^:private operand-table (erlang/list_to_tuple (Enum/map (lists/seq 0 63) (fn [i] (str "a" i)))))
(defn- operand-name [i] (if (< i 64) (erlang/element (inc i) operand-table) (glue "a" (erlang/integer_to_binary i))))
(defn- operand-names [n] (Enum/map (lists/seq 0 (dec n)) (fn [i] (operand-name i))))
(defn- source-call-frame [n options]
 (let [ann (:ann n)]
  {:file (:file ann) :line (:line ann) :col (:col ann)
   :end-line (:end-line ann) :end-col (:end-col ann)
   :ns (:source-ns options) :fn (:source-fn options) :arity (:source-arity options)
   :call (if (:tail? options) :tail :direct)
   :internal (and (string? (:file ann)) (string/ends-with? (:file ann) "/actor/runtime.bl"))}))
; Source frames (debug emission) are statements around a call, never a
; wrapper: the call keeps its position, so a tail call stays a Scheme tail
; call. Each site is an emission-table entry: a constant vector
; #(internal? key value …) in the code, turned into its frame map only when a
; stack is observed (host/host-source-frames.scm). A map value with no Scheme
; datum falls back to a builder #(internal? (lambda () map)).
(defn- site-symbol? [s]
 (Enum/all? (unicode/characters_to_list s) (fn [c] (and (> c 32) (< c 127) (not= c 124) (not= c 92)))))
(defn- site-datum [v]
 (cond (nil? v) "#!void" (= v true) "#t" (= v false) "#f"
       (integer? v) (erlang/integer_to_binary v) (string? v) (text v)
       (and (keyword? v) (site-symbol? (erlang/atom_to_binary v))) (glue "|:" (erlang/atom_to_binary v) "|")
       :else nil))
(defn- frame-site [frame internal?]
 (let [data (Enum/map (maps/to_list frame) (fn [pair]
              [(site-datum (erlang/element 1 pair)) (site-datum (erlang/element 2 pair))]))
       flag (if internal? "#t" "#f")]
  (if (Enum/all? data (fn [d] (and (some? (first d)) (some? (second d)))))
   (glue "'#(" flag (Enum/join (Enum/map data (fn [d] (glue " " (first d) " " (second d)))) "") ")")
   (glue "(vector " flag " (lambda () " (literal frame) "))"))))
(defn- source-call [node expression options]
 (if (:source-frames? options)
  (let [frame (source-call-frame node options) site (frame-site frame (:internal frame))]
   (if (:tail? options)
    (glue "(begin (bl-source-tail " site ") " expression ")")
    (glue "(let ((source-entry (bl-source-call " site "))) (bl-source-return source-entry " expression "))")))
  expression))
(defn joined [xs options] (spaced (Enum/map (items xs) (fn [x] (emit x options)))))
(defn- operand-bindings
 "`(a<i> <operand>)` for each operand, emitted in source order."
 [args options]
 (let [operand (operand-options options)]
  (Enum/map (indexed args)
   (fn [pair] (glue "(" (operand-name (erlang/element 2 pair)) " " (emit (erlang/element 1 pair) operand) ")")))))
(defn ordered
 "Pin source operand order explicitly, as js.emit/emit-all and current lower
  operand tests do. Scheme application order is unspecified. Capture callee first."
 [callee args options]
 (let [args (items args)
       binds (operand-bindings args options)]
  (glue "(let ((callee " callee ")) (let* (" (spaced binds) ") (callee "
       (spaced (operand-names (count args))) ")))")))

(defn- ordered-call [node callee args options]
 (let [args (items args)
       names (spaced (operand-names (count args)))
       binds (operand-bindings args options)
       invoke (if (:source-frames? options)
                (glue "(bl-invoke callee (list " names "))")
                (glue "(callee " names ")"))]
  (glue "(let ((callee " callee ")) (let* (" (spaced binds) ") "
       (source-call node invoke options) "))")))

(defn- ordered-target-call [node function arguments operation options]
 ; Evaluate the ACTUAL target and arglist before installing its source context.
 ; The raw-fun operation validates before calling; language dispatch stays generic.
 (glue "(let* ((actual-callee " (emit function (operand-options options)) ") "
      "(actual-arguments " (emit arguments (operand-options options)) ")) "
      (source-call node (glue "(" operation " actual-callee actual-arguments)") options) ")"))
(defn- linked-operands
 "Bind operands in source order to fresh a<i> variables. With :inline?, a
  variable or literal operand (no effect, no order) is passed in place.
  Returns [binds operands]: an Erlang list of bindings, a vector of operands."
 [inline? args options]
 (let [operand (operand-options options)
       parts (Enum/map (indexed args) (fn [pair]
               (let [arg (erlang/element 1 pair) i (erlang/element 2 pair)
                     value (emit arg operand)]
                (if (and inline? (or (= :var (:op arg)) (= :lit (:op arg)))) [nil value]
                 [(glue "(" (operand-name i) " " value ")") (operand-name i)]))))]
  [(Enum/filter (Enum/map parts (fn [part] (first part))) (fn [b] (some? b)))
   (vec (Enum/map parts (fn [part] (second part))))]))
(defn- linked-call
 "An AOT-linked remote: {:call (fn [operands] expression) :inline? bool}.
  The target cell is read after its operands, as the live wrapper did."
 [node link args options]
 (let [[binds operands] (linked-operands (:inline? link) args options)
       call (source-call node ((:call link) operands) options)]
  (if (empty? binds) call (glue "(let* (" (spaced binds) ") " call ")"))))
(defn- static-arguments [n]
 (loop [n n items []]
  (case (:op n) :enil items :cons (recur (:tail n) (conj items (:head n))) nil)))
(declare self-knot?)
(defn- procedure-self?
 "A self-call's callee: the `letrec` local of a function scaffold, always a procedure."
 [function options]
 (and (self-knot? function options) (contains? (or (:procedure-selves options) #{}) (:name (:fn function)))))
(defn- global-call-link
 "A sealed plan's direct link for a :global callee called with `arity` static
  arguments (:aot-link :global, native.bootstrap/global-link), or nil."
 [function arity options]
 (when-let [hook (:global (:aot-link options))]
  (when (= :global (:op function)) (hook function arity))))
(defn- linked-language-call
 "AOT invoke fast path: a sealed global target is called through its arity
  cell; a procedure is applied directly; every other callee takes bl-invoke.
  Callee first, then arguments, in source order."
 [function arguments options]
 (let [statics (static-arguments arguments)
       global (when statics (global-call-link function (count statics) options))]
  (if global (linked-call nil global statics options)
  (let [direct? (procedure-self? function options)
        cell (when (and direct? statics)
               (let [c (get (or (:self-cells options) {}) (:name (:fn function)))]
                (when (and c (= (second c) (count statics))) (first c))))
        callee (emit function (operand-options options))]
  (cond
   cell
   (let [[binds operands] (linked-operands true statics options)
         call (glue "(" cell (Enum/join (Enum/map (items operands) (fn [o] (glue " " o))) "") ")")]
    (if (empty? binds) call (glue "(let* (" (spaced binds) ") " call ")")))
   statics
   (let [[binds operands] (linked-operands true statics options)
         spread (Enum/join (Enum/map (items operands) (fn [o] (glue " " o))) "")
         call (if direct? (glue "(callee" spread ")")
                (glue "(if (procedure? callee) (callee" spread ") (bl-invoke callee (list" spread ")))"))]
    (glue "(let ((callee " callee ")) "
         (if (empty? binds) call (glue "(let* (" (spaced binds) ") " call ")")) ")"))
   :else
   (glue "(let* ((callee " callee ") (arguments " (emit arguments (operand-options options)) ")) "
        (if direct? "(apply callee arguments))"
          "(if (procedure? callee) (apply callee arguments) (bl-invoke callee arguments)))")))))))
(defn- ordered-language-call [node function arguments options]
 (cond
  (:source-frames? options) (ordered-target-call node function arguments "bl-invoke" options)
  (:aot-link options) (linked-language-call function arguments options)
  :else (ordered "bl-invoke" [function arguments] options)))

(defn- binders-into
 "Prepend p's binder names to `acc` (so `acc` is in reverse source order)."
 [p acc]
 (case (:pop p)
  :pvar (cons (:name p) acc)
  :ptuple (Enum/reduce (items (:elems p)) acc (fn [x acc] (binders-into x acc)))
  :pcons (binders-into (:tail p) (binders-into (:head p) acc))
  :palias (binders-into (:b p) (binders-into (:a p) acc))
  :pmap (Enum/reduce (items (:pairs p)) acc (fn [pair acc] (binders-into (second pair) acc)))
  :pstruct (Enum/reduce (items (:fields p)) acc (fn [field acc] (binders-into (second field) acc)))
  acc))
(defn binders [p] (Enum/reverse (binders-into p (list))))
(defn- patterns-binders [pats] (Enum/reduce (items pats) (list) (fn [p acc] (binders-into p acc))))

; Facts (:facts, a BeamLisp.Optimize fact environment: Source name -> value fact)
; come from the shared ANF fact pass that BEAM's optimizer reads too. Every
; Scheme binder of a Source name forgets that name's fact. `names` is a
; function returning the names, so no binder list is built without facts.
(defn- forget-facts [options names]
 (let [facts (:facts options)]
  (if (empty? facts) options
   (let [names (items (names))]
    (if (any-of? names (fn [name] (contains? facts name)))
     (assoc options :facts (BeamLisp.Optimize/forget facts names)) options)))))

; Patterns compile to decision code on the subject. A continuation carries the
; lexical bindings at EMISSION time: no pattern data, runtime binding alist or
; variable-name lookup is emitted. Semantics are host bl-match's (host-values):
; bl-key-equal? literals and repeated variables, `_` never unifies, map keys
; must be present, struct module/fields through bl-match-struct-fields.
; Host temporaries are named by pattern path (pm/pv/pe/pf/pk + path); Source
; locals are ident-encoded v_*, so neither can capture the other.
(defn- pattern-child [path component]
 (glue path "_" (if (integer? component) (erlang/integer_to_binary component) component)))
(defn- vector-items-pattern [p]
 (or (second (first (:fields p))) (refuse {:op (:pop p)})))
(defn- vector-pattern? [p] (and (= :pstruct (:pop p)) (= :Elixir.BeamLisp.Vector (:mod p))))
(defn- key-bindings-into
 "Prepend p's non-literal map-pattern keys with their paths, [path key-node],
  to `acc` in reverse order. They are evaluated once per clause attempt, before
  matching, in the clause's scope."
 [p path acc]
 (case (:pop p)
  :ptuple (Enum/reduce (indexed (:elems p)) acc (fn [pair acc]
            (key-bindings-into (erlang/element 1 pair) (pattern-child path (erlang/element 2 pair)) acc)))
  :pcons (key-bindings-into (:tail p) (pattern-child path "t")
          (key-bindings-into (:head p) (pattern-child path "h") acc))
  :palias (key-bindings-into (:b p) (pattern-child path "b")
           (key-bindings-into (:a p) (pattern-child path "a") acc))
  :pmap (Enum/reduce (indexed (:pairs p)) acc (fn [entry acc]
          (let [pair (erlang/element 1 entry) i (erlang/element 2 entry)
                acc (if (= :lit (:op (first pair))) acc
                      (cons [(pattern-child path (glue "k" (erlang/integer_to_binary i))) (first pair)] acc))]
           (key-bindings-into (second pair) (pattern-child path (glue "m" (erlang/integer_to_binary i))) acc))))
  :pstruct (if (vector-pattern? p)
             (key-bindings-into (vector-items-pattern p) (pattern-child path "v") acc)
             (Enum/reduce (indexed (:fields p)) acc (fn [entry acc]
               (key-bindings-into (second (erlang/element 1 entry))
                (pattern-child path (glue "m" (erlang/integer_to_binary (erlang/element 2 entry)))) acc))))
  acc))
(defn- tag-test [subject tag]
 (glue "(and (vector? " subject ") (= (vector-length " subject ") 2) (eq? (vector-ref " subject " 0) '" tag "))"))
(defn- literal-test [v subject]
 ; bl-key-equal? against a non-boolean keyword or an exact integer is eq?/eqv?.
 (cond (and (keyword? v) (not (contains? #{"true" "false" "nil"} (erlang/atom_to_binary v))))
        (glue "(eq? " subject " " (literal v) ")")
       (integer? v) (glue "(eqv? " subject " " (erlang/integer_to_binary v) ")")
       :else (glue "(bl-key-equal? " (literal v) " " subject ")")))
(defn- with-subject [subject path k]
 (if (string/starts-with? subject "(")
  (let [local (glue "pm" path)] (glue "(let ((" local " " subject ")) " (k local) ")"))
  (k subject)))
(declare match-pattern)
(defn- match-each [items bound keys success failure]
 (if (empty? items) (success bound)
  (let [item (first items)]
   (match-pattern (nth item 0) (nth item 1) (nth item 2) bound keys
    (fn [next-bound] (match-each (rest items) next-bound keys success failure)) failure))))
(defn- match-entries [entries fields bound keys success failure]
 (if (empty? entries) (success bound)
  (let [entry (first entries) child (nth entry 2) local (glue "pe" child)]
   (glue "(let ((" local " (bl-match-entry " fields " " (nth entry 0) "))) (if " local " "
        (match-pattern (nth entry 1) (glue "(cdr " local ")") child bound keys
         (fn [next-bound] (match-entries (rest entries) fields next-bound keys success failure)) failure)
        " " failure "))"))))
(defn- match-indexed [patterns accessor path bound keys success failure]
 (match-each (Enum/map (indexed patterns) (fn [pair]
              (let [i (erlang/element 2 pair)] [(erlang/element 1 pair) (accessor i) (pattern-child path i)])))
  bound keys success failure))
(defn- match-pattern [p subject path bound keys success failure]
 (case (:pop p)
  :pvar (let [name (:name p)]
          (cond (= name "_") (success bound)
                (contains? bound name)
                 (glue "(if (bl-key-equal? " (get bound name) " " subject ") " (success bound) " " failure ")")
                :else (let [local (ident name)]
                       (glue "(let ((" local " " subject ")) " (success (assoc bound name local)) ")"))))
  :plit (glue "(if " (literal-test (:val p) subject) " " (success bound) " " failure ")")
  :pnil (glue "(if (null? " subject ") " (success bound) " " failure ")")
  :pcons (with-subject subject path (fn [s]
           (glue "(if (pair? " s ") "
            (match-each [[(:head p) (glue "(car " s ")") (pattern-child path "h")]
                         [(:tail p) (glue "(cdr " s ")") (pattern-child path "t")]] bound keys success failure)
            " " failure ")")))
  :palias (with-subject subject path (fn [s]
            (match-each [[(:a p) s (pattern-child path "a")] [(:b p) s (pattern-child path "b")]] bound keys success failure)))
  :ptuple (with-subject subject path (fn [s]
            (let [elems (:elems p) storage (glue "pv" path)]
             (glue "(if (and " (tag-test s "tuple") " (= (vector-length (vector-ref " s " 1)) "
                  (erlang/integer_to_binary (count elems)) ")) "
              (if (empty? elems) (success bound)
               (glue "(let ((" storage " (vector-ref " s " 1))) "
                (match-indexed elems (fn [i] (glue "(vector-ref " storage " " (erlang/integer_to_binary i) ")"))
                 path bound keys success failure) ")"))
              " " failure ")"))))
  :pmap (with-subject subject path (fn [s]
          (glue "(if " (tag-test s "map") " "
           (match-entries (Enum/map (indexed (:pairs p)) (fn [entry]
             (let [pair (erlang/element 1 entry) i (erlang/element 2 entry) k (first pair)]
              [(if (= :lit (:op k)) (literal (:val k)) (get keys (pattern-child path (glue "k" (erlang/integer_to_binary i)))))
               (second pair) (pattern-child path (glue "m" (erlang/integer_to_binary i)))]))) s bound keys success failure)
           " " failure ")")))
  :pstruct
  (if (vector-pattern? p)
   ; Host bl-match matches a vector's items as a tuple of its elements.
   (let [inner (vector-items-pattern p) inner-path (pattern-child path "v")]
    (with-subject subject path (fn [s]
     (if (= :ptuple (:pop inner))
      (glue "(if (and " (tag-test s "vec") " (= (bl-match-vector-count " s ") "
           (erlang/integer_to_binary (count (:elems inner))) ")) "
           (match-indexed (:elems inner) (fn [i] (glue "(bl-match-vector-ref " s " " (erlang/integer_to_binary i) ")"))
            inner-path bound keys success failure)
           " " failure ")")
      (glue "(if " (tag-test s "vec") " "
           (match-pattern inner (glue "(bl-match-vector-items " s ")") inner-path bound keys success failure)
           " " failure ")")))))
   (with-subject subject path (fn [s]
    (let [fields (glue "pf" path)]
     (glue "(let ((" fields " (bl-match-struct-fields " s " " (literal (:mod p)) "))) (if " fields " "
      (match-entries (Enum/map (indexed (:fields p)) (fn [entry]
                       (let [field (erlang/element 1 entry)]
                        [(literal (first field)) (second field)
                         (pattern-child path (glue "m" (erlang/integer_to_binary (erlang/element 2 entry))))])))
                      fields bound keys success failure)
      " " failure "))")))))
  (refuse {:op (:pop p)})))
(defn- match-arguments [patterns argv index bound keys success failure]
 (if (empty? patterns)
  (glue "(if (null? " argv ") " (success bound) " " failure ")")
  (glue "(if (pair? " argv ") "
   (match-pattern (first patterns) (glue "(car " argv ")") (erlang/integer_to_binary index) bound keys
    (fn [next-bound] (match-arguments (rest patterns) (glue "(cdr " argv ")") (inc index) next-bound keys success failure)) failure)
   " " failure ")")))

; Guards that provably cannot raise skip bl-guard's exception catcher. Total:
; literals, variables, if-chains of total parts, unary erlang type tests,
; equality against a non-text atomic literal, integer intrinsics on integer
; facts, and `not` of a boolean test. Anything else keeps bl-guard semantics.
(def ^:private type-tests
 #{:is_integer :is_float :is_number :is_binary :is_bitstring :is_boolean :is_atom
   :is_tuple :is_list :is_map :is_function :is_pid :is_port :is_reference})
(def ^:private equalities #{:== :=:= :/= :=/=})
(def ^:private comparisons #{:== :=:= :/= :=/= :< :> :=< :>=})
(defn- boolean-test?
 "An erlang BIF whose result is always true or false (never nil)."
 [n]
 (and (= :remote (:op n)) (= :erlang (:mod n))
      (let [arity (count (:args n)) f (:fun n)]
       (or (and (= 1 arity) (or (contains? type-tests f) (= :not f)))
           (and (= 2 arity) (contains? comparisons f))))))
(defn- atomic-literal? [n]
 (and (= :lit (:op n))
      (let [v (:val n)] (or (nil? v) (= v true) (= v false) (keyword? v) (integer? v) (erlang/is_float v)))))
(declare integer-intrinsic integer-branch)
(defn- total? [n options]
 (case (:op n)
  :lit true
  :var true
  :if (and (total? (:test n) options) (total? (:then n) (integer-branch options (:test n)))
           (total? (:else n) options))
  :remote (let [args (items (:args n)) f (:fun n) arity (count args)]
           (and (= :erlang (:mod n)) (Enum/all? args (fn [arg] (total? arg options)))
                (or (some? (integer-intrinsic n options))
                    (and (= 1 arity) (contains? type-tests f))
                    (and (= 2 arity) (contains? equalities f) (any-of? args (fn [arg] (atomic-literal? arg))))
                    (and (= 1 arity) (= :not f)
                         (or (boolean-test? (first args))
                             (and (= :lit (:op (first args))) (contains? #{true false} (:val (first args)))))))))
  false))
; Boolean values. The compiler expands `(and a b)` to `(let [x a] (if x b x))`
; and `(or a b)` to `(let [x a] (if x x b))`. When `a` is #t or #f, the
; junction's own test is a plain `if`; when its branches are boolean too, so is
; its value, and an enclosing test needs no truthiness wrapper either.
(declare boolean-valued?)
(defn- boolean-junction?
 "`(let [x init] (if x then else))` whose init is always #t or #f."
 [n options]
 (let [body (:body n) test (:test body)]
  (and (= :let (:op n)) (= :if (:op body)) (= :var (:op test)) (= (:name n) (:name test))
       (boolean-valued? (:init n) options))))
(defn- junction-part? [n name options]
 (or (and (= :var (:op n)) (= name (:name n))) (boolean-valued? n options)))
(defn- boolean-valued?
 "An expression whose value is always #t or #f: a guard-position erlang BIF
  (boolean-test?), a boolean literal, an `if` of boolean branches, a boolean
  junction of boolean parts, or anything the shared fact pass (:facts, a
  BeamLisp.Optimize fact environment) tags :bool, such as a variable bound to one."
 [n options]
 (or (case (:op n)
      :lit (or (= true (:val n)) (= false (:val n)))
      :remote (boolean-test? n)
      :if (and (boolean-valued? (:then n) options) (boolean-valued? (:else n) options))
      :let (and (boolean-junction? n options)
                (junction-part? (:then (:body n)) (:name n) options)
                (junction-part? (:else (:body n)) (:name n) options))
      false)
     (BeamLisp.Optimize/bool-fact? (BeamLisp.Optimize/expr n (or (:facts options) {})))))
(defn- branch
 "Inline BL truthiness: everything except false and nil is true. The host
  local `t` cannot capture an ident-encoded Source local."
 [test-node test then else options]
 (if (boolean-valued? test-node options) (glue "(if " test " " then " " else ")")
  (glue "(let ((t " test ")) (if (or (eq? t #f) (eq? t bl-nil)) " else " " then "))")))

(defn- distinct-names? [names] (= (count names) (count (Enum/uniq names))))
(defn- irrefutable? [cl]
 (let [pats (items (:pats cl))]
  (and (nil? (:guard cl)) (Enum/all? pats (fn [p] (= :pvar (:pop p))))
       (distinct-names? (Enum/filter (Enum/map pats (fn [p] (:name p))) (fn [name] (not= "_" name)))))))
(defn clauses
 "Compile a clause chain. `subjects` is a vector of host locals (one per
  pattern; a clause of another width never matches) or, for a mixed-width
  function, the Scheme name of its argument list. Pattern and guard failure
  share ONE suspended suffix: duplicating it at every failure site grows
  exponentially across clauses. Only the constant `fallback` is inlined."
 [cs subjects fallback options wrap?]
 (if (empty? cs) fallback
  (let [cl (first cs) pats (items (:pats cl))
        argv (when (string? subjects) subjects)
        fits? (or (some? argv) (= (count pats) (count subjects)))
        final? (empty? (rest cs))
        ; Later clauses are unreachable behind a clause that cannot fail.
        exhaustive? (and fits? (nil? argv) (irrefutable? cl))
        more (when-not (or final? exhaustive?) (clauses (rest cs) subjects fallback options wrap?))]
   (if-not fits? (or more fallback)
    (let [next (if final? fallback "(clause-next)")
          options (forget-facts options (fn [] (patterns-binders pats)))
          body (emit (:body cl) options)
          body (if wrap? (glue "(bl-vec (list " (literal :match) " (lambda () " body ")))") body)
          guard (:guard cl)
          guard-options (assoc (operand-options options) :source-frames? false)
          body (cond (nil? guard) body
                     (total? guard guard-options) (branch guard (emit guard guard-options) body next guard-options)
                     :else (glue "(if (bl-guard (lambda () " (emit guard guard-options) ")) " body " " next ")"))
          _ (when-let [counts (:emission-counts options)]
              (swap! counts update :compiled-pattern-clauses (fnil inc 0)))
          key-bindings (Enum/reverse (Enum/reduce (indexed pats) (list) (fn [pair acc]
                         (key-bindings-into (erlang/element 1 pair) (erlang/integer_to_binary (erlang/element 2 pair)) acc))))
          keys (Enum/reduce key-bindings {} (fn [binding keys] (assoc keys (first binding) (glue "pk" (first binding)))))
          arm (if argv
                (match-arguments pats argv 0 {} keys (fn [_] body) next)
                (match-each (Enum/map (indexed pats) (fn [pair]
                              (let [i (erlang/element 2 pair)]
                               [(erlang/element 1 pair) (nth subjects i) (erlang/integer_to_binary i)])))
                 {} keys (fn [_] body) next))
          arm (if (empty? key-bindings) arm
                (glue "(let* (" (spaced (Enum/map key-bindings (fn [binding]
                  (glue "(pk" (first binding) " " (emit (second binding) guard-options) ")")))) ") " arm ")"))]
     (if more (glue "(let ((clause-next (lambda () " more "))) " arm ")") arm))))))

; Budget sites. A turn budget is spent by (h-tick) at every loop back-edge
; (the named-let head of a lowered loop) and at the entry of every function
; whose body can call BL code (`body-calls?`). A function that cannot call BL
; code runs a bounded straight line between ticks, so it pays none, whether
; its caller knows it or not. Every cycle of BL control passes through one
; of these ticks: see speed/frames/RESULT.md.
(declare body-calls?)
(defn- function-entry [body site tick?]
 (let [body (if tick? (glue "(h-tick) " body) body)]
  (if site (glue "(bl-source-enter " site ") " body) body)))

(defn- fixed-function [formals body fallback site tick?]
 ; Gambit's case-lambda keeps wrong-arity calls on the original entry frame
 ; and function-clause path; that arm only raises, so it never ticks.
 ; Gambit 4.9.5's macro needs an optional position when a rest arm is
 ; present: a one-required rest fallback covers every nonzero arity of a
 ; zero-parameter function without capturing a Source variable.
 (glue "(case-lambda ((" (spaced formals) ") " (function-entry body site tick?) ") ("
      (if (empty? formals) "(extra . argv)" "argv") " " (function-entry fallback site false) "))"))
(def ^:private formal-table (erlang/list_to_tuple (Enum/map (lists/seq 0 63) (fn [i] (str "fa" i)))))
(defn- formal-names [n]
 (Enum/map (lists/seq 0 (dec n)) (fn [i] (if (< i 64) (erlang/element (inc i) formal-table)
                                           (glue "fa" (erlang/integer_to_binary i))))))
(def ^:private clause-fallback "(error \"native seed: function clause\")")
(defn- fixed-parts
 "nil for a mixed-width clause chain; else {:formals :body} of the fixed-arity
  function. One unguarded DISTINCT-variable clause binds its Source names as
  Scheme formals; other same-width chains match fixed formals directly."
 [n options]
 (let [clause (BeamLisp.CompilerData/simple_function_clause n)
       names (when clause (Enum/map (items (:pats clause)) (fn [p] (:name p))))
       cs (items (:clauses n))
       widths (Enum/uniq (Enum/map cs (fn [c] (count (:pats c)))))]
  (cond
   (and clause (distinct-names? names))
    {:formals (Enum/map names (fn [name] (ident name))) :body (emit (:body clause) options)}
   (= 1 (count widths))
    (let [formals (formal-names (first widths))]
     {:formals formals :body (clauses cs formals clause-fallback options false)})
   :else nil)))
(defn- function-ticks? [n options]
 (body-calls? (items (:clauses n)) {:verdicts (:loop-verdicts options)}))
(defn- function-expression
 "A fixed-arity function is a case-lambda (fixed-parts); only a mixed-width
  chain destructures its argument list."
 [n options frame]
 (let [site (when frame (frame-site frame false))
       tick? (function-ticks? n options)]
  (if-let [parts (fixed-parts n options)]
   (fixed-function (:formals parts) (:body parts) clause-fallback site tick?)
   (glue "(lambda argv " (function-entry (clauses (items (:clauses n)) "argv" clause-fallback options false) site tick?) ")"))))

(def arithmetic {:add "+" :sub "-" :mul "*" :div "bl-div" :lt "<" :gt ">" :le "<=" :ge ">=" :num_eq "="})
(def core-leaves
 {"get" "bl-get" "assoc" "bl-assoc" "conj" "bl-conj" "nth" "bl-nth"
  "first" "bl-first" "rest" "bl-rest" "empty?" "bl-empty" "count" "bl-count"
  "eqv" "bl-equal?" "=" "bl-equal?" "not" "bl-not" "not_" "bl-not" "nil?" "bl-is-nil" "str" "bl-str"
  "str_v" "bl-str-v" "list__bl_v" "bl-list-v" "hash_key" "bl-key-value"
  "list" "list" "cons" "cons" "inc" "bl-inc" "dec" "bl-dec"})
(def host-leaves
 #{"state" "set-state" "self" "set-self" "make-frames" "run-turn"
   "critical-enter" "critical-leave" "park-release" "now" "wait-until" "wait-input"
   "empty-map" "empty-list" "map-remove" "map-keys" "map-size" "vec-from-list" "vec-size" "vec-el"
   "vec-remove" "is-nil" "is-kw" "kw-name" "is-int" "is-str" "is-vec" "is-enil"
   "eq" "lt" "arith" "write" "str-cat" "describe" "raise" "record-error" "truthy"})
(defn remote [n options]
 (let [m (:mod n) f (erlang/atom_to_binary (:fun n))]
  (or (when-let [resolver (:remote-resolver options)] (resolver n))
   (cond (and (= m :host) (contains? host-leaves f)) (glue "h-" f)
        (and (contains? #{:Elixir.BeamLisp.Ns.Rt :Elixir.BeamLisp.Ns.Core} m) (get core-leaves f)) (get core-leaves f)
        (and (= m :Elixir.BeamLisp.Num) (get arithmetic (keyword f))) (get arithmetic (keyword f))
        (and (= m :erlang) (= f "not")) "not"
        (and (= m :erlang) (= f "exit") (= 1 (count (:args n)))) "h-exit"
        (and (= m :erlang) (contains? #{"==" "=:="} f)) "bl-equal?"
        (and (= m :erlang) (contains? #{">" "<" ">=" "=<" "+" "-" "*"} f))
          (if (= f "=<") "<=" f)
        :else (refuse n)))))

(defn- argument-list [args]
 (Enum/reduce (Enum/reverse (items args)) {:op :enil :ann {}}
  (fn [arg tail] {:op :cons :head arg :tail tail :ann {}})))

(defn- emit-try [n options]
 ; js.emit delivers body/catches to an assignment destination, even when
 ; the try expression is in function tail position. Preserve its live handler.
 (let [options (operand-options options)
       stack (BeamLisp.CompilerData/catch_stack_bindings)
       handler (clauses (items (:catch n)) ["caught-kind" "caught-reason"]
                   "(bl-reraise caught-kind caught-reason caught-trace)"
                   (forget-facts options (fn [] (list (:frames stack) (:raw stack)))) false)]
  (glue "(bl-try (lambda () " (emit (:body n) options) ") "
   "(lambda (caught-kind caught-reason caught-trace) (let ((" (ident (:frames stack)) " " (if (:source-frames? options) "(bl-trace-frames caught-trace)" "caught-trace") ") ("
   (ident (:raw stack)) " caught-trace)) " handler ")) "
   (if (:after n) (glue "(lambda () " (emit (:after n) options) ")") "#f") ")")))

(defn- self-parts [n]
 (BeamLisp.CompilerData/self_application_parts n))
(defn- loop-parts [n]
 (when (= :apply (:op n))
  (when-let [parts (self-parts (:fn n))]
   (let [clause (first (:clauses (:inner parts)))]
    {:self (:name (:fn n)) :vars (Enum/map (items (:pats clause)) (fn [p] (:name p)))
     :body (:body clause) :inits (items (:args n))}))))
(defn- recur-node? [n self]
 (let [g (:fn n)]
  (and (= :apply (:op n)) (= :apply (:op g)) (= :var (:op (:fn g)))
       (= self (:name (:fn g))))))
(defn- self-knot? [n options]
 (let [f (:fn n) args (:args n)]
  (and (= :apply (:op n)) (= :var (:op f))
       (contains? (or (:selves options) {}) (:name f))
       (= 1 (count args)) (= :var (:op (first args))) (= (:name f) (:name (first args))))))
; Loop safety: a checked self-recursive loop becomes a named let when its
; self is used ONLY as `((self self) args...)` with its own arity, in tail
; position of its body, and no let rebinds it. One walk over the outermost
; candidate's region decides every loop nested in it; the verdicts travel in
; options, so no subtree is walked twice. The walk threads its state
; {:candidates set :unsafe set} through return values: no atom, no seq.
(defn- structural-loop-parts [n]
 (when-let [parts (loop-parts n)]
  (let [clause (BeamLisp.CompilerData/simple_function_clause (:inner (self-parts (:fn n))))
        names (:vars parts)]
   (when (and clause (distinct-names? names)
              (= (count names) (count (:inits parts)))
              (not (lists/member (:self parts) names))) parts))))
(declare loop-walk loop-walk-clauses)
(defn- loop-unsafe [state self] (assoc state :unsafe (conj (:unsafe state) self)))
(defn- loop-walk-all [values active state]
 (Enum/reduce (items values) state (fn [value state] (loop-walk value nil active state))))
(defn- loop-walk
 "`tail` is the loop whose tail position this is (nil otherwise); `active`
  maps each enclosing loop's self to its arity. Returns the new state."
 [value tail active state]
 (cond
  (sequential? value) (loop-walk-all value active state)
  (erlang/is_map value)
  (case (:op value)
   :lit state
   :var (if (contains? active (:name value)) (loop-unsafe state (:name value)) state)
   :apply
   (let [g (:fn value)
         self (when (and (= :apply (:op g)) (= :var (:op (:fn g)))) (:name (:fn g)))]
    (if (and self (contains? active self))
     (loop-walk-all (:args value) active
      (if (and (= tail self) (= (get active self) (count (:args value)))
               (= 1 (count (:args g))) (= :var (:op (first (:args g))))
               (= self (:name (first (:args g)))))
       state (loop-unsafe state self)))
     (if-let [parts (structural-loop-parts value)]
      (let [self (:self parts) inside (assoc active self (count (:vars parts)))
            state (assoc state :candidates (conj (:candidates state) self))]
       (loop-walk (:body parts) self inside (loop-walk-all (:inits parts) inside state)))
      (loop-walk-all (:args value) active (loop-walk g nil active state)))))
   :let (loop-walk (:body value) tail active
         (loop-walk (:init value) nil active
          (if (contains? active (:name value)) (loop-unsafe state (:name value)) state)))
   :if (loop-walk (:else value) tail active
        (loop-walk (:then value) tail active (loop-walk (:test value) nil active state)))
   :do (let [statements (items (:stmts value))]
        (loop-walk (last statements) tail active (loop-walk-all (butlast statements) active state)))
   :remote (loop-walk-all (:args value) active state)
   :arith (loop-walk-all (:args value) active state)
   :invoke (loop-walk (:arguments value) nil active (loop-walk (:callee value) nil active state))
   :cons (loop-walk (:tail value) nil active (loop-walk (:head value) nil active state))
   :tuple (loop-walk-all (:elems value) active state)
   :global state
   :binding state
   :enil state
   :fn (loop-walk-clauses (:clauses value) active state)
   :case (loop-walk-clauses (:clauses value) active (loop-walk (:subj value) nil active state))
   :map (Enum/reduce (items (:pairs value)) state (fn [pair state]
         (loop-walk (second pair) nil active (loop-walk (first pair) nil active state))))
   :struct (Enum/reduce (items (:fields value)) state (fn [pair state]
            (loop-walk (second pair) nil active (loop-walk (first pair) nil active state))))
   ; Any other node walks every non-annotation value.
   (loop-walk-all (vals (dissoc value :ann)) active state))
  :else state))
(defn- loop-walk-clauses [clauses active state]
 (Enum/reduce (items clauses) state (fn [clause state]
  ; Patterns hold Source expressions only as map-pattern keys.
  (let [state (Enum/reduce (items (:pats clause)) state (fn [p state]
                (if (= :pvar (:pop p)) state (loop-walk-all (vals p) active state))))]
   (loop-walk (:body clause) nil active (loop-walk (:guard clause) nil active state))))))
(defn- loop-verdicts [n]
 (let [state (loop-walk n nil {} {:candidates #{} :unsafe #{}})]
  (Enum/reduce (items (:unsafe state)) (:candidates state) (fn [self verdicts] (disj verdicts self)))))
(defn- loop-plan
 "nil, or {:verdicts set [:parts loop-parts]} for a self-application node.
  Without :parts the node is emitted ordinarily, with the verdicts known."
 [n options]
 (when-let [parts (loop-parts n)]
  (let [known (:loop-verdicts options) verdicts (or known (loop-verdicts n))]
   (cond (contains? verdicts (:self parts)) {:parts parts :verdicts verdicts}
         (nil? known) {:verdicts verdicts}
         :else nil))))

; Can this function body (nested fn bodies excluded: they are functions with
; their own entry) pass control to BL code? `ctx` carries the loop verdicts in
; force and the
; self of the innermost lowered loop, whose recur is a jump, not a call. One
; walk per function; a loop region not covered by the verdicts in force gets
; its verdicts once, as loop-plan computes them.
(defn- primitive-remote?
 "A host primitive, OTP or Elixir function returns after work bounded by its
  finite arguments; a BL callback it runs is a function with its own entry.
  BL-compiled modules (Elixir.BeamLisp.*) and apply can run unbounded BL."
 [n]
 (let [m (:mod n)]
  (and (keyword? m) (not= :apply (:fun n))
       (not (string/starts-with? (erlang/atom_to_binary m) "Elixir.BeamLisp")))))
(defn- any-calls? [xs ctx] (any-of? (items xs) (fn [x] (body-calls? x ctx))))
(defn- body-calls? [n ctx]
 (cond
  (sequential? n) (any-calls? n ctx)
  (not (erlang/is_map n)) false
  :else
  (case (:op n)
   :lit false :var false :global false :binding false :enil false :fn false
   :apply
   (if-let [parts (loop-parts n)]
    (let [verdicts (or (:verdicts ctx) (loop-verdicts n)) inside (assoc ctx :verdicts verdicts)]
     (if (contains? verdicts (:self parts))
      (or (any-calls? (:inits parts) inside) (body-calls? (:body parts) (assoc inside :loop (:self parts))))
      true))
    (if (and (:loop ctx) (recur-node? n (:loop ctx))) (any-calls? (:args n) ctx) true))
   :invoke true
   :recv true
   :remote (or (not (primitive-remote? n)) (any-calls? (:args n) ctx))
   (any-calls? (vals (dissoc n :ann)) ctx))))

(defn- integer-operand? [n options]
 (or (and (= :lit (:op n)) (erlang/is_integer (:val n)))
     (BeamLisp.Optimize/int-fact? (BeamLisp.Optimize/expr n (or (:facts options) {})))))
(defn- integer-binding [options name value]
 (let [facts (or (:facts options) {})
       bound (BeamLisp.Optimize/bind facts name value)]
  ; Unchanged options when there is nothing to know or to forget.
  (if (and (empty? (get bound name)) (not (contains? facts name))) options
   (assoc options :facts bound))))
(defn- integer-branch [options test]
 (let [facts (or (:facts options) {}) refined (BeamLisp.Optimize/refine facts test)]
  (if (erlang/=:= facts refined) options (assoc options :facts refined))))
(defn- integer-intrinsic [node options]
 (when (and (= :erlang (:mod node)) (= 2 (count (:args node)))
            (Enum/all? (items (:args node)) (fn [arg] (integer-operand? arg options))))
  (get {:+ "+" :- "-" :* "*" :== "=" :=:= "=" :< "<" :=< "<=" :> ">" :>= ">="} (:fun node))))

(def ^:private loop-initial-table
 (erlang/list_to_tuple (Enum/map (lists/seq 0 63) (fn [i] (str "loop-initial-" i)))))
(defn- emit-source-loop [n parts options]
 (let [_ (when (:emission-counts options)
           (swap! (:emission-counts options) update :direct-loops (fnil inc 0)))
       variables (:vars parts)
       loop-name (ident (glue "$loop/" (:self parts)))
       operand (operand-options options)
       inits (indexed (:inits parts))
       names (Enum/map inits (fn [pair] (let [i (erlang/element 2 pair)]
               (if (< i 64) (erlang/element (inc i) loop-initial-table) (glue "loop-initial-" (erlang/integer_to_binary i))))))
       bindings (Enum/map (Enum/zip names inits) (fn [pair]
                  (glue "(" (erlang/element 1 pair) " " (emit (erlang/element 1 (erlang/element 2 pair)) operand) ")")))
       parameters (Enum/map (Enum/zip variables names) (fn [pair]
                    (glue "(" (ident (erlang/element 1 pair)) " " (erlang/element 2 pair) ")")))
       ; A loop's initial value does not establish an inductive type fact.
       ; Remove parameter facts; explicit guards inside its body refine them.
       options (forget-facts options (fn [] variables))
       body (emit (:body parts) (assoc options :loop {:self (:self parts) :name loop-name}))]
  (glue "(let* (" (spaced bindings) ") (let " loop-name " (" (spaced parameters)
       ") (h-tick) " body "))")))
(defn- emit-source-function [n options]
 (let [arity (count (:pats (first (:clauses n))))
       function-name (:fn-label options)
       inside (assoc options :source-fn function-name :source-ns (or (:definition-ns options) (:ns options))
                     :source-arity arity :fn-label nil :tail? true :loop nil)
       frame (merge {:file nil :line nil :col nil :end-line nil :end-col nil} (:ann n)
                    {:ns (or (:definition-ns options) (:ns options)) :fn function-name :arity arity :call :direct})
       function (function-expression n inside frame)]
  (if (:callable-arities? options) (glue "(bl-register-callable! " function " " (erlang/integer_to_binary arity) ")") function)))
(defn- emit-source-scaffold [n parts options]
 ; The local is bound to the emitted :fn, a procedure (bl-register-callable!
 ; returns its procedure), so a self-call applies it directly.
 (let [self (:name n) local (ident self)
       procedures (or (:procedure-selves options) #{})
       body (emit (:inner parts) (assoc (forget-facts options (fn [] (list self)))
                                        :selves (assoc (or (:selves options) {}) self local)
                                        :procedure-selves (if (= :fn (:op (:inner parts))) (conj procedures self)
                                                            (disj procedures self))
                                        :self-cells (dissoc (or (:self-cells options) {}) self)))]
  (glue "(letrec ((" local " " body ")) " local ")")))

(defn- multi-layout [n]
 ; The compiler's exact $blfn constructor, with checked inert function
 ; scaffolds in its slots. This is the same container js.emit/emit-blfn owns.
 (when (and (= :tuple (:op n)) (= 3 (count (:elems n))))
  (let [[tag fixed variadic] (:elems n) pairs (:pairs fixed)
        var? (= :tuple (:op variadic))]
   (when (and (= :lit (:op tag)) (= :"$blfn" (:val tag)) (= :map (:op fixed))
               (erlang/is_list pairs)
               (Enum/all? pairs (fn [pair]
                 (and (= 2 (count pair)) (= :lit (:op (first pair)))
                      (integer? (:val (first pair))) (>= (:val (first pair)) 0))))
               (= (count pairs) (count (Enum/uniq (Enum/map pairs (fn [pair] (:val (first pair)))))))
               (or (and (= :lit (:op variadic)) (nil? (:val variadic)))
                   (and var? (= 2 (count (:elems variadic)))
                        (= :lit (:op (first (:elems variadic))))
                        (integer? (:val (first (:elems variadic))))
                        (>= (:val (first (:elems variadic))) 0))))
    (let [arms (Enum/map pairs (fn [pair] (second pair)))
          arms (if var? (lists/append arms (list (second (:elems variadic)))) arms)]
     (when (and (not (empty? arms))
                (Enum/all? arms (fn [arm] (some? (BeamLisp.CompilerData/self_application_parts arm)))))
      {:tag tag :fixed pairs :variadic (when var? variadic) :arms arms}))))))
(defn- emit-multi-arm [node target options]
 (let [parts (BeamLisp.CompilerData/self_application_parts node)
       self (:name node)
       inside (assoc (dissoc options :self-target)
                     :selves (assoc (or (:selves options) {}) self target)
                     :procedure-selves (disj (or (:procedure-selves options) #{}) self)
                     :self-cells (dissoc (or (:self-cells options) {}) self))]
  ; Original ANF uses (self self) for its self value. Bind that ORIGINAL
  ; scaffold variable to a one-argument thunk of the WHOLE dispatcher.
  ; The arm still receives its original parameters/rest-list convention.
  (glue "(let ((" (ident self) " (lambda (ignored-self) " target "))) "
       (emit (:inner parts) inside) ")")))
(defn- emit-multi [layout options]
 ; Same emission order as before: fixed keys, variadic tag, arms, $blfn tag.
 (let [target (ident (glue "$multi/" (:name (first (:arms layout)))))
       fixed (:fixed layout) variadic (:variadic layout)
       arms (Enum/map (indexed fixed) (fn [entry]
              (let [pair (erlang/element 1 entry)]
               [(glue "multi-arm-" (erlang/integer_to_binary (erlang/element 2 entry))) (first pair) (second pair)])))
       fixed-source (glue "(bl-map " (spaced (Enum/flat_map arms (fn [arm] (list (emit (nth arm 1) options) (nth arm 0))))) ")")
       variadic-source (if variadic (glue "(bl-make-tuple " (emit (first (:elems variadic)) options) " multi-variadic-arm)") "bl-nil")
       bindings (Enum/map arms (fn [arm] (glue "(" (nth arm 0) " " (emit-multi-arm (nth arm 2) target options) ")")))
       bindings (if variadic (lists/append bindings (list (glue "(multi-variadic-arm "
                                 (emit-multi-arm (second (:elems variadic)) target options) ")"))) bindings)]
  (glue "(let ((" target " bl-nil)) (let* (" (spaced bindings) ") "
       "(set! " target " (bl-make-tuple " (emit (:tag layout) options) " " fixed-source " " variadic-source ")) "
       target "))")))

(defn- emit-junction
 "A boolean junction, emitted as `:let` and `:if` emit it, with the plain test."
 [n options]
 (let [local (ident (:name n)) body (:body n)
       init (emit (:init n) (operand-options options))
       options (integer-binding options (:name n) (:init n))]
  (glue "(let ((" local " " init ")) (if " local " "
       (emit (:then body) (integer-branch options (:test body))) " " (emit (:else body) options) "))")))
; Keyword dispatch. A chain `(cond (== x :a) A (== x :b) B … :else E)` whose
; AOT templates are exactly `(eq? x KEYWORD)` becomes one Scheme `case` on the
; interned symbol (eqv? is eq? on symbols). The tests are a variable and a
; literal: emitting them has no effect, so only the branches are emitted, in
; their source order.
(defn- plain-keyword? [n]
 (and (= :lit (:op n)) (keyword? (:val n))
      (not (contains? #{"true" "false" "nil"} (erlang/atom_to_binary (:val n))))))
(defn- keyword-test
 "[name datum] when `n` is an AOT-linked `==`/`=:=` of variable `name` and a
  plain keyword whose template is exactly `(eq? variable keyword)`."
 [n options]
 (when (and (= :remote (:op n)) (= :erlang (:mod n)) (contains? #{:== :=:=} (:fun n)))
  (let [args (items (:args n))]
   (when (= 2 (count args))
    (let [a (erlang/hd args) b (erlang/hd (erlang/tl args))
          side (cond (and (= :var (:op a)) (plain-keyword? b)) 1
                     (and (= :var (:op b)) (plain-keyword? a)) 0
                     :else nil)]
     (when side
      (let [variable (if (= side 1) a b) k (:val (if (= side 1) b a))
            datum (keyword-datum (erlang/atom_to_binary k))
            link (when datum ((:remote (:aot-link options)) n))]
       (when (and link (not (:inline? link))
                  (= (if (= side 1) "(eq? a0 a1)" "(eq? a1 a0)") ((:call link) ["a0" "a1"])))
        [(:name variable) datum]))))))))
(defn- keyword-dispatch
 "nil, or {:subject name :arms (reversed list of [datum node]) :else node} for
  a chain of at least two `if`s testing one variable against distinct keywords."
 [n options]
 (when (and (:aot-link options) (not (:source-frames? options)))
  (when-let [first-test (keyword-test (:test n) options)]
   (let [subject (first first-test)]
    (loop [node (:else n) arms (list [(second first-test) (:then n)]) seen #{(second first-test)}]
     (let [t (when (= :if (:op node)) (keyword-test (:test node) options))]
      (if (and t (= subject (first t)) (not (contains? seen (second t))))
       (recur (:else node) (cons [(second t) (:then node)] arms) (conj seen (second t)))
       (when (not (erlang/=:= (erlang/tl arms) ())) {:subject subject :arms arms :else node}))))))))
(defn- emit-keyword-dispatch [dispatch options]
 (let [arms (Enum/map (Enum/reverse (:arms dispatch)) (fn [arm] [(first arm) (emit (second arm) options)]))
       otherwise (emit (:else dispatch) options)
       ; Adjacent arms with the same code share one clause: groups of
       ; {reversed datums, code}, in reverse.
       groups (Enum/reduce arms (list) (fn [arm acc]
                (if (and (not (erlang/=:= acc ())) (= (second arm) (erlang/element 2 (erlang/hd acc))))
                 (cons (erlang/list_to_tuple (list (cons (first arm) (erlang/element 1 (erlang/hd acc))) (second arm)))
                       (erlang/tl acc))
                 (cons (erlang/list_to_tuple (list (list (first arm)) (second arm))) acc))))]
  (glue "(case " (ident (:subject dispatch)) " "
       (spaced (Enum/map (Enum/reverse groups) (fn [group]
        (glue "((" (spaced (Enum/reverse (erlang/element 1 group))) ") " (erlang/element 2 group) ")"))))
       " (else " otherwise "))")))
(defn- clauses-binders [cs]
 (Enum/reduce (items cs) (list) (fn [clause acc]
  (Enum/reduce (items (:pats clause)) acc (fn [p acc] (binders-into p acc))))))
(defn- pairs-operands [pairs] (Enum/flat_map (items pairs) (fn [pair] (items pair))))
(defn emit [n options]
 (if-let [layout (multi-layout n)] (emit-multi layout options)
 ; Checked self-recursive loops become named lets, in release and in
 ; source-frame emission alike; an unchecked one runs as calls.
 (if-let [plan (loop-plan n options)]
  (let [options (assoc options :loop-verdicts (:verdicts plan))]
   (if (:parts plan) (emit-source-loop n (:parts plan) options) (emit n options)))
 (cond
  (and (:loop options) (recur-node? n (:self (:loop options))))
   (ordered (:name (:loop options)) (:args n) (operand-options options))
  (self-knot? n options) (get (:selves options) (:name (:fn n)))
  (and (= :let (:op n)) (self-parts n)) (emit-source-scaffold n (self-parts n) options)
  (boolean-junction? n options) (emit-junction n options)
  :else
 (case (:op n)
  :lit (hoisted (literal (:val n)) options)
  :var (ident (:name n))
  :global (or (when-let [resolver (:global-resolver options)] (resolver n))
          (if (and (= (:ns options) (:ns n)) (contains? (:definitions options) (:name n)))
            (ident (:name n))
            (or (when (contains? #{"core" "rt"} (:ns n)) (get core-leaves (:name n))) (refuse n))))
  :binding (or (when-let [resolver (:binding-resolver options)] (resolver n)) (refuse n))
  :remote (if (and (:source-frames? options) (= :erlang (:mod n))
                    (= :apply (:fun n)) (= 2 (count (:args n))))
            (ordered-target-call n (first (:args n)) (second (:args n)) "native-raw-apply" options)
            (if-let [link (when-let [aot (:aot-link options)] ((:remote aot) n))]
             (linked-call n link (:args n) options)
            (let [callee (remote n options) intrinsic (integer-intrinsic n options)]
             ; Resolve first so the exact pinned primitive remains in the
             ; artifact's activation check even when its call is eliminated.
             (when (and intrinsic (:emission-counts options))
              (swap! (:emission-counts options) update :integer-intrinsics (fnil inc 0)))
             (ordered-call n (or intrinsic callee) (:args n) options))))
  :arith (if-let [f (or (when-let [resolver (:arithmetic-resolver options)] (resolver n))
                       (get arithmetic (:fun n)))] (ordered f (:args n) options) (refuse n))
  :apply (ordered-language-call n (:fn n) (argument-list (:args n)) options)
  :invoke (ordered-language-call n (:callee n) (:arguments n) options)
  :let (glue "(let ((" (ident (:name n)) " " (emit (:init n) (operand-options options)) ")) " (emit (:body n) (integer-binding options (:name n) (:init n))) ")")
  :if (if-let [dispatch (keyword-dispatch n options)] (emit-keyword-dispatch dispatch options)
       (branch (:test n) (emit (:test n) (operand-options options))
               (emit (:then n) (integer-branch options (:test n))) (emit (:else n) options) options))
  :do (let [statements (items (:stmts n))]
        (glue "(begin " (if (empty? statements) "bl-nil"
          (glue (joined (butlast statements) (operand-options options)) " " (emit (last statements) options))) ")"))
  :fn (let [options (forget-facts options (fn [] (clauses-binders (:clauses n))))]
       (if (:source-frames? options) (emit-source-function n options)
       (let [function (function-expression n options nil)]
        (if (:callable-arities? options)
         (glue "(bl-register-callable! " function " " (erlang/integer_to_binary (count (:pats (first (:clauses n))))) ")")
         function))))
  :case (glue "(let ((subject " (emit (:subj n) (operand-options options)) ")) "
          (clauses (items (:clauses n)) ["subject"] "(error \"native seed: case clause\")" options false) ")")
  :recv (let [timeout (if (:timeout n) (emit (:timeout n) (operand-options options)) "bl-nil")
              scan (glue "(lambda (message) "
                    (clauses (items (:clauses n)) ["message"] (literal :nomatch) options true) ")")
              after (glue "(lambda () " (if (:after n) (emit (:after n) options) "bl-nil") ")")
              receive (source-call n (glue "(" (ident "rt-receive") " " scan " " after " timeout)")
                         (operand-options options))]
          (glue "(let* ((timeout " timeout ") (selection " receive ")) ((bl-nth selection 1)))"))

  :try (emit-try n options)
  :tuple (ordered "bl-make-tuple" (:elems n) options)
  :map (ordered "bl-map" (pairs-operands (:pairs n)) options)
  :cons (ordered "cons" [(:head n) (:tail n)] options)
  :enil "'()"
  :struct (if (and (= :Elixir.BeamLisp.Vector (:mod n)) (= 1 (count (:fields n)))
                   (= :tuple (:op (second (first (:fields n))))))
            (ordered "bl-make-vec" (:elems (second (first (:fields n)))) options)
            (glue "(bl-struct " (literal (:mod n)) " "
              (ordered "bl-map" (pairs-operands (:fields n)) options) ")"))
  (refuse n))))))

(defn emit-definition [definition options]
 (try
  (glue "(define " (or (:scheme-name definition)
                      (when (:namespace-qualified? options)
                       (ident (str (or (:ns definition) (:ns options)) "/" (:name definition))))
                      (ident (:name definition))) " "
       (emit (:node definition)
        (assoc options :definition-ns (or (:ns definition) (:ns options)) :fn-label (:name definition)
                       :source-fn nil :source-arity nil :tail? false :loop nil)) ")\n")
  (catch e (throw (ex-info (str (:name definition) ": " (ex-message e)) (assoc (or (ex-data e) {}) :emission-stack __STACKTRACE__))))))

(defn emit-sealed-function
 "Release AOT emission of a fixed-arity function definition for a sealed
  image, or nil when `node` is not one (another shape, or source frames).
  Returns {:arity n :lambda text :value text}: `:lambda` is the function as a
  literal `(lambda (formals) entry+body)` for the arity cell `cell`, so
  Gambit can inline calls to it; `:value` is the definition's value, the
  registered case-lambda that forwards its arity to `cell` and keeps the
  function-clause arm for any other. Self-calls of that arity call `cell`;
  the self as a value is `value-name`. Emission order and facts are those of
  `emit` on the same node."
 [node options cell value-name]
 (when (and (= :let (:op node)) (not (:source-frames? options)))
  (when-let [parts (self-parts node)]
   (let [inner (:inner parts) self (:name node)
         widths (Enum/uniq (Enum/map (items (:clauses inner)) (fn [c] (count (:pats c)))))]
    (when (and (= :fn (:op inner)) (= 1 (count widths)))
     (let [arity (first widths)
           scaffold (assoc (forget-facts options (fn [] (list self)))
                           :selves (assoc (or (:selves options) {}) self value-name)
                           :procedure-selves (conj (or (:procedure-selves options) #{}) self)
                           :self-cells (assoc (or (:self-cells options) {}) self [cell arity]))
           inside (forget-facts scaffold (fn [] (clauses-binders (:clauses inner))))
           tick? (function-ticks? inner inside)]
      (when-let [fixed (fixed-parts inner inside)]
       (let [formals (:formals fixed)
             forward (glue "(" cell (Enum/join (Enum/map formals (fn [f] (glue " " f))) "") ")")
             value (fixed-function formals forward clause-fallback nil false)]
        {:arity arity
         :lambda (glue "(lambda (" (spaced formals) ") " (function-entry (:body fixed) nil tick?) ")")
         :value (if (:callable-arities? options)
                  (glue "(bl-register-callable! " value " " (erlang/integer_to_binary arity) ")") value)}))))))))
