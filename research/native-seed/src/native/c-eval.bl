; Integration adapter: native.eval must call this after canonical compilation.
; Backend selection changes emission/loading only, not reader/compiler policy.
(ns native.c-eval
 (:require [native.c :as c] [native.c-remote :as remote] [native.scheme :as scheme]))
(defn eval-node [node context]
 (case (host/native-backend)
  :scheme (host/eval-scheme (scheme/emit node context))
  :c (host/eval-c-unit (c/emit-unit node (remote/options context)))
  (throw (ex-info "native compiler: unknown selected backend" {}))))
