;; Only the observer is interpreted. The candidate and compiler are actual C.
(define es-original (bench-select "rt" "k-eqv"))
(define es-order (bench-select "rt" "k-compare"))
(define es-integer (native-leaf "erlang/is_integer/1"))
(define es-strict (native-leaf "erlang/=:=/2"))
(define es-original-remote native-remote)
(define es-checks 0)
(define (es-check label value)
 (if (not value) (error "equality shortcut check failed" label))
 (set! es-checks (+ es-checks 1)))
(define (es-current?)
 (and (eq? (native-global-exact "rt" "k-compare") es-order)
      (eq? (native-leaf "erlang/is_integer/1") es-integer)
      (eq? (native-leaf "erlang/=:=/2") es-strict)))
(define (es-with selected action)
 (es-check 'kernel-current (es-current?))
 (es-check 'canonical-serving (eq? (native-global-exact "rt" "k-eqv") es-original))
 (dynamic-wind
  (lambda () (native-register! "rt" "k-eqv" selected))
  action
  (lambda () (native-register! "rt" "k-eqv" es-original))))
(define (es-text texts)
 (if (null? texts) ""
  (if (null? (cdr texts)) (car texts)
   (string-append (car texts) "\n" (es-text (cdr texts))))))
(define (es-action phase forms nodes)
 (cond ((string=? phase "read") bench-parse)
  ((string=? phase "compile") (lambda () (bench-compile-forms forms)))
  ((string=? phase "emit") (lambda () (bench-emit-nodes nodes)))
  (else (lambda () (bench-emit-nodes (bench-compile-forms (bench-parse)))))))
(define (es-sample phase label selected batch forms nodes)
 (es-with selected
  (lambda ()
   (let ((action (es-action phase forms nodes)))
    (bench-repeat 3 action)
    (##get-monotonic-time! bench-clock 1)
    (bench-repeat 5 action)
    (##get-monotonic-time! bench-clock 2)
    (es-check 'kernel-still-current (es-current?))
    (es-check 'serving-still-selected (eq? (native-global-exact "rt" "k-eqv") selected))
    (display "EQUALITY_SHORTCUT_TIMING\t") (display phase) (display "\t")
    (display label) (display "\t") (write batch) (display "\t5\t")
    (write (exact->inexact (/ (- (u64vector-ref bench-clock 2) (u64vector-ref bench-clock 1)) bench-clock-frequency)))
    (newline) (force-output)))))
(define (es-remote-sample phase label selected batch forms nodes)
 (dynamic-wind
  (lambda () (set! native-remote selected))
  (lambda ()
   (let ((action (es-action phase forms nodes)))
    (bench-repeat 3 action)
    (##get-monotonic-time! bench-clock 1)
    (bench-repeat 5 action)
    (##get-monotonic-time! bench-clock 2)
    (es-check 'remote-retained (eq? native-remote selected))
    (display "EQUALITY_SHORTCUT_TIMING\t") (display phase) (display "\t")
    (display label) (display "\t") (write batch) (display "\t5\t")
    (write (exact->inexact (/ (- (u64vector-ref bench-clock 2) (u64vector-ref bench-clock 1)) bench-clock-frequency)))
    (newline) (force-output)))
  (lambda () (set! native-remote es-original-remote))))
(define (es-run)
 (native-mark-host-callable! bench-no-eval)
 (bl-register-callable! bench-no-eval 1)
 (set! native-leaf-registry (bl-assoc native-leaf-registry "host/eval-scheme/1" bench-no-eval))
 (set! native-eval-string bench-no-eval)
 (load @MODULE@)
 (let ((initializer (linked-proof-binding @INITIALIZER@)))
  (bench-check-native initializer) (bl-invoke initializer '()))
 (let* ((factory (bench-select @NAMESPACE@ "make-helper"))
        (candidate (bl-invoke factory (list es-original)))
        (parents (linked-proof-parents '@PHYSICAL@ linked-proof-existing-parents))
        (values (list bl-nil #t #f (bl-key "x") (bl-key "y") -1 0 1 2 9 32
                 10000000000000000000000000000000000000000000000000
                 -10000000000000000000000000000000000000000000000000
                 (bl-float 0.1) (bl-float 1.0) (bl-float 32.0)
                 (bl-decimal 1 1) (bl-decimal 10 2) (bl-decimal 1 0)
                 "x" "λ" '() (list 1) (list 1 2) (bl-vec (list 1))
                 (bl-tuple (list 1)) (bl-map (bl-key "a") 1)
                 (native-vector-with-meta (bl-vec (list 1)) (bl-map (bl-key "x") #t))))
        (forms (bench-parse)) (nodes (bench-compile-forms forms)))
  (es-check 'candidate-native-owner (memq (linked-proof-parent candidate) parents))
  (for-each (lambda (a)
   (for-each (lambda (b)
    (es-check 'differential (eq? (bl-invoke es-original (list a b))
                                (bl-invoke candidate (list a b))))) values)) values)
  (##gc)
  (es-check 'captured-fallback-after-gc
   (eq? (bl-invoke es-original (list (bl-decimal 1 1) (bl-float 0.1)))
        (bl-invoke candidate (list (bl-decimal 1 1) (bl-float 0.1)))))
  (for-each (lambda (phase)
   (let loop ((batch 0))
    (if (< batch 5)
     (begin
      (if (even? batch)
       (begin (es-sample phase "reference" es-original batch forms nodes) (es-sample phase "candidate" candidate batch forms nodes))
       (begin (es-sample phase "candidate" candidate batch forms nodes) (es-sample phase "reference" es-original batch forms nodes)))
      (loop (+ batch 1)))))) '("read" "compile" "emit" "pipeline"))
  (es-check 'reader-output-equal (bl-equal? forms (es-with candidate bench-parse)))
  (let ((reference (es-with es-original (es-action "pipeline" forms nodes)))
        (changed (es-with candidate (es-action "pipeline" forms nodes))))
   (es-check 'scheme-byte-equal (equal? reference changed))
   (native-write-file (string-append @OUTPUT@ "/reference.scm") (es-text reference))
   (native-write-file (string-append @OUTPUT@ "/candidate.scm") (es-text changed)))
  ;; A second tiny hypothesis uses the ALREADY COMPILED structural resolver.
  ;; It retains exact string-content lookup and the same epoch/membership/live
  ;; wrapper policies, while removing the weak-key identity-front lookup.
  (bench-check-native native-remote-resolve-key)
  (for-each (lambda (phase)
   (let loop ((batch 0))
    (if (< batch 5)
     (begin
      (if (even? batch)
       (begin
        (es-remote-sample phase "remote-reference" es-original-remote batch forms nodes)
        (es-remote-sample phase "remote-structural" native-remote-resolve-key batch forms nodes))
       (begin
        (es-remote-sample phase "remote-structural" native-remote-resolve-key batch forms nodes)
        (es-remote-sample phase "remote-reference" es-original-remote batch forms nodes)))
      (loop (+ batch 1)))))) '("read" "compile" "emit" "pipeline"))
  (dynamic-wind
   (lambda () (set! native-remote native-remote-resolve-key))
   (lambda ()
    (es-check 'structural-reader-output (bl-equal? forms (bench-parse)))
    (let ((texts ((es-action "pipeline" forms nodes))))
     (es-check 'structural-scheme-output (equal? texts (bench-emit-nodes nodes)))))
   (lambda () (set! native-remote es-original-remote)))
  (es-check 'restored-serving (eq? (native-global-exact "rt" "k-eqv") es-original))
  (es-check 'restored-kernel (es-current?))
  (display "EQUALITY_SHORTCUT_CHECKS ") (write es-checks) (newline)
  (display "EQUALITY_SHORTCUT_PASS\n") (force-output) (exit 0)))
(with-exception-catcher
 (lambda (failure) (set! native-remote es-original-remote) (native-register! "rt" "k-eqv" es-original)
  (display-exception failure) (newline) (exit 1)) es-run)
