(ns formal.source-handlers-check
 (:require [formal.api :as formal] [formal.term :as t] [interop]))

(def account
 {:name "source-account" :state {"balance" t/Int}
  :init (fn [s] (t/eq (get s "balance") (t/int 0)))
  :invariant (fn [s] (t/ge (get s "balance") (t/int 0)))
  :handlers [{:name "deposit" :inputs {"amount" t/Int}
               :assumptions (fn [s in] [(t/ge (get in "amount") (t/int 0))])
               :source "(fn [s msg] (assoc s \"balance\" (+ (get s \"balance\") (get msg \"amount\"))))"}
              {:name "withdraw" :inputs {"amount" t/Int}
               :assumptions (fn [s in] [(t/ge (get in "amount") (t/int 0))])
               :source "(fn [s msg] (if (<= (get msg \"amount\") (get s \"balance\")) (assoc s \"balance\" (- (get s \"balance\") (get msg \"amount\"))) s))"}]})
(def cases
 [{:id :source-account :spec account :expected :checked :trace-status :replayed :safety :holds
   :initial {"balance" 0} :events [{:transition "deposit" :inputs {"amount" 3}}
                                   {:transition "withdraw" :inputs {"amount" 2}}
                                   {:transition "withdraw" :inputs {"amount" 100}}]}
  {:id :unsafe-source-withdrawal
   :spec (assoc-in account [:handlers 1 :source]
           "(fn [s msg] (assoc s \"balance\" (- (get s \"balance\") (get msg \"amount\"))))")
   :expected :obligation-refuted :trace-status :replayed :safety :violated
   :initial {"balance" 0} :events [{:transition "withdraw" :inputs {"amount" 1}}]}
  {:id :empty-state-handler-failure :spec {:name "source-empty" :state {}
            :handlers [{:name "attempt" :source "(fn [s msg] (do (quot 1 0) {}))"}]}
   :expected :obligation-refuted :trace-status :replayed :safety :violated :initial {}
   :events [{:transition "attempt" :inputs {}} {:stutter true}]}
  {:id :hidden-field-handler-failure :spec {:name "source-hidden" :state {"value" t/Int}
            :handlers [{:name "attempt" :source "(fn [s msg] (get {\"next\" s \"unobserved\" (quot 1 0)} \"next\"))"}]}
   :expected :obligation-refuted :trace-status :replayed :safety :violated :initial {"value" 0}
   :events [{:transition "attempt" :inputs {}}]}
  {:id :inconsistent-initial-state :spec (assoc account :name "source-empty-init" :init (t/bool false))
   :expected :vacuous :trace-status :invalid :initial {"balance" 0} :events []}
  {:id :unreachable-induction-countermodel
   :spec {:name "source-loose-invariant" :state {"i" t/Int}
          :init (fn [s] (t/eq (get s "i") (t/int 0)))
          :invariant (fn [s] (t/any [(t/eq (get s "i") (t/int 0)) (t/eq (get s "i") (t/int 2))]))
          :handlers [{:name "decrement" :source "(fn [s msg] (if (> (get s \"i\") 0) (assoc s \"i\" (- (get s \"i\") 1)) s))"}]}
   :expected :obligation-refuted :trace-status :replayed :safety :holds :initial {"i" 0}
   :events [{:transition "decrement" :inputs {}}]}])
(def results
 (mapv (fn [sample]
  (let [definition (formal/source-protocol (:spec sample))
        comparison (formal/compare definition {:initial-state (:initial sample)})
        trace (formal/replay-source-protocol-trace definition (:initial sample) (:events sample))]
   (doseq [engine [:z3 :oxiz]]
    (assert (= (:expected sample) (get-in comparison [:results engine :status])) (pr-str {:id (:id sample) :comparison comparison})))
   (assert (= (:trace-status sample) (:status trace)))
   (when (= :replayed (:status trace))
    (assert (= (:safety sample) (:safety trace)))
    (assert (= :valid (get-in trace [:source-replay :status]))))
   {:id (:id sample) :definition definition :comparison comparison
    :initial (:initial sample) :events (:events sample) :execution trace})) cases))
(File/write! "research/formal-logic/evidence/record-handlers/examples.json"
 (interop/->json {:schema :enchant.formal.source-handlers-examples-v1
  :source-commit (trim (elem (System/cmd "git" (list "rev-parse" "HEAD")) 0))
  :cases results :scope :source-extracted-core-and-state-model
  :live-actor-connection :not-established :compiler-proof-authority false}))
(println {:cases (count results) :native-runs (* 2 (count results))
          :statuses (mapv (fn [r] [(:id r) (get-in r [:comparison :results :z3 :status])
                                   (get-in r [:comparison :results :oxiz :status])
                                   (:status (:execution r)) (:safety (:execution r))]) results)})
