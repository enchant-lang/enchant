#!/usr/bin/env bash
set -euo pipefail
project=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
root=$(CDPATH='' cd "$project/../../.." && pwd -P)
lean_paths="$project"
if [[ "${1:-}" == --with-refutation || "${1:-}" == --with-terms || "${1:-}" == --with-core-terms || "${1:-}" == --with-core-contract ]]; then
  library_mode="$1"
  shift
  checked_library=$(python3 - "$project" "$library_mode" <<'PY'
import hashlib,json,pathlib,sys
project=pathlib.Path(sys.argv[1]).parent
names=['metatheory/refutation-pin.json']
if sys.argv[2] in ['--with-terms','--with-core-terms','--with-core-contract']:
    names.append('metatheory/terms-pin.json')
if sys.argv[2] in ['--with-core-terms','--with-core-contract']:
    names.append('evidence/specialization/model-qualification.json')
if sys.argv[2]=='--with-core-contract':
    names.append('metatheory/core-terms-pin.json')
paths=[]
for name in names:
    pin=json.loads((project/name).read_text())
    for key in ['source','compiled']:
        artifact=project/pin[key]['path']
        assert hashlib.sha256(artifact.read_bytes()).hexdigest()==pin[key]['sha256']
    paths.append(str((project/pin['compiled']['path']).parent))
print(':'.join(paths))
PY
)
  lean_paths="$lean_paths:$checked_library"
fi
lean_tool=$(python3 - "$project/tool-pin.json" <<'PY'
import hashlib,json,pathlib,sys
p=json.loads(pathlib.Path(sys.argv[1]).read_text())
binary=pathlib.Path(p['path'])/'bin/lean'
assert hashlib.sha256(binary.read_bytes()).hexdigest()==p['binary_sha256']
print(binary)
PY
)
exec systemd-run --user --quiet --collect --wait --pipe \
  --working-directory="$root" --property=MemoryMax=2G --property=MemorySwapMax=0 \
  --property=RuntimeMaxSec=900 --property=KillMode=control-group \
  --setenv=LEAN_PATH="$lean_paths" \
  "$lean_tool" --root="$project" "$@"
