(ns formal.answers-check (:require [formal.answer-examples :as examples] [bl.json :as json]))
(let [report {:schema "enchant.formal.answer-integrity-examples.v1"
              :handled (examples/summary) :equalities (examples/equality-results) :contexts (examples/context-results)}
      root "research/formal-logic/evidence/answer-integrity"]
 (File/write! (str root "/examples.json") (json/encode report {:pretty 2}))
 (println (json/encode report {:pretty 2})))
