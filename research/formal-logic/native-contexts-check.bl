(ns formal.native-contexts-check
 (:require [formal.native-context-examples :as examples] [bl.json :as json]))
(let [report {:schema "enchant.formal.native-context-examples.v1" :rows (examples/results)
              :scope "Managed owner accounting; no arbitrary Erlang introspection or runtime replacement."
              :compiler-proof-authority false}]
 (File/write! "research/formal-logic/evidence/native-contexts/examples.json" (json/encode report {:pretty 2}))
 (println (json/encode report {:pretty 2})))
