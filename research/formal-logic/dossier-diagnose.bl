(ns formal.dossier-diagnose (:require [bl.doc :as doc] [bl.json :as json]))
(let [path (Path/expand "research/formal-logic/ATLAS.bl.org")
      sliced (doc/slice-doc path)
      _ (when-not (:ok sliced) (throw (ex-info "dossier could not be sliced" sliced)))
      observed (doc/run-doc (:ok sliced))
      text (doc/write-results (:ok sliced) (:results observed))
      root "research/formal-logic/evidence/sdk-interface"]
 (File/write! (str root "/dossier-fresh.bl.org") text)
 (File/write! (str root "/dossier-diagnostic.json")
              (json/encode {:errors (vec (:errors observed)) :results (:results observed)} {:pretty 2}))
 (println (json/encode {:errors (vec (:errors observed)) :cells (count (:results observed))})))
