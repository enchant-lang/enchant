(ns formal.dossier-inputs-check
 (:require [formal.collections] [formal.graph-observation-examples] [formal.bounded-point-examples]
           [formal.numeric-point-examples]
           [dossier.notebook :as notebook] [bl.doc :as doc]))
(def model (notebook/read-model "research/formal-logic/ATLAS.bl.org"))
(assert (= [] (notebook/problems model)))
(assert (= "/evidence/term-forest-evaluation/sharing.json" (get-in model [:source_urls "sharing_fixture"])))
(assert (every? #(contains? #{"structure" "observed"} (get % "phase")) (:formulas model)))
(def cells (doc/cells (:ok (doc/slice-doc "research/formal-logic/ATLAS.bl.org"))))
(assert (= 89 (count cells)))
(assert (= ["story-float-backends"] (mapv :id (filter :frozen? cells))))
(doseq [layers (range 17)]
 (let [values (notebook/calculate model {"sharing_layers" layers} "value")]
  (assert (= (inc layers) (get values "sharing_nodes")))
  (assert (= (dec (erlang/bsl 1 (inc layers))) (get values "sharing_terms_16")))))
(let [values (notebook/calculate model {} "value")]
 (assert (= 14 (get values "numeric_js_before") (get values "numeric_js_fixed")))
 (assert (= 0 (get values "numeric_js_after"))))
(assert (= "/evidence/numeric-semantics/baseline/observation-summary.json"
           (get-in model [:source_urls "numeric_baseline"])))
(assert (= "/evidence/numeric-semantics/candidate/observation-summary.json"
           (get-in model [:source_urls "numeric_candidate"])))
(println {:project-imports :loaded :notebook :valid :integer-settings 17 :phases [:structure :observed]
          :source-link :exact :native-query-calls 0 :compiler-proof-authority false})
