(ns formal.term-forest-sharing
 (:require [formal.term-forest-examples :as examples] [bl.json :as json]))
(def report (examples/run-sharing))
(File/write! (first (BeamLisp/argv)) (json/encode report {:pretty 2}))
(println (select-keys report [:checking :canonical-graph-bytes :expanded-term-occurrences :raw-native-scopes :managed-query-calls]))
