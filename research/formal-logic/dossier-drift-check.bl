(ns formal.dossier-drift-check (:require [bl.doc :as doc] [bl.json :as json]))
(def argv (BeamLisp/argv))
(def path (first argv))
(def sliced (doc/slice-doc path))
(assert (not (contains? sliced :error)))
(def document (:ok sliced))
(def actual (doc/run-doc document))
(assert (empty? (:errors actual)))
(File/write! (second argv) (doc/write-results document (:results actual)))
(File/write! (nth argv 2)
 (json/encode {:cells (count (:details actual)) :errors (:errors actual)
               :cell-ms (mapv #(select-keys % [:id :ms]) (:details actual))
               :scope "Actual cells evaluated from the original document path; separate diagnostic result text, no source/prose rewrite."} {:pretty 2}))
(println {:cells (count (:details actual)) :errors (:errors actual)})
