(ns formal.core-loops-check
 (:require [formal.api :as formal] [formal.core-loop-examples :as examples]
           [formal.runtime-artifact :as artifact] [interop]))

(def out (System/get_env "ENCHANT_FORMAL_EVIDENCE_ROOT"))
(File/mkdir_p! out)
(def rows
 (mapv (fn [row]
         (let [definition (:definition row) question (formal/core-loop-question definition)
               proof (when (= :ready (:status question)) (formal/certify (:problem question)))
               made (when (= :checked (:status proof)) (formal/core-loop-data definition (:certificate proof)))]
          (when-not (= :ready (:status made))
           (println {:id (:id row) :question (:status question) :proof (:status proof) :data (:status made)
                     :reason (or (:reason made) (:reason proof) (:reason question))})
           (throw (ex-info "Core loop export refused" {:id (:id row)})))
          (let [packet (:packet made)]
           (assert (= :checked-data-connection
                     (:status (formal/check-core-loop-data definition (:certificate proof) packet))))
           (File/write! (Path/join out (str (:id row) ".json")) (interop/->json packet))
           (assoc row :certificate (:certificate proof) :packet packet)))) (examples/examples)))
(def snapshot {:schema :enchant.formal.core-loop-examples-v1 :rows rows
               :source-commit (trim (elem (System/cmd "git" (list "rev-parse" "HEAD")) 0))})
(def bytes (erlang/term_to_binary snapshot (list :deterministic (tuple :minor_version 2))))
(assert (<= (erlang/byte_size bytes) 8388608))
(File/write! (Path/join out "core-loops.etf") bytes)
(File/write! (Path/join out "summary.json") (interop/->json
 {:schema (:schema snapshot) :source-commit (:source-commit snapshot)
  :archive {:bytes (erlang/byte_size bytes) :sha256 (artifact/digest bytes)}
  :rows (mapv (fn [row] {:id (:id row) :packet (get-in row [:packet :identity])
                        :subject (get-in row [:packet :subject])}) rows)}))
(println {:examples (count rows) :kernel-execution :not-run})
