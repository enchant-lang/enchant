(ns formal.diagnose-float-source
 (:require [veritas.property :as property] [veritas] [bl.json :as json]))
(def rows
 (mapv (fn [engine]
         (let [r (property/prove {:backend engine}
                   '(defn cancellation [x] (- (+ x 0.1) x)) '(= result 0.1) (veritas/one-of 1.0))]
          {:engine engine :modality (:modality r) :reason (:reason r)
           :answer (select-keys (:answer r) [:verdict :solver-status :phase :error :reason :why
                                            :model-status :validation :certificate :identity])
           :runtime-replay (select-keys (:runtime-replay r) [:status :module-loaded])
           :compiler-proof-authority false})) [:z3 :oxiz]))
(File/write! (first (BeamLisp/argv))
 (json/encode {:schema "enchant.formal.float-source-diagnostic.v1" :rows rows
               :scope "One SDK-only execution of the exact existing cancellation example, with unchanged default backend budgets."} {:pretty 2}))
(println (mapv #(select-keys % [:engine :modality :reason]) rows))
