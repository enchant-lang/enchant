(ns formal.point-boundary-baseline
 (:require [formal.runtime-values :as rv] [formal.value :as value] [formal.term :as t]
           [formal.source :as source] [formal.beam-float :as float] [veritas :as v]
           [bl.json :as json]))
(def report
 {:schema "enchant.formal.point-boundary-baseline.v1"
  :runtime-numeric-equality (= 1 1.0)
  :int-observation-accepts-runtime-float (rv/matches? (value/lift (t/int 1)) 1.0 1)
  :float-observation-accepts-runtime-int (rv/matches? (float/literal 1.0) 1 (float/runtime-data 1.0))
  :mixed-result-equivalence (try (source/equivalence-problem "0" "0.0" {} {})
                               (catch error {:status :threw :reason (ex-message error)}))
  :historical-real-generator {:admits-int (v/gen-domain? (v/real-of 0.0 0.0) 0)
                              :admits-float (v/gen-domain? (v/real-of 0.0 0.0) 0.0)
                              :enumeration (v/gen-enumerate (v/real-of 0.0 0.0))}
  :explicit-zeros (mapv float/runtime-data (v/gen-enumerate (v/one-of 0.0 -0.0)))
  :compiler-proof-authority false})
(File/write! (first (BeamLisp/argv)) (json/encode report {:pretty 2}))
(println (json/encode report {:pretty 2}))
