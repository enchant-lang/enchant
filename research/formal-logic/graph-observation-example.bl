(ns formal.graph-observation-example
 (:require [formal.graph-observation-examples :as examples] [bl.json :as json]))
(def result (examples/run))
(File/write! (first (BeamLisp/argv)) (json/encode result {:pretty 2}))
(println {:same-original-question true :inactive :not-demanded :active :materialization-refused
          :managed-query-calls (:managed-query-calls result)})
