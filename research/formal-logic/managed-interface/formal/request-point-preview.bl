(ns formal.request-point-preview
 (:require [formal.request-preview :as request] [formal.graph-question :as question]
           [formal.data-graph :as graph] [formal.evaluate :as evaluator]))

(def profile :bl/formal-request-point-preview-v1)

(defn- assertions [inventory]
 (vec (concat (:assertions inventory) (when (:counterexample inventory) [(:counterexample inventory)]))))
(defn- validation [operation roots rows]
 (let [bindings ((:check-bindings operation) roots)
       results (mapv (fn [i]
                       (let [value ((:resolve operation) (nth roots i))]
                        {:label (:label (nth rows i)) :value value
                         :status (cond (= true value) :valid (= false value) :invalid :else :incomplete)}))
                     (range (count rows)))
       invalid (vec (filter #(= :invalid (:status %)) results))
       incomplete (vec (filter #(= :incomplete (:status %)) results))]
  {:status (cond (= :invalid (:status bindings)) :invalid (seq invalid) :invalid
                 (or (:resource-refused bindings) (seq incomplete)) :incomplete :else :valid)
   :kind :independent-graph-replay :bindings bindings :results results :invalid invalid :incomplete incomplete
   :checked (- (count results) (count incomplete))}))

(defn replay
 "Freshly check original assertion roots at supplied coordinates.
  There is no native callback, handler invocation or record-provided forest.
  A valid point is evidence under this SDK policy, not a compiler/proof theorem."
 [original assignments]
 (when-not (= :map (rt/kind-kind assignments))
  (throw (ex-info "formal.request-point-preview: coordinate map required" {:kind :point-coordinates})))
 (let [fresh (request/check! original) subject (:subject fresh) configuration (:policy fresh)
       assignment-reference (graph/of assignments)
       base {:formal/request-point 1 :profile profile :request-reference (request/reference fresh)
             :subject-reference (request/subject-reference fresh) :assignment-reference assignment-reference
             :policy-reference (graph/of configuration) :checked-native-execution false
             :compiler-proof-authority false :certificate {:status :not-checked :kind :request-point}
             :observation-materialization :deferred}]
  (question/with-numeric subject (:limits configuration)
   (fn [inventory admitted]
    (if (= 1 (:formal/question-forest-refusal inventory))
     (merge base {:verdict :incomplete :phase :admission :validation {:status :incomplete :kind :admission}
                  :point-replay :not-run :admission (:admission inventory)})
     ((:with-point admitted) assignments
      (fn [operation]
       (let [forest (:forest inventory) source-for (zipmap (:roots forest) (:source-roots forest))
             rows (assertions inventory) roots (mapv #(get source-for (:term %)) rows)
             checking (validation operation roots rows)
             observations
             (into {}
              (mapv
               (fn [{:keys [label descriptor-source terms]}]
                [label {:descriptor-graph (graph/subgraph (:graph subject) descriptor-source)
                        :materialization :deferred :basis :original-descriptor-and-point-roots
                        :roots (mapv (fn [id]
                                       (let [source (get source-for id)]
                                        {:source-node source :value ((:resolve operation) source)})) terms)}])
               (:observations inventory)))
             verdict (cond (= :invalid (:status checking)) :invalid-point
                           (= :incomplete (:status checking)) :candidate
                           (= :prove (:mode inventory)) :refuted :else :sat)]
        (merge base {:verdict verdict :phase :point :point-replay :run :mode (:mode inventory)
                     :validation checking :observations observations :admission (:admission admitted)
                     :admission-account :shared-scope :resources ((:resources operation))
                     :checking ((:checking operation))})))))))))
