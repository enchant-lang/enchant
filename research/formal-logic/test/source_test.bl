(ns formal.source-test
 (:require [formal.source :as source] [formal.term :as t] [formal.logic :as logic]
           [formal.query :as q] [formal.elaborate :as elaborate] [formal.value :as v]
           [formal.evaluate :as evaluate] [formal.data :as d]))

(deftest both-source-frontends-refuse-names-with-another-binding-identity
 (doseq [expression ["foreign/x" "formal.source.intrinsics/x" "formal.core.intrinsics/x"]]
  (is (= :unsupported (:status (source/prepare expression {"x" (t/int 7)}))) expression)
  (is (= :unsupported (:status (elaborate/prepare expression {"x" t/Int}))) expression))
 (is (= :translated (:status (source/prepare "x" {"x" (t/int 7)}))))
 (is (= :elaborated (:status (elaborate/prepare "x" {"x" t/Int})))))

(deftest semantic-values-share-the-exact-reviewed-callee-catalog
 (doseq [expression ["(BeamLisp.Num/div x y)" "(/ x y)" "(erlang/mod x y)" "(erlang/inc x)"
                    "(BeamLisp.Num/quot x y)" "(BeamLisp.Ns.Rt/mod x y)" "(BeamLisp.Ns.Core/rem x y)"
                    "(erlang/eqv x y)" "(BeamLisp.Num/not_ x)" "(erlang/div x)" "(BeamLisp.Num/neg x y)"]]
  (is (= :unsupported (:status (source/prepare expression {"x" (t/int 7) "y" (t/int 2)}))) expression))
 (doseq [[expression expected] [["(BeamLisp.Num/neg x)" -7] ["(BeamLisp.Num/add x y)" 9]
                              ["(erlang/div x y)" 3] ["(erlang/rem x y)" 1]
                              ["(BeamLisp.Num/num_eq x y)" false] ["(not x)" false]]]
  (let [p (source/prepare expression {"x" (t/int 7) "y" (t/int 2)})]
   (is (= :translated (:status p)) (pr-str p))
   (when (= :translated (:status p))
    (is (= expected (evaluate/value (v/term (:value p)) {}))))))
 (doseq [node [{:op :arith :fun :add :bif :* :args [{:op :lit :val 2} {:op :lit :val 3}]}
               {:op :arith :fun :div :bif :div :args [{:op :lit :val 7} {:op :lit :val 2}]}
               {:op :invoke :callee {:op :global :ns "foreign" :name "inc"}
                :arguments {:op :cons :head {:op :lit :val 1} :tail {:op :enil}}}]]
  (is (= :refused (try (source/lower node {} {}) :admitted (catch _ :refused))))))

(deftest strict-boolean-not-retains-definedness-and-refuses-nullability
 (doseq [value [true false]]
  (let [p (source/prepare "(erlang/not flag)" {"flag" (t/bool value)})]
   (is (= :translated (:status p)))
   (is (= (not value) (evaluate/value (v/term (:value p)) {})))))
 (doseq [value [(t/int 7) (t/text "hello") (d/nullable "maybe" t/Bool)]]
  (is (= :unsupported (:status (source/prepare "(erlang/not flag)" {"flag" value})))))
 (let [p (source/prepare "(erlang/not (= (quot 1 0) 0))" {})]
  (is (= :translated (:status p)))
  (is (= false (evaluate/value (v/defined (:value p)) {})))))

(deftest compiler-anf-expressions-enter-the-same-term-interface
 (let [x (t/variable "source.x" t/Int) y (t/variable "source.y" t/Int)
       bindings {"x" x "y" y}
       samples [["(+ x 1)" "(inc x)"]
                ["(if (< x 0) (- x) x)" "(if (neg? x) (- x) x)"]
                ["(let [a (+ x 1)] (+ a 2))" "(+ x 3)"]
                ["(rem x y)" "(- x (* y (quot x y)))"]]]
  (doseq [[left right] samples]
   (let [prepared (source/equivalence-problem left right bindings {})]
    (is (= :translated (:status prepared)) (pr-str prepared))
    (when (= :translated (:status prepared))
     (doseq [engine [:z3 :oxiz]]
      (let [result (logic/run {:backend engine} (:problem prepared))]
       (is (= :proved (:verdict result)) (pr-str result)))))))))

(deftest source-profile-refuses-effects-and-unsupported-semantics
 (let [bindings {"x" (t/variable "source.x" t/Int)}]
  (is (= :unsupported (:status (source/prepare "(do (println x) x)" bindings))))
  (is (= :unsupported (:status (source/prepare "(mystery x)" bindings))))
  (is (= :unsupported (:status (source/prepare "(+ x 1) (+ x 2)" bindings))))
  (is (= :unsupported (:status (source/prepare "(+ x 0.5)" bindings))))))

(deftest runtime-floor-modulus-is-not-smt-euclidean-modulus
 (let [prepared (source/prepare "(>= (mod x -3) 0)" {"x" (t/int 7)})]
  (is (= :translated (:status prepared)) (pr-str prepared))
  (when (= :translated (:status prepared))
   (is (= :refuted (:verdict (logic/run {:backend :z3} (q/prove (:value prepared))))))
   (is (contains? #{:refuted :unknown}
         (:verdict (logic/run {:backend :oxiz} (q/prove (:value prepared)))))))))
