(ns formal.api-test
 (:require [formal.api :as formal] [formal.term :as t] [formal.value :as v]
           [formal.collections :as c] [formal.data :as d]
           [formal.query :as q] [formal.logic :as logic] [formal.backend :as backend]
           [formal.source :as source] [formal.answer :as answer] [formal.evaluate :as replay]))

(deftest one-declaration-and-question-interface-for-language-values
 (let [inputs (formal/symbols "api.example"
                {:ledger {:kind :map :keys [:alice :bob] :item t/Int}
                 :account {:kind :key :universe [:alice :bob]}
                 :amount t/Int})
       problem (formal/question inputs
                 {:id :api/read-after-write
                  :claim (fn [{:keys [ledger account amount]}]
                           (v/equal (d/unwrap (c/map-lookup (c/map-assoc ledger account amount) account)) amount))})]
  (is (= :finite-universe (get-in (formal/describe problem) [:scope :mode])))
  (is (pos? (:terms (formal/describe problem))))
  (doseq [engine [:z3 :oxiz]]
   (is (= :proved (:verdict (formal/check {:backend engine} problem)))))))

(deftest opaque-derived-observations-can-use-labelled-independent-replay
 (let [x (t/variable "observation.x" t/Int) y (t/variable "observation.y" t/Int)
       problem (q/sat {:assumptions [(t/eq x (t/int 0)) (t/eq y (t/int 1))]
                       :observe {"difference" (t/sub x y)}})]
  (doseq [engine [:z3 :oxiz]]
   (let [result (formal/check {:backend engine} problem)
         origin (first (get-in result [:witness-provenance "difference" :terms]))]
    (is (= :sat (:verdict result)))
    (is (= -1 (get-in result [:witness "difference"])))
    (is (= :valid (get-in result [:validation :status])))
    (is (contains? #{:backend :independent-replay} (:source origin)))
    (when (= :unavailable (:native-availability origin))
     (is (= :independent-replay (:source origin)))
     (is (some? (:native-reason origin))))))))

(deftest observation-replay-does-not-manufacture-a-nan-payload
 (let [nan (t/literal (t/fp-sort 8 24) 2143289345)]
  (doseq [engine [:z3 :oxiz]]
   (let [result (formal/check {:backend engine} (q/sat {:observe {"nan" nan}}))
         source (:source (first (get-in result [:witness-provenance "nan" :terms])))]
    (is (= :sat (:verdict result)))
    (is (contains? #{:backend :unavailable} source))))))

(deftest handler-and-reopened-observations-keep-semantic-nan-without-payload
 (let [sort (t/fp-sort 8 24) zero (t/literal sort 0)
       nan (t/literal sort 2143289345)
       computed (t/app :fp-div sort [(t/literal t/Rounding "RNE") zero zero] nil)]
  (doseq [expression [nan computed]]
   (let [question (q/sat {:observe {"nan" expression "nan?" (t/app :fp-is-nan t/Bool [expression] nil)}})
         checked (answer/check question (answer/bind question {:solver-status :sat :assignments {}}))]
    (is (= :sat (:verdict checked)))
    (is (replay/unavailable? (get-in checked [:witness "nan"])))
    (is (= true (get-in checked [:witness "nan?"])))
    (is (= :unavailable (get-in checked [:witness-provenance "nan" :terms 0 :source])))
    (is (= :independent-replay (get-in checked [:witness-provenance "nan?" :terms 0 :source])))))
  (doseq [expression [(t/literal sort 1065353216) (t/literal sort 2139095040)]]
   (let [question (q/sat {:observe {"value" expression}})
         checked (answer/check question (answer/bind question {:solver-status :sat :assignments {}}))]
    (is (= (replay/value expression {}) (get-in checked [:witness "value"])))
    (is (= :independent-replay (get-in checked [:witness-provenance "value" :terms 0 :source])))))))

(deftest nested-fp-observations-also-separate-nan-meaning-from-payload
 (let [sort (t/fp-sort 8 24) nan (t/literal sort 2143289345)
       sequence (t/app :seq-unit (t/seq-sort sort) [nan] nil)
       array (t/const-array t/Int nan)]
  (doseq [[expression path] [[sequence [0]] [array [:formal/array :default]]]]
   (let [question (q/sat {:observe {"value" expression}})
         checked (answer/check question (answer/bind question {:solver-status :sat :assignments {}}))]
    (is (= :sat (:verdict checked)))
    (is (replay/unavailable? (get-in checked (into [:witness "value"] path))))
    (is (= :valid (:status (replay/check-value (t/sort-of expression) (replay/value expression {})))))))))

(deftest persistent-context-is-visible-in-meaning-replay-and-cache
 (let [x (t/variable "context.x" t/Int) problem (q/prove (t/gt x (t/int 0)))
       fresh (logic/run {:backend :z3} problem)]
  (is (= :refuted (:verdict fresh)))
  (backend/with-session {:backend :z3}
   (fn [session]
    (is (:ok (backend/load! session [(q/assertion "positive" (t/gt x (t/int 0)))])))
    (let [conditional (logic/solve-in session problem)
          witness (logic/solve-in session (q/sat {}))]
     (is (= :proved (:verdict conditional)))
     (is (= ["context/0/positive"] (get-in conditional [:context :assertions])))
     (is (not= (:cache-key fresh) (:cache-key conditional)))
     (is (= :valid (get-in witness [:validation :status])))
     (is (pos? (get (:assignments witness) "context.x"))))))))

(deftest closed-labels-and-source-bindings-use-reviewed-relations
 (is (thrown? (d/finite-key "bad" [1 1.0])))
 (is (thrown? (d/finite-key "bad" [:a :a])))
 (is (thrown? (c/map-symbolic "bad" [1 1.0] t/Int)))
 (is (= :unsupported (:status (source/prepare "(- x)" {"x" (t/variable "x" t/Real)}))))
 (is (= :unsupported (:status (source/prepare "(= x x)" {"x" (t/variable "x" (t/fp-sort 8 24))})))))

(deftest shared-synthesis-and-explanation-have-explicit-finite-contracts
 (doseq [engine [:z3 :oxiz]]
  (let [x (t/variable "grammar.x" t/Int)
        synthesis (logic/synthesize {:backend engine}
                    [[:bad (t/gt x (t/int 0))] [:good (t/gt (t/add x (t/int 1)) x)]] {})
        explanation (logic/explain-unsat {:backend engine}
                       [(q/assertion "positive" (t/gt x (t/int 0)))
                        (q/assertion "negative" (t/lt x (t/int 0)))
                        (q/assertion "irrelevant" (t/bool true))])]
   (is (= :candidate-proved (:status synthesis)) (pr-str synthesis))
   (is (= :good (:candidate synthesis)))
   (is (= :subset-minimal (:status explanation)) (pr-str explanation))
   (is (= #{"positive" "negative"} (set (map :label (:assertions explanation))))))))
