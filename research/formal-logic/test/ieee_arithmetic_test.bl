(ns formal.ieee-arithmetic-test
 (:require [formal.ieee-arithmetic :as ieee] [formal.term :as t] [formal.query :as q]
           [formal.logic :as logic]))

(defn bits [x]
 (binary/decode_unsigned (erlang/binary_part (erlang/term_to_binary x) 2 8)))
(defn host [pattern]
 (let [bytes (mapv #(erlang/band 255 (erlang/bsr pattern (* 8 (- 7 %)))) (range 8))]
  (BeamLisp.Env/decode_data_term! (erlang/list_to_binary (to-list (concat [131 70] bytes))))))
(def finite-patterns
 [0 9223372036854775808 1 2 4503599627370495 4503599627370496 4503599627370497
  4602678819172646912 4607182418800017408 4607182418800017409 4607182418800017410
  4368491638549381120 4368491638549381121 4591870180066957722 4596373779694328218
  4599075939470750515 4613937818241073152 4845873199050653696 9218868437227405311
  9223372036854775809 9227875636482146304 13826050856027422720 13830554455654793216
  13830554455654793217 13819745816549104026 18442240474082181119])
(def host-ops
 {:fp-add (fn [a b] (+ a b)) :fp-sub (fn [a b] (- a b))
  :fp-mul (fn [a b] (* a b)) :fp-div (fn [a b] (erlang// a b))})

(deftest binary64-finite-arithmetic-agrees-with-actual-bl-and-bad-arithmetic
 (doseq [operation [:fp-add :fp-sub :fp-mul :fp-div] a finite-patterns b finite-patterns]
  (let [left (ieee/data 11 53 a) right (ieee/data 11 53 b)
        expected (ieee/operate operation "RNE" left right) parsed (ieee/parts expected)
        actual (try {:status :returned :bits (bits ((get host-ops operation) (host a) (host b)))}
                    (catch _ {:status :raised}))]
   (is (= (if (or (:nan parsed) (:infinite parsed)) :raised :returned) (:status actual)))
   (when (= :returned (:status actual)) (is (= (nth (:formal/fp expected) 2) (:bits actual)))))))

;; Independent small-format reference: enumerate the complete representable
;; positive grid (units of one half). Unlike the implementation, this does not
;; normalize exponents or compute a significand/quantum. A virtual value four
;; supplies the final rounding boundary; its encoding is infinity.
(def units [0 1 2 3 4 6])
(defn tiny-unit [bits] (* (if (>= bits 8) -1 1) (nth units (erlang/band bits 7))))
(defn tiny-reference [operation rounding a b]
 (let [x (tiny-unit a) y (tiny-unit b)
       sign-a (>= a 8) sign-b (if (= operation :fp-sub) (< b 8) (>= b 8))
       [n d] (case operation :fp-add [(+ x y) 2] :fp-sub [(- x y) 2]
                            :fp-mul [(* x y) 4] :fp-div [x y])
       n (if (< d 0) (- n) n) d (abs d)
       negative (cond (not= n 0) (< n 0)
                      (contains? #{:fp-mul :fp-div} operation) (not= (>= a 8) (>= b 8))
                      (and (= x 0) (= y 0) (= sign-a sign-b)) sign-a
                      :else (= rounding "RTN"))
       n (abs n) candidates (mapv (fn [bits] {:bits bits :units (nth (conj units 8) bits)}) (range 7))
       low (last (filter #(and (< (:bits %) 6) (<= (* (:units %) d) (* 2 n))) candidates))
       high (first (filter #(>= (* (:units %) d) (* 2 n)) candidates))
       nearest (first (sort-by (fn [point]
                                [(abs (- (* 2 n) (* (:units point) d)))
                                 (if (= rounding "RNA") (- (:units point)) (erlang/band (:bits point) 1))]) candidates))
       selected (cond (= n 0) 0
                      (contains? #{"RNE" "RNA"} rounding) (:bits nearest)
                      (or (and (= rounding "RTP") (not negative)) (and (= rounding "RTN") negative))
                       (if high (:bits high) 6)
                      :else (:bits low))]
  (+ (if negative 8 0) selected)))

(deftest every-finite-pair-in-a-tiny-format-and-all-five-roundings
 (doseq [operation [:fp-add :fp-sub :fp-mul :fp-div] rounding ["RNE" "RNA" "RTP" "RTN" "RTZ"]
         a (concat (range 6) (range 8 14)) b (concat (range 6) (range 8 14))
         :when (or (not= operation :fp-div) (not= 0 (tiny-unit b)))]
  (let [expected (tiny-reference operation rounding a b)
        actual (ieee/operate operation rounding (ieee/data 2 2 a) (ieee/data 2 2 b))]
   (is (= expected (nth (:formal/fp actual) 2))))))

(deftest signed-zeros-and-special-values-are-explicit
 (let [pos (ieee/zero 11 53 false) neg (ieee/zero 11 53 true)
       inf (ieee/infinity 11 53 false) ninf (ieee/infinity 11 53 true)]
  (is (= neg (ieee/operate :fp-add "RNE" neg neg)))
  (is (= pos (ieee/operate :fp-add "RNE" neg pos)))
  (is (= neg (ieee/operate :fp-add "RTN" neg pos)))
  (doseq [[operation a b] [[:fp-add inf ninf] [:fp-sub inf inf] [:fp-mul pos inf] [:fp-div pos pos] [:fp-div inf inf]]]
   (is (:nan (ieee/parts (ieee/operate operation "RNE" a b)))))
  (is (= inf (ieee/operate :fp-div "RNE" (ieee/data 11 53 (bits 1.0)) pos)))
  (is (= neg (ieee/operate :fp-div "RNE" (ieee/data 11 53 (bits -1.0)) inf)))
 ))

(deftest native-z3-reference-queries-cover-rounding-and-nonfinite-results
 (logic/with-session {:backend :z3}
  (fn [session]
   (doseq [rounding ["RNE" "RNA" "RTP" "RTN" "RTZ"]
           operation [:fp-add :fp-sub :fp-mul :fp-div]
           [a b] [[0 16] [1 3] [3 1] [11 6] [11 11] [12 0] [12 28] [0 0]]]
    (let [sort (t/fp-sort 2 3) left (ieee/data 2 3 a) right (ieee/data 2 3 b)
          expected (ieee/operate operation rounding left right)
          expression (t/app operation sort [(t/literal t/Rounding rounding) (t/literal sort a) (t/literal sort b)] nil)
          problem (q/prove (t/eq expression (t/literal sort (nth (:formal/fp expected) 2)))
                           {:vacuity :allow :profile ieee/profile})
          result (logic/solve-in session problem)]
     (is (= :unsat (:solver-status result)) (pr-str (select-keys result [:why :error :phase :verdict])))
 )))))

(deftest rounding-boundaries-rational-projection-and-explicit-capacity
 (is (= (ieee/data 11 53 (bits 9007199254740992.0)) (ieee/from-integer 11 53 "RNE" 9007199254740993)))
 (is (= (ieee/data 11 53 (bits 9007199254740994.0)) (ieee/from-integer 11 53 "RNA" 9007199254740993)))
 (is (= [1 2] (ieee/rational (ieee/data 11 53 (bits 0.5)))))
 (is (thrown? (ieee/data 16 53 0)))
 (is (thrown? (ieee/data 11 53 -1)))
 (is (thrown? (ieee/from-integer 11 53 "invalid" 0)))
)
