(ns formal.research-evidence-capture (:require [formal.research-evidence :as evidence]))
(def args (BeamLisp/argv))
(def result (evidence/append-snapshot! (nth args 0) (nth args 1)))
(println {:snapshot :saved :revisions (:revisions result) :basis (get-in result [:snapshot :basis])
          :source :qualified-implementation-evidence :compiler-proof-authority false})
