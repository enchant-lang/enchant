(ns formal.research-evidence
 (:require [research.elements :as elements] [bl.json :as json]
           [formal.logic :as logic] [formal.data-graph :as graph]))

(def id "word-answer-evidence")
(def renderer "research/comparison")
(def revision 3)
(def source-paths
 ["sdk-pin.json"
  "evidence/obligation-integration/qualification.json"
  "evidence/obligation-integration/previous-scalar-readers-qualification.json"
  "evidence/obligation-dossier-cases/qualification.json"
  "evidence/obligation-dossier-cases/cases.json"
  "evidence/graph-search-prototype/qualification.json"
  "evidence/graph-search-prototype/observations.json"
  "evidence/graph-choice-prototype/qualification.json"
  "evidence/graph-choice-prototype/observations.json"
  "evidence/choice-extension-model/qualification.json"
  "evidence/scalar-integration/qualification.json"
  "evidence/scalar-integration/records-qualification.json"
  "evidence/scalar-integration/native-comparison.json"
  "evidence/scalar-integration/corpus.json"
  "evidence/scalar-integration/reader-one.json"
  "evidence/scalar-integration/reader-two.json"
  "evidence/scalar-integration/word-native.json"
  "evidence/scalar-integration/evidence-packets.json"
  "dossier/formal/research-evidence.bl"
  "dossier/formal/research-view.bl"
  "dossier/research-evidence.js"
  "evidence/word-integration/qualification.json"
  "evidence/word-integration/records-qualification.json"
  "evidence/word-integration/native-comparison.json"
  "evidence/word-integration/corpus.json"
  "evidence/word-integration/reader-one.json"
  "evidence/word-integration/reader-two.json"])
(defn- require! [ok why]
 (when-not ok (throw (ex-info (str "formal.research-evidence: " why) {}))))
(defn- sha [bytes] (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower))))
(defn sources [root]
 (mapv (fn [relative]
         (let [path (Path/join root relative)
               _ (require! (<= (:size (File/stat! path)) 8388608) "source capacity")
               bytes (File/read! path)]
          (require! (<= (erlang/byte_size bytes) 8388608) "source capacity")
          {:id relative :source relative :revision (sha bytes) :bytes bytes})) source-paths))
(defn basis [root]
 (graph/of {:producer "formal/word-evidence" :producer-version revision :renderer renderer :renderer-version 1
            :sources (mapv #(select-keys % [:id :revision]) (sources root))}))
(defn basis-id [root] (:sha256 (basis root)))
(defn- source [data relative] (json/decode (:bytes (first (filter #(= relative (:source %)) data)))))
(defn locate!
 "A bounded JSON pointer, traversed as data only. Missing differs from present nil."
 [data pointer]
 (require! (and (string? pointer) (String/starts_with? pointer "/")) "exact locator required")
 (let [parts (vec (rest (String/split pointer "/")))]
  (require! (<= (count parts) 12) "locator depth")
  (reduce (fn [value part]
            (cond
             (map? value) (do (require! (contains? value part) "locator key missing") (get value part))
             (vector? value) (let [index (json/decode part)]
                              (require! (and (int? index) (<= 0 index) (< index (count value))) "locator index missing")
                              (nth value index))
             :else (throw (ex-info "formal.research-evidence: locator crossed a scalar" {})))) data parts)))
(defn- evidence [relative locator] {:source relative :locator locator})
(defn- row [identity label finding state references]
 {:id identity :label label :finding finding :state state :evidence references})
(defn build
 "Read actual source-bound checks. This comparison is an inspected report,
  never a substitute for freshly checking a candidate's original terms."
 [root]
 (let [data (sources root) pin (source data "sdk-pin.json")
       runtime (source data "evidence/obligation-integration/qualification.json")
       prior (source data "evidence/obligation-integration/previous-scalar-readers-qualification.json")
       cases-q (source data "evidence/obligation-dossier-cases/qualification.json")
       cases (source data "evidence/obligation-dossier-cases/cases.json")
       search-q (source data "evidence/graph-search-prototype/qualification.json")
       choice-q (source data "evidence/graph-choice-prototype/qualification.json")
       model (source data "evidence/choice-extension-model/qualification.json")
       _ (doseq [q [runtime prior cases-q search-q choice-q model]]
           (require! (= "passed" (get q "status")) "qualified sources required"))
       _ (doseq [q [runtime prior cases-q search-q choice-q]]
           (require! (= pin (get q "sdk_pin")) "sources describe another SDK"))
       _ (require! (= (get pin "sdk") (System/get_env "BL_SDK_PRODUCT") (get cases "sdk")) "actual selected SDK required")
       _ (require! (and (= 11914 (get runtime "assertion_executions")) (= 187 (get runtime "native_questions"))
                        (= [] (get runtime "native_outcome_differences"))) "complete artifact qualification required")
       _ (require! (and (= 20 (get prior "records")) (= 2 (get prior "fresh_sdk_only_readers"))
                        (= 16 (get prior "refusal_controls")) (= 3 (get prior "independently_invalid_text_controls"))
                        (= 0 (get prior "solver_exchanges") (get prior "oracle_calls"))) "prior packet checks required")
       cases-bytes (:bytes (first (filter #(= "evidence/obligation-dossier-cases/cases.json" (:source %)) data)))
       _ (require! (= (sha cases-bytes) (get cases-q "cases_sha256")) "case capture differs from qualification")
       _ (require! (and (= 9 (count (get cases "rows"))) (= 0 (get cases "native-exchanges") (get cases "oracle-calls"))) "all solver-free case captures required")
       _ (require! (and (= 43 (get search-q "assertions")) (= 50 (get choice-q "assertions"))
                        (= false (get search-q "in_sdk") (get choice-q "in_sdk"))
                        (= 15 (get model "theorems")) (= 4 (get model "false_claim_controls"))
                        (= false (get model "bl_implementation_correspondence"))) "prototype and model scopes required")
       _ (doseq [[qualified relative] [[search-q "evidence/graph-search-prototype/observations.json"]
                                        [choice-q "evidence/graph-choice-prototype/observations.json"]]]
           (require! (= (get qualified "observations_sha256")
                        (sha (:bytes (first (filter #(= relative (:source %)) data))))) "prototype capture differs from qualification"))
       recorded (get runtime "recorded_utc") year (json/decode (subs recorded 0 4))
       overview
        [(row "terms" "One complete question" "The original graph, premises and semantic profile remain bound to every check." :supported
              [(evidence "evidence/obligation-integration/qualification.json" "/build_linkage_sha256")])
         (row "native" "Z3 and OxiZ" "All 187 paired native outcomes matched the scalar checkpoint. Native status remains a claim." :supported
              [(evidence "evidence/obligation-integration/qualification.json" "/native_questions")
               (evidence "evidence/obligation-integration/qualification.json" "/native_outcome_differences")])
         (row "points" "Fresh saved answers" "Two new-SDK readers rechecked twenty prior word/text packets each. Earlier durable-store checks retain their own checkpoint." :supported
              [(evidence "evidence/obligation-integration/previous-scalar-readers-qualification.json" "/fresh_sdk_only_readers")])
         (row "proof" "Installed proof choices" "Finite words and unbounded linear integers use separate independently checked certificate strategies." :supported
              [(evidence "evidence/obligation-integration/qualification.json" "/assertion_runs/focused/formal.graph-integer-certificate-test")])
         (row "choices" "Conditional integer prototype" "Nested choices passed 50 checks with explicit definitions. Fifteen Lean model theorems keep the BL evaluator connection as a separate premise." :supported
              [(evidence "evidence/graph-choice-prototype/qualification.json" "/assertions")
               (evidence "evidence/choice-extension-model/qualification.json" "/explicit_original_target_correspondence_premise")])
         (row "source" "An affine Source example" "Graph proof search checked its term contract, and fresh premise replay allowed acceptance. Source interpretation remains reviewed." :supported
              [(evidence "evidence/graph-search-prototype/observations.json" "/observations/1/result/conclusion/status")])
         (row "program" "Whole-language correspondence" "Wider-theory request admission, Source/transform implementation proofs and compiler preservation remain open." :candidate
              [(evidence "evidence/obligation-integration/qualification.json" "/compiler_proof_authority")])]
       case-rows
        (mapv (fn [index]
                (let [item (nth (get cases "rows") index) result (get item "result")
                      policy (get item "consumer") background (get item "background")
                      _ (require! (and (= "checked" (get-in result ["proof-check" "status"]))
                                       (= background (get-in result ["feasibility-check" "feasibility"]))) "case proof and premise checks required")
                      fact (case background "witnessed" "premises witnessed" "inconsistent" "premises inconsistent" "not-established" "premise allowance zero")
                      action (get-in result ["conclusion" "status"])]
                 (row (str "policy-" policy "-" background) (str policy " · " background)
                   (str "The theorem checked; " fact "; consumer result: " action ".") :supported
                   [(evidence "evidence/obligation-dossier-cases/cases.json" (str "/rows/" index "/result/conclusion/status"))
                    (evidence "evidence/obligation-dossier-cases/cases.json" (str "/rows/" index "/result/proof-check/status"))])))
              (range 9))
       rows (vec (concat overview case-rows))
       edges (mapv (fn [r] {:id (str "receipt-" (:id r)) :from "word-answer" :to (:id r)
                           :relation :recorded-evidence :from-year year :to-year year :state (:state r) :evidence (:evidence r)}) rows)
       result (elements/element
                {:question "When can Beam Lisp accept a formal answer?"
                 :basis (basis-id root)
                 :scope {:sdk (get pin "sdk") :semantic-profiles [logic/numeric-word-policy logic/numeric-word-text-policy]
                         :profile-scope "Individual receipts retain their original numeric, word or text profile."
                         :period :recorded-qualification :recorded-at recorded :compiler-proof-authority false}
                 :year year :recipe {:id "formal/word-evidence" :version revision}}
                {:kind :comparison :title "Proof, premises and acceptance"
                 :rows rows :edges edges :entity-ids (vec (cons "word-answer" (map :id rows)))
                 :edge-ids (mapv :id edges) :source-ids source-paths
                 :sources (mapv #(select-keys % [:id :source :revision]) data)
                 :summary "A checked theorem, feasible premises and the consumer's acceptance are separate judgments."})]
  (doseq [r rows reference (:evidence r)]
   (locate! (source data (:source reference)) (:locator reference)))
  (assoc result :origin :qualified-implementation-evidence :compiler-proof-authority false)))
(defn validate!
 "Only this installed comparison contract is renderable; strings choose no callable."
 [saved]
 (require! (and (map? saved) (int? (:version saved)) (= 1 (:version saved))
                (= :comparison (:kind saved)) (= renderer (:function saved))
                (int? (:function-version saved)) (= 1 (:function-version saved))
                (= :qualified-implementation-evidence (:origin saved))
                (= false (:compiler-proof-authority saved))
                (string? (:basis saved)) (Regex/match? #"^[0-9a-f]{64}$" (:basis saved))
                (vector? (:rows saved)) (<= 1 (count (:rows saved)) 16)) "installed finite comparison required")
 (doseq [r (:rows saved)]
  (require! (and (= #{:id :label :finding :state :evidence} (set (keys r)))
                 (every? string? [(:id r) (:label r) (:finding r)])
                 (contains? #{:supported :candidate :disputed} (:state r))
                 (every? #(and (contains? (set source-paths) (:source %)) (string? (:locator %)) (not (blank? (:locator %)))) (:evidence r)))
            "closed located row required")
  (when (= :supported (:state r)) (require! (elements/supported? r) "supported row lacks a locator")))
 saved)
(defn read-snapshots [path]
 (if (File/exists? path)
  (let [bytes (File/read! path)]
   (require! (<= (erlang/byte_size bytes) 8388608) "snapshot store capacity")
   (mapv validate! (elements/read-records bytes))) []))
(defn append-snapshot!
 "Append native Org through the one review host's serialized atomic writer."
 ([root path] (append-snapshot! root path nil))
 ([root path expected-basis]
 (global/trans (tuple (tuple :formal/research-snapshot (Path/expand path)) (erlang/self))
  (fn []
   (let [prior (read-snapshots path) current (validate! (build root))
         number (inc (count prior)) saved (assoc current :snapshot-revision number :element-id id)
         _ (when (and expected-basis (not= expected-basis (:basis current)))
             (throw (ex-info "Source basis changed during save" {:kind :stale-basis})))
         before (if (File/exists? path) (File/read! path) "")
         record (elements/org-record (str id "-" number) (:title saved) saved)
         output (str before (when (seq before) "\n") record)
         temporary (str path "." (System/unique_integer (list :positive)) ".tmp")]
    (require! (<= (erlang/byte_size output) 8388608) "snapshot store capacity")
    (File/mkdir_p! (Path/dirname path))
    (try (File/write! temporary output) (File/rename! temporary path)
     (finally (when (File/exists? temporary) (File/rm temporary))))
    {:snapshot (last (read-snapshots path)) :revisions number :freshness :current})))))
