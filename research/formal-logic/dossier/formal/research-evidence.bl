(ns formal.research-evidence
 (:require [research.elements :as elements] [bl.json :as json]
           [formal.logic :as logic] [formal.data-graph :as graph]))

(def id "word-answer-evidence")
(def renderer "research/comparison")
(def revision 2)
(def source-paths
 ["sdk-pin.json"
  "evidence/scalar-integration/qualification.json"
  "evidence/scalar-integration/records-qualification.json"
  "evidence/scalar-integration/native-comparison.json"
  "evidence/scalar-integration/corpus.json"
  "evidence/scalar-integration/reader-one.json"
  "evidence/scalar-integration/reader-two.json"
  "evidence/scalar-integration/word-native.json"
  "evidence/scalar-integration/evidence-packets.json"
  "dossier/formal/research-evidence.bl"
  "dossier/formal/research-view.bl"
  "dossier/research-evidence.js"
  "evidence/word-integration/qualification.json"
  "evidence/word-integration/records-qualification.json"
  "evidence/word-integration/native-comparison.json"
  "evidence/word-integration/corpus.json"
  "evidence/word-integration/reader-one.json"
  "evidence/word-integration/reader-two.json"])
(defn- require! [ok why]
 (when-not ok (throw (ex-info (str "formal.research-evidence: " why) {}))))
(defn- sha [bytes] (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower))))
(defn sources [root]
 (mapv (fn [relative]
         (let [path (Path/join root relative)
               _ (require! (<= (:size (File/stat! path)) 8388608) "source capacity")
               bytes (File/read! path)]
          (require! (<= (erlang/byte_size bytes) 8388608) "source capacity")
          {:id relative :source relative :revision (sha bytes) :bytes bytes})) source-paths))
(defn basis [root]
 (graph/of {:producer "formal/word-evidence" :producer-version revision :renderer renderer :renderer-version 1
            :sources (mapv #(select-keys % [:id :revision]) (sources root))}))
(defn basis-id [root] (:sha256 (basis root)))
(defn- source [data relative] (json/decode (:bytes (first (filter #(= relative (:source %)) data)))))
(defn locate!
 "A bounded JSON pointer, traversed as data only. Missing differs from present nil."
 [data pointer]
 (require! (and (string? pointer) (String/starts_with? pointer "/")) "exact locator required")
 (let [parts (vec (rest (String/split pointer "/")))]
  (require! (<= (count parts) 12) "locator depth")
  (reduce (fn [value part]
            (cond
             (map? value) (do (require! (contains? value part) "locator key missing") (get value part))
             (vector? value) (let [index (json/decode part)]
                              (require! (and (int? index) (<= 0 index) (< index (count value))) "locator index missing")
                              (nth value index))
             :else (throw (ex-info "formal.research-evidence: locator crossed a scalar" {})))) data parts)))
(defn- evidence [relative locator] {:source relative :locator locator})
(defn- row [identity label finding state references]
 {:id identity :label label :finding finding :state state :evidence references})
(defn build
 "Read actual fixed qualification sources. This produces view data, not logical authority."
 [root]
 (let [data (sources root) pin (source data "sdk-pin.json")
       qualification (source data "evidence/scalar-integration/qualification.json")
       records (source data "evidence/scalar-integration/records-qualification.json")
       native (source data "evidence/scalar-integration/native-comparison.json")
       one (source data "evidence/scalar-integration/reader-one.json")
       two (source data "evidence/scalar-integration/reader-two.json")
       corpus (source data "evidence/scalar-integration/corpus.json")
       word-proof (source data "evidence/scalar-integration/word-native.json")
       proof-packets (source data "evidence/scalar-integration/evidence-packets.json")
       descriptor (logic/checking-policy {:profile logic/numeric-word-policy})]
  (require! (= "passed" (get qualification "status") (get records "status") (get native "status")) "qualified sources required")
  (require! (= pin (get qualification "sdk_pin") (get records "sdk_pin") (get native "sdk_pin")) "sources describe another SDK")
  (require! (= (get pin "sdk") (System/get_env "BL_SDK_PRODUCT") (get corpus "producer-sdk")) "actual selected SDK required")
  (require! (= 20 (count (get corpus "rows")) (count (get one "rows")) (count (get two "rows"))) "complete captured cohort required")
  (require! (= 0 (get one "solver-exchanges") (get two "solver-exchanges")
                 (get one "oracle-calls") (get two "oracle-calls")) "solver-denied readers required")
  (require! (= false (get qualification "compiler_proof_authority") (get corpus "compiler-proof-authority")) "unprivileged evidence required")
  (require! (= 2 (count (get word-proof "rows"))) "both actual word proof observations required")
  (require! (= (sha (:bytes (first (filter #(= "evidence/scalar-integration/word-native.json" (:source %)) data))))
               (get-in qualification ["focused_artifact_sha256" "word-native.json"]))
            "word proof capture must match the qualified focused output")
  (doseq [r (get word-proof "rows")]
   (require! (and (= (get pin "sdk") (get-in r ["identity" "sdk"]))
                  (= "solver-claim" (get r "native-verdict"))
                  (= "not-checked" (get-in r ["native-certificate" "status"]))
                  (= "checked" (get-in r ["independent-check" "status"]))
                  (= 8 (get-in r ["independent-check" "points-checked"]))
                  (= "not-established" (get-in r ["independent-check" "feasibility"])))
             "native claim and independent conditional check must remain separate"))
  (require! (and (= (get pin "sdk") (get proof-packets "sdk"))
                 (= "passed" (get proof-packets "status")) (= 2 (get proof-packets "packets"))
                 (= 0 (get proof-packets "native-exchanges") (get proof-packets "oracle-calls")))
            "actual solver-denied certificate packet reader required")
  (let [recorded (get qualification "recorded_utc")
        _ (require! (and (string? recorded) (>= (erlang/byte_size recorded) 4)) "recorded qualification period required")
        year (json/decode (subs recorded 0 4))
        rows [(row "terms" "One complete question" "Width, assumptions and checking policy travel as BL data." :supported
                   [(evidence "evidence/scalar-integration/corpus.json" "/rows/0/request-reference")])
              (row "native" "Z3 and OxiZ" "Both real owners were exercised; their reported result remains a claim." :supported
                   [(evidence "evidence/scalar-integration/native-comparison.json" "/questions")])
              (row "points" "A point BL can check" "Two fresh readers rechecked twenty saved word/text answers each, without asking a solver." :supported
                   [(evidence "evidence/scalar-integration/records-qualification.json" "/fresh_sdk_only_readers")])
              (row "wrong-point" "An altered answer" "Wrong coordinates remain invalid after saving and re-encoding." :supported
                   [(evidence "evidence/scalar-integration/reader-one.json" "/rows/1/verdict")])
              (row "ledger" "One saved record" "Selected lookup validates one payload, then freshly checks its point." :supported
                   [(evidence "evidence/scalar-integration/reader-one.json" "/ledger/0/lookup-normalizer-calls")])
              (row "proof" "A checked proof" "A separate finite checker checked the wrapping theorem over eight values. The conclusion is conditional on its listed assumptions." :supported
                   [(evidence "evidence/scalar-integration/word-native.json" "/rows/0/independent-check/points-checked")
                    (evidence "evidence/scalar-integration/evidence-packets.json" "/native-exchanges")])
              (row "program" "An ordinary BL program" "Source and compiler correspondence need their own evidence." :candidate
                   [(evidence "evidence/scalar-integration/qualification.json" "/compiler_proof_authority")])]
        edges (mapv (fn [r]
                      {:id (str "receipt-" (:id r)) :from "word-answer" :to (:id r)
                       :relation :recorded-evidence :from-year year :to-year year :state (:state r) :evidence (:evidence r)}) rows)
        result (elements/element
                 {:question "What does the evidence establish about a word answer?"
                  :basis (:sha256 (graph/of {:producer "formal/word-evidence" :producer-version revision
                                            :renderer renderer :renderer-version 1
                                            :sources (mapv #(select-keys % [:id :revision]) data)}))
                  :scope {:sdk (get pin "sdk") :semantic-profile logic/numeric-word-policy
                          :period :recorded-qualification :recorded-at recorded :compiler-proof-authority false}
                  :year year :recipe {:id "formal/word-evidence" :version revision}}
                 {:kind :comparison :title "What a word answer carries" :rows rows :edges edges
                  :entity-ids (vec (cons "word-answer" (map :id rows))) :edge-ids (mapv :id edges)
                  :source-ids source-paths :sources (mapv #(select-keys % [:id :source :revision]) data)
                  :summary "Native status, replayed points and proof authority remain separate."})]
   (doseq [r rows reference (:evidence r)]
    (locate! (source data (:source reference)) (:locator reference)))
   (require! (= :not-checked (:certificates descriptor)) "unexpected checking capability; update this view explicitly")
   (assoc result :origin :qualified-implementation-evidence :compiler-proof-authority false))))
(defn validate!
 "Only this installed comparison contract is renderable; strings choose no callable."
 [saved]
 (require! (and (map? saved) (int? (:version saved)) (= 1 (:version saved))
                (= :comparison (:kind saved)) (= renderer (:function saved))
                (int? (:function-version saved)) (= 1 (:function-version saved))
                (= :qualified-implementation-evidence (:origin saved))
                (= false (:compiler-proof-authority saved))
                (string? (:basis saved)) (Regex/match? #"^[0-9a-f]{64}$" (:basis saved))
                (vector? (:rows saved)) (<= 1 (count (:rows saved)) 16)) "installed finite comparison required")
 (doseq [r (:rows saved)]
  (require! (and (= #{:id :label :finding :state :evidence} (set (keys r)))
                 (every? string? [(:id r) (:label r) (:finding r)])
                 (contains? #{:supported :candidate :disputed} (:state r))
                 (every? #(and (contains? (set source-paths) (:source %)) (string? (:locator %)) (not (blank? (:locator %)))) (:evidence r)))
            "closed located row required")
  (when (= :supported (:state r)) (require! (elements/supported? r) "supported row lacks a locator")))
 saved)
(defn read-snapshots [path]
 (if (File/exists? path)
  (let [bytes (File/read! path)]
   (require! (<= (erlang/byte_size bytes) 8388608) "snapshot store capacity")
   (mapv validate! (elements/read-records bytes))) []))
(defn append-snapshot!
 "Append native Org through the one review host's serialized atomic writer."
 ([root path] (append-snapshot! root path nil))
 ([root path expected-basis]
 (global/trans (tuple (tuple :formal/research-snapshot (Path/expand path)) (erlang/self))
  (fn []
   (let [prior (read-snapshots path) current (validate! (build root))
         number (inc (count prior)) saved (assoc current :snapshot-revision number :element-id id)
         _ (when (and expected-basis (not= expected-basis (:basis current)))
             (throw (ex-info "Source basis changed during save" {:kind :stale-basis})))
         before (if (File/exists? path) (File/read! path) "")
         record (elements/org-record (str id "-" number) (:title saved) saved)
         output (str before (when (seq before) "\n") record)
         temporary (str path "." (System/unique_integer (list :positive)) ".tmp")]
    (require! (<= (erlang/byte_size output) 8388608) "snapshot store capacity")
    (File/mkdir_p! (Path/dirname path))
    (try (File/write! temporary output) (File/rename! temporary path)
     (finally (when (File/exists? temporary) (File/rm temporary))))
    {:snapshot (last (read-snapshots path)) :revisions number :freshness :current})))))
