(ns formal.wide-admission-check
 (:require [formal.wide-admission :as wide] [formal.term :as t] [formal.query :as q]
           [formal.question-graph :as qg] [formal.graph-question :as inventory]
           [formal.data-graph :as graph] [formal.request :as request]
           [formal.point-profile :as point] [formal.backend :as backend]
           [formal.advanced-cases :as advanced] [formal.feature-cases :as features]
           [formal.native-cases :as native] [bl.json :as json] [oracle]))
(def entered (atom []))
(def observations (atom []))
(defn enter! [id] (swap! entered conj id))
(defn emit! [id value] (swap! observations conj {:case id :value value}))
(defn subject [term] (qg/prepare (q/prove term {:vacuity :allow})))
(defn raw-subject [term]
 {:formal/question-graph 1 :profile qg/profile :graph (graph/encode (q/prove term {:vacuity :allow}))})
(defn trace-count [f]
 (let [module (elem (erlang/fun_info f :module) 1) name (elem (erlang/fun_info f :name) 1)
       arity (elem (erlang/fun_info f :arity) 1)] (tuple module name arity)))
(deftest admit-all-retained-native-vocabulary-without-inventing-checkers
 (enter! :native-vocabulary)
 (let [cases (vec (concat (advanced/cases) (features/all-cases) (native/cases)))
       calls (atom 0) deny (fn [& _] (swap! calls inc) (throw :wide-admission-must-not-query))
       pattern (trace-count backend/invoke)]
  (is (= 187 (count cases)))
  (is (= 1 (erlang/trace_pattern pattern true (list :local :call_count))))
  (try
   (oracle/with-oracle {:query deny :query-graph deny :script deny :request deny :request-evidence deny}
    (fn []
     (let [rows (mapv (fn [c]
                        (let [original (qg/prepare (q/from-case c)) admitted (wide/admit original)]
                         (is (= :admitted (:status admitted)) (str (:id c) " " (:reason admitted) " " (:details admitted)))
                         (is (= (qg/reference original) (:subject-reference admitted)))
                         (is (= :not-installed (:point-checking admitted)))
                         (is (= [] (:proof-strategies admitted)))
                         (is (= :none (:admission-authority admitted)))
                         {:id (:id c) :status (:status admitted)
                          :subject-reference (:subject-reference admitted)
                          :operators (:admitted-operators admitted) :screening (:screening admitted)})) cases)]
      (is (= 0 @calls (elem (erlang/trace_info pattern :call_count) 1)))
      (emit! :corpus {:rows rows :native-exchanges 0 :oracle-calls @calls})) ))
   (finally (erlang/trace_pattern pattern false (list :local :call_count))))))
(deftest wide-typing-does-not-install-a-narrow-point-interpreter
 (enter! :admission-versus-replay)
 (let [a (t/variable "wide.array" (t/array-sort t/Int t/Int))
       original (subject (t/eq (t/select (t/store a (t/int 2) (t/int 9)) (t/int 2)) (t/int 9)))
       narrow (request/prepare original)
       wide-result (wide/admit original)]
  (is (= :admitted (:status wide-result)))
  (is (= :not-observed (:backend-support wide-result)))
  (is (= :not-run (:native-execution wide-result)))
  (is (= false (:checked-native-execution wide-result) (:compiler-proof-authority wide-result)))
  (is (thrown? (point/with-question (:subject narrow) (:policy narrow) (fn [& _] nil))))
  (emit! :array {:wide (select-keys wide-result [:status :admitted-operators :point-checking :proof-strategies :backend-support])
                :narrow-point-admission :refused})))
(deftest no-constructors-run-before-the-reader-allowance-fits
 (enter! :prospective-work)
 (let [x (t/variable "wide.work" t/Real) original (subject (t/eq x (t/real 1 3)))
       pattern (trace-count inventory/prepare-keys)]
  (is (= 1 (erlang/trace_pattern pattern true (list :local :call_count))))
  (try
   (let [refused (wide/admit original {:work-units 0})]
    (is (= :incomplete (:status refused)))
    (is (= :work-units (get-in refused [:details :metric])))
    (is (= 0 (elem (erlang/trace_info pattern :call_count) 1))))
   (finally (erlang/trace_pattern pattern false (list :local :call_count))))
  (is (= :admitted (:status (wide/admit original))))))
(deftest untrusted-diagnostics-and-invalid-binders-cannot-bypass-fresh-typing
 (enter! :fresh-original)
 (let [bound (t/bound "wide.bound" t/Int)
       closed (subject (t/forall [bound] (t/eq bound bound)))
       escaped (raw-subject (t/eq bound bound))
       good (wide/admit closed)
       malformed (assoc closed :graph (graph/patch-map (:graph closed)
                         [[(graph/encode :claim) (graph/encode (t/bool false))]]))]
  (is (= :admitted (:status good)))
  (is (= :rejected (:status (wide/admit escaped))))
  (is (= :rejected (:status (wide/admit malformed)))))
 (is (thrown? (wide/admit (subject (t/bool true)) {:inventory {:status :admitted}}))))
(deftest scalar-and-shared-descriptor-refusals-precede-typed-construction
 (enter! :bounded-construction)
 (let [too-large (t/int (erlang/bsl 1 300))
       too-wide (subject (t/eq too-large too-large))
       text (t/text (String/duplicate "x" 4097))
       too-long (subject (t/eq text text))
       deep-sort (reduce (fn [s _] (t/array-sort s s)) t/Int (range 11))
       deep (t/variable "wide.deep" deep-sort)
       source (subject (t/eq deep deep)) pattern (trace-count inventory/prepare-keys)]
  (is (= 1 (erlang/trace_pattern pattern true (list :local :call_count))))
  (try
   (doseq [original [too-wide too-long source]]
    (is (= :incomplete (:status (wide/admit original)))))
   (is (= 0 (elem (erlang/trace_info pattern :call_count) 1)))
   (finally (erlang/trace_pattern pattern false (list :local :call_count))))))
(deftest graph-native-keys-and-unfamiliar-provenance-stay-unmaterialized
 (enter! :original-data)
 (let [unknown {:formal/data-graph 1 :profile graph/profile :root 0
                :nodes [["keyword" "formal.wide.unfamiliar.provenance.20261114"]]}
       history (reduce (fn [data _] (graph/assemble "vector" [data data])) unknown (range 17))
       x (t/variable "wide.provenance" t/Int)
       original (qg/patch (qg/prepare (q/prove (t/eq x x) {:observe {"input" x}})) {:origin history})
       before (graph/bytes (:graph original)) result (wide/admit original)]
  (is (= :admitted (:status result)))
  (is (= 0 (get-in result [:inventory :checking :materialized-keys])))
  (is (= before (graph/bytes (:graph original))))
  (is (> (:expanded-nodes (graph/check! (:graph original))) 200000))
  (is (thrown? (erlang/binary_to_existing_atom "formal.wide.unfamiliar.provenance.20261114" :utf8)))))
(deftest write-actual-admission-observations
 (enter! :capture)
 (when-let [path (System/get_env "FORMAL_WIDE_ADMISSION_OUTPUT")]
  (File/write! path (json/encode {:schema "bl.wide-admission-prototype.v1" :sdk (System/get_env "BL_SDK_PRODUCT")
     :entered-tests @entered :observations @observations :in-sdk false :compiler-proof-authority false}
      {:pretty 2}))))
(run-tests)
