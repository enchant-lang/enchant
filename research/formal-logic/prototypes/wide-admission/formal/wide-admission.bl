(ns formal.wide-admission
 (:require [formal.data-graph :as graph] [formal.request-header :as header]
           [formal.graph-question :as question] [formal.resources.rational :as rational]))

;; A bounded, independently repeated front-end experiment. Its inventory is
;; diagnostic data, never an owner admission token or an independently checked
;; proof. No point semantics or native capability is inferred from term typing.
(def profile :bl/wide-term-admission-prototype-v1)
(def limits {:source-nodes 4096 :source-edges 32768 :source-bytes 262144
             :integer-bits 256 :scalar-bytes 4096 :term-shaped-maps 512
             :arguments 64 :sort-expanded-nodes 1024 :sort-depth 12
             :datum-expanded-nodes 4096 :datum-depth 24 :component-occurrences 32768
             :binder-declarations 32 :work-units 10000000})
(def constructor-reservation 5000000)
(defn- require! [ok why]
 (when-not ok (throw (ex-info (str "formal.wide-admission: " why) {:kind :wide-admission}))))
(defn- children [[kind body]]
 (cond (= "map" kind) (vec (mapcat identity body))
       (contains? #{"vector" "list" "tuple" "set"} kind) body :else []))
(defn- fields [rows pairs]
 (into {} (keep (fn [[key value]]
                  (let [[tag name] (nth rows key)]
                   (when (= "keyword" tag) [name value]))) pairs)))
(defn- settings [options]
 (require! (and (= :map (rt/kind-kind options))
                (or (nil? (meta options)) (= {} (meta options)))
                (every? #{:work-units} (keys options))) "closed work allowance required")
 (let [work (get options :work-units (:work-units limits))]
  (require! (and (int? work) (<= 0 work 20000000)) "bounded integer work allowance required")
  work))
(defn- refuse! [metric required maximum]
 (when (> required maximum)
  (throw (ex-info "formal.wide-admission: prospective resource refusal"
           {:kind :resource-limit :metric metric :required required :limit maximum}))))
(defn- screen
 "Inspect original raw rows before any selected descriptor decoding or term
  constructor. All scalar rows and term-shaped maps count conservatively,
  including ignored provenance. Those rows gain no operational meaning."
 [subject work]
 (let [head (header/inspect subject) data (:graph subject) rows (:nodes data)
       checked (graph/check! data) shapes (atom []) metrics (atom [])
       components (atom #{}) binders (atom 0) rational-work (atom 0)]
  (doseq [[metric required maximum]
           [[:source-nodes (count rows) (:source-nodes limits)]
            [:source-edges (:edges checked) (:source-edges limits)]
            [:source-bytes (:bytes checked) (:source-bytes limits)]]]
   (refuse! metric required maximum))
  ;; An integer is already supplied data. Compare its ETF size before any
  ;; arithmetic that could normalize or expand it. Include the small-int and
  ;; external-term headers conservatively, then check the exact numeric bound.
  (doseq [id (range (count rows))]
   (let [[kind body :as row] (nth rows id) cs (children row)
         prior (mapv #(nth @metrics %) cs)
         info {:occurrences (inc (reduce + 0 (map :occurrences prior)))
               :depth (if (seq prior) (inc (reduce max 0 (map :depth prior))) 0)}]
    (cond
     (= "int" kind)
      (do (refuse! :integer-carrier-bytes (erlang/external_size body) 40)
          (refuse! :integer-magnitude (if (< body 0) (- body) body) (dec (erlang/bsl 1 (:integer-bits limits)))))
     (contains? #{"binary" "symbol" "keyword"} kind)
      (refuse! :scalar-bytes (erlang/byte_size body) (:scalar-bytes limits)))
    (swap! metrics conj info)
    (when (= "map" kind)
     (let [f (fields rows body)]
      (when (= ["int" 1] (when-let [tag (get f "formal/term")] (nth rows tag)))
       (require! (and (= 5 (count body)) (= #{"formal/term" "op" "sort" "args" "data"} (set (keys f))))
                 "closed term-shaped map required")
       (refuse! :term-shaped-maps (inc (count @shapes)) (:term-shaped-maps limits))
       (let [[arg-kind arguments] (nth rows (get f "args"))
             op (nth rows (get f "op")) sort-info (nth @metrics (get f "sort"))
             datum-info (nth @metrics (get f "data"))]
        (require! (contains? #{"vector" "list"} arg-kind) "ordered arguments required")
        (refuse! :arguments (count arguments) (:arguments limits))
        (refuse! :sort-expanded-nodes (:occurrences sort-info) (:sort-expanded-nodes limits))
        (refuse! :sort-depth (:depth sort-info) (:sort-depth limits))
        (refuse! :datum-expanded-nodes (:occurrences datum-info) (:datum-expanded-nodes limits))
        (refuse! :datum-depth (:depth datum-info) (:datum-depth limits))
        (swap! components into (map #(get f %) ["op" "sort" "data"]))
        (when (contains? #{["keyword" "forall"] ["keyword" "exists"]} op)
         (let [[tag declarations] (nth rows (get f "data"))]
          (require! (contains? #{"vector" "list"} tag) "ordered declarations required")
          (refuse! :binder-declarations (+ @binders (count declarations)) (:binder-declarations limits))
          (swap! binders + (count declarations))))
        (when (= ["keyword" "real"] op)
         (let [[tag pair] (nth rows (get f "data"))
               _ (require! (and (contains? #{"vector" "list"} tag) (= 2 (count pair))) "rational pair required")
               values (mapv #(nth rows %) pair)
               _ (require! (every? #(= "int" (first %)) values) "integer rational coordinates required")
               point (mapv second values)
               plan (rational/plan :normalize [point] {:component-bits 256 :intermediate-bits 512 :work-units 20000000})]
          (when-not (= :ready (:status plan))
           (throw (ex-info "formal.wide-admission: bounded rational normalization refused" (:reason plan))))
          (swap! rational-work + (get-in plan [:forecast :work-units]))))
        (swap! shapes conj id))))))
  (let [expanded (reduce + 0 (map #(:occurrences (nth @metrics %)) @components))
        required (+ constructor-reservation (* 64 (count rows)) (* 8 expanded) @rational-work)]
   (refuse! :component-occurrences expanded (:component-occurrences limits))
   (refuse! :work-units required work)
   {:header head :reference (:reference checked) :source-nodes (count rows)
    :term-shaped-maps (count @shapes) :component-occurrences expanded
    :binder-declarations @binders :reserved-work-units required
    :rational-normalization-work @rational-work})))
(defn admit
 "Fresh typed original-graph admission, separated from replay and proof.
  Every call reconstructs its inventory. A returned inventory is never an
  accepted caller token; another consumer must re-admit the original graph."
 ([subject] (admit subject {}))
 ([subject options]
  (let [work (settings options)
        base {:profile profile :point-checking :not-installed :proof-strategies []
              :native-execution :not-run :backend-support :not-observed
              :compiler-proof-authority false :checked-native-execution false}]
   (try
    (let [screening (screen subject work)
          inventory (question/prepare-keys subject)]
     (merge base {:status :admitted :subject-reference (:reference screening)
                  :screening (dissoc screening :header) :inventory inventory
                  :admitted-operators (vec (sort (distinct (map #(nth % 1) (get-in inventory [:forest :nodes])))))
                  :admission-authority :none :constructor-execution :run}))
    (catch error
     (let [why (ex-data error)]
      (merge base {:status (if (= :resource-limit (:kind why)) :incomplete :rejected)
                   :reason (ex-message error) :details why :admission-authority :none
                   :typed-inventory :not-produced})))))))
