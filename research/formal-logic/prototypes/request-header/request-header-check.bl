(ns formal.request-header-check
 (:require [formal.request-header :as header] [formal.data-graph :as graph]
           [formal.question-graph :as qg] [formal.point-profile :as policy]
           [formal.request :as request]
           [formal.term :as t] [formal.query :as q] [formal.backend :as backend]
           [bl.json :as json] [oracle]))
(def entered (atom []))
(def measured (atom nil))
(defn persist! []
 (when-let [path (System/get_env "FORMAL_REQUEST_HEADER_OUTPUT")]
  (File/write! path (json/encode {:entered-tests @entered :measurement @measured
                                :sdk (System/get_env "BL_SDK_PRODUCT") :compiler-proof-authority false} {:pretty 2}))))
(defn enter! [name] (swap! entered conj name) (persist!))
(defn rejected? [f] (try (f) false (catch _ true)))
(defn with-data [subject key value]
 (assoc subject :graph (graph/patch-map (:graph subject) [[(graph/encode key) (graph/encode value)]])))
(defn counted [f]
 (let [module (elem (erlang/fun_info graph/check! :module) 1) pattern (tuple module :check! 1)]
  (is (= 1 (erlang/trace_pattern pattern true (list :local :call_count))))
  (try
   (let [result (f) calls (elem (erlang/trace_info pattern :call_count) 1)] {:result result :calls calls})
   (finally (erlang/trace_pattern pattern false (list :local :call_count))))))
(deftest accepted-original-headers-have-the-same-complete-reference
 (enter! :accepted)
 (doseq [subject [(qg/prepare (q/prove (t/bool true))) (qg/prepare (q/sat {:assumptions [(t/bool true)]}))]]
  (let [old (header/previous subject) current (header/inspect subject)]
   (is (= old (:subject current)))
   (is (= (:subject (request/prepare subject)) (:subject current)))
   (is (= (graph/reference (:graph old)) (:subject-reference current)))
   (is (= :not-run (:typed-admission current) (:native-execution current)))
   (is (= false (:compiler-proof-authority current))))))
(deftest malformed-headers-and-wrappers-are-refused-by-both-paths
 (enter! :refusals)
 (let [subject (qg/prepare (q/prove (t/bool true)))
       cases [(with-data subject :formal/query 1.0) (with-data subject :formal/query 2)
              (with-data subject :mode :misspelled) (with-data subject :mode nil)
              (with-data subject :assertions nil) (with-data subject :assertions (list))
              (assoc subject :cached true) (assoc subject :formal/question-graph 1.0)
              (assoc subject :profile "bl/portable-question-graph-v1")]]
  (doseq [changed cases]
   (is (rejected? #(header/previous changed)))
   (is (rejected? #(request/prepare changed)))
   (is (rejected? #(header/inspect changed))))))
(deftest unfamiliar-shared-metadata-is-bound-without-decoding
 (enter! :metadata)
 (let [subject (qg/prepare (q/prove (t/bool true)))
       unknown {:formal/data-graph 1 :profile graph/profile :root 0
                :nodes [["keyword" (str "request.header.unknown." (System/unique_integer (list :positive)))]]}
       shared (reduce (fn [g _] (graph/assemble "vector" [g g])) unknown (range 17))
       data (graph/patch-map (:graph subject) [[(graph/encode :origin) shared]])
       original (assoc subject :graph data) result (header/inspect original)]
  (is (> (:expanded-nodes (graph/check! data)) 100000))
  (is (= (graph/reference data) (:subject-reference result)))
  (is (= original (header/previous original)))
  (is (= original (:subject (request/prepare original))))
  (is (thrown? (qg/materialize! original)))))
(deftest a-valid-header-is-not-a-typed-admission
 (enter! :not-typed)
 (let [subject (qg/prepare (q/prove (t/bool true))) changed (with-data subject :claim (t/int 1))]
  (is (= changed (header/previous changed)))
  (is (= changed (:subject (header/inspect changed))))
  (is (= changed (:subject (request/prepare changed))))
  (is (thrown? (policy/with-question changed {} (fn [_ _] :must-not-admit))))))
(deftest one-original-check-replaces-the-repeated-field-subgraph-checks
 (enter! :measurement)
 (let [x (t/variable "request.header.x" t/Int)
       subject (qg/prepare (q/prove (t/ge (t/add x (t/int 1)) x) {:assumptions [(t/ge x (t/int 0))]}))
       _ (header/previous subject) _ (header/inspect subject)
       old (counted #(header/previous subject)) current (counted #(header/inspect subject))]
  (is (>= (:calls old) 6))
  (is (= 1 (:calls current)))
  (is (= (:result old) (get-in current [:result :subject])))
  (reset! measured {:fixture :small-integer-question :previous-graph-check-invocations (:calls old)
                   :single-pass-graph-check-invocations (:calls current)
                   :reference-path :copied-subject-header-block
                   :claim :graph-check-invocations-only :universal-speed-claim false})
  (persist!)))
(deftest header-inspection-needs-no-native-or-oracle-owner
 (enter! :no-native)
 (let [subject (qg/prepare (q/prove (t/bool true)))
       module (elem (erlang/fun_info backend/invoke :module) 1) pattern (tuple module :exchange! 4)
       calls (atom 0) deny (fn [& _] (swap! calls inc) (throw :must-not-query))]
  (is (= 1 (erlang/trace_pattern pattern true (list :local :call_count))))
  (try
   (oracle/with-oracle {:query deny :query-graph deny :script deny :request deny :request-evidence deny}
    #(is (= subject (:subject (header/inspect subject)))))
   (is (= 0 @calls (elem (erlang/trace_info pattern :call_count) 1)))
   (finally (erlang/trace_pattern pattern false (list :local :call_count))))))
(run-tests)
