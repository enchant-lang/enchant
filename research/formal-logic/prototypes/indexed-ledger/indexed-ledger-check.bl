(ns formal.indexed-ledger-prototype-check
 (:require [formal.indexed-ledger-prototype :as ledger] [formal.indexed-request-record-prototype :as record]
           [formal.data-graph :as graph] [formal.backend :as backend] [datom] [datom.value-codec :as codec]
           [bl.json :as json] [oracle] [formal.request :as request] [formal.request-answer :as answer]
           [formal.retained-composition :as composition] [formal.question-graph :as qg]))

(defn- counted [function name arity action]
 (let [module (elem (erlang/fun_info function :module) 1) pattern (tuple module name arity)]
  (is (= 1 (erlang/trace_pattern pattern true (list :local :call_count))))
  (try (let [result (action) calls (elem (erlang/trace_info pattern :call_count) 1)] {:result result :calls calls})
   (finally (erlang/trace_pattern pattern false (list :local :call_count))))))
(defn- normalized [action] (counted ledger/lookup :normalize-row 2 action))
(defn- restore [wire]
 {:formal/data-graph 1 :profile graph/profile :root (get wire "root")
  :nodes (mapv (fn [[tag payload]]
                 [tag (if (contains? #{"binary" "float64"} tag) (Base/decode64! payload) payload)]) (get wire "nodes"))})
(def corpus (json/decode (File/read! (System/get_env "INDEXED_LEDGER_CORPUS"))))
;; Load only the named packet schema modules. Graph payloads never choose a
;; namespace and unknown application names are never interned here.
(def protocol-profiles [record/profile request/profile answer/profile answer/retained-profile composition/profile qg/profile])
(def missing-protocol-names
 (vec (distinct (mapcat (fn [entry]
                         (keep (fn [[tag name]]
                                 (when (= "keyword" tag)
                                  (try (erlang/binary_to_existing_atom name :utf8) nil (catch _ name))))
                               (get-in entry ["packet" "nodes"]))) (get corpus "rows")))))
(when (seq missing-protocol-names)
 (throw (ex-info (str "Outer packet vocabulary is not loaded: " missing-protocol-names) {:missing missing-protocol-names})))
(def packets (mapv (fn [row] {:id (get row "id") :expected (keyword (get row "expected"))
                            :packet (graph/decode! (restore (get row "packet")))}) (get corpus "rows")))

(deftest lookup-preserves-selected-payload-validation-without-decoding-unrelated-records
 (let [connection (ledger/open nil) calls (atom 0)
       deny (fn [& _] (swap! calls inc) (throw :indexed-ledger-must-not-query))]
  (try
   (let [actual
         (counted backend/invoke :exchange! 4
          (fn []
           (oracle/with-oracle {:query deny :query-graph deny :script deny :request deny}
            (fn []
             (is (= 12 (count packets)))
             (is (= #{2 3} (set (map #(get-in % [:packet :answer :formal/request-answer]) packets))))
             (let [stored (mapv (fn [entry]
                                  (assoc entry :stored-id (record/record! connection
                                                           (get-in entry [:packet :request]) (get-in entry [:packet :answer])
                                                           {:claim (:id entry)}))) packets)
                   all (normalized #(ledger/all connection))
                   by-id (into {} (map (fn [row] [(:verdict/id row) row]) (:result all)))]
              (is (= 12 (:calls all)))
              (is (= 12 (count by-id)))
              (doseq [entry stored]
               (let [id (:stored-id entry) selected (normalized #(ledger/lookup connection id))
                     reopened (normalized #(record/reopen connection id))]
                (is (= 1 (:calls selected)))
                (is (= 1 (:calls reopened)))
                (is (= (get by-id id) (:result selected)))
                (is (= (:expected entry) (get-in reopened [:result :result :verdict])))
                (is (= false (get-in reopened [:result :checked-native-execution])))
                (is (= false (get-in reopened [:result :compiler-proof-authority])))))
              (let [missing (normalized #(ledger/lookup connection "missing.id"))]
               (is (nil? (:result missing)))
               (is (= 0 (:calls missing))))
              (doseq [id [nil :bad-id 1 false]]
               (let [r (normalized #(try (ledger/lookup connection id) :accepted (catch _ :refused)))]
                (is (= :refused (:result r)))
                (is (= 0 (:calls r)))))
              (is (thrown? (record/reopen connection "missing.id")))
              (let [good (:stored-id (first stored)) bad (:stored-id (second stored))
                    invalid (datom/put-file! connection (codec/encode {:broken true})
                              {:media-type "application/vnd.beam-lisp.request-verdict-payload.v1"})]
               (datom/transact! connection [{:verdict/id bad :verdict/payload invalid}])
               (let [selected (normalized #(ledger/lookup connection good))]
                (is (= 1 (:calls selected)))
                (is (= (get by-id good) (:result selected))))
               (let [bad-read (normalized #(try (ledger/lookup connection bad) :accepted (catch _ :refused)))]
                (is (= 1 (:calls bad-read)))
                (is (= :refused (:result bad-read))))
               (is (thrown? (ledger/all connection)))
               (is (thrown? (record/reopen connection bad)))))))))]
    (is (= 0 (:calls actual)))
    (is (= 0 @calls)))
   (finally (datom/close! connection)))))

(run-tests)
