(ns formal.core-counterexamples-check
 (:require [formal.api :as formal] [formal.core-counterexample-examples :as examples]
           [formal.runtime-artifact :as artifact] [interop]))

(def out (System/get_env "ENCHANT_FORMAL_EVIDENCE_ROOT"))
(File/mkdir_p! out)
(def rows
 (vec (for [row (examples/specifications) engine [:z3 :oxiz]]
        (let [id (str (:id row) "-" (name engine)) subject (examples/subject row)
              native (examples/discover engine subject)
              observed (formal/observe-protocol-counterexample subject native)
              receipt (:receipt observed)
              made (formal/core-protocol-counterexample-data subject native receipt)
              packet (:packet made)]
         (when-not (and (= :observed (:status observed)) (= :ready (:status made)))
          (println {:id id :observation observed :export made})
          (throw (ex-info "Core counterexample export refused" {:id id})))
         (assert (= :checked-data-connection
                    (:status (formal/check-core-protocol-counterexample-data subject native receipt packet))))
         (File/write! (Path/join out (str id ".json")) (interop/->json packet))
         {:id id :case (:id row) :engine engine :subject subject :native native :receipt receipt :packet packet}))))
(def snapshot {:schema :enchant.formal.core-counterexample-examples-v1 :rows rows
               :source-commit (trim (elem (System/cmd "git" (list "rev-parse" "HEAD")) 0))})
(def bytes (erlang/term_to_binary snapshot (list :deterministic (tuple :minor_version 2))))
(assert (<= (erlang/byte_size bytes) 8388608))
(File/write! (Path/join out "core-counterexamples.etf") bytes)
(File/write! (Path/join out "summary.json") (interop/->json
 {:schema (:schema snapshot) :source-commit (:source-commit snapshot)
  :archive {:bytes (erlang/byte_size bytes) :sha256 (artifact/digest bytes)}
  :rows (mapv (fn [row]
                {:id (:id row) :case (:case row) :engine (:engine row) :packet (get-in row [:packet :identity])
                 :subject (get-in row [:subject :identity]) :query (get-in row [:packet :subject :query])
                 :receipt (get-in row [:receipt :identity]) :events (count (get-in row [:receipt :events]))
                 :completion (frequencies (map #(nth % 3) (get-in row [:packet :bindings])))}) rows)}))
(println {:counterexamples (count rows) :kernel-execution :not-run})
