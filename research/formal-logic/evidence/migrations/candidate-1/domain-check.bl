(ns migration-domain (:require [formal.source :as source] [formal.term :as t] [formal.value :as v]
                              [formal.evaluate :as replay]))
(doseq [form ['(fn [x] (+ x 1)) '(fn [x] (quot 10 x))]]
 (let [result (source/prepare-function form [(t/variable "x" t/Int)]) value (:value result)]
  (println (pr-str {:status (:status result) :reason (:reason result) :domain (:domain value)
                   :scope (v/scope value) :within (v/within value) :closed-within (replay/value (v/within value) {})}))))
