(ns reload.migration-conditional-baseline-test
 (:require [formal.migration :as migration] [formal.term :as t] [formal.value :as v]))

(deftest inactive-errors-do-not-restrict-a-source-migration
 (let [definition (migration/define
                   {:name "conditional-source" :parameters [["message" t/Int]] :message "message"
                    :source-function '(fn [x] (if (> x 0) (+ x 1) (quot 10 0)))
                    :admit-before (fn [in] (t/gt (get in "message") (t/int 0)))
                    :admit-after (fn [_ output] (t/gt (v/term output) (t/int 0)))})
       good (migration/point definition :admission {"message" 1})
       actual (migration/replay-source definition {"message" 1})]
  (is (= :ready (:status (migration/prepare definition))))
  (is (= :ready (:status good)))
  (is (= :valid (:status actual)))
  (is (= 2 (get-in actual [:actual :value])))))
