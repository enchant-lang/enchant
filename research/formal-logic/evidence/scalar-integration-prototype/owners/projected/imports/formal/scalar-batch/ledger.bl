; A durable record of caller verdicts, complete questions and their evidence.
; Recording checks question identity, not mathematical validity. Reports retain
; unknown modalities and explicit witness presence; no row gains proof or
; compiler authority merely by being stored.

(ns formal.scalar-batch.ledger
  (:require [datom] [datom.store-fjall] [datom.file :as file] [datom.value-codec :as codec]
            [formal.identity :as identity] [formal.query :as query]
            [formal.data-graph :as graph] [formal.question-graph :as question-graph] [formal.answer :as answer]
            [formal.scalar-batch.request :as request] [formal.scalar-batch.request-answer :as request-answer]))

(def schema
  [{:db/ident :verdict/id       :db/valueType :db.type/string :db/unique :db.unique/identity}
   {:db/ident :verdict/claim    :db/valueType :db.type/string}
   {:db/ident :verdict/modality :db/valueType :db.type/keyword :db/index true}
   {:db/ident :verdict/engine   :db/valueType :db.type/keyword}
   {:db/ident :verdict/why      :db/valueType :db.type/string}
   {:db/ident :verdict/seed     :db/valueType :db.type/long}
   {:db/ident :verdict/tried    :db/valueType :db.type/long}
   {:db/ident :verdict/witness  :db/valueType :db.type/term}
   {:db/ident :verdict/witness-present :db/valueType :db.type/boolean}
   {:db/ident :verdict/witness-value :db/valueType :db.type/term}
   {:db/ident :verdict/question-id :db/valueType :db.type/string}
   {:db/ident :verdict/question :db/valueType :db.type/term}
   {:db/ident :verdict/format :db/valueType :db.type/keyword}
   {:db/ident :verdict/question-reference :db/valueType :db.type/term}
   {:db/ident :verdict/evidence :db/valueType :db.type/term}
   {:db/ident :verdict/payload :db/valueType :db.type/file}
   {:db/ident :verdict/assurance :db/valueType :db.type/keyword}
   {:db/ident :verdict/compiler-authority :db/valueType :db.type/boolean}
   {:db/ident :verdict/replay   :db/valueType :db.type/string}
   {:db/ident :verdict/about    :db/valueType :db.type/string :db/cardinality :db.cardinality/many :db/index true}
   {:db/ident :verdict/by       :db/valueType :db.type/string}
   {:db/ident :verdict/at       :db/valueType :db.type/long :db/index true}
   {:db/ident :verdict/request-reference :db/valueType :db.type/term}])

(defn open
  "A ledger: a durable datom conn at `path` (fjall), or in memory when `path` is
   nil (tests, throwaway sessions)."
  [path]
  (if (nil? path)
    (datom/connect schema)
    (datom/connect-with (datom.store-fjall/open path) schema)))

(defn- vid []
 (str "vd-" (Base/encode16 (crypto/strong_rand_bytes 16) (list (tuple :case :lower)))))

(def ^:private payload-byte-limit (* 16 1024 1024))
(def ^:private payload-media-type "application/vnd.beam-lisp.verdict-payload.v1")
(def graph-format :bl/graph-verdict-v1)
(def ^:private graph-payload-media-type "application/vnd.beam-lisp.verdict-payload.v2")
(def request-format :bl/request-verdict-preview-v1)
(def ^:private request-payload-media-type "application/vnd.beam-lisp.request-verdict-payload.v1")
(defn- payload!
 ([ledger payload] (payload! ledger payload payload-media-type))
 ([ledger payload media-type]
 (let [bytes (codec/encode payload)]
  (when (> (erlang/byte_size bytes) payload-byte-limit)
   (throw (ex-info "Ledger payload exceeds its explicit byte capacity" {})))
  (datom/put-file! ledger bytes {:media-type media-type}))))

(defn record!
  "Record a caller verdict without granting proof authority, under `meta`
   {:claim str (required) :about [str …] :by str :replay str}. The shrunk
   witness is kept when present (it is the one worth replaying). → the id."
  [ledger v meta]
  (when (or (contains? v :question-graph) (contains? v :question-reference))
   (throw (ex-info "Use record-graph! for explicit graph question references" {})))
  (when-not (and (keyword? (:modality v)) (string? (:claim meta)))
   (throw (ex-info "A ledger record needs an explicit modality and claim" {})))
  (let [at (erlang/system_time :millisecond) id (vid)
        present (or (contains? v :shrunk) (contains? v :witness))
        w (if (contains? v :shrunk) (:shrunk v) (:witness v))
        question (:question v)
        qid (when question (identity/hash (query/validate! question)))
        _ (when (and (:question-identity v) (not= qid (:question-identity v)))
            (throw (ex-info "Ledger question identity does not match the recorded question" {})))
        evidence (select-keys v [:modality :engine :complete :none :answer :source-connection :runtime-replay :projection-replay
                                :claim-kind :evidence :feasibility :optimality :compiler-proof-authority])
        ;; Values occur in covering-index keys. Complete questions and evidence
        ;; can exceed the store's 64 KiB key capacity, even for small contracts.
        ;; Keep their exact value-codec bytes in the existing blob tier instead.
        payload (payload! ledger
                  (cond-> {:veritas/verdict-payload 1 :evidence evidence}
                    qid (assoc :question question)
                    present (assoc :witness [w])))]
    (datom/transact! ledger
      [(cond-> {:db/id -1 :verdict/id id :verdict/claim (:claim meta)
                 :verdict/modality (:modality v) :verdict/at at
                :verdict/witness-present present :verdict/assurance :recorded
                :verdict/compiler-authority false :verdict/payload payload}
         (:engine v) (assoc :verdict/engine (:engine v))
         (:why v) (assoc :verdict/why (:why v))
         (int? (:seed v)) (assoc :verdict/seed (:seed v))
         (int? (:tried v)) (assoc :verdict/tried (:tried v))
         qid (assoc :verdict/question-id qid)
         (:replay meta) (assoc :verdict/replay (:replay meta))
         (:by meta) (assoc :verdict/by (:by meta)))])
    ;; many-valued refs go in as list-form adds: a map-form SET value is
    ;; rejected as one wrong-typed value (measured), not expanded
    (when (seq (:about meta))
      (let [e (first (first (into [] (datom/q '[:find ?e :in $ ?id :where [?e :verdict/id ?id]]
                                              (datom/db ledger) id))))]
        (datom/transact! ledger (mapv (fn [a] [:db/add e :verdict/about a]) (distinct (:about meta))))))
    id))

(defn record-graph!
 "Record an explicitly graph-bound verdict. The question, caller evidence,
  stripped typed answer body and witness are stored separately; the question
  graph occurs once. Binding is checked, not logical validity or execution."
 [ledger v meta]
 (when-not (and (keyword? (:modality v)) (string? (:claim meta))
                (contains? v :question-graph) (not (contains? v :question))
                (not (contains? v :question-identity)))
  (throw (ex-info "A graph verdict needs a graph question, modality and claim" {})))
 (when-not (and (or (nil? (:engine v)) (keyword? (:engine v)))
                (or (nil? (:why v)) (string? (:why v)))
                (or (nil? (:by meta)) (string? (:by meta)))
                (or (nil? (:replay meta)) (string? (:replay meta)))
                (or (nil? (:about meta)) (and (sequential? (:about meta)) (every? string? (:about meta)))))
  (throw (ex-info "Graph verdict index metadata has invalid types" {})))
 (let [context (:question-graph v) opened (question-graph/open! context) reference (:reference opened)
       _ (when (and (contains? v :question-reference)
                    (not= (identity/bytes reference) (identity/bytes (:question-reference v))))
           (throw (ex-info "Ledger graph reference differs from the complete question" {})))
       response (:answer v)
       _ (when (contains? v :answer) (answer/assert-bound-graph! context response))
       present (or (contains? v :shrunk) (contains? v :witness))
       witness (if (contains? v :shrunk) (:shrunk v) (:witness v))
       evidence (select-keys v [:modality :engine :complete :none :source-connection :runtime-replay :projection-replay
                                :claim-kind :evidence :feasibility :optimality :compiler-proof-authority])
       data (cond-> {:veritas/verdict-payload 2 :profile graph-format :question-graph context
                     :evidence-graph (graph/encode evidence)}
              (contains? v :answer) (assoc :answer-body-graph (graph/encode (dissoc response :question-graph)))
              present (assoc :witness-graph (graph/encode [witness])))
       payload (payload! ledger data graph-payload-media-type)
       at (erlang/system_time :millisecond) id (vid)]
  (datom/transact! ledger
   (into [(cond-> {:db/id -1 :verdict/id id :verdict/claim (:claim meta) :verdict/modality (:modality v)
              :verdict/at at :verdict/format graph-format :verdict/question-reference reference
              :verdict/witness-present present :verdict/assurance :recorded
              :verdict/compiler-authority false :verdict/payload payload}
      (:engine v) (assoc :verdict/engine (:engine v))
      (:why v) (assoc :verdict/why (:why v))
      (int? (:seed v)) (assoc :verdict/seed (:seed v))
      (int? (:tried v)) (assoc :verdict/tried (:tried v))
      (:replay meta) (assoc :verdict/replay (:replay meta))
      (:by meta) (assoc :verdict/by (:by meta)))]
    (mapv (fn [a] [:db/add -1 :verdict/about a]) (distinct (:about meta))))) id))

(defn record-request!
 "Store one complete portable request and a separately bound answer graph.
  The small index holds request/subject references and point presence only.
  Storage does not establish validity, delegation or native execution."
 [ledger original response metadata]
 (let [fresh (request/check! original) _ (request-answer/check! fresh response)
       _ (when-not (and (string? (:claim metadata))
                        (or (nil? (:by metadata)) (string? (:by metadata)))
                        (or (nil? (:replay metadata)) (string? (:replay metadata)))
                        (or (nil? (:about metadata))
                            (and (sequential? (:about metadata)) (every? string? (:about metadata)))))
           (throw (ex-info "Request ledger metadata has invalid types" {})))
       data {:veritas/verdict-payload 3 :profile request-format :request fresh
             :answer-body-graph (graph/encode response)}
       payload (payload! ledger data request-payload-media-type)
       at (erlang/system_time :millisecond) id (vid)]
  (datom/transact! ledger
   (into [(cond-> {:db/id -1 :verdict/id id :verdict/claim (:claim metadata)
              :verdict/modality :recorded-request :verdict/engine (get-in fresh [:adapter :backend])
              :verdict/at at :verdict/format request-format
              :verdict/question-reference (request/subject-reference fresh)
              :verdict/request-reference (request/reference fresh)
              :verdict/witness-present (:point-present response) :verdict/assurance :recorded
              :verdict/compiler-authority false :verdict/payload payload}
      (:replay metadata) (assoc :verdict/replay (:replay metadata))
      (:by metadata) (assoc :verdict/by (:by metadata)))]
    (mapv (fn [name] [:db/add -1 :verdict/about name]) (distinct (:about metadata)))))
  id))

(def ^:private PULL
  [:verdict/id :verdict/claim :verdict/modality :verdict/engine :verdict/why
   :verdict/seed :verdict/tried :verdict/witness :verdict/replay :verdict/about
   :verdict/by :verdict/at :verdict/witness-present :verdict/witness-value
   :verdict/question-id :verdict/question :verdict/format :verdict/question-reference :verdict/evidence :verdict/payload :verdict/assurance :verdict/compiler-authority :verdict/request-reference])

(defn- request-payload-row [row payload]
 (when-not (and (= :map (rt/kind-kind payload))
                (= #{:veritas/verdict-payload :profile :request :answer-body-graph} (set (keys payload)))
                (int? (:veritas/verdict-payload payload)) (= 3 (:veritas/verdict-payload payload))
                (= request-format (:profile payload) (:verdict/format row))
                (= :recorded-request (:verdict/modality row)) (= :recorded (:verdict/assurance row))
                (= false (:verdict/compiler-authority row))
                (erlang/is_boolean (:verdict/witness-present row))
                (every? #(not (contains? row %))
                  [:verdict/question-id :verdict/question :verdict/evidence :verdict/witness :verdict/witness-value]))
  (throw (ex-info "Request ledger payload format mismatch" {})))
 (let [fresh (request/check! (:request payload)) body (:answer-body-graph payload)
       response (request-answer/restore fresh body)]
  (when-not (and (= (graph/bytes (graph/encode (request/reference fresh)))
                   (graph/bytes (graph/encode (:verdict/request-reference row))))
                 (= (graph/bytes (graph/encode (request/subject-reference fresh)))
                    (graph/bytes (graph/encode (:verdict/question-reference row))))
                 (= (:point-present response) (:verdict/witness-present row))
                 (= (get-in fresh [:adapter :backend]) (:verdict/engine row)))
   (throw (ex-info "Request ledger payload differs from its indexed record" {})))
  (assoc (dissoc row :verdict/payload) :verdict/request fresh :verdict/answer-body-graph body)))

(defn- graph-payload-row [row payload]
 (let [required #{:veritas/verdict-payload :profile :question-graph :evidence-graph}
       allowed (into required [:answer-body-graph :witness-graph])]
  (when-not (and (= :map (rt/kind-kind payload))
                 (int? (:veritas/verdict-payload payload)) (= 2 (:veritas/verdict-payload payload))
                 (= graph-format (:profile payload)) (= graph-format (:verdict/format row))
                 (not (contains? row :verdict/request-reference))
                 (every? #(contains? payload %) required) (every? #(contains? allowed %) (keys payload))
                 (= :recorded (:verdict/assurance row)) (= false (:verdict/compiler-authority row))
                 (erlang/is_boolean (:verdict/witness-present row))
                 (every? #(not (contains? row %))
                   [:verdict/question-id :verdict/question :verdict/evidence :verdict/witness :verdict/witness-value]))
   (throw (ex-info "Ledger graph payload format mismatch" {})))
  (let [context (:question-graph payload) opened (question-graph/open! context)
        evidence (:evidence-graph payload) witness (:witness-graph payload)
        _ (graph/check! evidence)
        _ (when-not (and (= (identity/bytes (:reference opened)) (identity/bytes (:verdict/question-reference row)))
                         (= "map" (first (nth (:nodes evidence) (:root evidence))))
                         (= (= true (:verdict/witness-present row)) (contains? payload :witness-graph)))
            (throw (ex-info "Ledger graph payload differs from its indexed record" {})))
        _ (when (contains? payload :answer-body-graph)
            (answer/assert-graph-body! context (:answer-body-graph payload)))
        _ (when (contains? payload :witness-graph)
            (graph/check! witness)
            (let [[kind values] (nth (:nodes witness) (:root witness))]
             (when-not (and (= "vector" kind) (= 1 (count values)))
              (throw (ex-info "Ledger graph witness presence mismatch" {})))))]
   (cond-> (assoc (dissoc row :verdict/payload) :verdict/question-graph context :verdict/evidence-graph evidence)
    (contains? payload :answer-body-graph) (assoc :verdict/answer-body-graph (:answer-body-graph payload))
    (contains? payload :witness-graph) (assoc :verdict/witness-graph witness)))))
(defn- legacy-payload-row [row payload]
 (let [question (:question payload)]
  (when-not (and (map? payload) (= 1 (:veritas/verdict-payload payload)) (map? (:evidence payload))
                 (nil? (:verdict/format row)) (nil? (:verdict/question-reference row)) (nil? (:verdict/request-reference row))
                 (= (boolean (:verdict/question-id row)) (contains? payload :question))
                 (or (not (contains? payload :question)) (= (:verdict/question-id row) (identity/hash (query/validate! question))))
                 (= (= true (:verdict/witness-present row)) (contains? payload :witness))
                 (or (not (contains? payload :witness)) (and (vector? (:witness payload)) (= 1 (count (:witness payload))))))
   (throw (ex-info "Ledger payload does not match its indexed record" {})))
  (cond-> (assoc (dissoc row :verdict/payload) :verdict/evidence (:evidence payload))
   question (assoc :verdict/question question)
   (contains? payload :witness) (assoc :verdict/witness-value (:witness payload)))))
(defn- normalize-row [db row]
 (let [row (if-let [descriptor (:verdict/payload row)]
             (do
              (when-not (and (file/file? descriptor)
                             (contains? #{payload-media-type graph-payload-media-type request-payload-media-type} (:media-type descriptor))
                             (int? (:size descriptor)) (<= 1 (:size descriptor) payload-byte-limit))
               (throw (ex-info "Ledger payload descriptor is invalid" {})))
              (let [bytes (datom/file-bytes db descriptor)]
               (when-not (and (erlang/is_binary bytes) (= (:size descriptor) (erlang/byte_size bytes))
                              (= (:sha descriptor) (file/sha256 bytes)))
                (throw (ex-info "Ledger payload is missing or corrupt" {})))
               (let [_ (when (= request-payload-media-type (:media-type descriptor)) (request-answer/data-vocabulary))
                     payload (codec/decode bytes)]
                (cond (= graph-payload-media-type (:media-type descriptor)) (graph-payload-row row payload)
                      (= request-payload-media-type (:media-type descriptor)) (request-payload-row row payload)
                      :else (legacy-payload-row row payload)))))
             (do (when (or (contains? row :verdict/format) (contains? row :verdict/question-reference)
                           (contains? row :verdict/request-reference))
                   (throw (ex-info "Referenced ledger record requires its payload" {}))) row))]
  ;; Version 1 keeps its original public shape, including false/nil values.
  ;; Version 2 returns graph data; materialization is always explicit.
  (if (and (nil? (:verdict/format row)) (= true (:verdict/witness-present row)))
   (assoc row :verdict/witness (first (:verdict/witness-value row))) row)))
(defn lookup
 "Read and validate one actual verdict by its unique id from one DB snapshot.
  Unrelated payloads are not decoded. Missing ids return nil; selected payload
  integrity checks are identical to all. No logical authority is granted."
 [connection id]
 (when-not (string? id) (throw (ex-info "Ledger verdict id must be a string" {})))
 (let [db (datom/db connection) row (datom/pull db PULL [:verdict/id id])]
  (when (some? (:verdict/id row))
   (when-not (= id (:verdict/id row)) (throw (ex-info "Ledger unique id lookup differs" {})))
   (normalize-row db row))))

(defn graph-evidence!
 "Explicitly materialize caller evidence and reattach a separately stored
  answer after binding checks. This does not replay or authenticate that answer."
 [row]
 (when-not (= graph-format (:verdict/format row)) (throw (ex-info "Graph ledger row required" {})))
 (cond-> (graph/decode! (:verdict/evidence-graph row))
  (:verdict/answer-body-graph row)
   (assoc :answer (answer/restore-graph-body! (:verdict/question-graph row) (:verdict/answer-body-graph row)))))
(defn graph-witness!
 "Materialize a present graph witness. False and nil remain distinct from an
  absent witness; callers can inspect witness-present without materialization."
 [row]
 (when-not (and (= graph-format (:verdict/format row)) (= true (:verdict/witness-present row)))
  (throw (ex-info "Present graph witness required" {})))
 (first (graph/decode! (:verdict/witness-graph row))))

(defn request-answer!
 "Restore explicitly graph-bound request evidence, without mathematical replay."
 [row]
 (when-not (= request-format (:verdict/format row)) (throw (ex-info "Request ledger row required" {})))
 (request-answer/restore (:verdict/request row) (:verdict/answer-body-graph row)))
(defn recheck-request
 "Freshly replay a stored point. Native status/artifact/delegation labels
  remain recorded claims even after storage integrity and point checks."
 [row]
 (request-answer/recheck (:verdict/request row) (request-answer! row)))

(defn all
  "Every verdict, newest first; `since` (epoch ms) narrows."
  ([ledger] (all ledger 0))
  ([ledger since]
   (let [d (datom/db ledger)
         es (into [] (datom/q '[:find ?e ?at :in $ ?since
                                :where [?e :verdict/at ?at] [(>= ?at ?since)]]
                              d since))]
     (mapv (fn [[e _]]
             (normalize-row d (datom/pull d PULL e)))
           (reverse (sort-by second es))))))

(defn about
  "Every verdict resting on `thing` (a string naming code: \"ns/fn\")."
  [ledger thing]
  (let [d (datom/db ledger)]
    (mapv (fn [[e]] (normalize-row d (datom/pull d PULL e)))
          (into [] (datom/q '[:find ?e :in $ ?t :where [?e :verdict/about ?t]] d thing)))))

(def ^:private SECTIONS
 [[:recorded-request "Recorded formal requests (recheck points explicitly)"]
  [:error "Execution or interface errors"] [:refuted "Refuted"] [:candidate "Unconfirmed candidates"]
  [:unknown "Unknown"] [:unsupported "Unsupported"] [:vacuous "Vacuous"]
  [:witnessed "Witnessed (inspect engine and completeness)"] [:exhausted "Exhausted finite domains"]
  [:solver-claim "Solver claims (certificate unchecked)"]
  [:checked "Recorded checked labels (inspect evidence)"] [:proven "Legacy proven labels (not independently checked here)"]])

(defn- line [v]
  (str "- " (:verdict/claim v)
       " — " (name (or (:verdict/engine v) :unknown))
       (if (some? (:verdict/tried v)) (str ", " (:verdict/tried v) " tried") "")
       (if (some? (:verdict/seed v)) (str ", seed " (:verdict/seed v)) "")
       (if (or (= true (:verdict/witness-present v)) (and (nil? (:verdict/witness-present v)) (some? (:verdict/witness v))))
         (if (= graph-format (:verdict/format v))
          (str "\n  witness: graph data " (pr-str (graph/reference (:verdict/witness-graph v))))
          (str "\n  witness: " (pr-str (:verdict/witness v)))) "")
       (if (some? (:verdict/replay v)) (str "\n  replay: " (:verdict/replay v)) "")
       (if (:verdict/question-id v) (str "\n  question: " (:verdict/question-id v)) "")
       (if (:verdict/question-reference v) (str "\n  graph question: " (pr-str (:verdict/question-reference v))) "")
       "  [" (:verdict/id v) "]"))

(defn report
  "Report every recorded modality with engine, effort, seed and witness.
   Native claims and legacy proof labels remain explicitly unchecked."
  ([ledger] (report ledger 0))
  ([ledger since]
   (let [vs (all ledger since)
         by (group-by :verdict/modality vs)
         known (set (map first SECTIONS))
         sections (concat SECTIONS (map (fn [k] [k (str "Other recorded modality: " (pr-str k))])
                                        (sort-by pr-str (remove #(contains? known %) (keys by)))))]
     (join "\n"
       (mapcat (fn [[k title]]
                 (let [xs (get by k)]
                   (if (empty? xs) []
                     (concat [(str "## " title " (" (count xs) ")")] (map line xs) [""]))))
               sections)))))
