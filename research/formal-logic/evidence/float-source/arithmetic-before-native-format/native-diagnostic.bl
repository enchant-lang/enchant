(ns ieee-native-diagnostic
 (:require [formal.term :as t] [formal.query :as q] [formal.logic :as logic]))
(doseq [[e s] [[2 2] [5 11] [11 53]]]
 (let [sort (t/fp-sort e s) a (t/literal sort 0) b (t/literal sort (erlang/bsl 1 (dec (+ e s))))
       expression (t/app :fp-add sort [(t/literal t/Rounding "RNE") a b] nil)
       question (q/prove (t/eq expression a) {:vacuity :allow})
       answer (logic/run {:backend :z3} question)]
  (println (pr-str {:format [e s] :result (select-keys answer [:solver-status :verdict :phase :why :error :backend :identity])}))))
