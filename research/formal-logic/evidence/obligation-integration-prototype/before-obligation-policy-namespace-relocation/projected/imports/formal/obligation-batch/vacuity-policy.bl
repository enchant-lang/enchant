(ns formal.obligation-batch.vacuity-policy)

;; One closed ordinary-value/raw-row parser. No graph bytes become new atoms.
(def profile :bl/closed-vacuity-policy-preview-v1)
(def values #{:allow :report :reject})
(defn- require! [ok why]
 (when-not ok (throw (ex-info (str "formal.vacuity-policy: " why) {}))))
(defn check [value]
 (require! (and (keyword? value) (contains? values value)) "allow, report or reject required") value)
(defn from-row
 "A missing field defaults to report; explicit nil and unknown bytes refuse.
  A raw graph node is inspected without materializing or interning its value."
 [row]
 (if (nil? row) :report
  (do
   (require! (and (vector? row) (= 2 (count row)) (or (nil? (meta row)) (= {} (meta row)))) "canonical node row required")
   (cond (= ["keyword" "allow"] row) :allow
         (= ["keyword" "report"] row) :report
         (= ["keyword" "reject"] row) :reject
         :else (throw (ex-info "formal.vacuity-policy: closed keyword policy required" {}))))))
