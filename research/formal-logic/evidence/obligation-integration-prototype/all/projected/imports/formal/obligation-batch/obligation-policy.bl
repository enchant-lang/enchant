(ns formal.obligation-batch.obligation-policy)

(def profile :bl/conditional-obligation-judgment-preview-v1)
(defn judge
 "Compose independently established logical and feasibility facts. A policy
  never repairs a failed proof or conflicting independently checked evidence."
 [vacuity logical background]
 (let [fact (:feasibility background)]
  (cond
   (or (= :conflicting-evidence (:status logical)) (= :conflicting-evidence (:status background)))
    {:status :conflicting-evidence :reason :incompatible-checked-results}
   (not= :checked (:status logical))
    {:status :not-established :reason :no-decisive-independent-check}
   (not= :conditional-entailment (:kind logical)) logical
   (= :witnessed fact) {:status :accepted :reason :checked-nonvacuous-entailment}
   (= :allow vacuity) {:status :accepted :reason (if (= :inconsistent fact) :explicitly-allowed-vacuity :conditional-entailment-allowed)}
   (= :report vacuity) {:status :reported :reason (if (= :inconsistent fact) :vacuous-entailment :feasibility-not-established)}
   (= :inconsistent fact) {:status :rejected :reason :vacuous-obligation}
   :else {:status :incomplete :reason :nonvacuity-not-established})))
