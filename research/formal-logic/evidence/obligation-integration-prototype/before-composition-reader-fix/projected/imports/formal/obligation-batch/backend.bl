(ns formal.obligation-batch.backend (:require [formal.obligation-batch.point-profile :as point-profile] [formal.term :as t] [formal.obligation-batch.evaluate :as ev] [bl.json :as json]
                            [formal.obligation-batch.graph-execution :as graph-execution]))

(def ^:private wire-atoms
 #{:ok :protocol :generation :backend :name :version :capabilities :operations :sorts :limits :pid
   :status :error :why :kind :message :stats :solve-us :nodes :checks :observations :model-status
   :core :core-kind :sat :unsat :unknown :unsupported :available :partial :unavailable :native
   :unspecified :timeout :incomplete :canceled :invalid :max-bv-width :max-fp-bits
   :real-literal-bits :symbolic-rounding :native-cores :max-text-codepoint :max-nodes})

(defn native-data [data]
 (cond
  (keyword? data) (name data)
  (or (vector? data) (list? data)) (to-list (map native-data data))
  (map? data) (reduce (fn [out [k v]] (Map/put out (if (keyword? k) (name k) k) (native-data v)))
                       (maps/from_list (list)) data)
  :else data))
(defn- read-data [data]
 (cond
  (erlang/is_map data) (reduce (fn [out pair] (assoc out (elem pair 0) (read-data (elem pair 1)))) {} (maps/to_list data))
  (erlang/is_list data) (vec (map read-data data))
  :else data))
(defn decode-frame [bytes]
 (when-not (and (erlang/is_binary bytes) (<= 2 (erlang/byte_size bytes) 1048576)
                (= 131 (binary/at bytes 0)) (not= 80 (binary/at bytes 1)))
  (throw (ex-info "formal reply must be bounded, uncompressed ETF" {:kind :invalid-frame :phase :reply})))
 (try
  (let [decoded (erlang/binary_to_term bytes (list :safe :used))]
   (when-not (= (erlang/byte_size bytes) (elem decoded 1))
    (throw (ex-info "formal reply has trailing bytes" {})))
   (read-data (elem decoded 0)))
  (catch error
   (throw (ex-info "formal reply must contain exactly one valid ETF term"
                   {:kind :invalid-frame :phase :reply :detail (ex-message error)})))))
(defn validate-reply [reply backend generation operation]
 (let [ok (:ok reply) status (:status reply)
       check? (contains? #{:check :scope} operation)]
  (when-not (and (map? reply) (or (= true ok) (= false ok)) (= 1 (:protocol reply))
                (= (name backend) (get-in reply [:backend :name]))
                (string? (get-in reply [:backend :version]))
                (= generation (:generation reply))
                (if ok
                 (cond
                  (= operation :hello) (and (map? (:capabilities reply)) (int? (:pid reply)) (pos? (:pid reply)))
                  check? (and (contains? #{:sat :unsat :unknown} status)
                              (contains? #{:available :partial :unavailable} (:model-status reply))
                              (vector? (:observations reply))
                              (every? (fn [row] (and (vector? row) (= 2 (count row))
                                               (string? (first row)) (vector? (second row))
                                               (string? (first (second row))))) (:observations reply))
                              (vector? (:core reply)) (every? string? (:core reply))
                              (contains? #{:native :unsupported} (:core-kind reply))
                              (map? (:stats reply)))
                  :else (contains? #{:load :reset} operation))
                 (and (contains? #{:error :unsupported} status) (string? (:error reply)))))
   (throw (ex-info "formal native reply schema or identity mismatch" {:kind :invalid :phase :reply})))
  reply))
(defn- close! [port]
 ;; OS exit can race the info/close pair, including while handling another
 ;; exception. Closing an already departed worker must not replace that error.
 (try (when (and (erlang/is_port port) (some? (Port/info port))) (Port/close port))
  (catch _ :ok)) :ok)
(defn- exchange! [port borrower-monitor payload timeout]
 (when-not (= (tuple :connected (erlang/self)) (erlang/port_info port :connected))
  (throw (ex-info "formal backend port custody required" {})))
 (let [deadline (+ (erlang/monotonic_time :millisecond) timeout)
       bytes (erlang/term_to_binary payload) monitor (erlang/monitor :port port)]
  (try
   (when (> (erlang/byte_size bytes) 1048576)
    (throw (ex-info "formal request exceeds packet capacity" {:kind :packet-capacity :phase :request})))
   (when-not (Port/command port bytes (list :nosuspend))
    (throw (ex-info "formal backend port busy" {:kind :port-busy :phase :transport})))
   (receive
    [seen [:data bytes]] :when (= seen port)
     (decode-frame bytes)
    [:DOWN seen :process _ _] :when (= seen borrower-monitor)
     (do (close! port) (erlang/exit (erlang/self) :kill))
    [:DOWN seen :port _ reason] :when (= seen monitor)
     (throw (ex-info "formal native worker exited" {:kind :worker-exit :phase :transport :reason reason}))
    [seen [:exit_status status]] :when (= seen port)
     (throw (ex-info "formal native worker exited" {:kind :worker-exit :phase :transport :status status}))
    (after (max 0 (- deadline (erlang/monotonic_time :millisecond)))
     (throw (ex-info "formal backend hard deadline exceeded" {:kind :timeout :phase :transport}))))
   (catch error (close! port) (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))
   (finally (Process/demonitor monitor (list :flush))))))

(defn- owner-context [state]
 {:owner (erlang/self) :generation (:generation state) :revision (:revision state)
  :assertions (:assertions state) :portable (:portable state) :retired (:retired state)})
(defn- refuse [state kind message]
 {:state state :result {:ok false :status :error :error message
                        :why {:kind kind :message message}}})
(defn- exchange-owned [state request]
 (let [result (try
                (let [reply (exchange! (:port state) (:monitor state) request (:hard-ms state))
                      op (elem request 0)
                      generation (if (and (:ok reply) (= op :reset)) (inc (:generation state)) (:generation state))]
                 (validate-reply reply (:backend state) generation op))
               (catch e {:ok false :status :error :error (ex-message e)
                         :why (merge (ex-data e)
                                {:kind (get (ex-data e) :kind :invalid) :message (ex-message e)
                                 :operation (elem request 0)})}))]
  (when-not (:ok result) (close! (:port state)))
  {:result result :state (if (:ok result) (assoc state :generation (:generation result))
                                              (assoc state :retired true))}))
(defn- prepare-owned [state assertions assumptions observations]
 (let [roots (vec (concat (map :term assertions) assumptions (map second observations)))
       exported (t/export (:registry state) roots) ids (:ids (:registry exported))]
  {:registry (:registry exported) :nodes (:nodes exported)
   :assertions (mapv (fn [a] [(str (:label a)) (get ids (:term a))]) assertions)
   :assumptions (mapv (fn [term] (get ids term)) assumptions)
   :observations (mapv (fn [[name term]] [(str name) (get ids term)]) observations)}))
(defn- same-context? [state expected]
 (and (map? expected) (= (erlang/self) (:owner expected))
      (int? (:generation expected)) (= (:generation state) (:generation expected))
      (int? (:revision expected)) (= (:revision state) (:revision expected))))
(defn- z3-small-significand? [data]
 ;; The portable theory allows s=2. The pinned Z3 native API requires s>=3.
 ;; Inspect nested sorts and signature/binder data, including unused binders.
 (cond
  (and (vector? data) (= 3 (count data)) (= :fp (first data)) (= 2 (nth data 2))) true
  (map? data) (some z3-small-significand? (vals data))
  (or (vector? data) (list? data)) (some z3-small-significand? data)
  :else false))
(defn- backend-format-refusal [state]
 {:state state :result {:ok false :status :unsupported
   :protocol 1 :generation (:generation state) :backend (:backend (:hello state))
   :error "Pinned Z3 native API requires FP significand width at least 3; portable s=2 terms remain valid"
   :why {:kind :backend-format :phase :preflight :significand-minimum 3}}})
(defn- managed-exchange [state operation payload]
 (cond
  (and (not= operation :reset) (not (:portable state)))
   (refuse state :context-unavailable "formal native context is not portable after raw transport; reset required")
  (and (= operation :scope) (not (same-context? state (:context payload))))
   (refuse state :context-changed "formal native question context changed before exchange")
  (not (contains? #{:load :scope :reset} operation))
   (refuse state :invalid "unknown formal managed operation")
  :else
   (try
    (let [assertions (vec (:assertions payload))
          ;; Native transport already uses str(label). Retain that same named
          ;; assertion contract so subsequent graph composition sees strings.
          assertions (if (= operation :load)
                       (mapv #(assoc % :label (str (:label %))) assertions) assertions)
          prepared (when-not (= operation :reset)
                     (prepare-owned state assertions (:assumptions payload) (:observations payload)))
          request (cond
                    (= operation :reset) (tuple :reset (:generation state))
                    (= operation :load) (tuple :load (:generation state)
                                         (native-data (:nodes prepared)) (native-data (:assertions prepared)))
                    :else (tuple :scope (:generation state) (native-data (:nodes prepared))
                                 (native-data (:assertions prepared)) (native-data (:assumptions prepared))
                                 (native-data (:observations prepared)) (:solver-ms state)))
          exchanged (if (and (= :z3 (:backend state)) (z3-small-significand? (:nodes prepared)))
                      (backend-format-refusal state)
                      (exchange-owned state request))
          result (:result exchanged) after (:state exchanged)
          committed (if-not (:ok result) after
                      (cond
                       (= operation :reset)
                        (assoc after :registry (t/registry) :assertions [] :portable true :revision (inc (:revision state)))
                       (= operation :load)
                        (assoc after :registry (:registry prepared)
                                     :assertions (vec (concat (:assertions state) assertions)) :revision (inc (:revision state)))
                       :else (assoc after :registry (:registry prepared))))]
     {:state committed :result (if (:ok result) (assoc result :owned-context (owner-context committed)) result)})
    (catch e
     (close! (:port state))
     (refuse (assoc state :retired true) :invalid (ex-message e))))))

(defn- prepare-graph-owned [state forest roots]
 ;; The forest comes directly from this owner turn's SDK admission callback.
 ;; Neither this registry nor a caller-supplied forest is a request argument.
 (let [definitions (into {} (map (fn [row] [(first row) row]) (:nodes forest)))
       wanted (loop [pending (vec roots) seen #{}]
                (if (empty? pending) seen
                 (let [id (peek pending) tail (pop pending)]
                  (when-not (contains? definitions id)
                   (throw (ex-info "formal graph import: missing admitted node" {})))
                  (if (contains? seen id) (recur tail seen)
                   (recur (into tail (nth (get definitions id) 3)) (conj seen id))))))
       registry (atom (:registry state)) translated (atom {}) added (atom [])]
  (doseq [[id op sort children datum] (:nodes forest)]
   (when (contains? wanted id)
    (let [arguments (mapv #(get @translated %) children)
          _ (when-not (every? int? arguments)
              (throw (ex-info "formal graph import: admitted topological order required" {})))
          key (erlang/term_to_binary (native-data [op sort arguments datum])
                                    (list :deterministic (tuple :minor_version 2)))
          known (get (get @registry :graph-ids {}) key)]
     (if (some? known) (swap! translated assoc id known)
      (let [native-id (:next @registry) definition [native-id op sort arguments datum]]
       ;; Legacy t/export preserves these extra fields and advances this same
       ;; next counter. Two import paths never own independent ID allocators.
       (swap! registry (fn [r] (-> r (update :next inc)
                                  (assoc-in [:graph-ids key] native-id)
                                  (assoc-in [:definitions native-id] definition))))
       (swap! translated assoc id native-id) (swap! added conj definition))))))
  {:registry @registry :nodes @added :ids @translated}))

(defn- refuse-graph [state kind message requested]
 (let [header (try (point-profile/reply-header (graph-execution/settings (or requested {})))
                (catch _ {:formal/managed-graph-reply 2 :reply-profile graph-execution/profile}))]
  (update (refuse state kind message) :result merge
   (merge header
    {:solver-status :not-run :verdict :error :phase :admission :binding :not-established
     :native-scope-attempts 0 :identity (:identity state) :trusted false :compiler-proof-authority false
     :certificate {:status :not-checked :kind :managed-graph-refusal}
     :execution {:scope :managed-native-owner :status :not-invoked}}))))

(defn- managed-graph-exchange [state payload]
 (cond
  (:retired state) (refuse-graph state :retired "formal graph context retired" (when (map? payload) (:settings payload)))
  (not (:portable state))
   (refuse-graph state :context-unavailable "formal native context is not portable after raw transport; reset required" (when (map? payload) (:settings payload)))
  (not (and (map? payload) (= #{:question :settings :context} (set (keys payload)))))
   (refuse-graph state :invalid "closed managed graph payload required" (when (map? payload) (:settings payload)))
  (not (same-context? state (:context payload)))
   (refuse-graph state :context-changed "formal native question context changed before graph admission" (when (map? payload) (:settings payload)))
  :else
   (let [owned (atom state)]
    (try
     (let [configuration (graph-execution/settings (:settings payload))
           deadline (+ (erlang/monotonic_time :millisecond) (:owner-ms configuration))
           check! (fn []
                    (when (> (+ (erlang/monotonic_time :millisecond) (:hard-ms @owned)) deadline)
                     (throw (ex-info "formal graph owner deadline cannot admit another native exchange"
                                     {:kind :owner-deadline :phase :native-exchange}))))
           snapshot (select-keys state [:assertions :generation :revision :identity :solver-ms :hard-ms])
           result
           (graph-execution/execute (:question payload) snapshot configuration
            (fn [forest assertions observations]
             (when (:retired @owned)
              (throw (ex-info "formal graph context retired" {:kind :retired})))
             (check!)
             (let [roots (vec (concat (map :term assertions) (map second observations)))
                   prepared (prepare-graph-owned @owned forest roots)
                   assertion-rows (mapv (fn [a] [(:label a) (get (:ids prepared) (:term a))]) assertions)
                   observation-rows (mapv (fn [[label id]] [label (get (:ids prepared) id)]) observations)
                   request (tuple :scope (:generation @owned) (native-data (:nodes prepared))
                                  (native-data assertion-rows) (list) (native-data observation-rows) (:solver-ms @owned))]
              ;; Import preparation may spend time; check the outer budget
              ;; again before sending, retaining the existing worker deadline.
              (check!)
              (let [format-refused? (and (= :z3 (:backend @owned)) (z3-small-significand? (:nodes prepared)))
                    exchanged (if format-refused? (backend-format-refusal @owned) (exchange-owned @owned request))
                    reply (:result exchanged)
                    after (cond-> (:state exchanged) (:ok reply) (assoc :registry (:registry prepared)))]
               ;; reset! in this namespace resets a solver session.
               (swap! owned (fn [_] after))
               (assoc reply :graph-imported (if format-refused? 0 (count (:nodes prepared))))))))
           _ (when (or (= :owner-deadline (get-in result [:why :kind]))
                       (and (= :error (:verdict result)) (pos? (:native-scope-attempts result))))
               (close! (:port @owned)) (swap! owned assoc :retired true))]
      {:state @owned :result (assoc result :owned-context (owner-context @owned)
                                          :execution {:scope :managed-native-owner :status :returned})})
     (catch error
      ;; An invalid original graph/settings request has not acquired a native
      ;; scope. Preserve the actual state, including any already retired port.
      (refuse-graph @owned :invalid (ex-message error) (:settings payload)))))))

(defn- handle-owned [state request]
 (cond
  (= request :hello) {:state state :result (:hello state)}
  (and (vector? request) (= :context-matches (first request)) (= 2 (count request)))
   ;; A completed refusal can retire a worker without changing its question.
   ;; Matching this token grants no ability to execute in a retired context.
   {:state state :result {:ok true :matches (and (:portable state) (same-context? state (second request)))}}
  (and (vector? request) (= :managed-graph (first request)) (= 2 (count request)))
   (managed-graph-exchange state (second request))
  (:retired state) (refuse state :retired "formal context retired")
  (= request :context)
   (if (:portable state) {:state state :result {:ok true :context (owner-context state)}}
     (refuse state :context-unavailable "formal native context is not portable after raw transport; reset required"))
  (= request :context-configuration)
   (if (:portable state)
    {:state state :result {:ok true :configuration
      {:context (owner-context state)
       :adapter (select-keys state [:backend :solver-ms :hard-ms])
       :identity (select-keys (:identity state) [:backend :worker-sha256 :library-sha256 :sdk])}}}
    (refuse state :context-unavailable "formal native context is not portable after raw transport; reset required"))
  (and (vector? request) (= :managed (first request)) (= 3 (count request)))
   (managed-exchange state (second request) (nth request 2))
  (and (vector? request) (= :invoke (first request)) (= 2 (count request)))
   (let [exchanged (exchange-owned state (second request))]
    ;; Raw ETF cannot attest the original portable assumptions or node registry.
    ;; Even a successful scoped import is outside managed registry accounting.
    (if (and (get-in exchanged [:result :ok]) (not= :hello (elem (second request) 0)))
     (update exchanged :state #(assoc % :portable false :revision (inc (:revision state))))
     exchanged))
  :else (refuse state :invalid "unknown formal owner request")))

(defserver native-owner
 (init [config]
  (let [monitor (Process/monitor (:borrower config))]
   (try
    (let [port (erlang/open_port (tuple :spawn_executable (:worker config))
              (list :binary :use_stdio :exit_status (tuple :packet 4)
               (tuple :args (to-list (concat ["--backend" (name (:backend config))]
                    (if (= :z3 (:backend config)) ["--z3-library" (:library config)] []))))))]
     (try
      (let [hello (validate-reply (exchange! port monitor (tuple :hello) (:hard-ms config))
                                  (:backend config) 0 :hello)]
       (when-not (:ok hello)
        (throw (ex-info "formal protocol handshake refused" {:reply hello})))
       (ok {:port port :borrower (:borrower config) :monitor monitor :hello hello
            :backend (:backend config) :generation 0 :revision 0 :registry (t/registry) :assertions [] :portable true
            :identity (:identity config)
            :solver-ms (:solver-ms config) :hard-ms (:hard-ms config) :retired false}))
      (catch error (close! port) (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__))))
    (catch error (Process/demonitor monitor (list :flush))
      (erlang/raise __EXCEPTION_KIND__ error __STACKTRACE__)))))
 (handle-call request [from state]
  (if (not= (:borrower state) (elem from 0))
   (reply {:ok false :status :error :error "formal borrower required"} state)
   (let [handled (handle-owned state request)] (reply (:result handled) (:state handled)))))
 (handle-info [:DOWN ref :process _ _] [state]
  (if (= ref (:monitor state)) (stop :normal state) (noreply state)))
 (handle-info _ [state] (noreply state))
 (terminate [_ state] (close! (:port state))))

(defn- checksum [path] (Base/encode16 (crypto/hash :sha256 (File/read! path)) (list (tuple :case :lower))))
(defn- image-priv []
 (let [directory (code/priv_dir :beam_lisp)]
  (when-not (and (erlang/is_list directory) (File/dir? (erlang/list_to_binary directory)))
   (throw (ex-info "formal backend: a filesystem language image is required for packaged artifacts" {})))
  (erlang/list_to_binary directory)))
(defn- artifact-choice [opts key environment default-path]
 (cond (some? (get opts key)) {:path (get opts key) :origin :option}
       (some? (System/get_env environment)) {:path (System/get_env environment) :origin :environment}
       :else {:path default-path :origin :sdk}))
(defn- artifact-file! [artifact]
 (let [path (:path artifact)]
  (when-not (and (string? path) (File/regular? path))
   (throw (ex-info "formal backend configuration refused" {:artifact artifact})))
  (assoc artifact :path (Path/expand path) :sha256 (checksum path))))
(defn artifacts
 "Resolve and hash the actual runtime files without starting a solver. Options
  override environment pins; otherwise use this language image's packaged
  worker and Z3 library. This runtime descriptor is not a portable question."
 [opts]
 (let [backend (get opts :backend :z3)
       _ (when-not (contains? #{:z3 :oxiz} backend)
           (throw (ex-info "formal backend configuration refused" {:backend backend})))
       ;; Explicit artifact pins also work outside a packaged filesystem image.
       need-worker (and (nil? (:worker opts)) (nil? (System/get_env "ENCHANT_FORMAL_WORKER")))
       need-library (and (= :z3 backend) (nil? (:library opts)) (nil? (System/get_env "ENCHANT_Z3_LIBRARY")))
       priv (when (or need-worker need-library) (image-priv))
       worker (artifact-file! (artifact-choice opts :worker "ENCHANT_FORMAL_WORKER"
                                (when priv (Path/join priv "formal/bin/formal-worker"))))
       library (when (= :z3 backend)
                 (artifact-file! (artifact-choice opts :library "ENCHANT_Z3_LIBRARY"
                                  (when priv (Path/join priv "z3/bin/libz3.so")))))
       manifest-path (when priv (Path/join priv "formal/artifact.json"))
       manifest (when manifest-path
                  (when-not (and (File/regular? manifest-path) (<= (:size (File/stat! manifest-path)) 65536))
                   (throw (ex-info "formal packaged artifact descriptor unavailable" {})))
                  (json/decode (File/read! manifest-path)))]
  (when manifest
   (when-not (and (= 1 (get manifest "version")) (= "formal-worker" (get manifest "kind"))
                  (= 1 (get manifest "protocol")) (= "x86_64-linux" (get manifest "target"))
                  (contains? #{"nix" "portable-shell-v1"} (get manifest "packaging"))
                  (= "bin/formal-worker" (get-in manifest ["worker" "path"]))
                  (= "../z3/bin/libz3.so" (get-in manifest ["z3" "path"]))
                  (or (not= :sdk (:origin worker)) (= (:sha256 worker) (get-in manifest ["worker" "sha256"])))
                  (or (not= :sdk (:origin library)) (= (:sha256 library) (get-in manifest ["z3" "sha256"]))))
    (throw (ex-info "formal packaged artifact identity mismatch" {}))))
  {:backend backend :worker worker :library library :sdk (System/get_env "BL_SDK_PRODUCT")
   :packaged (when manifest
               {:applies-to (vec (concat (when (= :sdk (:origin worker)) [:worker])
                                         (when (= :sdk (:origin library)) [:library])))
                :descriptor-sha256 (checksum manifest-path) :packaging (get manifest "packaging")
                :producer-descriptor-sha256 (get manifest "producer_descriptor_sha256")
                :cargo-lock-sha256 (get manifest "cargo_lock_sha256") :source (get manifest "source")
                :features (get manifest "features") :oxiz-version (get manifest "oxiz_version")})}))

(defn- stop-owner! [pid]
 ;; An unresponsive actor must not outlive its bracket. Graceful stop normally
 ;; closes the port in terminate; kill also closes every port owned by the PID.
 ;; Monitor before stopping so both paths wait for the actual owner's death.
 (let [monitor (Process/monitor pid)]
  (try
   (when (Process/alive? pid)
    (try (GenServer/stop pid :normal 1000)
     (catch _ (Process/exit pid :kill))))
   (receive
    [:DOWN seen :process _ _] :when (= seen monitor) :ok
    (after 1000
     (do (Process/exit pid :kill)
      (receive
       [:DOWN seen :process _ _] :when (= seen monitor) :ok
       (after 1000 (throw (ex-info "formal owner did not retire" {:kind :cleanup-timeout})))))))
   (finally (Process/demonitor monitor (list :flush))))))

(defn with-session [opts f]
 (let [assets (artifacts opts) backend (:backend assets)
       worker (get-in assets [:worker :path]) library (get-in assets [:library :path])
       solver-ms (get opts :solver-ms 500) hard-ms (get opts :hard-ms 2000)]
  (when-not (and (contains? #{:z3 :oxiz} backend) (string? worker) (File/exists? worker)
                (or (= backend :oxiz) (and (string? library) (File/exists? library)))
                (int? solver-ms) (int? hard-ms) (< 0 solver-ms hard-ms) (<= hard-ms 15000) (<= solver-ms 10000))
   (throw (ex-info "formal backend configuration refused" {:backend backend :worker worker :library library})))
  (let [identity {:backend backend :worker-sha256 (get-in assets [:worker :sha256])
                  :library-sha256 (get-in assets [:library :sha256]) :artifacts assets
                  :model-completion (if (= backend :z3) :concrete-extension :backend-native)
                  :sdk (System/get_env "BL_SDK_PRODUCT")}
        state (atom {:generation 0 :revision 0 :assertions [] :portable true :retired false})
        pid (start native-owner {:backend backend :worker (Path/expand worker) :library library
                                 :borrower (erlang/self) :solver-ms solver-ms :hard-ms hard-ms :identity identity})]
   ;; Everything after a successful start, including session setup, is owned
   ;; by the same cleanup bracket as the user callback.
   (try
    (let [hello (call pid :hello (+ 1000 hard-ms))
          session {:pid pid :borrower (erlang/self) :solver-ms solver-ms :hard-ms hard-ms :identity identity
                   :hello hello :state state}]
     (f session))
    (finally
     (try (swap! state #(assoc (if (map? %) % {}) :retired true))
      (finally (stop-owner! pid))))))))

(defn- owner-call [session request]
 (call (:pid session) request (+ 1000 (:hard-ms session))))
(defn invoke
 "Raw native compatibility transport. Successful exchanges other than hello
  invalidate portable context accounting until a managed reset."
 [session request] (owner-call session [:invoke request]))
(defn hello [session] (:hello session))
(defn context
 "Read the authoritative live portable context from its borrower-owned process.
  The owner PID is an execution token, not portable query data or a certificate."
 [session]
 (when-not (and (= (:borrower session) (erlang/self)) (Process/alive? (:pid session)))
  (throw (ex-info "formal backend: a live owned question context is required" {})))
 (let [reply (owner-call session :context)]
  (if (:ok reply) (:context reply) (throw (ex-info (:error reply) (:why reply))))))
(defn context-matches?
 "Check the captured owner's question identity after an exchange, including a
  native refusal that retired the worker. This is not a liveness check."
 [session expected]
 (let [reply (owner-call session [:context-matches expected])]
  (and (:ok reply) (= true (:matches reply)))))
(defn context-configuration
 "Atomically read the actual owner's context and adapter configuration.
  Session mirrors are ignored. The context contains a local owner PID; only
  the separately selected adapter/artifact fields are portable recorded data.
  This read performs no native exchange and grants no proof authority."
 [session]
 (when-not (and (= (:borrower session) (erlang/self)) (Process/alive? (:pid session)))
  (throw (ex-info "formal backend: a live owned question context is required" {})))
 ;; Bounded local metadata read, independent of a caller-corrupted hard-ms
 ;; mirror. The actual native solver and worker deadlines remain unchanged.
 (let [reply (call (:pid session) :context-configuration 16000)]
  (if (:ok reply) (:configuration reply) (throw (ex-info (:error reply) (:why reply))))))
(defn- managed-call [session operation payload]
 (let [reply (owner-call session [:managed operation payload])]
  (when (:ok reply)
   ;; A diagnostic mirror only. No native operation reads this atom.
   (swap! (:state session) (fn [_] (dissoc (:owned-context reply) :owner))))
  (dissoc reply :owned-context)))
(defn reset! [session] (managed-call session :reset {}))
(defn load! [session assertions] (managed-call session :load {:assertions (vec assertions)}))

(defn graph-question!
 "Opt-in original graph execution under a named checking policy in the actual native owner. The
  owner rechecks context/settings, composes its retained assumptions, admits the
  original graph, translates owner-local IDs and replays SAT coordinates under
  one SDK admission scope. This is an explicit managed-graph reply format;
  legacy tree and version-2 graph reply APIs remain separate. Observations keep
  their descriptor graphs and point roots; full value materialization is deferred.
  The whole-operation budget does not increase the solver/worker deadlines."
 ([session original options] (graph-question! session original options (context session)))
 ([session original options expected]
  (when-not (and (= (:borrower session) (erlang/self)) (Process/alive? (:pid session)))
   (throw (ex-info "formal backend: a live owned graph context is required" {})))
  (let [configuration (graph-execution/settings options)]
   (try
    (let [reply (call (:pid session) [:managed-graph {:question original :settings configuration :context expected}]
                      (+ 1000 (:owner-ms configuration)))]
     (when (:owned-context reply)
      (swap! (:state session) (fn [_] (dissoc (:owned-context reply) :owner))))
     (dissoc reply :owned-context))
    (catch error
     ;; A caller that stops waiting cannot leave an owner working on an
     ;; abandoned graph operation, or later accept a reply from that operation.
     (stop-owner! (:pid session))
     (throw (ex-info (str "formal graph owner call failed: " (ex-message error))
                     {:kind :owner-call-failed :native-state :not-established})))))))

(defn decode-native [wire]
 (if-not (and (vector? wire) (seq wire)) (ev/unavailable :malformed-observation)
  (let [kind (first wire)]
   (cond
    (contains? #{"bool" "int" "text"} kind) (second wire)
    (= kind "real") (ev/real (second wire) (nth wire 2))
    (= kind "bv") {:formal/bv [(second wire) (nth wire 2)]}
    (= kind "fp") {:formal/fp [(second wire) (nth wire 2) (nth wire 3)]}
    (= kind "enum") {:formal/enum [(second wire) (nth wire 2)]}
    (= kind "constructor") {:formal/constructor [(second wire) (mapv decode-native (nth wire 2))]}
    (= kind "array") {:formal/array {:default (decode-native (second wire))
                          :updates (mapv (fn [[k v]] [(decode-native k) (decode-native v)]) (nth wire 2))}}
    :else (ev/unavailable {:kind kind :reason (second wire)})))))

(defn scope!
 "An owner-checked native scope. The optional captured context is checked in
  the same owner turn as the exchange. Portable node IDs remain owner-local."
 ([session assertions assumptions observations]
  (scope! session assertions assumptions observations (context session)))
 ([session assertions assumptions observations expected]
  (let [started (erlang/monotonic_time :microsecond)
        reply (managed-call session :scope {:context expected :assertions (vec assertions)
                                            :assumptions (vec assumptions) :observations (vec observations)})]
   (assoc reply :identity (:identity session) :trusted false
                :values (into {} (map (fn [[name v]] [name (decode-native v)]) (:observations reply)))
                :wall-us (- (erlang/monotonic_time :microsecond) started)))))
