@@ -1142,12 +1142,16 @@ article.job,article.decision,article.ask,article.schema,article.procedure,.film,
    rest of the page holds; screens sit in one column on the right */
 .cl-cover{border:0;border-top:1px solid var(--line);border-radius:0;background:none;padding:var(--s2) 0;margin-top:var(--s1)}
 .cl-rows{border-radius:0;background:none}
-.cl-row{grid-template-columns:max-content minmax(0,1fr) minmax(140px,220px);gap:var(--s1) var(--s3);padding:var(--s2) 14px;border-left-width:2px}
-.cl-key{min-width:96px;gap:4px}
 .cl-ph{font-size:10.5px;padding:1px 6px}
 .cl-text{max-width:62ch;font-size:15px;line-height:1.5}
-.cl-screens{max-width:none}
 .cl-screen{font-size:11.5px;padding:4px 9px;min-height:30px;border-radius:6px}
+/* three columns need a column to hold them; below 700px the kit's own
+   stacked grid keeps the phase above the sentence it labels */
+@media (min-width:701px){
+  .cl-row{grid-template-columns:max-content minmax(0,1fr) minmax(140px,220px);gap:var(--s1) var(--s3);padding:var(--s2) 14px;border-left-width:2px}
+  .cl-key{min-width:96px;gap:4px}
+  .cl-screens{max-width:none}
+}
 
