(ns formal.wide-batch.scalar-text-value)

;; One existing mathematical value domain, shared by original admission and
;; point evaluation. This predicate neither reserves work nor returns authority.
(def domain {:encoding :utf8 :text-unit :unicode-codepoint :alphabet [0 196607]})
(defn check-value [data]
 (if (and (string? data) (String/valid? data)
           (every? #(<= % 196607) (unicode/characters_to_list data)))
  {:status :valid}
  {:status :invalid :reason :value-sort-mismatch}))
