(ns formal.wide-batch.graph-replay)

;; Report aggregation over a fresh local SDK point operation. A fabricated
;; callback can fabricate data, never admission, native or proof authority.
(defn validation [operation roots rows]
 (let [bindings ((:check-bindings operation) roots)
       results (mapv (fn [i]
                       (let [value ((:resolve operation) (nth roots i))]
                        {:label (:label (nth rows i)) :value value
                         :status (cond (= true value) :valid (= false value) :invalid :else :incomplete)}))
                     (range (count rows)))
       invalid (vec (filter #(= :invalid (:status %)) results))
       incomplete (vec (filter #(= :incomplete (:status %)) results))]
  {:status (cond (= :invalid (:status bindings)) :invalid (seq invalid) :invalid
                 (or (:resource-refused bindings) (seq incomplete)) :incomplete :else :valid)
   :kind :independent-graph-replay :bindings bindings :results results :invalid invalid :incomplete incomplete
   :checked (- (count results) (count incomplete))}))


(defn observations [inventory operation source-for]
 (mapv
  (fn [{:keys [label-source descriptor-source terms]}]
   {:label-source label-source :descriptor-source descriptor-source
    :materialization :deferred :basis :original-source-cursors-and-point-roots
    :roots (mapv (fn [id]
                   (let [source (get source-for id)]
                    {:source-node source :value ((:resolve operation) source)})) terms)})
  (:observations inventory)))
