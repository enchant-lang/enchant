(ns formal.wide-owner-pure-check
 (:require [formal.wide-batch.logic :as logic] [formal.wide-batch.request :as request] [formal.wide-batch.request-answer :as answer]
           [formal.wide-batch.request-evidence :as evidence] [formal.wide-batch.request-point :as point]
           [formal.wide-batch.point-profile :as policy] [formal.wide-batch.graph-question :as question]
           [formal.wide-batch.resources.typed :as typed] [formal.wide-batch.graph-terms :as forest] [formal.wide-batch.finite-word-certificate :as finite]
           [formal.term :as t] [formal.wide-batch.query :as q] [formal.wide-batch.question-graph :as qg]
           [formal.data-graph :as graph] [formal.wide-batch.backend :as backend]
           [formal.advanced-cases :as advanced] [formal.feature-cases :as features]
           [formal.native-cases :as native] [bl.json :as json] [formal.wide-batch.oracle :as oracle]))
(def entered (atom []))
(def observations (atom []))
(def calls (atom 0))
(def pattern (tuple (elem (erlang/fun_info backend/invoke :module) 1) :exchange! 4))
(defn persist! []
 (when-let [path (System/get_env "FORMAL_WIDE_OWNER_OUTPUT")]
  (File/write! path (json/encode {:schema "bl.wide-owner-pure-prototype.v1"
     :sdk (System/get_env "BL_SDK_PRODUCT") :entered-tests @entered :observations @observations
     :native-exchanges (elem (erlang/trace_info pattern :call_count) 1) :oracle-calls @calls
     :in-sdk false :compiler-proof-authority false} {:pretty 2}))))
(defn enter! [id] (swap! entered conj id) (persist!))
(defn observe! [id result] (swap! observations conj {:case id :result result}) (persist!))
(defn original [term]
 (logic/prepare-request (qg/prepare (q/prove term {:vacuity :reject}))
   {:policy {:profile logic/wide-native-policy}}))
(deftest all-retained-theories-share-the-public-request-interface
 (enter! :vocabulary)
 (let [cases (vec (concat (advanced/cases) (features/all-cases) (native/cases)))
       description (logic/checking-policy {:profile logic/wide-native-policy})
       rows (mapv (fn [c]
                    (let [r (logic/prepare-request (qg/prepare (q/from-case c))
                              {:policy {:profile logic/wide-native-policy}})
                          inventory (policy/with-question (:subject r) (:policy r) (fn [inventory _] inventory))]
                     (is (= 2 (:formal/question-forest inventory)) (str (:id c)))
                     (is (= (request/subject-reference r) (:reference inventory)))
                     {:id (:id c) :subject-reference (request/subject-reference r)
                      :typed-nodes (get-in inventory [:forest :checking :typed-nodes])
                      :operators (vec (sort (distinct (map #(nth % 1) (get-in inventory [:forest :nodes])))))})) cases)]
  (is (= 187 (count rows)))
  (is (= :not-installed (:point-replay description) (:evaluation-profile description)))
  (is (= [] (:replayed-operations description) (:installed-proof-strategies description)))
  (is (= :requires-backend-evidence (:native-support description)))
  (is (= false (:compiler-proof-authority description)))
  (observe! :corpus rows)))
(deftest supplied-coordinates-and-saved-success-flags-do-not-become-witnesses
 (enter! :candidate-only)
 (let [a (t/variable "wide.array" (t/array-sort t/Int t/Int))
       r (original (t/eq (t/select (t/store a (t/int 2) (t/int 9)) (t/int 2)) (t/int 9)))
       supplied (logic/answer-request r {"wide.array" {"invented" "opaque-array"}})
       candidate (logic/propose-evidence r {:answer supplied})
       checked (logic/recheck-evidence r candidate)
       packet (evidence/pack r candidate) reopened (evidence/reopen packet)]
  (is (= :candidate (get-in checked [:answer-check :verdict])))
  (is (= :not-installed (get-in checked [:answer-check :point-replay])))
  (is (= :unreplayed-point-data (get-in checked [:answer-check :interpretation])))
  (is (= :not-established (get-in checked [:logical-conclusion :status])))
  (is (not= :accepted (get-in checked [:conclusion :status])))
  (is (= checked reopened))
  (is (thrown? (evidence/check! r (assoc candidate :conclusion {:status :accepted}))))
  (is (thrown? (answer/check! r (assoc supplied :trusted true))))
  (observe! :unreplayed-candidate checked)))
(deftest narrow-certificate-authority-cannot-be-renamed-into-a-wide-profile
 (enter! :semantic-profile)
 (let [subject (qg/prepare (q/prove (t/bool true) {:vacuity :reject}))
       narrow (request/prepare subject {:policy {:profile policy/numeric-word}})
       wide (request/prepare subject {:policy {:profile policy/wide-native}})
       certificate (finite/candidate narrow)
       checked (evidence/recheck wide (evidence/propose wide {:certificate certificate}))]
  (is (= :rejected (get-in checked [:proof-check :status])))
  (is (= :not-established (get-in checked [:logical-conclusion :status])))
  (is (not= :accepted (get-in checked [:conclusion :status])))
  (is (thrown? (policy/evaluation-profile (:policy wide))))))
(deftest reader-work-refusal-precedes-generic-term-construction
 (enter! :prospective-admission)
 (let [r (original (t/eq (t/real 1 3) (t/real 1 3)))
       limited (request/prepare (:subject r)
                 {:policy {:profile policy/wide-native :limits {:admission-work-units 0}}})
       constructors (tuple (elem (erlang/fun_info forest/prepare :module) 1) :prepare 2)]
  (is (= 1 (erlang/trace_pattern constructors true (list :local :call_count))))
  (try
   (let [prepared (point/replay limited {}) supplied (answer/supply limited {})
         checked (answer/recheck limited supplied)]
    (is (= :incomplete (:verdict prepared) (:verdict checked)))
    (is (= :not-installed (:point-replay prepared) (:point-replay checked)))
    (is (= :admission-work-units (get-in prepared [:admission :reason :metric])))
    (is (= :not-run (get-in prepared [:admission :constructor-execution])))
    (is (= 0 (elem (erlang/trace_info constructors :call_count) 1))))
   (finally (erlang/trace_pattern constructors false (list :local :call_count))))
  (is (thrown? (policy/settings {:profile policy/wide-native :limits {:cached-inventory {}}})))))
(deftest only-selected-operational-descriptors-enter-typing-work
 (enter! :metadata)
 (let [unknown {:formal/data-graph 1 :profile graph/profile :root 0
                :nodes [["keyword" "wide.owner.unfamiliar.provenance.20261114"]]}
       ignored (graph/assemble "vector" [unknown (graph/encode (erlang/bsl 1 300))
                                        (graph/encode {:formal/term 1 :data "ignored incomplete term-shaped metadata"})])
       history (reduce (fn [data _] (graph/assemble "vector" [data data])) ignored (range 14))
       x (t/variable "wide.metadata.input" t/Int)
       subject (qg/patch (qg/prepare (q/prove (t/eq x x) {:observe {"input" x}})) {:origin history})
       before (graph/bytes (:graph subject))
       r (logic/prepare-request subject {:policy {:profile logic/wide-native-policy}})
       inventory (policy/with-question (:subject r) (:policy r) (fn [inventory _] inventory))]
  (is (= 2 (:formal/question-forest inventory)))
  (is (= 0 (get-in inventory [:checking :materialized-keys])))
  (is (= before (graph/bytes (get-in r [:subject :graph]))))
  (is (> (:expanded-nodes (graph/check! (:graph subject))) 100000))
  (is (thrown? (erlang/binary_to_existing_atom "wide.owner.unfamiliar.provenance.20261114" :utf8)))
  (observe! :metadata {:subject-reference (request/subject-reference r)
                      :checking (:checking inventory) :forest-checking (get-in inventory [:forest :checking])})))
(deftest active-literals-and-unused-declarations-keep-their-fixed-shape-bounds
 (enter! :bounded-descriptors)
 (let [huge (t/int (erlang/bsl 1 300))
       deep-sort (reduce (fn [sort _] (t/array-sort sort sort)) t/Int (range 11))
       unused (t/bound "wide.unused" deep-sort)
       requests (mapv original [(t/eq huge huge) (t/forall [unused] (t/bool true))])
       constructors (tuple (elem (erlang/fun_info forest/prepare :module) 1) :prepare 2)]
  (is (= 1 (erlang/trace_pattern constructors true (list :local :call_count))))
  (try
   (doseq [r requests]
    (let [inventory (policy/with-question (:subject r) (:policy r) (fn [inventory _] inventory))]
     (is (= 2 (:formal/question-forest-refusal inventory)))
     (is (= :not-run (get-in inventory [:admission :constructor-execution])))))
   (is (= 0 (elem (erlang/trace_info constructors :call_count) 1)))
   (finally (erlang/trace_pattern constructors false (list :local :call_count))))))
(deftest no-native-or-oracle-execution-was-used
 (enter! :no-native)
 (is (= 0 @calls (elem (erlang/trace_info pattern :call_count) 1)))
 (persist!))
(assert (= 1 (erlang/trace_pattern pattern true (list :local :call_count))))
(try
 (let [deny (fn [& _] (swap! calls inc) (throw :wide-pure-check-must-not-query))]
  (oracle/with-oracle {:query deny :query-graph deny :script deny :request deny :request-evidence deny} #(run-tests)))
 (finally (erlang/trace_pattern pattern false (list :local :call_count))))
