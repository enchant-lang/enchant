+(defn run
+ "Execute supplied function ANF with actual arguments. Preparation errors are
+  distinct from invocation raises; code retirement remains visible."
+ [function arguments]
+ (let [result (with-function function (fn [invoke] (invoke arguments)))]
+  (if (= :completed (:status result))
+   (assoc (:value result) :module (:module result) :module-loaded (:module-loaded result)) result)))
