(ns formal.host-profile (:require [formal.review-host :as host]))
(def started (erlang/monotonic_time :millisecond))
(def doc (host/document (File/read! host/path) nil))
(println {:nodes (count (:nodes doc)) :elapsed-ms (- (erlang/monotonic_time :millisecond) started)})
(def warmed (erlang/monotonic_time :millisecond))
(def again (host/document (File/read! host/path) nil))
(assert (= (:nodes doc) (:nodes again)))
(println {:nodes (count (:nodes again)) :warm-elapsed-ms (- (erlang/monotonic_time :millisecond) warmed)})
