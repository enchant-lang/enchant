(ns formal.host-profile (:require [formal.review-host :as host]))
(let [text (File/read! host/path) started (erlang/monotonic_time :millisecond)
      doc (host/document text nil) warmed (erlang/monotonic_time :millisecond)
      again (host/document text nil) finished (erlang/monotonic_time :millisecond)]
 (assert (= (host/revision text doc) (host/revision text again)))
 (println {:nodes (count (:nodes doc)) :cold-elapsed-ms (- warmed started)
           :warm-elapsed-ms (- finished warmed) :same-data-revision true}))
