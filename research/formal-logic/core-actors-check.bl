(ns formal.core-actors-check
 (:require [formal.api :as formal] [formal.core-actor-examples :as examples]
           [formal.runtime-artifact :as artifact] [interop]))

(def out (System/get_env "ENCHANT_FORMAL_EVIDENCE_ROOT"))
(File/mkdir_p! out)
(def rows
 (mapv (fn [row]
         (let [definition (:definition row) certificates (examples/certificates definition)
               made (formal/core-actor-data definition certificates) packet (:packet made)]
          (when-not (= :ready (:status made))
           (println {:id (:id row) :status (:status made) :reason (:reason made)})
           (throw (ex-info "Core actor export refused" {:id (:id row)})))
          (assert (= :checked-data-connection (:status (formal/check-core-actor-data definition certificates packet))))
          (File/write! (Path/join out (str (:id row) ".json")) (interop/->json packet))
          (assoc row :certificates certificates :packet packet))) (examples/examples)))
(def snapshot {:schema :enchant.formal.core-actor-examples-v1 :rows rows
               :source-commit (trim (elem (System/cmd "git" (list "rev-parse" "HEAD")) 0))})
(def bytes (erlang/term_to_binary snapshot (list :deterministic (tuple :minor_version 2))))
(assert (<= (erlang/byte_size bytes) 8388608))
(File/write! (Path/join out "core-actors.etf") bytes)
(File/write! (Path/join out "summary.json") (interop/->json
 {:schema (:schema snapshot) :source-commit (:source-commit snapshot)
  :archive {:bytes (erlang/byte_size bytes) :sha256 (artifact/digest bytes)}
  :rows (mapv (fn [row] {:id (:id row) :packet (get-in row [:packet :identity])
                        :subject (get-in row [:packet :subject])}) rows)}))
(println {:examples (count rows) :kernel-execution :not-run})
