(ns formal.protocol-run
 (:require [formal.protocol :as protocol] [formal.term :as t]
           [formal.value :as v] [formal.evaluate :as replay]))

;; Concrete execution of the declared model. This does not operate a BEAM actor.
(defn- assignment? [schema values]
 (and (map? values) (= (set (keys schema)) (set (keys values)))
      (every? (fn [[field sort]] (let [value (get values field)]
                     (if (= t/Bool sort) (contains? #{true false} value) (int? value)))) schema)))
(defn- assign [symbols values]
 (into {} (map (fn [[field term]] [(:data term) (get values field)]) symbols)))
(defn- invariant [model values]
 (let [terms (mapv (fn [[_ value]] (t/all [(v/defined value) (v/term value)])) (:invariants model))
       result (replay/value (t/all terms) (assign (:state model) values))]
  (cond (= true result) :holds (= false result) :violated :else :incomplete)))
(defn- step-in [definition prepared state event]
 (let [model (:model prepared) label (:transition event)
       row (first (filter #(= label (:name %)) (:transitions model)))]
  (cond
   (not (and (map? event) (= #{:transition :inputs} (set (keys event))) row))
    {:status :invalid :reason :unknown-or-noncanonical-transition}
   (not (assignment? (:schema definition) state)) {:status :invalid :reason :state-schema-mismatch}
   (not (assignment? (:input-schema row) (:inputs event))) {:status :invalid :reason :input-schema-mismatch}
   :else
    (let [env (merge (assign (:state model) state) (assign (:inputs row) (:inputs event)))
          permitted (replay/value (t/all (:assumptions row)) env)
          guard-defined (replay/value (v/defined (:guard row)) env)
          base {:transition label :inputs (:inputs event) :before state :state state
                :invariant-before (invariant model state)}]
     (cond
      (= false permitted) (merge base {:status :outside-assumptions})
      (not= true permitted) (merge base {:status :incomplete :reason :nonconcrete-input-domain})
      (= false guard-defined) (merge base {:status :failed :phase :guard :state-committed false})
      (not= true guard-defined) (merge base {:status :incomplete :reason :nonconcrete-guard-outcome})
      :else
       (let [enabled (replay/value (v/term (:guard row)) env)]
        (cond
         (= false enabled) (merge base {:status :disabled})
         (not= true enabled) (merge base {:status :incomplete :reason :nonconcrete-guard})
         :else
          (loop [fields (sort-by str (keys (:schema definition))) next-state {}]
           (if (empty? fields)
            (merge base {:status :stepped :state next-state :state-committed true
                         :invariant-after (invariant model next-state)})
            (let [field (first fields) value (get (:next row) field)
                  defined (replay/value (v/defined value) env)]
             (cond
              (= false defined) (merge base {:status :failed :phase :update :field field :state-committed false})
              (not= true defined) (merge base {:status :incomplete :reason :nonconcrete-update-outcome :field field})
              :else
               (let [result (replay/value (v/term value) env)]
                (if (replay/unavailable? result)
                 (merge base {:status :incomplete :reason :nonconcrete-update :field field})
                 (recur (rest fields) (assoc next-state field result)))))))))))))))

(defn step
 "Execute a declared transition with simultaneous state replacement. A false
  guard disables it; an undefined guard/update fails without committing state."
 [definition state event]
 (let [prepared (protocol/prepare definition)]
  (if-not (= :ready (:status prepared)) prepared
   (assoc (step-in definition prepared state event)
     :scope :declared-state-model-step :source-connection :authored-model-not-live-beam-actor))))

(defn replay-trace
 "Replay an explicit finite model trace, including failures and stuttering.
  No solver answer or induction template is needed to check this execution.
  After a failure only an explicit {:stutter true} event is permitted."
 [definition initial events]
 (let [prepared (protocol/prepare definition)]
  (cond
   (not= :ready (:status prepared)) prepared
   (not (and (vector? events) (<= (count events) 64))) {:status :invalid :reason :trace-capacity}
   :else
    (let [initial-check (protocol/initial-witness definition prepared initial)
          model (:model prepared) initial-invariant (when (= :valid (:status initial-check)) (invariant model initial))]
     (if-not (= :valid (:status initial-check))
      {:status (if (= :incomplete (:status initial-check)) :incomplete :invalid)
       :reason :inadmissible-initial-state :initial-witness initial-check}
      (loop [remaining events state initial halted? false
             safety initial-invariant frames [{:kind :initial :state initial :invariant initial-invariant}]]
       (if (empty? remaining)
        {:status :replayed :safety safety :initial initial :state state :frames frames
         :events (count events) :failed halted? :scope :finite-declared-state-model-trace
         :source-connection :authored-model-not-live-beam-actor}
        (let [event (first remaining)]
         (cond
          (= {:stutter true} event)
           (recur (rest remaining) state halted? safety (conj frames {:kind :stutter :state state}))
          halted? {:status :invalid :reason :transition-after-failure :frames frames}
          :else
           (let [out (step-in definition prepared state event)]
            (cond
             (= :failed (:status out))
              (recur (rest remaining) state true :violated (conj frames out))
             (= :stepped (:status out))
              (recur (rest remaining) (:state out) false
                     (cond (or (= :violated safety) (= :violated (:invariant-after out))) :violated
                           (or (= :incomplete safety) (= :incomplete (:invariant-after out))) :incomplete
                           :else :holds)
                     (conj frames out))
             :else {:status (if (= :incomplete (:status out)) :incomplete :invalid)
                    :reason (:status out) :event out :frames frames})))))))))))
