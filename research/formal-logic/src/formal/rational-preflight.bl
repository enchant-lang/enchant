(ns formal.rational-preflight (:require [formal.resources.rational :as sdk]))

;; Keep the original charging policy explicit. New direct plans use the SDK API.
(def profile sdk/profile)
(def defaults sdk/defaults)
(defn limits [overrides] (sdk/limits overrides))
(defn pair? [value] (sdk/pair? value))
(defn plan [op operands overrides] (sdk/plan op operands overrides))
