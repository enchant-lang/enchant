(ns formal.proof (:require [formal.certificate :as certificate]))

;; Untrusted search. A bug or a budget exhaustion cannot create a checked result:
;; every successful object must pass formal.certificate/check from the statement.
(defn- add-scaled [a b scale]
 (into {} (remove (fn [[_ n]] (= n 0))
  (reduce (fn [out [x n]] (assoc out x (+ (get out x 0) (* scale n)))) a b))))
(defn- combine [a b variable]
 (let [pa (get-in a [:coeff variable]) nb (- (get-in b [:coeff variable]))]
  {:coeff (add-scaled (add-scaled {} (:coeff a) nb) (:coeff b) pa)
   :bound (+ (* nb (:bound a)) (* pa (:bound b)))
   :weights (add-scaled (add-scaled {} (:weights a) nb) (:weights b) pa)}))
(defn- contradiction [rows]
 (first (filter (fn [row] (and (empty? (:coeff row)) (< (:bound row) 0))) rows)))
(defn- arithmetic [prepared assignment budget]
 (let [rows (mapv (fn [[id _]] (assoc (certificate/inequality prepared assignment id) :weights {id 1}))
                  (filter (fn [[id _]] (= :linear (:kind (nth (:atoms prepared) id)))) assignment))
       variables (vec (sort (set (mapcat (comp keys :coeff) rows))))]
  (loop [rows rows remaining variables]
   (if-let [bad (contradiction rows)] {:rule :linear :weights (mapv (fn [[id w]] [id w]) (:weights bad))}
    (when (seq remaining)
     (let [x (first remaining)
           pos (filter #(> (get-in % [:coeff x] 0) 0) rows)
           neg (filter #(< (get-in % [:coeff x] 0) 0) rows)
           zero (filter #(= (get-in % [:coeff x] 0) 0) rows)
           cost (* (count pos) (count neg))]
      (when (<= (+ (count zero) cost) budget)
       (recur (vec (concat zero (for [p pos n neg] (combine p n x)))) (rest remaining)))))))))

(defn produce
 "Bounded proof-producing search for a Bool/linear Int conditional theorem.
  Search failure is unknown, never SAT. Unsupported syntax remains explicit."
 ([problem] (produce problem {}))
 ([problem options]
  (try
   (let [prepared (certificate/prepare problem (get options :rules certificate/rules))
         node-limit (get options :nodes 2048) row-limit (get options :rows 512)
         _ (when-not (and (int? node-limit) (<= 1 node-limit 8192)
                           (int? row-limit) (<= 1 row-limit 4096))
             (throw (ex-info "Proof search limits must be bounded positive integers" {})))
         visited (atom 0)]
    (letfn [(search [assignment]
             (when (<= (swap! visited inc) node-limit)
              (if (some #(= false (certificate/truth % assignment)) (:formulas prepared)) {:rule :boolean}
               (or (arithmetic prepared assignment row-limit)
                (when-let [id (first (remove #(contains? assignment %) (range (count (:atoms prepared)))))]
                 (when-let [yes (search (assoc assignment id true))]
                  (when-let [no (search (assoc assignment id false))]
                   {:rule :split :atom id :yes yes :no no})))))))]
     (if-let [proof (search {})]
      (let [object {:formal/certificate 1 :rules (:rules prepared) :statement (:statement prepared) :proof proof}
            checked (certificate/check problem object)]
       (if (= :checked (:status checked))
        {:status :checked :certificate object :checking checked :search {:nodes @visited :limits {:nodes node-limit :rows row-limit}}}
        {:status :error :reason :producer-object-rejected :checking checked}))
      {:status :unknown :reason :no-certificate-in-fragment-and-budget :search {:nodes @visited :limits {:nodes node-limit :rows row-limit}}})))
   (catch error {:status :unsupported :reason (ex-message error)}))))
