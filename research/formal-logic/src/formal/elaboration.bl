(ns formal.elaboration
 (:require [formal.core :as core] [formal.identity :as identity]))

;; A translation validator, separate from the elaboration producer. Its input
;; is the full pair of syntax trees, not a producer's cached successful status.
;; Do not require elaborate, compiler, system.ir, intrinsics, or a solver here.
(def profile :bl/anf-core-validation-v1)
(def limits {:bytes 2097152 :nodes 4096 :depth 128 :arguments 64 :parameters 4096})
(def ^:private fields
 #{:formal/elaboration :profile :input :anf :core :parameters :aliases :record-vars :identity-profile :identity})
(defn- require! [ok reason]
 (when-not ok (throw (ex-info (str "formal.elaboration: " reason) {}))))
(defn- shape! [node operation fields]
 (require! (and (map? node) (= operation (:op node))
                (= (conj fields :op) (set (keys (dissoc node :ann))))) "ANF shape"))
(defn- core! [node operation arity]
 (require! (and (= operation (:op node)) (= arity (count (:args node)))) "Core constructor or arity"))
(defn- constant! [node value]
 (core! node :const 0) (require! (= value (:data node)) "inserted constant"))
(defn- proper-arguments [node]
 (loop [node node out []]
  (require! (<= (count out) (:arguments limits)) "argument capacity")
  (case (:op node)
   :enil (do (shape! node :enil #{}) out)
   :cons (do (shape! node :cons #{:head :tail}) (recur (:tail node) (conj out (:head node))))
   (throw (ex-info "formal.elaboration: computed argument list" {})))))
(defn- key! [node hashed?]
 (let [key (if (and hashed? (= :remote (:op node)))
             (do (shape! node :remote #{:mod :fun :args})
                 (require! (and (= :Elixir.BeamLisp.Ns.Rt (:mod node)) (= :hash_key (:fun node))
                                (= 1 (count (:args node)))) "record key wrapper")
                 (first (:args node))) node)]
  (shape! key :lit #{:val}) (require! (string? (:val key)) "literal string field") (:val key)))

;; Independent, closed MFA rule table. No author annotation, short function
;; name, intrinsic summary, or producer status can add a primitive to this set.
(def ^:private primitives
 {[:erlang :+ 2] :add [:erlang :- 2] :sub [:erlang :- 1] :neg [:erlang :* 2] :mul
  [:erlang :< 2] :lt [:erlang :"=<" 2] :le [:erlang :> 2] :gt [:erlang :>= 2] :ge
  [:erlang :== 2] :eq [:erlang :"=:=" 2] :eq [:erlang :div 2] :quot [:erlang :rem 2] :rem
  [:erlang :not 1] :not
  [:Elixir.BeamLisp.Num :add 2] :add [:Elixir.BeamLisp.Num :sub 2] :sub
  [:Elixir.BeamLisp.Num :mul 2] :mul [:Elixir.BeamLisp.Num :neg 1] :neg
  [:Elixir.BeamLisp.Num :lt 2] :lt [:Elixir.BeamLisp.Num :le 2] :le
  [:Elixir.BeamLisp.Num :gt 2] :gt [:Elixir.BeamLisp.Num :ge 2] :ge
  [:Elixir.BeamLisp.Num :num_eq 2] :eq
  [:Elixir.BeamLisp.Ns.Rt :eqv 2] :eq [:Elixir.BeamLisp.Ns.Rt :not_ 1] :truthy-not
  [:Elixir.BeamLisp.Ns.Core :quot 2] :quot [:Elixir.BeamLisp.Ns.Core :mod 2] :mod
  [:Elixir.BeamLisp.Ns.Core :inc 1] :increment [:Elixir.BeamLisp.Ns.Core :dec 1] :decrement
  [:Elixir.BeamLisp.Num :pos? 1] :positive [:Elixir.BeamLisp.Num :neg? 1] :negative
  [:Elixir.BeamLisp.Num :zero? 1] :zero
  [:Elixir.BeamLisp.Ns.Rt :pos? 1] :positive [:Elixir.BeamLisp.Ns.Rt :neg? 1] :negative
  [:Elixir.BeamLisp.Ns.Rt :zero? 1] :zero})
(def ^:private arith-rules
 {[:add :+] :add [:sub :-] :sub [:mul :*] :mul [:lt :<] :lt [:le :"=<"] :le
  [:gt :>] :gt [:ge :>=] :ge [:num_eq :==] :eq})

(defn- function-body! [node parameters]
 ;; Recognize the exact compiler knot independently of system.ir's recognizer.
 (shape! node :let #{:name :init :body})
 (let [outer (:init node) knot (:body node)]
  (shape! outer :fn #{:clauses}) (shape! knot :apply #{:fn :args})
  (require! (= 1 (count (:clauses outer))) "outer function clause")
  (let [clause (first (:clauses outer)) pats (:pats clause) inner (:body clause)]
   (require! (and (= #{:pats :guard :body} (set (keys clause))) (nil? (:guard clause))
                  (= 1 (count pats)) (= :pvar (:pop (first pats)))
                  (= (:name node) (:name (first pats)))) "outer lexical knot")
   (shape! (:fn knot) :var #{:name})
   (require! (and (= (:name node) (:name (:fn knot))) (= 1 (count (:args knot)))) "knot application")
   (shape! (first (:args knot)) :var #{:name})
   (require! (= (:name node) (:name (first (:args knot)))) "knot argument")
   (shape! inner :fn #{:clauses})
   (require! (= 1 (count (:clauses inner))) "one function clause")
   (let [clause (first (:clauses inner)) pats (:pats clause)]
    (require! (and (= #{:pats :guard :body} (set (keys clause))) (nil? (:guard clause))
                   (= (count pats) (count parameters))
                   (every? #(and (= :pvar (:pop %)) (string? (:name %))) pats)
                   (= (count pats) (count (set (map :name pats))))
                   (not (contains? (set (map :name pats)) (:name node)))) "fixed lexical function parameters")
    {:body (:body clause)
     :aliases (into {} (map (fn [pat parameter] [(:name pat) (first parameter)]) pats parameters))}))))

(defn claim
 "Package an expression ANF/Core pair as ordinary data. Construction grants no
  assurance. Aliases map actual compiler lexical names to semantic input roles."
 ([anf program parameters aliases] (claim anf program parameters aliases :forbid))
 ([anf program parameters aliases record-vars]
  (identity/seal {:formal/elaboration 1 :profile profile :input :expression
                  :anf anf :core program :parameters parameters :aliases aliases :record-vars record-vars})))
(defn function-claim [anf program parameters record-vars]
 (identity/seal {:formal/elaboration 1 :profile profile :input :function
                 :anf anf :core program :parameters parameters :aliases nil :record-vars record-vars}))

(defn check
 "Check a closed syntax-directed ANF/Core relation without elaborating again,
  evaluating a program, invoking a solver, or trusting a producer's rule trace.
  This reviewed checker is not yet proved sound for BL's compiler/runtime."
 [object]
 (try
  (require! (and (map? object) (<= (erlang/external_size object) (:bytes limits))
                 (= fields (set (keys object))) (= 1 (:formal/elaboration object))
                 (= profile (:profile object)) (identity/valid? object)
                 (contains? #{:expression :function} (:input object))
                 (contains? #{:forbid :declared} (:record-vars object))) "identity, profile or capacity")
  (let [parameters (:parameters object)
        _ (require! (and (vector? parameters) (<= (count parameters) (:parameters limits))
                         (every? #(and (vector? %) (= 2 (count %))) parameters)
                         (= (count parameters) (count (set (map first parameters))))) "ordered distinct parameter roles")
        declarations (into {} parameters) program (:core object)
        typing (core/typecheck program declarations)
        _ (require! (= :typed (:status typing)) "typed Core required")
        function (when (= :function (:input object)) (function-body! (:anf object) parameters))
        _ (when function (require! (nil? (:aliases object)) "function aliases are derived, not supplied"))
        aliases (if function (:aliases function) (:aliases object))
        _ (require! (and (map? aliases) (every? string? (keys aliases))
                         (= (count aliases) (count declarations))
                         (= (set (vals aliases)) (set (keys declarations)))) "exact lexical input map")
        visits (atom 0) binders (atom (set (keys declarations))) rules (atom {}) assumptions (atom #{})]
   (letfn [(tick [rule depth]
             (require! (and (<= (swap! visits inc) (:nodes limits)) (<= depth (:depth limits))) "relation capacity")
             (swap! rules update rule (fn [n] (inc (or n 0)))))
           (children [nodes models env depth]
             (require! (= (count nodes) (count models)) "ordered operand count")
             (doseq [i (range (count nodes))] (visit (nth nodes i) (nth models i) env (inc depth))))
           (condition [node model env depth]
             (if (and (= :do (:op model)) (= 2 (count (:args model)))
                      (not= [:bool] (:sort (first (:args model)))))
              (do (constant! (second (:args model)) true)
                  (visit node (first (:args model)) env (inc depth))
                  (tick :truthy-nonbool depth))
              (visit node model env (inc depth))))
           (primitive [rule nodes model env depth]
             (require! rule "unreviewed exact intrinsic identity")
             (cond
              (= :truthy-not rule) (do (core! model :not 1) (condition (first nodes) (first (:args model)) env (inc depth)))
              (contains? #{:increment :decrement :positive :negative :zero} rule)
               (do (require! (= 1 (count nodes)) "unary sugar arity")
                   (core! model (get {:increment :add :decrement :sub :positive :gt :negative :lt :zero :eq} rule) 2)
                   (visit (first nodes) (first (:args model)) env (inc depth))
                   (constant! (second (:args model)) (if (contains? #{:increment :decrement} rule) 1 0)))
              :else (do (core! model rule (count nodes)) (children nodes (:args model) env depth)))
             (tick rule depth))
           (record-call [node model env depth]
             (let [declared? (= :invoke (:op node))
                   _ (if declared?
                       (do (shape! node :invoke #{:callee :arguments})
                           (let [callee (:callee node)]
                            (shape! callee :global #{:ns :name})
                            (require! (and (= :declared (:record-vars object))
                                           (= "formal.core.intrinsics" (:ns callee))
                                           (contains? #{"get" "assoc"} (:name callee))) "undeclared record Var")
                            (swap! assumptions conj :ambient-record-var-must-match-declaration)))
                       (require! (= :Elixir.BeamLisp.Ns.Rt (:mod node)) "record runtime identity"))
                   target (if declared? (keyword (:name (:callee node))) (:fun node))
                   original (if declared? (proper-arguments (:arguments node)) (vec (:args node)))
                   _ (when (= :assoc_variadic target) (require! (= 4 (count original)) "packed update arity"))
                   args (if (= :assoc_variadic target) (into (vec (take 3 original)) (proper-arguments (nth original 3))) original)
                   n (count args)]
              (if (= :get target)
               (do (require! (contains? #{2 3} n) "record get arity")
                   (let [key (key! (second args) false) base (first (:args model))
                         present? (contains? (into {} (second (:sort base))) key)]
                    (require! (core/record-sort? (:sort base)) "record operand")
                    (if present?
                     (do (core! model :field (dec n)) (require! (= key (:data model)) "projection field")
                         (visit (first args) base env (inc depth))
                         (when (= n 3) (visit (nth args 2) (second (:args model)) env (inc depth))))
                     (do (require! (= n 3) "absent field needs default") (core! model :do 2)
                         (visit (first args) base env (inc depth))
                         (visit (nth args 2) (second (:args model)) env (inc depth))))))
               (do (require! (and (contains? #{:assoc :assoc_variadic} target) (>= n 3) (odd? n)) "ordered update arity")
                   (core! model :record-assoc (inc (erlang/div (dec n) 2)))
                   (require! (= (:data model) (mapv #(key! (nth args (inc (* 2 %))) false) (range (erlang/div (dec n) 2)))) "ordered update fields")
                   (children (into [(first args)] (map #(nth args (+ 2 (* 2 %))) (range (erlang/div (dec n) 2)))) (:args model) env depth)))
              (tick :record-call depth)))
           (visit [node model env depth]
             (tick (:op node) depth)
             (case (:op node)
              :lit (do (shape! node :lit #{:val}) (constant! model (:val node)))
              :var (do (shape! node :var #{:name}) (core! model :local 0)
                       (require! (and (contains? env (:name node)) (= (get env (:name node)) (:data model))) "lexical reference mismatch"))
              :let (do (shape! node :let #{:name :init :body}) (core! model :let 2)
                       (require! (string? (:name node)) "lexical alias")
                       (require! (not (contains? @binders (:data model))) "Core binder captures an input or another binder")
                       (swap! binders conj (:data model))
                       (visit (:init node) (first (:args model)) env (inc depth))
                       (visit (:body node) (second (:args model)) (assoc env (:name node) (:data model)) (inc depth)))
              :if (do (shape! node :if #{:test :then :else}) (core! model :if 3)
                      (condition (:test node) (first (:args model)) env depth)
                      (visit (:then node) (second (:args model)) env (inc depth))
                      (visit (:else node) (nth (:args model) 2) env (inc depth)))
              :do (do (shape! node :do #{:stmts}) (core! model :do (count (:stmts node)))
                      (children (:stmts node) (:args model) env depth))
              :map (do (shape! node :map #{:pairs}) (core! model :record (count (:pairs node)))
                       (require! (every? #(= 2 (count %)) (:pairs node)) "record pair arity")
                       (require! (= (mapv #(key! (first %) true) (:pairs node)) (:data model)) "ordered construction fields")
                       (children (mapv second (:pairs node)) (:args model) env depth))
              :arith (do (shape! node :arith #{:fun :bif :args})
                         (require! (= 2 (count (:args node))) "canonical arithmetic arity")
                         (primitive (get arith-rules [(:fun node) (:bif node)]) (:args node) model env depth))
              :remote (do (shape! node :remote #{:mod :fun :args})
                          (require! (and (or (list? (:args node)) (vector? (:args node)))
                                         (<= (count (:args node)) (:arguments limits))) "finite remote operands")
                          (if (and (= :Elixir.BeamLisp.Ns.Rt (:mod node)) (contains? #{:get :assoc :assoc_variadic} (:fun node)))
                           (record-call node model env depth)
                           (primitive (get primitives [(:mod node) (:fun node) (count (:args node))]) (:args node) model env depth)))
              :invoke (record-call node model env depth)
              (throw (ex-info "formal.elaboration: operation outside the checked relation" {}))))]
    (visit (if function (:body function) (:anf object)) program aliases 0)
    {:status :checked :profile profile :object (:identity object)
     :scope :supplied-anf-to-typed-core :rule-counts @rules :visited @visits :assumptions @assumptions
     :syntax-pair-bound true :elaborator-called false :solver-called false :program-evaluated false
     :soundness :reviewed-rule-checker :source-to-anf :not-established
     :selected-specialization :not-established :compiler-proof-authority false}))
  (catch error {:status :rejected :profile profile :reason (ex-message error) :compiler-proof-authority false})))
