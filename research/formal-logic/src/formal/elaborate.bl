(ns formal.elaborate
 (:require [compiler :as compiler] [system.ir :as ir] [formal.core :as core] [formal.term :as t]
           [formal.intrinsics :as intrinsics] [formal.anf-inputs :as anf-inputs]))

;; This consumes the real resolved ANF. It is a reviewed front end into the
;; specified core, not a second evaluator for the surface language.
(defn- refuse [message node]
 (throw (ex-info (str "formal.elaborate: " message) {:operation (:op node) :origin (:ann node)})))
(defn- truthy [expression]
 (if (= t/Bool (:sort expression)) expression
  ;; Every Int is truthy in BL, but evaluating it can still raise.
  (core/block [expression (core/literal true)])))
(defn- intrinsic [name args node]
 (let [a (first args) n (count args)]
  (cond
   (and (= name "neg") (= n 1)) (core/operation :neg args)
   (and (= name "-") (= n 1)) (core/operation :neg args)
   (contains? #{"+" "-" "*" "<" "<=" "=<" ">" ">=" "=" "eqv" "==" "=:=" "quot" "div" "rem" "mod"} name)
    (core/operation (get {"+" :add "-" :sub "*" :mul "<" :lt "<=" :le "=<" :le ">" :gt ">=" :ge
                          "=" :eq "eqv" :eq "==" :eq "=:=" :eq "quot" :quot "div" :quot "rem" :rem "mod" :mod} name) args)
   (and (= name "strict-not") (= n 1))
    (do (when-not (= t/Bool (:sort a)) (refuse "erlang/not requires Bool, not BL truthiness" node))
        (core/operation :not [a]))
   (and (= name "not") (= n 1)) (core/operation :not [(truthy a)])
   (and (contains? #{"pos?" "neg?" "zero?"} name) (= n 1))
    (core/operation (get {"pos?" :gt "neg?" :lt "zero?" :eq} name) [a (core/literal 0)])
   (and (contains? #{"inc" "dec"} name) (= n 1))
    (core/operation (if (= name "inc") :add :sub) [a (core/literal 1)])
   :else (refuse (str "unreviewed intrinsic " name) node))))

(defn- field-key [node allow-hash?]
 (let [node (if (and allow-hash? (= :remote (:op node)) (= :Elixir.BeamLisp.Ns.Rt (:mod node))
                           (= :hash_key (:fun node)) (= 1 (count (:args node)))) (first (:args node)) node)]
  (when-not (and (= :lit (:op node)) (string? (:val node)))
   (refuse "record field keys must be literal strings" node)) (:val node)))

(declare lower-node)
(defn- literal-arguments [node]
 (loop [node node out []]
  (when (> (count out) 64) (refuse "record update argument capacity" node))
  (case (:op node)
   :enil out
   :cons (recur (:tail node) (conj out (:head node)))
   (refuse "record variadic updates require a literal proper argument list" node))))
(defn- record-call [call node bindings context]
 (let [callee (:callee call)
       ;; The compiler leaves variadic assoc as a fetched Var. Preserve that
       ;; declared-core assumption only in our explicit elaboration namespace;
       ;; a foreign or exact qualified member cannot borrow its meaning.
       declared? (and (= :invoke (:mode call)) (= :global (:op callee))
                       (= "formal.core.intrinsics" (:ns callee)) (nil? (:lookup callee))
                       (not (contains? bindings (:name callee)))
                       (contains? #{"get" "assoc"} (:name callee)))
       target (if declared? (keyword (:name callee)) (:fun call))]
 (when (or declared?
           (and (= :remote (:mode call)) (= :Elixir.BeamLisp.Ns.Rt (:mod call))
                (contains? #{:get :assoc :assoc_variadic} target)))
  (let [original (vec (:args call))
        _ (when (and (= :assoc_variadic target) (not= 4 (count original)))
            (refuse "record variadic update runtime arity" node))
        args (if (= :assoc_variadic target)
               (into (vec (take 3 original)) (literal-arguments (nth original 3))) original)
        n (count args)]
   (case (if (= :assoc_variadic target) :assoc target)
    :get (do (when-not (contains? #{2 3} n) (refuse "record get requires one literal field and optional eager default" node))
             (let [record (lower-node (first args) bindings context) key (field-key (second args) false)]
              (when-not (core/record-sort? (:sort record)) (refuse "record get requires a declared record" node))
              (if (= n 2) (core/field record key)
               (let [default (lower-node (nth args 2) bindings context)]
                (if (contains? (into {} (second (:sort record))) key) (core/field record key default)
                 (core/block [record default]))))))
    :assoc (do (when-not (and (>= n 3) (= 1 (erlang/rem n 2))) (refuse "record assoc requires ordered field/value pairs" node))
               (core/record-assoc (lower-node (first args) bindings context)
                (mapv (fn [index]
                        (let [i (inc (* 2 index))]
                         [(field-key (nth args i) false) (lower-node (nth args (inc i)) bindings context)]))
                      (range (erlang/div (dec n) 2))))))))))

(defn- fresh-core-name [context]
 (let [name (str "#anf/local" (swap! (:next context) inc))]
  (if (contains? (:reserved context) name) (fresh-core-name context) name)))

(defn- lower-node [node bindings context]
 (let [op (:op node)]
  (case op
   :lit (core/literal (:val node))
   :var (or (get bindings (:name node)) (refuse "unbound variable" node))
   :binding (refuse "selected bindings require the selected Source adapter" node)
   :global (refuse "global values require actual selected Source resolution" node)
   :let (let [initial (lower-node (:init node) bindings context)
              name (fresh-core-name context)
              local (core/variable name (:sort initial))
              body (lower-node (:body node) (assoc bindings (:name node) local) context)]
          (core/let-in name initial body))
   :if (do (when (nil? (:test node)) (refuse "conditional ANF shape" node))
           (core/choose (truthy (lower-node (:test node) bindings context))
             (lower-node (:then node) bindings context) (lower-node (:else node) bindings context)))
   :do (core/block (mapv #(lower-node % bindings context) (:stmts node)))
   :map (core/record (mapv (fn [pair] [(field-key (first pair) true) (lower-node (second pair) bindings context)]) (:pairs node)))
   :arith (let [meaning (intrinsics/arith-meaning node)]
            (when-not meaning (refuse "unreviewed canonical arithmetic identity" node))
            (intrinsic meaning (mapv #(lower-node % bindings context) (:args node)) node))
   (let [call (ir/call-site node)]
    (when (or (nil? call) (:rest call)) (refuse "computed or unresolved call" node))
    (or (record-call call node bindings context)
     (let [args (mapv #(lower-node % bindings context) (:args call))]
     (cond
      (= :remote (:mode call))
       (let [meaning (intrinsics/remote-meaning (:mod call) (:fun call) (:arity call))]
        (when-not meaning (refuse "unreviewed module/function/arity identity" node))
        (intrinsic meaning args node))
      (and (= :invoke (:mode call)) (= :global (:op (:callee call))))
       (refuse "unresolved global calls require checked resolution and summaries" node)
      :else (refuse "first-class functions require checked summaries" node))))))))

(defn from-anf
 "Interpret supplied ANF with lexical bindings only. Input roles and compiler
  aliases are distinct: every resulting Core binder gets a fresh identity."
 [node bindings]
 (let [visited (atom 0) names (atom #{})]
  (letfn [(reserve [value depth]
            (when-not (and (<= (swap! visited inc) 16384) (<= depth 128)
                           (map? value) (= 1 (:core/node value)) (vector? (:args value)))
             (refuse "bounded Core values required for lexical bindings" node))
            (when (= :local (:op value)) (swap! names conj (:data value)))
            (doseq [argument (:args value)] (reserve argument (inc depth))))]
   (doseq [value (vals bindings)] (reserve value 0))
   (lower-node node bindings {:next (atom 0) :reserved @names}))))

(defn prepare
 "Elaborate one BL expression through compiler ANF into the typed pure core.
  Input declarations are Bool/Int or closed records; no application code is evaluated."
 [source declarations]
 (try
  (let [forms (BeamLisp.Reader/read_string source)
        _ (when-not (= 1 (count forms)) (refuse "one source expression is required" {}))
        bindings (into {} (map (fn [[name sort]] [name (core/variable name sort)]) declarations))
        inputs (anf-inputs/prepare "formal.core.intrinsics" bindings)
        anf (compiler/compile (first forms) (:environment inputs))
        bindings (:bindings inputs)
        raw (from-anf anf bindings) expression (core/canonicalize raw declarations)
        typing (core/typecheck expression declarations)]
   (if (= :typed (:status typing))
    {:status :elaborated :core expression :identity (core/identity expression declarations)
     :typing typing :source source :anf anf :profile (:profile typing)
     :basis :compiler-anf :assurance :reviewed-elaboration :metatheory :not-mechanized}
    {:status :unsupported :reason (:reason typing) :source source :basis :compiler-anf}))
  (catch error {:status :unsupported :reason (ex-message error) :source source :basis :compiler-anf})))

(defn- function-anf! [anf parameters]
  (when-not (and (vector? parameters) (<= (count parameters) 16)
                 (every? #(and (vector? %) (= 2 (count %))) parameters)
                 (= (count parameters) (count (set (map first parameters)))))
   (refuse "ordered distinct function parameter declarations required" {}))
  (let [_ (when-not (ir/self-scaffold? anf) (refuse "one top-level compiler function scaffold required" anf))
        clauses (:clauses (ir/scaffold-inner anf)) clause (first clauses) patterns (:pats clause)
        _ (when-not (and (= 1 (count clauses)) (nil? (:guard clause)) (= (count patterns) (count parameters))
                         (every? #(= :pvar (:pop %)) patterns)
                         (= (count patterns) (count (set (map :name patterns)))))
            (refuse "one unguarded clause with distinct variable parameters required" anf))
        declarations (into {} parameters)
        _ (doseq [[name sort] declarations]
            (t/variable name t/Int) (when-not (core/sort? sort) (refuse "function input sort" anf)))
        bindings (into {} (map-indexed (fn [i pattern]
                            [(:name pattern) (core/variable (first (nth parameters i)) (second (nth parameters i)))]) patterns))
        body (core/canonicalize (from-anf (:body clause) bindings) declarations)
        typing (core/typecheck body declarations)]
   (when-not (= :typed (:status typing)) (refuse (:reason typing) anf))
   {:status :elaborated :core body :identity (core/identity body declarations) :typing typing
    :parameters declarations :parameter-order (mapv first parameters) :anf anf :profile (:profile typing)}))

(defn prepare-function-anf
 "Interpret a supplied function scaffold. This makes no source provenance claim."
 [anf parameters]
 (try (assoc (function-anf! anf parameters) :basis :supplied-anf :assurance :reviewed-function-elaboration)
  (catch error {:status :unsupported :reason (ex-message error) :basis :supplied-anf})))

(defn prepare-function
 "Extract one actual compiler function scaffold into the core. Parameter
  declarations are ordered [role sort] pairs; source names are lexical aliases."
 [source parameters]
 (try
  (let [forms (BeamLisp.Reader/read_string source)
        _ (when-not (= 1 (count forms)) (refuse "one source function required" {}))
        anf (compiler/compile (first forms) (compiler/new-env "formal.core.intrinsics"))]
   (assoc (function-anf! anf parameters) :source source :basis :compiler-anf
          :assurance :reviewed-function-elaboration :metatheory :not-mechanized))
  (catch error {:status :unsupported :reason (ex-message error) :source source :basis :compiler-anf})))
