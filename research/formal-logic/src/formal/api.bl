(ns formal.api
 (:require [formal.term :as t] [formal.value :as v] [formal.data :as data]
           [formal.collections :as collections] [formal.numeric :as numeric]
           [formal.relation :as relation] [formal.query :as query]
           [formal.logic :as logic] [formal.backend :as backend]
           [formal.proof :as proof] [formal.certificate :as certificate]
           [formal.contract :as contracts] [formal.loop :as loops]
           [formal.translation :as translations] [formal.optimize :as optimizer]
           [formal.result :as result] [formal.protocol :as protocols]
           [formal.protocol-run :as protocol-run] [formal.protocol-trace :as protocol-traces]
           [formal.elaborate :as elaborate] [formal.core :as core]
           [formal.source-protocol :as source-protocols] [formal.runtime-protocol :as runtime-protocols]
           [formal.context :as contexts] [formal.selected :as selected] [formal.selected-runtime :as selected-runtime]
           [formal.identity :as identity] [formal.elaboration :as elaboration] [formal.specialization :as specialization]
           [formal.connection :as connection]))

;; One functional BL facade. Declarations, callbacks and questions stay pure
;; ordinary language data until check/compare. Callbacks construct a model;
;; evaluating a builder does not prove an arbitrary callback implementation.
(declare symbolic)
(defn- item-factory [spec] (fn [prefix] (symbolic prefix spec)))
(defn symbolic [prefix spec]
 (cond
  (t/sort? spec) (v/lift (t/variable prefix spec))
  (map? spec)
   (case (:kind spec)
    :nullable (data/nullable prefix (:sort spec))
    :option (data/option (t/variable (str prefix ".present") t/Bool)
                        (symbolic (str prefix ".item") (:item spec)))
    :key (data/finite-key prefix (:universe spec))
    :map (collections/map-symbolic prefix (:keys spec) (item-factory (:item spec)))
    :vector (collections/vector-symbolic prefix (:capacity spec) (item-factory (:item spec)))
    :set (collections/set-symbolic prefix (:universe spec))
    :bag (collections/bag-symbolic prefix (:universe spec))
    :bytes (collections/bytes-symbolic prefix (:capacity spec))
    :sum (data/sum prefix (into {} (map (fn [[tag fields]]
                  [tag (into {} (map (fn [[field item]] [field (item-factory item)]) fields))]) (:arms spec))))
    :relation (relation/symbolic prefix (:universe spec))
    :decimal (numeric/decimal (t/variable (str prefix ".coefficient") t/Int) (:scale spec))
    (throw (ex-info "Unknown formal declaration" {:spec spec})))
  :else (throw (ex-info "A formal declaration needs a sort or a semantic schema" {:spec spec}))))

(defn symbols
 "Declare typed symbols with a caller-owned prefix. Reusing a prefix denotes
  the same inputs; distinct model instances need distinct prefixes."
 [prefix schema]
 (when-not (and (string? prefix) (map? schema))
  (throw (ex-info "Symbol declarations need a prefix and field map" {})))
 (into {} (map (fn [[name spec]] [name (symbolic (str prefix "." (str name)) spec)]) schema)))

(defn- build [value symbols] (if (fn? value) (value symbols) value))
(defn question
 "Construct a portable proof/SAT question. :claim, :assumptions and :observe
  can be pure BL builders over the declared symbols or already-built data."
 [symbols specification]
 (query/make (merge specification
               {:inputs (vec (vals symbols))
                :claim (when (contains? specification :claim) (build (:claim specification) symbols))
                :assumptions (build (get specification :assumptions []) symbols)
                :observe (build (get specification :observe symbols) symbols)})))

(defn check
 "Check a term query, program contract, loop, translation, protocol state model
  source-extracted handler protocol or bounded protocol trace subject.
  Without a backend a proof query uses the portable producer/checker. Every
  path adds the same evidence envelope and retains its original result fields."
 ([subject] (check {} subject))
 ([options subject]
  (let [type (result/kind subject)
        execution (if (:backend options) :native :portable)
        raw (case type
              :query (if (:backend options) (logic/run options subject)
                       (if (= :prove (:mode subject)) (proof/produce subject (get options :search {}))
                        {:status :unsupported :reason :sat-search-needs-an-explicit-backend}))
              :contract (contracts/verify options subject)
              :loop (loops/verify options subject)
              :translation (translations/verify options subject)
              :protocol (protocols/verify options subject)
              :source-protocol (source-protocols/verify options subject)
              :protocol-trace (protocol-traces/verify options subject)
              {:status :unsupported :reason :one-supported-formal-subject-tag-required})]
   (result/attach subject raw execution))))
(defn certify
 "Produce and independently check a certificate for the supported fragment.
  Unlike check, this path needs no native solver. Failure stays unknown or
  unsupported; a checked result remains conditional on its assumption ledger."
 ([question] (proof/produce question))
 ([question options] (proof/produce question options)))
(defn check-certificate [question object] (certificate/check question object))
(defn program-contract [specification] (contracts/define specification))
(defn source-function [source parameters] (elaborate/prepare-function source parameters))
(defn check-elaboration [object] (elaboration/check object))
(defn check-specialization [object] (specialization/check object))
(defn source-context [source parameters] (contexts/define source parameters))
(defn selected-source-context [specification] (selected/define specification))
(defn prepare-source-context
 "Reconstruct a declared source context and return its Core plus complete
  checked translation objects. Source expansion can execute phase code."
 [definition] (contexts/prepare definition))
(defn check-source-context [definition] (contexts/check definition))
(defn verify-contract
 ([definition] (contracts/verify definition))
 ([options definition] (contracts/verify options definition)))
(defn replay-contract-counterexample [definition observation] (contracts/replay-counterexample definition observation))
(defn observe-contract
 ([definition assignment] (selected-runtime/observe definition assignment))
 ([definition assignment options] (selected-runtime/observe definition assignment options)))
(defn check-contract-observation [definition receipt] (selected-runtime/check definition receipt))
(defn observe-contract-counterexample
 ([definition observation] (observe-contract-counterexample definition observation {}))
 ([definition observation options]
  (let [replayed (contracts/replay-counterexample definition observation)]
   (if-not (= :valid (:status replayed))
    {:status :rejected :reason :invalid-contract-counterexample :replay replayed :execution-started false
     :compiler-proof-authority false}
    (assoc (selected-runtime/observe definition (:assignment replayed) options)
     :model-counterexample {:subject (:identity definition) :status :valid :scope (:scope observation)
                            :input-provenance (:input-provenance replayed) :native-identity (:identity observation)
                            :native-certificate (:certificate observation)})))))
(defn loop-contract [specification] (loops/define specification))
(defn verify-loop
 ([definition] (loops/verify definition))
 ([options definition] (loops/verify options definition)))
(defn check-loop-proof [definition object] (loops/check-proof definition object))
(defn translation [specification] (translations/define specification))
(defn verify-translation
 ([definition] (translations/verify definition))
 ([options definition] (translations/verify options definition)))
(defn check-translation-proof [definition object] (translations/check-proof definition object))
(defn replay-translation-counterexample [definition observation] (translations/replay-counterexample definition observation))
(defn optimize-core
 ([program declarations] (optimizer/optimize program declarations))
 ([program declarations options] (optimizer/optimize program declarations options)))
(defn protocol [specification] (protocols/define specification))
(defn source-protocol [specification] (source-protocols/define specification))
(defn check-source-protocol-proof [definition object] (source-protocols/check-proof definition object))
(defn source-protocol-step [definition state event] (source-protocols/step definition state event))
(defn replay-source-protocol-trace [definition initial events] (source-protocols/replay-trace definition initial events))
(defn check-protocol-proof [definition object] (protocols/check-proof definition object))
(defn protocol-step [definition state event] (protocol-run/step definition state event))
(defn replay-protocol-trace [definition initial events] (protocol-run/replay-trace definition initial events))
(defn protocol-trace [definition depth] (protocol-traces/define definition depth))
(defn check-protocol-trace-proof [subject object] (protocol-traces/check-proof subject object))
(defn replay-protocol-counterexample [subject observation] (protocol-traces/replay-counterexample subject observation))
(defn observe-protocol-trace
 ([definition initial events] (runtime-protocols/observe definition initial events))
 ([definition initial events options] (runtime-protocols/observe definition initial events options)))
(defn check-runtime-observation [definition receipt] (runtime-protocols/check definition receipt))
(defn observe-protocol-counterexample
 ([subject native] (observe-protocol-counterexample subject native {}))
 ([subject native options]
  (if-not (protocol-traces/source-profile? (:profile subject))
   {:status :rejected :reason :source-bound-trace-required :execution-started false}
   (let [replayed (protocol-traces/replay-counterexample subject native)]
    (if-not (= :valid (:status replayed))
     {:status :rejected :reason :invalid-source-counterexample :replay replayed :execution-started false}
     (assoc (runtime-protocols/observe (:protocol subject) (:initial replayed) (:events replayed) options)
       :model-counterexample {:subject (:identity subject) :scope (:scope replayed) :status :valid
                              :native-identity (:identity native) :native-certificate (:certificate native)}))))))
(defn compare
 ([subject] (compare subject {}))
 ([subject options]
  (if (= :query (result/kind subject))
   (let [pair (logic/compare subject options)
         a (result/attach subject (:decision pair) :native)
         b (result/attach subject (:candidate pair) :native)]
    (merge pair (result/comparison subject a b)))
   (result/comparison subject (check (assoc options :backend :z3) subject)
                              (check (assoc options :backend :oxiz) subject)))))
(defn- describe-question [question]
 (let [roots (query/roots question) nodes (t/walk roots)]
  {:id (:id question) :mode (:mode question) :scope (:scope question)
   :profile (:profile question) :profiles (:profiles question)
   :assumptions (:assumptions question) :question-sha256 (t/digest roots)
   :terms (count nodes) :operations (frequencies (map :op nodes))
   :variables (mapv (fn [term] {:name (:data term) :sort (:sort term)}) (t/variables roots))}))
(defn describe [subject]
 (let [type (result/kind subject)
       prepared (case type :contract (contracts/prepare subject) :loop (loops/prepare subject)
                           :translation (translations/prepare subject) :protocol (protocols/prepare subject)
                           :source-protocol (source-protocols/prepare subject)
                           :protocol-trace (protocol-traces/prepare subject) nil)]
  (cond
   (= :query type) (assoc (describe-question subject) :subject-kind type :identity (result/subject-id subject)
                   :source-connection :not-applicable-direct-term-query :model-interpretation (connection/direct-terms))
   (= :ready (:status prepared))
    (merge {:subject-kind type :identity (:identity subject) :profile (:profile subject)
            :name (get subject :name (get-in subject [:protocol :name])) :parameters (:parameters subject)
            :source-connection (:source-connection prepared) :binding-context (:binding-context prepared)
            :model-interpretation (:model-interpretation prepared)
            :elaboration (:elaboration prepared) :specialization (:specialization prepared)}
     (if (contains? #{:loop :protocol :source-protocol} type)
      (merge {:obligations (mapv (fn [row] {:id (:id row) :question (describe-question (:problem row))}) (:obligations prepared))}
        (if (= :loop type) {:rank-dimension (:rank-dimension prepared)}
          (let [model (if (= :source-protocol type) (:protocol prepared) subject)]
           {:state-schema (:schema model) :transitions (mapv :name (:transitions model))
            :handlers (when (= :source-protocol type) (mapv #(select-keys % [:name :core]) (:handlers prepared)))})))
      (merge {:question (describe-question (:problem prepared))}
        (when (= :protocol-trace type) {:protocol (:protocol prepared) :depth (:depth subject) :scope (:scope prepared)
                                       :handler-cores (:handler-cores prepared)
                                       :live-actor-connection (:live-actor-connection prepared)}))))
   prepared (assoc prepared :subject-kind type)
   :else {:status :unsupported :reason :one-supported-formal-subject-tag-required})))
(defn construction-capabilities
 ([] (construction-capabilities {}))
 ([options]
  (let [base {:qualification :requires-retained-per-fragment-evidence
              :subjects [:query :contract :loop :translation :protocol :source-protocol :protocol-trace]
              :identity-profile identity/profile
              :core-profiles [core/profile core/record-profile]
              :trace-profiles [protocol-traces/profile protocol-traces/source-profile protocol-traces/context-profile]
              :selected-source-context {:profile selected/profile :closure :selected-source-and-lexical-callees
                                        :runtime-initializers-executed false :compiler-proof-authority false}
              :contract-observations {:profile selected-runtime/profile :scope :initialize-original-selected-unit-and-call-once
                                      :authority :normal-sdk-source-instance-owner :universal-runtime-refinement :not-established}
              :source-context {:profile contexts/profile :closure :no-fetched-vars-in-function-anf
                               :ambient-equivalence :requires-declared-bindings :transitive-runtime-closure :not-established}
              :runtime-observations {:profile runtime-protocols/profile :context-profile runtime-protocols/context-profile :scope :owned-sequential-trap-and-stop
                                     :universal-refinement :not-established :attestation :observer-trusted}
              :certificate :not-checked
              :native-solver-certificate {:status :not-checked}
              :portable-certificate {:status :implemented :rules (vec (sort-by str certificate/supported-rules))
                                     :scope :bool-piecewise-linear-int-and-ground-nonzero-division
                                     :soundness :not-mechanically-proved}
              :compiler-proof-authority false :promotion :disabled}]
   (if (:backend options)
    (backend/with-session options (fn [session]
      (assoc base :identity (:identity session) :native-advertisement (backend/hello session)))) base))))
