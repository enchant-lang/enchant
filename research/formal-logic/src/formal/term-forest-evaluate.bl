(ns formal.term-forest-evaluate
 (:require [formal.term-forest :as forest] [formal.term :as t]
           [formal.data-graph :as graph] [formal.evaluate :as sdk]
           [formal.integer-preflight :as integer]))

(def profile :bl/graph-point-evaluation-preview-v1)
(def bounded-profile :bl/bounded-bool-int-point-preview-v1)
(def resource-defaults {:integer integer/defaults :request-work-units 1048576 :evaluated-nodes 16384})
(def ^:private supported #{:bool :int :var :ite :and :or :not :implies :xor :eq
                          :add :sub :mul :neg :div :mod :lt :le :gt :ge})
(def ^:private integer-ops #{:add :sub :mul :neg :div :mod :lt :le :gt :ge})

(defn resource-limits
 "Normalize the explicit scalar preview policy. Arithmetic work units are the
  integer planner's convention; node visits are a separate request allowance."
 [overrides]
 (when-not (and (map? overrides) (every? #(contains? resource-defaults %) (keys overrides)))
  (throw (ex-info "formal.term-forest-evaluate: unknown resource configuration" {:profile bounded-profile})))
 (let [limits (assoc (merge resource-defaults overrides) :integer
                    (integer/limits (get overrides :integer {})))]
  (when-not (every? #(and (int? %) (>= % 0)) [(:request-work-units limits) (:evaluated-nodes limits)])
   (throw (ex-info "formal.term-forest-evaluate: nonnegative request limits required" {:profile bounded-profile})))
  (graph/encode limits)
  limits))

(defn- with-point*
 "Use one freshly admitted graph point while consuming demanded root values.
  The callback receives source-root lookup and diagnostic snapshot functions;
  both retire on return or failure. Only the original admitted roots can be
  looked up. These functions are local implementation plumbing, not portable
  query terms, accepted prepared views, native handles or proof authority."
 [data roots assignments policy consume]
 (when-not (map? assignments)
  (throw (ex-info "formal.term-forest-evaluate: point assignments must be a map" {:profile profile})))
 ;; Refuse lazy/executable/nonportable model objects before primitive checking.
 (let [assignment-data (graph/encode assignments)
       prepared (if policy (forest/prepare-bool-int data roots) (forest/prepare data roots))
       nodes (into {} (map (fn [[id op sort children datum]]
                            [id {:op (erlang/binary_to_existing_atom op :utf8)
                                 :sort sort :children children :data datum}]) (:nodes prepared)))
       memo (atom {}) active (atom true) owner (erlang/self) root-ids (zipmap roots (:roots prepared))
       accounting (atom {:evaluated-nodes 0 :sdk-calls 0 :integer-primitive-calls 0
                         :charged-work-units 0 :refusals []})
       selected-profile (if policy bounded-profile profile)]
  (letfn [(refuse [id reason]
           (let [row {:node id :reason reason}]
            (swap! accounting update :refusals conj row)
            (sdk/unavailable {:kind :resource-incomplete :profile bounded-profile :node id :reason reason})))
          (call-sdk [term bindings]
           (when policy (swap! accounting update :sdk-calls inc))
           (sdk/value term bindings))
          (primitive [id op sort children datum child-values]
           (let [names (mapv #(str "forest.private.child/" %) (range (count children)))
                 arguments (mapv (fn [i] (t/variable (nth names i) (:sort (get nodes (nth children i)))))
                                 (range (count children)))
                 local {:formal/term 1 :op op :sort sort :args arguments :data datum}
                 bindings (if (= :var op) assignments (zipmap names child-values))
                 integer? (or (contains? integer-ops op)
                              (and (= :eq op) (= t/Int (:sort (get nodes (first children))))))
                 missing (some sdk/unavailable? child-values)
                 scalar (cond (= :int op) datum
                              (and (= :var op) (= t/Int sort)) (get assignments datum)
                              :else nil)]
            (cond
             ;; Existing integer input is measured before SDK value checking.
             (and policy (int? scalar) (> (integer/bits scalar) (get-in policy [:integer :integer-bits])))
              (refuse id {:kind :resource-limit :metric :integer-bits :required (integer/bits scalar)
                          :limit (get-in policy [:integer :integer-bits])})
             (and policy integer? (not missing))
              (let [plan (integer/plan op child-values (:integer policy))
                    work (get-in plan [:forecast :work-units])]
               (if (not= :ready (:status plan)) (refuse id (:reason plan))
                (let [required (+ (:charged-work-units @accounting) work)]
                 (if (> required (:request-work-units policy))
                  (refuse id {:kind :resource-limit :metric :request-work-units :required required
                              :limit (:request-work-units policy)})
                  (do
                   ;; Derive and reserve here, from actual private child values.
                   ;; No caller-supplied plan or counter is read as authority.
                   (swap! accounting assoc :charged-work-units required)
                   (swap! accounting update :integer-primitive-calls inc)
                   (call-sdk local bindings))))))
             :else (call-sdk local bindings))))
          (evaluate-node [id]
           (let [{:keys [op sort children data]} (get nodes id)]
            (cond
             (and policy (not (contains? supported op)))
              (refuse id {:kind :resource-policy-unsupported :operation op})
             (= :ite op)
              (let [condition (visit (first children))]
               (cond (= true condition) (visit (second children))
                     (= false condition) (visit (nth children 2))
                     :else condition))
             (= :and op)
              (loop [pending children unknown nil]
               (if (empty? pending) (or unknown true)
                (let [value (visit (first pending))]
                 (cond (= false value) false
                       (sdk/unavailable? value) (recur (rest pending) value)
                       :else (recur (rest pending) unknown)))))
             (= :or op)
              (loop [pending children unknown nil]
               (if (empty? pending) (or unknown false)
                (let [value (visit (first pending))]
                 (cond (= true value) true
                       (sdk/unavailable? value) (recur (rest pending) value)
                       :else (recur (rest pending) unknown)))))
             :else (primitive id op sort children data (mapv visit children)))))
          (visit [id]
           (if (contains? @memo id) (get @memo id)
            (let [result
                  (if (and policy (>= (:evaluated-nodes @accounting) (:evaluated-nodes policy)))
                   (refuse id {:kind :resource-limit :metric :evaluated-nodes
                               :required (inc (:evaluated-nodes @accounting)) :limit (:evaluated-nodes policy)})
                   (do (when policy (swap! accounting update :evaluated-nodes inc)) (evaluate-node id)))]
             (swap! memo assoc id result)
             result)))]
   (let [live! (fn []
                (when-not (= owner (erlang/self))
                 (throw (ex-info "formal.term-forest-evaluate: point belongs to another process" {:profile selected-profile})))
                (when-not @active (throw (ex-info "formal.term-forest-evaluate: point operation retired" {:profile selected-profile}))))
         base {:profile selected-profile :data-reference (:data-reference prepared) :source-roots roots}
         references (when policy
                     {:assignment-reference (graph/reference assignment-data)
                      :settings-reference (graph/of {:profile bounded-profile :limits policy}) :limits policy})]
    (try
     (consume (merge base references
              {:resources (fn [] (live!) (when policy @accounting))
               :resolve (fn [id]
                          (live!)
                          (when-not (and (int? id) (contains? root-ids id))
                           (throw (ex-info "formal.term-forest-evaluate: unadmitted source root" {:profile profile})))
                          (visit (get root-ids id)))
               :checking (fn [] (live!)
                           (merge {:typed-nodes (get-in prepared [:checking :typed-nodes])
                                   :evaluated-nodes (if policy (:evaluated-nodes @accounting) (count @memo))
                                   :argument-traversal :graph-references}
                                  (when policy {:attempted-nodes (count @memo)})))}))
     (finally (reset! active false) (reset! memo {})))))))

(defn with-point [data roots assignments consume] (with-point* data roots assignments nil consume))
(defn with-bounded-point
 "Consume a fresh Bool/Int graph point in its owning process. Policy refusals
  become unavailable values. Node visits and performed integer work are charged
  privately once per graph node; no prepared plan or counter can be supplied."
 [data roots assignments overrides consume]
 (with-point* data roots assignments (resource-limits overrides) consume))

(defn values
 "Evaluate requested graph terms under bounded portable point data. Revalidate
  the original forest; retain argument references and per-operation memoization.
  ITE/AND/OR keep the selected SDK's demand behavior. Other local primitive
  semantics are delegated to that SDK using privately named child values.
  No supplied prepared view, native result or checked-proof claim is accepted."
 [data roots assignments]
 (with-point data roots assignments
  (fn [point]
   (let [result (mapv (:resolve point) roots)]
    {:profile profile :data-reference (:data-reference point) :source-roots roots
     :values result :checking ((:checking point))
     :semantics :selected-sdk-primitive-rules :compiler-proof-authority false}))))

(defn value [data root assignments] (first (:values (values data [root] assignments))))

(defn bounded-values
 "Evaluate under an explicit scalar resource profile. Completion describes each
  requested root; decisive Booleans may complete despite refused other nodes.
  Original graph, assignments and normalized settings are bound separately."
 [data roots assignments overrides]
 (with-bounded-point data roots assignments overrides
  (fn [point]
   (let [result (mapv (:resolve point) roots)
         states (mapv #(if (sdk/unavailable? %) :incomplete :complete) result)
         bound (select-keys point [:profile :data-reference :source-roots :assignment-reference :settings-reference :limits])]
    (merge bound
     {:evaluation-reference (graph/of bound) :values result :root-statuses states
      :status (if (every? #(= :complete %) states) :complete :incomplete)
      :checking ((:checking point)) :resources ((:resources point))
      :semantics :selected-sdk-primitive-rules :native-calls 0 :assertion-replay :not-run
      :compiler-proof-authority false})))))
