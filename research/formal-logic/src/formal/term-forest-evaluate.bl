(ns formal.term-forest-evaluate (:require [formal.evaluate :as sdk]))

;; Preserve the project preview APIs and result/accounting profiles explicitly.
;; New direct graph clients use the SDK's named v2 profiles themselves.
(def profile sdk/graph-profile)
(def bounded-profile sdk/bounded-graph-profile)
(def numeric-profile sdk/numeric-graph-profile)
(def resource-defaults sdk/graph-resource-defaults)
(def numeric-resource-defaults sdk/numeric-graph-resource-defaults)

(defn resource-limits [overrides] (sdk/graph-resource-limits bounded-profile overrides))
(defn numeric-resource-limits [overrides] (sdk/graph-resource-limits numeric-profile overrides))
(defn with-point [data roots assignments consume]
 (sdk/with-graph-point data roots assignments {:profile profile} consume))
(defn with-bounded-point [data roots assignments overrides consume]
 (sdk/with-graph-point data roots assignments {:profile bounded-profile :limits overrides} consume))
(defn with-numeric-point [data roots assignments overrides consume]
 (sdk/with-graph-point data roots assignments {:profile numeric-profile :limits overrides} consume))
(defn values [data roots assignments]
 (sdk/graph-values data roots assignments {:profile profile}))
(defn value [data root assignments] (first (:values (values data [root] assignments))))
(defn bounded-values [data roots assignments overrides]
 (sdk/graph-values data roots assignments {:profile bounded-profile :limits overrides}))
(defn numeric-values [data roots assignments overrides]
 (sdk/graph-values data roots assignments {:profile numeric-profile :limits overrides}))
