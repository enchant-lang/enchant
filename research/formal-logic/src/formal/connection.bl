(ns formal.connection (:require [formal.identity :as identity]))

;; A versioned implementation-connection record, not a proof certificate.
;; It names the exact prepared model and property questions so that reviewed
;; interpretation cannot be confused with Source extraction or entailment.
(def profile :bl/reviewed-model-to-terms-v1)
(def no-source :authored-core-no-source-claim)
(defn reviewed [model relation questions]
 (when-not (and (map? model) (keyword? (:kind model)) (keyword? relation)
                ;; Every output row consumes at least one canonical-data node.
                ;; Refuse impossible counts early without a separate smaller
                ;; interpretation-question limit.
                (vector? questions) (<= 1 (count questions) (:nodes identity/limits))
                (every? #(and (vector? %) (= 2 (count %)) (string? (first %))
                              (map? (second %)) (= 1 (:formal/query (second %)))) questions)
                (= (count questions) (count (set (map first questions)))))
  (throw (ex-info "formal.connection: exact model and labelled property questions required" {})))
 (identity/seal
  {:formal/model-connection 1 :profile profile :status :reviewed-not-mechanically-proved
   :model model :relation relation
   :questions (mapv (fn [[label question]]
                     {:label label :identity (identity/hash question) :mode (:mode question)
                      :profile (:profile question) :scope (:scope question) :relation (:relation question)}) questions)
   :purpose :implementation-connection-not-proof :source-provenance :not-established-by-this-record
   :runtime-conformance :not-established-by-this-record :compiler-proof-authority false}))
(defn through
 "Extend an already prepared model connection through another reviewed model
  derivation. Copying exact question identities grants no additional assurance."
 [model relation child]
 (when-not (and (map? model) (keyword? (:kind model)) (keyword? relation)
                (= 1 (:formal/model-connection child)) (= profile (:profile child))
                (= :implementation-connection-not-proof (:purpose child)) (= false (:compiler-proof-authority child))
                (= :reviewed-not-mechanically-proved (:status child)) (identity/valid? child))
  (throw (ex-info "formal.connection: prepared child model connection required" {})))
 (identity/seal (assoc (dissoc child :identity :identity-profile) :model model :relation relation :via (:identity child))))
(defn direct-terms [] {:status :not-applicable :reason :direct-term-question})
(defn unavailable [] {:status :not-established :reason :no-successful-model-preparation})
