(ns formal.contract
 (:require [formal.core :as core] [formal.core-symbolic :as symbolic]
           [formal.elaborate :as elaborate] [formal.term :as t] [formal.query :as q]
           [formal.proof :as proof] [formal.logic :as logic] [formal.backend :as backend]
           [formal.core-inputs :as inputs] [formal.evaluate :as replay] [formal.value :as v]
           [formal.context :as context] [formal.identity :as identity]))

;; Builders run once and produce ordinary data. Verification reconstructs the
;; question from that data; no supplied cached query can replace the program.
(def ^:private fields
 #{:formal/contract :name :parameters :body :source :requires :ensures
   :raises :effects :returns :prefix :profile :identity-profile :identity})
(defn- require! [ok message]
 (when-not ok (throw (ex-info (str "formal.contract: " message) {}))))
(defn- identity-of [definition] (identity/of definition))

(defn- build-pre [value inputs] (if (fn? value) (value inputs) value))
(defn- build-post [value inputs output] (if (fn? value) (value inputs output) value))
(defn- bool! [expression]
 (require! (and (t/term? expression) (= t/Bool (t/sort-of expression))) "contracts require Boolean terms") expression)
(defn- check-free! [terms inputs]
 (t/validate! terms)
 (require! (every? (fn [node]
                    (and (contains? #{[:bool] [:int]} (:sort node))
                         (contains? #{:var :bool :int :not :and :or :implies :xor :eq :distinct :ite
                                      :add :sub :neg :mul :div :mod :lt :le :gt :ge} (:op node))))
                   (t/walk terms)) "contract predicates require the declared Bool/Int term vocabulary")
 (let [allowed (set (mapcat symbolic/payload-terms (vals inputs)))]
  (require! (every? #(contains? allowed %) (t/variables terms)) "contract contains an undeclared input identity")))
(defn- prepare-source [source declarations]
 (cond
  (nil? source) nil
  (string? source) (elaborate/prepare source declarations)
  (and (map? source) (or (= 1 (:formal/source-context source)) (= 1 (:formal/selected-context source))))
   (let [checked (context/prepare source)]
    (require! (and (= :ready (:status checked)) (= declarations (into {} (:parameters source)))) "contract source context mismatch")
    (assoc (:prepared checked) :binding-context (dissoc checked :prepared :status)))
  (and (map? source) (= #{:function :parameter-order} (set (keys source)))
       (string? (:function source)) (vector? (:parameter-order source))
       (= (count declarations) (count (:parameter-order source)))
       (= (set (keys declarations)) (set (:parameter-order source))))
   (elaborate/prepare-function (:function source) (mapv (fn [name] [name (get declarations name)]) (:parameter-order source)))
  :else (throw (ex-info "Invalid stored source expression/function descriptor" {}))))

(defn define
 "Build a closed, portable scalar/record program contract. :requires receives input
  terms; :ensures receives input terms and the symbolic returned value.
  Builders construct a model; this does not verify their BL implementations."
 [specification]
 (let [name (:name specification) function-source (:function-source specification) binding-context (:context specification)
       _ (when binding-context
           (require! (not (contains? specification :parameters)) "context parameters belong to the context declaration"))
       _ (when function-source (require! (vector? (:parameters specification)) "source function parameters must be ordered [role sort] pairs"))
       declarations (cond binding-context (into {} (:parameters binding-context))
                          function-source (into {} (:parameters specification)) :else (:parameters specification))
       _ (t/variable name t/Bool)
       _ (require! (= 1 (count (filter some? [(:source specification) function-source (:core specification) binding-context])))
                   "provide exactly one source expression, source function, binding context or core program")
       source (cond binding-context binding-context
                    function-source {:function function-source :parameter-order (mapv first (:parameters specification))}
                    :else (:source specification))
       authored (:core specification)
       elaborated (prepare-source source declarations)
       _ (when source (require! (= :elaborated (:status elaborated)) (str "source is outside the core: " (:reason elaborated))))
       body (core/canonicalize (or authored (:core elaborated)) declarations) prefix (str "contract." name)
       lowered (symbolic/lower body declarations {:prefix prefix})
       _ (require! (= :translated (:status lowered)) (str "core interpretation refused: " (:reason lowered)))
       inputs (:inputs lowered) out (get-in lowered [:outcome :value])
       pre (bool! (build-pre (get specification :requires (t/bool true)) inputs))
       post (bool! (build-post (get specification :ensures (t/bool true)) inputs out))
       _ (check-free! [pre post] inputs)
       raises (set (get specification :raises #{})) effects (set (get specification :effects #{}))
       returns (get specification :returns :must)
       _ (require! (every? keyword? raises) "raises must name error keywords")
       _ (require! (every? #{:raise} effects) "this core has only the raise effect")
       _ (require! (contains? #{:must :may} returns) "returns must be :must or :may")
       definition {:formal/contract 1 :name name :parameters declarations :body body :source source
                   :requires pre :ensures post :raises raises :effects effects :returns returns
                   :prefix prefix :profile (:profile lowered)}]
  (identity/seal definition)))

(defn prepare
 "Reconstruct the property, outcomes and assumption ledger for this exact
  definition. No producer or solver identity changes the proposition."
 [definition]
 (try
  (require! (and (map? definition) (= fields (set (keys definition)))
                 (= 1 (:formal/contract definition)) (contains? #{core/profile core/record-profile} (:profile definition))
                 (identity/valid? definition)) "changed or noncanonical contract identity")
  (t/variable (:name definition) t/Bool)
  (require! (and (= (:prefix definition) (str "contract." (:name definition)))
                 (contains? #{:must :may} (:returns definition))
                 (set? (:raises definition)) (every? keyword? (:raises definition))
                 (set? (:effects definition)) (every? #{:raise} (:effects definition))) "invalid contract policy")
  (let [source (prepare-source (:source definition) (:parameters definition))
        _ (when source
            (require! (and (= :elaborated (:status source))
                           (= (:identity source) (core/identity (:body definition) (:parameters definition))))
                      "stored core does not match the freshly elaborated source"))
        lowered (symbolic/lower (:body definition) (:parameters definition) {:prefix (:prefix definition)})
        _ (require! (= :translated (:status lowered)) (str "core interpretation refused: " (:reason lowered)))
        _ (require! (= (:profile lowered) (:profile definition)) "contract core profile mismatch")
        pre (bool! (:requires definition)) post (bool! (:ensures definition))
        _ (check-free! [pre post] (:inputs lowered))
        out (:outcome lowered) allowed (t/any (keep (fn [reason]
                         (when-let [code (get (:errors lowered) reason)] (t/eq (:error out) (t/int code)))) (:raises definition)))
        must-return (or (= :must (:returns definition)) (not (contains? (:effects definition) :raise)))
        claim (if must-return (t/all [(:ok out) post])
                (t/all [(t/implies (:ok out) post) (t/implies (t/not (:ok out)) allowed)]))
        observed-inputs (into {} (map (fn [[name payload]] [name (symbolic/observation payload)]) (:inputs lowered)))
        problem (q/prove claim {:id (:name definition) :assumptions [(q/assertion "requires" pre)]
                    :profile (:profile definition) :scope {:mode :exact :contract (:identity definition) :core (:core lowered)}
                    :relation :return-value-and-declared-errors
                    :observe (merge (into {} (map (fn [[name value]] [(str "input/" name) value]) observed-inputs))
                               {"returned" (:ok out)
                                "value" (if (core/record-sort? (get-in lowered [:typing :sort])) (symbolic/as-value lowered) (:value out))
                                "error-code" (:error out)})
                    :origin {:contract (:identity definition) :core (:core lowered)
                             :basis :reviewed-core-interpretation :source (:source definition)}})]
   {:status :ready :definition (:identity definition) :core (:core lowered) :problem problem
    :inputs (:inputs lowered) :observed-inputs observed-inputs :outcome out :errors (:errors lowered) :typing (:typing lowered)
    :binding-context (:binding-context source)
    :elaboration (if source (get-in source [:elaboration :check]) {:status :not-applicable :reason :authored-core})
    :source-connection (if (:binding-context source) :reviewed-context-linking-not-mechanically-proved :reviewed-not-mechanically-proved)})
  (catch error {:status :unsupported :reason (ex-message error)})))

(defn- replay-in [definition prepared native]
 (when (= :refuted (:verdict native))
  (let [completed (inputs/complete (:parameters definition) (:inputs prepared) native)
        assignment (:assignment completed) terms (:term-assignments completed)
        term-check (replay/validate (conj (:assertions (:problem prepared)) (:counterexample (:problem prepared))) terms)
        result (core/evaluate (:body definition) (:parameters definition) assignment)
        outcome (:outcome prepared)
        expected-ok (replay/value (:ok outcome) terms)
        returned? (= :returned (:status result)) raised? (= :raised (:status result))
        expected-value (when returned? (v/decode (symbolic/observation (:value outcome)) #(replay/value % terms)))
        expected-value (if (and (map? expected-value) (contains? expected-value :domain)) (:value expected-value) expected-value)
        expected-error (when raised? (replay/value (:error outcome) terms))
        matches? (and (= returned? expected-ok)
                      (if returned? (= (:value result) expected-value)
                       (and raised? (= (get (:errors prepared) (:error result)) expected-error))))
        post (when returned? (replay/value (:ensures definition) terms))
        must-return (or (= :must (:returns definition)) (not (contains? (:effects definition) :raise)))
        violation? (if returned? (= false post)
                     (and raised? (or must-return (not (contains? (:raises definition) (:error result))))))]
   {:status (cond (not= :valid (:status term-check)) :incomplete
                  (not (or returned? raised?)) :incomplete
                  (not matches?) :invalid violation? :valid :else :invalid)
    :assignment assignment :input-provenance (:provenance completed) :term-replay term-check
    :execution result :outcome-matches matches? :postcondition post :violation violation?
    :scope :concrete-core-contract :source-connection (:source-connection prepared) :binding-context (:binding-context prepared)})))

(defn replay-counterexample [definition native]
 (let [prepared (prepare definition)]
  (cond (not= :ready (:status prepared)) (assoc prepared :status :rejected)
        (not (and (= (:profile definition) (:profile native)) (= (get-in prepared [:problem :scope]) (:scope native))))
         {:status :rejected :reason :native-observation-subject-mismatch}
        :else (replay-in definition prepared native))))

(defn verify
 "Check the conditional term contract. An optional backend also searches for
  counterexamples and a replayable assumption-feasibility witness. A solver
  verdict cannot fill in a missing certificate. Compiler authority stays off."
 ([definition] (verify {} definition))
 ([options definition]
  (let [prepared (prepare definition)]
   (if-not (= :ready (:status prepared)) prepared
    (let [problem (:problem prepared) search (get options :search {})
          checked (proof/produce problem search)
          inconsistent (proof/produce
             (q/prove (t/bool false) {:assumptions (:assertions problem) :profile (:profile definition) :scope (:scope problem)}) search)
          observations
          (when (:backend options)
           (backend/with-session options
            (fn [session]
             {:feasibility (logic/solve-in session
                (q/sat {:id (str (:name definition) "/requires") :assumptions (:assertions problem)
                        :observe (:observed-inputs prepared) :profile (:profile definition) :scope (:scope problem)}))
              :property (logic/solve-in session problem)})))
          native (:property observations) feasible (:feasibility observations)
          concrete (replay-in definition prepared native)
          checked? (= :checked (:status checked))
          inconsistent? (= :checked (:status inconsistent))
          status (cond
                   (and inconsistent? (= :sat (:verdict feasible))) :disagreement
                   (and checked? (= :sat (:solver-status native))) :disagreement
                   inconsistent? :vacuous
                   (= :unsat (:verdict feasible)) :vacuous
                   (= :vacuous (:verdict native)) :vacuous
                   (and (= :refuted (:verdict native)) (= :valid (:status concrete))) :refuted
                   (and (= :refuted (:verdict native)) (= :incomplete (:status concrete))) :candidate
                   (= :refuted (:verdict native)) :disagreement
                   checked? :checked
                   (= :proved (:verdict native)) :uncertified
                   :else (:status checked))]
     {:status status :definition (:identity definition) :name (:name definition)
      :scope :conditional-core-term-contract :profile (:profile definition)
      :proof checked :inconsistency-proof inconsistent :backend observations :counterexample concrete
      :assumption-consistency (cond inconsistent? :inconsistent-checked
                                    (= :sat (:verdict feasible)) :replayed-witness
                                    (= :unsat (:verdict feasible)) :inconsistent
                                    (nil? feasible) :not-checked :else :undecided)
      :source-connection (:source-connection prepared) :binding-context (:binding-context prepared)
      :elaboration (:elaboration prepared)
      :termination {:basis :finite-core-syntax :normal-return :separate-contract-obligation :metatheory :not-mechanized}
      :compiler-proof-authority false})))))
