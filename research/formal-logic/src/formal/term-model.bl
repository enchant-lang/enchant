(ns formal.term-model (:require [formal.term :as t]))

(def semantics :bl/partial-mathematical-int-bool-v1)
(defn supported? [roots]
 (every? (fn [node]
           (and (contains? #{t/Int t/Bool} (:sort node))
                (contains? #{:bool :int :var :add :sub :mul :neg :div :mod
                             :eq :le :lt :ge :gt :not :and :or :implies :xor :ite} (:op node))
                (or (contains? #{:bool :int :var} (:op node)) (nil? (:data node))))) (t/walk roots)))
