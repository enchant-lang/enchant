(ns formal.protocol
 (:require [formal.term :as t] [formal.value :as v] [formal.transition :as transition]
           [formal.query :as q] [formal.proof :as proof] [formal.certificate :as certificate]
           [formal.backend :as backend] [formal.logic :as logic] [formal.evaluate :as replay]))

(def profile :bl/pure-state-int-bool-v1)
(def rule :finite-trace-invariant-v1)
(def ^:private fields #{:formal/protocol :name :schema :init :invariants :transitions :profile :identity})
(def ^:private value-fields #{:formal/value :value :defined :within :constraints :scope :domain :errors})
(def ^:private transition-fields #{:name :input-schema :guard :next :assumptions})
(defn- require! [ok message]
 (when-not ok (throw (ex-info (str "formal.protocol: " message) {}))))
(defn- identity-of [definition]
 (Base/encode16 (crypto/hash :sha256 (erlang/term_to_binary (dissoc definition :identity))) (list (tuple :case :lower))))
(defn- name! [name] (t/variable name t/Bool) name)
(defn- schema! [schema limit]
 (require! (and (map? schema) (<= (count schema) limit)) "state/input schema capacity")
 (doseq [[field sort] schema] (name! field) (require! (contains? #{[:int] [:bool]} sort) "state/input sorts must be Bool or Int")) schema)
(defn- terms! [roots allowed]
 (t/validate! roots)
 (let [nodes (t/walk roots)]
  (require! (<= (count nodes) 1024) "value term capacity")
  (require! (every? #(contains? (set allowed) %) (t/variables roots)) "undeclared state or input identity")
  (require! (every? (fn [node]
                    (and (contains? #{[:int] [:bool]} (:sort node))
                         (contains? #{:var :bool :int :not :and :or :implies :xor :eq :distinct :ite
                                      :add :sub :neg :mul :div :mod :lt :le :gt :ge} (:op node)))) nodes)
            "operation outside the Int/Bool state profile")))
(defn- value! [value sort allowed]
 (require! (and (map? value) (= value-fields (set (keys value))) (= 1 (:formal/value value))
                (= sort (t/sort-of (:value value)))) "noncanonical scalar semantic value")
 ;; This first profile has no representation constraints that could silently
 ;; erase a failed attempt. Bounded containers need a richer explicit profile.
 (require! (and (= {:mode :exact} (:scope value)) (= (t/bool true) (:within value))
                (= [] (:constraints value)) (= #{:kind :profile} (set (keys (:domain value))))
                (= :scalar (get-in value [:domain :kind])) (keyword? (get-in value [:domain :profile])))
           "this profile requires exact scalar values without hidden domain constraints")
 (require! (and (map? (:errors value)) (every? keyword? (keys (:errors value)))
                (every? #(= t/Bool (t/sort-of %)) (vals (:errors value)))
                (= t/Bool (t/sort-of (:defined value)))) "definedness and error predicates must be Boolean")
 (terms! (vec (concat [(:value value) (:defined value)] (vals (:errors value)))) allowed) value)
(defn- source-spec [definition]
 {:init (:init definition) :invariants (:invariants definition)
  :identity-encoding :length-prefixed-v1 :scope {:mode :exact :profile profile}
  :transitions (mapv (fn [row] {:name (:name row) :inputs (:input-schema row)
                                :guard (:guard row) :next (:next row) :assumptions (:assumptions row)})
                      (:transitions definition))})

(declare prepare)
(defn define
 "Close pure state/transition builders into exact Bool/Int model data. The
  model has no live actor, scheduler, mailbox, external effect or liveness claim."
 [specification]
 (let [_ (require! (and (map? specification)
                         (every? #{:name :state :init :invariants :invariant :transitions} (keys specification))
                         (not (and (contains? specification :invariants) (contains? specification :invariant))))
                   "unknown protocol policy or ambiguous invariants")
       name (name! (:name specification)) schema (schema! (:state specification) 16)
       _ (require! (and (vector? (:transitions specification)) (<= (count (:transitions specification)) 16))
                   "transitions must be a vector of at most sixteen variants")
       _ (doseq [row (:transitions specification)]
           (require! (every? #{:name :inputs :guard :next :assumptions} (keys row)) "unknown transition policy")
           (name! (:name row)) (schema! (get row :inputs {}) 16))
       invariants (get specification :invariants {"invariant" (get specification :invariant (t/bool true))})
       _ (require! (and (map? invariants) (pos? (count invariants)) (<= (count invariants) 16)) "one to sixteen invariants required")
       _ (doseq [label (keys invariants)] (name! label))
       model (transition/machine name schema (assoc specification :invariants invariants
                   :identity-encoding :length-prefixed-v1 :scope {:mode :exact :profile profile}))
       definition {:formal/protocol 1 :name name :schema schema :init (:init model)
                   :invariants (:invariants model) :profile profile
                   :transitions (mapv #(select-keys % [:name :input-schema :guard :next :assumptions]) (:transitions model))}
       definition (assoc definition :identity (identity-of definition))
       ready (prepare definition)]
  (require! (= :ready (:status ready)) (:reason ready)) definition))

(defn prepare
 "Rebuild all derived transition facts and every induction obligation. The
  closed definition cannot supply a cached :defined field, model or query."
 [definition]
 (try
  (require! (and (map? definition) (= fields (set (keys definition))) (= 1 (:formal/protocol definition))
                 (= profile (:profile definition)) (= (:identity definition) (identity-of definition)))
            "changed or noncanonical protocol definition")
  (name! (:name definition)) (schema! (:schema definition) 16)
  (require! (and (map? (:invariants definition)) (pos? (count (:invariants definition)))
                 (<= (count (:invariants definition)) 16) (vector? (:transitions definition))
                 (<= (count (:transitions definition)) 16)) "invariant/transition shape or capacity")
  (doseq [label (keys (:invariants definition))] (name! label))
  (doseq [row (:transitions definition)]
   (require! (and (= transition-fields (set (keys row))) (vector? (:assumptions row))
                  (map? (:next row)) (= (set (keys (:schema definition))) (set (keys (:next row))))) "noncanonical transition")
   (name! (:name row)) (schema! (:input-schema row) 16))
  (let [model (transition/machine (:name definition) (:schema definition) (source-spec definition))
        state (:state model) allowed (vals state)
        _ (value! (:init definition) t/Bool allowed)
        _ (doseq [[_ invariant] (:invariants definition)] (value! invariant t/Bool allowed))
        _ (doseq [row (:transitions model)]
            (let [identities (concat allowed (vals (:inputs row)))]
             (require! (= (count identities) (count (set identities))) "state and input identities collide")
             (value! (:guard row) t/Bool identities)
             (doseq [[field value] (:next row)] (value! value (get (:schema definition) field) identities))
             (terms! (:assumptions row) identities)))
        derived (transition/induction model)
        obligation (fn [id item]
                     {:id id :problem (q/prove (:property item)
                       {:id id :assumptions (:assumptions item) :observe (:observations item) :vacuity :allow
                        :profile profile :relation :normal-step-and-state-invariant
                        :scope (assoc (:scope item) :protocol (:identity definition) :rule rule)
                        :origin {:protocol (:identity definition) :basis :reviewed-transition-model}})})
        rows (vec (cons (obligation [:initiation] (:base derived))
                    (mapv #(obligation [:preservation (:id %)] %) (:steps derived))))
        initial (:assumptions (:base derived))]
   {:status :ready :definition (:identity definition) :model model :obligations rows
    :consistency (q/prove (t/bool false) {:assumptions initial :profile profile
                     :scope {:mode :exact :protocol (:identity definition) :procedure :initial-consistency}})
    :initial (q/sat {:assumptions initial :observe state :profile profile
                    :scope {:mode :exact :protocol (:identity definition) :procedure :initial-state}})
    :source-connection :authored-model-not-live-beam-actor})
  (catch error {:status :unsupported :reason (ex-message error)})))

(defn- impossible [problem]
 (q/prove (t/bool false) {:assumptions (:assertions problem) :profile profile :scope (:scope problem)}))
(defn check-proof
 "Recheck every induction premise against the exact closed model. This path
  calls neither a solver nor proof search. Composition remains reviewed code."
 [definition object]
 (try
  (let [prepared (prepare definition)]
   (require! (= :ready (:status prepared)) (:reason prepared))
   (require! (and (map? object) (= #{:formal/protocol-proof :definition :rule :obligations} (set (keys object)))
                  (= 1 (:formal/protocol-proof object)) (= rule (:rule object))
                  (= (:identity definition) (:definition object)) (vector? (:obligations object))
                  (= (mapv :id (:obligations prepared)) (mapv :id (:obligations object)))) "protocol proof subject or coverage mismatch")
   (doseq [i (range (count (:obligations prepared)))]
    (let [row (nth (:obligations object) i) problem (:problem (nth (:obligations prepared) i))
          _ (require! (= #{:id :kind :certificate} (set (keys row))) "noncanonical obligation proof")
          target (case (:kind row) :entailment problem :unreachable (impossible problem)
                   (throw (ex-info "Unknown induction proof kind" {})))]
     (require! (= :checked (:status (certificate/check target (:certificate row)))) "induction certificate rejected")))
   {:status :checked-obligations :definition (:identity definition) :obligations (count (:obligations prepared))
    :rule {:kind rule :lemma "BeamLispCore.invariant_on_reachable"
           :failure-lemma "BeamLispCore.no_failed_attempt_on_reachable" :axioms []
           :bl-model-connection :reviewed-not-mechanically-proved}
    :scope :all-finite-prefixes-of-the-declared-state-model
    :source-connection :authored-model-not-live-beam-actor :compiler-proof-authority false})
  (catch error {:status :rejected :reason (ex-message error)})))

(defn initial-witness
 "Validate a concrete initial state by independent term replay. This proves
  existence of an admitted model state, not a live actor initialization."
 [definition prepared state]
 (let [schema (:schema definition)
       valid? (and (map? state) (= (set (keys schema)) (set (keys state)))
                    (every? (fn [[field sort]] (let [value (get state field)]
                                  (if (= t/Bool sort) (contains? #{true false} value) (int? value)))) schema))
       assignments (when valid? (into {} (map (fn [[field term]] [(:data term) (get state field)])
                                              (get-in prepared [:model :state]))))]
  (if-not valid? {:status :invalid :reason :state-schema-mismatch}
   (assoc (replay/validate (get-in prepared [:initial :assertions]) assignments)
     :state state :assignments assignments :scope :declared-initial-state))))

(defn verify
 ([definition] (verify {} definition))
 ([options definition]
  (let [prepared (prepare definition)]
   (if-not (= :ready (:status prepared)) prepared
    (let [search (merge {:nodes 8192 :rows 1024} (:search options))
          inconsistent (proof/produce (:consistency prepared) search)
          rows (mapv (fn [{:keys [id problem]}]
                       (let [absent (proof/produce (impossible problem) search)
                             direct (when-not (= :checked (:status absent)) (proof/produce problem search))]
                        {:id id :kind (cond (= :checked (:status absent)) :unreachable
                                           (= :checked (:status direct)) :entailment :else :undischarged)
                         :proof (if (= :checked (:status absent)) absent direct)})) (:obligations prepared))
          all? (every? #(= :checked (get-in % [:proof :status])) rows)
          object (when all? {:formal/protocol-proof 1 :definition (:identity definition) :rule rule
                             :obligations (mapv (fn [row] {:id (:id row) :kind (:kind row)
                                                         :certificate (get-in row [:proof :certificate])}) rows)})
          checking (when object (check-proof definition object))
          witness (when (contains? options :initial-state) (initial-witness definition prepared (:initial-state options)))
          native (when (:backend options)
                   (backend/with-session options (fn [session]
                    {:feasibility (logic/solve-in session (:initial prepared))
                     :obligations (mapv (fn [row] {:id (:id row) :result (logic/solve-in session (:problem row))})
                                         (:obligations prepared))})))
          feasible (:feasibility native) inconsistent? (= :checked (:status inconsistent))
          contradiction? (or (and inconsistent? (or (= :sat (:verdict feasible)) (= :valid (:status witness))))
                             (and all? (some #(= :sat (get-in % [:result :solver-status])) (:obligations native))))
          status (cond contradiction? :disagreement inconsistent? :vacuous (= :unsat (:verdict feasible)) :vacuous
                       (some #(= :refuted (get-in % [:result :verdict])) (:obligations native)) :obligation-refuted
                       (= :checked-obligations (:status checking)) :checked
                       all? :error
                       (and native (every? #(= :proved (get-in % [:result :verdict])) (:obligations native))) :uncertified
                       :else :unknown)]
     {:status status :definition (:identity definition) :name (:name definition) :profile profile
      :scope :all-finite-prefixes-of-the-declared-state-model :relation :normal-step-and-state-invariant
      :proof object :checking checking :obligations rows :backend native :initial-witness witness
      :inconsistency-proof inconsistent
      :assumption-consistency (cond inconsistent? :inconsistent-checked (= :valid (:status witness)) :replayed-initial-state
                                    (= :sat (:verdict feasible)) :replayed-witness (= :unsat (:verdict feasible)) :backend-inconsistent
                                    :else :not-established)
      :safety-status (if (= :checked status) :conditional-inductive-invariant :not-established)
      :liveness :not-established :handler-termination :term-model-only
      :source-connection :authored-model-not-live-beam-actor :compiler-proof-authority false})))))
