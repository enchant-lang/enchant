(ns formal.integer-preflight (:require [formal.resources.integer :as sdk]))

;; Compatibility names; the implementation and policy now belong to the SDK.
(def profile sdk/profile)
(def defaults sdk/defaults)
(defn limits [overrides] (sdk/limits overrides))
(defn bits [value] (sdk/bits value))
(defn plan [op operands overrides] (sdk/plan op operands overrides))
