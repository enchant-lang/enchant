(ns formal.core-loop-examples
 (:require [formal.api :as formal] [formal.term :as t] [formal.obligation-examples :as obligations]))

(def zero (t/int 0))
(defn- one-rank [_ state] [(get state "i")])
(defn- natural-i [_ state] (t/ge (get state "i") zero))
(defn- natural-n [inputs] (t/ge (get inputs "n") zero))
(defn- example [id specification]
 {:id id :definition (formal/loop-contract (assoc specification :name id))})

(defn examples []
 [{:id "countdown" :definition obligations/countdown}
  (example "lexicographic-reset"
   {:parameters {"n" t/Int "m" t/Int}
    :source "(loop [outer n inner m] (if (> inner 0) (recur outer (- inner 1)) (if (> outer 0) (recur (- outer 1) 3) (+ outer inner))))"
    :requires (fn [in] (t/all [(natural-n in) (t/ge (get in "m") zero)]))
    :invariant (fn [_ state] (t/all [(t/ge (get state "outer") zero) (t/ge (get state "inner") zero)]))
    :rank (fn [_ state] [(get state "outer") (get state "inner")])
    :ensures (fn [_ _ out] (t/eq out zero))})
  (example "unreachable-raise"
   {:parameters {"n" t/Int}
    :source "(loop [i n] (if (< i 0) (quot 1 0) (if (> i 0) (recur (- i 1)) i)))"
    :requires natural-n :invariant natural-i :rank one-rank
    :ensures (fn [_ _ out] (t/eq out zero))})
  (example "boolean-state"
   {:parameters {"n" t/Int}
    :source "(loop [i n done false] (if (> i 0) (recur (- i 1) true) done))"
    :requires natural-n :invariant natural-i :rank one-rank
    :ensures (fn [_ state out] (t/eq out (get state "done")))})
  (example "finite-no-state"
   {:parameters {} :source "(loop [] 7)" :ensures (fn [_ _ out] (t/eq out (t/int 7)))})
  (example "simultaneous-state"
   {:parameters {}
    :source "(loop [a 1 b 2 i 1] (if (> i 0) (recur b a (- i 1)) (+ (* a 10) b)))"
    :invariant (fn [_ state]
                 (let [a (get state "a") b (get state "b") i (get state "i")]
                  (t/any [(t/all [(t/eq i zero) (t/eq a (t/int 2)) (t/eq b (t/int 1))])
                          (t/all [(t/eq i (t/int 1)) (t/eq a (t/int 1)) (t/eq b (t/int 2))])])))
    :rank one-rank :ensures (fn [_ _ out] (t/eq out (t/int 21)))})
  (example "vacuous-growth"
   {:parameters {"n" t/Int} :source "(loop [i n] (recur (+ i 1)))"
    :requires (t/bool false) :invariant natural-i :rank one-rank})])

(defn growing []
 (:definition (example "growth"
  {:parameters {"n" t/Int} :source "(loop [i n] (recur (+ i 1)))"
   :requires natural-n :invariant natural-i :rank one-rank})))
