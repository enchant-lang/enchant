(ns formal.runtime-artifact
 (:require [formal.elaborate :as elaborate] [formal.context :as context] [formal.identity :as identity] [anf :as anf] [lower :as lower]))

;; Compilation is separate from publication and user-handler execution.
;; Receipt checking compiles into bytes only; it never loads supplied code.
(defn- require! [ok message] (when-not ok (throw (ex-info (str "formal.runtime-artifact: " message) {}))))
(defn hex [bytes] (Base/encode16 bytes (list (tuple :case :lower))))
(defn digest [bytes] (hex (crypto/hash :sha256 bytes)))
(defn identity-of [data] (identity/of data))
(def critical-modules
 [:Elixir.BeamLisp.Compiler :Elixir.BeamLisp.Ns.Lower :Elixir.BeamLisp.Ns.Body.Lower
  :Elixir.BeamLisp.Ns.Anf :Elixir.BeamLisp.Ns.Body.Anf :Elixir.BeamLisp.Num
  :Elixir.BeamLisp.Ns.Rt :Elixir.BeamLisp.Ns.Body.Rt :Elixir.BeamLisp.Ns.Core :Elixir.BeamLisp.Ns.Body.Core
  :Elixir.BeamLisp.Env :Elixir.BeamLisp.Refs])
(def compilation-modules
 #{"Elixir.BeamLisp.Compiler" "Elixir.BeamLisp.Ns.Lower" "Elixir.BeamLisp.Ns.Body.Lower"
   "Elixir.BeamLisp.Ns.Anf" "Elixir.BeamLisp.Ns.Body.Anf"})
(defn sdk-identity []
 (let [sdk (System/get_env "BL_SDK_PRODUCT")]
  (require! (and (string? sdk) (String/starts_with? sdk "/nix/store/")) "an immutable SDK product is required")
  {:sdk sdk :descriptor-sha256 (digest (File/read! (str sdk "/artifact.json")))
   :runtime-floor (try {:status :adopted :sha256 (digest (erlang/term_to_binary (BeamLisp.Env/runtime_floor_key!) (list :deterministic)))}
                   (catch error
                    (if (String/contains? (ex-message error) "runtime_floor_required") {:status :not-adopted}
                     (throw error))))
   ;; This launch may have no adopted floor. Record actual critical code and
   ;; its image relation without installing a floor or claiming a full graph.
   :critical-code (mapv (fn [module]
                         (require! (= (tuple :module module) (code/ensure_loaded module)) "critical SDK module is unavailable")
                         (let [path (str sdk "/image/ebin/" module ".beam")
                               loaded (hex (erlang/apply module :module_info (list :md5)))
                               image (hex (elem (elem (beam_lib/md5 (File/read! path)) 1) 1))]
                          {:module (str module) :loaded-md5 loaded :image-md5 image :matches-selected-image (= loaded image)}))
                       critical-modules)
   :otp (erlang/list_to_binary (erlang/system_info :otp_release)) :elixir (System/version)}))
(defn check-sdk [recorded]
 (let [current (sdk-identity) md5? #(and (string? %) (Regex/match? (Regex/compile! "^[0-9a-f]{32}$") %))
       floor (:runtime-floor recorded)]
  (require! (and (map? recorded) (= (set (keys recorded)) (set (keys current)))
                 (= (select-keys recorded [:sdk :descriptor-sha256 :otp :elixir])
                    (select-keys current [:sdk :descriptor-sha256 :otp :elixir]))) "recorded compiler SDK differs from this checker")
  (require! (or (= {:status :not-adopted} floor)
                 (and (map? floor) (= #{:status :sha256} (set (keys floor))) (= :adopted (:status floor))
                      (string? (:sha256 floor)) (Regex/match? (Regex/compile! "^[0-9a-f]{64}$") (:sha256 floor))))
            "invalid recorded floor identity")
  (require! (and (vector? (:critical-code recorded))
                 (= (mapv :module (:critical-code current)) (mapv :module (:critical-code recorded)))) "critical code coverage mismatch")
  (doseq [at (range (count (:critical-code current)))]
   (let [old (nth (:critical-code recorded) at) live (nth (:critical-code current) at)]
    (require! (and (map? old) (= #{:module :loaded-md5 :image-md5 :matches-selected-image} (set (keys old)))
                   (md5? (:loaded-md5 old)) (= (:image-md5 old) (:image-md5 live))
                   (= (:matches-selected-image old) (= (:loaded-md5 old) (:image-md5 old)))) "invalid recorded runtime code snapshot")
    (when (contains? compilation-modules (:module old))
     (require! (= (:loaded-md5 old) (:loaded-md5 live)) "recorded compilation code differs from this checker"))))
  ;; Historical observation data can be checked after a runtime projection has
  ;; changed. This is not a claim that old execution occurred or will repeat.
  {:compiler-code-match-current true
   :runtime-code-match-current (= (:critical-code recorded) (:critical-code current))
   :runtime-floor-match-current (= floor (:runtime-floor current))
   :runtime-provenance :recorded-observer-snapshot}))
(defn module-name [run index] (str "Elixir.Formal.Observed.M" run ".H" index))
(defn compile-handler [handler module-name]
 (require! (and (string? module-name) (<= (count module-name) 80)
                 (Regex/match? (Regex/compile! "^Elixir\\.Formal\\.Observed\\.M[0-9]{1,24}\\.H([0-9]|1[0-5])$") module-name))
           "invalid owned observation module name")
 (let [parameters (mapv (fn [role] [role (get (:parameters handler) role)]) ["state" "message"])
       checked (when (:context handler) (context/prepare (:context handler)))
       _ (when (:context handler)
           (require! (and (= :ready (:status checked)) (= parameters (get-in handler [:context :parameters]))
                          (= (:source handler) (get-in handler [:context :source]))) "artifact binding context mismatch"))
       extracted (if (:context handler) (:prepared checked) (elaborate/prepare-function (:source handler) parameters))
       _ (require! (and (= :elaborated (:status extracted)) (= (:core handler) (:identity extracted))) "source/core identity changed")
       module (erlang/binary_to_atom module-name)
       descriptor (anf/module module
          (list {:op :defn-clause :fname :run :params (list) :guard nil :body (:anf extracted) :ann {}})
          (list [:run 0]) (list))
       pair (lower/descriptor->beam descriptor) bytes (elem pair 1)]
  (require! (= module (elem pair 0)) "compiled module mismatch")
  {:pair pair :manifest (cond-> {:name (:name handler) :source (:source handler) :core (:core handler)
                        :module module-name :arity 2 :beam-sha256 (digest bytes)
                        :code-md5 (hex (elem (elem (beam_lib/md5 bytes) 1) 1))}
                        (:context handler) (assoc :context (get-in handler [:context :identity])))}))
(defn publish! [compiled]
 (let [pair (:pair compiled) module (elem pair 0)
       lease (BeamLisp.Env/retain_exact_binary! pair (str (get-in compiled [:manifest :module]) ".beam"))]
  {:compiled compiled :module module :lease lease}))
(defn callable! [resource]
 (let [module (:module resource) manifest (get-in resource [:compiled :manifest])]
  (BeamLisp.Env/with_code_lease (list module)
   (fn []
    (let [function (erlang/apply module :run (list))]
     (require! (and (erlang/is_function function 2) (= module (elem (erlang/fun_info function :module) 1))
                    (= (:code-md5 manifest) (hex (erlang/apply module :module_info (list :md5)))))
               "actual callable differs from emitted artifact") function)))))
(defn close! [resources]
 (doseq [resource resources] (BeamLisp.Env/release_code! (:lease resource)))
 (mapv (fn [resource]
         {:module (get-in resource [:compiled :manifest :module])
          :retired (BeamLisp.Env/retire_module! (:module resource))
          :loaded (erlang/module_loaded (:module resource))}) resources))
