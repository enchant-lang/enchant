(ns formal.witness-examples (:require [formal.term :as t] [formal.query :as q]))
(def x (t/variable "witness.x" t/Int))
(def y (t/variable "witness.y" t/Int))
(def p (t/variable "witness.p" t/Bool))
(def r (t/variable "witness.r" t/Bool))
(def dead (t/eq (t/div x (t/int 0)) (t/int 0)))
(def strange (t/variable "λ.\"\nend; theorem forged : False := by sorry\n" t/Int))
(def big (erlang/bsl 1 200))
(def many (mapv #(t/variable (str "many/" %) t/Bool) (range 20)))
(defn example [id assertions bindings]
 {:id id :question (q/sat {:id id :assumptions assertions}) :bindings bindings})
(def rows
 [(example "empty" [] {})
  (example "constant" [(t/bool true)] [])
  (example "integer" [(t/eq x (t/int 7))] [[x 7]])
  (example "boolean" [(t/not p)] [[p false]])
  (example "nonlinear" [(t/eq (t/mul x y) (t/int 42))] [[x 6] [y 7]])
  (example "variable-division" [(t/eq (t/div x y) (t/int 3)) (t/eq (t/mod x y) (t/int 2))] [[x -7] [y -3]])
  (example "positive-divisor" [(t/eq (t/div x y) (t/int -3)) (t/eq (t/mod x y) (t/int 2))] [[x -7] [y 3]])
  (example "selected-dead-arm" [(t/eq (t/ite p (t/div x (t/int 0)) x) x)] [[x 5] [p false]])
  (example "undefined-and-false" [(t/not (t/all [dead (t/bool false)]))] [[x 3]])
  (example "undefined-or-true" [(t/any [dead (t/bool true)])] [[x 3]])
  (example "false-implies-undefined" [(t/implies p dead)] [[p false] [x 3]])
  (example "undefined-implies-true" [(t/implies dead (t/bool true))] [[x 3]])
  (example "xor" [(t/xor p r)] [[p true] [r false]])
  (example "boolean-equality" [(t/eq p r)] [[p false] [r false]])
  (example "nary-boolean" [(t/all [(t/bool true) p (t/any [r p (t/bool false)])])] [[p true] [r false]])
  (example "empty-connectives" [(t/all []) (t/not (t/any []))] {})
  (example "integer-comparisons" [(t/lt (t/neg x) y) (t/le x y) (t/ge y x) (t/gt y (t/sub x (t/int 1)))] [[x 2] [y 3]])
  (example "large-integer" [(t/eq x (t/int big))] [[x big]])
  (example "names-remain-data" [(t/eq strange (t/int 11))] [[strange 11]])
  (example "twenty-booleans" [(t/all many)] (mapv (fn [variable] [variable true]) many))
  (example "twenty-choices" [(t/eq (reduce t/add (t/int 0) (mapv #(t/ite % (t/int 1) (t/int 0)) many)) (t/int 20))]
           (mapv (fn [variable] [variable true]) many))
  {:id "watchers-are-not-assumptions"
   :question (q/sat {:assumptions [(t/eq x (t/int 7))]
                    :observe {"undefined" (t/div x (t/int 0)) "observer-only" (t/variable "observer.only" t/Real)}})
   :bindings [[x 7]]}])
(def native-ids #{"empty" "integer" "boolean" "nary-boolean" "integer-comparisons"})
