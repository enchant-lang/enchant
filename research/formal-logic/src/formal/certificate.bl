(ns formal.certificate (:require [formal.term :as t]))

;; This is the checking boundary. No native solver, independent model evaluator,
;; compiler traversal or search implementation is called from this namespace.
(def rules :bl/boolean-linear-integer-v1)
(def limits {:terms 1024 :atoms 32 :nodes 8192 :depth 64 :weight-bits 4096})
(defn- require! [ok message]
 (when-not ok (throw (ex-info (str "formal.certificate: " message) {}))))
(defn- digest [data]
 (Base/encode16 (crypto/hash :sha256 (erlang/term_to_binary data)) (list (tuple :case :lower))))
(defn- gcd [a b] (loop [a (abs a) b (abs b)] (if (= b 0) a (recur b (erlang/rem a b)))))
(defn- floor-div [a b]
 (let [q (erlang/div a b)] (if (< (erlang/rem a b) 0) (dec q) q)))
(defn- coefficients [a b scale]
 (into {} (remove (fn [[_ n]] (= n 0))
  (reduce (fn [out [x n]] (update out x (fn [old] (+ (or old 0) (* scale n))))) a b))))
(defn- affine-add [a b scale]
 {:coeff (coefficients (:coeff a) (:coeff b) scale)
  :constant (+ (:constant a) (* scale (:constant b)))})
(defn- affine-scale [a n]
 {:coeff (coefficients {} (:coeff a) n) :constant (* n (:constant a))})
(defn- affine [term]
 (require! (= t/Int (:sort term)) "linear expressions must have Int sort")
 (let [op (:op term) args (:args term)]
  (case op
   :int {:coeff {} :constant (:data term)}
   :var {:coeff {(:data term) 1} :constant 0}
   :add (affine-add (affine (first args)) (affine (second args)) 1)
   :sub (affine-add (affine (first args)) (affine (second args)) -1)
   :neg (affine-scale (affine (first args)) -1)
   :mul (let [a (affine (first args)) b (affine (second args))]
         (cond (empty? (:coeff a)) (affine-scale b (:constant a))
               (empty? (:coeff b)) (affine-scale a (:constant b))
               :else (throw (ex-info "formal.certificate: nonlinear multiplication" {}))))
   (throw (ex-info "formal.certificate: operation outside the linear Int fragment" {:operation op})))))
(defn- tighten [row]
 (let [g (reduce (fn [g [_ n]] (gcd g n)) 0 (:coeff row))]
  (if (<= g 1) row
   {:coeff (into {} (map (fn [[x n]] [x (erlang/div n g)]) (:coeff row)))
    :bound (floor-div (:bound row) g)})))
(defn- relation [a b strict?]
 (let [difference (affine-add (affine a) (affine b) -1)]
  (tighten {:coeff (:coeff difference) :bound (- (if strict? -1 0) (:constant difference))})))

(defn prepare
 "Reconstruct the exact conditional entailment and its atom vocabulary.
  Inputs are portable data; assertions and the claim are validated afresh."
 [problem]
 (require! (and (= 1 (:formal/query problem)) (= :prove (:mode problem))) "a proof query is required")
 (let [assertions (:assertions problem) claim (:claim problem)
       _ (require! (vector? assertions) "assertions must be a vector")
       _ (doseq [a assertions]
           (require! (and (map? a) (string? (:label a)) (= t/Bool (t/sort-of (:term a)))) "invalid assertion"))
       _ (require! (= t/Bool (t/sort-of claim)) "the claim must be Boolean")
       roots (conj (mapv :term assertions) (t/not claim))
       _ (require! (<= (count (t/walk roots)) (:terms limits)) "term capacity exceeded")
       _ (t/validate! roots)
       atoms (atom []) ids (atom {}) visits (atom 0)
       register (fn [atom]
                  (if (contains? @ids atom) [:atom (get @ids atom)]
                   (let [id (count @atoms)]
                    (require! (< id (:atoms limits)) "atom capacity exceeded")
                    (swap! ids assoc atom id) (swap! atoms conj atom) [:atom id])))
       linear (fn [row]
                (if (empty? (:coeff row)) [:const (<= 0 (:bound row))]
                 (register (assoc row :kind :linear))))]
  (letfn [(boolean [term]
           (require! (<= (swap! visits inc) 4096) "normalization capacity exceeded")
           (require! (= t/Bool (:sort term)) "expected Boolean term")
           (let [op (:op term) args (:args term) a (first args) b (second args)]
            (case op
             :bool [:const (:data term)]
             :var (register {:kind :boolean :name (:data term)})
             :not [:not (boolean a)]
             :and [:and (mapv boolean args)]
             :or [:or (mapv boolean args)]
             :implies [:or [[:not (boolean a)] (boolean b)]]
             :xor (let [a (boolean a) b (boolean b)]
                   [:or [[:and [a [:not b]]] [:and [[:not a] b]]]])
             :ite (let [c (boolean a) yes (boolean b) no (boolean (nth args 2))]
                   [:or [[:and [c yes]] [:and [[:not c] no]]]])
             :eq (cond
                   (= t/Int (:sort a)) [:and [(linear (relation a b false)) (linear (relation b a false))]]
                   (= t/Bool (:sort a)) (let [a (boolean a) b (boolean b)]
                    [:or [[:and [a b]] [:and [[:not a] [:not b]]]]])
                   :else (throw (ex-info "formal.certificate: equality sort outside the proof fragment" {})))
             :le (linear (relation a b false))
             :lt (linear (relation a b true))
             :ge (linear (relation b a false))
             :gt (linear (relation b a true))
             (throw (ex-info "formal.certificate: Boolean operation outside the proof fragment" {:operation op})))))]
   (let [formulas (mapv boolean roots)
         statement {:mode :prove :claim claim
                    :assertions (mapv (fn [a] (select-keys a [:label :term])) assertions)
                    :profile (:profile problem) :profiles (:profiles problem)
                    :scope (:scope problem) :relation (:relation problem)}]
    {:rules rules :statement (digest statement) :subject statement
     :atoms @atoms :formulas formulas
     :assumptions (mapv (fn [i] {:index i :label (:label (nth assertions i))
                               :term (:term (nth assertions i)) :origin (:origin (nth assertions i))})
                       (range (count assertions)))}))))

(defn truth
 "Three-valued evaluation of only the normalized Boolean skeleton."
 [formula assignment]
 (case (first formula)
  :const (second formula)
  :atom (get assignment (second formula))
  :not (let [a (truth (second formula) assignment)] (when (some? a) (not a)))
  :and (let [values (mapv #(truth % assignment) (second formula))]
         (cond (some #(= false %) values) false (every? #(= true %) values) true :else nil))
  :or (let [values (mapv #(truth % assignment) (second formula))]
        (cond (some #(= true %) values) true (every? #(= false %) values) false :else nil))))

(defn inequality
 "The exact integer inequality of an assigned atom; no proof-supplied rows."
 [prepared assignment id]
 (require! (and (int? id) (<= 0 id) (< id (count (:atoms prepared)))
                (contains? assignment id)) "arithmetic premise is not assigned")
 (let [row (nth (:atoms prepared) id)]
  (require! (= :linear (:kind row)) "arithmetic premise is not linear")
  (if (get assignment id) (select-keys row [:coeff :bound])
   (tighten {:coeff (coefficients {} (:coeff row) -1) :bound (- -1 (:bound row))}))))

(defn check
 "Check a finite refutation independently of its producer and both solvers.
  :checked establishes conditional entailment, not assumption feasibility,
  source correctness, compiler correctness or a verified implementation."
 [problem certificate]
 (try
  (let [prepared (prepare problem) count-nodes (atom 0)]
   (require! (and (= 1 (:formal/certificate certificate)) (= rules (:rules certificate))
                  (= (:statement prepared) (:statement certificate))) "certificate belongs to a different statement or rule system")
   (letfn [(visit [proof assignment depth]
            (require! (and (map? proof) (<= depth (:depth limits))
                           (<= (swap! count-nodes inc) (:nodes limits))) "proof capacity or shape")
            (case (:rule proof)
             :boolean (require! (some #(= false (truth % assignment)) (:formulas prepared)) "no Boolean assertion is false")
             :split (let [id (:atom proof)]
                     (require! (and (int? id) (<= 0 id) (< id (count (:atoms prepared)))
                                    (not (contains? assignment id))) "invalid or repeated split atom")
                     (visit (:yes proof) (assoc assignment id true) (inc depth))
                     (visit (:no proof) (assoc assignment id false) (inc depth)))
             :linear (let [weights (:weights proof)
                           _ (require! (and (vector? weights) (pos? (count weights))
                                            (<= (count weights) (:atoms limits))) "invalid arithmetic weights")
                           total (reduce
                            (fn [sum entry]
                             (let [[id weight] entry]
                              (require! (and (vector? entry) (= 2 (count entry)) (int? weight)
                                             (pos? weight) (< weight (erlang/bsl 1 (:weight-bits limits)))) "weights must be positive bounded integers")
                              (let [row (inequality prepared assignment id)]
                               {:coeff (coefficients (:coeff sum) (:coeff row) weight)
                                :bound (+ (:bound sum) (* weight (:bound row)))})))
                            {:coeff {} :bound 0} weights)]
                       (require! (and (empty? (:coeff total)) (< (:bound total) 0)) "arithmetic combination is not a contradiction"))
             (throw (ex-info "formal.certificate: unknown proof rule" {}))))]
    (visit (:proof certificate) {} 0)
    {:status :checked :verdict :entails :rules rules :statement (:statement prepared)
     :profile (:profile problem) :scope (:scope problem) :nodes @count-nodes
     :assumptions (:assumptions prepared) :feasibility :not-established
     :trust [:certificate-checker :term-validation :exact-integer-arithmetic :bl-compiler :beam-runtime]
     :source-connection :not-established :implementation-verification :not-established}))
  (catch error {:status :rejected :verdict :not-established :reason (ex-message error)})))
