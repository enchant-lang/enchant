(ns formal.term-forest (:require [formal.graph-terms :as sdk]))

;; Caller-supplied forests remain diagnostics, never admission authority.
(def profile sdk/profile)
(def limits sdk/limits)
(defn prepare [data roots] (sdk/prepare data roots))
(defn prepare-bool-int [data roots] (sdk/prepare-bool-int data roots))
(defn prepare-numeric [data roots overrides] (sdk/prepare-numeric data roots overrides))
