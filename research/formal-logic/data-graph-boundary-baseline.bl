(ns formal.data-graph-boundary-baseline
 (:require [formal.data-graph :as graph] [bl.json :as json]))
(def valid (graph/encode 0))
(def alias (with-meta :root {:hidden :must-not-disappear}))
(def forged (maps/put alias (:root valid) valid))
(defn inspect-graph [g]
 (try {:status :accepted :reference (graph/reference g) :bytes (erlang/byte_size (graph/bytes g))}
      (catch e {:status :refused :reason (ex-message e)})))
(def report {:valid (inspect-graph valid) :aliased-header (inspect-graph forged)
             :actual-header-fields (erlang/map_size forged)
             :apparent-key-count (count (set (keys forged)))})
(File/write! (first (BeamLisp/argv)) (json/encode report {:pretty 2}))
(println report)
