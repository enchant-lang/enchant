(ns formal.explicit-points-check
 (:require [formal.point :as point] [formal.term :as t] [formal.query :as q]
           [formal.identity :as identity] [formal.answer :as answer] [formal.logic :as logic]
           [veritas :as v] [veritas.property :as property] [veritas.ledger :as ledger]
           [oracle] [datom] [bl.json :as json]))

(def subjects
 [{:id :cancellation :kind :source :source '(defn cancellation [x] (- (+ x 0.1) x))
   :predicate '(= result 0.1) :lower 1.0 :upper 1.0 :arguments [1.0]}
  {:id :negative-zero :kind :source :source '(defn negative-zero [x] (- x))
   :predicate '(erlang/=:= result 0.0) :lower 0.0 :upper 0.0 :arguments [0.0]}
  {:id :division-failure :kind :source :source '(defn divide-zero [x] (/ x 0.0))
   :predicate '(float? result) :lower 1.0 :upper 1.0 :arguments [1.0]}
  {:id :rational-third :kind :math}])
(def argv (BeamLisp/argv))
(def mode (first argv))
(assert (contains? #{"examples" "write" "read"} mode))
(defn generator [subject] (v/float-of (:lower subject) (:upper subject)))
(defn prepare [subject]
 (if (= :source (:kind subject))
  (let [prepared (property/prepare (:source subject) (:predicate subject) (generator subject))]
   (assert (= :translated (:status prepared))) {:question (:problem prepared)})
  (let [x (t/variable "point/rational" t/Real)]
   {:question (q/sat {:assumptions [(t/eq (t/mul (t/real 3 1) x) (t/real 1 1))]
                     :observe {"rational" x} :profile :bl/explicit-rational-point-v1})})))
(defn observed [subject]
 (when (= :source (:kind subject))
  (let [observed (property/observe-point (:source subject) (:predicate subject) (generator subject) (:arguments subject))]
   (assert (= :observed (:status observed)))
   (assert (= :refuted (:modality observed))) observed)))
(defn run-subject [subject engine]
 (let [question (:question (prepare subject))
       native (logic/run {:backend engine} question)
       actual (observed subject)
       packet (if actual (:point actual)
                (:packet (point/prepare question {"point/rational" {:formal/real [1 3]}})))
       checking (point/check question packet)]
  (assert (= :checked-data-connection (:status checking)))
  (assert (= (identity/bytes question) (identity/bytes (:question native))))
  (assert (not (contains? #{:error :invalid-model :vacuous} (:verdict native))))
  (when actual
   (assert (= (identity/hash question) (:question-identity actual)))
   (assert (not= :unsat (:solver-status native))))
  {:id (:id subject) :engine engine :subject subject :question (identity/hash question)
   :native native :point packet :checking checking :source-observation actual
   :compiler-proof-authority false}))
(defn examples []
 (let [rows (vec (for [subject subjects engine [:z3 :oxiz]] (run-subject subject engine)))]
  (doseq [subject subjects]
   (assert (= 1 (count (set (map :question (filter #(= (:id subject) (:id %)) rows)))))))
  {:schema "enchant.formal.explicit-point-examples.v1" :cwd (File/cwd!) :research-import-path false
   :cases rows :compiler-proof-authority false}))
(defn record [connection subject engine]
 (let [row (run-subject subject engine)]
  (ledger/record! connection
   {:modality (if (= :source (:kind subject)) :checked-explicit-counterpoint :checked-data-point)
    :engine engine :question (get-in row [:native :question]) :answer (:native row)
    :witness (get-in row [:point :bindings])
    :evidence {:subject subject :point (:point row) :source-observation (:source-observation row)}
    :compiler-proof-authority false}
   {:claim (str "point/" (:id subject) "/" engine) :about ["logic/original-point"]})))
(defn recheck [row]
 (let [stored (:verdict/evidence row) question (:verdict/question row) packet (get-in stored [:evidence :point])
       checking (point/check question packet) native (:answer stored)
       _ (assert (= (identity/bytes question) (identity/bytes (:question native))))
       checked-native (answer/check question (answer/bind question native))]
  (assert (= :checked-data-connection (:status checking)))
  (assert (= (:verdict native) (:verdict checked-native)))
  (assert (= :recorded (:verdict/assurance row)))
  (assert (= false (:verdict/compiler-authority row)))
  {:id (get-in stored [:evidence :subject :id]) :engine (:verdict/engine row)
   :question (identity/hash question) :point (:identity packet) :role (:role packet)
   :point-status (:status checking) :native-verdict (:verdict checked-native)}))
(defn observe-again [row]
 (let [subject (get-in row [:verdict/evidence :evidence :subject])]
  (when (= :source (:kind subject))
   (let [actual (observed subject)]
    (assert (= (identity/hash (:verdict/question row)) (:question-identity actual)))
    {:id (:id subject) :engine (:verdict/engine row) :status (:status actual)
     :runtime-status (get-in actual [:runtime-replay :status])}))))
(defn recorded []
 (let [connection (ledger/open (second argv))]
  (try
   (when (= mode "write") (doseq [subject subjects engine [:z3 :oxiz]] (record connection subject engine)))
   (let [stored (ledger/about connection "logic/original-point") calls (atom 0)
         rows (oracle/with-oracle {:query (fn [_ _] (swap! calls inc) (throw :pure-point-check-must-not-query))}
                #(mapv recheck stored))
         _ (assert (= 8 (count rows)))
         _ (assert (= 0 @calls))
         fresh-source (vec (keep observe-again stored))]
    (assert (= 6 (count fresh-source)))
    {:schema "enchant.formal.explicit-point-ledger.v1" :mode mode :process (System/pid)
     :rows rows :managed-query-calls @calls :managed-query-scope :pure-original-point-checking
     :source-compilation-during-pure-check false :fresh-source-observations fresh-source
     :source-observation-scope :separate-phase-after-pure-checking :compiler-proof-authority false})
   (finally (datom/close! connection)))))
(def report (if (= mode "examples") (examples) (recorded)))
(File/write! (nth argv (if (= mode "examples") 1 2)) (json/encode report {:pretty 2}))
(println {:mode mode :cases (count (:cases report)) :records (count (:rows report))
          :pure-check-queries (:managed-query-calls report) :compiler-proof-authority false})
