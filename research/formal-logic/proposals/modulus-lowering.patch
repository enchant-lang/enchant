+
+; BL mod is floor modulus: a nonzero result carries the DIVISOR's sign.
+; SMT Euclidean mod is nonnegative even for a negative divisor. This correction
+; is exact for b != 0. The legacy expression API does not encode the raised
+; zero-divisor outcome; callers still need their explicit domain obligation.
+(defn- smt-mod [a b]
+  (let [e (list 'mod a b)]
+    (list 'ite (list 'or (list '= e 0) (list '> b 0)) e (list '+ e b))))
 
