(let [literal "é" x (scalar-text/variable "dossier.text")
      claim (v/equal (scalar-text/at x 1) (formal-data/some (scalar-text/literal "́")))
      subject (question-graph/prepare (q/prove claim {:assumptions [(v/equal x (scalar-text/literal literal))]}))
      request (logic/prepare-request subject {:policy {:profile logic/numeric-word-text-policy}})
      compared (logic/compare-evidence request)
      length (term-replay/value (v/term (scalar-text/length literal)) {})
      absent (term-replay/value (v/term (formal-data/present? (scalar-text/at literal 2))) {})
      strict (term-replay/value (v/defined (scalar-text/at! literal 2)) {})
      fallback (term-replay/value (v/term (scalar-text/at-or literal 2 "fallback")) {})
      rows (mapv (fn [engine]
                    (let [result (get compared engine)]
                     (assert (= :not-established (get-in result [:conclusion :status])))
                     (into-sorted-map {:backend engine :reported-status (get-in result [:answer-check :source :status])
                                      :meaning (get-in result [:answer-check :verdict])
                                      :independent-conclusion (get-in result [:conclusion :status])}))) [:z3 :oxiz])]
 (assert (= 3 (erlang/byte_size literal)))
 (assert (= 2 length))
 (assert (= 1 (String/length literal)))
 (assert (= false absent strict))
 (assert (= "fallback" fallback))
 (assert (= :unsat (get-in compared [:z3 :answer-check :source :status])))
 (assert (= :unknown (get-in compared [:oxiz :answer-check :source :status])))
 (into-sorted-map {:example :explicit-scalar-text :utf8-bytes 3 :codepoints length :bl-graphemes 1
                  :out-of-range-option-present absent :strict-access-defined strict :explicit-fallback fallback
                  :backends rows :point-domain :bounded-valid-utf8 :native-domain-connection :not-established
                  :compiler-proof-authority false}))
