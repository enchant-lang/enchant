--- a/priv/lib/veritas/ledger.bl
+++ b/priv/lib/veritas/ledger.bl
@@ -269,6 +269,17 @@
   ;; Version 2 returns graph data; materialization is always explicit.
   (if (and (nil? (:verdict/format row)) (= true (:verdict/witness-present row)))
    (assoc row :verdict/witness (first (:verdict/witness-value row))) row)))
+(defn lookup
+ "Read and validate one actual verdict by its unique id from one DB snapshot.
+  Unrelated payloads are not decoded. Missing ids return nil; selected payload
+  integrity checks are identical to all. No logical authority is granted."
+ [connection id]
+ (when-not (string? id) (throw (ex-info "Ledger verdict id must be a string" {})))
+ (let [db (datom/db connection) row (datom/pull db PULL [:verdict/id id])]
+  (when (some? (:verdict/id row))
+   (when-not (= id (:verdict/id row)) (throw (ex-info "Ledger unique id lookup differs" {})))
+   (normalize-row db row))))
+
 (defn graph-evidence!
  "Explicitly materialize caller evidence and reattach a separately stored
   answer after binding checks. This does not replay or authenticate that answer."
--- a/priv/lib/formal/request-record.bl
+++ b/priv/lib/formal/request-record.bl
@@ -40,9 +40,9 @@
  "Fetch an actual ledger row, check its payload/index binding, then freshly
   recheck the point. No stored label authenticates native execution."
  [connection id]
- (let [rows (filter #(= id (:verdict/id %)) (ledger/all connection))]
-  (require! (= 1 (count rows)) "one actual ledger record required")
-  (let [row (first rows)]
+ (let [row (ledger/lookup connection id)]
+  (require! (some? row) "one actual ledger record required")
+  (let [row row]
    (require! (and (= ledger/request-format (:verdict/format row))
                   (= :recorded-request (:verdict/modality row)) (= :recorded (:verdict/assurance row))
                   (= false (:verdict/compiler-authority row))) "recorded request ledger envelope required")
