(ns formal.response-contracts-check
 (:require [veritas :as v] [veritas.mock :as mock] [veritas.fault :as fault]
           [formal.term :as t] [formal.value :as value] [formal.logic :as logic]
           [formal.identity :as identity] [bl.json :as json]))
(def output (first (BeamLisp/argv)))
(assert (string? output))
(File/mkdir_p! output)
(defn summary [id result]
 {:id id :modality (:modality result) :value (:value result) :none (:none result)
  :question (:question-identity result) :scope (get-in result [:question :scope])
  :term-replay (get-in result [:answer :validation :status])
  :runtime-replay (get-in result [:runtime-replay :status]) :source-connection (:source-connection result)
  :certificate (get-in result [:answer :certificate :status])
  :feasibility (:feasibility result) :optimality (:optimality result)
  :compiler-proof-authority (:compiler-proof-authority result)})
(defn inspect [backend]
 (let [options {:backend backend}
       band (mock/contract-from [[:x "Int"]] ['(>= x -41) '(<= x -3) '(>= x -50)])
       boolean (mock/contract-from [[:flag "Bool"]] ['(= flag false)])
       mathematical (mock/contract [[:real t/Real] [:bits (t/bv-sort 8)]]
                      (fn [f] [(t/eq (:real f) (t/real 1 3)) (t/eq (:bits f) (t/literal (t/bv-sort 8) 255))]))
       impossible (mock/contract-from [[:x "Int"]] ['(>= x 0) '(< x 0) true])
       both (mock/contract-from [[:x "Int"]] ['(>= x 0) '(<= x 1)])
       server (mock/make-mock options band :x)
       first-answer (mock/answer server -7) again (mock/answer server -7)
       rows [["source-response" (mock/synth options band)] ["false-response" (mock/synth options boolean)]
             ["mathematical-response" (mock/synth options mathematical)] ["isolated" (fault/isolate options band 0)]
             ["implied" (fault/isolate options band 2)] ["vacuous" (fault/isolate options impossible 2)]
             ["any-law-fails" (mock/synth-invalid options both)] ["every-law-fails" (fault/total-error options both)]
             ["minimum" (mock/synth-boundary options band :x :min)]
             ["budget" (mock/synth-boundary options (mock/contract-from [[:x "Int"]] [true]) :x :min {:query-budget 3})]]
       expected [:witnessed :witnessed :witnessed :witnessed :solver-claim :vacuous :witnessed :solver-claim :solver-claim :candidate]]
  (assert (= expected (mapv (comp :modality second) rows)))
  (assert (= {:flag false} (:value (second (nth rows 1)))))
  (assert (= {:formal/real [1 3]} (get-in (second (nth rows 2)) [:value :real])))
  (assert (= -41 (get-in (second (nth rows 8)) [:value :x])))
  (assert (= :witnessed (:feasibility (second (nth rows 8)))))
  (assert (= (:value first-answer) (:value again)))
  (assert (= :retained-answer (:reuse again)))
  (let [x (value/term (mock/field band :x))
        premise (value/make (t/bool true) {:constraints [(t/ge x (t/int -7))]
                                          :scope {:mode :bounded :domain [-7 :unbounded]}})]
   (v/with-solver options
    (fn [owned]
     (logic/load! (:session owned) [premise])
     (let [answer (mock/synth owned band)]
      (assert (= :witnessed (:modality answer)))
      (assert (>= (get-in answer [:value :x]) -7))
      (assert (= :bounded (get-in answer [:question :scope :mode])))
      (assert (= (:question-identity answer) (identity/hash (:question answer))))))))
  {:backend backend :rows (mapv (fn [[id result]] (summary id result)) rows)
   :retained-answer true :retained-semantic-assumption true}))
(def engines (mapv inspect [:z3 :oxiz]))
;; Model choices can change optimization's path, so its terminal question is
;; compared by meaning and replay above, not required to share an incidental ID.
(assert (= (mapv :question (take 8 (:rows (first engines))))
           (mapv :question (take 8 (:rows (second engines))))))
(def report {:schema "enchant.formal.response-contracts.v1" :native engines
             :cwd (File/cwd!) :research-import-path false :compiler-proof-authority false})
(def encoded (json/encode report {:pretty 2}))
(File/write! (Path/join output "examples.json") encoded)
(println encoded)
