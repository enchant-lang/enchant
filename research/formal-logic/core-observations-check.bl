(ns formal.core-observations-check
 (:require [formal.api :as formal] [formal.core-observation-examples :as examples]
           [formal.runtime-artifact :as artifact] [interop]))

(def out (System/get_env "ENCHANT_FORMAL_EVIDENCE_ROOT"))
(File/mkdir_p! out)
(def rows
 (mapv (fn [{:keys [id definition initial events]}]
         (let [observed (formal/observe-protocol-trace definition initial events)
               receipt (:receipt observed)
               made (formal/core-actor-observation-data definition receipt)
               packet (:packet made)]
          (when-not (and (= :observed (:status observed)) (= :ready (:status made)))
           (println {:id id :observation (:status observed) :projection made})
           (throw (ex-info "Core observation export refused" {:id id})))
          (assert (= :checked-data-connection (:status (formal/check-core-actor-observation-data definition receipt packet))))
          (File/write! (Path/join out (str id ".json")) (interop/->json packet))
          {:id id :definition definition :receipt receipt :packet packet
           :runtime-safety (get-in observed [:checking :runtime-safety])}))
       (examples/examples)))
(def snapshot {:schema :enchant.formal.core-observation-examples-v1 :rows rows
               :source-commit (trim (elem (System/cmd "git" (list "rev-parse" "HEAD")) 0))})
(def bytes (erlang/term_to_binary snapshot (list :deterministic (tuple :minor_version 2))))
(assert (<= (erlang/byte_size bytes) 8388608))
(File/write! (Path/join out "core-observations.etf") bytes)
(File/write! (Path/join out "summary.json") (interop/->json
 {:schema (:schema snapshot) :source-commit (:source-commit snapshot)
  :archive {:bytes (erlang/byte_size bytes) :sha256 (artifact/digest bytes)}
  :rows (mapv (fn [row] {:id (:id row) :packet (get-in row [:packet :identity]) :receipt (get-in row [:receipt :identity])
                        :events (count (get-in row [:receipt :events])) :runtime-safety (:runtime-safety row)}) rows)}))
(println {:examples (count rows) :kernel-execution :not-run})
