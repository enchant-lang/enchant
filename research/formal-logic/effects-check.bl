(ns formal.effects-check
 (:require [formal.effect-examples :as examples] [bl.json :as json]))
(let [report {:schema "enchant.formal.effect-examples.v1" :results (examples/results)
              :scope "Submission snapshots with actual callback custody; synchronous named handlers."
              :compiler-proof-authority false}]
 (File/write! "research/formal-logic/evidence/effects/examples.json" (json/encode report {:pretty 2}))
 (println (json/encode report {:pretty 2})))
