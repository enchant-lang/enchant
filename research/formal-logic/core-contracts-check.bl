(ns formal.core-contracts-check
 (:require [formal.core-contract-examples :as examples] [formal.api :as formal]
           [formal.runtime-artifact :as artifact] [interop]))

(def out (System/get_env "ENCHANT_FORMAL_EVIDENCE_ROOT"))
(File/mkdir_p! out)
(def rows
 (mapv (fn [row]
         (let [proof (examples/certify (:definition row)) certificate (:certificate proof)]
          (assert (= :checked (:status proof)) (pr-str {:id (:id row) :status (:status proof) :reason (:reason proof)}))
          (let [made (examples/export row certificate) packet (:packet made)]
           (assert (= :ready (:status made)) (pr-str {:id (:id row) :status (:status made) :reason (:reason made)}))
           (assert (= :checked-data-connection (:status (formal/check-core-contract-data (:definition row) certificate packet))))
           (File/write! (Path/join out (str (:id row) ".json")) (interop/->json packet))
           (assoc row :certificate certificate :packet packet)))) examples/rows))
(def snapshot {:schema :enchant.formal.core-contract-examples-v1 :rows rows
               :source-commit (trim (elem (System/cmd "git" (list "rev-parse" "HEAD")) 0))})
(def bytes (erlang/term_to_binary snapshot (list :deterministic (tuple :minor_version 2))))
(assert (<= (erlang/byte_size bytes) 8388608))
(File/write! (Path/join out "core-contracts.etf") bytes)
(File/write! (Path/join out "summary.json") (interop/->json
 {:schema (:schema snapshot) :source-commit (:source-commit snapshot)
  :archive {:bytes (erlang/byte_size bytes) :sha256 (artifact/digest bytes)}
  :rows (mapv (fn [row] {:id (:id row) :packet (get-in row [:packet :identity])
                        :witness (get-in row [:packet :witness :identity])}) rows)}))
(println {:examples (count rows) :witnesses (count (filter #(get-in % [:packet :witness]) rows))
          :kernel-execution :not-run})
