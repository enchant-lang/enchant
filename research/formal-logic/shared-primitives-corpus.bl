(ns formal.shared-primitives-corpus
 (:require [formal.evaluate :as e] [formal.term :as t] [formal.query :as q]
           [formal.data-graph :as g] [formal.point-fixtures :as fixtures]
           [formal.advanced-cases :as advanced] [formal.feature-cases :as features]
           [formal.native-cases :as native] [oracle] [bl.json :as json]))

;; Owned compatibility fixtures, not a generic evidence interchange. JSON
;; cannot carry ETF Float64 payload bytes directly, so their row payload is
;; base64 here. The SDK reader reconstructs and freshly checks the public graph.
(defn- wire [graph]
 (assoc graph :nodes (mapv (fn [[kind payload]] [kind (if (= "float" kind) (Base/encode64 payload) payload)]) (:nodes graph))))
(def calls (atom 0))
(defn deny [& _] (swap! calls inc) (throw :point-corpus-must-not-query))
(def rows
 (oracle/with-oracle {:query deny :query-graph deny :script deny}
  (fn []
   (vec
    (mapcat
     (fn [[family cases]]
      (mapv
       (fn [item]
        (println (str "shared SDK primitives " (:id item)))
        (let [problem (q/from-case item)
              terms (vec (concat (q/roots problem) [(get-in problem [:counterexample :term])]))
              data (g/encode terms) roots (second (nth (:nodes data) (:root data)))
              variables (t/variables terms)
              points
              (mapv
               (fn [mode]
                (let [bindings (fixtures/bindings variables mode)
                      expected (mapv #(e/value % bindings) terms)
                      legacy (e/graph-values data roots bindings {:profile e/graph-profile})
                      direct (e/graph-values data roots bindings {})]
                 (assert (erlang/=:= expected (:values legacy)))
                 (assert (erlang/=:= expected (:values direct)))
                 (assert (= (:checking legacy) (:checking direct)))
                 (assert (= (:data-reference direct) (g/reference data)))
                 (doseq [i (range (count terms))]
                  (let [value (nth (:values direct) i)]
                   (when-not (e/unavailable? value)
                    (assert (= :valid (:status (e/check-value (t/sort-of (nth terms i)) value)))))))
                 {:mode mode :assignments (wire (g/encode bindings)) :roots (count roots)
                  :exact-values true :concrete-values-sort-checked true
                  :value-reference (g/reference (g/encode expected))
                  :checking (:checking direct) :resources (:resources direct)}))
               [:absent :zero :alternate :ill-sorted])]
         {:id (:id item) :family family :graph (wire data) :data-reference (g/reference data)
          :source-roots roots :points points :compiler-proof-authority false})) cases))
     [[:advanced (advanced/cases)] [:features (features/all-cases)] [:native (native/cases)]])))))

(def transport-graph (g/encode [(t/real 1 3) 0.0 -0.0]))
(def transport-root (first (second (nth (:nodes transport-graph) (:root transport-graph)))))
(def transport-point (e/graph-values transport-graph [transport-root] {} {}))
(assert (= [(e/real 1 3)] (:values transport-point)))
(assert (= 187 (count rows)))
(assert (= 0 @calls))
(File/write! (first (BeamLisp/argv))
 (json/encode {:schema "enchant.formal.shared-sdk-point-fixtures.v1" :rows rows :managed-query-calls @calls
               :transport-control {:graph (wire transport-graph) :source-roots [transport-root]
                                   :data-reference (g/reference transport-graph)
                                   :expected (g/reference (g/encode (:values transport-point)))}
               :compiler-proof-authority false} {:pretty 2}))
(println {:questions (count rows) :point-maps (* 4 (count rows)) :managed-query-calls @calls
          :status :exact-sdk-primitive-agreement :transport :float-history-kept})
