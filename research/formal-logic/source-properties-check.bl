(ns formal.source-properties-check
 (:require [veritas :as v] [veritas.property :as p] [formal.check :as check]
           [formal.identity :as identity] [bl.json :as json]))
(def output (first (BeamLisp/argv)))
(assert (string? output))
(File/mkdir_p! output)
(def floor '(defn floor [c] (if (< c 0) 0 c)))
(defn inspect [engine]
 (let [opts {:backend engine} domain (v/one-of -2)
       law (p/prove opts floor '(>= result 0) domain)
       failure (p/prove opts floor '(> result 0) domain)
       crash (p/prove opts '(defn boom [n] (quot n 0)) true (v/one-of 7))
       guarded (p/prove opts '(defn safe [n] (if (= n 0) 0 (quot 1 n))) '(= result 0) (v/one-of 0))
       empty (p/prove opts '(defn ident [n] n) false (v/one-of))]
  (assert (= :solver-claim (:modality law)))
  (assert (= :not-checked (get-in law [:answer :certificate :status])))
  (assert (= :refuted (:modality failure)))
  (assert (= :valid (get-in failure [:answer :validation :status])))
  (assert (= :reproduced (get-in failure [:runtime-replay :status])))
  (assert (= -2 (:witness failure))) (assert (= 0 (:result failure)))
  (assert (= :refuted (:modality crash))) (assert (= true (:crash crash)))
  (assert (= :vacuous (:modality empty)))
  (assert (= (if (= :z3 engine) :solver-claim :unknown) (:modality guarded)))
  {:guarded-division {:modality (:modality guarded) :question (:question-identity guarded)
                      :solver-status (get-in guarded [:answer :solver-status])}
   :backend engine :law (:modality law) :native-certificate (get-in law [:answer :certificate :status])
   :law-question (:question-identity law) :failure-question (:question-identity failure)
   :failure (:modality failure) :witness (:witness failure) :result (:result failure)
   :term-replay (get-in failure [:answer :validation :status])
   :runtime-replay (get-in failure [:runtime-replay :status])
   :crash-status (get-in crash [:runtime-replay :target :status])
   :crash-replay (get-in crash [:runtime-replay :status]) :empty-domain (:modality empty)
   :artifacts (get-in failure [:answer :identity :artifacts]) :compiler-proof-authority false}))
(def rows (mapv inspect [:z3 :oxiz]))
(assert (apply = (map #(get-in % [:guarded-division :question]) rows)))
(assert (apply = (map :law-question rows))) (assert (apply = (map :failure-question rows)))
(def prepared (p/prepare '(defn step [n] (+ n 1)) '(> result n) (v/int-of 0 1000000)))
(def proof (check/query (:problem prepared)))
(assert (= :checked (:status proof)))
(def report {:schema "enchant.formal.source-properties.v1" :native rows
             :term-proof {:status (:status proof) :verdict (get-in proof [:evidence :claim :verdict])
                          :question (:question-identity prepared) :source-connection :reviewed}
             :cwd (File/cwd!) :research-import-path false :compiler-proof-authority false})
(def encoded (json/encode report {:pretty 2}))
(File/write! (Path/join output "examples.json") encoded)
(println encoded)
