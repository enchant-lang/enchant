(ns formal.decimal-format-probe (:require [decimal :as decimal] [bl.json :as json]))

;; Preserve the qualified BEAM spelling before implementing the JS host API.
(def samples [0.0 -0.0 0.1 1.0 1.5 1.0e-7 1.0e-6 1.0e-5 1.0e-4
              1.0e14 1.0e15 1.0e16 1.0e20 1.0e21 9007199254740992.0
              1.234567890123456e15 1.234567890123456e-5])
(def rows
 (mapv (fn [value]
         (let [converted (decimal/from-float value)]
          {:float-text (Float/to_string value) :decimal-text (decimal/plain-str converted)
           :coefficient (str (decimal/unscaled converted)) :scale (decimal/scale converted)})) samples))
(File/write! (first (BeamLisp/argv)) (json/encode {:rows rows :scope :named-shortest-roundtrip-approximation} {:pretty 2}))
(println {:samples (count rows) :target :beam :scope :named-shortest-roundtrip-approximation})
