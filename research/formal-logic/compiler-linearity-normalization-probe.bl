(ns formal.compiler-linearity-normalization-probe
 (:require [formal.term :as t] [formal.query :as query] [formal.proof :as proof]
           [formal.certificate :as certificate] [formal.logic :as logic]
           [formal.identity :as identity] [bl.json :as json]))
(defn sum [terms] (reduce t/add (t/int 0) terms))
(defn question [k n overhead duplication]
 (let [sizes (mapv #(t/variable (str "linearity/size/" %) t/Int) (range n))
       children (mapv #(t/variable (str "linearity/emitted/" %) t/Int) (range n))
       h (t/variable "linearity/overhead" t/Int)
       assumptions (vec (concat (mapv #(t/ge % (t/int 0)) sizes)
                          (mapv #(t/ge % (t/int 0)) children)
                          (mapv (fn [s c] (t/le c (t/mul (t/int k) s))) sizes children)
                          [(t/ge h (t/int 0)) (t/le h (t/int overhead))]))
       emitted (t/add h (sum (mapv (fn [i c] (t/mul (t/int (if (= i 0) duplication 1)) c))
                                    (range n) children)))
       bound (t/mul (t/int k) (t/add (t/int 1) (sum sizes)))]
  (query/prove (t/le emitted bound)
    {:id :compiler/constructor-size :profile :bl/declared-constructor-size-v1
     :assumptions assumptions :observe {"output" emitted "bound" bound}
     :origin {:arity n :coefficient k :overhead-bound overhead :first-child-placement duplication
              :compiler-connection :conditional-not-mechanized}})))

(defn normalize [term style]
 (let [args (mapv #(normalize % style) (:args term)) a (first args) b (second args)
       integer? (fn [x n] (and (= :int (:op x)) (= n (:data x))))]
  (cond
   (= :add (:op term))
    (cond (integer? a 0) b (integer? b 0) a
          (and (= :int (:op a)) (= :int (:op b))) (t/int (+ (:data a) (:data b)))
          :else (t/add a b))
   (= :mul (:op term))
    (let [[coefficient expression] (if (= :int (:op a)) [a b] [b a])]
     (if-not (= :int (:op coefficient)) (t/mul a b)
      (let [k (:data coefficient)]
       (cond
        (= :int (:op expression)) (t/int (* k (:data expression)))
        (= k 0) (t/int 0)
        (= k 1) expression
        (= :add (:op expression))
         (normalize (t/add (t/mul coefficient (first (:args expression)))
                           (t/mul coefficient (second (:args expression)))) style)
        (= :addition style)
         (do (assert (<= 0 k 64)) (reduce t/add (t/int 0) (repeat k expression)))
        :else (t/mul coefficient expression)))))
   :else (assoc term :args args))))

(defn transformed [problem style]
 (if (= style :original) problem
  (let [claim (normalize (:claim problem) style)]
   (query/validate!
    (-> problem
        (assoc :claim claim :counterexample (assoc (:counterexample problem) :term (t/not claim)))
        (update :assertions #(mapv (fn [row] (update row :term (fn [term] (normalize term style)))) %))
        (update :observe #(into {} (mapv (fn [[key term]] [key (normalize term style)]) %)))
        (update :origin assoc :normalization style))))))

(defn bridge [before after]
 (let [pairs (concat (mapv (fn [a b] [(:term a) (:term b)]) (:assertions before) (:assertions after))
                     [[(:claim before) (:claim after)]]
                     (mapv (fn [[label term]] [term (get (:observe after) label)]) (:observe before)))
       rows (mapv (fn [[a b]]
                    (let [problem (query/prove (t/eq a b) {:id :compiler/size-form-equivalence})
                          result (proof/produce problem)]
                     (assert (= :checked (:status result)))
                     {:question problem :certificate (:certificate result) :checking (:checking result)})) pairs)]
  {:status :checked-exact-question-forms :original (identity/hash before) :transformed (identity/hash after) :rows rows
   :scope :these-reconstructed-assertions-claims-and-observations :compiler-proof-authority false}))

(def cases
 (vec (for [n [0 1 2] duplication [1 2] style [:original :affine :addition]]
        (let [original (question 12 n 8 duplication) target (transformed original style)]
         {:id [n duplication style] :question target :bridge (bridge original target)}))))
(def native
 (mapv (fn [backend]
          (logic/with-session {:backend backend}
           (fn [session]
            {:backend backend
             :cases (mapv (fn [row]
                             (let [answer (logic/solve-in session (:question row))]
                              {:id (:id row) :question (identity/hash (:question row))
                               :verdict (:verdict answer) :validation (:validation answer)
                               :answer answer})) cases)}))) [:z3 :oxiz]))
(assert (= (mapv :question (:cases (first native))) (mapv :question (:cases (second native)))))
(def report {:schema "enchant.formal.compiler-size-normalization-probe.v1" :cases cases :native native
             :compiler-proof-authority false :normalizer-soundness :checked-only-for-these-questions})
(File/write! (first (BeamLisp/argv)) (json/encode report {:pretty 2}))
(println (json/encode {:cases (count cases)
                      :native (mapv (fn [engine] {:backend (:backend engine)
                                                 :verdicts (mapv #(select-keys % [:id :verdict]) (:cases engine))}) native)
                      :compiler-proof-authority false} {:pretty 2}))
