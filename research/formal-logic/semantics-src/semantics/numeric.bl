(ns semantics.numeric (:require [decimal :as decimal] [semantics.decimal-oracle :as oracle]))

;; Compile this actual BL function for the cross-target semantic gate. Calling
;; only the hand-written JS value helpers cannot qualify the emitted BL route.
(defn relations [a b]
 [(= a b) (compare a b) (= [a] (list b)) (= {"value" a} {"value" b})
  (count (set [a b]))])

(defn representations [a b]
 [(= a b) (decimal/same-representation? a b)])

(defn approximation [value]
 (let [converted (decimal/from-float value)]
  [(str (decimal/unscaled converted)) (decimal/scale converted) (decimal/plain-str converted)]))

(defn decimal-oracle [] (oracle/results))
