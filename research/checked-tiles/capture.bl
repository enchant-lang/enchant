(let [[input-path table-path reference-path] (clojure.io/current-command-line-args)
      input (File/read! input-path)
      table (mapv pixel (range 256))
      started (System/monotonic_time :microsecond)
      frame (erlang/list_to_binary (to-list (mapv pixel (erlang/binary_to_list input))))
      elapsed (- (System/monotonic_time :microsecond) started)]
  (File/write! reference-path frame)
  (File/write! table-path (Jason/encode! {:table table :sdk (System/fetch_env! "BL_SDK_PRODUCT") :frame_us elapsed})))
