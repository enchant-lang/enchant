(let [[input-path table-path reference-path] (clojure.io/current-command-line-args)
      input (File/read! input-path)
      table (to-list (mapv pixel (range 256)))
      started (System/monotonic_time :microsecond)
      fits (every? (fn [v] (and (int? v) (<= 0 v) (< v 256))) table)]
  (when fits
    (File/write! reference-path
      (erlang/list_to_binary (to-list (mapv pixel (erlang/binary_to_list input))))))
  (File/write! table-path (Jason/encode! {:table table :sdk (System/fetch_env! "BL_SDK_PRODUCT")
    :frame_us (- (System/monotonic_time :microsecond) started)})))
