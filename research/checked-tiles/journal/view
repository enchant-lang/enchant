#!/usr/bin/env bash
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
kit=${DOSSIER_KIT_DIR:-"$HOME/projects/enchanted-skills/bl-org-dossier/kit"}
case "${1:-experiment}" in
  experiment) name=02-experiment.bl.org ;;
  core) name=04-native-concurrent-core.bl.org ;;
  pipeline) name=03-live-compiler.bl.org ;;
  discussion) name=01-bend-and-enchant.bl.org ;;
  *) echo "usage: $0 [discussion|experiment|pipeline|core]" >&2; exit 2 ;;
esac
sdk=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["sdk"])' "$here/../tools.json")
if [[ -z "${PORT:-}" ]]; then
  PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
fi
export DOSSIER_KIT_DIR="$kit" PORT
echo "Journal will be available on http://127.0.0.1:$PORT/ once the BL renderer is ready. Ctrl-C stops it."
exec systemd-run --user --scope --quiet -p MemoryMax=2G -p MemorySwapMax=256M \
  "$sdk/bin/bl" --cold -p "$kit" serve "$kit/serve.bl" -- "$here/$name"
