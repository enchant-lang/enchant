#!/usr/bin/env bash
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
if [[ $# -lt 1 ]]; then
  echo "usage: $0 NEW_DIRECTORY [--cpu-only] [--quick]" >&2
  exit 2
fi
root=$(realpath -m -- "$1")
shift
mkdir -- "$root"
"$here/run" --out "$root/corpus" "$@"
export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-"$root/cargo"}
run_case() {
  "$here/../../../scripts/bl-mem" | tail -2
  systemd-run --user --scope --quiet -p MemoryMax=2G -p MemorySwapMax=256M python3 -B "$here/$1" "${@:2}"
}
run_case packed.py "$root/corpus" --out "$root/packed"
run_case ordinary.py "$root/corpus" "$root/packed" --out "$root/bytes" --probe "$CARGO_TARGET_DIR/release/j1_probe"
run_case bounded.py "$root/corpus" --word --out "$root/word"
echo "Results in $root/{corpus,packed,bytes,word}/receipt.json"
