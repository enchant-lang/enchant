(ns speed.oracle (:require [speed.kernels :as k] [speed.emit :as emit]))
(let [[folder source] (clojure.io/current-command-line-args)
      cases (Jason/decode! (File/read! (str folder "/oracle-input.json")))
      answers (mapv (fn [row]
                      (let [id (get row "id") n (get row "n") seed (get row "seed")
                            data (get row "data")]
                        (case id 0 seed 1 (k/serial n seed) 2 (k/tree n seed)
                          3 (k/scan data) 4 (k/mapped data) 5 (k/fused data)))) cases)]
  (File/write! (str folder "/oracle.json") (Jason/encode! (to-list answers)))
  (doseq [policy ["linked" "hoisted"]]
    (File/write! (str folder "/" policy ".scm") (emit/emit-file source (File/read! source) policy))))
