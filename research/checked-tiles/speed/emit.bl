(ns speed.emit
  (:require [native.eval :as ev] [native.scheme :as scheme] [compiler :as c]
            [reader :as rd] [reader-node :as rn]))

; Fast paths for this sealed snapshot. Every unhandled input still invokes the
; exact captured import. Operands have already been evaluated by linked-call.
(defn import-call [policy code cell args]
  (let [a (first args) ordinary (str "(" cell " " (Enum/join (to-list args) " ") ")")]
    (if (not= policy "shapes") ordinary
      (case code
        "(native-remote \"erlang/hd/1\")" (str "(if (pair? " a ") (car " a ") " ordinary ")")
        "(native-remote \"erlang/tl/1\")" (str "(if (pair? " a ") (cdr " a ") " ordinary ")")
        "(native-remote \"Elixir.BeamLisp.Ns.Rt/empty?/1\")"
          (str "(cond ((null? " a ") #t) ((pair? " a ") #f) (else " ordinary "))")
        "(native-remote \"Elixir.BeamLisp.Ns.Rt/not_/1\")"
          (str "(if (boolean? " a ") (not " a ") " ordinary ")")
        "(native-remote \"Elixir.BeamLisp.Ns.Core/quot/2\")"
          (if (= "2" (second args))
            (str "(if (fixnum? " a ") (quotient " a " 2) " ordinary ")") ordinary)
        ordinary))))

(defn emit-file [path source policy]
  (let [ns "speed.kernels"
        forms (rd/read-string source path)
        native? (or (= policy "guarded") (= policy "reference"))
        _ (when native? (ev/eval-form (first forms)))
        context (ev/context ns)
        arithmetic (:arithmetic-resolver context)
        fast {:add "speed-add" :sub "speed-sub" :mul "speed-mul" :lt "speed-lt"}
        remote (:remote-resolver context)
        captures (atom {})
        options (if (not= policy "reference")
                  (assoc context :arithmetic-resolver
                         (fn [node] (or (get fast (:fun node)) (arithmetic node)))) context)
        options (if native? options
                  (assoc options :aot-link
                    {:remote (fn [node]
                       (when (or (= policy "hoisted") (= policy "shapes"))
                         (let [code (remote node)
                               cell (str "speed-import-" (or (get @captures code) (count @captures)))]
                           (when-not (contains? @captures code)
                             (swap! captures assoc code (count @captures)))
                           {:inline? true :call (fn [args] (import-call policy code cell args))})))}))
        bodies
        (apply str
      (mapv (fn [form]
        (let [env (assoc (c/new-env ns) :target :js)
              decl (c/declaration-source form env)
              name (rn/node-name (rn/node-form (:name decl)))
              _ (BeamLisp.Env/intern ns name nil)
              _ (c/reset-fresh!)
              ir (c/compile (:value-form decl) env)]
          (str "(native-intern \"speed.kernels\" \"" name "\" " (scheme/emit ir options) ")\n")))
        (rest forms)))]
    (str (apply str (mapv (fn [[code id]] (str "(define speed-import-" id " " code ")\n")) @captures))
         bodies)))
