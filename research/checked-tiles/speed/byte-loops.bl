(ns speed.bytes)

(defn grade [buf n]
  (loop [i 0 total 0]
    (if (< i n)
      (recur (+ i 1) (+ total (quot (+ (binary/at buf i) 255) 2)))
      total)))

; State is twice the number of runs so far, plus one while inside a run.
(defn scan [buf n]
  (quot
    (loop [i 0 state 0]
      (if (< i n)
        (recur (+ i 1)
          (let [b (binary/at buf i)
                base (* 2 (quot state 2))
                digit (if (< b 48) 0 (if (< b 58) 1 0))]
            (if (< digit 1) base (if (< state (+ base 1)) (+ base 3) state))))
        state))
    2))
