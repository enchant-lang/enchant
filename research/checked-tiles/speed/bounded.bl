(ns speed.bounded (:require [native.scheme :as scheme] [native.eval :as ev]
                            [reader :as rd] [reader-node :as rn] [compiler :as c]))
; This finite specialization has a manually checked BL/Lean correspondence.
; An edit invalidates the exact source subject before any unchecked emission.
(let [[path out style] (clojure.io/current-command-line-args) source (File/read! path)
      hash (Base/encode16 (crypto/hash :sha256 source) (list (tuple :case :lower)))]
  (assert (= hash "3d8f2bf18655ad648770a52e43dc4aca611fa15b916ba99a051d4a13d6c5ad4d"))
  (let [ns "speed.kernels" env (assoc (c/new-env ns) :target :js)
        form (second (rd/read-string source path)) decl (c/declaration-source form env)
        name (rn/node-name (rn/node-form (:name decl)))
        _ (assert (= name "serial")) _ (BeamLisp.Env/intern ns name nil) _ (c/reset-fresh!)
        ir (c/compile (:value-form decl) env)
        intrinsics {:add "##fx+" :sub "##fx-" :mul "##fx*" :lt "##fx<"}
        options (assoc (ev/context ns) :aot-link {:remote (fn [_] nil)}
                  :arithmetic-resolver (fn [node]
                    (if-let [op (get intrinsics (:fun node))]
                      (if (= style "direct") (str "(lambda (a b) (" op " a b))") op)
                      (throw (ex-info "Unexpected arithmetic in bounded serial region" {})))))]
    (File/write! out (str "(define speed-raw-serial " (scheme/emit ir options) ")\n"))))
