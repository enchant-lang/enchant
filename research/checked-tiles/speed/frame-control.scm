(with-exception-catcher
 (lambda (e) (display-exception e (current-error-port)) (exit 1))
 (lambda ()
  (load (caddr (native-command-line)))
  (let ((selected (native-global-exact "speed.kernels" "serial")))
   (define (observe f budget)
    (let* ((answer #f)
           (frame (h-make-frames (lambda () (set! answer (f 33 37))) '())))
      (let resume ((yields 0))
        (let ((status (bl-get (h-run-turn frame budget) (bl-key "status"))))
          (cond ((equal? status (bl-key "done")) (list yields answer))
                ((and (< yields 40) (equal? status (bl-key "yield"))) (resume (+ 1 yields)))
                (else (error "unexpected scheduling trace" yields status)))))))
   (for-each
    (lambda (budget)
      (let ((actual (observe selected budget)) (expected (observe speed-general-serial budget)))
        (if (or (not (equal? actual expected)) (< (car actual) 1)) (error "frame trace differs" actual expected))
        (write (list budget (car actual) (cadr actual))) (newline)))
    '(1 4 9))
   (exit 0))))
