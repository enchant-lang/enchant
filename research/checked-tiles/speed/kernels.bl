(ns speed.kernels)

(defn serial [n seed]
  (loop [i n x seed]
    (if (< i 1) x
      (let [t (+ (* x 3) 1)
            y (if (< t 65521) t (if (< t 131042) (- t 65521) (- t 131042)))]
        (recur (- i 1) y)))))

(defn tree [depth x]
  (if (< depth 1) (+ (* x x) 1)
    (+ (tree (- depth 1) x) (tree (- depth 1) (+ x 1)))))

(defn scan [xs]
  (loop [ys xs inside false runs 0]
    (if (empty? ys) runs
      (let [c (erlang/hd ys) digit (and (< 47 c) (< c 58))]
        (recur (erlang/tl ys) digit (if (and digit (not inside)) (+ runs 1) runs))))))

(defn mapped [xs]
  (reduce + 0 (mapv (fn [x] (quot (+ x 255) 2)) xs)))

(defn fused [xs]
  (loop [ys xs total 0]
    (if (empty? ys) total
      (recur (erlang/tl ys) (+ total (quot (+ (erlang/hd ys) 255) 2))))))
