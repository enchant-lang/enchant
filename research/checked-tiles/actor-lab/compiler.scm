;; A real self-hosted emitter with one editable provider. The example is small
;; enough to compare every result against a clean emission under each revision.
(define lab-ident (native-global-exact "native.scheme" "ident"))
(define lab-emitter (native-global-exact "native.scheme" "emit"))
(define (new-ident s)
  (let ((old (bl-invoke lab-ident (list s))))
    (string-append "w" (substring old 1 (string-length old)))))
(define (install-ident f) (native-intern "native.scheme" "ident" f))
(define (literal-node n) (bl-map (bl-key "op") (bl-key "lit") (bl-key "val") n))
(define binding-node
  (bl-map (bl-key "op") (bl-key "let") (bl-key "name") "x"
          (bl-key "init") (literal-node 7)
          (bl-key "body") (bl-map (bl-key "op") (bl-key "var") (bl-key "name") "x")))
(define (emit-node n) (bl-invoke lab-emitter (list n (bl-empty-map))))
(define (evaluate-program s) (eval (with-input-from-string s read)))

(define (compiler-collision pinned?)
  (let ((arrived #f) (edited #f) (bytes #f) (old #f) (new #f))
    (install-ident lab-ident) (set! old (emit-node binding-node))
    (install-ident new-ident) (set! new (emit-node binding-node))
    (check (and (not (string=? old new)) (= 7 (evaluate-program old) (evaluate-program new))) "clean emit oracles")
    (run-actors
     (lambda ()
       ;; Interpose exactly at the first identifier emission. Keep the saved
       ;; target for this individual invocation even if the peer publishes B.
       (let ((job-owner (h-self)))
         (install-ident
          (lambda (s)
            (set! arrived #t)
            (wait-for (lambda () edited))
            (bl-invoke lab-ident (list s))))
         (spawn (lambda ()
                  (wait-for (lambda () arrived))
                  (install-ident
                   (lambda (s)
                     (if (and pinned? (bl-equal? (h-self) job-owner))
                         (bl-invoke lab-ident (list s)) (new-ident s))))
                  (set! edited #t)))
         (set! bytes (emit-node binding-node)))))
    (let ((result (with-exception-catcher (lambda (ex) 'error) (lambda () (evaluate-program bytes)))))
      (check (if pinned? (and (equal? result 7) (string=? bytes old))
                 (and (eq? result 'error) (not (string=? bytes old)) (not (string=? bytes new))))
             "mixed-generation compiler control")
      (check (string=? new (emit-node binding-node)) "fresh compile after edit")
      (report "compiler" (if pinned? 'pinned 'latest) old new bytes result))
    (install-ident lab-ident)))

(define (incremental n)
  (let ((inputs (make-vector n)) (before (make-vector n)) (dirty '()) (owner #f))
    (vector-set! inputs 0 binding-node)
    (let fill ((i 1))
      (if (< i n) (begin (vector-set! inputs i (literal-node i)) (fill (+ i 1)))))
    (install-ident
     (lambda (s)
       (if (or (null? dirty) (not (= (car dirty) owner))) (set! dirty (cons owner dirty)))
       (bl-invoke lab-ident (list s))))
    (let capture ((i 0))
      (if (< i n) (begin (set! owner i) (vector-set! before i (emit-node (vector-ref inputs i)))
                         (capture (+ i 1)))))
    (install-ident new-ident)
    (let* ((start (micros))
           (patch (map (lambda (i) (cons i (emit-node (vector-ref inputs i)))) dirty))
           (update-us (elapsed start)) (clean-start (micros)))
      (let compare ((i 0))
        (if (< i n)
            (let ((change (assv i patch)) (clean (emit-node (vector-ref inputs i))))
              (check (string=? clean (if change (cdr change) (vector-ref before i))) "dirty replay")
              (if change (check (not (string=? clean (vector-ref before i))) "stale bytes accepted"))
              (compare (+ i 1)))))
      (check (equal? dirty '(0)) "incorrect provider index")
      (report "invalidation" n (length patch) (- n (length patch)) update-us (elapsed clean-start)))
    (install-ident lab-ident)))
