(define quick? (equal? (getenv "ENCHANT_LAB_QUICK" "0") "1"))
(for-each
 (lambda (candidate?)
   (set! lab-candidate? candidate?)
   (storage-branches)
   (for-each collision '(pinned latest deadline timeout retire))
   (selective (if quick? 33 257)))
 '(#f #t))
(for-each compiler-collision '(#t #f))
(for-each incremental (if quick? '(8) '(16 64 256)))
(let trials ((trial 0))
  (if (< trial (if quick? 1 3))
      (begin
        (for-each (lambda (n)
          (for-each (lambda (candidate?)
                      (set! lab-candidate? candidate?) (bench n trial))
                    (if (even? trial) '(#f #t) '(#t #f))))
          (if quick? '(32 128) '(128 256 512 1024 2048)))
        (trials (+ trial 1)))))
(report "complete")
