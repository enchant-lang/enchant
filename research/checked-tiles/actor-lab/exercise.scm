(define (kernel name . args) (bl-invoke (native-global-exact "native.kernel" name) args))
(define (field obj name) (bl-get obj (bl-key name)))
(define (process-of pid) (field-proc seed-state pid))
(define (field-proc state pid) (bl-get (field state "procs") pid))
(define (mail pid) (field (process-of pid) "mailbox"))
(define (check fact label) (if (not fact) (error "native actor lab" label)))
(define (report kind . fields)
  (display kind)
  (for-each (lambda (v) (display "\t") (display v)) fields)
  (newline) (force-output))
(define (wait-for condition)
  (let loop ((remaining 100000))
    (if (not (condition))
        (begin (check (> remaining 0) "schedule did not reach barrier")
               (h-park "yield") (loop (- remaining 1))))))
(define (receive-with scan timeout-proc ms)
  (let ((selected (kernel "rt-receive" scan timeout-proc ms)))
    (bl-invoke (bl-nth selected 1) '())))
(define (accept thunk) (bl-make-vec (bl-key "match") thunk))
(define (anything msg) (accept (lambda () msg)))
(define (unexpected) (error "unexpected timeout"))
(define (arm) (if lab-candidate? "queue" "vector"))
(define (micros) (* 1000000.0 (real-time)))
(define (allocated) (f64vector-ref (##process-statistics) 7))
(define (live-bytes) (##gc) (inexact->exact (f64vector-ref (##process-statistics) 17)))
(define (elapsed t) (inexact->exact (round (- (micros) t))))
(define (spawn f) (kernel "rt-spawn" f (bl-vec '())))
(define (run-actors entry)
  (kernel "bl-main" entry)
  (if (pair? seed-errors) (begin (write seed-errors) (newline) (error "actor failed")))
  (check (= 0 (h-map-size (field seed-state "procs"))) "live processes after drain")
  (check (= 0 (h-vec-size (field seed-state "runnable"))) "runnable entry after drain")
  (check (= 0 seed-critical) "unbalanced critical section"))

(define (bench n trial)
  (let ((probes 0) (peer-done #f) (turns 0) (max-gap 0) (orders (make-vector n)))
    (run-actors
     (lambda ()
       (let ((pid (h-self)) (start (micros)))
         (let fill ((i 0))
           (if (< i n) (begin (kernel "rt-send" pid i) (fill (+ i 1)))))
         (let ((enqueue-us (elapsed start)))
           (spawn (lambda ()
             (let pulse ((last (micros)))
               (if (not peer-done)
                   (begin (set! turns (+ turns 1)) (h-park "yield")
                          (set! max-gap (max max-gap (elapsed last))) (pulse (micros)))))))
           (wait-for (lambda () (> turns 0)))
           (set! lab-heads 0) (set! lab-transfers 0) (set! lab-base-slots 0)
           (let ((bytes (allocated)) (t (micros)))
             (let drain ((i 0))
               (if (< i n)
                   (let ((x (receive-with (lambda (m) (set! probes (+ probes 1)) (anything m))
                                          unexpected 0)))
                     (vector-set! orders i x) (drain (+ i 1)))))
             (let ((drain-us (elapsed t)) (alloc (inexact->exact (- (allocated) bytes))))
               (set! peer-done #t)
               (let verify ((i 0))
                 (if (< i n) (begin (check (= (vector-ref orders i) i) "FIFO order") (verify (+ i 1)))))
               (check (= probes n) "unexpected head-probe count")
               (check (= 0 (lab-size (mail pid))) "mailbox after drain")
               (check (if lab-candidate? (= lab-heads lab-transfers n)
                          (= lab-base-slots (quotient (* n (+ n 1)) 2))) "removal cost")
               (report "drain" (arm) n trial enqueue-us drain-us alloc probes lab-base-slots
                       lab-heads lab-transfers turns max-gap)))))))))

(define (selective n)
  (run-actors
   (lambda ()
     (let ((pid (h-self)) (probes 0) (mid (quotient n 2)))
       (let fill ((i 0))
         (if (< i n) (begin (kernel "rt-send" pid i) (fill (+ i 1)))))
       (set! lab-interior 0)
       (let* ((snapshot (mail pid)) (start (micros))
              (got (receive-with (lambda (m) (set! probes (+ probes 1))
                                  (if (= m mid) (anything m) (bl-key "nomatch"))) unexpected 0))
              (us (elapsed start)) (q (mail pid)))
         (check (= got mid) "middle selection")
         (check (= probes (+ 1 mid)) "unmatched prefix rescanned")
         (check (= (- n 1) (lab-size q)) "middle residual length")
         (let verify ((i 0))
           (if (< i n)
               (begin (check (= i (lab-ref snapshot i)) "old snapshot order")
                      (if (not (= i mid)) (check (= i (lab-ref q (if (< i mid) i (- i 1)))) "residual order"))
                      (verify (+ 1 i)))))
         (report "middle" (arm) n probes lab-interior us))))))

(define pinned-snapshot #f)
(define payloads (make-table weak-values: #t))
(define payload-count 16)
(define payload-size 32768)
(define (payload i)
  (let ((v (make-u8vector payload-size i))) (table-set! payloads i v) v))
(define (reachable)
  (let loop ((i 0) (n 0))
    (if (= i payload-count) n (loop (+ i 1) (+ n (if (table-ref payloads i #f) 1 0))))))
(define preview (bl-key "preview"))
(define cancel (bl-key "cancel"))
(define noise (bl-key "noise"))
(define (policy revision visit)
  (lambda (m)
    (visit m)
    (if (or (eq? m cancel) (and (eq? revision 'B) (eq? m preview)))
        (accept (lambda () (cons revision m)))
        (bl-key "nomatch"))))
(define (binding) (native-global-exact "lab" "receive-policy"))
(define (publish f) (native-intern "lab" "receive-policy" f))
(define (parked? p) (eq? (field (process-of p) "status") (bl-key "waiting")))

(define (collision mode)
  (let ((seen '()) (chosen #f) (fresh #f) (deadline #f) (terminal 0) (expired #f)
        (old-deadline #f) (late-ignored #f))
    (define (visit m) (if (symbol? m) (set! seen (cons m seen))))
    (publish (policy 'A visit))
    (run-actors
     (lambda ()
       (let ((actor
              (spawn (lambda ()
                (let* ((a (binding))
                       (scan (if (eq? mode 'latest) (lambda (m) ((binding) m)) a))
                       (selected (receive-with scan (lambda () (set! expired (h-now)) 'timeout) 25)))
                  (set! terminal (+ 1 terminal))
                  (if (pair? selected)
                      (begin
                        (set! chosen selected)
                        (set! fresh (receive-with (binding) unexpected 0))
                        (let drain ((i 0))
                          (if (< i payload-count)
                              (let ((v (receive-with anything unexpected 0)))
                                (check (and (= (u8vector-length v) payload-size)
                                            (= (u8vector-ref v 0) i)) "B drain order")
                                (drain (+ i 1))))))
                      (check (eq? selected 'timeout) "unexpected outcome")))))))
         (wait-for (lambda () (parked? actor)))
         (set! old-deadline (field (process-of actor) "wait"))
         (publish (policy 'B visit))
         (cond
           ((eq? mode 'retire)
            (kernel "rt-monitor" actor)
            (kernel "rt-exit" actor (bl-key "kill"))
            (set! late-ignored (and (bl-is-nil (process-of actor))
                                   (bl-is-nil (kernel "rt-deliver-quiet" actor cancel)))))
           ((eq? mode 'timeout)
            (kernel "rt-send" actor noise)
            (wait-for (lambda () (and (pair? seen) (parked? actor))))
            (set! deadline (field (process-of actor) "wait")))
           (else
            (h-critical-enter)
            (kernel "rt-send" actor preview) (kernel "rt-send" actor cancel)
            (let enqueue ((i 0))
              (if (< i payload-count) (begin (kernel "rt-send" actor (payload i)) (enqueue (+ i 1)))))
            (set! pinned-snapshot (mail actor))
            (h-critical-leave))))))
    (cond
      ((eq? mode 'retire)
       (check (and (= terminal 0) late-ignored) "late completion after cancellation")
       (report "retired" (arm) terminal))
      ((eq? mode 'timeout)
       (check (and (= terminal 1) (= expired old-deadline deadline) (equal? seen (list noise)))
              "wake must retain cursor and deadline")
       (report "timeout" (arm) old-deadline deadline expired (length seen)))
      (else
       (let* ((latest? (eq? mode 'latest)) (first (if latest? preview cancel))
              (left (if latest? cancel preview)) (held (live-bytes)) (before (reachable)))
         (check (and (= terminal 1) (eq? (car chosen) (if latest? 'B 'A)) (eq? (cdr chosen) first)
                     (eq? (car fresh) 'B) (eq? (cdr fresh) left)) "wrong revision or residue")
         (check (and (= (lab-size pinned-snapshot) (+ payload-count 2))
                     (eq? preview (lab-ref pinned-snapshot 0)) (eq? cancel (lab-ref pinned-snapshot 1)))
                "retained snapshot mutated")
         (check (= before payload-count) "snapshot lost payload")
         (set! pinned-snapshot #f)
         (let ((released (live-bytes)))
           (check (= 0 (reachable)) "payload remains reachable after release")
           (report "revision" (arm) mode (car chosen) (cdr chosen) (car fresh) (cdr fresh)
                   before (reachable) held released)))))))
