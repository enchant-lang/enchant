(load (getenv "BOOT_OBSERVATIONS"))
(with-exception-catcher
 (lambda (e) (display-exception e (current-error-port)) (exit 1))
 (lambda ()
  (load (getenv "BOOT_TRANSPORT"))
  (let* ((paths (file-in (getenv "BOOT_PATHS")))
         (readers (list native-read-file boot-copy-read-file boot-block-read-file boot-bulk-read-file))
         (names '("image" "copy" "blocks" "bulk"))
         (parse (pick "read-string")))
    (for-each (lambda (path)
                (let ((ref (native-read-file path)))
                 (for-each (lambda (f) (if (not (equal? (f path) ref)) (error "text differs" path))) readers))) paths)
    (do ((i 0 (+ i 1))) ((= i 4))
      (do ((j 0 (+ j 1))) ((= j 4))
       (let* ((k (modulo (+ i j) 4)) (reader (list-ref readers k)) (name (list-ref names k)))
         (out "IO" i name (timed (lambda () (for-each reader paths))))
         (out "JOB" i name (timed (lambda () (for-each (lambda (p) (invoke parse (reader p) p)) paths)))))))
    (exit 0))))
