(load (getenv "BOOT_OBSERVATIONS"))
(define (probe name f)
 (let ((result (with-exception-catcher
                (lambda (e) (list (bl-key "error")
                                 (call-with-output-string "" (lambda (p) (display-exception e p)))))
                (lambda () (list (bl-key "ok") (f))))))
   (call-with-output-file (string-append (getenv "BOOT_OUT") "/native-" name ".wire")
                          (lambda (p) (wire result p)))))
(define (provider)
 (bl-vec (list (bl-map (bl-key "namespace") (bl-make-tuple (bl-key "symbol") "demo")
                       (bl-key "revision") (bl-make-tuple (bl-key "symbol") "current")
                       (bl-key "file") "demo.bl" (bl-key "source") "(ns demo) (defn identity-x [x] x)"))))
(define (call ns name . xs) (bl-invoke (native-global-exact ns name) xs))
(with-exception-catcher
 (lambda (e) (display-exception e (current-error-port)) (exit 1))
 (lambda ()
  (invoke (native-global-exact "native.bootstrap" "install-source-macros!")
          (native-eval-string (native-read-file (getenv "BOOT_BUNDLE"))))
  (for-each (lambda (row) (load (cadr row)) (native-declare-ns (car row)))
            (file-in (getenv "BOOT_OBJECTS")))
  (probe "syntax" (lambda () (call "syntax" "identifier?" bl-nil)))
  (probe "binding" (lambda () (call "binding" "check-name!" (bl-make-tuple (bl-key "symbol") "α"))))
  (probe "expand-source" (lambda () (bl-get (call "expand-source" "catalog" (provider)) (bl-key "kind"))))
  (probe "expand" (lambda () (bl-get (call "expand" "phase-library" (provider)) (bl-key "kind"))))
  (probe "lower-core" (lambda () (call "lower-core" "call" (bl-key "erlang") (bl-key "self") '())))
  (probe "lower" (lambda () (call "lower" "catom" (bl-key "ok"))))
  (probe "optimize" (lambda () (call "optimize" "version")))
  (exit 0)))
