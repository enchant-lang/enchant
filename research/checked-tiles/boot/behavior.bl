(ns boot.behavior (:require [syntax :as s] [binding :as b] [expand-source :as es]
                           [expand :as ex] [lower-core :as lc] [lower :as lo]
                           [optimize :as opt] [boot.witness :as w]))
(let [[out] (clojure.io/current-command-line-args)
      sources [{:namespace (tuple :symbol "demo") :revision (tuple :symbol "current")
                :file "demo.bl" :source "(ns demo) (defn identity-x [x] x)"}]
      cases {"syntax" (fn [] (s/identifier? nil))
             "binding" (fn [] (b/check-name! (tuple :symbol "α")))
             "expand-source" (fn [] (:kind (es/catalog sources)))
             "expand" (fn [] (:kind (ex/phase-library sources)))
             "lower-core" (fn [] (lc/call :erlang :self (list)))
             "lower" (fn [] (lo/catom :ok))
             "optimize" (fn [] (opt/version))}]
  (doseq [[name f] cases]
    (let [result (try (list :ok (f)) (catch e (list :error (ex-message e))))]
      (File/write! (str out "/beam-" name ".wire") (erlang/iolist_to_binary (w/wire result))))))
