(ns reuse.request
 (:require [reader] [reader-node :as rn] [codebase :as code] [datom] [datom.file :as file]
           [native.fragments :as fragments] [reuse.sdk :as sdk] [clojure.string :as string]))

(defn sha [bytes] (file/sha-hex (file/sha256 bytes)))
(defn session [dir]
 {:cache (fragments/open dir)
  :tool (System/fetch_env! "BL_REPEAT_TOOL")
  :lab (System/fetch_env! "BL_REPEAT_LAB")
  :qualified (get (Jason/decode! (File/read! "research/checked-tiles/evidence/boot-self-hosted-fields.json")) "jobs")})
(defn- require! [value why]
 (when-not value (throw (ex-info (str "Repeat compile: " why) {:kind :unsupported-repeat-input}))))
(defn- symbol-name [form]
 (let [node (rn/node-form form)] (when (= :symbol (rn/node-tag node)) (rn/node-name node))))
(defn- items [form kind]
 (let [node (rn/node-form form)] (when (= kind (rn/node-tag node)) (rn/node-items node))))
(def def-name (Regex/compile! "^p-[a-z][a-z0-9-]*$"))
(def arg-name (Regex/compile! "^x-[a-z][a-z0-9-]*$"))
(def primitives #{"erlang/+" "erlang/-" "erlang/*"})
(defn- matches? [pattern s] (and (string? s) (Regex/match? pattern s)))
(defn- calls-in [form params]
 (loop [todo (list form) calls []]
  (if (empty? todo) calls
   (let [f (first todo) tail (rest todo) xs (items f :list)]
    (if (or (erlang/is_integer (rn/node-form f)) (contains? params (symbol-name f)))
     (recur tail calls)
     (let [callee (symbol-name (first xs)) args (rest xs) arity (count args)]
      (require! (or (matches? def-name callee) (and (contains? primitives callee) (= arity 2)))
                "expected integer, argument, arithmetic or local call")
      (recur (lists/append args tail) (if (contains? primitives callee) calls (conj calls [callee arity])))))))))

(defn- editable-rows [source label ns]
 ;; Finite edit profile. No user macros, reader tags, runtime initializers,
 ;; ambient calls, lexical shadows or namespace directives enter a certificate.
 (require! (and (Regex/match? (Regex/compile! "^repeat[.][a-z][a-z0-9-]*$") ns)
                (Regex/match? (Regex/compile! "\\A[a-z0-9./+*()\\[\\]\\- \\t\\n\\r]+\\z") source))
           "use the closed repeat.* profile or an exact qualified boot input")
 (let [forms (reader/read-string source label) header (items (first forms) :list)
       _ (require! (= ["ns" ns] (mapv symbol-name header)) "namespace")
       rows (mapv (fn [form]
              (let [xs (items form :list) name (symbol-name (second xs))
                    params (items (nth xs 2 nil) :vector) args (mapv symbol-name params)]
               (require! (and (= 4 (count xs)) (= "defn" (symbol-name (first xs))) (matches? def-name name)
                              (some? params) (= (count args) (count (set args))) (every? #(matches? arg-name %) args))
                         "expected a fixed-arity p-* definition with x-* arguments")
               {:name name :arity (count args) :digest (fragments/digest form)
                :calls (calls-in (nth xs 3) (set args))})) (rest forms))
       arities (Map/new (map #(tuple (:name %) (:arity %)) rows))]
  (require! (and (seq rows) (<= (count rows) 256) (= (count arities) (count rows))
                 (every? (fn [r] (every? (fn [[name arity]] (= arity (get arities name))) (:calls r))) rows))
            "unresolved, duplicate or wrong-arity definition")
  {:rows rows :forms forms}))

(defn dependency-rows [local-sites]
 ;; Multiplicity and arity are checked on the original Codebase output.
 ;; Reachability consumes only the two qualified endpoints of distinct edges.
 (map-indexed (fn [i endpoints] (assoc endpoints :db/id (+ 100000 i)))
              (distinct (map #(select-keys % [:call/caller-qualified :call/callee-qualified]) local-sites))))

(defn stored-graph [rows]
 (let [conn (code/connect-codebase)]
  (try
   (let [_ (when (seq rows) (datom/transact! conn rows))
         edges (datom/q '[:find ?from ?to :where [?e :call/caller-qualified ?from]
                             [?e :call/callee-qualified ?to]] (datom/db conn))]
    (Enum/reduce edges {} (fn [edge acc]
      (update acc (get edge 0) #(conj (or % #{}) (get edge 1))))))
   (finally (datom/close! conn)))))

(defn- index-calls [forms ns names sites expected work]
 ;; The header and all call kinds were checked before indexing these forms.
 (let [start (erlang/monotonic_time :microsecond)
       ;; Calls consult macro declarations. This profile admits a closed
       ;; environment, so every site in this index pass shares one snapshot.
       facts (BeamLisp.Loader/with_declaration_snapshot
              (fn [] (code/index-forms {} ns forms nil {:mode :calls})))
       facts-end (erlang/monotonic_time :microsecond)
       local-sites (remove #(contains? primitives (:call/callee %)) (:calls facts))
       _ (require! (and (= names (set (map :fn/qualified (:fn facts))))
                        (= sites (frequencies (map (fn [site] [(:call/caller site) (:call/callee site) (:call/arity site)]) local-sites)))
                        (every? :call/callee-qualified local-sites)) "Codebase call coverage")
       rows (vec (dependency-rows local-sites))
       storage-start (erlang/monotonic_time :microsecond)
       graph (stored-graph rows)
       storage-us (- (erlang/monotonic_time :microsecond) storage-start)]
  (require! (= graph expected) "Codebase dependency graph")
  (swap! work assoc :indexed-calls (count (:calls facts)) :stored-edges (count rows)
                    :codebase-us (- facts-end start) :datom-us storage-us)
  (Jason/encode! (Map/new (map (fn [[name deps]] (tuple name (Enum/sort (to-list deps)))) graph)))))

(defn- indexed-keys [s parsed label ns contract work]
 (let [rows (:rows parsed) qualify (fn [name] (str ns "/" name))
       bodies (Map/new (map #(tuple (qualify (:name %)) (:digest %)) rows))
       names (set (keys bodies))
       sites (frequencies (mapcat (fn [r] (map (fn [[name arity]] [(:name r) name arity]) (:calls r))) rows))
       expected (Map/new (keep (fn [r] (when (seq (:calls r))
                       (tuple (qualify (:name r)) (set (map #(qualify (first %)) (:calls r)))))) rows))
       graph-key (fragments/digest [:closed-call-graph (:tool s) ns (sort names) sites])
       graph (Jason/decode! (fragments/emit (:cache s) graph-key
              (fn [] (swap! work assoc :codebase "indexed") (index-calls (:forms parsed) ns names sites expected work))))
       memo (atom {})]
    ;; A target's recipe binds its dependencies recursively. Memoize one digest
    ;; per declaration, including shared leaves. Cycles take whole-unit compilation.
    (letfn [(visit [name active]
             (or (get @memo name)
              (if (contains? active name) :cycle
               (let [children (mapv #(visit % (conj active name)) (get graph name []))
                     key (if (some #(= :cycle %) children) :cycle
                           (fragments/digest [:definition contract label ns name (get bodies name) children]))]
                (swap! memo assoc name key) key))))]
     (mapv #(visit (qualify (:name %)) #{}) rows))))

(defn- native! [s source label ns order selected]
 (let [root (str (:lab s) "/" (erlang/unique_integer (list :positive)))
       chosen (if (= :all selected) "all" (str "(" (string/join " " selected) ")"))]
  (File/mkdir! root)
  (try
   (File/write! (str root "/source") source)
   (File/write! (str root "/selected") chosen)
   (let [env (list (tuple "BL_REPEAT_JOB" root) (tuple "BL_REPEAT_LABEL" label)
                   (tuple "BL_REPEAT_NS" ns) (tuple "BL_REPEAT_ORDER" order))
         result (System/cmd (str (:lab s) "/stage2") (list "--eval" (str (:lab s) "/translate.scm") "unused")
                  (list (tuple :env env) (tuple :stderr_to_stdout true)))]
    (when-not (= 0 (elem result 1)) (throw (ex-info (elem result 0) {:kind :native-repeat-compile})))
    (let [[amount micros] (String/split (String/trim (elem result 0)) " ")]
    {:count (String/to_integer amount) :native-us (String/to_integer micros)
     :text (if (= :all selected) (File/read! (str root "/result"))
             (mapv #(File/read! (str root "/" %)) selected))}))
   (finally (File/rm_rf! root)))))

(defn- edited [s source label ns order contract parsed work]
 (swap! work assoc :codebase "reused")
 (let [rows (:rows parsed) keys (indexed-keys s parsed label ns contract work) cache (:cache s)]
  (if (some #(= :cycle %) keys)
   (let [r (native! s source label ns order :all)]
    (swap! work assoc :route "cycle" :compiled (:count r)) (:text r))
   (let [cached (mapv #(fragments/lookup cache %) keys)
         miss (vec (filter #(nil? (nth cached %)) (range (count rows))))
         fresh (when (seq miss) (:text (native! s source label ns order miss)))
         by-index (Map/new (map (fn [i text] (tuple i text)) miss fresh))]
    (swap! work assoc :route "definitions" :compiled (count miss) :names (mapv #(:name (nth rows %)) miss))
    (string/join "\n" (map-indexed
     (fn [i key] (or (nth cached i) (fragments/emit cache key #(get by-index i)))) keys))))))

(defn compile-file! [s path label ns output clean? order]
 (let [start (erlang/monotonic_time :microsecond)
       source (File/read! path) digest (sha source) cache (:cache s)
       boot (get (:qualified s) ns)
       trusted (and (= digest (get boot "source")) (= label (str "priv/boot/" ns ".bl")))
       contract [(:tool s) order]
       key (fragments/digest [:translation contract ns label digest])
       work (atom {:route "artifact" :compiled 0})
       _ (when (= "sdk" order) (require! trusted "SDK control requires an exact boot source"))
       render (fn []
        (let [rows (when-not trusted
                    (let [begin (erlang/monotonic_time :microsecond) parsed (editable-rows source label ns)]
                     (swap! work assoc :admit-us (- (erlang/monotonic_time :microsecond) begin)) parsed))]
         (if (or clean? trusted)
          (let [r (if (= "sdk" order) (sdk/translate source label ns) (native! s source label ns order :all))
                text (:text r)]
           (when trusted (require! (= (get boot "output") (sha text)) "qualified bytes differ"))
           (swap! work assoc :route "full" :compiled (:count r) :native-us (:native-us r)) text)
          (edited s source label ns order contract rows work))))
       bytes (if clean? (render) (fragments/emit cache key render))
       temporary (str output ".writing-" (System/pid) "-" (erlang/unique_integer (list :positive)))]
  (try (File/write! temporary bytes) (File/rename! temporary output) (finally (File/rm temporary)))
  (let [checksum (sha bytes)]
   (assoc @work :sha256 checksum :us (- (erlang/monotonic_time :microsecond) start) :bytes (erlang/byte_size bytes)))))
