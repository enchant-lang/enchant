(ns reuse.driver (:require [reuse.request :as request]))
(let [[cache instructions] (BeamLisp/argv) s (request/session cache)]
 (doseq [job (Jason/decode! (File/read! instructions))]
  (let [[name path label ns output clean order] job
        result (request/compile-file! s path label ns output clean order)]
   (println (str "COMPILED " (Jason/encode! (assoc result :job name :sha256 (request/sha (File/read! output)))))))))
