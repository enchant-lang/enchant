(ns reuse.sdk
 (:require [reader] [reader-node :as rn] [compiler :as compiler] [native.eval :as ev]
           [native.scheme :as scheme] [clojure.string :as string]))
(defn translate [source label ns]
 (BeamLisp.Loader/with_declaration_snapshot (fn []
  (let [forms (reader/read-string source label) options (ev/context ns)
        definitions (filter #(contains? #{"def" "defn" "defn-"} (ev/head-symbol %)) (rest forms))
        emit (fn [form]
              (let [env (assoc (compiler/new-env ns) :file label)
                    value (:value-form (compiler/declaration-source form env))
                    pos (rn/node-pos form)]
               (compiler/reset-fresh!)
               (scheme/emit (compiler/compile (if pos (rn/meta-node value pos) value) (assoc env :target :js)) options)))]
   {:count (count definitions) :text (string/join "\n" (map emit definitions))}))))
