;; All reader and compiler calls here go to the retained AOT image. The witness
;; encoder observes their results outside the measurement interval.
(define (pick name) (native-global-exact "reader" name))
(define (invoke f . xs) (bl-invoke f xs))
(define (out . xs) (for-each (lambda (x) (display x) (display "\t")) xs) (newline) (force-output))
(define (file-in s) (call-with-input-file s read))
(define (wire x p)
 (define (field tag s) (display tag p) (display (u8vector-length (string->utf8 s)) p) (display ":" p) (display s p))
 (define (seq tag xs) (display tag p) (display (length xs) p) (display ":" p) (for-each (lambda (v) (wire v p)) xs))
 (cond ((eq? x bl-nil) (field "A" "nil")) ((eq? x #t) (field "A" "true")) ((eq? x #f) (field "A" "false"))
       ((symbol? x) (let ((s (symbol->string x))) (if (or (= 0 (string-length s)) (not (char=? #\: (string-ref s 0)))) (error "unexpected atom" x))
                    (field "A" (substring s 1 (string-length s)))))
       ((bl-tag? x 'float) (wire (vector-ref x 1) p))
       ((string? x) (field "S" x)) ((and (number? x) (exact? x) (integer? x)) (field "I" (number->string x)))
       ((and (number? x) (inexact? x)) (let ((q (inexact->exact x))) (seq "F" (list (numerator q) (denominator q)))))
       ((or (pair? x) (null? x)) (seq "L" x)) ((bl-tag? x 'tuple) (seq "T" (vector->list (vector-ref x 1))))
       ((bl-tag? x 'vec) (seq "V" (bl-items x))) ((bl-tag? x 'map) (seq "M" (native-map-pairs x)))
       (else (error "unsupported reader witness" x))))
(define (stream-view source label)
 (let ((next (pick "read-next-string")))
  (let loop ((st (invoke (pick "stream") source label)) (rows '()))
   (let ((r (bl-items (invoke next st))))
    (if (eq? (car r) (bl-key "ok"))
      (loop (cadddr r) (cons (list (cadr r) (caddr r)) rows))
      (list (reverse rows) (bl-get (cadr r) (bl-key "pos"))))))))
(define (observed mode src label)
 (with-exception-catcher
  (lambda (e) (list (bl-key "error") (native-exception-reason e)))
  (lambda () (list (bl-key "ok")
    (cond ((string=? mode "syntax") (invoke (pick "read-syntax") src label))
          ((string=? mode "stream") (stream-view src label))
          (else (invoke (pick "read-string") src label)))))))
(define clock-data (make-u64vector 3 0))
(##get-monotonic-time-frequency! clock-data 0)
(define (clock) (##get-monotonic-time! clock-data 1) (/ (u64vector-ref clock-data 1) (u64vector-ref clock-data 0)))
(define (timed thunk)
 (let ((before (clock))) (thunk) (exact->inexact (* 1000000 (- (clock) before)))))
(define (one root row)
 (let* ((id (car row)) (mode (cadr row)) (path (caddr row)) (label (list-ref row 3)) (reps (list-ref row 4))
        (src (native-read-file path)) (action (lambda () (observed mode src label))) (answer (action)))
   (call-with-output-file (string-append root "/native-" id ".wire") (lambda (p) (wire answer p)))
   (out "RESULT" id (car answer))
   (let loop ((i 0))
     (if (< i reps) (begin (out "PARSE" id (timed action)) (loop (+ i 1)))))
   (if (and (string=? mode "read") (> reps 1))
     (let ((arms (list (cons "original" native-read-file) (cons "bulk" boot-bulk-read-file) (cons "blocks" boot-block-read-file))))
       (for-each (lambda (arm) (if (not (equal? src ((cdr arm) path))) (error "input changed" path))) arms)
       (let loop ((i 0) (order arms))
         (if (< i reps)
           (begin (for-each (lambda (arm)
                     (out "IO" id (car arm) (timed (lambda () ((cdr arm) path))))
                     (out "TOTAL" id (car arm) (timed (lambda () (observed mode ((cdr arm) path) label))))) order)
                  (loop (+ i 1) (append (cdr order) (list (car order)))))))))))
(with-exception-catcher
 (lambda (e) (display-exception e (current-error-port)) (exit 1))
 (lambda ()
  (let ((root (getenv "BOOT_OUT")))
   (load (getenv "BOOT_TRANSPORT"))
   (for-each (lambda (row) (one root row)) (file-in (string-append root "/jobs.scm")))
   (exit 0))))
