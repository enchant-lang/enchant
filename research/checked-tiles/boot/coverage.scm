(define (coverage-probe root phase)
 (for-each
  (lambda (row)
    (let* ((ns (car row)) (name (cadr row)) (key (string-append ns "/" name))
           (sealed (bl-get native-global-registry key native-missing))
           (live (native-fetch-value ns name #t)))
      (display phase) (display "\t") (display key) (display "\t")
      (display (cond ((not (eq? native-missing sealed)) "image")
                     ((eq? native-missing live) "missing")
                     (else "environment"))) (newline)))
  (call-with-input-file (string-append root "/names.scm") read)))
(with-exception-catcher
 (lambda (e) (display-exception e (current-error-port)) (exit 1))
 (lambda ()
   (let ((root (getenv "BOOT_OUT")))
     (coverage-probe root "before")
     (bl-invoke (native-global-exact "native.bootstrap" "install-source-macros!")
                (list (native-eval-string (native-read-file (getenv "BOOT_BUNDLE")))))
     (coverage-probe root "prepared")
     (exit 0))))
