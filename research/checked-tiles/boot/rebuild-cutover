#!/usr/bin/env bash
# Run from the checkout root. Give this rehearsal fresh, ignored directories.
set -euo pipefail
if [ "$#" -ne 2 ]; then
  echo 'usage: rebuild-cutover CLOSURE_NAME BUILD_NAME (relative to research/native-seed/out)' >&2
  exit 2
fi
seed=research/native-seed
closure=$seed/out/$1
build=$seed/out/$2
baseline=$seed/out/checked-fields-build
boot=research/checked-tiles/boot
test ! -e "$build"
export ELIXIR_ERL_OPTIONS='+S 2:2 +SDcpu 1:1 +SDio 1'
python3 "$seed/snapshot-closure.py" "$seed/out/checked-fields-closure" "$closure"
cp "$seed/out/checked-fields-closure/link-rows.etf" "$closure/"
"$seed/speed/final/closure-r3.sh" "$closure"
mkdir "$build"
cp "$closure/identity.json" "$closure/partition.json" "$build/"
# A new generation owns its cache. Reusing its contents still goes through
# the verifier's per-object and per-link identities.
cp -a --reflink=auto "$baseline/native-unit-cache" "$build/"
python3 "$seed/prepare-host.py" --out "$build"
"$seed/speed/final/emit.sh" "out/$1" "out/$2"
"$boot/verify-native-build" "$build" "$build/actor-check" \
  .local/native-speed-integration/wave1-compiled-actors/javascript-corpus-fixed/manifest.json
