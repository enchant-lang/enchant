(load (getenv "BOOT_OBSERVATIONS"))
(with-exception-catcher
 (lambda (e) (display-exception e (current-error-port)) (exit 1))
 (lambda ()
   (load (getenv "BOOT_REGION"))
   (let* ((session (getenv "BOOT_BASE")) (outdir (getenv "BOOT_OUT"))
          (rows (file-in (string-append session "/jobs.scm")))
          (boot (file-in (string-append outdir "/boot.scm")))
          (inputs (map (lambda (row) (list (native-read-file (car row)) (cadr row))) boot))
          (rd (pick "read-string")))
     (region-mode! "both")
     (for-each (lambda (row)
       (let ((answer (observed (cadr row) (native-read-file (caddr row)) (list-ref row 3))))
         (call-with-output-file (string-append outdir "/" (car row) ".wire") (lambda (p) (wire answer p))))) rows)
     ;; Count entry uses separately so the timing pays no counter increments.
     (let ((tokens 0) (skips 0) (empty-skips 0))
       (##global-var-set! token-slot (lambda (xs pipe?) (set! tokens (+ tokens 1)) (old-token xs pipe?)))
       (##global-var-set! skip-slot (lambda (xs pos) (set! skips (+ skips 1))
          (if (and (pair? xs) (region-ascii? (car xs)) (= 1 (u8vector-ref ascii-no-trivia (car xs))))
              (set! empty-skips (+ empty-skips 1))) (old-skip xs pos)))
       (for-each (lambda (input) (apply invoke rd input)) inputs)
       (out "COUNTS" tokens skips empty-skips))
     (let loop ((i 0) (order '("stock" "token" "skip" "both")))
       (if (< i 4)
           (begin
             (for-each (lambda (mode)
               (region-mode! mode)
               (out "BOOT" i mode (timed (lambda () (for-each (lambda (input) (apply invoke rd input)) inputs))))) order)
             (loop (+ i 1) (append (cdr order) (list (car order)))))))
     (exit 0))))
