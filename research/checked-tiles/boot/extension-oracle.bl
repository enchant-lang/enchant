(ns boot.extension-oracle (:require [syntax :as syn] [boot.witness :as w]))
(let [[folder] (clojure.io/current-command-line-args)
      src "(hello é)" file "fixture.bl"
      ctx {:world "00000000000000000000000000000000" :namespace (tuple :symbol "boot.fixture")
           :space (tuple :symbol "value") :scopes {}}
      cases {"reader-read" (fn [] (BeamLisp.Reader/read_string src file))
             "reader-syntax" (fn [] (BeamLisp.Reader/read_syntax src file))
             "reader-bare" (fn [] (BeamLisp.Reader/read_all src))
             "reader-one" (fn [] (BeamLisp.Reader/read_one src))
             "reader-first" (fn [] (BeamLisp.Reader/read_first src file))
             "reader-invalid" (fn [] (BeamLisp.Reader/read_string "[}" file))
             "identifier-false" (fn [] (syn/identifier? nil))
             "context" (fn [] (syn/context ctx))
             "identifier" (fn [] (syn/identifier (tuple :symbol "hello") ctx))
             "read-context" (fn [] (syn/read src file ctx))}]
  (doseq [[name f] cases]
    (let [answer (try (list :ok (f)) (catch e (list :error (get e :__struct__) (ex-message e))))]
      (File/write! (str folder "/beam-" name ".wire") (erlang/iolist_to_binary (w/wire answer))))))
