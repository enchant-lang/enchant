(ns boot.registry (:require [reader :as r] [boot.witness :as w]))
(defn snapshot [out phase]
  (doseq [[name f] {"d" (fn [] (r/read-string "#d[:find ?x]" "tagged.bl"))
                    "time" (fn [] (r/read-string "#time\"2026-06-15\"" "tagged.bl"))}]
    (let [result (try (list :ok (f)) (catch e (list :error (or (get e :original) (ex-message e)))))]
      (File/write! (str out "/beam-" phase "-" name ".wire") (erlang/iolist_to_binary (w/wire result))))))
(let [[out] (clojure.io/current-command-line-args)]
  (snapshot out "ordinary")
  (data-reader! "time" (quote boot.fixture/other))
  (snapshot out "shadow"))
