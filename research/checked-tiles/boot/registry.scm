(load (getenv "BOOT_OBSERVATIONS"))
(define (snapshot phase)
 (for-each
  (lambda (name src)
   (let ((answer (observed "raw" src "tagged.bl")))
    (call-with-output-file (string-append (getenv "BOOT_OUT") "/native-" phase "-" name ".wire")
                           (lambda (p) (wire answer p)))))
  '("d" "time") '("#d[:find ?x]" "#time\"2026-06-15\"")))
(define (activate phase src path)
 (with-exception-catcher
  (lambda (e) (display phase) (display " error ") (write (native-exception-reason e)) (newline))
  (lambda () (invoke (native-global-exact "native.eval" "eval-string") src path)
             (display phase) (display " ok") (newline)))
 (snapshot phase))
(with-exception-catcher
 (lambda (e) (display-exception e (current-error-port)) (exit 1))
 (lambda ()
  (invoke (native-global-exact "native.bootstrap" "install-source-macros!")
          (native-eval-string (native-read-file (getenv "BOOT_BUNDLE"))))
  (snapshot "ordinary")
  (let ((path "priv/boot/data-readers.bl"))
   (activate "seed" (native-read-file path) path))
  (activate "shadow" "(data-reader! \"time\" (quote boot.fixture/other))" "shadow.bl")
  (exit 0)))
