;; The qualified native compiler compiles each unchanged Source declaration.
;; The generated module uses its ordinary environment and Scheme ABI.
(define (options ns module)
 (let ((ctx (bl-invoke (native-global-exact "native.eval" "context") (list ns))))
   (if (not module) ctx
     (let ((plan (bl-map (bl-key "module-of") (bl-map ns (bl-key module)))))
       (bl-assoc ctx (bl-key "aot-link")
         (bl-map (bl-key "remote")
           (lambda (node)
             (if (and (eq? (bl-get node (bl-key "mod")) (bl-key "erlang"))
                      (eq? (bl-get node (bl-key "fun")) (bl-key "fun_info")))
               (bl-invoke (native-global-exact "native.bootstrap" "remote-link") (list plan ns node))
               bl-nil))))))))
(define (run ns src path port module)
 (define (get n f) (native-global-exact n f))
 (define (call n f . xs) (bl-invoke (get n f) xs))
 (let* ((forms (call "reader" "read-string" src path))
        (env (bl-assoc (bl-assoc (call "compiler" "new-env" ns) (bl-key "file") path)
                       (bl-key "target") (bl-key "js"))))
  (call "native.eval" "eval-form" (car forms))
  (for-each
   (lambda (form)
    (let ((head (call "native.eval" "head-symbol" form)))
     (if (equal? head "declare")
       (call "native.eval" "eval-form" form)
       (begin
     (if (not (member head '("defn" "defn-" "def"))) (error "unhandled declaration" ns head))
     (let* ((decl (call "compiler" "declaration-source" form env))
            (name (call "reader-node" "node-name" (call "reader-node" "node-form" (bl-get decl (bl-key "name")))))
            (pos (call "reader-node" "node-pos" form))
            (value (bl-get decl (bl-key "value-form"))))
       (native-intern ns name bl-nil)
       (call "compiler" "reset-fresh!")
       (let* ((ir (call "compiler" "compile" (if (bl-truthy pos) (call "reader-node" "meta-node" value pos) value) env))
              (text (call "native.scheme" "emit" ir (options ns module))))
        (display "(native-intern " port) (write ns port) (display " " port) (write name port)
        (display " " port) (display text port) (display ")" port) (newline port)
        (display "EMIT\t") (display ns) (display "\t") (display name) (newline)))))))
   (cdr forms))))
(with-exception-catcher
 (lambda (e) (display-exception e (current-error-port)) (exit 1))
 (lambda ()
  (bl-invoke (native-global-exact "native.bootstrap" "install-source-macros!")
             (list (native-eval-string (native-read-file (getenv "BOOT_BUNDLE")))))
  (let ((root (getenv "BOOT_OUT")))
   (for-each (lambda (item)
               (let ((ns (car item)) (path (cadr item)))
                 (call-with-output-file (string-append root "/" ns ".scm")
                   (lambda (p) (run ns (native-read-file path) path p (and (pair? (cddr item)) (caddr item)))))))
             (call-with-input-file (string-append root "/modules.scm") read)))
  (exit 0)))
