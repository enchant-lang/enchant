;; Run on a fresh native image independently of throughput measurements.
(define (check x) (if (not x) (error "native symbol accounting changed")))
(define (refused thunk) (with-exception-catcher (lambda (e) #t) (lambda () (thunk) #f)))
(let ((count native-source-symbol-count) (bytes native-source-symbol-bytes)
      (calls native-reader-symbol-count) (s (string-copy "field-trial-β😀")))
 (native-atom-account s)
 (check (= (+ count 1) native-source-symbol-count))
 (check (= (+ bytes (native-utf8-size s)) native-source-symbol-bytes))
 (native-atom-account (string-copy s))
 (check (= (+ calls 2) native-reader-symbol-count))
 (check (= (+ count 1) native-source-symbol-count))
 ;; A caller's mutable Scheme buffer must not change the proven spelling.
 (string-set! s 0 #\x)
 (native-atom-account "field-trial-β😀")
 (check (= (+ count 1) native-source-symbol-count))
 (native-atom-account s)
 (check (= (+ count 2) native-source-symbol-count))
 ((native-leaf "Elixir.BeamLisp.AtomGuard/reset/0"))
 (check (= native-reader-symbol-count 0))
 (check (refused (lambda () (native-atom-account (make-string 1048577 #\a)))))
 (check (= native-reader-symbol-count 0))
 (set! native-source-symbol-limit native-source-symbol-count)
 (check (refused (lambda () (native-atom-account "field-over-limit"))))
 (check (= 1 native-reader-symbol-count))
 (check (refused (lambda () (native-atom-account "field-trial-β😀"))))
 (check (= 1 native-reader-symbol-count)))
(display "SYMBOL_BUDGET_OK") (newline)
(exit 0)
