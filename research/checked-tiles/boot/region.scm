;; Installed in a fresh measurement process. Both arity cells and their native
;; input layout are selected by the checked image digest in regions.py.
(define (region-slot name)
  (##make-global-var
    (string->symbol (string-append "v" (apply string-append
      (map (lambda (c) (string-append "_" (number->string (char->integer c)))) (string->list name))) "$2"))))
(define token-slot (region-slot "reader/token-length"))
(define skip-slot (region-slot "reader/skip-pos"))
(define old-token (##global-var-ref token-slot))
(define old-skip (##global-var-ref skip-slot))
(define ascii-no-pipe (make-u8vector 128))
(define ascii-pipe (make-u8vector 128))
(define ascii-no-trivia (make-u8vector 128))
(define (region-position? p)
  (and (bl-tag? p 'tuple) (vector? (vector-ref p 1)) (= 4 (vector-length (vector-ref p 1)))
       (fixnum? (vector-ref (vector-ref p 1) 0)) (fixnum? (vector-ref (vector-ref p 1) 1))
       (fixnum? (vector-ref (vector-ref p 1) 3))))
(define (region-ascii? c) (and (fixnum? c) (fx<= 0 c) (fx< c 128)))
(define (region-token xs pipe?)
  (if (or seed-frame (not (boolean? pipe?))) (old-token xs pipe?)
      (let ((table (if pipe? ascii-pipe ascii-no-pipe)))
        (let scan ((rest xs) (n 0))
          (cond ((null? rest) n)
                ((and (pair? rest) (region-ascii? (car rest)))
                 (if (fx= 0 (u8vector-ref table (car rest))) n
                     (scan (cdr rest) (+ n 1))))
                (else (old-token xs pipe?)))))))
(define (region-skip xs p)
  (if (and (not seed-frame) (region-position? p) (pair? xs) (region-ascii? (car xs))
           (fx= 1 (u8vector-ref ascii-no-trivia (car xs))))
      (vector 'tuple (vector xs p))
      (old-skip xs p)))
(define (region-mode! mode)
  (##global-var-set! token-slot (if (member mode '("token" "both")) region-token old-token))
  (##global-var-set! skip-slot (if (member mode '("skip" "both")) region-skip old-skip)))
;; Derive both tables by invoking the original compiled Enchant functions.
(let ((p (bl-make-tuple 2 7 "region.bl" 4)))
  (let loop ((i 0))
    (if (< i 128)
        (let* ((chars (list i)) (result (vector-ref (old-skip chars p) 1)))
          (u8vector-set! ascii-no-pipe i (old-token chars #f))
          (u8vector-set! ascii-pipe i (old-token chars #t))
          (u8vector-set! ascii-no-trivia i (if (and (eq? chars (vector-ref result 0))
                                                    (eq? p (vector-ref result 1))) 1 0))
          (loop (+ i 1))))))
