(with-exception-catcher
 (lambda (e) (display-exception e (current-error-port)) (exit 1))
 (lambda ()
  (load (getenv "BOOT_REGION"))
  (let ((p (bl-make-tuple 7 12 "position.bl" 26)) (checks 0))
   (define (same a b)
    (if (not (bl-equal? a b)) (error "specialized reader differs" a b))
    (set! checks (+ checks 1)))
   (do ((a 0 (+ a 1))) ((= a 128))
    (do ((b 0 (+ b 1))) ((= b 128))
     (let ((src (list a b 233 59 10 120)))
      (same (old-token src #t) (region-token src #t))
      (same (old-token src #f) (region-token src #f))
      (same (old-skip src p) (region-skip src p)))))
   (define (turns mode budget)
    (region-mode! mode)
    (let* ((answer #f) (reader (native-global-exact "reader" "read-string"))
           (frame (h-make-frames (lambda () (set! answer (bl-invoke reader (list ";hi\n(a b |c| é)" "actor.bl")))) '())))
     (let loop ((n 0))
      (let ((status (bl-get (h-run-turn frame budget) (bl-key "status"))))
       (cond ((eq? status (bl-key "done")) (list n answer))
             ((and (< n 50000) (eq? status (bl-key "yield"))) (loop (+ n 1)))
             (else (error "unexpected actor status" status)))))))
   (for-each (lambda (budget)
     (let ((a (turns "stock" budget)) (b (turns "both" budget)))
      (same a b) (if (< (car a) 1) (error "expected scheduler yields"))
      (display "YIELDS ") (write (list budget (car a))) (newline))) '(4 17 41))
   (display "CHECKS ") (display checks) (newline)
   (exit 0))))
