;; Inserted into the pinned timing fixture in place of its aggregated report.
;; Keep the physical module, function and arity. Public forwarding functions
;; and anonymous helpers otherwise get charged as additional BL invocations.
(defn report [phase action]
 (profile/call-time (fn [] nil))
 (erlang/apply :tprof :start (list {:type :call_count}))
 (try
  (erlang/apply :tprof :set_pattern (list :_ :_ :_))
  (pass action)
  (let [sample (erlang/apply :tprof :collect (list))
        inspected (erlang/apply :tprof :inspect (list sample :total :measurement))
        raw (erlang/element 3 (erlang/apply :maps :get (list :all inspected)))]
   (doseq [r raw]
    (let [m (erlang/element 1 r) fa (erlang/element 2 r)
          f (erlang/atom_to_binary (erlang/element 1 fa))]
     (when (contains? observed-fns f)
      (println (str "ENTRY\t" phase "\t" (erlang/atom_to_binary m) "\t" f
                    "\t" (erlang/element 2 fa) "\t" (erlang/element 3 r)))))))
  (finally (erlang/apply :tprof :stop (list)))))
