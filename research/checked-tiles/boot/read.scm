(define (call ns name . xs) (bl-invoke (native-global-exact ns name) xs))
(with-exception-catcher
 (lambda (e)
   (let* ((p (current-error-port)) (reason (native-exception-reason e))
          (message (and (bl-tag? reason 'map) (bl-get reason (bl-key "message") #f))))
     (if (string? message) (begin (display message p) (newline p)) (display-exception e p))
     (exit 1)))
 (lambda ()
  (call "native.bootstrap" "install-source-macros!" (native-eval-string (native-read-file (getenv "BOOT_BUNDLE"))))
  (for-each load (call-with-input-file (getenv "BOOT_OBJECTS") read))
  (load (getenv "BOOT_LINKS"))
  (let ((path "priv/boot/data-readers.bl") (before native-env-current))
    (call "native.eval" "eval-string" (native-read-file path) path)
    (set! native-env-current before))
  (let ((result (call "host.reader" (getenv "BOOT_METHOD") (native-read-file (getenv "BOOT_PROGRAM")) (getenv "BOOT_LABEL"))))
    (display (call "rt" "print_str" result)) (newline))
  (exit 0)))
