(define source "(hello é)")
(define (sym name) (bl-make-tuple (bl-key "symbol") name))
(define ctx (bl-map (bl-key "world") "00000000000000000000000000000000"
                    (bl-key "namespace") (sym "boot.fixture") (bl-key "space") (sym "value")
                    (bl-key "scopes") (bl-map)))
(define (arguments mode)
 (cond ((string=? mode "source") (list source "fixture.bl")) ((string=? mode "bare") (list source))
       ((string=? mode "invalid") (list "[}" "fixture.bl")) ((string=? mode "nil") (list bl-nil))
       ((string=? mode "context") (list ctx)) ((string=? mode "identifier") (list (sym "hello") ctx))
       (else (list source "fixture.bl" ctx))))
(define (one row)
 (let ((name (car row)))
  (with-exception-catcher
   (lambda (e)
     (display "ERROR\t") (display name) (display "\t")
     (let ((reason (native-exception-reason e)))
       (write (if (bl-tag? reason 'map)
                  (bl-get reason (bl-key "message") (bl-get reason (bl-key "msg") reason)) reason)))
     (newline))
   (lambda ()
    (let* ((fn (native-global-exact (cadr row) (caddr row)))
           (result (bl-invoke fn (arguments (list-ref row 3)))))
      (display "OK\t") (display name) (display "\t")
      (write (bl-invoke (native-global-exact "native.scheme" "literal") (list result))) (newline))))))
(with-exception-catcher
 (lambda (e) (display-exception e (current-error-port)) (exit 1))
 (lambda ()
  (let ((root (getenv "BOOT_OUT")))
   (bl-invoke (native-global-exact "native.bootstrap" "install-source-macros!")
              (list (native-eval-string (native-read-file (getenv "BOOT_BUNDLE")))))
   (for-each load (call-with-input-file (string-append root "/objects.scm") read))
   (for-each one (call-with-input-file (string-append root "/probes.scm") read))
   (exit 0))))
