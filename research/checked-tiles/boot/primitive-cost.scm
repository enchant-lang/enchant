;; Counterfactual for the historical ELF. Outside actors, try only these
;; closed scalar domains. Verification recomputes every admitted result with
;; the image's original procedure. Other values and invalid arguments delegate.
(define (primitive-cell name)
 (##make-global-var (string->symbol name)))
(define (primitive-encoded name)
 (string-append "v" (apply string-append (map (lambda (ch)
  (string-append "_" (number->string (char->integer ch)))) (string->list name)))))
(define primitive-decline (list 'declined))
(define primitive-specs
 (list
  (list "equal" (string-append (primitive-encoded "rt/eqv") "$2")
   (lambda (a b)
    (cond ((and (fixnum? a) (fixnum? b)) (fx= a b))
          ((and (symbol? a) (symbol? b) (not (uninterned-symbol? a)) (not (uninterned-symbol? b))) (eq? a b))
          ((and (string? a) (string? b)) (string=? a b))
          (else primitive-decline))))
  (list "key" (string-append (primitive-encoded "rt/hash_key") "$1")
   (lambda (x) (if (or (fixnum? x) (symbol? x) (string? x) (boolean? x) (eq? x bl-nil)) x primitive-decline)))
  (list "at" (string-append "l" (primitive-encoded "binary/at/2"))
   (lambda (s i) (if (and (string? s) (fixnum? i) (fx>= i 0) (fx< i (string-length s))
                          (= (native-utf8-size s) (string-length s)))
                    (char->integer (string-ref s i)) primitive-decline)))
  (list "part" (string-append "l" (primitive-encoded "binary/part/3"))
   (lambda (s i n)
    (if (and (string? s) (fixnum? i) (fixnum? n) (>= i 0) (>= n 0)
             (<= (+ i n) (string-length s)) (= (native-utf8-size s) (string-length s)))
        (substring s i (+ i n)) primitive-decline)))))
(define primitive-counts (make-table test: equal?))
(define (primitive-install! mode)
 (for-each
  (lambda (spec)
   (let* ((name (car spec)) (cell (primitive-cell (cadr spec))) (base (##global-var-ref cell))
          (fast (caddr spec)) (scalar (member name '("equal" "key"))))
    (if (not (procedure? base)) (error "missing retained primitive" name))
    (if (or (member mode '("both" "verify"))
            (and scalar (equal? mode "scalars")) (and (not scalar) (equal? mode "bytes")))
     (##global-var-set! cell
      (lambda args
       (let ((r (if seed-frame primitive-decline (apply fast args))))
        (cond ((eq? r primitive-decline) (apply base args))
              ((equal? mode "verify")
               (table-set! primitive-counts name (+ 1 (table-ref primitive-counts name 0)))
               (if (not (bl-equal? r (apply base args))) (error "wrong primitive result" name)) r)
              (else r))))))))
  primitive-specs))
(define (primitive-report!)
 (for-each (lambda (s) (display "FAST ") (display (car s)) (display " ")
                       (display (table-ref primitive-counts (car s) 0)) (newline)) primitive-specs))
