;; stage2 --eval compiler.scm bundle.scm. This Scheme bootstrap enters the
;; compiled BL reader, compiler and emitter and serves trusted local BL files.
(define bundle-path (caddr (native-command-line)))
(define (named ns name) (native-global-exact ns name))
(define (invoke ns name . args) (bl-invoke (named ns name) args))
(define (source text path) (invoke "native.eval" "eval-string" text path))
(define (emit-event . values)
  (display "LIVE")
  (for-each (lambda (x) (display " ") (display x)) values)
  (newline) (force-output))
(define base #f)
(define prepared #f)
(define roots (make-table))
(define weak-roots (make-table weak-values: #t))
(define edit-name "ora-film.grade")
(define holding? #f)
(define inside? #f)
(define (environment)
  (vector native-env-rows native-env-current native-module-names native-namespace-modules
          native-export-arities native-stub-names native-global-registry))
(define (restore env)
  (set! native-env-rows (vector-ref env 0)) (set! native-env-current (vector-ref env 1))
  (set! native-module-names (vector-ref env 2)) (set! native-namespace-modules (vector-ref env 3))
  (set! native-export-arities (vector-ref env 4)) (set! native-stub-names (vector-ref env 5))
  (set! native-global-registry (vector-ref env 6)))
(define (load-unit file)
  (source (native-read-file file) file))
(define (table-result tag)
  (let ((values (bl-items (invoke edit-name "channel-table"))))
    (if (not (and (= (length values) 256) (every-integer? values))) (error "invalid byte-domain result"))
    (apply emit-event "TABLE" tag values)))
(define (every-integer? xs)
  (or (null? xs) (and (exact-integer? (car xs)) (every-integer? (cdr xs)))))
(define (compile-revision id file entry cold?)
  (restore (if (or cold? (not prepared)) base prepared))
  (load-unit file)
  (let ((rebuild-entry (or cold? (not prepared))))
    (if rebuild-entry (load-unit entry))
    (let ((env (environment)))
      (if (not prepared) (set! prepared env))
      (table-set! roots id env) (table-set! weak-roots id env)
      (emit-event "DEFS" id (if rebuild-entry "mix-white,pixel,channel-table" "mix-white")
                  (if rebuild-entry "-" "pixel,channel-table"))
      (table-result id)))
  (restore base))
(define (run-command cmd)
  (case (car cmd)
    ((build clean hold)
     (let ((previous holding?))
       (set! holding? (eq? 'hold (car cmd)))
       (compile-revision (cadr cmd) (caddr cmd) (cadddr cmd) (eq? (car cmd) 'clean))
       (set! holding? previous)))
    ((observe)
     (restore (table-ref roots (cadr cmd))) (table-result (cadr cmd)) (restore base))
    ((drop)
     (let ((id (cadr cmd)))
       (if (not (table-ref roots id #f)) (error "unknown generation" id))
       (table-set! roots id)
       (##gc)
       (emit-event "DROPPED" id (if (table-ref weak-roots id #f) "held" "collected"))))
    (else (error "unknown native compiler command" cmd))))
(define (pump nested?)
  (let loop ()
    (let ((cmd (read)))
      (cond ((or (eof-object? cmd) (eq? (car cmd) 'stop))
             (if nested? (error "stopped with a suspended emission") (exit)))
            ((eq? (car cmd) 'resume)
             (if (not nested?) (error "no suspended emission")))
            (else (run-command cmd) (loop))))))
(with-exception-catcher
  (lambda (ex) (display-exception ex (current-error-port)) (exit 1))
  (lambda ()
    (invoke "native.bootstrap" "install-source-macros!" (native-eval-string (native-read-file bundle-path)))
    (source "(ns ora-film.grade)" "grade.bl")
    (let ((original (named "native.scheme" "ident")))
      (native-intern "native.scheme" "ident"
        (lambda (name)
          (if (and holding? (not inside?))
              (let ((pinned (environment)))
                (set! inside? #t) (emit-event "PARKED" "native.scheme/ident")
                (pump #t) (restore pinned) (set! holding? #f) (set! inside? #f)))
          (bl-invoke original (list name)))))
    (set! base (environment))
    (emit-event "READY")
    (pump #f)))
