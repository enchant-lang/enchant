(ns live-render.owner (:require [reload.generation :as g]))
(def slot (g/slot))
(def graphs (atom {}))
(def tickets (atom {}))
(def export "ora-film.grade/channel-table")
(defn dispatch [r]
 (let [id (get r "id") key (get r "ticket") graph (get @graphs id)]
  (case (get r "op")
    "prepare" (let [source (File/read! (get r "path"))
                    graph (g/prepare! {:application-id "ora-film.live-grade"
                                       :sources {"ora-film.grade" source}})]
                (swap! graphs assoc id graph)
                {:digest (:digest graph) :table (g/invoke! graph export [])})
    "publish" (g/publish! slot (get r "expected") graph)
    "select" {:digest (g/selected slot) :table (g/call! slot export [])}
    "pin" (let [registration (g/with-selected! slot g/capture!)]
            (swap! tickets assoc key registration)
            {:digest (:digest (:generation registration))})
    "observe" {:table (g/run! (get @tickets key) export [])}
    "release" (do (g/release! (get @tickets key)) (swap! tickets dissoc key) {:released key})
    "retire" (let [status (:status (g/retire! graph))]
               (when (= status :retired) (swap! graphs dissoc id))
               {:status status})
    "close" (g/close! slot (g/selected slot)))))
(defn response [value] (IO/puts (str "LIVE " (Jason/encode! value))))
(response {:ready true})
(loop []
 (let [line (IO/gets "")]
  (when (string? line)
   (response (try (dispatch (Jason/decode! line))
                  (catch e {:failure (Exception/message e)})))
   (recur))))
