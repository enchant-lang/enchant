; Run with the exact qualified SDK in a bounded job. No state mutations.
(ns execution-membership-benchmark)
(def module :bl_membership_benchmark_unowned_module)
(def expected (list))
(assert (= expected (BeamLisp.Env/execution_graph_members module)))
(defn measure [label action]
 (erlang/garbage_collect)
 (let [started (erlang/monotonic_time :microsecond)
       reductions (elem (erlang/process_info (erlang/self) :reductions) 1)]
  (dotimes [_ 1000] (assert (= expected (action))))
  (println "membership-lookup" {:kind label :iterations 1000
    :extent-rows (ets/info :beam_lisp_source_extent_heads :size)
    :microseconds (- (erlang/monotonic_time :microsecond) started)
    :reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) reductions)})))
(measure :legacy-scan (fn [] (ets/match_object :beam_lisp_source_extent_heads
 (tuple (tuple :execution_graph_member module :_) :_))))
(measure :module-index (fn [] (BeamLisp.Env/execution_graph_members module)))
