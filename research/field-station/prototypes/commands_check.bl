(ns station-prototype.commands-check
 (:require [station-prototype.deployment :as deployment]
           [station-prototype.checks :as checks] [bl.json :as json]))
(let [root (System/get_env "STATION_PROTOTYPE_STATE") path (str root "/commands-receipt.json")]
 (reset! checks/results [])
 (try
  (deployment/command-checks! root)
  (let [receipt {:format 1 :kind :field-station-native-command-prototype :status :passed
                 :passed (count @checks/results) :checks @checks/results
                 :scope "Actual bounded argv commands, demand stream and disposable Fjall observations."}]
   (File/write! path (json/encode receipt)) (println (json/encode receipt)))
  (catch error
   (let [receipt {:format 1 :kind :field-station-native-command-prototype :status :failed
                  :passed (count @checks/results) :checks @checks/results :reason (ex-message error)}]
    (File/write! path (json/encode receipt)) (println (json/encode receipt)))
   (throw error))))
