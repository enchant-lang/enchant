(ns station-prototype.foundry-check (:require [station-prototype.deployment :as deployment] [bl.json :as json]))
(let [source (System/get_env "STATION_PROTOTYPE_SOURCE") root (System/get_env "STATION_PROTOTYPE_STATE")
      receipt (deployment/run! source (str root "/foundry"))]
 (File/write! (str root "/foundry-receipt.json") (json/encode receipt))
 (println (json/encode receipt)))
