(ns station-prototype.foundry-check (:require [station-prototype.deployment :as deployment]
                                            [station-prototype.checks :as checks] [bl.json :as json]))
(let [source (System/get_env "STATION_PROTOTYPE_SOURCE") root (System/get_env "STATION_PROTOTYPE_STATE")
      path (str root "/foundry-receipt.json")]
 (try
  (let [receipt (assoc (deployment/run! source (str root "/foundry")) :status :passed)]
   (File/write! path (json/encode receipt)) (println (json/encode receipt)))
  (catch error
   (let [receipt {:format 1 :kind :field-station-foundry-prototype :status :failed
                  :passed (count @checks/results) :checks @checks/results :reason (ex-message error)}]
    (File/write! path (json/encode receipt)) (println (json/encode receipt)))
   (throw error))))
