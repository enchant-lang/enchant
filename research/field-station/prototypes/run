#!/usr/bin/env bash
set -euo pipefail
prototype_source=$(cd -- "$(dirname -- "$0")" && pwd)
enchant_source=$(cd -- "$prototype_source/../../.." && pwd)
prototype_action=${1:-core}
prototype_runtime=${STATION_PROTOTYPE_RUNTIME:-$enchant_source/bin/bl}
if [[ "$prototype_runtime" != "$enchant_source/bin/bl" ]]; then
  prototype_runtime=$(readlink -f "$prototype_runtime")
  prototype_sdk=$(dirname "$(dirname "$prototype_runtime")")
  [[ "$prototype_runtime" == /nix/store/*/bin/bl && -f "$prototype_sdk/artifact.json" ]] || {
    echo 'STATION_PROTOTYPE_RUNTIME must be a retained immutable SDK executable' >&2
    exit 2
  }
fi
if [[ "$prototype_action" != core && "$prototype_action" != foundry ]]; then
  echo 'Usage: ./run core|foundry' >&2
  exit 2
fi
mkdir -p "$HOME/tmp"
prototype_state=$(mktemp -d "$HOME/tmp/station-prototypes.XXXXXXXX")
chmod 700 "$prototype_state"
prototype_unit="station-prototypes-$(date +%s)-$$"
trap 'systemctl --user stop "$prototype_unit.service" >/dev/null 2>&1 || true' EXIT
echo "Prototype evidence: $prototype_state"
git -C "$enchant_source" rev-parse HEAD > "$prototype_state/source-revision"
if [[ -n "${prototype_sdk:-}" ]]; then
  cp "$prototype_sdk/artifact.json" "$prototype_state/runtime-artifact.json"
fi
cd "$enchant_source"
prototype_program="$prototype_source/check.bl"
prototype_paths=(-p "$prototype_source/src")
if [[ "$prototype_action" == foundry ]]; then
  foundry_source=${FOUNDRY_SOURCE:-/home/othman/code/undefine/foundry}
  foundry_revision=2ca41aa9199a54602606f026309e9e7ec925587d
  mkdir "$prototype_state/foundry-source"
  git -C "$foundry_source" archive "$foundry_revision" > "$prototype_state/foundry-source.tar"
  tar -xf "$prototype_state/foundry-source.tar" -C "$prototype_state/foundry-source"
  # Stable immutable paths let AOT reuse the same dependency compilation across
  # repeated sandbox runs. A fresh HOME temporary path would defeat that reuse.
  prototype_foundry_store=$(nix-store --add "$prototype_state/foundry-source")
  nix-store --add-root "$prototype_state/foundry-source-root" --indirect --realise "$prototype_foundry_store" >/dev/null
  printf '%s\n' "$prototype_foundry_store" > "$prototype_state/foundry-source-path"
  printf '%s\n' "$foundry_revision" > "$prototype_state/foundry-revision"
  sha256sum "$prototype_state/foundry-source.tar" > "$prototype_state/foundry-source.sha256"
  # The immutable source and GC root are the evidence; discard duplicate staging.
  rm -r -- "$prototype_state/foundry-source" "$prototype_state/foundry-source.tar"
  for directory in src src/foundry/engine src/foundry/operations src/foundry/release src/foundry/host src/foundry/providers src/foundry/credentials src/foundry/interfaces src/foundry/support; do
    prototype_paths+=(-p "$prototype_foundry_store/$directory")
  done
  prototype_program="$prototype_source/foundry_check.bl"
fi
printf 'CHECK service=messages stage=load runtime=%s action=%s\n' "$prototype_runtime" "$prototype_action"
systemd-run --user --quiet --collect --wait --pipe --unit="$prototype_unit" \
  --working-directory="$enchant_source" \
  --property=MemoryMax=3G --property=MemorySwapMax=512M \
  --property=RuntimeMaxSec=900 --property=TimeoutStopSec=15 \
  --setenv="STATION_PROTOTYPE_SOURCE=$prototype_source" \
  --setenv="STATION_PROTOTYPE_STATE=$prototype_state" \
  --setenv="STATION_PROTOTYPE_DIAGNOSTICS=${STATION_PROTOTYPE_DIAGNOSTICS:-0}" \
  "$prototype_runtime" --cold "${prototype_paths[@]}" run "$prototype_program" \
  2>&1 | tee "$prototype_state/$prototype_action.log"
