;; Sealed application factory. Its mirror is borrowed from the stable owner.
(ns field-station.live
 (:require [datom :as d] [reload.generation :as g] [web]))
(defn initialize! [options]
 (let [conn (:messages options)]
  (when-not (get (d/schema conn) :prototype/message)
   (d/install-schema! conn [{:db/ident :prototype/message :db/valueType :db.type/string}]))
  (g/bind-runtime! {:prototype/messages conn})))
(defn app []
 (let [conn (g/runtime-resource :prototype/messages)]
  {:principal (fn [_] "prototype")
   :worlds (fn [_ _] {:messages (d/db conn)})
   :shared-conn conn
   :routes [["/" (fn [_] [:main [:h1 "Field Station"] [:p "prototype-old"]])]]
   :http (fn [request path]
           (when (= path "/health/ready")
            (web/json request 200 {:status "ready" :version "prototype-old"
                                   :generation (:digest (g/current))
                                   :messages (count (d/q '[:find ?e :where [?e :prototype/message _]] (d/db conn)))})))}))
