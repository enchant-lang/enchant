(ns station-prototype.deployment
 (:require [station-prototype.release :as release] [station-prototype.checks :as checks]
           [foundry.upgrade.lifecycle :as lifecycle] [foundry.upgrade.application :as application]
           [foundry.upgrade.admission :as admission]
           [foundry.upgrade.bootstrap :as bootstrap]
           [foundry.definition :as definition]
           [deployment-exec :as command] [proc.flow :as flow]
           [datom :as d] [datom.conn :as conn] [reload.generation :as generation]
           [auth] [reload] [bl.json :as json]))
(def observed (atom nil))
(defn get! [port]
 (Application/ensure_all_started :inets)
 (let [response (httpc/request :get
                 (tuple (String/to_charlist (str "http://127.0.0.1:" port "/health/ready")) (list))
                 (list (tuple :timeout 3000) (tuple :connect_timeout 1000))
                 (list (tuple :body_format :binary)))]
  (when-not (and (= :ok (elem response 0)) (= 200 (elem (elem (elem response 1) 0) 1)))
   (throw (ex-info "Prototype readiness request failed" {})))
  (json/decode (elem (elem response 1) 2))))
(defn observe! [status seen]
 (let [operation (or (last (:operations status)) (:preparation status))
       public (merge (select-keys operation ["state" "phase" "substep" "candidate" "generation" "error"])
                (when-let [drain (when (= "drain" (get operation "phase")) (get operation "drain"))]
                 {"drain" (select-keys drain ["jobs" "leases" "producers" "retainedHandlers"])})
                {"service" "messages" "owner" (str (:owner status))
                 "selectedGeneration" (:generation status) "port" (:port status)})
       key (if (contains? #{"pending" "running" "waiting"} (get public "state"))
             (assoc public "state" "active") public)]
  (reset! observed public)
  (when-not (= key @seen) (reset! seen key) (println (str "DEPLOY " (json/encode public))))
  (when (contains? #{"blocked" "failed" "recovering" "rolled-back" "refused"} (get operation "state"))
   (throw (ex-info (str "Foundry publication stopped: " (get operation "state") " " (pr-str (get operation "error")))
            {:operation operation}))) operation))
(defn published! [owner port journal]
 (let [seen (atom nil) deadline (+ (System/monotonic_time :millisecond) 90000)]
  (loop []
   (let [status (lifecycle/status owner)]
    (observe! (assoc status :preparation
               (or (:preparation status)
                   (admission/observation journal "field-station" "sandbox" "prototype-publication"))) seen))
   (cond (= "prototype-new" (get (get! port) "version")) true
         (>= (System/monotonic_time :millisecond) deadline) false
         :else (do (Process/sleep 50) (recur))))))
(defn complete! [owner]
 ;; live.socket's default reconnect grace is 120s. Preserve that real policy;
 ;; completion must wait for it rather than force-stop an accepted old session.
 (let [deadline (+ (System/monotonic_time :millisecond) 180000)]
  (loop [seen (atom nil)]
   (let [status (lifecycle/status owner) operation (observe! status seen)]
    (cond (= "completed" (get operation "state")) status
          (contains? #{"failed" "rolled-back" "refused"} (get operation "state"))
          (throw (ex-info "Foundry publication did not complete" {:operation operation}))
          (>= (System/monotonic_time :millisecond) deadline)
          (throw (ex-info "Foundry publication deadline exceeded" {:operation operation}))
          :else (do (Process/sleep 20) (recur seen)))))))
(defn stop-owned! [owner]
 (let [deadline (+ (System/monotonic_time :millisecond) 35000)]
  (loop []
   (let [result (lifecycle/stop! owner 5000)]
    (cond (= :ok result) :ok
          (and (= :waiting (:status result)) (Process/alive? (:owner owner))
               (< (System/monotonic_time :millisecond) deadline))
           (do (Process/sleep 25) (recur))
          :else (throw (ex-info (str "Controlled owner stop did not complete: " (:kind result))
                         {:kind :prototype-stop-incomplete :result result})))))))
(defn websocket! [port]
 (let [r (gen_tcp/connect (tuple 127 0 0 1) port (list :binary (tuple :active false)) 3000)]
  (when-not (= :ok (elem r 0)) (throw (ex-info "WebSocket client failed" {})))
  (let [socket (elem r 1)]
   (try
    (gen_tcp/send socket (str "GET /ws/?live-sid=prototype-publication HTTP/1.1\r\nHost: 127.0.0.1:" port
                          "\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n"
                          "Sec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n"))
    (let [reply (gen_tcp/recv socket 0 5000)]
     (when-not (and (= :ok (elem reply 0)) (String/contains? (elem reply 1) "101 Switching Protocols"))
      (throw (ex-info "WebSocket upgrade failed" {:reply reply}))) socket)
    (catch error (gen_tcp/close socket) (throw error))))))
(defn pong! [socket]
 ;; A unique ping must yield its actual pong, not merely a queued mount frame.
 (gen_tcp/send socket (erlang/iolist_to_binary (list 137 136 0 0 0 0 "probe-v1")))
 (let [expected (erlang/iolist_to_binary (list 138 8 "probe-v1"))
       deadline (+ (System/monotonic_time :millisecond) 5000)]
  (loop [bytes ""]
   (cond (not= :nomatch (binary/match bytes expected)) true
         (or (> (erlang/byte_size bytes) 1048576)
             (>= (System/monotonic_time :millisecond) deadline)) false
         :else
          (let [reply (gen_tcp/recv socket 0 (max 1 (- deadline (System/monotonic_time :millisecond))))]
           (if (= :ok (elem reply 0))
            (recur (erlang/iolist_to_binary (list bytes (elem reply 1)))) false))))))
(defn diagnostics! []
 (when (= "1" (System/get_env "STATION_PROTOTYPE_DIAGNOSTICS"))
  (loop [n 0]
   (when (< n 40)
    (receive event
     (cond
      (and (tuple? event) (>= (erlang/tuple_size event) 3) (= :exception_from (elem event 2)))
       (do (println (pr-str event)) (recur (inc n)))
      (and (tuple? event) (= 4 (erlang/tuple_size event)) (= :call (elem event 2))
           (= :execution_profile_enter_native! (elem (elem event 3) 1)))
       (let [args (elem (elem event 3) 2) graph (first args) lease (second args)]
        (when graph
         (println (pr-str {:execution-enter (:digest graph) :scope (:scope graph)
                    :components (mapv #(if (erlang/is_atom %) % :graph-pin) (elem lease 0))
                    :missing-physical (vec (remove (set (elem lease 0)) (:modules graph)))})))
        (recur n))
      :else (recur n))
     (after 100 nil))))))
(defn command-checks! [root]
 (let [print-program (command/tool "printf") sleep-program (command/tool "sleep")
       result (command/run print-program ["%s\n" "{\"component\":\"backup\",\"ready\":true}"
                                           "{\"component\":\"messages\",\"ready\":true}"]
                {:timeout-ms 3000 :limit 4096})
       rows (filter #(not= "" %) (String/split (:out result) "\n"))
       upstream (flow/map-stage (flow/from-seq rows) json/decode)
       observations (flow/run upstream [] (fn [all row] (conj all row)) 1)
       conn (d/connect-with (datom.store-fjall/open (str root "/command-observations.fjall"))
              [{:db/ident :observation/component :db/valueType :db.type/string :db/unique :db.unique/identity}
               {:db/ident :observation/ready :db/valueType :db.type/boolean}])]
  (try
   (checks/check! "bounded argv subprocess returns actual structured observations" (command/ok? result))
   (d/transact! conn (mapv (fn [i]
                            {:db/id (- -1 i) :observation/component (get (nth observations i) "component")
                             :observation/ready (get (nth observations i) "ready")}) (range (count observations))))
   (checks/check! "proc demand stream feeds queryable Datom observations"
    (= 2 (count (d/q '[:find ?e :where [?e :observation/ready true]] (d/db conn)))))
   (let [limited (command/run print-program ["%s" (join "" (repeat 1000 "x"))] {:timeout-ms 3000 :limit 32})
         timed (command/run sleep-program ["2"] {:timeout-ms 20 :limit 128})
         failed (command/run (command/tool "false") [] {:timeout-ms 3000 :limit 128})]
    (checks/check! "subprocess capture drains excess output and marks truncation" (:truncated limited))
    (checks/check! "subprocess deadline reports timeout rather than success" (= :timed-out (:status timed)))
    (checks/check! "a completed nonzero subprocess is still a failed command"
     (and (= :exited (:status failed)) (= 1 (:exit failed)) (not (command/ok? failed)))))
   (finally (d/close! conn)))))
(defn run! [source root]
 (reset! checks/results [])
 (reset! observed nil)
 (File/mkdir_p! (str root "/data"))
 (checks/check! "project .foundry.bl returns the validated online lifecycle declaration"
  (= (definition/define (release/declaration)) (BeamLisp/run_file (str source "/.foundry.bl"))))
 (let [old (release/artifact! source root "prototype-old") fresh (release/artifact! source root "prototype-new")
       key (auth/keypair) host (assoc-in (release/host-contract root old key) ["artifacts" (:id fresh)] (:root fresh))
       opts (bootstrap/config! host)
       previous (reload/reload-enabled?) _ (reload/set-enabled! true)
       owned (atom nil) traffic (atom nil) socket (atom nil) stopped (atom false) samples (atom [])
       acknowledged (atom false)]
  (try
   (reset! owned (lifecycle/start! opts))
   (let [before (lifecycle/status @owned) port (:port before)
         store (conn/registered-at (str root "/data/messages.fjall"))]
    (checks/check! "Foundry starts a real managed live.app factory" (= "prototype-old" (get (get! port) "version")))
    (d/transact! store [{:db/id -1 :prototype/message "accepted-before-publication"}])
    (reset! acknowledged true)
    (reset! socket (websocket! port))
    (reset! traffic (spawn-monitor
     (fn []
      (loop []
       (when-not @stopped
        (swap! samples conj (try (get! port) (catch _ :error)))
        (Process/sleep 10) (recur))))))
    ;; Opt-in local diagnostics for the disposable fixture only. Public Foundry
    ;; refusal categories deliberately do not expose host exception details.
    (when (= "1" (System/get_env "STATION_PROTOTYPE_DIAGNOSTICS"))
     (doseq [module (BeamLisp.Env/callback_modules
                     (BeamLisp.Env/fetch! "foundry.upgrade.lifecycle" "admission!"))]
      (erlang/trace_pattern (tuple module :_ :_)
       (list (tuple :_ (list) (list (tuple :exception_trace)))) (list :local)))
     (doseq [module (BeamLisp.Env/callback_modules
                     (BeamLisp.Env/fetch! "foundry.upgrade.application" "compatibility!"))]
      (erlang/trace_pattern (tuple module :_ :_)
       (list (tuple :_ (list) (list (tuple :exception_trace)))) (list :local)))
     (erlang/trace_pattern (tuple :Elixir.BeamLisp.Env :execution_profile_enter_native! 3)
      (list (tuple :_ (list) (list (tuple :exception_trace)))) (list :local))
     (erlang/trace (:owner @owned) true (list :call :set_on_spawn)))
    ;; This cold, contended sandbox gets an explicit bounded admission budget.
    ;; A timeout is never retried as a fresh operation; the same journal wins.
    (let [reply (GenServer/call (:owner @owned)
                 [:admit {"operation" "prototype-publication" "candidate" (:id fresh)
                          "expectedGeneration" (:generation before) "idempotencyKey" "prototype-source-update"}]
                 60000)]
     (when (:admission-error reply)
      (when (= "1" (System/get_env "STATION_PROTOTYPE_DIAGNOSTICS"))
       (erlang/trace (:owner @owned) false (list :call))
       (diagnostics!))
      (throw (ex-info (str "Native admission refused: " (:admission-error reply)) reply))))
    (checks/check! "candidate serves new requests while the old WebSocket remains open"
     (published! @owned port store))
    (checks/check! "old WebSocket connection still responds after publication"
     (pong! @socket))
    (gen_tcp/close @socket) (reset! socket nil)
    (let [after (complete! @owned) ready (get! port)]
     (checks/check! "online publication keeps the stable lifecycle owner" (= (:owner before) (:owner after)))
     (checks/check! "online publication keeps the same HTTP listener port" (= port (:port after)))
     (checks/check! "readiness proves the actually selected new generation"
      (and (= "prototype-new" (get ready "version")) (= (:generation after) (get ready "generation"))))
     (checks/check! "published application retains the actual pre-publication write" (= 1 (get ready "messages")))
     (d/transact! store [{:db/id -1 :prototype/message "accepted-after-publication"}])
     (checks/check! "existing native connection remains writable after publication" (= 2 (get (get! port) "messages"))))
    (reset! stopped true)
    (checks/eventually #(not (Process/alive? (elem @traffic 0))) 5000)
    (checks/check! "real concurrent HTTP observations contain no failed requests"
     (and (pos? (count @samples)) (not-any? #(= :error %) @samples)))
    )
   (stop-owned! @owned)
   (checks/check! "controlled shutdown acknowledges the actual owner has stopped"
    (not (Process/alive? (:owner @owned))))
   (reset! owned nil)
   ;; Corrupt the disposable pointer deliberately: the journal remains authority.
   (File/rm! (str root "/current")) (File/ln_s! (:root old) (str root "/current"))
   (let [receipt {:format 1 :kind :field-station-foundry-prototype :status :awaiting-restart
                  :passed (count @checks/results) :checks @checks/results
                  :http-observations (count @samples) :old (:id old) :candidate (:id fresh)}
         checkpoint {"version" 1 "host" host "expectedCandidate" (:id fresh)
                     "previousOSProcess" (System/pid) "liveReceipt" receipt}]
    (File/write! (str root "/restart.json") (json/encode checkpoint))
    (File/chmod! (str root "/restart.json") 384)
    receipt)
   (catch error
    (when (and @owned @acknowledged)
     (try
      (let [status (lifecycle/status @owned) ready (get! (:port status))]
       (checks/check! "failed experiment still serves the actually selected generation"
        (= (:generation status) (get ready "generation")))
       (checks/check! "failed experiment preserves the acknowledged application write"
        (>= (get ready "messages") 1)))
      (catch _ (println "FAIL serving/data retention could not be verified after the experiment failed"))))
    (throw error))
   (finally
    (when (and @owned (= "1" (System/get_env "STATION_PROTOTYPE_DIAGNOSTICS")))
     (erlang/trace (:owner @owned) false (list :call :set_on_spawn))
     (diagnostics!))
    (reset! stopped true)
    (when @socket (gen_tcp/close @socket))
    (when @traffic
     (let [pid (elem @traffic 0)] (when (Process/alive? pid) (erlang/exit pid :kill)))
     (Process/demonitor (elem @traffic 1) (list :flush)))
    (when @owned (lifecycle/stop! @owned))
    (reload/set-enabled! previous)))))

(defn restart! [root]
 (let [checkpoint (json/decode (File/read! (str root "/restart.json")))
       _ (when-not (= 1 (get checkpoint "version")) (throw (ex-info "Invalid prototype restart checkpoint" {})))
       live (get checkpoint "liveReceipt") opts (bootstrap/config! (get checkpoint "host"))
       previous (reload/reload-enabled?) owned (atom nil)]
  (reset! checks/results (get live "checks"))
  (reload/set-enabled! true)
  (try
   (checks/check! "journal recovery executes in a fresh OS process"
    (not= (get checkpoint "previousOSProcess") (System/pid)))
   (reset! owned (lifecycle/start! opts))
   (let [status (lifecycle/status @owned) ready (get! (:port status))
         store (conn/registered-at (str root "/data/messages.fjall"))]
    (checks/check! "restart selects the durable journal over a stale artifact pointer"
     (and (= (get checkpoint "expectedCandidate") (:candidate status))
          (= "prototype-new" (get ready "version")) (= (:generation status) (get ready "generation"))))
    (checks/check! "restart preserves both acknowledged writes"
     (and (= 2 (get ready "messages"))
          (= #{["accepted-before-publication"] ["accepted-after-publication"]}
             (set (d/q '[:find ?body :where [?e :prototype/message ?body]] (d/db store)))))))
   (command-checks! root)
   {:format 1 :kind :field-station-foundry-prototype :status :passed
    :passed (count @checks/results) :checks @checks/results
    :http-observations (get live "http-observations") :old (get live "old") :candidate (get live "candidate")
    :scope "Real Foundry publication and journal recovery in two cold SDK VMs, Fjall, HTTP and WebSocket. Sandbox runtime marker; no portable package or production rollout."}
   (finally
    (when @owned (stop-owned! @owned))
    (reload/set-enabled! previous)))))
