; Thin prototype delegate; the implementation belongs to the shared library.
(ns station-prototype.rpc (:require [rpc.unix :as rpc]))
(def protocol rpc/protocol)
(defn serve! [options] (rpc/serve! options))
(defn stop! [server] (rpc/stop! server))
(defn status [server] (rpc/status server))
(defn request!
 ([path request] (rpc/request! path request))
 ([path request options] (rpc/request! path request options)))
