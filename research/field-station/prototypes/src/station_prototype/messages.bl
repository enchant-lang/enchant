;; This namespace uses the existing checked export/effect grammar unchanged.
(ns ^{:auth {:version 1
             :exports {inbox {:roles #{:member} :resource {:arg 0} :effects {:read #{:inbox}}}
                       claim! {:roles #{:member} :resource {:arg 0} :effects {:send #{:claim}}}}
             :grants {"prototype-client" #{inbox claim!}}}}
 station-prototype.messages
 (:require [auth.resource :as resource]))
(defn inbox [workspace] (resource/read :inbox))
(defn claim! [workspace message request-id] (resource/perform! :claim [message request-id]))
