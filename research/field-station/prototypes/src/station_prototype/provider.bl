;; Host binding: callback closures are trusted local wiring, never wire data.
(ns station-prototype.provider
 (:require [auth.interface :as interface] [datom :as d] [station-prototype.store :as store]))
(defn open! [source conn now]
 (interface/open
  {:file source :world "field-station/prototype"
   :roles (fn [principal resource]
            (if (store/member? (d/db conn) (:subject principal) resource) #{:member} #{}))
   :readers {:inbox (fn [principal resource] (store/inbox (d/db conn) (:subject principal) resource))}
   :effects {:claim (fn [principal resource command]
                     (let [[message request-id] command
                           receipt (store/claim! conn (:subject principal) resource
                                     {:message/id message :request/id request-id} (now))]
                      [(:message/id receipt) (:claim/owner receipt) (:claim/until receipt)]))}}))
