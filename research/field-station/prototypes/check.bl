(ns station-prototype.check (:require [station-prototype.checks :as checks] [bl.json :as json]))
(let [source (System/get_env "STATION_PROTOTYPE_SOURCE") root (System/get_env "STATION_PROTOTYPE_STATE")]
 (when-not (and source root) (throw (ex-info "Use the bounded ./run entrypoint" {})))
 (let [path (str root "/core-receipt.json")]
  (try
   (let [receipt (assoc (checks/run! source root) :status :passed)]
    (File/write! path (json/encode receipt)) (println (json/encode receipt)))
   (catch error
    (let [receipt {:format 1 :kind :field-station-core-prototypes :status :failed
                   :passed (count @checks/results) :checks @checks/results :reason (ex-message error)}]
     (File/write! path (json/encode receipt)) (println (json/encode receipt)))
    (throw error)))))
