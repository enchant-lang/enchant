;; Exercise the actual LSP state transitions in one private VM. All inputs are
;; generated and bounded, and the runner retains only scalar resource samples.
(ns observatory.editor-memory
 (:require [bl.json :as json] [clojure.string :as string] [lsp :as lsp] [lsp.rpc :as rpc]))

(def uri "file:///enchant-editor-memory.bl")
(def peer-uri "file:///enchant-editor-memory-peer.bl")
(def edits 32)
(def source-prefix
 (str "(ns observatory.memory-fixture)\n"
      (apply str (mapv (fn [i] (str "(defn f" i " [x] (+ x " i "))\n")) (range 48)))))
(defn source [revision] (str source-prefix "(defn changed [x] (+ (f0 x) " revision "))\n"))

(defn request [state method params]
 (rpc/handle state {"jsonrpc" "2.0" "method" method "params" params}))

(defn linux-sample [path labels]
 (try
  (into {}
   (keep (fn [line]
          (let [[name value] (string/split line #":" 2)]
           (when (contains? labels name)
            [name (String/to_integer (first (string/split (string/trim value) #"\s+")))])))
    (string/split-lines (File/read! path))))
  (catch _ nil)))

(defn sample [phase state]
 {:phase phase
  :monotonic-ms (erlang/monotonic_time :millisecond)
  :documents (count (:docs state))
  :vm (into {} (map (fn [kind] [kind (erlang/memory kind)])
                    [:total :processes_used :system :binary :ets :code :atom_used]))
  :editor (into {} (map (fn [pair] [(elem pair 0) (elem pair 1)])
                        (erlang/process_info (erlang/self)
                          (list :memory :heap_size :total_heap_size :message_queue_len :reductions))))
  :lsp-retention (lsp/memo-stats)
  :ets-words (into {} (keep (fn [name]
                            (let [words (ets/info name :memory)]
                             (when (int? words) [name words])))
                    [:lsp.analysis :lsp.growth :lsp.diagnostics :lsp.defns]))
  :loaded-modules (count (code/all_loaded))
  :os-kib (or (linux-sample "/proc/self/smaps_rollup" #{"Rss" "Pss" "SwapPss"})
              (linux-sample "/proc/self/status" #{"VmRSS" "VmSwap"}))})

(defn diagnostics-for? [messages target]
 (some #(and (= "textDocument/publishDiagnostics" (get % "method"))
             (= target (get-in % ["params" "uri"]))) messages))

(defn edit [state target revision]
 (let [[updated messages] (request state "textDocument/didChange"
                            {"textDocument" {"uri" target "version" revision}
                             "contentChanges" [{"text" (source revision)}]})]
  (assert (= revision (get-in updated [:docs target :version])))
  (assert (diagnostics-for? messages target))
  updated))

(defn initialized []
 (first (rpc/handle (rpc/initial-state)
         {"jsonrpc" "2.0" "id" 1 "method" "initialize" "params" {}})))

(defn open-document [state target revision]
 (let [[opened messages] (request state "textDocument/didOpen"
                          {"textDocument" {"uri" target "version" revision "text" (source revision)}})]
  (assert (diagnostics-for? messages target))
  opened))

(defn close-document [state target]
 (let [[closed messages] (request state "textDocument/didClose" {"textDocument" {"uri" target}})]
  (assert (diagnostics-for? messages target))
  (assert (empty? (get-in (first messages) ["params" "diagnostics"])))
  (assert (nil? (get-in closed [:docs target])))
  closed))

(defn single-replay []
 (let [idle (initialized)
      before (sample "idle" idle)
      opened (open-document idle uri 1)
      _ (assert (= 1 (count (:docs opened))))
      after-open (sample "opened" opened)
      {:keys [closed observations]}
      (loop [state opened n 2 rows [before after-open]]
       (if (> n (inc edits))
        (let [before-close (sample "edited" state)
              closed (close-document state uri)]
         {:closed closed :observations (conj rows before-close)})
        (let [state (edit state uri n)]
         (recur state (inc n)
          (if (zero? (mod (dec n) 8)) (conj rows (sample (str "after-" (dec n) "-edits") state)) rows)))))
      _ (assert (empty? (:docs closed)))
      after-close (sample "closed" closed)]
  (erlang/garbage_collect)
  {:schema "enchant.editor-memory-replay.v1"
                :scope "One LSP request process. Dedicated VM exits after the final sample."
                :memory-units {:vm "bytes" :editor "bytes or heap words by key" :os-kib "KiB"}
                :edits edits :samples (conj observations after-close (sample "closed-after-gc" closed))}))

(defn interleaved-replay []
 (let [idle (initialized)
       idle-sample (sample "idle" idle)
       opened (open-document (open-document idle uri 1) peer-uri 1001)
       open-sample (sample "two-documents-open" opened)
       {:keys [final-state samples]}
       (reduce (fn [{:keys [final-state samples]} round]
                 (let [before (get-in final-state [:docs uri :memo-slot])
                       peer-before (get-in final-state [:docs peer-uri :memo-slot])
                       edited (reduce (fn [state version]
                                       (edit (edit state uri version) peer-uri (+ 1000 version)))
                                      final-state (range (+ 2 (* 4 round)) (+ 6 (* 4 round))))
                       edited-bytes (:bytes (lsp/memo-stats))
                       closed (close-document edited uri)
                       closed-sample (sample (str "primary-closed-" round) closed)
                       peer-builds (:builds (:lsp-retention closed-sample))
                       [saved messages] (request closed "textDocument/didSave"
                                          {"textDocument" {"uri" peer-uri}})
                       reopened (open-document saved uri 1)]
                  (assert (diagnostics-for? messages peer-uri))
                  (assert (< (get-in closed-sample [:lsp-retention :bytes]) edited-bytes))
                  (assert (= before (get-in edited [:docs uri :memo-slot])))
                  (assert (not= before (get-in reopened [:docs uri :memo-slot])))
                  (assert (= peer-before (get-in reopened [:docs peer-uri :memo-slot])))
                  ;; The peer's save uses the retained analysis. Only reopening
                  ;; the primary document should build one more bundle.
                  (assert (= (inc peer-builds) (:builds (lsp/memo-stats))))
                  {:final-state reopened :samples (conj samples closed-sample
                                                    (sample (str "primary-reopened-" round) reopened))}))
               {:final-state opened :samples [idle-sample open-sample]} (range 4))
       closed (close-document (close-document final-state uri) peer-uri)
       before-gc (sample "both-closed" closed)]
  (assert (empty? (:docs closed)))
  (erlang/garbage_collect)
  {:schema "enchant.interleaved-editor-memory-replay.v1"
   :scope "Two open documents through the serial LSP request owner in a private VM."
   :memory-units {:vm "bytes" :editor "bytes or heap words by key" :os-kib "KiB"}
   :edits 32 :reopens 4 :peer-saves-reused true
   :samples (conj samples before-gc (sample "both-closed-after-gc" closed))}))

(let [[output mode] (BeamLisp/argv)
      report (if (= "--interleaved" mode) (interleaved-replay) (single-replay))]
 (File/write! output (json/encode report)))
