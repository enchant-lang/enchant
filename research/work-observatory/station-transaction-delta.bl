;; Run with the Station gateway Source on the load path. The replay uses
;; the accounting schema and committed Datom reports in an owned memory DB.
(ns observatory.station-transaction-delta
 (:require [bl.json :as json] [datom] [datom.db :as db] [datom.watch :as watch]
           [data.delta-aggregate :as aggregate] [gateway.accounting :as accounting]
           [gateway.json :as report-json]))

(def fact-query
 '[:find ?e ?id ?at ?type ?data :where
   [?e :fact/id ?id] [?e :fact/at ?at] [?e :fact/type ?type] [?e :fact/data ?data]])

(def history-query
 '[:find ?e :in $ ?since :where [?e :fact/at ?at] [(>= ?at ?since)]])

(defn fact-index [database]
 (into {} (map (juxt first identity) (datom/q fact-query database))))

(defn- decoded-event [[_ id _ type data]]
 (assoc (json/decode data) "id" id "type" type))

(defn rebuild [current]
 {:basis (db/view-key current) :facts (fact-index current) :path :full-rebuild})

(defn advance [previous report current]
 (let [{:keys [db-before db-after tx tx-datoms]} report
       current-key (db/view-key current)]
  (if (and db-before db-after
           (= (:basis previous) (db/view-key db-before))
           (= current-key (db/view-key db-after))
           (= tx (datom/basis-t db-after)))
   (let [{:keys [removed added]} (watch/delta-diff fact-query [] db-before db-after tx tx-datoms)
         old (:facts previous)
         changed (into (set (map first removed)) (map first added))
         facts (into (reduce (fn [rows row] (dissoc rows (first row))) old removed)
                     (map (juxt first identity) added))]
    {:basis current-key :facts facts :path :transaction-delta
     :changed changed :transaction-datoms (count tx-datoms)})
   (rebuild current))))

(defn- measured [action]
 (let [start (erlang/monotonic_time :microsecond)
       before (elem (erlang/process_info (erlang/self) :reductions) 1)
       result (action)]
  [result {:elapsed-us (- (erlang/monotonic_time :microsecond) start)
           :caller-reductions (- (elem (erlang/process_info (erlang/self) :reductions) 1) before)}]))

(defn- fact [tempid id at type data]
 {:db/id tempid :fact/id id :fact/at at :fact/type type :fact/data (json/encode (assoc data "at" at))})

(defn- seed-request [index stamp]
 (let [id (str "seed-" index)
       at (cond (= index 1) stamp
                (zero? (mod index 10)) (- stamp (* 7 86400000))
                :else (dec stamp))
       route (if (zero? (mod index 3)) "anthropic" "codex")]
  (fact (- -1 index) (str "request:" id) at "request"
        {"request-id" id "uid" (+ 1000 (mod index 150)) "route" route "provider" route
         "status" (if (zero? (mod index 7)) 429 200)
         "input_tokens" (when (odd? index) 8) "output_tokens" (when (odd? index) 5)
         "fallback" (zero? (mod index 13))})))

(defn- update-decoded [before change]
 (reduce (fn [events id]
           (if-let [row (get-in change [:facts id])]
            (assoc events id (decoded-event row))
            (dissoc events id)))
         before (:changed change)))

(defn- ordered-events [database since events]
 ;; Use Station's existing history selection order before rendering. Tied
 ;; timestamps rank by that order, which a map keyed by entity cannot supply.
 (mapv (fn [[entity]]
         (let [event (get events entity)]
          (assert (some? event))
          event))
       (datom/q history-query database since)))

(defn- completed-attempt? [window]
 (some (fn [request]
         (and (= "seed-1" (get request "request-id"))
              (some #(= "attempt-finished" (get % "event")) (get request "attempts"))))
       (:requests window)))

(def window-sums [:refused :inputTokens :outputTokens :fallbackRequests])

(defn- request-contribution [entity event]
 (when (and (= "request" (get event "type")) (string? (get event "route")))
  (let [tokens (fn [field]
                 (let [value (get event field)]
                  (cond (nil? value) 0
                        (and (int? value) (<= 0 value)) value
                        :else (throw (ex-info "Replay requires nonnegative integer token meters" {:field field})))))]
   {:id entity :at (get event "at") :uid (get event "uid") :route (get event "route")
    :refused (if (and (number? (get event "status")) (>= (get event "status") 400)) 1 0)
    :inputTokens (tokens "input_tokens") :outputTokens (tokens "output_tokens")
    :fallbackRequests (if (get event "fallback") 1 0)})))

(defn- window-counter [days]
 ;; The publisher includes an event at the cutoff itself.
 (aggregate/initial {:source-id "station-window-replay" :group-by [:route] :sum window-sums
                      :window-ms (inc (* days 86400000))
                      :max-events 4096 :max-groups 16 :max-delta 128 :max-bytes 4194304}))

(defn- apply-counter [state now changes]
 (aggregate/apply-delta state (assoc changes :sequence (inc (:cursor state)) :now now)))

(defn- seed-counters [decoded days now]
 (let [people (group-by :uid (keep (fn [[eid event]] (request-contribution eid event)) decoded))]
  (into {} (map (fn [[uid rows]]
                  [uid (reduce (fn [counter batch] (apply-counter counter now {:upsert (vec batch)}))
                               (window-counter days) (Enum/chunk_every rows 128))])
                people))))

(defn- counter-changes [baseline decoded ids]
 (reduce (fn [changes eid]
           (let [before (request-contribution eid (get baseline eid))
                 after (request-contribution eid (get decoded eid))]
            (cond-> changes
             before (update-in [(:uid before) :remove] (fn [xs] (conj (or xs []) eid)))
             after (update-in [(:uid after) :upsert] (fn [xs] (conj (or xs []) after))))))
         {} ids))

(defn- drain-counter [state now]
 (loop [state state expired 0]
  (let [next (aggregate/expire state now)
        expired (+ expired (get-in next [:work :expired]))]
   (if (:more? next) (recur next expired) [next expired]))))

(defn- counter-result [counters]
 (into {} (mapcat (fn [[uid state]]
                   (let [{:keys [status groups]} (aggregate/view state)]
                    (assert (= :ready status))
                    (map (fn [[[route] group]] [[uid route] (assoc (:sums group) :requests (:count group))]) groups)))
                 counters)))

(defn- verify-window-counters [baseline decoded ids expected days now]
 (let [initial (seed-counters baseline days (dec now))
       delta (counter-changes baseline decoded ids)
       [[live expired] cost]
       (measured #(reduce (fn [[live expired] [uid state]]
                            (let [[current removed] (drain-counter state now)]
                             [(assoc live uid current) (+ expired removed)]))
                          [{} 0]
                          (reduce (fn [current [uid changes]]
                                    (assoc current uid (apply-counter (get current uid (window-counter days)) now changes)))
                                  initial delta)))
       groups (counter-result live)
       expected (into {} (map (fn [row] [[(:uid row) (:route row)]
                                       (select-keys row (conj window-sums :requests))]) (:rows expected)))]
  (assert (= expected groups))
  {:exact true :changed-users (count delta) :expired expired :timing cost}))

(defn- grouped-events [events]
 (into {} (map (fn [[uid owned]] [(str uid) owned]) (dissoc (group-by #(get % "uid") events) nil))))

(defn- report-windows [events now]
 {"7" (accounting/project events now 7) "30" (accounting/project events now 30)})

(defn- encoded-windows [windows]
 (list "{\"7\":" (report-json/encode (get windows "7"))
       ",\"30\":" (report-json/encode (get windows "30")) "}"))

(defn- report-body [envelope global people]
 (let [header (report-json/encode envelope)
       rows (map (fn [[uid windows]] (list (report-json/encode uid) ":" windows)) (sort-by first people))]
  (list (binary/part header 0 (dec (erlang/byte_size header)))
        ",\"windows\":" global ",\"people\":{" (Enum/intersperse rows ",") "}}")))

(defn- measure-file! [path body size]
 (let [[_ write] (measured #(File/write! path body))
       [fingerprint verify]
       (measured
        #(let [opened (file/open (String/to_charlist path) (list :read :binary :raw)) handle (elem opened 1)]
          (assert (= :ok (elem opened 0)))
          (try
           (loop [read 0 hash (crypto/hash_init :sha256)]
            (let [chunk (file/read handle 65536)]
             (if (= :eof chunk)
              (do (assert (= size read)) (crypto/hash_final hash))
              (do (assert (= :ok (elem chunk 0)))
                  (let [bytes (elem chunk 1) next-read (+ read (erlang/byte_size bytes))]
                   (assert (<= next-read size))
                   (recur next-read (crypto/hash_update hash bytes)))))))
           (finally (file/close handle)))))]
  (assert (= fingerprint (crypto/hash :sha256 body)))
  {:write write :verify verify}))

(defn- verify-complete-report [current before expected actual changed now path]
 ;; All windows are computed at the same observation time and without billing.
 ;; A production owner must also detect clock, policy and provider changes.
 (let [baseline (grouped-events before)
       [prior-encoded prior-cost]
       (measured #(into {} (map (fn [[uid events]] [uid (encoded-windows (report-windows events now))]) baseline)))
       [reference preparation]
       (measured #(accounting/publication-input current {:schema 1 :at now :source "accounting"} nil false))
       people (:people reference) envelope (:envelope reference)
       [candidate grouping] (measured #(grouped-events actual))
       _ (assert (= expected (:events reference)))
       _ (assert (= people candidate))
       ;; Revalidate the ordered UID input before reusing bytes. A Datom query
       ;; need not preserve tie ordering after a basis change.
       [dirty selection]
       (measured #(reduce-kv (fn [uids uid events]
                              (if (and (not (contains? changed uid)) (= (get baseline uid) events))
                               uids (conj uids uid))) #{} candidate))
       report (fn [events rows reuse?]
                (let [[windows shaping]
                      (measured #(into {} (keep (fn [[uid events]]
                                                 (when (or (not reuse?) (contains? dirty uid))
                                                  [uid (report-windows events now)])) rows)))
                      [global global-shaping] (measured #(report-windows events now))
                      [body encoding]
                      (measured #(report-body envelope (encoded-windows global)
                                 (reduce-kv (fn [m uid _]
                                             (assoc m uid (if-let [window (get windows uid)]
                                                           (encoded-windows window) (get prior-encoded uid)))) {} rows)))]
                 [body {:uid-shaping shaping :global-shaping global-shaping :encoding encoding}]))
       [full full-timing] (report (:events reference) people false)
       [retained retained-timing] (report actual candidate true)
       bytes (erlang/iolist_size full)
       limit (* 16 1024 1024)]
  (assert (= bytes (erlang/iolist_size retained)))
  (assert (= (erlang/iolist_to_binary full) (erlang/iolist_to_binary retained)))
  (let [file-work (when (<= bytes limit)
                   (let [work (str path "-" (Base/encode16 (crypto/strong_rand_bytes 12)))
                         candidate-file (Path/join work "report.json")]
                    (File/mkdir! work)
                    (try
                     (File/chmod! work 448)
                     {:full (measure-file! candidate-file full bytes)
                      :retained (measure-file! candidate-file retained bytes)}
                     (finally (File/rm candidate-file) (File/rmdir work)))))]
   {:exact-bytes true :bytes bytes :byte-limit limit :uids (count people) :recomputed-uids (count dirty)
    :reused-uids (- (count people) (count dirty))
    :status (if (<= bytes limit) :verified-private-file :over-managed-publisher-limit)
    :prior-uid-encoding prior-cost :full-preparation preparation :retained-grouping grouping :uid-selection selection
    :full (merge full-timing (:full file-work))
    :retained (merge retained-timing (:retained file-work))})))

(defn- verify-publication [conn current prior initial delta stamp report-path]
 (let [now (+ stamp 1)
       since (- now (* 31 86400000))
       baseline-index (into {} (map (fn [[id row]] [id (decoded-event row)]) (:facts initial)))
       reference #(accounting/facts conn since)
       candidate #(ordered-events current since (update-decoded baseline-index delta))
       expected (reference)
       {:keys [actual timing]}
       (reduce (fn [{:keys [actual timing]} path]
                 (let [[events cost] (measured (if (= :from-retained-events path) candidate reference))]
                  (assert (= expected events))
                  {:actual (if (= :from-retained-events path) events actual)
                   :timing (update timing path (fn [samples] (conj (or samples []) cost)))}))
               {:actual [] :timing {}}
               [:from-full-pulls :from-retained-events :from-retained-events :from-full-pulls])
       expected-by-uid (group-by #(get % "uid") expected)
       actual-by-uid (group-by #(get % "uid") actual)
       decoded (update-decoded baseline-index delta)
       has-seed-request (some #(= "request:seed-1" (get % "id")) expected)
       windows (mapv (fn [days]
                       (let [from-reference (accounting/project expected now days)
                             from-delta (accounting/project actual now days)]
                        (assert (= from-reference from-delta))
                        (doseq [uid [1000 1001]]
                         (assert (= (accounting/project (get expected-by-uid uid) now days)
                                    (accounting/project (get actual-by-uid uid) now days))))
                        (when has-seed-request (assert (completed-attempt? from-delta)))
                        {:days days :exact true :exact-uid-windows 2
                         :attempt-join-checked (boolean has-seed-request)
                         :incremental-counters (verify-window-counters baseline-index decoded (:changed delta) from-reference days now)
                         :requests (reduce + 0 (map :requests (:rows from-delta)))}))
                     [7 30])]
  (when (>= (count expected) 10)
   (assert (< (:requests (first windows)) (:requests (second windows)))))
  (cond-> {:events (count actual) :exact-ordered-events true :decoded-updates (count (:changed delta))
           :history-preparation timing :windows windows}
   report-path
   (assoc :complete-report
    (let [before (ordered-events prior since baseline-index)
          changed (into #{} (keep #(when-let [uid (get % "uid")] (str uid)))
                          (mapcat #(vector (get baseline-index %) (get decoded %)) (:changed delta)))]
     (verify-complete-report current before expected actual changed now report-path))))))

(defn- seed! [conn n stamp bulk?]
 (let [started (erlang/monotonic_time :microsecond)]
  (doseq [batch (range (erlang/div (+ n 499) 500))]
   (let [start (* batch 500)
         rows (mapv (fn [index]
                      (let [row (seed-request index stamp)]
                       ;; The fixture owns a fresh DB. This high ID range is
                       ;; reserved for new seed rows and never overlaps the
                       ;; temporary IDs resolved by the later transactions.
                       (if bulk? (assoc row :db/id (+ 10000000 index)) row)))
                    (range start (min n (+ start 500))))]
    (if bulk? (datom/load-facts! conn rows) (datom/transact! conn rows))))
  {:mode (if bulk? :bulk-fresh-facts :ordinary-transactions)
   :elapsed-us (- (erlang/monotonic_time :microsecond) started)}))

(defn- replay [n bulk? report-path]
 (let [conn (datom/connect accounting/schema)
       stamp 1790000000000]
  (try
   (let [seed (seed! conn n stamp bulk?)
         _ (println (str "Station fixture seeded " n " requests"))
         attempt {"attempt-id" "one" "request-id" "seed-1" "uid" 1001 "provider" "codex"}
         _ (datom/transact! conn [(fact -1 "attempt:one" stamp "attempt" (assoc attempt "event" "attempt-started"))])
         prior (datom/db conn)
         initial (rebuild prior)
         written (datom/transact! conn [(fact -1 "attempt:one" (+ stamp 1) "attempt"
                                         (assoc attempt "event" "attempt-finished" "complete" true))
                                        (fact -2 "gap:one" stamp "gap" {"event" "gap"})
                                        (fact -4 "request:added" (+ stamp 1) "request"
                                         {"uid" 1000 "route" "codex" "status" 200 "input_tokens" 3})
                                        {:db/id -3 :cursor/id "audit:fixture" :cursor/offset 10}])
         current (datom/db conn)
         [delta delta-cost] (measured #(advance initial written current))
         [full full-cost] (measured #(rebuild current))
         _ (assert (= :transaction-delta (:path delta)))
         _ (assert (= 3 (count (:changed delta))))
         _ (assert (= (:facts full) (:facts delta)))
         publication (verify-publication conn current prior initial delta stamp report-path)
         cursor-only (datom/transact! conn [{:db/id -1 :cursor/id "audit:fixture" :cursor/offset 20}])
         cursor-result (advance delta cursor-only (datom/db conn))
         _ (assert (= :transaction-delta (:path cursor-result)))
         _ (assert (empty? (:changed cursor-result)))
         _ (assert (= (:facts delta) (:facts cursor-result)))
         missed (datom/transact! conn [(fact -1 "request:missed" stamp "request" {"uid" 1000})])
         latest (datom/transact! conn [(fact -1 "request:latest" stamp "request" {"uid" 1001})])
         observed (datom/db conn)
         rebuilt (advance cursor-result latest observed)
         overtaken (advance cursor-result missed observed)]
    (assert (= :full-rebuild (:path rebuilt) (:path overtaken)))
    (assert (= (fact-index observed) (:facts rebuilt) (:facts overtaken)))
    {:seed-requests n :seed seed :changed-facts (count (:changed delta)) :transaction-datoms (:transaction-datoms delta)
     :delta delta-cost :full full-cost :publication publication
     :controls {:attempt-finish-exact true :cursor-only-ignored true
                :missed-transaction-rebuilt true :overtaken-transaction-rebuilt true}})
   (finally (datom/close! conn)))))

(let [[output size & flags] (BeamLisp/argv)
      requests (if size (String/to_integer size) 3000)
      flags (set flags)
      bulk? (contains? flags "--bulk-seed")
      report? (contains? flags "--complete-report")]
 (assert (every? #{"--bulk-seed" "--complete-report"} flags))
 (assert (and (string? output) (<= 1 requests 74000)))
 (File/write! output (json/encode {:schema "enchant.station-transaction-delta-replay.v1"
                                  :result (replay requests bulk? (when report? (str output ".candidate")))})))
