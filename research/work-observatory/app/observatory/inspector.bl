;; App-owned development UI over the qualified SDK's read-only snapshot.
;; Follows tooling.pulse/with-chip; uses the existing live:patch browser seam.
(ns observatory.inspector
  (:require [live.observatory :as observations] [loom.token :as token]
            [bl.json :as json] [web]))

(defn root []
  (or (System/get_env "ENCHANT_INSPECTOR_ROOT")
      (Path/join (BeamLisp/cwd) "research/work-observatory/app")))

(defn- chip []
  (let [scale (json/encode (select-keys (token/theme) [:space :radius :color :text]))]
    [[:div {:id "enchant-inspector" :key "enchant-inspector"
            :data-loom-scale (if (<= (count scale) 16384) scale "{}") }]
     [:script {:src "/__enchant/inspector.js" :defer true :key "enchant-inspector-script"}]]))

(defn decorate
  "Inject the small dock only for an authorized development viewer. The shadow
   DOM keeps its controls and browser state outside the app's patch children."
  [screen authorize]
  (fn [context]
    (let [view (screen context)]
      (if (= true (authorize (:me context)))
        [:div {:data-enchant-app ""} view (chip)] view))))

(defn attach
  "Opt-in app decoration. Retains the SDK snapshot/auth boundary and composes
   existing HTTP routes. UI assets belong to the app and need no SDK rebuild."
  [app options]
  (if-not (= true (:enabled? options)) app
    (let [authorize (:authorize options)
          _ (when-not (fn? authorize) (throw "Inspector needs host authorization"))
          model (observations/open options)
          read-snapshot (observations/handler model authorize)
          assets (into {} (map (fn [[path file]]
                    (let [bytes (File/read! (Path/join (root) file))]
                      (when (> (count bytes) 65536) (throw "Inspector asset exceeds 64 KiB"))
                      [path bytes]))
                   [["/__enchant/inspector.js" "inspector.js"]
                    ["/__enchant/inspector.css" "inspector.css"]]))
          previous (:http app)]
      (assoc app
        :routes (mapv (fn [[path screen]] [path (decorate screen authorize)]) (:routes app))
        :http (fn [conn path]
          (cond
            (= path "/__enchant/snapshot.json") (read-snapshot conn path)
            (or (= path "/__enchant") (contains? assets path))
            (let [conn (web/resp-header conn "cache-control" "no-store")]
              (cond
                (not= true (authorize (web/private conn :me))) (web/text conn 404 "not found")
                (not= "get" (web/method conn)) (web/text conn 405 "GET required")
                (= path "/__enchant") (web/text (web/resp-header conn "location" "/") 302 "")
                (= path "/__enchant/inspector.js") (web/js conn (get assets path))
                :else (web/bytes conn "text/css" (get assets path))))
            previous (previous conn path)
            :else nil))))))
