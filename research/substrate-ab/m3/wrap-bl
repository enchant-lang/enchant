#!/bin/sh
# M3: the copy's checkout entry, served by the branch's client binary
# (M3_CLIENT), with the platform preset exactly as the one-exec path sets it.
COPY=${M3_COPY:-/tmp/m3-$USER/enchant}
for a in "$@"; do [ "$a" = "--" ] && break; [ "$a" = "--cold" ] && exec "$COPY/bin/bl" "$@"; done
P=$(readlink -f "$COPY/.bl/checkout-platform")
export BL_CHECKOUT_PLATFORM="$P" BL_ARTIFACT_PLATFORM="$P/artifact-platform" BL_BIN="$P/bin/drop-launcher" PATH="$P/bin:$PATH"
BL_PREPARED_NATIVES=$(readlink -f "$P/native-products"); export BL_PREPARED_NATIVES
exec "${M3_CLIENT:-$P/bin/drop-launcher}" --checkout "$COPY" -- "$@"
