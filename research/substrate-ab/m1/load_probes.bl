(ns m1-load-probes)
;; Compiles m1_sampler.erl and m1_trace.erl into M1_BEAM_DIR, loads them into
;; the warm VM and starts the one M1_PROBE names (sampler | trace).
;; M1_DIR: this directory; M1_LABEL_FILE: the window label file.
(def dir (System/get_env "M1_DIR"))
(def out (System/get_env "M1_BEAM_DIR"))
(doseq [m ["m1_sampler" "m1_trace"]]
  (compile/file (erlang/binary_to_list (str dir "/" m ".erl"))
                (list (tuple :outdir (erlang/binary_to_list out))))
  (code/add_patha (erlang/binary_to_list out))
  (code/purge (erlang/binary_to_atom m :utf8))
  (code/load_file (erlang/binary_to_atom m :utf8)))
(def label (System/get_env "M1_LABEL_FILE"))
(def traced
  ;; {module function arity index-of-the-argument-to-show}
  (list (tuple :Elixir.BeamLisp.Loader :do_load 3 1)
        (tuple :Elixir.BeamLisp.AOT :ensure_loaded_local 5 1)
        (tuple :Elixir.BeamLisp.AOT :compile_sdk_source! 3 1)
        (tuple :Elixir.BeamLisp.Compiler :eval_string 3 3)
        (tuple :Elixir.BeamLisp :run_file 1 1)
        (tuple :Elixir.BeamLisp.Ns.Body.Bl.Daemon :handle-in-vm 3 1)
        (tuple :Elixir.BeamLisp.Ns.Body.Bl.Cli :run-argv 1 1)
        (tuple :Elixir.BeamLisp.Ns.Body.Vm.Realm :open 2 1)))
(if (= "trace" (System/get_env "M1_PROBE"))
  (m1_trace/start traced label)
  (m1_sampler/start label))
(println "M1-PROBES" (System/get_env "M1_PROBE")
         (erlang/module_loaded :m1_sampler) (erlang/module_loaded :m1_trace))
