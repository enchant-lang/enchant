(ns w3-bench-req)
(require '[bl.daemon :as d] '[bl.cli :as cli] '[vm.realm :as realm])
(defn us [n f] (f) (let [t0 (erlang/monotonic_time :microsecond)] (dotimes [_ n] (f)) (/ (- (erlang/monotonic_time :microsecond) t0) (* 1.0 n))))
(def env (into {} (System/get_env)))
(def root (or (System/get_env "W3_ROOT") (BeamLisp/cwd)))
(defn report [label v] (IO/puts :stderr (str "BENCH " label " " v)))
(report "env-vars" (count env))
(report "spawn-owned+wait" (us 200 (fn [] (let [me (erlang/self)] (spawn (fn [] (erlang/send me :done))) (receive :done :ok)))))
(report "erlang-spawn+wait" (us 200 (fn [] (let [me (erlang/self)] (erlang/spawn (fn [] (erlang/send me :done))) (receive :done :ok)))))
(report "with-project" (us 100 (fn [] (BeamLisp/with_cwd root (fn [] (cli/with-project))))))
(report "realm-open" (us 100 (fn [] (realm/open (d/realm-root root) (get env "BL_CHECKOUT_SOURCE_GENERATION")))))
(report "handle-in-vm" (us 100 (fn [] (d/handle-in-vm ["run" "/tmp/w3-othman/one.bl"] root env))))
(report "handle-in-vm-noenv" (us 100 (fn [] (d/handle-in-vm ["run" "/tmp/w3-othman/one.bl"] root nil))))
(report "run-argv-direct" (us 100 (fn [] (BeamLisp/with_cwd root (fn [] (BeamLisp/with_argv (list "run" "/tmp/w3-othman/one.bl") (fn [] (cli/run-argv ["run" "/tmp/w3-othman/one.bl"]))))))))
