(ns w3-bench-env)
(require '[vm.osenv :as osenv] '[bl.daemon :as d])
(defn us [n f] (f) (let [t0 (erlang/monotonic_time :microsecond)] (dotimes [_ n] (f)) (/ (- (erlang/monotonic_time :microsecond) t0) (* 1.0 n))))
(defn report [label v] (IO/puts :stderr (str "BENCH " label " " v)))
(def owned (set ["BL_ROOT" "BL_EBIN" "BL_SDK_PRODUCT" "BL_SDK_INPUTS" "BL_BUILD_ID"]))
(defn ce [os-env]
  (reduce (fn [result key]
            (cond (contains? owned key) (dissoc result key)
                  (contains? result key) result
                  :else (assoc result key nil)))
          (or os-env {}) (keys (erlang/apply :Elixir.System :get_env (list)))))
(defn main []
  (let [env (into {} (System/get_env))
        env2 (into {} (System/get_env))
        full (ce env)]
    (report "n" (count full))
    (report "System/get_env" (us 200 (fn [] (System/get_env))))
    (report "os/getenv+phash2" (us 200 (fn [] (erlang/phash2 (os/getenv)))))
    (report "client-environment" (us 200 (fn [] (ce env))))
    (report "validate" (us 200 (fn [] (osenv/validate full))))
    (report "equal" (us 200 (fn [] (= env env2))))
    (report "with-env" (us 200 (fn [] (osenv/with-env full (fn [] nil)))))))
(main)
