(ns w3-bench-run)
(require '[bl.daemon :as d] '[bl.cli :as cli] '[vm.manager :as mgr] '[vm.realm :as realm])
(defn us [n f] (f) (let [t0 (erlang/monotonic_time :microsecond)] (dotimes [_ n] (f)) (/ (- (erlang/monotonic_time :microsecond) t0) (* 1.0 n))))
(defn report [label v] (IO/puts :stderr (str "BENCH " label " " v)))
(defn main []
  (let [env (into {} (System/get_env))
        root (BeamLisp/cwd)
        gen (get env "BL_CHECKOUT_SOURCE_GENERATION")
        vm (realm/open (d/realm-root root))]
    (report "println" (us 200 (fn [] (println 1))))
    (report "run_file-one" (us 100 (fn [] (BeamLisp/run_file "/tmp/w3-othman/one.bl"))))
    (report "run_file-noprint" (us 100 (fn [] (BeamLisp/run_file "/tmp/w3-othman/noprint.bl"))))
    (report "run-argv-noprint" (us 100 (fn [] (BeamLisp/with_argv (list "run" "/tmp/w3-othman/noprint.bl") (fn [] (cli/run-argv ["run" "/tmp/w3-othman/noprint.bl"]))))))
    (report "run-argv-version" (us 100 (fn [] (cli/run-argv ["version"]))))
    (report "with-project" (us 100 (fn [] (cli/with-project))))
    (report "mgr-run-nil" (us 100 (fn [] (mgr/run (:id vm) env (fn [] nil)))))
    (report "mgr-run-nil-noenv" (us 100 (fn [] (mgr/run (:id vm) (fn [] nil)))))
    (report "handle-noprint" (us 100 (fn [] (d/handle-in-vm ["run" "/tmp/w3-othman/noprint.bl"] root env))))))
(main)
