(ns w3-bench-project)
(require '[bl.env :as env])
(def root "/home/othman/code/undefine/beam-lisp--execution-protocol/.claude/worktrees/integration")
(defn us [n f] (let [t0 (erlang/monotonic_time :microsecond)] (dotimes [_ n] (f)) (/ (- (erlang/monotonic_time :microsecond) t0) (* 1.0 n))))
(def path (env/find root))
(println "find" (us 200 (fn [] (env/find root))))
(println "read" (us 200 (fn [] (File/read! path))))
(println "literal" (us 200 (fn [] (env/literal path))))
(let [v (:ok (env/literal path))]
  (println "normalize" (us 200 (fn [] (env/normalize v root path)))))
(println "project" (us 200 (fn [] (env/project root))))
(println "project-tmp" (us 200 (fn [] (env/project "/tmp/w3-othman/proj"))))
(println "read_all_data" (us 200 (fn [] (BeamLisp.Compiler/read_all_data (File/read! path)))))
(let [b (File/read! path)] (println "sha256" (us 200 (fn [] (crypto/hash :sha256 b)))))
