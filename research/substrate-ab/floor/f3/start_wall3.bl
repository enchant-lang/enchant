(ns w3-start-wall3)
(defn fns [mod names]
  (let [exports (erlang/apply mod :module_info (list :functions))]
    (filterv (fn [fa] (contains? names (erlang/atom_to_binary (elem fa 0) :utf8))) exports)))
(defn mfas [mod names]
  (map (fn [fa] (tuple mod (elem fa 0) (elem fa 1))) (fns mod names)))
(let [spec
      [(tuple :Elixir.BeamLisp.Ns.Body.Vm.Net (set ["serve-conn" "serve-requests" "handoff-connection" "watch-client"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Session (set ["request-handler" "dispatch-command" "run-command" "await-command" "note-realm!"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Io (set ["start-with-send" "finish"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Wire (set ["decode"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Bl.Daemon (set ["handle-in-vm" "client-environment" "run-client" "realm-root"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Bl.Dev-overlay (set ["sync!"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Realm (set ["open"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Manager (set ["run" "get-vm" "start"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Core (set ["run"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Scope (set ["with-vm"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Osenv (set ["with-env"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Bl.Cli (set ["run-argv" "run-argv-bound" "cmd-run" "dispatch" "dispatch-command" "parse-argv" "with-project"]))
       (tuple :Elixir.BeamLisp (set ["run_file" "with_cwd" "with_argv"]))
       (tuple :Elixir.BeamLisp.Env (set ["with_env"]))
       (tuple :Elixir.BeamLisp.Loader (set ["ensure_loaded" "with_load_path"]))
       (tuple :Elixir.BeamLisp.Compiler (set ["eval_string" "run_eval_forms" "eval_string_forms"]))
       (tuple :Elixir.BeamLisp.Refs (set ["spawn_owned" "await_owned_start"]))]
      list (Enum/flat_map spec (fn [p] (if (erlang/module_loaded (elem p 0)) (mfas (elem p 0) (elem p 1)) (list))))]
  (println "MFAS" (count list))
  (u9_wall/start list))
