(ns u9-load-all)
(defn load-probe [name]
  (let [mod (erlang/binary_to_atom name :utf8)
        dir "/tmp/u9/probe"]
    (compile/file (erlang/binary_to_list (str dir "/" name ".erl"))
                  (list (tuple :outdir (erlang/binary_to_list dir))))
    (code/add_patha (erlang/binary_to_list dir))
    (code/purge mod) (code/load_file mod)
    mod))
(doseq [n ["u9_wall" "u9_procs" "u9_sampler"]] (load-probe n))
(println "LOADED" (pr-str (map (fn [m] (erlang/module_loaded m)) [:u9_wall :u9_procs :u9_sampler])))
