(ns u9-start-wall2)
(defn fns [mod names]
  (let [exports (erlang/apply mod :module_info (list :functions))]
    (filterv (fn [fa] (contains? names (erlang/atom_to_binary (elem fa 0) :utf8))) exports)))
(defn mfas [mod names]
  (map (fn [fa] (tuple mod (elem fa 0) (elem fa 1))) (fns mod names)))
(let [spec
      [(tuple :Elixir.BeamLisp.Ns.Body.Vm.Session (set ["request-handler" "dispatch-command" "run-command" "start-heartbeat" "stop-heartbeat"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Io (set ["start-with-send" "finish"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Wire (set ["decode"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Bl.Daemon (set ["handle-in-vm" "client-environment" "run-client"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Realm (set ["open"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Manager (set ["run" "get-vm"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Core (set ["run"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Scope (set ["with-vm"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Osenv (set ["with-env"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Vm.Idle (set ["begin!" "end!" "running" "active-members"]))
       (tuple :Elixir.BeamLisp.Ns.Body.Bl.Cli (set ["run-argv" "cmd-run" "dispatch" "parse-argv"]))
       (tuple :Elixir.BeamLisp (set ["run_file" "init"]))
       (tuple :Elixir.BeamLisp.Env (set ["fork" "destroy" "with_env" "intern"]))
       (tuple :Elixir.BeamLisp.Loader (set ["ensure_loaded"]))
       (tuple :Elixir.BeamLisp.Compiler (set ["eval_string"]))
       (tuple :Elixir.BeamLisp.Refs (set ["spawn_owned" "await_owned_start"]))
       (tuple :Elixir.BeamLisp.SeqCursor (set ["new"]))
       (tuple :Elixir.BeamLisp.Execution (set ["register!"]))]
      list (Enum/flat_map spec (fn [p] (if (erlang/module_loaded (elem p 0)) (mfas (elem p 0) (elem p 1)) (list))))]
  (println "MFAS" (count list))
  (u9_wall/start list))
