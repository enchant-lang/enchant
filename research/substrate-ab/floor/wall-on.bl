(do (compile/file (erlang/binary_to_list "/tmp/claude-step0/floor/ab_wall.erl") (list (tuple :outdir (erlang/binary_to_list "/tmp/claude-step0/floor"))))
    (code/add_patha (erlang/binary_to_list "/tmp/claude-step0/floor"))
    (code/purge :ab_wall) (code/load_file :ab_wall)
    (println (erlang/function_exported :Elixir.BeamLisp.Env :module_info 0))
    (println (Enum/filter (Kernel/apply :Elixir.BeamLisp.Env :module_info (list :functions))
               (fn [fa] (String/contains? (erlang/atom_to_binary (erlang/element 1 fa)) "local_lock"))))
    (ab_wall/start (list (tuple :Elixir.BeamLisp.Env :wait_for_local_lock_retry 0)
                         (tuple :Elixir.BeamLisp.Env :wait_for_local_lock_release 1)
                         (tuple :Elixir.BeamLisp.Env :acquire_local_lock 1))))
