(ns u9-start-wall-deep)
(defn fns [mod]
  (erlang/apply mod :module_info (list :exports)))
(let [mods [:Elixir.BeamLisp :Elixir.BeamLisp.Compiler :Elixir.BeamLisp.Loader :Elixir.BeamLisp.Ns.Body.Bl.Cli
            :Elixir.BeamLisp.Ns.Body.Vm.Realm :Elixir.BeamLisp.Ns.Body.Vm.Manager :Elixir.BeamLisp.Ns.Body.Vm.Session
            :Elixir.BeamLisp.Ns.Body.Vm.Io :Elixir.BeamLisp.Ns.Body.Bl.Daemon :Elixir.BeamLisp.Ns.Body.Vm.Spec]
      skip #{:module_info :__info__}
      list (Enum/flat_map mods (fn [m] (if (erlang/module_loaded m)
                                         (Enum/flat_map (fns m) (fn [fa] (if (contains? skip (elem fa 0)) (list) (list (tuple m (elem fa 0) (elem fa 1))))))
                                         (list))))]
  (println "DEEP" (count list))
  (u9_wall/start list))
