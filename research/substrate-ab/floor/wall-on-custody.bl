(do (compile/file (erlang/binary_to_list "/tmp/u4-probe/ab_wall.erl") (list (tuple :outdir (erlang/binary_to_list "/tmp/u4-probe"))))
    (code/add_patha (erlang/binary_to_list "/tmp/u4-probe"))
    (code/purge :ab_wall) (code/load_file :ab_wall)
    (let [names #{"with_local_lock" "acquire_local_lock" "with_module_locks" "try_with_module_locks" "retain_code_components!" "register_code_callback!" "close_execution_registration!" "release_eval_module!" "run_code_callback_entry!" "wait_for_local_lock_release" "wait_for_local_lock_retry"}
          fs (Enum/filter (Kernel/apply :Elixir.BeamLisp.Env :module_info (list :functions))
               (fn [fa] (contains? names (erlang/atom_to_binary (erlang/element 1 fa)))))]
      (println fs)
      (ab_wall/start (Enum/map fs (fn [fa] (tuple :Elixir.BeamLisp.Env (erlang/element 1 fa) (erlang/element 2 fa)))))))
