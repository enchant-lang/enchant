(ns f2-bench (:require [compiler :as c] [lower :as sc] [vm.realm :as realm] [vm.manager :as mgr] [vm.index :as index] [vm.spec :as spec] [vm.paths :as paths] [bl.util :as u]))
(defn- installed-beam?
  "Whether `mname` is loaded with exactly these bytes. A retained module (a
   closure-producing form) is still loaded when a cached form is replayed, and
   loading identical bytes would churn the code server for nothing."
  [mname beam]
  (and (erlang/module_loaded mname)
       (let [parsed (beam_lib/md5 beam)]
         (and (erlang/is_tuple parsed) (erlang/== :ok (elem parsed 0))
              (erlang/== (elem (elem parsed 1) 1)
                         (erlang/apply mname :module_info (list :md5)))))))

(defn replay-retained-limit
  "How many replayed eval modules stay loaded at once, VM-wide."
  []
  64)

(defn replay-retained
  "The replayed eval modules this VM keeps loaded: `{:order (oldest … newest)
   :beams #{module → beam}}`. A persistent_term, read without copying on every
   replay and written only when a new module joins."
  []
  (persistent_term/get :bl_replay_retained_scratch {:order (list) :beams {}}))

(defn- retain-replay-module!
  "Keep `mname` (loaded from `beam`) loaded for later replays. Past
   `replay-retained-limit` the oldest leaves the table and goes through
   eval-anf's own retirement, so the code a replay keeps is bounded however
   many files a VM has run. Serialized: two first replays must not drop each
   other's entry, which would leave a module loaded that nothing releases."
  [mname beam]
  (erlang/apply :global :trans
    (list (tuple :bl_replay_retained_scratch (erlang/self))
          (fn []
            (let [table (replay-retained)
                  beams (:beams table)]
              (when-not (maps/is_key mname beams)
                (let [order (erlang/++ (:order table) (list mname))
                      excess (erlang/- (erlang/length order) (replay-retained-limit))
                      gone (if (erlang/> excess 0) (lists/sublist order excess) (list))
                      kept (if (erlang/> excess 0) (lists/nthtail excess order) order)]
                  (persistent_term/put :bl_replay_retained_scratch
                    {:order kept :beams (maps/put mname beam (maps/without gone beams))})
                  (lists/foreach (fn [m] (sc/release-eval-module! m)) gone))))))))

(defn run-eval-beam
  "Run a form from its compiled bytes, without compiling: load (unless the
   identical module is already loaded), then run/0. Returns run/0's value.

   A replayed module STAYS loaded (F2): a run cache replays the same modules
   request after request, and loading and retiring one per form per request
   was the largest part of an unchanged `bl run` in a warm VM (3.8 ms of the
   VM handler, research/checked-tiles/evidence/warm-floor-f1.json). Its
   lifetime is `retain-replay-module!`'s table, bounded VM-wide; a module that
   left it, or that something else retired, is loaded again here."
  [mname beam]
  (let [known (maps/get mname (:beams (replay-retained)) nil)]
    (when-not (and (erlang/=:= known beam) (erlang/module_loaded mname))
      (when-not (installed-beam? mname beam)
        (let [filename (erlang/binary_to_list (str mname ".beam"))
              result (code/load_binary mname filename beam)]
          (when (not= result (tuple :module mname))
            (throw (ex-info "lower/run-eval-beam: load failed" {:module mname :result result})))))
      (retain-replay-module! mname beam)))
  (erlang/apply mname :run (list)))


(defn- caller-scope-id []
  (let [r (BeamLisp.Env/lookup (tuple :manager_scope))]
    (if (and (erlang/is_tuple r) (erlang/== :ok (erlang/element 1 r))) (erlang/element 2 r) nil)))

(defn- start-services!
  "What a realm brings alive beyond its env and its wheel (the manager arms the
   wheel when it creates the realm): a cold index owner. Index-consuming
   commands build on that owner; opening a realm never indexes its sources."
  [vm]
  (index/start-for (:root vm) (:id vm) {:build false}))

(def ^:private OPENED
  "persistent_term key: {[root generation scope] → realm id} for realms opened
   with a source generation. Written once per new generation, read per request."
  (tuple :vm_realm :opened_scratch))

(def ^:private OPENED-LIMIT 64)

(defn- opened-key [root generation]
  [(Path/expand root) generation (caller-scope-id)])

(defn- reopen
  "The fast path of `open` (F2): the realm this (root, generation, scope) last
   opened, when the manager still holds it serving that generation. Equal
   generation means the client saw the same project bytes, env.bl and
   .env.local.bl included, so the spec, `observe-sources` (:current) and
   `mgr/open` (the existing realm) would answer what they answered then. A
   realm drained, closed, retired or moved to another generation since misses
   and takes the locked path. The index owner is still ensured, as there.

   Not covered by the generation: a git branch switch with identical bytes,
   which `spec/read` folds into a realm's id (`instance-of`). The realm keeps
   the id it was opened under until the bytes change or it is reopened."
  [root generation]
  (let [id (get (erlang/apply :persistent_term :get (list OPENED {})) (opened-key root generation))]
    (when (some? id)
      (let [vm (mgr/get-vm id)]
        (when (and (some? vm)
                   (not= :draining (:status vm))
                   (= generation (:source-generation vm))
                   (= (Path/expand root) (:root vm)))
          (start-services! vm)
          vm)))))

(defn- remember-opened! [root generation vm]
  (let [table (erlang/apply :persistent_term :get (list OPENED {}))
        k (opened-key root generation)]
    (when (not= (:id vm) (get table k))
      (erlang/apply :persistent_term :put
        (list OPENED (assoc (if (>= (count table) OPENED-LIMIT) {} table) k (:id vm)))))))

(defn open
  "Open a project under its physical identity's lifecycle lock. A changed
   project retires its executed definitions while the compiler VM stays warm.
   Pure document edits preserve an analyzer realm and its content cache.

   A request that carries the generation a realm was last opened under takes
   `reopen` instead: no env.bl read, no lock, no manager turns but one."
  ([root] (open root nil))
  ([root generation]
   (or (when generation (reopen root generation))
    (let [sp (cond-> (spec/read root) generation (assoc :source-generation generation))
          vm (global/trans (tuple (tuple :vm-realm-lifecycle (paths/fingerprint root)) (erlang/self))
               (fn []
                 (when generation
                   (let [decision (mgr/observe-sources sp generation)]
                     (when (map? decision) (mgr/drain (:retire decision)))))
                 (let [r (mgr/open sp)]
                   (start-services! (:vm r))
                   (:vm r))))]
      (when (and generation (map? vm) (= generation (:source-generation vm)))
        (remember-opened! root generation vm))
      vm))))


(defn- each [f xs] (doseq [x xs] (f x)) nil)

(defn- path->binary
  "A code-path entry as a binary. `code.get_path` answers charlists and the
   library store answers binaries; comparing the two needs one shape."
  [p]
  ; `unicode:characters_to_binary`, not `list_to_binary`: a code-path entry is
  ; a CHARLIST, and a directory named with a non-Latin-1 character (a test's
  ; tmp dir titled "compile → load") is not a valid iolist — measured: every
  ; `bl test` run in a VM that had such a path died in `list_to_binary`.
  (if (erlang/is_binary p) p (unicode/characters_to_binary p)))

(defn- stamp
  "`path`'s inode, mtime and ctime in whole seconds, or :absent."
  [path]
  (let [r (erlang/apply :file :read_file_info (list path (list (tuple :time :posix))))]
    (if (= :ok (elem r 0))
      (let [info (elem r 1)] [(elem info 11) (elem info 5) (elem info 6)])
      :absent)))

(defn- store-snapshot
  "What decides `library_search_paths`: the store's `ebin` directory, and each
   entry in it carrying this runtime's tag, with their stamps. A library that
   is added, removed or finishes compiling (`.compiled`, `ebin/`) moves the
   stamp of the directory it lands in, so an equal snapshot is an equal answer.
   Taken BEFORE the paths are listed: a change after it moves a stamp."
  []
  (let [root (BeamLisp.Loader/shared_cache_root "ebin")
        tag (BeamLisp.Loader/library_runtime_tag)
        entries (filter (fn [d] (String/ends_with? d tag)) (Path/wildcard (Path/join root "*")))]
    {:root root :root-stamp (stamp root)
     :entries (mapv (fn [d] [d (stamp d)]) entries)}))

(defn- snapshot-current? [snapshot]
  (and (= (:root-stamp snapshot) (stamp (:root snapshot)))
       (= (:root snapshot) (BeamLisp.Loader/shared_cache_root "ebin"))
       (every? (fn [[d st]] (= st (stamp d))) (:entries snapshot))))

(defn- snapshot-settled?
  "Recorded only when nothing in it changed in the last 2 s: a write inside
   the same second as the snapshot would not move a whole-second stamp."
  [snapshot]
  (let [now (erlang/system_time :second)
        stamps (cons (:root-stamp snapshot) (map second (:entries snapshot)))]
    (every? (fn [st] (or (= st :absent) (< (max (nth st 1) (nth st 2)) (- now 2)))) stamps)))

(def ^:private STORE-PATHS (tuple :bl_util :store_paths_scratch))

(defn register-store-paths!
  "Put the library STORE's compiled ebins on the VM code path. Idempotent: a
   directory already on the path is left alone, so this costs nothing when it
   runs twice and never leaves the path half-applied.

   Machine-global — it reads no command state, because it has none to read.
   Any `.bl` namespace may call a library module (`Jason` behind every `--json`,
   the store behind everything else), and the directories that hold them exist
   for the whole VM, not for one invocation. `run-argv` calls this on every
   entry, ahead of dispatch, so no command can reach a library module before
   the path that carries it is in place.

   Once per VM, not per request (F2): the registered set is remembered with the
   store snapshot it was listed under, and a request whose snapshot is
   unchanged, with those directories still on the code path, does nothing
   more. Listing the store and building a set of the whole code path cost a
   warm `bl run` about 0.8 ms."
  []
  (let [memo (erlang/apply :persistent_term :get (list STORE-PATHS nil))
        path (code/get_path)]
    (when-not (and (some? memo)
                   (snapshot-current? (:snapshot memo))
                   (every? (fn [d] (lists/member d path)) (:charlists memo)))
      (let [snapshot (store-snapshot)
            dirs (BeamLisp.Loader/library_search_paths)
            have (set (map path->binary path))]
        (each (fn [d]
                (when-not (contains? have (path->binary d))
                  (Code/prepend_path d)))
              dirs)
        (when (snapshot-settled? snapshot)
          (let [wanted (set (map path->binary dirs))
                charlists (distinct (filter (fn [c] (contains? wanted (path->binary c))) (code/get_path)))]
            ;; remembered only when every directory is found as the code path holds it
            (when (= (count charlists) (count dirs))
              (erlang/apply :persistent_term :put
                (list STORE-PATHS {:snapshot snapshot :charlists (vec charlists)})))))))
    :ok))



(def kenv (assoc (c/new-env "user") :ns "user"))
(defn- us [n f] (let [t0 (System/monotonic_time :microsecond)] (dotimes [_ n] (f)) (/ (- (System/monotonic_time :microsecond) t0) (* 1.0 n))))
(defn- median3 [g] (let [xs (sort [(g) (g) (g)])] (str (nth xs 1) " (" (first xs) "-" (last xs) ")")))
(let [N 200
      m (erlang/binary_to_atom (str "bl_f2_bench_" (System/unique_integer (list :positive))))
      beam (:beam (sc/eval-anf-record m (c/compile (BeamLisp.Reader/read_one "(str \"x\" 1)") kenv)))
      m2 (erlang/binary_to_atom (str "bl_f2_bench2_" (System/unique_integer (list :positive))))
      beam2 (:beam (sc/eval-anf-record m2 (c/compile (BeamLisp.Reader/read_one "(str \"x\" 1)") kenv)))
      root (str (System/tmp_dir!) "/f2-bench-" (System/unique_integer (list :positive)))]
  (File/mkdir_p! root)
  (File/write! (str root "/env.bl") "{:name \"f2-bench\" :paths []}")
  (mgr/start)
  (println "replay old us/call" (median3 (fn [] (us N (fn [] (sc/run-eval-beam m beam))))))
  (println "replay new us/call" (median3 (fn [] (us N (fn [] (run-eval-beam m2 beam2))))))
  (println "store-paths old us/call" (median3 (fn [] (us N (fn [] (u/register-store-paths!))))))
  (register-store-paths!)
  (println "store-paths new memo" (some? (erlang/apply :persistent_term :get (list STORE-PATHS nil))))
  (println "store-paths new us/call" (median3 (fn [] (us N (fn [] (register-store-paths!))))))
  (realm/open root "g1")
  (println "realm-open old us/call" (median3 (fn [] (us N (fn [] (realm/open root "g1"))))))
  (open root "g1")
  (println "realm-open new us/call" (median3 (fn [] (us N (fn [] (open root "g1"))))))
  (realm/close root)
  (File/rm_rf! root))
