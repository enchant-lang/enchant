(println (Agent/get :Elixir.BeamLisp.Env
  (fn [_]
    (let [t (fn [f] (let [a (erlang/monotonic_time :microsecond) r (f) b (erlang/monotonic_time :microsecond)] (- b a)))
          me (erlang/self) reg (tuple :bl-execution me (erlang/make_ref))]
      {:cache-size (if (== :undefined (ets/whereis :beam_lisp_callback_analysis_cache)) :none (ets/info :beam_lisp_callback_analysis_cache :size))
       :offers-match-object-us (t (fn [] (ets/match_object :beam_lisp_source_lease_domains (tuple :_ {:kind :execution-handoff :source reg}))))
       :owner-select-us (t (fn [] (ets/select :beam_lisp_source_lease_domains
                           (list (tuple (tuple (tuple me :_) :_) (list) (list :"$_"))
                                 (tuple (tuple :_ {:kind :execution-handoff}) (list) (list :"$_"))))))
       :heads-profile-select-us (t (fn [] (ets/select_count :beam_lisp_source_extent_heads
                           (list (tuple (tuple (tuple :source_execution_profile me :_) :_) (list) (list true))))))}))))
