;; Rewrites Gambit-dialect forms into Chez forms. Shared by translate.ss (ahead of
;; time) and chez-shim.ss (ab-eval, for Scheme the compiler evaluates at run time).
(define (split-formals fs)
  ;; returns (required optionals rest)
  (let loop ((fs fs) (req '()) (opt '()) (mode 'req) (rest #f))
    (cond ((null? fs) (values (reverse req) (reverse opt) rest))
          ((symbol? fs) (values (reverse req) (reverse opt) fs))
          ((eq? (car fs) 'ab:optional) (loop (cdr fs) req opt 'opt rest))
          ((eq? (car fs) 'ab:rest) (values (reverse req) (reverse opt) (cadr fs)))
          ((eq? mode 'opt) (loop (cdr fs) req (cons (if (pair? (car fs)) (car fs) (list (car fs) #f)) opt) mode rest))
          (else (loop (cdr fs) (cons (car fs) req) opt mode rest)))))
(define (gambit-formals? fs)
  (let loop ((fs fs)) (and (pair? fs) (or (memq (car fs) '(ab:optional ab:rest)) (loop (cdr fs))))))
(define (lambda-of formals body)
  (let-values (((req opt rest) (split-formals formals)))
    (let ((r (gensym "opt")))
      `(lambda (,@req . ,r)
         (let* ,(let loop ((opt opt) (acc '()) (r r))
                  (if (null? opt) (reverse (if rest (cons (list rest r) acc) acc))
                      (let ((r2 (gensym "opt")))
                        (loop (cdr opt)
                              (cons `(,r2 (if (pair? ,r) (cdr ,r) '()))
                                    (cons `(,(caar opt) (if (pair? ,r) (car ,r) ,(cadar opt))) acc))
                              r2))))
           ,@body)))))
(define (ctype t)
  (cond ((equal? t '(pointer void)) 'uptr)
        ((assq t '((UTF-8-string . utf-8) (unsigned-long-long . unsigned-64) (long-long . integer-64)
                   (int . int) (void . void) (unsigned-int . unsigned-int) (long . long) (double . double)))
         => cdr)
        (else (error 'ctype "unmapped C type" t))))
;; Gambit's #!void literal is read as the symbol ab:void-literal. Chez cannot write
;; or read a void constant, so quoted data containing it is wrapped in
;; ab-void-subst (chez-shim.ss), which substitutes (void) once per literal.
(define (has-void? x)
  (cond ((eq? x 'ab:void-literal) #t)
        ((pair? x) (or (has-void? (car x)) (has-void? (cdr x))))
        ((vector? x) (let loop ((i 0)) (and (< i (vector-length x)) (or (has-void? (vector-ref x i)) (loop (+ i 1))))))
        (else #f)))
(define (xform x)
  (cond ((eq? x 'ab:void-literal) '(void))
        ((not (pair? x)) (ab-rename x))
        ((eq? (car x) 'c-lambda)
         `(foreign-procedure ,(cadddr x) ,(map ctype (cadr x)) ,(ctype (caddr x))))
        ((and (eq? (car x) 'define) (pair? (cdr x)) (pair? (cadr x)) (gambit-formals? (cdadr x)))
         `(define ,(caadr x) ,(lambda-of (cdadr x) (map xform (cddr x)))))
        ((and (eq? (car x) 'lambda) (pair? (cdr x)) (gambit-formals? (cadr x)))
         (lambda-of (cadr x) (map xform (cddr x))))
        ((eq? (car x) 'quote) (if (has-void? (cadr x)) `(ab-void-subst ,x) x))
        (else (let loop ((x x)) (cond ((pair? x) (cons (xform (car x)) (loop (cdr x)))) (else (ab-rename x)))))))
;; Gambit procedures whose Chez namesakes have different signatures.
(define renames '((error . ab-error) (with-output-to-string . ab-with-output-to-string)
                  (getenv . ab-getenv) (map . ab-map) (call-with-output-file . ab-call-with-output-file) (eval . ab-eval)))
(define (ab-rename x) (cond ((and (symbol? x) (assq x renames)) => cdr) (else x)))
