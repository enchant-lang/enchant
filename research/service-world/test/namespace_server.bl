(ns auth.namespace-fixture
 (:require [auth] [auth.interface :as interface] [auth.identity :as identity]
           [auth.transport :as transport] [auth.authority :as private] [auth.contract :as contract] [web]))
(def root (System/fetch_env! "SERVICE_WORLD_FIXTURE_DIR"))
(def pair (auth/keypair))
(def token
 (identity/issue pair {:subject "person:alice" :application "qa-app" :kind :person :audience "qa/world"
                       :expires-at (+ (System/system_time :millisecond) 300000)
                       :rights [["demo.catalog" "services-in" "project-a"]
                                ["demo.catalog" "count-in" "project-a"]
                                ["demo.catalog" "label" "project-a"]]}))
(File/write! (str root "/token") (auth/encode-base64 token))
(File/chmod! (str root "/token") 384)
(def authority-file (str root "/authority.edn"))
(File/write! authority-file (pr-str {:issuer-public (Base/url_encode64 (auth/public pair)) :revoked #{} :enabled true
                                    :memberships {"person:alice" {"project-a" #{:operator}}}
                                    :token-id (Base/url_encode64 (first (auth/revocation-ids token)))}))
(File/chmod! authority-file 384)
(def provider
 (interface/open
  {:file (str root "/provider.bl") :world "qa/world"
   :roles (fn [principal resource]
             (if (and (:enabled (private/private-data authority-file))
                      (= "person:alice" (:subject principal)) (= "project-a" resource)) #{:operator} #{}))
   :readers {:catalog (fn [_ resource] [{"title" resource}])}
   :effects {:counter (fn [_ _ _] (File/write! (str root "/effect-ran") "ran") {"receipt" "r1"})}}))
(File/write! (str root "/interface.edn") (pr-str (:manifest provider)))
(File/write! (str root "/issuer.edn") (pr-str {:public (Base/url_encode64 (auth/public pair))
                                              :private (Base/url_encode64 (:private pair))}))
(File/chmod! (str root "/issuer.edn") 384)
(web/serve {:port (String/to_integer (System/fetch_env! "PORT")) :ip (tuple 127 0 0 1) :log :off
            :plug (transport/handler provider (transport/authority-authenticator authority-file "qa/world"))})
(File/write! (str root "/ready") "ready")
(try (receive :stop :ok) (finally (interface/close! provider)))
