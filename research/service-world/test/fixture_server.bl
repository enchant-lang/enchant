;; Isolated cross-SDK fixture. The harness owns the directory and this VM.
(ns service-world.fixture-server
 (:require [service-world.core :as world] [service-world.station :as station]
           [service-world.http :as http] [web]))
(def root (System/fetch_env! "SERVICE_WORLD_FIXTURE_DIR"))
(def authority (str root "/authority.edn"))
(def provider
 (station/provider {:world "qa/world"
                    :inventory (fn [] (world/decode (File/read! (str root "/catalog.json")) world/MAX-RESPONSE))}))
(web/serve {:port (String/to_integer (System/fetch_env! "PORT")) :ip (tuple 127 0 0 1) :log :off
            :plug (http/handler provider #(http/authenticate authority %))})
(File/write! (str root "/ready") "ready")
(receive :stop :ok)
