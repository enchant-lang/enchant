(ns auth.namespace-remote-test
 (:require [auth.imports :as imports] [auth.interface] [auth.transport :as transport]
           [auth.authority :as private] [auth.contract :as contract] [auth.delegation :as delegation] [auth.identity :as identity] [env]))
(def root (System/fetch_env! "SERVICE_WORLD_FIXTURE_DIR"))
(def provider {:world "qa/world" :manifest (contract/read! (str root "/interface.edn"))})
(defn with-client [action]
 (let [consumer (env/fork)
       endpoint (transport/endpoint {:allow-loopback-http? true :url (System/fetch_env! "SERVICE_WORLD_FIXTURE_URL")
                    :token-file (str root "/token")
                    :issuer-public (:issuer-public (private/private-data (str root "/authority.edn")))})
       raw (fn [code] (env/with-env consumer
                       #(BeamLisp.Compiler/eval_string code (BeamLisp.Compiler/new_env "consumer") "ordinary-app")))
       run (fn [code] (identity/with-verified {:subject "person:alice" :application "qa-app" :kind :person} #(raw code)))
       failure (fn [code] (try (run code) nil (catch error (:kind (ex-data error)))))]
  (try
   (env/with-env consumer
    #(imports/bind! 'remote.catalog {:namespace "demo.catalog" :version 1 :only '[services-in count-in label change!]}
       provider endpoint))
   (run "(ns consumer (:require [remote.catalog :as catalog]))")
   (action run failure raw)
   (finally (env/destroy consumer)))))
(deftest ordinary-app-code-runs-over-authenticated-rpc-between-sdk-versions
 (with-client
  (fn [run _ _raw]
   (is (= [{"title" "project-a"}] (run "(catalog/services-in \"project-a\")")))
   (is (= 1 (run "(catalog/count-in \"project-a\")")))
   (is (= "A" (run "(catalog/label \"project-a\" {\"title\" \"A\"})"))))))
(deftest signed-authority-cannot-be-widened-by-the-app
 (with-client
  (fn [_ failure _raw]
   (is (= :auth/denied (failure "(catalog/services-in \"project-b\")")))
   (is (= :auth/denied (failure "(catalog/change! \"project-a\" {\"value\" 1})")))
   (is (not (File/exists? (str root "/effect-ran")))))))
(deftest current-roles-and-revocation-are-read-by-the-independent-vm
 (with-client
  (fn [run failure _raw]
   (let [file (str root "/authority.edn") authority (private/private-data file)]
    (try
     (File/write! file (pr-str (assoc authority :enabled false)))
     (is (= :auth/denied (failure "(catalog/services-in \"project-a\")")))
     (File/write! file (pr-str (assoc authority :revoked #{(:token-id authority)})))
     (is (= :auth/unauthenticated (failure "(catalog/services-in \"project-a\")")))
     (File/write! file (pr-str (assoc authority :revoked #{"placeholder"})))
     (is (= 1 (run "(catalog/count-in \"project-a\")")))
     (File/write! file (pr-str (dissoc authority :revoked)))
     (is (= :auth/unauthenticated (failure "(catalog/services-in \"project-a\")")))
     (finally (File/write! file (pr-str authority))))))))
(deftest one-users-delegation-is-never-borrowed-by-another-user
 (with-client
  (fn [_ _failure raw]
   (identity/with-verified {:subject "person:bob" :application "qa-app" :kind :person}
    #(is (= :auth/denied
            (try (raw "(catalog/services-in \"project-a\")") nil
             (catch error (:kind (ex-data error))))))))))
(deftest stale-provider-source-cannot-reuse-its-old-evidence
 (with-client
  (fn [_ failure _raw]
   (let [file (str root "/provider.bl") source (File/read! file)]
    (try
     (File/write! file (str source "\n; new source generation\n"))
     (is (= :auth/stale-code (failure "(catalog/services-in \"project-a\")")))
     (finally (File/write! file source)))))))
(deftest host-broker-issues-per-call-credentials-without-app-token-handling
 (let [broker (delegation/broker {:issuer-file (str root "/issuer.edn") :authority-file (str root "/authority.edn")
                                 :application "qa-app" :world "qa/world" :namespace "demo.catalog"
                                 :exports #{"services-in" "count-in"}})
       endpoint (transport/endpoint {:allow-loopback-http? true :url (System/fetch_env! "SERVICE_WORLD_FIXTURE_URL") :token-for broker
                                     :issuer-public (:issuer-public (private/private-data (str root "/authority.edn")))})
       principal {:subject "person:alice" :application "qa-app" :kind :person}
       request (auth.interface/request provider "services-in" ["project-a"])]
  (identity/with-verified principal
   (fn []
    (is (= [{"title" "project-a"}] (transport/result! request (endpoint request))))
    (is (= :auth/denied (try (endpoint (auth.interface/request provider "services-in" ["project-b"])) nil
                              (catch error (:kind (ex-data error))))))))
  (is (= :auth/denied (try (endpoint request) nil (catch error (:kind (ex-data error))))))))
(run-tests)
