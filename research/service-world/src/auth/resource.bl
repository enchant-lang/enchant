;; The only effect ports admitted by the namespace prototype. Handlers belong
;; to the authenticated provider invocation, never to a value from the wire.
(ns auth.resource (:require [effect]))
(defn read [resource]
 (effect/call :auth/resources :read [resource]
  (fn [] (throw (ex-info "No authenticated resource scope" {:kind :auth/denied})))))
(defn perform! [resource value]
 (effect/call :auth/resources :perform [resource value]
  (fn [] (throw (ex-info "No authenticated effect scope" {:kind :auth/denied})))))
