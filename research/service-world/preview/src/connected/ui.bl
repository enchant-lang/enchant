(ns connected.ui (:require [connected.model :as model] [machine.ui :as gather]))
(defn team? [ctx] (= "team" (:side ctx)))
(defn url [ctx view] (str "/" (:side ctx) "?view=" view))
(defn link [ctx view title] [:a {:class "preview-link" :href (url ctx view)} title])
(defn hidden [key value] [:input {:type "hidden" :name key :value (str value)}])
(defn action
 ([ctx op title] (action ctx op title {} nil))
 ([ctx op title values] (action ctx op title values nil))
 ([ctx op title values fields]
  (let [allowed (or (= "operator" (:role ctx)) (contains? model/read-ops op) (contains? model/fixture-ops op))]
   [:form {:method "post" :action "/action" :class "preview-action" :data-operation op}
    (hidden "csrf" (:csrf ctx)) (hidden "side" (:side ctx)) (hidden "view" (:view ctx))
    (hidden "basis" (get-in ctx [:world :revision]))
    (hidden "request" (str "r-" (erlang/unique_integer (list :positive :monotonic))))
    (hidden "op" op)
    (for [[k v] values] (hidden (name k) v))
    fields
    [:button {:type "submit" :class (if (team? ctx) "button small" "preview-key") :disabled (not allowed)} title]])))
(defn field [label key value & [kind]]
 [:label {:class "preview-field"} [:span label]
  (if (= kind "textarea") [:textarea {:name key :rows 5 :required true :maxlength 4000} value]
   [:input {:name key :type (or kind "text") :value value :required true :maxlength 180}])])
(defn pill [ctx text & [state]]
 (if (team? ctx) (gather/pill text (case state "good" "mint" "bad" "peach" "lilac"))
  [:span {:class (str "preview-stamp " (or state "neutral"))} text]))
(defn panel [ctx title content]
 (if (team? ctx) (gather/panel title content {:class "panel preview-panel"})
  [:section {:class "preview-panel station-panel"} [:header [:h2 title]] [:div {:class "preview-panel-body"} content]]))
(defn stack [& items] (into [:div {:class "preview-stack"}] items))
(defn actions [& items] (into [:div {:class "preview-actions"}] items))
(defn fact [label value] [:div {:class "preview-fact"} [:span label] [:strong (str value)]])
(defn stat [label value hint]
 [:article {:class "preview-stat"} [:span label] [:strong (str value)] [:small hint]])
(defn empty [ctx title text]
 (panel ctx title [:p {:class "muted"} text]))
