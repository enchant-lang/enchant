#!/usr/bin/env python3
"""Check only committed projection sources on one retained SDK; build no SDK."""
import argparse
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--sdk', type=Path, required=True)
parser.add_argument('--revision', default='HEAD')
parser.add_argument('--canonical', action='store_true', help='Qualify original namespaces on an SDK containing these exact sources')
parser.add_argument('--out', type=Path, required=True)
args = parser.parse_args()
sdk = args.sdk.resolve(strict=True)
if not re.fullmatch(r'/nix/store/[a-z0-9]{32}-[^/]+', str(sdk)):
    parser.error('SDK must be an existing immutable Nix product')
metadata_bytes = (sdk / 'artifact.json').read_bytes()
metadata = json.loads(metadata_bytes)
if (metadata.get('version'), metadata.get('kind')) != (1, 'sdk'):
    parser.error('Expected an SDK selection')
revision = subprocess.check_output(['git', 'rev-parse', '--verify', '--end-of-options',
                                    args.revision + '^{commit}'], cwd=ROOT, text=True).strip()

def committed(name):
    path = PurePosixPath(name)
    if (path.is_absolute() or '..' in path.parts or not path.parts
            or path.parts[0] not in ('priv', 'test', 'scripts')):
        raise ValueError('Invalid projection source path')
    return subprocess.check_output(['git', 'show', revision + ':' + name], cwd=ROOT)

manifest_name = 'scripts/projection-preflight.json'
manifest_bytes = committed(manifest_name)
manifest = json.loads(manifest_bytes)
files = [manifest_name, manifest['helper'], manifest['driver']]
files += [row[0] for row in manifest['sources']] + manifest['tests'] + manifest.get('assets', [])
if len(files) != len(set(files)) or not 1 <= len(files) <= 72:
    raise ValueError('Projection inventory must be finite and unique')
sources = {name: committed(name) for name in files}
if sum(map(len, sources.values())) > 1024 * 1024:
    raise ValueError('Focused source fixture exceeds 1 MiB')
# Source fixtures may delegate unchanged cache infrastructure to a qualified
# SDK, whose native ownership cannot be recreated by a private namespace.
cache_name = 'priv/lib/data/bounded-cache.bl'
if not args.canonical and cache_name in sources:
    candidate = sources[cache_name]
    installed = (sdk / 'image' / cache_name).read_bytes()
    before = candidate.index(b'(defn computation-revision')
    old_before = installed.index(b'(defn computation-revision') if b'(defn computation-revision' in installed else installed.index(b'(defn value\n')
    end = candidate.index(b'(defn clear!')
    old_end = installed.index(b'(defn clear!')
    if candidate[:before] != installed[:old_before] or candidate[end:] != installed[old_end:]:
        raise ValueError('Changed cache infrastructure requires canonical SDK qualification')
if args.canonical:
    for name in [row[0] for row in manifest['sources']] + manifest.get('assets', []):
        installed = sdk / 'image' / name
        if not installed.is_file() or installed.read_bytes() != sources[name]:
            parser.error('Canonical SDK source differs from committed input: ' + name)
output = args.out.resolve()
if output.exists():
    parser.error('Keep existing receipts; select a fresh --out path')
output.parent.mkdir(parents=True, exist_ok=True)
scope = ('canonical-sdk-qualification' if args.canonical else 'current-source-private-namespace-preflight')
receipt = {'revision': revision, 'scope': scope,
           'sdk': str(sdk), 'sdk_descriptor_sha256': hashlib.sha256(metadata_bytes).hexdigest(),
           'SDK_production_requested': False,
           'cache_infrastructure': ('exact-sdk-source' if args.canonical else 'unchanged-sdk-owner-with-candidate-client'),
           'files': {name: hashlib.sha256(body).hexdigest() for name, body in sources.items()}}
with tempfile.TemporaryDirectory(prefix='projection-preflight-') as temporary:
    frozen = Path(temporary) / 'source'
    for name, body in sources.items():
        path = frozen / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(body)
    result = Path(temporary) / 'result.json'
    command = ['systemd-run', '--user', '--quiet', '--wait', '--pipe', '--collect',
               '--expand-environment=no', '--working-directory=' + str(frozen),
               '--property=MemoryMax=2G', '--property=MemorySwapMax=0', '--property=CPUQuota=200%',
               '--property=RuntimeMaxSec=300',
               '--setenv=ERL_FLAGS=+S 2:2 +SDcpu 1:1 +SDio 1',
               '--setenv=BL_TEST_SOURCE_ROOT=' + str(frozen),
               '--setenv=PROJECTION_PREFLIGHT_OUTPUT=' + str(result),
               '--setenv=PROJECTION_PREFLIGHT_MODE=' + ('canonical' if args.canonical else 'source'),
               str(sdk / 'bin/bl'), '--cold', 'run', str(frozen / manifest['driver'])]
    run = subprocess.run(command, timeout=320)
    receipt['exit'] = run.returncode
    receipt['result'] = json.loads(result.read_text()) if result.exists() else {'status': 'no-result'}
    receipt['frozen_inputs_unchanged'] = all((frozen / name).read_bytes() == body for name, body in sources.items())
    receipt['status'] = ('passed' if run.returncode == 0 and receipt['result']['status'] == 'passed'
                         and receipt['frozen_inputs_unchanged'] else 'failed')
output.write_text(json.dumps(receipt, indent=2) + '\n')
print(output)
raise SystemExit(0 if receipt['status'] == 'passed' else 1)
