;; Private candidate namespaces on an existing immutable SDK, never its globals.
(BeamLisp.Env/add_search_path (System/fetch_env! "BL_TEST_SOURCE_ROOT"))
(ns tooling.inspector-preview (:require [test.support.projection-candidate :as candidate]))
(candidate/with-candidate*
  (fn [_entries rename]
    (let [source (File/read! (Path/join (System/fetch_env! "BL_TEST_SOURCE_ROOT") "examples/tooling/work-observatory.bl"))]
      ;; The retained SDK attests its framework classes; keep its live.app socket.
      ;; Only ordinary candidate functions decorate that canonical framework.
      (BeamLisp/eval
        (-> (rename source)
          (String/replace (str "[" (rename "live.app") " :as app]") "[live.app :as app]")
          (String/replace "(app/serve application"
            (str "(app/serve (" (rename "live.inspector")
                 "/attach application {:enabled? true :authorize (fn [me] (= :local-developer me)) :work {:example jobs} :projections {:totals (projection/reader totals)}})"))
          (String/replace "(serve/port 4056)" "4057")))
      (println "inspector candidate ready on 4057")
      (receive :stop nil))))
