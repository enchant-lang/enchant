#!/usr/bin/env python3
# Inclusive cost and direct callees of named BL functions from stacks.term files:
#   stacks FILE[,FILE] "AOT:image_sdk_entry!" "Emit:collect_execution_entries"
import re,sys,collections
def load(p):
    t=open(p).read()
    S=int(re.search(r'samples => (\d+)',t).group(1))
    out=[]
    for m in re.finditer(r'\{\[((?:"[^"]*",?\s*)*)\],\s*(\d+)\}',t):
        fr=re.findall(r'"([^"]*)"',m.group(1)); out.append((fr,int(m.group(2))))
    return S,out
files=sys.argv[1].split(',')
stacks=[];S=0
for f in files:
    s,o=load(f); S+=s; stacks+=o
print('samples',S,'distinct stacks',len(stacks))
for P in sys.argv[2:]:
    inc=sum(n for fr,n in stacks if P in fr)
    print('\n== %s inclusive %d (%.1f%%)'%(P,inc,100*inc/S))
    kids=collections.Counter(); own=0
    for fr,n in stacks:
        if P in fr:
            i=fr.index(P)
            if i==0: own+=n
            else: kids[fr[i-1]]+=n
    print('   own',own)
    for k,v in kids.most_common(8): print('   %5d %4.1f%% %s'%(v,100*v/S,k))
