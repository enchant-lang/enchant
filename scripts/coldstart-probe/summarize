#!/usr/bin/env python3
# Summarize a sampler.term: summarize FILE [OWN_N] [INCLUSIVE_N]
import re,sys,collections
t=open(sys.argv[1]).read()
sam=int(re.search(r'samples => (\d+)',t).group(1)); el=int(re.search(r'elapsed => (\d+)',t).group(1))
def parse(sec):
    m=re.search(sec+r' =>\s*\[(.*?)\](?:,\n|\}\.)',t,re.S)
    rows=re.findall(r'\{\{"([^"]*)",\s*"([^"]*)",\s*(\d+)\},\s*(\d+)\}',m.group(1))
    agg=collections.Counter()
    for mod,name,a,n in rows: agg[(mod,name)]+=int(n)
    return agg
own=parse('own'); incl=parse('incl')
print('samples',sam,'elapsed ms',el)
print('--own top'); 
for k,v in own.most_common(int(sys.argv[2]) if len(sys.argv)>2 else 15): print(v,k)
print('--incl (BL fns)')
for k,v in incl.most_common(int(sys.argv[3]) if len(sys.argv)>3 else 50): print(v,k)
