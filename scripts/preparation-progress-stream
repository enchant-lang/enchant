#!/usr/bin/env bash
# Preserve the private stderr log; expose only the native closed progress frames.
set -uo pipefail
preparation_log=${1:?private stderr log required}
: > "$preparation_log"
while IFS= read -r preparation_line || [[ -n "$preparation_line" ]]; do
  printf '%s\n' "$preparation_line" >> "$preparation_log" || true
  case "$preparation_line" in
    'PREPARE '*) printf '%s\n' "$preparation_line" >&2 || true ;;
  esac
done
