#!/usr/bin/env python3
"""N4d: a development SDK for a pinned host edit, built on Work in seconds.

    scripts/dev-sdk [--from SDK] [--out DIR] [--select]

Compiles only the edited `priv/host` units, with the base SDK's own compiler in
one cold VM of that SDK (no QEMU, no Nix producer, no checkout launcher), and
assembles a store product that links every other file of the base by
reference (scripts/dev-sdk.nix). The beams are compiled with the producer's exact
options and root-relative source label, so an unchanged unit is the store
SDK's beam byte for byte; the floor manifest, `.bl-host-stage` and
`seed-metadata.term` are regenerated exactly as the producer writes them.
Library units, `sdk-code.term`, `precompiled.term` and `image-metadata.term`
are the base's: a host edit that keeps the library-runtime key (comments,
labels) changes none of them in the release SDK either.

`--select` records the product as this tree's SDK under its exact engine
fingerprint, so `./bin/bl` runs on it without preparing. The product carries
`dev` in artifact.json; the release path never takes it as a predecessor and
CI refuses it. `scripts/prepare-checkout-sdk` (no arguments) still builds the
qualified SDK of the tree. Anything but a pinned host edit is refused with the
release path's name.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
RELEASE = "scripts/prepare-checkout-sdk"


def fail(message, code=69):
    print(f"dev-sdk: {message}", file=sys.stderr)
    raise SystemExit(code)


def run(command, **kwargs):
    return subprocess.run(command, check=True, text=True, stdout=subprocess.PIPE, **kwargs).stdout.strip()


class Clock:
    def __init__(self):
        self.started = time.monotonic()
        self.last = self.started
        self.phases = {}

    def phase(self, name):
        now = time.monotonic()
        self.phases[name] = round(now - self.last, 3)
        self.last = now

    def total(self):
        return round(time.monotonic() - self.started, 3)


def codegen_leaves(root):
    """Host sources the compiler key hashes (aot_cache.bl `pinned_host_source`)
    and the module that computes it. An edit there rotates every unit's key."""
    text = (root / "priv/host/aot_cache.bl").read_text()
    body = text.split("(defn- pinned_host_source", 1)[1].split("\n(defn", 1)[0]
    return set(re.findall(r'"([a-z_]+\.bl)"', body)) | {"aot_cache.bl"}


def host_table_leaves(root):
    text = (root / "priv/build/seed.bl").read_text()
    body = text.split("(defn host-sources", 1)[1].split("\n(defn", 1)[0]
    return set(re.findall(r'\(Path/join host-dir "([a-z_]+\.bl)"\)', body))


def classify(root, changed):
    """(host leaves to compile, refusals)."""
    codegen = codegen_leaves(root)
    table = host_table_leaves(root)
    hosts, refused = [], []
    for path in changed:
        if path.startswith("priv/host/") and path.count("/") == 2:
            leaf = path.rsplit("/", 1)[1]
            if leaf in codegen:
                refused.append(f"{path} feeds the compiler key; every SDK unit recompiles: use {RELEASE}")
            elif leaf not in table:
                refused.append(f"{path} is not a pinned host unit (priv/build/seed.bl host-sources): use {RELEASE}")
            elif not (root / path).is_file():
                refused.append(f"{path} was deleted: use {RELEASE}")
            else:
                hosts.append(leaf)
        elif path.startswith("priv/boot/"):
            refused.append(f"{path} is the boot compiler (P/B/C generations and the library recompile): use {RELEASE}")
        elif path.startswith(("priv/lib/", "priv/std/")):
            refused.append(f"{path} is a library source: the warm VM reloads it over the SDK (U15), "
                           f"or {RELEASE} builds it in")
        else:
            refused.append(f"{path} is an engine input outside pinned hosts: use {RELEASE}")
    return sorted(hosts), refused


def first_extent(path):
    """The physical offset of a file's first extent (FIEMAP), or None."""
    import fcntl
    import struct
    try:
        descriptor = os.open(path, os.O_RDONLY)
    except OSError:
        return None
    try:
        request = bytearray(struct.pack("=QQLLLL", 0, 0xFFFFFFFFFFFFFFFF, 1, 0, 1, 0) + bytes(56))
        fcntl.ioctl(descriptor, 0xC020660B, request)
        return struct.unpack_from("=Q", request, 40)[0] if struct.unpack_from("=L", request, 20)[0] else None
    except OSError:
        return None
    finally:
        os.close(descriptor)


def retained_source(root, base):
    """The captured engine source the base SDK was selected with."""
    for link in sorted((root / ".bl/sdks").glob("*/result-sdk")):
        if link.is_symlink() and Path(os.path.realpath(link)) == base:
            source = link.parent / "source-engine"
            if source.is_symlink():
                return Path(os.path.realpath(source))
    fail(f"no retained engine source for base SDK {base} in {root}/.bl/sdks; select it once with {RELEASE}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--root", type=Path, default=ROOT, help="checkout (default: this script's)")
    parser.add_argument("--from", dest="base", type=Path,
                        help="qualified base SDK selection (default: ROOT/.bl/sdks/current-sdk; a dev SDK names its base)")
    parser.add_argument("--out", type=Path, help="scratch directory (default: ROOT/.bl/dev-sdk)")
    parser.add_argument("--select", action="store_true", help="select the product for ROOT's ./bin/bl")
    args = parser.parse_args()
    clock = Clock()
    root = args.root.resolve(strict=True)
    base = Path(os.path.realpath(args.base or root / ".bl/sdks/current-sdk"))
    metadata = json.loads((base / "artifact.json").read_text())
    if "dev" in metadata:
        base = Path(metadata["dev"]["base"])
        metadata = json.loads((base / "artifact.json").read_text())
    if metadata.get("kind") != "sdk" or not re.fullmatch(r"/nix/store/[0-9a-z]{32}-[^/]+", str(base)):
        fail(f"{base} is not an immutable SDK selection")
    out = (args.out or root / ".bl/dev-sdk").resolve()
    source = retained_source(root, base)
    changed = [line for line in run([sys.executable, str(root / "scripts/sdk-inputs"), "--root", str(root),
                                     "--changed", str(source)]).splitlines() if line]
    clock.phase("diff")
    hosts, refused = classify(root, changed)
    if refused:
        for line in refused:
            print(f"dev-sdk: refused: {line}", file=sys.stderr)
        fail("a dev SDK covers pinned priv/host edits only; nothing was built", 65)
    if not hosts:
        fail(f"the tree's engine inputs equal base SDK {base}; it needs no dev SDK", 0)

    # One cold VM of the BASE SDK compiles the edited units and the seed rows.
    if out.exists():
        shutil.rmtree(out)
    stage = out / "stage"
    (stage / "bootstrap/seed").mkdir(parents=True)
    seed = Path(os.path.realpath(base / "image/priv/bootstrap/seed"))
    for name in os.listdir(seed):
        (stage / "bootstrap/seed" / name).symlink_to(seed / name)
    request = out / "request.json"
    request.write_text(json.dumps({"host-dir": str(root / "priv/host"), "out": str(out / "beams"),
                                   "base-host": os.path.realpath(base / "image/priv/host"),
                                   "seed": str(seed), "stage": str(stage), "leaves": hosts}))
    environment = dict(os.environ, DEV_SDK_REQUEST=str(request), XDG_CACHE_HOME=str(out / "cache"),
                       BL_DAEMON="off")
    for key in ("BL_CHECKOUT_ROOT", "BL_CHECKOUT_COLD", "BL_CHECKOUT_SDK_INPUTS", "BL_SDK_PRODUCT", "BL_ROOT"):
        environment.pop(key, None)
    (out / "vm").mkdir()
    completed = subprocess.run([str(base / "bin/bl-cold"), "run", str(ROOT / "scripts/dev-sdk-compile.bl")],
                               cwd=out / "vm", env=environment, text=True, capture_output=True)
    lines = [line for line in completed.stdout.splitlines() if line.startswith("DEV-SDK-RESULT ")]
    if completed.returncode or not lines:
        sys.stderr.write(completed.stdout[-4000:] + completed.stderr[-4000:])
        fail("compiling the edited host units on the base SDK failed")
    result = json.loads(lines[-1].split(" ", 1)[1])
    clock.phase("compile")

    # The floor files a host edit changes in a release image (measured on the
    # 2026-11-24 delay.bl-comment SDK against its predecessor: these seven).
    files = out / "delta/files"
    for directory in ("ebin", "priv/bootstrap/seed", "priv/host"):
        (files / directory).mkdir(parents=True)
    manifest = (stage / "bootstrap/seed/manifest.term").read_bytes()
    for unit in result["units"]:
        beam = (out / "beams" / unit["module"]).read_bytes()
        (files / "ebin" / unit["module"]).write_bytes(beam)
        (files / "priv/bootstrap/seed" / unit["module"]).write_bytes(beam)
    for leaf in hosts:
        shutil.copyfile(root / "priv/host" / leaf, files / "priv/host" / leaf)
    (files / "ebin/manifest.term").write_bytes(manifest)
    (files / "priv/bootstrap/seed/manifest.term").write_bytes(manifest)
    stamp = (base / "image/ebin/.bl-host-stage").read_text().split(" ", 1)
    (files / "ebin/.bl-host-stage").write_text(hashlib.sha256(manifest).hexdigest() + " " + stamp[1])
    shutil.copyfile(stage / "seed-metadata.term", files / "priv/seed-metadata.term")
    kept = all(unit["code-identical"] for unit in result["units"])
    for unit in result["units"]:
        if not unit["reproducible"]:
            print(f"dev-sdk: note: {unit['module']} compiles differently here than in the release producer; "
                  "its dev beam runs the edited code but is not byte-equal to a release build's", file=sys.stderr)
    info = {"hosts": hosts, "units": result["units"], "manifest-sha256": result["manifest-sha256"],
            "library": "restored: library-runtime key holds" if kept
            else "kept from base: an executed-code edit; the release path recompiles the library"}
    (out / "delta/dev.json").write_text(json.dumps(info, sort_keys=True) + "\n")
    clock.phase("delta")

    python = Path(os.path.realpath(shutil.which("python3"))).parents[1]
    product = run(["nix-build", str(ROOT / "scripts/dev-sdk.nix"), "--argstr", "base", str(base),
                   "--argstr", "delta", str(out / "delta"), "--argstr", "python", str(python),
                   # On Work, in its sandbox: linking 585 MB of base image on the
                   # Build host and copying it back costs ~20 s and the disk;
                   # here copy_file_range shares the base's btrfs extents.
                   "--max-jobs", "1", "--builders", "",
                   "--out-link", str(out / "result")], stderr=subprocess.DEVNULL if not os.environ.get("DEV_SDK_VERBOSE") else None)
    clock.phase("assemble")
    # Disk: the product shares the base image's extents (btrfs reflinks).
    probe = "image/priv/z3/bin/libz3.so"
    shared = first_extent(Path(product) / probe)
    shared = shared is not None and shared == first_extent(Path(os.path.realpath(base / probe)))
    selected = None
    if args.select:
        captured = json.loads(run(["nix-instantiate", "--eval", "--read-write-mode", "--json", str(ROOT / "scripts/dev-sdk.nix"),
                                   "--argstr", "mode", "source", "--argstr", "root", str(root)]))
        fingerprint = run([sys.executable, str(root / "scripts/sdk-inputs"), "--root", str(root)])
        frozen = run([sys.executable, str(root / "scripts/sdk-inputs"), "--root", captured,
                      "--policy", str(root / "nix/engine-inputs.json")])
        if frozen != fingerprint:
            fail("engine inputs changed while the dev SDK was built; run it again")
        directory = root / ".bl/sdks" / fingerprint
        directory.mkdir(parents=True, exist_ok=True)
        if (directory / "result-sdk").exists() and "dev" not in json.loads((directory / "result-sdk/artifact.json").read_text()):
            fail(f"{directory} already holds this tree's qualified SDK; it needs no dev SDK", 0)
        for name, target in (("result-sdk", product), ("source-engine", captured)):
            link = directory / name
            if link.is_symlink():
                link.unlink()
            run(["nix-store", "--add-root", str(link), "--realise", target])
        coordinator = os.path.realpath(Path(product) / "preparation-coordinator")
        (directory / "dev-sdk").write_text(product + "\n")
        (directory / "selection.v1").write_text(f"v1 {fingerprint} {product} {coordinator} {captured}\n")
        current = root / ".bl/sdks/current-sdk"
        temporary = root / ".bl/sdks/current-sdk.dev-tmp"
        if temporary.is_symlink():
            temporary.unlink()
        temporary.symlink_to(product)
        os.replace(temporary, current)
        selected = fingerprint
        # One dev SDK per tree: retire the earlier ones (their GC roots).
        for marker in (root / ".bl/sdks").glob("*/dev-sdk"):
            older = marker.parent
            if older == directory:
                continue
            for name in ("result-sdk", "source-engine", "selection.v1", "dev-sdk"):
                if (older / name).is_symlink() or (older / name).exists():
                    (older / name).unlink()
            if not any(older.iterdir()):
                older.rmdir()
        clock.phase("select")
    print(json.dumps({"product": product, "base": str(base), "hosts": hosts, "library": info["library"],
                      "units": [{k: u[k] for k in ("module", "identical", "relabelled", "reproducible", "code-identical", "milliseconds")}
                                for u in result["units"]],
                      "selected": selected, "shared-extents": shared, "phases": clock.phases, "seconds": clock.total()}, sort_keys=True))


if __name__ == "__main__":
    main()
